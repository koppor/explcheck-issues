\box_new:N \g__ptxcd_frame_logo_box

\defbeamertemplate{icon~in~head/foot/sidebar}{BFH}[1][logobox_A]{
		\box_if_empty:NTF \g__ptxcd_frame_logo_box {
			#1
		}{
			\box_use:N \g__ptxcd_frame_logo_box
		}
}[action]{
	\dim_compare:nNnTF {\l__ptxcd_frame_icon_ht_dim} = {\c_zero_dim} {
		\box_gclear:N  \g__ptxcd_frame_logo_box
	} {
		\str_if_eq:nnTF {#1} {logobox_A} {
			\cs_if_exist:NT \__ptxcd_set_logobox_A:N {
				\__ptxcd_set_logobox_A:N \g__ptxcd_frame_logo_box
			}
		}{
			\hbox_gset:Nn \g__ptxcd_frame_logo_box {#1}
		}
		\box_if_empty:NF \g__ptxcd_frame_logo_box {
			\box_gresize_to_ht_plus_dp:Nn \g__ptxcd_frame_logo_box {\l__ptxcd_frame_icon_ht_dim}
		}
	}
}

\defbeamertemplate{version~in~head/foot/sidebar}{BFH}{
  \ifx\insertversion\@empty
					\else
						{%
							\usebeamercolor[fg]{version~in~head/foot}%
							\usebeamerfont{version~in~head/foot}%
							\insertversion
						}%
	\fi
}

\bool_new:N \l__ptxcd_footline_title_bool
\bool_new:N \l__ptxcd_footline_author_bool
\tl_new:N \l__ptxcd_pagenumber_unit_tl

\keys_define:nn {ptxcd/beamer/outer} {
	footline .multichoice:,
	footline / author .code:n = \bool_set:Nn \l__ptxcd_footline_author_bool {#1},
	footline / author .default:n = true,
	footline / title .code:n = \bool_set:Nn \l__ptxcd_footline_title_bool {#1},
	footline / title .default:n = true,
	sidebar .bool_gset:N = \g__ptxcd_sidebar_bool,
	sidebar .initial:n = false,
	sidebar .default:n = true,
	sidebar .usage:n = load,
	%
	headbar .bool_gset:N = \g__ptxcd_headbar_bool,
	headbar .initial:n = false,
	headbar .default:n = true,
	headbar .usage:n = load,
	% framenumber-unit used to output the numbers + calculate progress bars
	framenumber-unit .choice:,
	framenumber-unit / frame .code:n = {
			\tl_set:Nn \l__ptxcd_pagenumber_unit_tl {frame}
	},
	framenumber-unit / page .code:n = {
			\tl_set:Nn \l__ptxcd_pagenumber_unit_tl {page}
		},
	framenumber-unit .initial:n = frame,
	% Option interface to adjust the template page number in head/foot
	show-page-number .choice:,
	show-page-number / false .code:n = {\setbeamertemplate{page~number~in~head/foot}[default]},
	show-page-number / current .code:n ={\setbeamertemplate{page~number~in~head/foot}[\l__ptxcd_pagenumber_unit_tl number]},
	show-page-number / total .code:n = {\setbeamertemplate{page~number~in~head/foot}[total\l__ptxcd_pagenumber_unit_tl number]},
	%
	framenumber .choice:,
  framenumber / current .meta:n = {framenumber-unit=frame,show-page-number=current},
  framenumber / total  .meta:n = {framenumber-unit=frame,show-page-number=total},
	framenumber / true .meta:n = {framenumber=current},
	framenumber / false .meta:n = {show-page-number=false},
	framenumber .default:n = true
	%
	pagenumber .choice:,
  pagenumber / current .meta:n = {framenumber-unit=page,show-page-number=current},
  pagenumber / total .meta:n = {framenumber-unit=page,show-page-number=total},
	pagenumber / true .meta:n = {pagenumber=current},
	pagenumber / false .meta:n = {show-page-number=false},
	pagenumber .default:n = true,
	%
	progressbar .tl_gset:N = \g__ptxcd_progressbar_init_options_tl,
	progressbar .initial:n = ,
	progressbar .default:n = true,
	%
	compress .choices:nn = {true, false}{\use:c {beamer@compress#1}},
	compress .default:n    = true,
	%%%%%%%%%%%%%%%%%%%%
	% shared options for sidebar + headbar
	%%%%%%%%%%%%%%%%%%%%
	icon .choice:,
	icon / true .code:n = \setbeamertemplate{icon~in~head/foot/sidebar}[BFH],
	icon / false .code:n = \setbeamertemplate{icon~in~head/foot/sidebar}{},
	icon / unknown .code:n = \setbeamertemplate{icon~in~head/foot/sidebar}[BFH][#1],
	icon* / unknown .meta:n = {icon=#1,iconheight=0pt},
	icon .initial:n    = false,
  iconheight .dim_set:N = \l__ptxcd_frame_icon_ht_dim,
% sidebar + headbar
	version .choice:,
	version / true .code:n = \setbeamertemplate{version~in~head/foot/sidebar}[BFH],
	version / false .code:n = \setbeamertemplate{version~in~head/foot/sidebar}{},
	version .initial:n    = true,
	version .default:n    = true,
}

\ProcessKeyOptions[ptxcd/beamer/outer]

\hook_gput_code:nnn {package/beamerouterthemeBFH/after} {sidebar-option} {
	\dim_compare:nNnT {\l__ptxcd_frame_icon_ht_dim} = {\c_zero_dim} {
		\bool_if:NTF \g__ptxcd_sidebar_bool {
			\dim_set:Nn  \l__ptxcd_frame_icon_ht_dim {.173\paperheight}
		}{
			\dim_set:Nn  \l__ptxcd_frame_icon_ht_dim {.006\paperheight}
		}
	}
	\bool_if:NT \g__ptxcd_headbar_bool {
		\useoutertheme{BFH-headbar}
	}
  \bool_if:NT \g__ptxcd_sidebar_bool {
		\useoutertheme{BFH-sidebar}
	}
}


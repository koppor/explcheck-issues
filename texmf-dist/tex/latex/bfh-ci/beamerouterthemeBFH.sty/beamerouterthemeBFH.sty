%% ============================================================================
%%
%% This is an unofficial extension the BFH-CI beamer outer theme. It adds a
%% progress bar showing how far the presentation has advanced. Colors, fonts,
%% footline, frame titles and title pages are inherited unchanged from the
%% BFH-CI themes; the bar uses BFH-Orange on a light BFH-Gray track, matching
%% the orange rule of the BFH title page.
%%
%% Usage:
%%   \documentclass[progressbar={…}]{bfhbeamer}
%%
%% To change settings afterwards use
%%
%%   \BFHBeamerSetup{progressbar={<options>}}
%%
%% which takes the same keys and can also be used between specific frames.
%%
%% It can be combined with `BFH-headbar' as long as the bar is not put at the
%% top (both would define the headline):
%%
%%   \useoutertheme{BFH-headbar}
%%   \useoutertheme{BFH-progressbar}
%%
%% Options (for \useoutertheme[<options>]{BFH-progressbar} or the setup command):
%%   position = footline|bottom|top|none
%%                             where the bar goes: directly above the BFH
%%                             footline text (default), flush with the bottom
%%                             edge below it, as a head line at the very top,
%%                             or nowhere
%%   unit     = frame|page     advance the bar once per frame (default) or
%%                             once per slide, i.e. per overlay
%%   height   = <dimen>        thickness of the bar (default: 2pt)
%%   titlepage = true|false     show the progress bar on title pages
%%                             (default: false)
%%   track    = true|false     draw the not-yet-covered part of the bar in
%%                             light gray (default: true)
%%   inset    = true|false     keep the bar inside the text margins instead of
%%                             running the full paper width (default: false)
%%   counter  = none|current|total
%%                             what the BFH footline shows next to the
%%                             institution line. Beamer's default template is
%%                             empty, so BFH slides are unnumbered unless this
%%                             is set (default: none). It follows `unit', i.e.
%%                             with unit=page it counts slides, not frames.
%%
%% Note: \inserttotalframenumber is only known after the first run, so LaTeX
%% has to be run twice before the bar is correct.

% What the bar measures. Both have to be usable as an <integer> inside
% \dimexpr, so they expand to a counter or to plain digits.
\cs_new:Nn \__ptxcd_pb_current: {\use:c {insert \l__ptxcd_pagenumber_unit_tl number}}
\cs_new:Nn \__ptxcd_pb_total: {\use:c {inserttotal \l__ptxcd_pagenumber_unit_tl number}}


%% =======================================================================
%% The progress bar itself
%% ============================================================================
%
% Drawn from two abutting rules rather than with TikZ, which keeps the theme
% free of further dependencies. \dimexpr keeps the intermediate result of
% <width> * <current> / <total> in 64 bit, so there is no overflow even for
% long presentations.

\dim_new:N \l__ptxcd_pb_fill_dim

\defbeamertemplate*{progressbar}{BFH-progressbar}[1][\paperwidth]{
	\dim_set:Nn \l__ptxcd_pb_width_dim {#1}
	\dim_set:Nn \l__ptxcd_pb_fill_dim {
		\int_compare:nNnTF {\__ptxcd_pb_total:} > {0}
		{
			\dim_min:nn
			{\l__ptxcd_pb_width_dim}
			{\l__ptxcd_pb_width_dim * \__ptxcd_pb_current: / \__ptxcd_pb_total:}
		}
		{\c_zero_dim}
	}
	% The template is page-relative. \addtobeamertemplate inserts this code
	% before/after the BFH footline box, not inside that box, so no horizontal
	% compensation for the footline's leftskip is required. This also keeps the
	% same geometry for the footline, bottom, and top positions.
	\ifbeamer@plainframe\hspace*{-\beamer@leftmargin}\fi
	\hbox to \paperwidth {
		\hskip0pt plus\beamer@leftmargin
		\makebox[\l__ptxcd_pb_width_dim][l]{
			\bool_if:NT \l__ptxcd_pb_track_bool {
				\rlap{\usebeamercolor{progress~bar}\color{bg}
				\rule{\l__ptxcd_pb_width_dim}{\l__ptxcd_pb_height_dim}}
			}
			\usebeamercolor[fg]{progress~bar}
			\rule{\l__ptxcd_pb_fill_dim}{\l__ptxcd_pb_height_dim}
		}
		\hskip0pt plus\beamer@rightmargin
	}%
}%

\ExplSyntaxOff

% Templates have to be defined before the options are processed

\defbeamertemplate{progressbar top}{BFH-progressbar}{
			\usebeamertemplate{progressbar}\par
			\nointerlineskip
}

\defbeamertemplate{progressbar headline}{BFH-progressbar}{
			\usebeamertemplate{progressbar}
}

\defbeamertemplate{progressbar footline}{BFH-progressbar}{
	\raisebox{-\height}[0pt][0pt]{\rlap{\usebeamertemplate{progressbar}}}
	\par\nointerlineskip
}

\defbeamertemplate{progressbar bottom}{BFH-progressbar}{
	\par\nointerlineskip
	\smash{\rlap{\usebeamertemplate{progressbar}}}
}

\defbeamertemplate{headline}{BFH-progressbar}{
		\usebeamertemplate{progressbar top}
}

\ExplSyntaxOn

\providecommand*{\thepagenumber}{\value{page}}
\providecommand*{\inserttotalpagenumber}{\beamer@endpageofdocument}

%% ============================================================================
%% Progressbar Options
%% ============================================================================
\keys_define:nn {ptxcd/beamer/outer/progressbar} {
	position .choices:nn = {footline, bottom, headline} {
		\keys_set:nn {ptxcd/beamer/outer/progressbar}{position=none}
		\setbeamertemplate{progressbar~\l_keys_choice_tl}[BFH-progressbar]
	},
	position / headbar .code:n = {
		\keys_set:nn {ptxcd/beamer/outer/progressbar}{position=none}
		\setbeamertemplate{headbar~rule}[BFH-progressbar]
	},
	position / top .meta:n = {position= headline},
	position / none .code:n = {
		\setbeamertemplate{progressbar~footline}{}
		\setbeamertemplate{progressbar~bottom}{}
		\setbeamertemplate{headbar~rule}[BFH]
		\setbeamertemplate{progressbar~headline}{}
	},

	height .dim_set:N = \l__ptxcd_pb_height_dim,
	height .initial:n  = 2pt,

	width .dim_set:N = \l__ptxcd_pb_width_dim,
	width .initial:n  = \paperwidth, 

	track .bool_set:N = \l__ptxcd_pb_track_bool,
	track .initial:n    = true,
	track .default:n    = true,

	inset .choice:,
	inset /true .meta:n ={width=\dim_eval:n {\paperwidth-\beamer@leftmargin-\beamer@rightmargin}},
	inset /false .meta:n ={width=\paperwidth},

	true .meta:n = {position=footline},
	top .meta:n = {position=top},
	bottom .meta:n = {position=bottom},
	footline .meta:n = {position=footline},
}

\tl_if_blank:VF \g__ptxcd_progressbar_init_options_tl {
	\keys_set:nV {ptxcd/beamer/outer/progressbar} \g__ptxcd_progressbar_init_options_tl
}

\NewDocumentCommand \BFHBeamerSetup {O{/outer}m} {
	\keys_set:nn {ptxcd/beamer#1} {#2}
}

\ExplSyntaxOff



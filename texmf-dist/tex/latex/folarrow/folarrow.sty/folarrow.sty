% マップファイルと，テキストとしての値（ToUnicode）
\iffol@glyphs
  \ifdefined\pdfextension % LuaTeX
    \ifnum\outputmode>\z@
      \pdfextension mapfile{+folarrow.map}%
      \pdfvariable gentounicode=\@ne
      \pdfextension glyphtounicode{arrowright}{2192}%
      \pdfextension glyphtounicode{arrowleft}{2190}%
      \pdfextension glyphtounicode{arrowdown}{2193}%
      \pdfextension glyphtounicode{arrowup}{2191}%
    \fi
  \else\ifdefined\pdfoutput % pdfTeX（XeTeXには\pdfoutputがない）
    \ifnum\pdfoutput>\z@
      \pdfmapfile{+folarrow.map}%
      \pdfgentounicode=\@ne
      \pdfglyphtounicode{arrowright}{2192}%
      \pdfglyphtounicode{arrowleft}{2190}%
      \pdfglyphtounicode{arrowdown}{2193}%
      \pdfglyphtounicode{arrowup}{2191}%
    \fi
  \fi\fi
  % dvipdfmx，xdvipdfmx：字形の名前（arrowrightなど）からToUnicodeを作るので，
  % マップファイルだけ読ませる．dvipsではupdmapでfolarrow.mapを登録しておく．
  \AtBeginDocument{%
    \def\fol@tempa{dvipdfmx.def}\def\fol@tempb{xetex.def}%
    \ifdefined\Gin@driver
      \ifx\Gin@driver\fol@tempa\fol@dvipdfmxmap\fi
      \ifx\Gin@driver\fol@tempb\fol@dvipdfmxmap\fi
      % dvipsはパッケージからマップファイルを読ませられないので，登録が要ることを知らせる
      \def\fol@tempa{dvips.def}%
      \ifx\Gin@driver\fol@tempa
        \PackageWarningNoLine{folarrow}{%
          With dvips, the map file folarrow.map must be\MessageBreak
          enabled (updmap-user --enable Map=folarrow.map,\MessageBreak
          or dvips -u +folarrow.map). Otherwise the inline\MessageBreak
          arrows are replaced by other glyphs.\MessageBreak
          The option glyphs=false avoids the arrow fonts}%
      \fi
    \fi}
  \def\fol@dvipdfmxmap{\AddToHook{shipout/firstpage}{\special{pdf:mapfile folarrow.map}}}
\fi

%% 伸びる矢印：\xfolrightarrow[下]{上}，\xfolleftarrow[下]{上}
%% （amsmathの\xrightarrowと同じ組み方で，できた矢印に斜線を重ねる）
\providecommand\rightarrowfill@{\arrowfill@\relbar\relbar\rightarrow}
\providecommand\leftarrowfill@{\arrowfill@\leftarrow\relbar\relbar}
\providecommand\arrowfill@[4]{%
  $\m@th\thickmuskip0mu\medmuskip\thickmuskip\thinmuskip\thickmuskip
   \relax#4#1\mkern-7mu%
   \cleaders\hbox{$#4\mkern-2mu#2\mkern-2mu$}\hfill
   \mkern-7mu#3$}
% hyperrefのしおりでは，矢印は→←↓↑の文字にし，伸びる矢印のラベルは捨てる
% （引数を取る定義は外に置き，\letで置き換える．フックの中に#を書くと二重に処理されるため）
\def\fol@pdfstr@xr#1#{\textrightarrow\@gobble}
\def\fol@pdfstr@xl#1#{\textleftarrow\@gobble}
\AtBeginDocument{%
  \ifdefined\pdfstringdefDisableCommands
    \pdfstringdefDisableCommands{%
      \def\folrightarrow{\textrightarrow}\def\folleftarrow{\textleftarrow}%
      \def\foldownarrow{\textdownarrow}\def\foluparrow{\textuparrow}%
      \let\xfolrightarrow\fol@pdfstr@xr \let\xfolleftarrow\fol@pdfstr@xl}%
  \fi}
\newcommand*\xfolrightarrow[2][]{\fol@extarrow 0359\rightarrowfill@{1}{#1}{#2}}
\newcommand*\xfolleftarrow[2][]{\fol@extarrow 3095\leftarrowfill@{-1}{#1}{#2}}
\def\fol@extarrow#1#2#3#4#5#6#7#8{%
  \mathrel{\mathop{%
    \setbox\z@\hbox{#5\displaystyle}%
    \setbox\tw@\vbox{\m@th
      \hbox{$\scriptstyle\mkern#3mu{#7}\mkern#4mu$}%
      \hbox{$\scriptstyle\mkern#3mu{#8}\mkern#4mu$}%
      \copy\z@}%
    % 短すぎると斜線が窮屈になるので，\longrightarrowの長さを最小とする
    \setbox\@ne\hbox{$\m@th\displaystyle\fol@longright$}%
    \ifdim\wd\tw@<\wd\@ne \setbox\tw@\hbox to\wd\@ne{}\fi
    \setbox\z@\hbox to\wd\tw@{\unhbox\z@}%
    \chardef\fol@hkindnum=\@ne
    \fol@overh\displaystyle\z@{#6}}%
  \limits
    \@ifnotempty{#8}{^{\if0#1\else\mkern#1mu\fi
                       #8\if0#2\else\mkern#2mu\fi}}%
    \@ifnotempty{#7}{_{\if0#2\else\mkern#2mu\fi
                       #7\if0#1\else\mkern#1mu\fi}}}}

%% ---------------------------------------------------------------
%% amscd：@F>>>，@F<<<，@FVVV，@FAAA
%%   通常の@>>>などの@の直後にFを付けると斜線入りになる．
%% ---------------------------------------------------------------
\def\fol@amscd{%
  % unicode-mathは\begin{document}で@の数式コードを上書きし，amscdの@>>>などが
  % 使えなくなる．amscdの設定（数式中で@を特別な意味にする）に戻す．unicode-mathを
  % folarrowより後に読むと，unicode-mathの上書きがこの後になるので，CD環境の始めでも戻す．
  \mathcode`\@="8000
  \AddToHook{env/CD/begin}{\mathcode`\@="8000 }%
  \atdef@ F##1{%
    \@ifundefined{fol@CD\string##1}%
      {\PackageError{folarrow}{@F must be followed by >, <, V or A}\@eha}%
      {\csname fol@CD\string##1\endcsname}}%
}
\@namedef{fol@CD>}#1>#2>{\ampersand@
  \ifCD@ \global\bigaw@\minCDarrowwidth \else \global\bigaw@\minaw@ \fi
  % 大きな文字では\minCDarrowwidth（既定2.5pc）が短すぎて3本線が矢頭にかかるので，
  % \longrightarrowの長さより短くしない
  \setboxz@h{$\m@th\displaystyle\fol@longright$}%
  \ifdim\wdz@>\bigaw@\global\bigaw@\wdz@\fi
  \setboxz@h{$\m@th\scriptstyle\;{#1}\;\;$}%
  \ifdim\wdz@>\bigaw@\global\bigaw@\wdz@\fi
  \@ifnotempty{#2}{\setbox\@ne\hbox{$\m@th\scriptstyle\;{#2}\;\;$}%
    \ifdim\wd\@ne>\bigaw@\global\bigaw@\wd\@ne\fi}%
  \ifCD@\enskip\fi
  \mathrel{\mathop{%
      \setbox\z@\hbox to\bigaw@{\rightarrowfill@\displaystyle}%
      \chardef\fol@hkindnum=\@ne
      \fol@overh\displaystyle\z@{1}}%
    \limits^{#1}\@ifnotempty{#2}{_{#2}}}%
  \ifCD@\enskip\fi \ampersand@}
\@namedef{fol@CD<}#1<#2<{\ampersand@
  \ifCD@ \global\bigaw@\minCDarrowwidth \else \global\bigaw@\minaw@ \fi
  % 大きな文字では\minCDarrowwidth（既定2.5pc）が短すぎて3本線が矢頭にかかるので，
  % \longrightarrowの長さより短くしない
  \setboxz@h{$\m@th\displaystyle\fol@longright$}%
  \ifdim\wdz@>\bigaw@\global\bigaw@\wdz@\fi
  \setboxz@h{$\m@th\scriptstyle\;\;{#1}\;$}%
  \ifdim\wdz@>\bigaw@ \global\bigaw@\wdz@ \fi
  \@ifnotempty{#2}{\setbox\@ne\hbox{$\m@th\scriptstyle\;\;{#2}\;$}%
    \ifdim\wd\@ne>\bigaw@ \global\bigaw@\wd\@ne \fi}%
  \ifCD@\enskip\fi
  \mathrel{\mathop{%
      \setbox\z@\hbox to\bigaw@{\leftarrowfill@\displaystyle}%
      \chardef\fol@hkindnum=\@ne
      \fol@overh\displaystyle\z@{-1}}%
    \limits^{#1}\@ifnotempty{#2}{_{#2}}}%
  \ifCD@\enskip\fi \ampersand@}
\@namedef{fol@CDV}#1V#2V{\CD@check{FV..V..V}{\llap{$\m@th\vcenter{\hbox
  {$\scriptstyle#1$}}$}\fol@Bigv\downarrow{-1}%
  \rlap{$\m@th\vcenter{\hbox{$\scriptstyle#2$}}$}&&}}
\@namedef{fol@CDA}#1A#2A{\CD@check{FA..A..A}{\llap{$\m@th\vcenter{\hbox
  {$\scriptstyle#1$}}$}\fol@Bigv\uparrow{1}%
  \rlap{$\m@th\vcenter{\hbox{$\scriptstyle#2$}}$}&&}}
% 回して組むときの長さは，\Bigの区切り記号に求める高さ（空の区切り記号の\Big.の箱の高さ＋深さ）
\newdimen\fol@Blen
\def\fol@Bigv#1#2{%
  \setbox\z@\hbox{$\m@th\Big.$}\fol@Blen=\dimexpr\ht\z@+\dp\z@\relax
  \mathord{\fol@tryrotv\textstyle{#2}{\fol@Blen}{%
    \setbox\z@\hbox{$\m@th\Big#1$}\fol@overv\textstyle\z@{#2}{big}}}}

%% ---------------------------------------------------------------
%% xy-pic：\ar[d]|@{fol}
%%   矢印の途中に置く大きさ0の方向付き物体（\newdir）．矢印は切れない．
%%   斜線の向きはその矢印の向きから決まる．
%% ---------------------------------------------------------------
\def\fol@xy{\newdir{fol}{*=0{\fol@xymark}}}
% \folpad{ラベル}：ラベルの四方に斜線の半分の長さの余白を付ける．xy-picの矢印のラベルが
% 斜線にかからないようにするときに\ar[r]|@{fol}^{\folpad{f}}のように使う．
\newcommand*\folpad[1]{\mathpalette\fol@pad{#1}}
\def\fol@pad#1#2{%
  \fol@hmetrics#1%
  \@tempdima=\fpeval{0.5*\fol@span*\fol@b}pt
  \setbox\z@\hbox{$\m@th#1#2$}%
  \hbox{\kern\@tempdima
    \vrule\@width\z@\@height\dimexpr\ht\z@+\@tempdima\relax
      \@depth\dimexpr\dp\z@+\@tempdima\relax
    \box\z@\kern\@tempdima}}
\def\fol@xymark{%
  \fol@hmetrics\textstyle
  \def\fol@cap{r}% xy-picの線の端は丸い
  \fol@strokes
    {\fpeval{-\fol@shift*\fol@b*(\cosDirection)}}%
    {\fpeval{-\fol@shift*\fol@b*(\sinDirection)}}%
    {\cosDirection}{\sinDirection}{\fol@b}{\fol@t}}

%% ---------------------------------------------------------------
%% tikz-cd：\arrow[d, foliated]
%% ---------------------------------------------------------------
\def\fol@tikz{%
  \usetikzlibrary{decorations.markings}%
  \tikzset{
    foliated/.style={
      postaction={decorate,
        decoration={markings,
          mark=at position 0.5 with {\fol@tikzmark}}},
      % ラベルが斜線にかからないよう，この矢印のラベルだけ余白を斜線の半分の長さだけ増やす
      % （tikz-cdの既定は0.5ex．矢頭の幅はおよそ0.4～0.55 em）
      /tikz/commutative diagrams/every label/.append style={
        inner sep={0.5ex+0.28em*\fol@span}}},
    commutative diagrams/foliated/.style={/tikz/foliated}}%
}
\def\fol@tikzmark{%
  % マーキングの座標系は矢印の向きに回っている（x軸が矢印の向き）．
  \fol@hmetrics\textstyle
  \edef\fol@c{\fpeval{cosd(\pgfdecoratedangle)}}%
  \edef\fol@si{\fpeval{sind(\pgfdecoratedangle)}}%
  % 右上がりになる符号（\fol@strokesと同じ判定）
  \edef\fol@sg{\fpeval{
      ((\fol@lean*\fol@c-\fol@si)*(\fol@lean*\fol@si+\fol@c) >= 0) ? 1 : -1}}%
  \edef\fol@s{\fpeval{\fol@span*\fol@b}}%
  \edef\fol@x{\fpeval{-\fol@shift*\fol@b}}%
  \ifx\fol@thickness\@empty\else\pgfsetlinewidth{\fol@thickness}\fi
  % 線の端は矢印の線の設定（line cap）をそのまま使う（tikz-cdの既定は切りっぱなし）
  \pgfsetarrows{-}%
  % 破線・点線（dashed，dotted）の模様は3本線には付けない
  \pgfsetdash{}{0pt}%
  \foreach \fol@k in {-1,0,1}{%
    \pgfpathmoveto{\pgfpoint
      {(\fol@x+\fol@k*\fol@gap*\fol@b-0.5*\fol@sg*\fol@lean*\fol@s)*1pt}
      {-0.5*\fol@s*1pt}}%
    \pgfpathlineto{\pgfpoint
      {(\fol@x+\fol@k*\fol@gap*\fol@b+0.5*\fol@sg*\fol@lean*\fol@s)*1pt}
      {0.5*\fol@s*1pt}}}%
  \pgfusepath{stroke}}

\AtBeginDocument{%
  \@ifpackageloaded{amscd}{\fol@amscd}{}%
  \@ifpackageloaded{tikz-cd}{\fol@tikz}{}%
  \@ifpackageloaded{xy}{\fol@xy}{}%
}

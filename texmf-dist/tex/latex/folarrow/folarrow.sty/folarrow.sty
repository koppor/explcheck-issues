  \edef\fol@rd{\fol@clistitem{#5}{\ifnum\fol@hdir<\z@\ifnum\fol@hkindnum=\z@ 5\else 6\fi
    \else\ifnum\fol@hkindnum=\z@ 1\else 2\fi\fi}}%
  \edef\fol@re{\fol@clistitem{#5}{\ifnum\fol@hdir<\z@\ifnum\fol@hkindnum=\z@ 7\else 8\fi
    \else\ifnum\fol@hkindnum=\z@ 3\else 4\fi\fi}}}
% 横向きの矢印の向き（1で右向き，-1で左向き）
\def\fol@hdir{1}
\def\fol@bigvals#1#2#3#4#5#6#7\@nil{\def\fol@ra{#1}\def\fol@rb{#2}\def\fol@rc{#5}%
  \edef\fol@rd{\fol@clistitem{#7}{\ifnum\fol@vdir<\z@ 1\else 2\fi}}%
  \edef\fol@re{\fol@clistitem{#7}{\ifnum\fol@vdir<\z@ 5\else 6\fi}}}
\def\fol@inlvals#1#2#3#4#5#6#7\@nil{\def\fol@ra{#3}\def\fol@rb{#4}\def\fol@rc{#6}%
  \edef\fol@rd{\fol@clistitem{#7}{\ifnum\fol@vdir<\z@ 3\else 4\fi}}%
  \edef\fol@re{\fol@clistitem{#7}{\ifnum\fol@vdir<\z@ 7\else 8\fi}}}
% 縦向きの矢印の向き（-1で下向き，1で上向き）
\def\fol@vdir{-1}
% 横向きの矢印の組み方：0は\longrightarrow（本文の数式），1は伸びる矢印（amscd，\xfolrightarrow）
\chardef\fol@hkindnum=\z@
% OpenTypeのフォントの尻の形と中心のずれ：#1は小文字の英数字だけにしたフォント名，
% #2は尻の形の何番目（1～4），#3は中心のずれの何番目（1～6）か．
% 結果は\fol@cap（尻の形）と\fol@rd（中心のずれ，quadに対する比）．
\ExplSyntaxOn
% コンマ区切りの並びの#2番目．なければ0
\cs_new:Npn \fol@clistitem #1#2
  { \exp_args:Ne \tl_if_blank:nTF { \clist_item:nn {#1} {#2} } { 0 } { \clist_item:nn {#1} {#2} } }
\cs_new_protected:Npn \fol@otfcaplookup #1#2#3
  {
    \def\fol@cap{b}
    \def\fol@rd{0}
    \def\fol@re{0}
    \cs_set:Npn \fol@oc ##1##2##3##4##5##6
      {
        \str_if_in:nnT {#1} {##1}
          {
            \tl_set:Nx \fol@cap { \int_case:nn {#2} { {1}{##2} {2}{##3} {3}{##4} {4}{##5} } }
            \tl_set:Nx \fol@rd { \fol@clistitem {##6} {#3} }
            \tl_set:Nx \fol@re { \fol@clistitem {##6}
              { \int_eval:n { \int_compare:nNnTF {#3} > {12} { #3 + 2 } { #3 + 6 } } } }
          }
      }
    \fol@otfcaps
    \tl_if_blank:VT \fol@rd { \def\fol@rd{0} }
    \tl_if_blank:VT \fol@re { \def\fol@re{0} }
  }
\ExplSyntaxOff

% 3. 推定（データがないとき）
% 矢頭の幅：\rightarrowの箱の高さと数式の軸から2×（高さ－軸の高さ）．これが0.35 quad
% 未満なら，箱の高さが矢頭より低く設定されたフォントとみなして0.5 quadにする．
% 線の太さ：数式拡張フォントの罫線の太さ．Computer Modernでexscaleを使わない
% ときのように拡張フォントが拡大されていなければ，記号フォントの大きさに合わせる．
% いずれも極端な値にならないよう，quadに対する比を制限する．
\def\fol@guess#1{%
  \fol@setff#1%
  \setbox\@tempboxa\hbox{$\m@th#1\rightarrow$}%
  \@tempdima=\ht\@tempboxa \advance\@tempdima-\fontdimen22\fol@ff\tw@
  \multiply\@tempdima\tw@
  \@tempdimb=.35\fontdimen6\fol@ff\tw@
  \ifdim\@tempdima<\@tempdimb \@tempdima=.5\fontdimen6\fol@ff\tw@ \fi
  \@tempdimb=\fontdimen6\fol@ff\tw@
  \edef\fol@b{\fpeval{min(max(\the\@tempdima,0.25*\the\@tempdimb),0.8*\the\@tempdimb)}}%
  \@tempdima\fontdimen8\textfont3
  \@tempdimc\fontdimen6\textfont3
  \ifdim\@tempdimc=\z@ \@tempdimc=\fontdimen6\textfont\tw@ \fi
  \edef\fol@t{\fpeval{\the\@tempdima*\the\@tempdimb/\the\@tempdimc}}%
  \edef\fol@t{\fpeval{min(max(\fol@t,0.02*\the\@tempdimb),0.12*\the\@tempdimb)}}}

% 横向き
\def\fol@hmetrics@calc#1{%
  \let\fol@glyphmid\@empty
  \setbox\fol@refbox\hbox{$\m@th#1\rightarrow$}%
  \fol@luaextent\fol@refbox{false}%
  \fol@setff#1\fol@hfamily\fol@fam
  \ifx\fol@lua\@empty
    \fol@xeextent\fol@fam{"2192}h%
  \fi
  \ifx\fol@lua\@empty
    \fol@lookup H{\fol@ff\fol@fam\relax}%
    \ifx\fol@data\relax
      \fol@guess#1\def\fol@cap{b}\def\fol@off{0}\def\fol@acr{0}%
    \else
      \expandafter\fol@hvals\fol@data\@nil
      \@tempdimb=\fontdimen6\fol@ff\fol@fam\relax
      \edef\fol@b{\fpeval{\fol@ra*\the\@tempdimb}}%
      \edef\fol@t{\fpeval{\fol@rb*\the\@tempdimb}}%
      \edef\fol@off{\fpeval{\fol@rd*\the\@tempdimb}}%
      \edef\fol@acr{\fpeval{\fol@re*\the\@tempdimb}}%
      \let\fol@cap\fol@rc
    \fi
  \else
    \expandafter\fol@splitlua\fol@lua\@nil
    \expandafter\fol@otfcaplookup\expandafter{\fol@otfkey}%
      {\ifnum\fol@hkindnum=\z@ 1\else 2\fi}%
      {\ifnum\fol@hdir<\z@\ifnum\fol@hkindnum=\z@ 13\else 14\fi\else\ifnum\fol@hkindnum=\z@ 1\else 2\fi\fi}%
    \@tempdimb=\fontdimen6\fol@ff\fol@fam\relax
    \edef\fol@off{\fpeval{\fol@rd*\the\@tempdimb}}%
      \edef\fol@acr{\fpeval{\fol@re*\the\@tempdimb}}%
  \fi
  \fol@usethickness}
% 縦向き
\def\fol@vmetrics@calc#1#2#3{%
  \fol@luaextent#2{true}%
  \fol@setff#1\fol@vfamily\fol@fam
  \ifx\fol@lua\@empty
    \fol@xeextent\fol@fam{"2193}v%
  \fi
  \def\@tempa{#3}%
  \ifx\fol@lua\@empty
    \fol@lookup V{\fol@ff\fol@fam\relax}%
    \ifx\fol@data\relax
      % データがなければ横向きと同じ値を，拡張フォントの大きさに合わせて使う
      \fol@hmetrics#1\fol@getrthree
      \edef\fol@b{\fpeval{\fol@b*\fol@rthree}}%
      \edef\fol@t{\fpeval{\fol@t*\fol@rthree}}%
      \def\fol@cap{b}\def\fol@off{0}\def\fol@acr{0}%
    \else
      \ifx\@tempa\fol@kind@inl
        \expandafter\fol@inlvals\fol@data\@nil
      \else
        \expandafter\fol@bigvals\fol@data\@nil
      \fi
      \@tempdimb=\fontdimen6\fol@ff\fol@fam\relax
      \edef\fol@b{\fpeval{\fol@ra*\the\@tempdimb}}%
      \edef\fol@t{\fpeval{\fol@rb*\the\@tempdimb}}%
      \edef\fol@off{\fpeval{\fol@rd*\the\@tempdimb}}%
      \edef\fol@acr{\fpeval{\fol@re*\the\@tempdimb}}%
      \let\fol@cap\fol@rc
    \fi
  \else
    \expandafter\fol@splitlua\fol@lua\@nil
    \expandafter\fol@otfcaplookup\expandafter{\fol@otfkey}%
      {\ifx\@tempa\fol@kind@inl 4\else 3\fi}%
      {\ifx\@tempa\fol@kind@inl\ifnum\fol@vdir<\z@ 5\else 6\fi\else\ifnum\fol@vdir<\z@ 3\else 4\fi\fi}%
    \@tempdimb=\fontdimen6\fol@ff\fol@fam\relax
    \edef\fol@off{\fpeval{\fol@rd*\the\@tempdimb}}%
      \edef\fol@acr{\fpeval{\fol@re*\the\@tempdimb}}%
  \fi
  \fol@usethickness}
\def\fol@kind@inl{inl}
% 計算した寸法（\fol@b，\fol@t，\fol@cap，\fol@off，\fol@acr，\fol@glyphmid）は，フォント名，矢印の種類，
% 向き，thicknessの値ごとに覚えておき，2回目からは計算しない（描く矢印が多い文書で時間がかかるため）
\def\fol@hmetrics#1{%
  \fol@setff#1\fol@hfamily\fol@fam
  \edef\fol@mkey{H\fol@fnm\fol@ff\fol@fam\relax|\number\fol@hkindnum|\fol@hdir|\detokenize\expandafter{\fol@thickness}}%
  \fol@metricscache{\fol@hmetrics@calc#1}}
\def\fol@vmetrics#1#2#3{%
  \fol@setff#1\fol@vfamily\fol@fam
  \edef\fol@mkey{V\fol@fnm\fol@ff\fol@fam\relax|\fol@fnm\fol@ff\tw@\relax|#3|\fol@vdir|\detokenize\expandafter{\fol@thickness}}%
  \fol@metricscache{\fol@vmetrics@calc#1#2{#3}}}
\def\fol@metricscache#1{%
  \ifcsname fol@MC@\fol@mkey\endcsname
    \csname fol@MC@\fol@mkey\endcsname
  \else
    #1%
    \expandafter\xdef\csname fol@MC@\fol@mkey\endcsname{%
      \def\noexpand\fol@b{\fol@b}\def\noexpand\fol@t{\fol@t}\def\noexpand\fol@cap{\fol@cap}%
      \def\noexpand\fol@off{\fol@off}\def\noexpand\fol@acr{\fol@acr}%
      \def\noexpand\fol@glyphmid{\fol@glyphmid}}%
  \fi}
\def\fol@usethickness{%
  \ifx\fol@thickness\@empty\else
    \@tempdima=\fol@thickness\relax
    \edef\fol@t{\fpeval{\the\@tempdima}}%
  \fi}
% 拡張フォント（family 3）が拡大されていなければ（family 3のquad）／（family 2のquad），
% 拡大されていれば1
\def\fol@getrthree{%
  \@tempdima\fontdimen6\textfont3
  \@tempdimb\fontdimen6\textfont\tw@
  \edef\fol@rthree{\fpeval{(\the\@tempdima>0pt) ? \the\@tempdima/\the\@tempdimb : 1}}%
  \edef\fol@rthree{\fpeval{abs(\fol@rthree-1)>0.2 ? \fol@rthree : 1}}}
% 数式の軸の高さ
\def\fol@getaxis#1{%
  \fol@setff#1\@tempdima\fontdimen22\fol@ff\tw@
  \edef\fol@axis{\fpeval{\the\@tempdima}}}
% 箱の寸法
\def\fol@getbox#1{%
  \edef\fol@wd{\fpeval{\the\wd#1}}%
  \edef\fol@ht{\fpeval{\the\ht#1}}%
  \edef\fol@dp{\fpeval{\the\dp#1}}}

%% ---------------------------------------------------------------
%% 箱に斜線を重ねる
%%   \fol@overh{style}{box}{dir}：横向きの矢印の箱（dir＝1で右向き，-1で左向き）
%%   \fol@overv{style}{box}{dir}{kind}：縦向きの矢印の箱（dir＝-1で下向き，1で上向き）
%% ---------------------------------------------------------------
\def\fol@overh#1#2#3{%
  \def\fol@hdir{#3}%
  \fol@hmetrics#1\fol@getaxis#1\fol@getbox#2%
  % 3本線の高さ：グリフから矢頭の上下の中心が読めればそれ，読めなければ数式の軸
  \ifx\fol@glyphmid\@empty\else\let\fol@axis\fol@glyphmid\fi
  \edef\fol@axis{\fpeval{\fol@axis+\fol@acr}}%
  \hbox{\fol@strokes
    {\fpeval{\fol@wd/2-(#3)*(\fol@shift*\fol@b+\fol@off)}}{\fol@axis}{#3}{0}{\fol@b}{\fol@t}%
    % 斜線の上下の広がりを箱の高さ・深さに入れ，上下のラベルと重ならないようにする
    \vrule\@width\z@
      \@height\fpeval{\fol@axis+(0.5*\fol@span*\fol@b+0.5*\fol@t)}pt
      \@depth\fpeval{max(0,(0.5*\fol@span*\fol@b+0.5*\fol@t)-\fol@axis)}pt
    \box#2}}
\def\fol@overv#1#2#3#4{%
  \def\fol@vdir{#3}%
  \fol@vmetrics#1#2{#4}\fol@getbox#2%
  \hbox{\fol@strokes
    {\fpeval{\fol@wd/2-\fol@acr}}%
    {\fpeval{(\fol@ht-\fol@dp)/2-(#3)*(\fol@shift*\fol@b+\fol@off)}}%
    {0}{#3}{\fol@b}{\fol@t}%
    \box#2}}

%% ---------------------------------------------------------------
%% 本文の数式用
%% ---------------------------------------------------------------
% 長い矢印：unicode-mathで数式フォントにU+27F6，U+27F5がなければ（XITS Math Bold），\LaTeX{}の
% 元の定義と同じく\relbar\joinrel\rightarrow（\leftarrow\joinrel\relbar）で組む
\def\fol@longright{\fol@iflongchar{"27F6}\longrightarrow{\relbar\joinrel\rightarrow}}
\def\fol@longleft{\fol@iflongchar{"27F5}\longleftarrow{\leftarrow\joinrel\relbar}}
\def\fol@iflongchar#1#2#3{%
  \ifdefined\Umathcode
    \fol@hfamily\fol@lfam
    \iffontchar\textfont\numexpr\fol@lfam\relax#1 \def\fol@tmp{#2}\else\def\fol@tmp{#3}\fi
  \else
    \def\fol@tmp{#2}%
  \fi
  \fol@tmp}
\DeclareRobustCommand*\folrightarrow{\mathrel{\mathpalette\fol@rightarrow\relax}}
\DeclareRobustCommand*\folleftarrow{\mathrel{\mathpalette\fol@leftarrow\relax}}
\DeclareRobustCommand*\foldownarrow{\mathrel{\mathpalette\fol@downarrow\relax}}
\DeclareRobustCommand*\foluparrow{\mathrel{\mathpalette\fol@uparrow\relax}}
\def\fol@rightarrow#1#2{\fol@tryglyph#1\z@{%
  \setbox\z@\hbox{$\m@th#1\fol@longright$}\fol@overh#1\z@{1}}}
\def\fol@leftarrow#1#2{\fol@tryglyph#1\@ne{%
  \setbox\z@\hbox{$\m@th#1\fol@longleft$}\fol@overh#1\z@{-1}}}
% 縦向きの土台：\right.が空の区切り記号の幅（\nulldelimiterspace）を右に足すと箱の中心が
% 軸からずれるので，\Bigと同じく0にして組む．高さは記号フォントのquadの1.25倍とする
% （本文のフォントによらず，数式フォントだけで形が決まるようにするため）．
% \fol@vbase{style}{\downarrowか\uparrow}：土台を\box\z@に組む．区切り記号の字形の選び方が
% 文字の大きさによらないよう，\delimiterfactorを1000，\delimitershortfallを0にする．
\def\fol@vbase#1#2{%
  \fol@setff#1\@tempdima=1.25\fontdimen6\fol@ff\tw@
  \setbox\z@\hbox{$\m@th\nulldelimiterspace\z@\delimiterfactor\@m\delimitershortfall\z@
    #1\left#2\vcenter to\@tempdima{}\right.$}}
\def\fol@downarrow#1#2{\fol@tryglyph#1\tw@{%
  \fol@tryrotv#1{-1}{}{%
    \fol@vbase#1\downarrow
    \fol@overv#1\z@{-1}{inl}}}}
\def\fol@uparrow#1#2{\fol@tryglyph#1\thr@@{%
  \fol@tryrotv#1{1}{}{%
    \fol@vbase#1\uparrow
    \fol@overv#1\z@{1}{inl}}}}

%% ---------------------------------------------------------------
%% 横向きの矢印を回した縦向きの矢印
%%   ↓↑の伸縮の部品がずれているOpenTypeの数式フォント（Pennstander Math）では，大きな
%%   区切り記号として組んだ↓↑が崩れる（軸の部品と矢頭の部品の軸の位置が合わない）．
%%   そのようなフォント（folarrow-otf.defの\fol@otfrotv）では，描いて組む縦向きの矢印の土台を，
%%   横向きの矢印を90°回したものにする（OTFの字形と同じ作り方）．
%%   \fol@tryrotv{style}{dir}{長さ}{そうでない場合の処理}：dirは-1で下向き，1で上向き．
%%   長さが空なら\longrightarrow，空でなければその長さの伸びる矢印（amscd用）を回す．
%%   3本線は，横向きの矢印の実測値（矢頭の幅，軸の太さ，中心のずれ）を回した位置に描く．
%% ---------------------------------------------------------------
\def\fol@tryrotv#1#2#3#4{%
  \fol@setff#1\fol@vfamily\fol@fam
  \fol@ifrotv{\fol@ff\fol@fam\relax}{\fol@rotv#1{#2}{#3}}{#4}}
% \fol@hink{style}{box}：横向きの矢印の箱の字面の左端と右端（pt）を\fol@inkl，\fol@inkrに入れる．
% 読めなければ\fol@inklを空にする．LuaTeXはfolarrow.hink，XeTeXは\XeTeXglyphboundsで，
% 最初の字形（\longrightarrowならU+27F6，伸びる矢印ならマイナス記号）の左の余白と，
% 最後の字形（U+27F6か→）の右の余白から求める．
\def\fol@hink#1#2#3{\let\fol@inkl\@empty
  \ifdefined\fol@uselua
    \edef\@tempa{\directlua{folarrow.hink(\number#2)}}%
    \ifx\@tempa\@empty\else\expandafter\fol@hink@split\@tempa\@nil\fi
  \else\ifdefined\XeTeXglyphbounds
    \fol@setff#1\fol@hfamily\fol@fam
    \ifnum\XeTeXfonttype\fol@ff\fol@fam=\tw@
      \begingroup
        \the\fol@ff\fol@fam\relax
        \ifx\@empty#3\@empty
          \count@=\XeTeXcharglyph"27F6 \count@ii=\count@
        \else
          \count@=\XeTeXcharglyph"2212 \count@ii=\XeTeXcharglyph"2192
        \fi
        \@tempdima=\XeTeXglyphbounds1 \count@
        \@tempdimb=\wd#2\advance\@tempdimb-\XeTeXglyphbounds3 \count@ii
        \xdef\fol@hink@tmp{\strip@pt\@tempdima\space\strip@pt\@tempdimb}%
      \endgroup
      \expandafter\fol@hink@split\fol@hink@tmp\@nil
    \fi
  \fi\fi}
\def\fol@hink@split#1 #2\@nil{\def\fol@inkl{#1}\def\fol@inkr{#2}}
\newcount\count@ii
\def\fol@rotv#1#2#3{%
  \def\@tempa{#3}%
  \ifx\@tempa\@empty
    \setbox\z@\hbox{$\m@th#1\fol@longright$}%
    \chardef\fol@hkindnum=\z@
  \else
    \setbox\z@\hbox to#3{\rightarrowfill@#1}%
    \chardef\fol@hkindnum=\@ne
  \fi
  \def\fol@hdir{1}%
  \fol@hmetrics#1\fol@getaxis#1\fol@getbox\z@
  \let\fol@vaxis\fol@axis
  \ifx\fol@glyphmid\@empty\else\let\fol@axis\fol@glyphmid\fi
  % 横向きの矢印の字面の中心（箱の基準点から）．字面の左右の端が読めればその中央，
  % 読めなければ箱の中央から実測の中心のずれを引いたもの
  \fol@hink#1\z@{#3}%
  \ifx\fol@inkl\@empty
    \edef\fol@cx{\fpeval{\fol@wd/2-\fol@off}}%
  \else
    \edef\fol@cx{\fpeval{(\fol@inkl+\fol@inkr)/2}}%
  \fi
  \edef\fol@cy{\fpeval{\fol@axis+\fol@acr}}%
  % 回したあと（\rotateboxは回した外接矩形の左端を基準点に置く）の字面の中心の横位置と，
  % 字面の中心を数式の軸に合わせるための上げ幅
  \ifnum#2<\z@
    \edef\fol@x{\fpeval{\fol@cy+\fol@dp}}%
    \edef\fol@r{\fpeval{\fol@vaxis+\fol@cx}}%
    \setbox\z@\hbox{\rotatebox{-90}{\box\z@}}%
  \else
    \edef\fol@x{\fpeval{\fol@ht-\fol@cy}}%
    \edef\fol@r{\fpeval{\fol@vaxis-\fol@cx}}%
    \setbox\z@\hbox{\rotatebox{90}{\box\z@}}%
  \fi
  \hbox{\fol@strokes{\fol@x}{\fol@vaxis}{0}{#2}{\fol@b}{\fol@t}%
    \raise\fol@r\p@\box\z@}}

%% ---------------------------------------------------------------
%% 本文用の矢印のフォント
%%   主な数式フォント（CM，Latin Modern，newtx，txfonts，newpx，pxfonts）には，
%%   記号フォントの→（またはマイナス記号と→）の字形に3本線を加えたType 1フォントを
%%   用意してある（元のフォントから作成した．文字0から順に→←↓↑）．
%%   \rightarrowを持つ記号フォントの名前がfolarrow-glyphs.defにあり，形のキーが既定値
%%   のままなら，本文用の矢印はそのフォントの字形で組む．フォントは記号フォントと同じ
%%   大きさで読む．そうでなければ（unicode-mathのOpenTypeフォントなど）これまでどおり
%%   描く．テキストとしては→←↓↑（U+2192，U+2190，U+2193，U+2191）になる．
%% ---------------------------------------------------------------
\def\fol@glyphfont#1#2{\@namedef{fol@G@#1}{#2}}
\iffol@lite\else \InputIfFileExists{folarrow-glyphs.def}{}{}\fi
% OpenTypeの数式フォント（unicode-math）用のOTF：\fol@otfglyphfont{見分ける文字列}{ファイル名}．
% 見分ける文字列は，元のフォントのファイル名，PostScript名，フルネーム，ファミリー名を小文字に
% して英数字だけ残したもの．\fontnameからフォント名の部分（「name:」や「[…]」の中，
% 「:」や「/OT」の前）を取り出して同じようにしたものと，完全に一致すれば使う．
% 文字はUnicodeの位置（→U+2192，←U+2190，↓U+2193，↑U+2191）にある．
\ifdefined\XeTeXrevision\def\fol@otfok{}\fi
\ifdefined\directlua\def\fol@otfok{}\fi
\iffol@lite \let\fol@otfok\@undefined \fi
\ifdefined\fol@otfok
  \def\fol@otfglyphfont#1#2{\@namedef{fol@O@#1}{#2}}
  \def\fol@otfrotv#1{\@namedef{fol@RV@#1}{}\def\fol@hasrotv{}}
  \ifdefined\XeTeXrevision
    \let\fol@otfrotvxe\fol@otfrotv
  \else
    \def\fol@otfrotvxe#1{}
  \fi
  \InputIfFileExists{folarrow-otf.def}{}{}
\fi

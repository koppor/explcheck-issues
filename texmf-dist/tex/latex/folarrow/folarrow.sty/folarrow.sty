%% (see the file LICENSE). The arrow fonts of the package keep the licenses of
%% their original fonts (see licenses/FONTS.md).
%%
\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{folarrow}[2026/10/10 v20261010.0 foliated arrows for amscd, xy-pic and tikz-cd]
\RequirePackage{pict2e}
\RequirePackage{graphics}

%% ---------------------------------------------------------------
%% パラメータ
%%   span：斜線の長さ（矢頭の幅に対する比）
%%   lean：斜線の傾き（長さに対する，矢印方向へのずれの比）
%%   gap：斜線の間隔（矢頭の幅に対する比）
%%   shift：矢印の中央から根元側へずらす量（矢頭の幅に対する比）
%%   thickness：斜線の太さ（空なら矢印の軸の太さ．下の「矢頭の幅と線の太さ」を参照）
%%   glyphs：本文用の矢印（\folrightarrowなど）に，用意したフォントの字形を使うか
%%     （true／false．下の「本文用の矢印のフォント」を参照）
%%   lite：簡易版（パッケージの読み込み時だけ指定できる）．ほかのファイル（folarrow.lua，
%%     folarrow-fonts.def，folarrow-glyphs.def，folarrow-otf.def，矢印のフォントとマップファイル）
%%     を一切使わず，すべての矢印を描いて組む．
%%     矢頭の幅と線の太さは，XeTeX＋OpenTypeの数式フォントなら\XeTeXglyphboundsで読み，
%%     それ以外はフォントの寸法から推定する．3本線は矢印の箱の中央に置く（字面の中心との
%%     ずれは補正しない）．
%% ---------------------------------------------------------------
\def\fol@span{1.0}
\def\fol@lean{0.25}
\def\fol@gap{0.35}
\def\fol@shift{0}
\def\fol@thickness{}
\newif\iffol@glyphs \fol@glyphstrue
\newif\iffol@lite
% 形のキーがすべて既定値か（本文用の矢印にフォントの字形を使えるか）．キーを設定するたびに判定する
\newif\iffol@defaultshape \fol@defaultshapetrue
% キーの値は設定のときに確かめる．数でないもの，範囲の外の値はエラーにして，前の値のままにする．
%   \fol@setnum{キー}{マクロ}{値}{範囲の条件（fpの式．##1が値）}{範囲の説明}
\ExplSyntaxOn
\cs_new_protected:Npn \fol@setnum #1#2#3#4#5
  {
    \regex_match:nnTF { \A\s*[+\-]?(\d+\.?\d*|\.\d+)([eE][+\-]?\d+)?\s*\Z } {#3}
      {
        \fp_compare:nTF {#4}
          { \tl_set:Nx #2 { \fp_eval:n {#3} } }
          { \msg_error:nnnnn { folarrow } { range } {#1} {#3} {#5} }
      }
      { \msg_error:nnnnn { folarrow } { number } {#1} {#3} {#5} }
    \fol@checkdefault
  }
\cs_new_protected:Npn \fol@setthickness #1
  {
    \tl_if_blank:nTF {#1}
      { \tl_clear:N \fol@thickness }
      {
        \regex_match:nnTF
          { \A\s*(([+\-]?(\d+\.?\d*|\.\d+)\s*(pt|bp|mm|cm|in|pc|dd|cc|sp|em|ex|px|nd|nc))|\\[A-Za-z@]+)\s*\Z } {#1}
          {
            \dim_compare:nNnTF {#1} < { 0pt }
              { \msg_error:nnnnn { folarrow } { range } { thickness } {#1} { a~non-negative~length } }
              { \tl_set:Nn \fol@thickness {#1} }
          }
          { \msg_error:nnnnn { folarrow } { number } { thickness } {#1} { a~length~such~as~0.4pt } }
      }
    \fol@checkdefault
  }
\cs_new_protected:Npn \fol@checkdefault
  {
    \bool_lazy_and:nnTF
      { \tl_if_empty_p:N \fol@thickness }
      { \fp_compare_p:n { abs(\fol@span-1) + abs(\fol@lean-0.25) + abs(\fol@gap-0.35) + abs(\fol@shift) < 0.0001 } }
      { \fol@defaultshapetrue } { \fol@defaultshapefalse }
  }
\msg_new:nnnn { folarrow } { number }
  { Invalid~value~'#2'~for~the~key~'#1'. }
  { The~value~must~be~#3.~The~previous~value~is~kept. }
\msg_new:nnnn { folarrow } { range }
  { The~value~'#2'~for~the~key~'#1'~is~out~of~range. }
  { The~value~must~be~#3.~The~previous~value~is~kept. }
\ExplSyntaxOff
\DeclareKeys[folarrow]{
  span.code       = \fol@setnum{span}\fol@span{#1}{#1>0 && #1<=10}{a number greater than 0 and at most 10},
  lean.code       = \fol@setnum{lean}\fol@lean{#1}{abs(#1)<=5}{a number between -5 and 5},
  gap.code        = \fol@setnum{gap}\fol@gap{#1}{#1>=0 && #1<=10}{a number between 0 and 10},
  shift.code      = \fol@setnum{shift}\fol@shift{#1}{abs(#1)<=10}{a number between -10 and 10},
  thickness.code  = \fol@setthickness{#1},
  glyphs.if       = fol@glyphs,
  lite.if         = fol@lite,
  lite.usage      = load,
}
\ProcessKeyOptions[folarrow]
% 簡易版では，ほかのファイルを使わない（フォントの字形も使わない）
\iffol@lite \fol@glyphsfalse \fi
% LuaTeXのグリフ情報（folarrow.lua）を使うか
\ifdefined\directlua \iffol@lite\else \def\fol@uselua{}\fi \fi
\NewDocumentCommand\folarrowsetup{m}{\SetKeys[folarrow]{#1}}

%% ---------------------------------------------------------------
%% 描画の核
%%   \fol@strokes{cx}{cy}{ux}{uy}{b}{t}
%%   (cx,cy)：3本の中心（pt単位の数），(ux,uy)：矢印の向きの単位ベクトル，
%%   b：矢頭の幅（pt），t：線の太さ（pt）．
%%   斜線の向きは ±lean×u＋n（nはuを左に90°回した法線）で，右上がりに
%%   なるほうの符号を選ぶ．横向きなら「///」，縦向きなら右上がりの
%%   ほぼ水平な3本になる．
%%   現在位置を原点とする幅0の箱に描く．
%%   線の端は\fol@capに従う：r（丸）なら丸い端，b（切りっぱなし）なら切りっぱなし．
%%   矢印の尻（軸の端）の形に合わせる．丸い端は線の太さの半分だけ外にはみ出すので，
%%   見た目の長さがそろうよう，そのぶん短く引く．
%% ---------------------------------------------------------------
\def\fol@cap{b}
\def\fol@cap@r{r}
\def\fol@off{0}
\def\fol@acr{0}
\def\fol@strokes#1#2#3#4#5#6{%
  \begingroup
  \edef\fol@s{\fpeval{\fol@span*(#5)}}%
  \ifx\fol@cap\fol@cap@r
    \edef\fol@k{\fpeval{max(0,\fol@s-(#6))/\fol@s}}%
  \else
    \def\fol@k{1}%
  \fi
  \edef\fol@sg{\fpeval{
      ((\fol@lean*(#3)-(#4))*(\fol@lean*(#4)+(#3)) >= 0) ? 1 : -1}}%
  % 斜線の半分のベクトル
  \edef\fol@vx{\fpeval{0.5*\fol@k*\fol@s*(\fol@sg*\fol@lean*(#3)-(#4))}}%
  \edef\fol@vy{\fpeval{0.5*\fol@k*\fol@s*(\fol@sg*\fol@lean*(#4)+(#3))}}%
  % 斜線どうしの間隔のベクトル
  \edef\fol@dx{\fpeval{\fol@gap*(#5)*(#3)}}%
  \edef\fol@dy{\fpeval{\fol@gap*(#5)*(#4)}}%
  \unitlength=1pt
  % タグ付けしたPDF（\DocumentMetadata{tagging=on}など）では，3本線は図ではなく飾り（artifact）にする
  \expandafter\ifx\csname l_tag_graphic_mode_tl\endcsname\relax\else
    \@namedef{l_tag_graphic_mode_tl}{artifact}%
  \fi
  \hbox to\z@{%
    \fol@tatebegin
    \begin{picture}(0,0)%
      \linethickness{#6pt}%
      \ifx\fol@cap\fol@cap@r\roundcap\else\buttcap\fi
      \fol@oneline{#1}{#2}{-1}%
      \fol@oneline{#1}{#2}{0}%
      \fol@oneline{#1}{#2}{1}%
    \end{picture}\fol@tateend\hss}%
  \endgroup}
% pTeX／upTeXの縦組み（dvipdfmx）では，pict2eのPDFの描画命令が縦組みに合わせて回らないので，
% -90°回して描く．\iftdirはpTeX系にしかないので，\csnameで呼ぶ（ほかのエンジンで\ifと\fiの
% 対応が崩れないように）．LuaTeX-jaの縦組みでは回さなくても正しい．
% （定義の本体に\fiを含むので，条件分岐の中には書かず，\@gobbleか\@firstofoneで選ぶ）
\let\fol@tatebegin\relax \let\fol@tateend\relax
\ifdefined\directlua\expandafter\@gobble\else\expandafter\@firstofone\fi
  {\@ifundefined{iftdir}{}{%
    \def\fol@tatebegin{\csname iftdir\endcsname\special{pdf:btrans rotate -90}\fi}%
    \def\fol@tateend{\csname iftdir\endcsname\special{pdf:etrans}\fi}}}
\def\fol@oneline#1#2#3{%
  \Line(\fpeval{(#1)+(#3)*\fol@dx-\fol@vx},\fpeval{(#2)+(#3)*\fol@dy-\fol@vy})%
       (\fpeval{(#1)+(#3)*\fol@dx+\fol@vx},\fpeval{(#2)+(#3)*\fol@dy+\fol@vy})}

%% ---------------------------------------------------------------
%% 矢頭の幅と線の太さ：\fol@b（矢頭の幅）と\fol@t（線の太さ）をpt単位の数で決める
%%   \fol@hmetrics{style}：横向きの矢印（\rightarrow系の文字）
%%   \fol@vmetrics{style}{box}{kind}：縦向きの矢印の箱．kindはbig（\Big\downarrowなど）
%%                                  またはinl（\foldownarrowの土台）
%% 次の順に試す．
%%   1. LuaTeXでOpenTypeの数式フォントなら，グリフの外接矩形から直接求める（folarrow.lua）．
%%   2. 矢印の文字を持つフォントの名前が実測データ（folarrow-fonts.def）にあれば，
%%      そのquadに実測の比を掛ける．\rightarrowは数式文字コードから，縦向きの矢印は
%%      \downarrowの区切り記号コードから，実際に使われるフォントを求める．
%%   3. どちらもなければ，箱の寸法とフォントのパラメーターから推定する．
%% thicknessキーが空でなければ，線の太さはその値にする．
%% ---------------------------------------------------------------
\def\fol@setff#1{% #1が\displaystyleなどのとき，\fol@ffを\textfontなどにする
  \ifx#1\scriptscriptstyle\let\fol@ff\scriptscriptfont
  \else\ifx#1\scriptstyle\let\fol@ff\scriptfont
  \else\let\fol@ff\textfont\fi\fi}
\newbox\fol@refbox

% 1. LuaTeX：グリフの外接矩形から（簡易版では使わない）
\ifdefined\fol@uselua
  \directlua{require('folarrow')}
  \def\fol@luaextent#1#2{% #1：箱の番号，#2：true（縦向き）かfalse
    \edef\fol@lua{\directlua{folarrow.extent(\number#1, #2)}}}
\else
  \def\fol@luaextent#1#2{\let\fol@lua\@empty}
\fi
\def\fol@splitlua#1 #2 #3 #4\@nil{\def\fol@b{#1}\def\fol@t{#2}\def\fol@otfkey{#3}\def\fol@glyphmid{#4}}
% 矢頭の上下の中心（ベースラインからの高さ，pt）．グリフから読めたときだけ設定する
\let\fol@glyphmid\@empty

% 1'. XeTeX：OpenTypeの数式フォントなら\XeTeXglyphboundsでグリフの外接矩形を読む
% \fol@xeextent{家族番号}{文字コード}{hかv}（フォントは\fol@ffで選んだスタイルのもの）：矢頭の幅（横向きは→の高さ＋深さ，縦向きは↓の
% 字面の幅）と，マイナス記号の高さ＋深さ（線の太さ）を\fol@luaに「幅 太さ」で入れる．
% 添字用の字形（ssty）や\Bigの大きい字形は読めないので，元の字形の値になる．
\ifdefined\XeTeXglyphbounds
  \def\fol@xeextent#1#2#3{%
    \ifnum\XeTeXfonttype\fol@ff#1 =\tw@
      \setbox\@tempboxa\hbox{\the\fol@ff#1\relax
        \count@=\XeTeXcharglyph#2\relax
        \if#3v%
          \setbox\@tempboxa\hbox{\XeTeXglyph\count@}%
          \@tempdima=\wd\@tempboxa
          \advance\@tempdima-\XeTeXglyphbounds1 \count@
          \advance\@tempdima-\XeTeXglyphbounds3 \count@
          \@tempdimc=\z@
        \else
          \@tempdima=\XeTeXglyphbounds2 \count@
          \advance\@tempdima\XeTeXglyphbounds4 \count@
          % 矢頭の上下の中心：（上端の高さ－下端の深さ）／2
          \@tempdimc=\XeTeXglyphbounds2 \count@
          \advance\@tempdimc-\XeTeXglyphbounds4 \count@
          \divide\@tempdimc\tw@
        \fi
        \count@=\XeTeXcharglyph"2212\relax
        \@tempdimb=\XeTeXglyphbounds2 \count@
        \advance\@tempdimb\XeTeXglyphbounds4 \count@
        \xdef\fol@xe@tmp{\strip@pt\@tempdima\space\strip@pt\@tempdimb}%
        \xdef\fol@xe@mid{\strip@pt\@tempdimc}}%
      \ifx\fol@xe@tmp\fol@xe@zero\else
        \fol@xecorrect{\fol@ff#1}{#3}%
        \let\fol@lua\fol@xe@tmp
      \fi
    \fi}
  \def\fol@xe@zero{0.0 0.0}
  % フォントごとの補正（folarrow.luaの表と同じ実測値．XeTeXでは\Bigの大きい字形を
  % 読めないので，KpMathは\Bigの矢頭の幅も補正する）
  \ExplSyntaxOn
  \cs_new_protected:Npn \fol@xecorrect #1#2
    {
      \str_set:Nx \l__fol_str { \str_lowercase:f { \fontname #1 } }
      \regex_replace_all:nnN { [^a-z0-9] } { } \l__fol_str
      \tl_set:Nn \l_tmpa_tl { 1 } % 太さ
      \tl_set:Nn \l_tmpb_tl { 1 } % 幅
      \str_if_in:NnT \l__fol_str { asanamath } { \tl_set:Nn \l_tmpa_tl { 1.058 } }
      \str_if_in:NnT \l__fol_str { gfsneohellenicmath } { \tl_set:Nn \l_tmpa_tl { 0.815 } }
      \str_if_eq:nnT {#2} { v }
        {
          \str_if_in:NnT \l__fol_str { minionmath } { \tl_set:Nn \l_tmpa_tl { 1.16 } }
          \str_if_in:NnT \l__fol_str { gfsneohellenicmath } { \tl_set:Nn \l_tmpa_tl { 0.79 } }
          \str_if_in:NnT \l__fol_str { kpmath }
            { \tl_set:Nn \l_tmpa_tl { 1.087 } \tl_set:Nn \l_tmpb_tl { 0.917 } }
        }
      \exp_after:wN \__fol_xe_apply:w \fol@xe@tmp \q_stop
    }
  \cs_new_protected:Npn \__fol_xe_apply:w #1~#2 \q_stop
    {
      \tl_gset:Nx \fol@xe@tmp
        { \fp_eval:n { #1 * \l_tmpb_tl } ~ \fp_eval:n { #2 * \l_tmpa_tl } ~ \l__fol_str \c_space_tl \fol@xe@mid }
    }
  \ExplSyntaxOff
\else
  \def\fol@xeextent#1#2#3{}
\fi

% 2. 実測データ
% \fol@hdata{フォント名}{矢頭の幅/quad}{軸の太さ/quad}{\longrightarrowの尻}{伸びる矢印の尻}
%           {中心のずれ：\longrightarrow,伸びる矢印,（直交方向）\longrightarrow,伸びる矢印,
%           （左向き）\longleftarrow,伸びる矢印,（左向きの直交方向）\longleftarrow,伸びる矢印}
% \fol@vdata{フォント名}{\Bigの矢頭の幅/quad}{\Bigの軸の太さ/quad}{土台の矢頭の幅/quad}{土台の軸の太さ/quad}
%           {\Bigの尻}{土台の尻}{中心のずれ：\Bigの下向き,\Bigの上向き,土台の下向き,土台の上向き,
%           （直交方向）同じ4つ}
% \fol@otfcap{鍵}{\longrightarrowの尻}{伸びる矢印の尻}{\Bigの尻}{土台の尻}
%           {中心のずれ：\longrightarrow,伸びる矢印,\Bigの下向き,\Bigの上向き,土台の下向き,土台の上向き,
%           （直交方向）同じ6つ,（左向き）\longleftarrow,伸びる矢印,（左向きの直交方向）同じ2つ}
%           ：OpenTypeのフォント
% 尻の形はr（丸）かb（切りっぱなし）．3本線の端をこれに合わせる．
% 中心のずれは，箱の中心に置いた3本線の中心が矢印の字面の中心から矢頭の側へずれる量と，
% 軸に直交する方向（横向きは下，縦向きは右が正）にずれる量（quadに対する比）．
% 3本線をこの量だけ戻して，字面の中心（軸の上）に置く．
\def\fol@hdata#1#2#3#4#5#6{\@namedef{fol@H@#1}{{#2}{#3}{#4}{#5}{#6}}}
\def\fol@vdata#1#2#3#4#5#6#7#8{\@namedef{fol@V@#1}{{#2}{#3}{#4}{#5}{#6}{#7}{#8}}}
\def\fol@otfcaps{}
\def\fol@otfcap#1#2#3#4#5#6{\g@addto@macro\fol@otfcaps{\fol@oc{#1}{#2}{#3}{#4}{#5}{#6}}}
% \fol@otfcapxe：XeTeXで測った値（形式は\fol@otfcapと同じ）．XeTeXでは\Bigなどに選ばれる
% 字形がLuaTeXと違うことがあるので，XeTeXのときだけ使う（あとから足すので優先される）．
\ifdefined\XeTeXrevision
  \let\fol@otfcapxe\fol@otfcap
\else
  \def\fol@otfcapxe#1#2#3#4#5#6{}
\fi
\iffol@lite\else \InputIfFileExists{folarrow-fonts.def}{}{}\fi

\ExplSyntaxOn
\str_new:N \l__fol_str
\seq_new:N \l__fol_seq
% \fol@hfamily〈マクロ〉：\rightarrowの数式文字コード（\mathchar"…）から家族番号を取り出す．
% \fol@vfamily〈マクロ〉：\downarrowの区切り記号コード（\delimiter"…）から，大きい字形の
% 家族番号を取り出す．取り出せなければ既定値（2または3）にする．
\regex_const:Nn \c__fol_mathchar_regex { \\mathchar\s*\"([0-9A-Fa-f]+) }
\regex_const:Nn \c__fol_delimiter_regex { \\delimiter\s*\"([0-9A-Fa-f]+) }
% unicode-math（LuaTeX，XeTeX）：\Umathchar"類"家族"文字，\Udelimiter"類"家族"文字
\regex_const:Nn \c__fol_umath_regex
  { \\U(?:mathchar|delimiter)\s*\"([0-9A-Fa-f]+)\"([0-9A-Fa-f]+)\" }
\cs_new_protected:Npn \__fol_family:NNnN #1#2#3#4
  {
    \cs_if_exist:cTF { fol@FAM@ \token_to_meaning:N #1 }
      { \tl_set_eq:Nc #4 { fol@FAM@ \token_to_meaning:N #1 } }
      {
        \__fol_family_compute:NNnN #1#2{#3}#4
        \tl_gset_eq:cN { fol@FAM@ \token_to_meaning:N #1 } #4
      }
  }
\cs_new_protected:Npn \__fol_family_compute:NNnN #1#2#3#4
  {
    \str_set:Nx \l__fol_str { \token_to_meaning:N #1 }
    \regex_extract_once:NVNTF \c__fol_umath_regex \l__fol_str \l__fol_seq
      { \tl_set:Nx #4 { \int_from_hex:e { \seq_item:Nn \l__fol_seq { 3 } } } }
      {
        \regex_extract_once:NVNTF #2 \l__fol_str \l__fol_seq
          {
            \tl_set:Nx #4
              { \int_eval:n { \int_mod:nn { \int_div_truncate:nn
                  { \int_from_hex:e { \seq_item:Nn \l__fol_seq { 2 } } } { 256 } } { 16 } } }
          }
          { \tl_set:Nn #4 {#3} }
      }
  }
\cs_generate_variant:Nn \regex_extract_once:NnNTF { NV }
\cs_generate_variant:Nn \int_from_hex:n { e }
\cs_new_protected:Npn \fol@hfamily #1
  { \__fol_family:NNnN \rightarrow \c__fol_mathchar_regex { 2 } #1 }
\cs_new_protected:Npn \fol@vfamily #1
  { \__fol_family:NNnN \downarrow \c__fol_delimiter_regex { 3 } #1 }
% フォント名の基本部分（「 at 10.95pt」を除く）と，末尾の数字を除いたもの
\cs_new_protected:Npn \fol@basename #1
  {
    \str_set:Nx \l__fol_str { \fontname #1 }
    \regex_replace_once:nnN { [\s\\].* } { } \l__fol_str
    \tl_set:Nx \fol@fname { \l__fol_str }
    \regex_replace_once:nnN { [0-9]+\Z } { } \l__fol_str
    \tl_set:Nx \fol@fnamestem { \l__fol_str }
  }
\ExplSyntaxOff
% データを引く．#1：HかV，#2：フォント．見つかれば\fol@dataに値を入れる．
\def\fol@lookup#1#2{%
  \fol@basename{#2}%
  \expandafter\let\expandafter\fol@data\csname fol@#1@\fol@fname\endcsname
  \ifx\fol@data\relax
    \expandafter\let\expandafter\fol@data\csname fol@#1@\fol@fnamestem\endcsname
  \fi}
% 表の値の取り出し：\fol@ra（幅），\fol@rb（太さ），\fol@rc（尻の形）
% \fol@rd：中心のずれ（quadに対する比）
% \fol@re：直交方向のずれ（quadに対する比）
\def\fol@hvals#1#2#3#4#5#6\@nil{\def\fol@ra{#1}\def\fol@rb{#2}%

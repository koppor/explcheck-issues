\cs_new_protected:Npn \lx@gl@colbegin
  { \lx@tag@if@active:T { \lx@tag@span@open:n { tag = Span } } }
\cs_new_protected:Npn \lx@gl@colend
  { \lx@tag@if@active:T { \lx@tag@span@close: } }
%% #1 = tier number.  If the tier has a declared language, wrap the word
%% in its own Span with /Lang (nested in the column Span); otherwise emit
%% plain marked content as before.  Neither half of the helper fits: the

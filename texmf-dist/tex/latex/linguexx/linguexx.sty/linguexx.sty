%% The \lpzg redefinition has to be scoped by a group, the result has to
%% survive it, and the destination is a local (l_-named) token list: the
%% previous code wrote to it with \tl_gput_right: from inside the group,
%% which straddled the scope and broke the expl3 naming contract at once.
\tl_new:N \g__lxp_alt_build_tl
\int_new:N \l__lxp_alt_n_int

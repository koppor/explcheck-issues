\msg_new:nnn { calendar-grid } { bad-columns }
  { Year~overview~columns~must~be~an~integer~from~1~to~4. }
\msg_new:nnn { calendar-grid } { reversed-range }
  { Range~start~date~'#1'~must~not~be~after~'#2'. }


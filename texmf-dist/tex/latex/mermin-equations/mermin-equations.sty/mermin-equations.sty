    {\csname mermin@ph@#2\endcsname}}
 % #1 is the text printed, #2 the argument, #3 the key.
\def\mermin@warn@unprintable#1#2#3{%
  \@ifundefined{mermin@xrdef@#3}%
    {\mermin@warn{`#2' has no typeset phrase\MessageBreak
       and is not text, so it is printed verbatim;\MessageBreak
       where it is defined, write\MessageBreak
       \mermin@akacs[<phrase>]{#3}}}%
    {\mermin@warn{`#2' has no typeset phrase\MessageBreak
       and is not text, so it is printed verbatim;\MessageBreak
       give it a phrase in the document\MessageBreak
       that defines `#1'}}}
\def\mermin@pdf@eq#1{\mermin@resolve{#1}{\mermin@pdf@cite{#1}}}
\def\mermin@pdf@cite#1#2{%
  \@ifundefined{mermin@ph@#2}%
    {\mermin@keytext{#1}{#2}\@firstofone}%
    {\csname mermin@ph@#2\endcsname}%
  \space(\ref{#2})}
\ExplSyntaxOn
 % The pieces of one command: its name, an optional <overlay>, an
 % optional [phrase], and the {key}.  A phrase or key may hold brace
 % groups one level deep, as in [\emph{x}] or {a{b}}; a lazy .*? would
 % instead run on to the title's last closing brace.
\tl_const:Nn \c__mermin_overlay_tl { (?: \< \c[^BE][^\>]* \> )? }
\tl_const:Nn \c__mermin_phrase_tl
  { (?: \[ (?: \c[^BE][^\]] | \cB. \c[^BE]* \cE. )* \] )? }
\tl_const:Nn \c__mermin_key_tl
  { \cB. (?: \c[^BE]. | \cB. \c[^BE]* \cE. )* \cE. }
\cs_new:Npn \__mermin_aka_one:n #1
  {
    \exp_not:n { \c{(?:#1)} }
    \exp_not:V \c__mermin_overlay_tl
    \exp_not:V \c__mermin_phrase_tl
    \exp_not:V \c__mermin_key_tl
  }
 % A run of the commands at the end of the title goes with the spaces
 % around it; one anywhere else goes alone, and its spaces stay.
\cs_new:Npn \__mermin_aka_pattern:n #1
  {
    \exp_not:n { \s* (?: } \__mermin_aka_one:n {#1}
    \exp_not:n { \s* )+ \Z | } \__mermin_aka_one:n {#1}
  }
\exp_args:NNx \regex_const:Nn \c__mermin_aka_regex
  { \__mermin_aka_pattern:n { aka|alsolabel|mermin@alsolabel } }
\exp_args:NNx \regex_const:Nn \c__mermin_long_regex
  { \__mermin_aka_pattern:n { alsolabel|mermin@alsolabel } }
\cs_new_protected:Npn \mermin@stripaka
  {
    \ifx \aka \alsolabel
      \regex_replace_all:NnN \c__mermin_aka_regex { }
        \GetTitleStringResult
    \else
      \regex_replace_all:NnN \c__mermin_long_regex { }
        \GetTitleStringResult
    \fi
  }
\ExplSyntaxOff
\AddToHook{begindocument/end}{%
   % nameref, through gettitlestring, takes section and caption names
   % from their titles; this is its default, non-expanding method.
  \ifdefined\GetTitleStringNonExpand
    \let\mermin@gts@orig\GetTitleStringNonExpand
    \def\GetTitleStringNonExpand#1{%
      \mermin@gts@orig{#1}\mermin@stripaka}%
  \fi}
 % l_text_case_exclude_arg_tl exists in LaTeX 2022-06 and later.
\AddToHook{begindocument/end}{%
  \@ifundefined{l_text_case_exclude_arg_tl}{}{%
    \@xp\g@addto@macro\csname l_text_case_exclude_arg_tl\endcsname
      {\eqcite\mermin@alsolabel}%
    \ifx\eq\eqcite
      \@xp\g@addto@macro\csname l_text_case_exclude_arg_tl\endcsname
        {\eq}%
    \fi}}
\def\mermin@akacs{\string\alsolabel}
\def\mermin@eqcs{\string\eqcite}
\def\mermin@shortname#1#2{%
  \@ifundefined{#1}%
    {\@xp\let\csname #1\endcsname#2}%
    {\mermin@warn@noline{\@backslashchar#1
      was already defined, by a package or\MessageBreak
      the preamble, and is left alone;\MessageBreak
      write \string#2\space instead}}}
 % env/document/begin, not begindocument/before or later: beamer builds
 % the PDF title, which may hold \eq, in this same hook (ordered after
 % this code by the rule below), and its themes typeset section titles
 % in \AtBeginDocument code.
\AddToHook{env/document/begin}[mermin-equations]{%
  \mermin@shortname{eq}\eqcite
  \mermin@shortname{aka}\alsolabel
  \ifx\aka\alsolabel\def\mermin@akacs{\string\aka}\fi
  \ifx\eq\eqcite\def\mermin@eqcs{\string\eq}\fi
  \ifdefined\pdfstringdefDisableCommands
    \pdfstringdefDisableCommands{%
       % Test the short names before the long ones change.
      \ifx\aka\alsolabel\let\aka\mermin@gobble@aka\fi
      \ifx\eq\eqcite\let\eq\mermin@pdf@eq\fi
      \let\alsolabel\mermin@gobble@aka
      \let\eqcite\mermin@pdf@eq
       % latexdiff's markers, which this package makes robust.
      \let\DIFdelbegin\@empty
      \let\DIFdelend\@empty
       % Neither of Mermin's rules is for bookmarks.
      \let\eqref\mermin@eqref
      \ifdefined\mermin@maketag\let\maketag@@@\mermin@maketag\fi}%
  \fi}
\DeclareHookRule{env/document/begin}
  {mermin-equations}{before}{beamer}
\newif\ifmermin@numbered
\def\mermin@fisher@begin{\global\mermin@numberedfalse}
\def\mermin@fisher@after#1{%
  \ifmermin@numbered\else\ifmermin@deleted\else
  \ifnum\mermin@slide>\@ne\else
    \mermin@warn{%
      `#1' display without a number.\MessageBreak
      Fisher's rule: number every display\MessageBreak
      (option nofisher)}%
  \fi\fi\fi}
 % beamer typesets a frame once per overlay slide; warn on the first.
 % A number, tested with a real \ifnum: a macro expanding to \ifnum
 % would not be counted as a conditional when TeX skips a branch.
\def\mermin@slide{%
  \ifdefined\beamer@slideinframe\beamer@slideinframe\else1\fi}
\def\mermin@fisherenv#1{%
  \AddToHook{env/#1/begin}{\mermin@fisher@begin}%
  \AddToHook{env/#1/after}{\mermin@fisher@after{#1}}}
 % A macro of its own: written inline, a false \ifmermin@fisher would
 % take the showonlyrefs test's \else and \fi as its own.
\def\mermin@fisher@install{%
     % mathtools' showonlyrefs: \MH_if_boolean_show_only_refs: is
     % \iftrue or \iffalse.
    \@ifundefined{MH_if_boolean_show_only_refs:}{\@secondoftwo}%
      {\csname MH_if_boolean_show_only_refs:\endcsname
         \@xp\@firstoftwo\else\@xp\@secondoftwo\fi}%
      {\mermin@warn@noline{%
         mathtools' showonlyrefs numbers only the\MessageBreak
         equations that are cited, which Mermin calls\MessageBreak
         Occam's rule; Fisher's rule numbers them all\MessageBreak
         (option nofisher silences this)}}%
      {\let\mermin@maketag\maketag@@@
       \def\maketag@@@{\global\mermin@numberedtrue\mermin@maketag}%
       \let\mermin@eqnnum\@eqnnum
       \def\@eqnnum{\global\mermin@numberedtrue\mermin@eqnnum}%
        % \[ is equation* under amsmath, and so is displaymath, which
        % would otherwise be checked twice.
       \@for\mermin@env:=%
           equation,equation*,align,align*,gather,gather*,%
           multline,multline*,flalign,flalign*,alignat,alignat*,%
           eqnarray,eqnarray*%
         \do{\@xp\mermin@fisherenv\@xp{\mermin@env}}%
        % empheq typesets its inner environment twice, the second time
        % with \maketag@@@ replaced by a \vphantom: check empheq as a
        % whole, and silence the inner environment's own check.
       \AddToHook{env/empheq/begin}{%
         \mermin@fisher@begin
         \let\mermin@fisher@begin\relax
         \let\mermin@fisher@after\@gobble}%
       \AddToHook{env/empheq/after}{\mermin@fisher@after{empheq}}}}
\AddToHook{begindocument/end}{%
  \ifmermin@fisher\@xp\mermin@fisher@install\fi}
 % A first copy now, for beamer, which typesets its title, perhaps with
 % \eq, before begindocument/end; the copy is refreshed there.
\NewCommandCopy\mermin@eqref\eqref
 % An \eqref in a display typesets its number through \maketag@@@ too;
 % \mermin@keepflag runs #1 without letting it count as the display's
 % own number.
\def\mermin@keepflag#1{%
  \ifmermin@numbered\@xp\@firstofone\else\@xp\mermin@keepflag@\fi{#1}}
\def\mermin@keepflag@#1{#1\global\mermin@numberedfalse}
\def\mermin@samaritan#1{%
   % Warn once: not in amsmath's measuring pass, nor caption's
   % single-line check (\label is \caption@gobble there), nor on a later
   % beamer slide; the table of contents is handled below.
  \ifx\label\caption@gobble\else\ifmeasuring@\else
  \ifnum\mermin@slide>\@ne\else
  \ifdefined\mermin@signed
    \@ifundefined{r@#1}{}{\@ifundefined{mermin@eq@#1}{}{%
      \mermin@warn{%
        `#1' is cited by number alone.\MessageBreak
        Good Samaritan rule: name it, as \mermin@eqcs\space does%
        \MessageBreak
        (option nosamaritan)}}}%
  \fi\fi\fi\fi}
\AddToHook{begindocument/end}{%
   % A command copy, not \let, since \eqref is robust.  mathtools'
   % showonlyrefs, or the document, may have redefined \eqref by now;
   % the copy keeps their version.
  \DeclareCommandCopy\mermin@eqref\eqref
  \ifmermin@samaritan
     % \protected, not \DeclareRobustCommand: that would redefine the
     % inner command `\eqref ', which a \let copy of \eqref made earlier
     % (\let\oldeqref\eqref, or refcheck's) still calls, and the two
     % would call each other forever.  Bookmarks use the original.
    \protected\def\eqref#1{%
      \mermin@samaritan{#1}\mermin@keepflag{\mermin@eqref{#1}}}%
     % cleveref's \cref, \Cref, and \labelcref, starred or not, pass
     % their list of keys to \@cref, with their own name as #1; so do
     % its page references (\cpageref, and varioref's \vref), which
     % cite a page, not an equation, and are not checked.
    \ifdefined\@cref
      \let\mermin@cref\@cref
      \def\@cref#1#2{%
        \in@{,#1,}{,cref,Cref,labelcref,}%
        \ifin@
          \@for\mermin@k:=#2\do{\@xp\mermin@samaritan\@xp{\mermin@k}}%
        \fi
        \mermin@cref{#1}{#2}}%
    \fi
     % Reading back the table of contents or list of figures would warn
     % again for each citation in a title or caption.
    \let\mermin@starttoc\@starttoc
    \def\@starttoc#1{%
      {\let\mermin@samaritan\@gobble\mermin@starttoc{#1}}}%
  \fi}

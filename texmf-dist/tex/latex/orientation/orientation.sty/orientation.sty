\AtBeginDocument{\orientation@init}
\newcommand{\orientation@shipout}{%
\ifx\orientation@page\@empty
\let\orientation@angle\orientation@default
\else
\let\orientation@angle\orientation@page
\fi
\ifx\orientation@angle\@empty\else
\expandafter\orientation@apply\expandafter{\orientation@angle}%
\fi
}
\AddToHook{shipout/before}[orientation]{%
\global\let\orientation@restore\@empty
\orientation@before
}
\AddToHook{shipout/background}[orientation]{%
\orientation@background
\global\let\orientation@page\@empty
}
\AddToHook{shipout/after}[orientation]{\orientation@restore}

\cs_new_protected:Npn \orientation@init
{
\ifpdf
\ifluatex
\def\orientation@driver{luatex}
\cs_set:Npn \orientation@pageattr { \pdfvariable pageattr }
\else
\def\orientation@driver{pdftex}
\cs_set_eq:NN \orientation@pageattr \pdfpageattr
\fi
\else
\ifxetex
\def\orientation@driver{dvipdfmx}
\else
%use dvips by default
\def\orientation@driver{dvips}
\cs_if_exist:NT \c_sys_backend_str
{ \str_if_eq:VnT \c_sys_backend_str {dvipdfmx}
{ \def\orientation@driver{dvipdfmx} } }
\cs_if_exist:NT \Gin@driver
{ \str_case:Vn \Gin@driver
{ {dvipdfmx.def}{\def\orientation@driver{dvipdfmx}}
{dvipdfm.def}{\def\orientation@driver{dvipdfmx}} } }
\str_case:Vn \orientation@option
{ {dvips}{\def\orientation@driver{dvips}}
{dvipdfmx}{\def\orientation@driver{dvipdfmx}} }
\fi
\fi
\tl_if_empty:NF \orientation@option
{
\str_if_eq:VVF \orientation@option \orientation@driver
{ \PackageError{orientation}
{Driver~`\orientation@option'~is~incompatible~with~this~engine/output~mode}
{Remove~the~driver~option~or~select~\orientation@driver.} }
}
\str_case:Vn \orientation@driver
{
{pdftex}{\cs_set_eq:NN \orientation@apply \orientation@native}
{luatex}{\cs_set_eq:NN \orientation@apply \orientation@native}
{dvips}{\cs_set_protected:Npn \orientation@apply ##1
{ \special{ps:[{ThisPage}~<</Rotate~##1>>~/PUT~pdfmark~true} }}
{dvipdfmx}{\cs_set_protected:Npn \orientation@apply ##1
{ \special{pdf:put~@thispage~<</Rotate~##1>>} }}
}
\cs_if_exist:NT \pdfmanagement_if_active:T
{
\pdfmanagement_if_active:T
{
\tl_set:Nx \l_tmpa_tl {\c_sys_backend_str}
\str_if_eq:VnT \l_tmpa_tl {xetex}
{ \tl_set:Nn \l_tmpa_tl {dvipdfmx} }
\str_if_eq:VVF \l_tmpa_tl \orientation@driver
{ \PackageError{orientation}{PDF~management~backend~mismatch}
{Select~the~same~backend~in~\string\DocumentMetadata
~and~orientation.} }
\cs_set_eq:NN \orientation@apply \orientation@managed
% LuaTeX keeps Page defaults in Lua; override
\ifluatex
\cs_set_protected:Npn \orientation@apply ##1
{ \pdfmanagement_add:nnn {ThisPage}{Rotate}{##1} }
\fi
}
}

    \bool_set:Nn \l__mpformulation_force_lhs_bool
      {
        \str_if_eq_p:ee { \@constraint@lhsbreakmode } { always }
        && \int_compare_p:nNn { \seq_count:N \l__mpformulation_lhs_seq } > 1

    \bool_if:NF \l__mpformulation_done_bool
      {
        \hbox_set:Nn \l__mpformulation_right_box { }
        \__mpformulation_row:n { \constraintMinIndent }
        \__mpformulation_rhs_below:n {#3}
      }
    \bool_if:NF \l__mpformulation_measure_bool
      { \tl_if_blank:nF {#1} { \label {#1} } }
    \group_end:
    \par
    \vspace { \constraintSep }
  }

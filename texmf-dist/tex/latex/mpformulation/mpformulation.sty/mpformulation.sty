        \hbox_set:Nn \l__mpformulation_left_box
          { $ \displaystyle \l__mpformulation_last_tl $ }
        \dim_set:Nn \l__mpformulation_avail_dim
          {
            \linewidth - \l__mpformulation_indent_dim - \constraintExprContIndent
            - \box_wd:N \l__mpformulation_left_box
            - \constraintQuantGap - \l__mpformulation_num_dim

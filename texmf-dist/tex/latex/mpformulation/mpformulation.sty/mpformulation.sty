    % Quantifier parts (split at \\), quantifier suffix on the last part
    \seq_set_split:Nnn \l__mpformulation_rhs_seq { \\ } {#3}
    \seq_pop_right:NN \l__mpformulation_rhs_seq \l__mpformulation_last_tl
    \tl_put_right:NV \l__mpformulation_last_tl \l__mpformulation_suffix_tl
    \seq_put_right:NV \l__mpformulation_rhs_seq \l__mpformulation_last_tl
    \tl_set:Nx \l__mpformulation_rhs_tl
      { \seq_use:Nn \l__mpformulation_rhs_seq { \exp_not:n { \  } } }

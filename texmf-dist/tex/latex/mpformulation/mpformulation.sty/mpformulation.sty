    % (a) One line
    \bool_if:nT
      {
        ! \l__mpformulation_done_bool
        && ! \l__mpformulation_force_rhs_bool && ! \l__mpformulation_force_lhs_bool
        && \dim_compare_p:nNn
          {
            \linewidth - \l__mpformulation_lhs_dim - \constraintQuantGap
            - \l__mpformulation_rhs_dim - \l__mpformulation_num_dim

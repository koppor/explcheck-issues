  {
    \bool_if:NF \l__mpformulation_measure_bool { \@constraint@autost }
    \par
    % Keep the last constraint with the previous one (keep_last)
    \bool_if:NT \g__mpformulation_keeplast_bool
      { \tl_if_eq:nnT {#4} { \constraintLastSuffix } { \addpenalty \@M } }

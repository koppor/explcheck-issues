          \vbox_set:Nn \l__mpformulation_tmp_box { #2 \__mpformulation_body_end: }
        \group_end:
        \dim_set_eq:NN \l__mpformulation_relw_dim \g__mpformulation_relw_dim
        \dim_set_eq:NN \l__mpformulation_qcol_dim \g__mpformulation_qcol_dim
      }

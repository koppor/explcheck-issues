                \tl_set:Nn \l_tmpa_tl {##1}
                \tl_trim_spaces:N \l_tmpa_tl
                \tl_if_eq:VnTF \l_tmpa_tl { rhs }
                { \seq_put_right:Nn \l__linesys_pivotcols_seq { rhs } }

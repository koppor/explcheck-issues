% uses exactly one variable for each coefficient supplied in this expression.
		\int_set_eq:NN \l__linesys_nvars_int \l__linesys_required_vars_int
		\__linesys_linexp_validate_wrap_indices:
		\bool_if:NT \l__linesys_valid_bool
		{ \__linesys_linexp_build_output: }
	}

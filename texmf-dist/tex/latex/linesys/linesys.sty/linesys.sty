            \exp_args:NnV \regex_extract_once:nnN
                { ^ \c{color} \{ [^{}]* \} (.*) $ }
                #1
                \l__linesys_sign_probe_seq
            \seq_if_empty:NF \l__linesys_sign_probe_seq
            {

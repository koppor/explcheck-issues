% beltmap.sty: schematic pictures of Factorio belt layouts in LuaLaTeX.
%
% Front ends, all drawn by the glyphs and themes of tikzlibrarybeltmap.code.tex:
%   \beltlayout[keys]{file}         Factorio-SAT tiles (.json), search records (.jsonl),
%                                   or a file holding a blueprint string or book
%   \beltblueprint[keys]{string}    a blueprint string written into the document
%   \begin{beltgrid}[keys] ... \end{beltgrid}      a layout typed as a character grid
%   \beltglyph[keys]{kind}          one glyph inline, for running text and captions
%   \usetikzlibrary{beltmap}        the glyphs by hand, in any tikzpicture
% Reading, tracing and the TikZ code are done in beltmap.lua.  See beltmap-doc.pdf.
\NeedsTeXFormat{LaTeX2e}[2024-06-01]
\ProvidesExplPackage{beltmap}{2026-11-23}{0.6}{Schematic pictures of Factorio belt layouts}

\sys_if_engine_luatex:F
	{
		\msg_new:nnn { beltmap } { engine } { beltmap~needs~LuaLaTeX:~it~reads~layouts~and~blueprint~strings~in~Lua. }
		\msg_critical:nn { beltmap } { engine }
	}


% A key taking true or false, stored as text for beltmap.lua to read.
\cs_new_protected:Npn \__beltmap_bool_key:n #1
	{
		\keys_define:nn { beltmap }
			{
				#1 .choices:nn = { true , false } { \tl_set_eq:cN { l__beltmap_#1_tl } \l_keys_choice_tl } ,
				#1 .default:n = true ,
			}
	}
\clist_map_function:nN { ends , heads , lanes , labels , openends , throughput , blocked , marks , demand , numbers , dimensions , cache } \__beltmap_bool_key:n
% grid: true (normal), false (none), faint, or strong; grid major=n, rulers=n, dimensions.
\keys_define:nn { beltmap }
	{
		grid .choices:nn = { true , false , none , faint , normal , strong } { \tl_set_eq:NN \l__beltmap_grid_tl \l_keys_choice_tl } ,
		grid .default:n = true ,
		grid~major .tl_set:N = \l__beltmap_gridmajor_tl ,
		rulers .tl_set:N = \l__beltmap_rulers_tl ,
		rulers .default:n = 1 ,
	}


\NewDocumentCommand \beltmapset { m } { \keys_set:nn { beltmap } {#1} }

% The picture: #1 is the Lua call that reads the layout.  The alternative text goes to
% LaTeX's tagging code when the document is tagged (\DocumentMetadata with tagging=on),
% which defines the TikZ key alt; otherwise the key is left out.
\cs_new_protected:Npn \__beltmap_picture:n #1
	{
		\lua_now:e {#1}
		\tl_if_empty:NT \l__beltmap_alt_tl { \tl_set_eq:NN \l__beltmap_alt_tl \l__beltmap_auto_alt_tl }
		\cs_if_exist:cTF { pgfk@/tikz/alt/.@cmd }
			{ \tl_set:Ne \l__beltmap_altkey_tl { alt = { \exp_not:V \l__beltmap_alt_tl } , } }
			{ \tl_clear:N \l__beltmap_altkey_tl }
		\use:e
			{
				\exp_not:N \begin{tikzpicture}
					[
						bm~tile = \l__beltmap_tile_tl ,
						bm~theme = \l__beltmap_theme_tl ,
						\exp_not:V \l__beltmap_altkey_tl
						\exp_not:V \l__beltmap_tikz_tl
					]
			}
		\lua_now:n { beltmap.emit() }
		\l__beltmap_annotate_tl
		\end{tikzpicture}
		\str_if_eq:VnT \l__beltmap_blueprint_tl { attach } { \__beltmap_attach:NN \beltmapstring \l__beltmap_bpfile_tl }
	}

% blueprint=attach: the blueprint string as a text file inside the PDF, listed in the
% viewer's attachments.  With \DocumentMetadata the kernel's pdfmanagement embeds it, with
% an /AF entry as PDF 2.0 asks; without, the embedfile package embeds the file written beside
% the PDF.
\IfPDFManagementActiveTF
	{
		\cs_generate_variant:Nn \pdffile_embed_stream:nnN { VV }
		\cs_new_protected:Npn \__beltmap_attach:NN #1#2
			{
				\tl_if_empty:NF #2
					{
						\group_begin:
							\pdfdict_put:nnn { l_pdffile/Filespec } { AFRelationship } { /Supplement }
							\pdf_string_from_unicode:nnN { utf16/string } { Factorio~blueprint~string } \l_tmpa_str
							\pdfdict_put:nne { l_pdffile/Filespec } { Desc } { \l_tmpa_str }
							\pdffile_embed_stream:VVN #1 #2 \l__beltmap_bpref_tl
							\pdfmanagement_add:nne { Catalog / Names } { EmbeddedFiles } { \l__beltmap_bpref_tl }
							\pdfmanagement_add:nne { Catalog } { AF } { \l__beltmap_bpref_tl }
						\group_end:
					}
			}
	}
	{
		\RequirePackage{embedfile}
		\cs_new_protected:Npn \__beltmap_attach:NN #1#2
			{
				\tl_if_empty:NF #2
					{ \use:e { \exp_not:N \embedfile [ filespec = { #2 } , desc = { Factorio~blueprint~string } , mimetype = text/plain ] { \l__beltmap_outdir_tl #2 } } }
			}
	}

% The share matrix of the last picture: rows inputs, columns outputs, exact fractions.
\NewDocumentCommand \beltmapmatrix { } { \lua_now:n { beltmap.print_matrix() } }

% \beltmapbook[label]: at the end of the document, every blueprint written with blueprint=file
% or attach goes into one blueprint book, written to <jobname>-book.txt and attached.
\NewDocumentCommand \beltmapbook { O{beltmap} }
	{
		\bool_gset_true:N \g__beltmap_book_bool
		\tl_gset:Nn \g__beltmap_booklabel_tl {#1}
	}
% The book is attached at the end of the document, before embedfile finishes its list of
% attachments (embedfile's own end-of-document code ran first and refused it otherwise).
\AddToHook { enddocument } [ beltmap ]
	{
		\bool_if:NT \g__beltmap_book_bool
			{
				\lua_now:e { beltmap.book('\lua_escape:e { \g__beltmap_booklabel_tl }') }
				\__beltmap_attach:NN \l__beltmap_bookstring_tl \l__beltmap_bookfile_tl
			}
		\lua_now:n { beltmap.cache_write() }
	}
\DeclareHookRule { enddocument } { beltmap } { before } { embedfile }

% \beltanimation[keys]{file}: one picture per step of the flow, from empty belts to the steady
% state, for beltmap_export.py --gif (or the animate package).
\NewDocumentCommand \beltanimation { O{} m }
	{
		\group_begin:
			\keys_set:nn { beltmap } {#1}
			\tl_if_empty:NT \l__beltmap_mix_tl { \tl_set:Nn \l__beltmap_mix_tl { blend } }
			\str_if_eq:VnT \l__beltmap_mix_tl { none } { \tl_set:Nn \l__beltmap_mix_tl { blend } }
			\lua_now:e { beltmap.count_frames('\lua_escape:e {#2}') }
			\int_step_inline:nnn { 0 } { \l__beltmap_frames_tl - 1 }
				{
					\tl_set:Nn \l__beltmap_step_tl {##1}
					\__beltmap_picture:n { beltmap.from_file('\lua_escape:e {#2}') }
					% a space between frames, where a line may break
					\c_space_tl
				}
		\group_end:
	}

% \beltgallery[keys]{file.jsonl}: every record with status "sat", columns= per row, each with
% its name, size and area and \beltmapcaption; pick= keeps one family, limit= the first n.
\NewDocumentCommand \beltgallery { O{} m }
	{
		\group_begin:
			\keys_set:nn { beltmap } {#1}
			\tl_set:Nn \l__beltmap_gpath_tl {#2}
			\par \noindent
			\lua_now:e { beltmap.gallery('\lua_escape:e {#2}') }
		\group_end:
	}
\cs_new_protected:Npn \BeltmapGalleryCell #1#2
	{
		\begin{minipage}[t]
			{ \dim_eval:n { ( \linewidth - 1em * ( \l__beltmap_columns_int - 1 ) ) / \l__beltmap_columns_int } }
			\centering
			\group_begin:
				\tl_set:Nn \l__beltmap_record_tl {#1}
				\tl_clear:N \l__beltmap_alt_tl
				\__beltmap_picture:n { beltmap.from_file('\lua_escape:e { \l__beltmap_gpath_tl }') }
			\group_end:
			\par \smallskip
			{ \scriptsize \sffamily #2 \par \beltmapcaption \par }
		\end{minipage}
	}

% The blueprint string of the last picture, typeset in a box #1 wide (\linewidth when
% left out) with a possible break after every character.
\NewDocumentCommand \beltmapprintstring { O{\linewidth} }
	{
		\parbox{#1}{ \raggedright \ttfamily \scriptsize \lua_now:n { beltmap.print_string() } }
	}

\NewDocumentCommand \beltlayout { O{} m }
	{
		\group_begin:
			\keys_set:nn { beltmap } {#1}
			\__beltmap_picture:n { beltmap.from_file('\lua_escape:e {#2}') }
		\group_end:
	}

\NewDocumentCommand \beltblueprint { O{} +m }
	{
		\group_begin:
			\keys_set:nn { beltmap } {#1}
			\__beltmap_picture:n { beltmap.from_string('\lua_escape:e { \tl_to_str:n {#2} }') }
		\group_end:
	}

% The body is read as text: cells separated by spaces, rows by \\ (see beltmap.lua).
\NewDocumentEnvironment { beltgrid } { O{} +b }
	{
		\group_begin:
			\keys_set:nn { beltmap } {#1}
			\__beltmap_picture:n { beltmap.from_grid('\lua_escape:e { \tl_to_str:n {#2} }') }
		\group_end:
	}
	{ }

% \beltmapicon[width]{item}: a game icon in running text, from the reader's copy of Factorio.
\NewDocumentCommand \beltmapicon { O{1.2em} m }
	{ \lua_now:e { beltmap.icon('\lua_escape:e {#2}', '\lua_escape:e { \exp_not:n {#1} }') } }

\NewDocumentCommand \beltglyph { O{} m }
	{
		\group_begin:
			\keys_set:nn { beltmap } { grid = false , ends = false , labels = false , openends = false , blueprint = none , tile = 1.15em , #1 }
			\tl_put_left:Nn \l__beltmap_tikz_tl { baseline = { ([yshift=-0.55ex]current~bounding~box.center) } , }
			\__beltmap_picture:n { beltmap.from_glyph('\lua_escape:e {#2}') }
		\group_end:
	}

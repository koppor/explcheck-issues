\cs_new:Nn \__suanpan_unit_mark_construct:
  {
    % TikZ绘制样式
    \bool_if:NTF \l__suanpan_draft_bool
      { % 草稿模式
        \tikzset{%
          unitmark/.style = {% 计位点(不带高光)
            fill       = black,
            line~width = \l__suanpan_frame_inner_linewidth_dim,
          },
        }
      }{ % 正常模式
        \tikzset{%
          unitmark/.style = {% 计位点(带高光)
            shade,

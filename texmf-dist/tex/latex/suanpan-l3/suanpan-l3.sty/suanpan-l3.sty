% ============================================================================
% 构建算珠组件
% ============================================================================
% 构建内珠(靠近横梁，参与计数)容器(盒子)
\cs_new:Nn \__suanpan_inner_bead_construct:
  {
    \dim_set:Nn \l_tmpa_dim
      { \l__suanpan_bead_d_half_dim - \l__suanpan_bead_draw_h_half_dim }

    \tikzset{%
      bead/.style = {% 正常内珠样式(带高光圆角矩形)
        shade,
        ball~color      = innerfillcolor,
        shading~angle   = \l__suanpan_spot_angle_int,
        draw            = innerdrawcolor,
        line~width      = \l__suanpan_bead_linewidth_dim,
        rounded~corners = \l__suanpan_bead_arc_dim,
      },
      draftline/.style = {% 草稿内珠样式(无高光圆帽线段)
        draw       = innerfillcolor,
        line~cap   = round,
        line~width = \l__suanpan_bead_draw_h_dim,
      }
    }

    \hcoffin_gset:Nn \g__suanpan_inner_bead_coffin
      {
        \bool_if:NTF \l__suanpan_draft_bool
          {
            \begin{tikzpicture} % 无高光圆帽线段算珠
              \path[draftline] (-\l_tmpa_dim, 0) -- (\l_tmpa_dim, 0);
            \end{tikzpicture}
          }{
            \begin{tikzpicture}
              \path[bead] % 带高光填充圆角矩形算珠
                (-\l__suanpan_bead_d_half_dim, \l__suanpan_bead_lower_dim) rectangle
                ( \l__suanpan_bead_d_half_dim, \l__suanpan_bead_upper_dim);
            \end{tikzpicture}
          }
      }
  }

% 构建外珠(远离横梁，不参与计数)容器(盒子)
\cs_new:Nn \__suanpan_outer_bead_construct:

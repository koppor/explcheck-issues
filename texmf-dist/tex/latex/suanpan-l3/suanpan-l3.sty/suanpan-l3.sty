\keys_define:nn { suanpan }
  {
    % 草稿模式
    draft .choice:,
    draft / true  .code:n = {%
                              \bool_set_true:N  \l__suanpan_draft_bool
                              \bool_set_false:N  \l__suanpan_empty_rod_bool
                              % 重建所有组件
                              \bool_gset_true:N \g__suanpan_inner_bead_dirty_bool
                              \bool_gset_true:N \g__suanpan_outer_bead_dirty_bool
                              \bool_gset_true:N \g__suanpan_support_dirty_bool
                              \bool_gset_true:N \g__suanpan_unit_mark_dirty_bool
                              \__suanpan_invalidate_all_support_units:
                            },
    draft / false .code:n = {%
                              \bool_set_false:N \l__suanpan_draft_bool
                              \bool_set_true:N  \l__suanpan_empty_rod_bool
                              % 重建所有组件
                              \bool_gset_true:N \g__suanpan_inner_bead_dirty_bool
                              \bool_gset_true:N \g__suanpan_outer_bead_dirty_bool
                              \bool_gset_true:N \g__suanpan_support_dirty_bool
                              \bool_gset_true:N \g__suanpan_unit_mark_dirty_bool
                              \__suanpan_invalidate_all_support_units:
                            },
    draft .default:n = true,
    draft .initial:n = false,

    % 是否绘制档的数值为0的空档算珠
    empty .choice:,
    empty / true  .code:n = {%
                              \bool_set_true:N  \l__suanpan_empty_rod_bool
                              % 重建算珠
                              \bool_gset_true:N \g__suanpan_inner_bead_dirty_bool
                              \bool_gset_true:N \g__suanpan_outer_bead_dirty_bool
                              % \bool_gset_true:N \g__suanpan_support_dirty_bool
                              \bool_gset_true:N \g__suanpan_unit_mark_dirty_bool
                              \__suanpan_invalidate_all_support_units:
                            },
    empty / false .code:n = {%
                              \bool_set_false:N  \l__suanpan_empty_rod_bool
                              % 重建算珠
                              \bool_gset_true:N \g__suanpan_inner_bead_dirty_bool
                              \bool_gset_true:N \g__suanpan_outer_bead_dirty_bool
                              % \bool_gset_true:N \g__suanpan_support_dirty_bool
                              \bool_gset_true:N \g__suanpan_unit_mark_dirty_bool
                              \__suanpan_invalidate_all_support_units:
                            },
    empty .default:n = true,
    empty .initial:n = true,

    unknown .code:n = { \__suanpan_error:n { unknown-option } }
  }


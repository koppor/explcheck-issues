% ============================================================================
% 构建档位值为0-20的21个档杆总成容器(盒子)
% ============================================================================
\cs_new:Nn \__suanpan_support_unit_construct:
  {
    \int_step_inline:nnn { 0 }{ 20 }
      {
        % 利用\int_to_alph:n { ##1 + 1 }将数字转换成小写字母
        \hcoffin_gset:cn { g__suanpan_support_unit_ \int_to_alph:n { ##1 + 1 } _coffin }
          {
            % 使用纯 TeX 盒子拼接档位总成
            \hbox:n
              {
                % 放置支架(利用 \llap 或 \rlap 确保它不占用水平空间)
                \hbox_overlap_right:n
                  {
                    \coffin_typeset:Nnnnn \g__suanpan_support_coffin { hc } { vc }
                      { 0pt } { -\l__suanpan_support_y_offset_dim }
                  }

                % 循环放置该档位上所有算珠
                \int_compare:nNnTF { ##1 } = { 0 }
                  {
                    \bool_if:NT \l__suanpan_empty_rod_bool
                      { \__suanpan_place_beads:n { ##1 } }
                  }{
                    \__suanpan_place_beads:n { ##1 }
                  }
              }
          }
      }
  }

% ============================================================================
% 构建档位值为0-20的单个档杆总成容器(盒子)
% ============================================================================
\cs_new:Npn \__suanpan_build_single_support_unit:n #1
  {
    % 利用\int_to_alph:n { #1 + 1 }将数字转换成小写字母
    \hcoffin_gset:cn { g__suanpan_support_unit_ \int_to_alph:n { #1 + 1 } _coffin }
      {
        % 使用纯 TeX 盒子拼接档位总成
        \hbox:n
          {
            % 放置支架(利用 \llap 或 \rlap 确保它不占用水平空间)
            \hbox_overlap_right:n
              {
                \coffin_typeset:Nnnnn \g__suanpan_support_coffin { hc } { vc }
                  { 0pt } { -\l__suanpan_support_y_offset_dim }
              }

            % 循环放置该档位上所有算珠
            \int_compare:nNnTF { #1 } = { 0 }
              {
                \bool_if:NT \l__suanpan_empty_rod_bool
                  { \__suanpan_place_beads:n { #1 } }
              }{
                \__suanpan_place_beads:n { #1 }
              }
          }
      }
  }

% ============================================================================
% 在一个档位上布置所有算珠
% #1 该档位的值
% ============================================================================
\cs_new:Npn \__suanpan_place_beads:n #1
  {
    % 数值合法性判断
    \__suanpan_check_rod_value:n { #1 }

    % 取得算珠位置数据(整数数组实现)
    % 计算起始偏移offset(档位值 × 14)
    \int_set:Nn \l_tmpa_int { #1 * \c__suanpan_bead_datas_per_rod_int }

    % 循环 7 对数据
    \int_step_inline:nnnn { 0 } { 2 } { 12 }
      {
        % 布置 1 个算珠
        % intarray 索引从 1 开始
        % 算珠位置: offset + ##1 + 1, 算珠类型: offset + ##1 + 2
        \__suanpan_place_single_bead:nn
          { \intarray_item:Nn \c__suanpan_rod_val_beads_intarray { \l_tmpa_int + ##1 + 1 } }
          { \intarray_item:Nn \c__suanpan_rod_val_beads_intarray { \l_tmpa_int + ##1 + 2 } }
      }
  }

% ============================================================================
% 在垂直方向指定位置布置单个算珠(纯 TeX 实现)
% #1: 算珠位置编号
% #2: 算珠类型 (0——外珠，1——内珠)
% ============================================================================
\cs_new:Npn \__suanpan_place_single_bead:nn #1#2
  {
    % 确定垂直偏移
    \int_compare:nNnTF { #1 } > { 7 }
      {
        \int_compare:nNnTF { #1 } < { 11 }
          { % 上珠
            \dim_set:Nn \l_tmpb_dim { \l__suanpan_bead_upper_offset_dim + \l__suanpan_bead_h_dim * (#1 - 8) }
          }{
            % 悬珠
            \dim_set:Nn \l_tmpb_dim { \l__suanpan_frame_b_half_dim + \l__suanpan_bead_h_dim * 2 }
          }
      }{ % 下珠
        \dim_set:Nn \l_tmpb_dim { \l__suanpan_bead_lower_offset_dim + \l__suanpan_bead_h_dim * (#1 - 1) }
      }

    % 选择 coffin
    \int_case:nnF { #2 }
      {
        { 0 } { \tl_set:Nn \l_tmpa_coffin_tl { \g__suanpan_outer_bead_coffin } }
        { 1 } { \tl_set:Nn \l_tmpa_coffin_tl { \g__suanpan_inner_bead_coffin } }
      }{ \__suanpan_error:nn { bead-type-error } { #2 } }

    % 布置算珠
    \hbox_overlap_right:n
      {
        \hbox:n
          {
            \coffin_typeset:Nnnnn \l_tmpa_coffin_tl { hc } { vc } { 0pt } { \l_tmpb_dim }
          }
      }
  }

% ============================================================================
% 检查指定档位总成是否已缓存
% #1 档位数值
% ============================================================================
\cs_new:Npn \__suanpan_ensure_support_unit:n #1
  {
    % 检查 coffin 是否已定义 (检查版本号)
    \int_compare:nNnT { \int_use:c { g__suanpan_support_unit_ \int_to_alph:n { #1 + 1 } _version_int } }
                      < { \g__suanpan_support_unit_version_int }
      {
        \__suanpan_build_single_support_unit:n { #1 }

        \int_gset_eq:cN { g__suanpan_support_unit_ \int_to_alph:n { #1 + 1 } _version_int }
          \g__suanpan_support_unit_version_int
      }
  }

% ============================================================================
% 组装一个档位
% #1 档位编号
% #2 档位数值
% ============================================================================
\cs_new:Npn \__suanpan_assemble_rod:nn #1#2
  {
    % 数据有效性判断
    \__suanpan_check_rod_index:n { #1 }
    \__suanpan_check_rod_value:n { #2 }

     % 检查档位数值对应的档位是否已完成组装
    \__suanpan_ensure_support_unit:n { #2 }

    \draw_scope_begin:
      % 水平平移到当前档位位置
      \draw_transform_xshift:n { \l__suanpan_support_d_dim * (#1 - 1) }

      % 根据档位值布置缓存的档位单元
      \draw_coffin_use:cnnn { g__suanpan_support_unit_ \int_to_alph:n { #2 + 1 } _coffin }
                           { hc } { vc } { 0pt, -\l__suanpan_support_y_offset_dim }

      % 布置计位点标记
      \bool_if:NT \l__suanpan_support_unit_bool
        {
          % 在mark层布置计位点标记
          \draw_layer_begin:n { mark }
            \draw_coffin_use:Nnn \g__suanpan_unit_mark_coffin { hc } { vc }
          \draw_layer_end:
        }
    \draw_scope_end:
  }

% ============================================================================
% 在垂直方向指定位置布置单个浮珠
% #1: 浮珠位置编号
% ============================================================================
\cs_new:Npn \__suanpan_draw_single_float_bead:n #1
  {
    % 确定垂直距离
    \int_compare:nNnTF { #1 } > { 7 }
      {
        \int_compare:nNnTF { #1 } < { 11 }
          { % 上珠
            \dim_set:Nn \l_tmpb_dim { \l__suanpan_bead_upper_offset_dim + \l__suanpan_bead_h_dim * (#1 - 8) }
          }{
            % 悬珠
            \dim_set:Nn \l_tmpb_dim { \l__suanpan_frame_b_half_dim + \l__suanpan_bead_h_dim * 2 }
          }
      }{ % 下珠
        \dim_set:Nn \l_tmpb_dim { \l__suanpan_bead_lower_offset_dim + \l__suanpan_bead_h_dim * (#1 - 1) }
      }

    % 垂直偏移
    \draw_transform_yshift:n { \l_tmpb_dim }
    % 布置浮珠基础组件(coffin)
    \draw_coffin_use:Nnn \g__suanpan_float_bead_coffin { hc } { vc }
  }

% ============================================================================
% 布置浮珠(指定一个档位上指定位置算珠的颜色)
% #1 档位编号
% #2 算珠位置(1-11)
% ============================================================================
\cs_new:Npn \__suanpan_float_bead:nn #1#2
  {
    % 数据有效性判断
    \__suanpan_check_rod_index:n { #1 }
    \__suanpan_check_bead_position:n { #2 }

    % 在float层布置浮珠
    \draw_layer_begin:n { float }
      \draw_scope_begin:
        % 水平平移到当前档位位置
        \draw_transform_xshift:n { \l__suanpan_support_d_dim * (#1 - 1) }
        % 布置一个浮珠
        \__suanpan_draw_single_float_bead:n { #2 }
      \draw_scope_end:
    \draw_layer_end:
  }

% ============================================================================
% 为一个档位添加标记
% #1 档位编号
% #2 标记内容
% ============================================================================
\cs_new:Npn \__suanpan_rod_mark:nn #1#2
  {
    % 数据有效性判断
    \__suanpan_check_rod_index:n { #1 }

    % 构造标记容器(盒子)
    \hcoffin_set:Nn \l_tmpa_coffin
      {
        \l__suanpan_mark_font_tl
        #2
      }

    \draw_layer_begin:n { mark }
      \draw_scope_begin:
        % 水平平移到当前档位位置
        \draw_transform_xshift:n { \l__suanpan_support_d_dim * ( #1 - 1 ) }
        % 布置标记盒子
        \draw_coffin_use:Nnn \l_tmpa_coffin { hc } { vc }
      \draw_scope_end:
    \draw_layer_end:
  }

% ============================================================================
% 绘制边框
% #1 起始档位编号(左)
% #2 终止档位编号(右)
% ============================================================================
\cs_new:Npn \__suanpan_frame_layout:nn #1#2
  {
    % 数据有效性判断
    \int_compare:nNnT { #2 } < { #1 }
      {
        \__suanpan_error:nnn { frame-range-error } { #1 } { #2 }

      }

    % TikZ绘制样式
    \bool_if:NTF \l__suanpan_draft_bool
      { % 草稿模式
        \tikzset{%
          hframe/.style = {% 水平梁(上下梁，不带高光)
            draw       = framecolor,
            fill       = framecolor!20,
            line~width = \l__suanpan_frame_inner_linewidth_dim,
          },
          vframe/.style = {% 水平梁(上下梁，不带高光)
            draw       = framecolor,
            fill       = framecolor!20,
            line~width = \l__suanpan_frame_inner_linewidth_dim,
          },
        }
      }{ % 正常模式
        \tikzset{%
          hframe/.style = {% 水平梁(上下梁，带高光)
            shade,
            top~color     = framecolor!95,
            bottom~color  = framecolor!95,
            middle~color  = framecolor!15,
            shading~angle = \l__suanpan_spot_angle_int,
            draw          = framecolor,
            line~width    = \l__suanpan_frame_inner_linewidth_dim,
          },
          vframe/.style = {% 垂直梁(左右梁)
            shade,
            left~color    = framecolor!95,
            right~color   = framecolor!95,
            middle~color  = framecolor!15,
            shading~angle = 90 + \l__suanpan_spot_angle_int,
            draw          = framecolor,
            line~width    = \l__suanpan_frame_inner_linewidth_dim,
          },
        }
      }

    \tikzset{%
      arcline/.style = {% 转角线
        draw            = framecolor,
        line~width      = \l__suanpan_frame_inner_linewidth_dim,
        rounded~corners = \l__suanpan_frame_inner_linewidth_dim / 2,
      },
    }

    % 总宽度
    \dim_set:Nn \l_tmpa_dim {
       \fp_to_dim:n {
           \fp_eval:n { \l__suanpan_support_d_dim * ( #2 - #1 + 1) }
         }
     }
    % 减半档宽度
    \dim_set:Nn \l_tmpb_dim {
       \fp_to_dim:n {
           \fp_eval:n { \l__suanpan_support_d_dim * ( #2 - #1 ) +
                        \l__suanpan_support_d_half_dim}
         }
     }

    % 上下边框基础容器(盒子)
    \hcoffin_set:Nn \l_tmpa_coffin
      {
        \begin{tikzpicture}
          \path[hframe]
              ( 0pt, 0pt ) --
            ++( \l_tmpa_dim, 0) --
            ++( \l__suanpan_frame_b_dim, \l__suanpan_frame_b_dim ) --
            ++( -\l__suanpan_frame_b_dim, 0 ) --
            ++( -\l_tmpa_dim, 0 ) --
            ++( -\l__suanpan_frame_b_dim, 0 ) --
            cycle;
        \end{tikzpicture}
      }

    % 左右边框基础容器(盒子)
    \hcoffin_set:Nn \l_tmpb_coffin
      {
        \begin{tikzpicture}
          \path[vframe]
              ( 0, 0 ) --
            ++( 0, \l__suanpan_frame_inner_h_dim) --
            ++( -\l__suanpan_frame_b_dim, \l__suanpan_frame_b_dim ) --
            ++( 0, -\l__suanpan_frame_outer_h_dim ) --
            cycle;
          \path[arcline]
              ( 0, 0 )
            ++( 0,  \l__suanpan_frame_inner_h_dim )
            ++( 0,  \l__suanpan_frame_b_dim )
            ++( 0,  \l__suanpan_frame_inner_linewidth_dim * 0.9 )
            ++( -\l__suanpan_frame_b_half_dim, 0 ) --
            ++( -\l__suanpan_frame_b_half_dim, 0 ) --
            ++( -\l__suanpan_frame_inner_linewidth_dim * 0.9, 0 ) --
            ++( 0, -\l__suanpan_frame_b_half_dim );
          \path[arcline]
              ( 0, 0 )
            ++( 0, -\l__suanpan_frame_b_dim )
            ++( 0, -\l__suanpan_frame_inner_linewidth_dim * 0.9 )
            ++( -\l__suanpan_frame_b_half_dim, 0 ) --
            ++( -\l__suanpan_frame_b_half_dim, 0 ) --
            ++( -\l__suanpan_frame_inner_linewidth_dim * 0.9, 0 ) --
            ++( 0, \l__suanpan_frame_b_half_dim );
        \end{tikzpicture}
      }

    % 横梁基础容器(盒子)
    \hcoffin_set:Nn \l__suanpan_tmpc_coffin
      {
        \begin{tikzpicture}
          \path[hframe]
              ( 0pt, \l__suanpan_frame_inner_linewidth_dim / 2 ) --
            ++( \l_tmpa_dim, \l__suanpan_frame_inner_linewidth_dim / 2) --
            ++( \l__suanpan_frame_b_dim / 3,  \l__suanpan_frame_b_dim / 2 - \l__suanpan_frame_inner_linewidth_dim / 2) --
            ++(-\l__suanpan_frame_b_dim / 3,  \l__suanpan_frame_b_dim / 2 - \l__suanpan_frame_inner_linewidth_dim / 2 ) --
            ++(-\l_tmpa_dim, 0 ) --
            ++(-\l__suanpan_frame_b_dim / 3, -\l__suanpan_frame_b_dim / 2 - \l__suanpan_frame_inner_linewidth_dim / 2 ) --
            cycle;
        \end{tikzpicture}
      }

    \draw_layer_begin:n { frame }
      % 布置上边框
      \draw_scope_begin:
        \draw_transform_xshift:n { -\l__suanpan_support_d_half_dim -
                                    \l__suanpan_frame_inner_linewidth_dim / 2 }
        \draw_transform_yshift:n { \l__suanpan_frame_inner_upper_dim -
                                   \l__suanpan_frame_inner_linewidth_dim }
        \draw_coffin_use:Nnnn \l_tmpa_coffin { l } { b } { -\l__suanpan_frame_b_dim, 0pt }
      \draw_scope_end:

      % 布置下边框
      \draw_scope_begin:
        \coffin_rotate:Nn \l_tmpa_coffin { 180 }
        \draw_transform_xshift:n { \l_tmpa_dim - \l__suanpan_support_d_half_dim +
                                   \l__suanpan_frame_inner_linewidth_dim / 2 }
        \draw_transform_yshift:n { \l__suanpan_frame_inner_lower_dim +
                                   \l__suanpan_frame_inner_linewidth_dim }
        \draw_coffin_use:Nnnn \l_tmpa_coffin { l } { b } { \l__suanpan_frame_b_dim, 0pt }
      \draw_scope_end:

      % 布置左边框
      \draw_scope_begin:
        \draw_transform_xshift:n { -\l__suanpan_support_d_half_dim - \l__suanpan_frame_b_dim -
                                    \l__suanpan_frame_inner_linewidth_dim * 1.5 }
        \draw_transform_yshift:n { \l__suanpan_frame_inner_lower_dim -
                                    \l__suanpan_frame_inner_linewidth_dim }
        \draw_coffin_use:Nnnn \l_tmpb_coffin { l } { b } { 0pt, -\l__suanpan_frame_b_dim }
      \draw_scope_end:

      % 布置右边框
      \draw_scope_begin:
        \coffin_rotate:Nn \l_tmpb_coffin { 180 }
        \draw_transform_xshift:n { \l_tmpb_dim + \l__suanpan_frame_b_dim +
                                   \l__suanpan_frame_inner_linewidth_dim * 1.5}
        \draw_transform_yshift:n { \l__suanpan_frame_inner_upper_dim +
                                   \l__suanpan_frame_inner_linewidth_dim }
        \draw_coffin_use:Nnnn \l_tmpb_coffin { l } { b } { 0pt, \l__suanpan_frame_b_dim }
      \draw_scope_end:

      % 布置横梁
      \draw_scope_begin:
        \draw_transform_xshift:n { -\l__suanpan_support_d_half_dim - \l__suanpan_frame_b_dim / 3 -
                                    \l__suanpan_frame_inner_linewidth_dim / 2 }
        \draw_transform_yshift:n { -\l__suanpan_frame_b_dim / 2 -
                                    \l__suanpan_frame_inner_linewidth_dim / 2 }
        \draw_coffin_use:Nnnn \l__suanpan_tmpc_coffin { l } { b } { 0pt, 0pt }
      \draw_scope_end:
    \draw_layer_end:

    % 状态恢复
    \bool_gset_false:N \g__suanpan_has_frame_bool
    \bool_gset_true:N \g__suanpan_support_dirty_bool
    \__suanpan_invalidate_all_support_units:
  }

% ============================================================================
% 解析档位数字列表（支持区间语法）
% #1 输出的 clist 变量（解析结果添加到此 clist 中）
% #2 原始数据（可能包含区间数据，如"4-7"或重复"2[3]"）
% ============================================================================
\cs_new:Npn \__suanpan_parse_rod_list:Nn #1#2
  {
    \clist_clear:N #1
    \clist_set:Nn \l_tmpb_clist { #2 }

    \clist_map_inline:Nn \l_tmpb_clist
      {
        \tl_set:Nn \l_tmpa_tl { ##1 }

        \tl_if_in:NnTF \l_tmpa_tl { - }
          {
            % 区间语法，如"4-7"
            \__suanpan_parse_rod_range:Nx #1 { \l_tmpa_tl }
          }{
            \tl_if_in:NnTF \l_tmpa_tl { [ }
              {
                % 重复语法，如"2[3]"
                \__suanpan_parse_rod_repeat:Nx #1 { \l_tmpa_tl }
              }{
                % 普通数字
                \clist_put_right:NV #1 \l_tmpa_tl
              }
          }
      }
  }

% ============================================================================
% 解析区间"start-end"或"start-end-step"
% #1 输出的 clist 变量
% #2 区间字符串（如"4-7"或"4-7-2"）
% ============================================================================
\cs_new:Npn \__suanpan_parse_rod_range:Nn #1#2
  {
    % 用 - 切分成 seq
    \seq_set_split:Nnn \l_tmpa_seq { - } { #2 }

    % 简单语法格式检查( 2 段：start-end或 3 段：start-end-step)
    \int_case:nnF { \seq_count:N \l_tmpa_seq }
      {
        { 2 } {
            % 提取整数
            \tl_set:Nx \l_tmpa_tl { \seq_item:Nn \l_tmpa_seq { 1 } } % start
            \tl_set:Nx \l_tmpb_tl { \seq_item:Nn \l_tmpa_seq { 2 } } % end

            % 数据校验
            \tl_if_empty:NT \l_tmpa_tl
               { \__suanpan_error:nn { rods-range-syntax-error } { #2 } }
            \tl_if_empty:NT \l_tmpb_tl
               { \__suanpan_error:nn { rods-range-syntax-error } { #2 } }

            % 转换为整数
            \int_set:Nn \l_tmpa_int { \l_tmpa_tl }
            \int_set:Nn \l_tmpb_int { \l_tmpb_tl }

            % 校验数据
            \__suanpan_check_range:VV \l_tmpa_int \l_tmpb_int

            % 添加档位值
            \int_step_inline:nnn { \l_tmpa_int } { \l_tmpb_int }
              { \clist_put_right:Nn #1 { ##1 } }
          }
        { 3 } {
            % 提取整数
            \tl_set:Nx \l_tmpa_tl { \seq_item:Nn \l_tmpa_seq { 1 } } % start
            \tl_set:Nx \l_tmpb_tl { \seq_item:Nn \l_tmpa_seq { 2 } } % end
            \tl_set:Nx \l__suanpan_tmpc_tl { \seq_item:Nn \l_tmpa_seq { 3 } } % step

            % 数据校验
            \tl_if_empty:NT \l_tmpa_tl
               { \__suanpan_error:nn { rods-range-syntax-error } { #2 } }
            \tl_if_empty:NT \l_tmpb_tl
               { \__suanpan_error:nn { rods-range-syntax-error } { #2 } }
            \tl_if_empty:NT \l__suanpan_tmpc_tl
               { \__suanpan_error:nn { rods-range-syntax-error } { #2 } }

            % 转换为整数
            \int_set:Nn \l_tmpa_int { \l_tmpa_tl }
            \int_set:Nn \l_tmpb_int { \l_tmpb_tl }
            \int_set:Nn \l__suanpan_tmpc_int { \l__suanpan_tmpc_tl }

            % 校验数据
            \__suanpan_check_range:VVV \l_tmpa_int \l_tmpb_int \l__suanpan_tmpc_int

            % 添加档位值
            \int_step_inline:nnnn { \l_tmpa_int } { \l__suanpan_tmpc_int } { \l_tmpb_int }
              { \clist_put_right:Nn #1 { ##1 } }
          }
      }{ \__suanpan_error:nn { rods-range-syntax-error } { #2 } }
  }
\cs_generate_variant:Nn \__suanpan_parse_rod_range:Nn { Nx }

% ============================================================================
% 区间数据范围检查函数
% ============================================================================
\cs_new:Npn \__suanpan_check_range:nn #1#2
  {
    \int_compare:nNnT { #1 } > { #2 }
      {
        \__suanpan_error:nnn { start-end-range-error } { #1 } { #2 }
      }
    \int_compare:nNnT { #1 } < { 0 }
      {
        \__suanpan_error:nnn { start-end-range-error } { #1 } { #2 }
      }
    \int_compare:nNnT { #2 } > { 20 }
      {
        \__suanpan_error:nnn { start-end-range-error } { #1 } { #2 }
      }
  }
\cs_generate_variant:Nn \__suanpan_check_range:nn { VV }

\cs_new:Npn \__suanpan_check_range:nnn #1#2#3
  {
    \int_compare:nNnT { #1 } > { #2 }
      {
        \__suanpan_error:nnn { start-end-range-error } { #1 } { #2 }
      }
    \int_compare:nNnT { #1 } < { 0 }
      {
        \__suanpan_error:nnn { start-end-range-error } { #1 } { #2 }
      }
    \int_compare:nNnT { #2 } > { 20 }
      {
        \__suanpan_error:nnn { start-end-range-error } { #1 } { #2 }
      }
    \int_compare:nNnT { #3 } < { 1 }
      {
        \__suanpan_error:nn { step-range-error } { #3 }
      }
  }
\cs_generate_variant:Nn \__suanpan_check_range:nnn { VVV }

% ============================================================================
% 解析重复语法"value[count]"
% #1 输出的 clist 变量
% #2 重复字符串（如"2[3]"）
% ============================================================================
\cs_new:Npn \__suanpan_parse_rod_repeat:Nn #1#2
  {
    % 用 [ 切分成 seq
    \seq_set_split:Nnn \l_tmpa_seq { [ } { #2 }

    % 简单语法格式检查( 2 段：value[count])
    \int_compare:nNnTF { \seq_count:N \l_tmpa_seq } = { 2 }
      {
        % 取得档位值
        \tl_set:Nx \l_tmpa_tl { \seq_item:Nn \l_tmpa_seq { 1 } }
        % 取得重复次数
        \tl_set:Nx \l_tmpb_tl { \seq_item:Nn \l_tmpa_seq { 2 } }
        \tl_remove_all:Nn \l_tmpb_tl { ] }

        % 数据校验
        \tl_if_empty:NT \l_tmpa_tl
          { \__suanpan_error:nn { rods-repeat-syntax-error } { #2 } }
        \tl_if_empty:NT \l_tmpb_tl
          { \__suanpan_error:nn { rods-repeat-syntax-error } { #2 } }

        % 转换为整数
        \int_set:Nn \l_tmpa_int { \l_tmpa_tl }
        \int_set:Nn \l_tmpb_int { \l_tmpb_tl }

        % 校验档位值
        \__suanpan_check_rod_value:n { \l_tmpa_int }

        % 校验重复次数
        \int_compare:nNnT { \l_tmpb_int } < { 1 }
          {
            \__suanpan_error:nn { repeat-value-error } { \l_tmpb_int }
          }

        % 重复添加
        \prg_replicate:nn { \l_tmpb_int }
          {
            \clist_put_right:NV #1 \l_tmpa_int
          }
      }
      {
        \__suanpan_error:nn { rods-repeat-syntax-error } { #2 }
      }
  }
\cs_generate_variant:Nn \__suanpan_parse_rod_repeat:Nn { Nx }

% ============================================================================
% 解析算珠位置列表(支持区间语法"4-7" 表示"4,5,6,7")
% #1 输出的 clist 变量（解析结果添加到此 clist 中）
% #2 原始数据(可能包含区间，如"1,3-5,7")
% ============================================================================
\cs_new:Npn \__suanpan_parse_bead_pos_list:Nn #1#2
  {
    \clist_clear:N #1
    \clist_set:Nn \l_tmpb_clist { #2 }

    \clist_map_inline:Nn \l_tmpb_clist
      {
        \tl_set:Nn \l_tmpa_tl { ##1 }
        \tl_if_in:NnTF \l_tmpa_tl { - }
          {
            \__suanpan_parse_bead_pos_range:Nx #1 { \l_tmpa_tl }
          }
          {
            \clist_put_right:NV #1 \l_tmpa_tl
          }
      }
  }

% ============================================================================
% 解析算珠位置区间"start-end"(步长为1)
% #1 输出的 clist 变量
% #2 区间字符串(如"4-7")
% ============================================================================
\cs_new:Npn \__suanpan_parse_bead_pos_range:Nn #1#2
  {
    % 用 - 切分成 seq
    \seq_set_split:Nnn \l_tmpa_seq { - } { #2 }

    % 简单语法格式检查( 2 段：start-end)
    \int_compare:nNnTF { \seq_count:N \l_tmpa_seq } = { 2 }
      {
        % 提取整数
        \tl_set:Nx \l_tmpa_tl { \seq_item:Nn \l_tmpa_seq { 1 } } % start
        \tl_set:Nx \l_tmpb_tl { \seq_item:Nn \l_tmpa_seq { 2 } } % end

        % 数据校验
        \tl_if_empty:NT \l_tmpa_tl
          { \__suanpan_error:nn { bead-range-syntax-error } { #2 } }
        \tl_if_empty:NT \l_tmpb_tl
          { \__suanpan_error:nn { bead-range-syntax-error } { #2 } }

        % 转换为整数
        \int_set:Nn \l_tmpa_int { \l_tmpa_tl }
        \int_set:Nn \l_tmpb_int { \l_tmpb_tl }

        % 范围检查（1-11）
        \__suanpan_check_bead_range:VV \l_tmpa_int \l_tmpb_int

        \int_step_inline:nnn { \l_tmpa_int } { \l_tmpb_int }
          {
            \clist_put_right:Nn #1 { ##1 }
          }
      }{ \__suanpan_error:nn { bead-range-syntax-error } { #2 } }
  }
\cs_generate_variant:Nn \__suanpan_parse_bead_pos_range:Nn { Nx }

% ============================================================================
% 算珠位置范围检查函数(1-11)
% #1 start
% #2 end
% ============================================================================
\cs_new:Npn \__suanpan_check_bead_range:nn #1#2
  {
    \int_compare:nNnT { #1 } < { 1 }
      {
        \__suanpan_error:nn { bead-position-error } { #1 }
      }
    \int_compare:nNnT { #2 } > { 11 }
      {
        \__suanpan_error:nn { bead-position-error } { #2 }
      }
    \int_compare:nNnT { #1 } > { #2 }
      {
        \__suanpan_error:nnn { bead-range-error } { #1 } { #2 }
      }
  }
\cs_generate_variant:Nn \__suanpan_check_bead_range:nn { VV }

% ============================================================================
% 用户接口环境
% ============================================================================
% 算盘排版环境
% #1 suanpan环境选项
% #2 suanpan环境内容(!b参数)
\NewDocumentEnvironment{ suanpan }{ o !b }
  {
    \group_begin:
      % 处理选项
      \IfNoValueF{ #1 } { \keys_set:nn { suanpan }{ #1 } }

      % 删除#2(!b)参数取得的环境内容中的空白
      \str_set:Nn \l_tmpa_str { #2 }
      \str_remove_all:Nn \l_tmpa_str { ~ }
      % 将str还原为tl
      \tl_set_rescan:Nno \l_tmpa_tl { } { \l_tmpa_str }

      % 检测 \l_tmpa_tl 中是否包含控制序列 \mkframe
      % 支架颜色可能会发生变化，需要重新构建
      \tl_if_in:NnT \l_tmpa_tl { \mkframe }
        {
          \bool_gset_true:N \g__suanpan_has_frame_bool
          \bool_gset_true:N \g__suanpan_support_dirty_bool
          \__suanpan_invalidate_all_support_units:
        }

      % 按需构建基础容器(盒子) - 仅在第一次和参数变化时重建
      % 内珠
      \bool_if:NT \g__suanpan_inner_bead_dirty_bool
        {
          \__suanpan_inner_bead_construct:
          \bool_gset_false:N \g__suanpan_inner_bead_dirty_bool
        }
      % 外珠
      \bool_if:NT \g__suanpan_outer_bead_dirty_bool
        {
          \__suanpan_outer_bead_construct:
          \bool_gset_false:N \g__suanpan_outer_bead_dirty_bool
        }
      % 档杆
      \bool_if:NT \g__suanpan_support_dirty_bool
        {
          \__suanpan_support_construct:
          \bool_gset_false:N \g__suanpan_support_dirty_bool
        }
      % 计位点(圆点)
      \bool_if:NT \g__suanpan_unit_mark_dirty_bool
        {
          \__suanpan_unit_mark_construct:
          \bool_gset_false:N \g__suanpan_unit_mark_dirty_bool
        }

      % 在容器(盒子)中用#2(!b)参数取得的环境内容实现绘制
      \hcoffin_set:Nn \l_tmpa_coffin
        {
          \draw_begin:
            % 执行用户内容
            \l_tmpa_tl

            % 检查是否有档位定义
            \int_compare:nNnT { \g__suanpan_rod_max_int } = { 0 }
              {
                \__suanpan_error:n { rod-count-error }
              }
          \draw_end:
        }
  }{
      % 检查缩放参数
      \fp_compare:nNnT { \l__suanpan_scale_fp } < { 0.1 }
        {
          \msg_warning:nnn { suanpan } { scale-warning } { \l__suanpan_scale_fp }
          \tl_set:Nn \l__suanpan_scale_fp { 0.1 }
        }

      % 按用户指定比例缩放
      \fp_compare:nNnF { \l__suanpan_scale_fp } = { 1.0 }
      {
        \coffin_scale:Nnn \l_tmpa_coffin { \l__suanpan_scale_fp } { \l__suanpan_scale_fp }
      }

      % 输出算盘容器(盒子)
      \coffin_typeset:Nnnnn \l_tmpa_coffin { l } { H } { 0pt } { 0pt }

      % 状态恢复
      \int_gzero:N \g__suanpan_rod_max_int
    \group_end:
  }

% ============================================================================
% 用户接口命令
% ============================================================================
% 排版算盘一个档位，包括档杆和算珠
% #1 星号命令，绘制计位点(黑色圆点)
% #2 档位编号(基于1，从左向右计数)
% #3 本档数字(0-20，10-15需用到顶珠和底珠，16-20需要用到悬珠)
\NewDocumentCommand{ \rod }{ s m m }
  {
    \int_gset:Nn \g__suanpan_rod_max_int
      { \int_max:nn { \g__suanpan_rod_max_int }{ #2 } }

    % 星号命令，用于在横梁绘制计位点
    \IfBooleanTF{ #1 }
      {
        \bool_set_true:N \l__suanpan_support_unit_bool
      }{
        \bool_set_false:N \l__suanpan_support_unit_bool
      }

    % 组装一个档位
    \__suanpan_assemble_rod:nn { #2 }{ #3 }
  }

% 排版算盘多个档位，包括档杆和算珠
% #1 本档数字(0-20，10-15需用到顶珠和底珠，16-20需要用到悬珠)
%    支持区间语法，"start-end: 4-7"表示"4,5,6,7"；"start-end-step: 4-7-2"表示"4,6"。
%    各数字之间需要用逗号分隔。
% #2 计位点标记可选项（字符串，每个字符对应一档，* 表示有计位点，空白会被忽略）
\NewDocumentCommand{ \rods }{ m O{} }
  {
    % 解析档位数字列表（支持区间语法）
    \__suanpan_parse_rod_list:Nn \l_tmpa_clist { #1 }

    % 初始化档位计数器
    \int_set:Nn \l_tmpa_int { 0 }

    % 统计档位总数
    \int_gset:Nn \g__suanpan_rod_max_int { \clist_count:N \l_tmpa_clist }

    % 处理计位点标记字符串(忽略所有空格)
    \str_set:Nn \l_tmpb_str { #2 }
    \str_remove_all:Nn \l_tmpb_str { ~ }
    % 获取计位点标记长度
    \int_set:Nn \l_tmpb_int { \str_count:N \l_tmpb_str }

    \str_if_empty:NTF \l_tmpb_str
      {
        % 计位点标记为空，不添加计位点
        \bool_set_false:N \l__suanpan_support_unit_bool

        \clist_map_inline:Nn \l_tmpa_clist
          {
            % 档位计数器自增1
            \int_incr:N \l_tmpa_int
            % 组装当前档位
            \__suanpan_assemble_rod:nn {\l_tmpa_int }{ ##1 }
          }
      }{
        \clist_map_inline:Nn \l_tmpa_clist
          {
            % 档位计数器自增1
            \int_incr:N \l_tmpa_int

            \int_compare:nNnTF { \l_tmpa_int } > { \l_tmpb_int }
              { % 超过计位点标记字符串长度的档位无计位标记
                \bool_set_false:N \l__suanpan_support_unit_bool
              }
              {
                % 处理各个计位点标记(自动忽略超出档数的标记)
                \str_set:Nx \l__suanpan_unit_mark_str { \str_item:Nn \l_tmpb_str { \l_tmpa_int } }
                \str_if_eq:VnTF \l__suanpan_unit_mark_str { * }
                  { \bool_set_true:N \l__suanpan_support_unit_bool }
                  { \bool_set_false:N \l__suanpan_support_unit_bool }
              }

            % 组装当前档位
            \__suanpan_assemble_rod:nn {\l_tmpa_int }{ ##1 }
          }
      }

    % 更新档位总数
    \int_gset:Nn \g__suanpan_rod_max_int
      { \int_max:nn { \g__suanpan_rod_max_int }{ \l_tmpa_int } }
  }

% 指定某档上某个算珠的颜色
% #1 档位(基于1，从左向右计数)
% #2 算珠位置列表(1--11，11为悬珠位置，支持步长为1的区间语法)
% #3 算珠填充颜色
% #4 算珠绘制颜色(默认为内珠绘制颜色)
\NewDocumentCommand{ \bead }{ m m m O{innerdrawcolor} }
  {
    % 构建浮珠
    \__suanpan_float_bead_construct:nn { #4 }{ #3 }

    % 解析算珠位置列表(支持步长为1的区间语法)
    \__suanpan_parse_bead_pos_list:Nn \l_tmpa_clist { #2 }

    \clist_map_inline:Nn \l_tmpa_clist
      {
        % 绘制浮珠
        \__suanpan_float_bead:nn { #1 }{ ##1 }
      }
  }

% 指定某档上所有内珠或外珠的颜色
% #1 星号命令，选择内珠或外珠
% #2 档位(基于1，从左向右计数)
% #3 该档数字
% #4 算珠填充颜色(绘图颜色采用原内/外珠绘制颜色)
\NewDocumentCommand{ \beads }{ s m m m }
  {
    % 数据有效性检查
    \__suanpan_check_rod_index:n { #2 }
    \__suanpan_check_rod_value:n { #3 }

    % 计算起始偏移offset(档位值 × 14)
    \int_set:Nn \l_tmpa_int { #3 * \c__suanpan_bead_datas_per_rod_int }

    \IfBooleanTF{ #1 }
      {
        % 构造浮珠
        \__suanpan_float_bead_construct:nn { outerdrawcolor }{ #4 }

        % 循环 7 对数据
        \int_step_inline:nnnn { 0 } { 2 } { 12 }
          {
            % 算珠类型: offset + ##1 + 2
            \int_compare:nNnT { \intarray_item:Nn \c__suanpan_rod_val_beads_intarray { \l_tmpa_int + ##1 + 2 } } = { 0 }
              {
                % 算珠位置: offset + ##1 + 1
                \__suanpan_float_bead:nn { #2 }{ \intarray_item:Nn \c__suanpan_rod_val_beads_intarray { \l_tmpa_int + ##1 + 1 } }
              }
          }
      }{
        % 构造浮珠
        \__suanpan_float_bead_construct:nn { innerdrawcolor }{ #4 }

        % 循环 7 对数据
        \int_step_inline:nnnn { 0 } { 2 } { 12 }
          {
            % 算珠类型: offset + ##1 + 2
            \int_compare:nNnT { \intarray_item:Nn \c__suanpan_rod_val_beads_intarray { \l_tmpa_int + ##1 + 2 } } = { 1 }
              {
                % 算珠位置: offset + ##1 + 1
                \__suanpan_float_bead:nn { #2 }{ \intarray_item:Nn \c__suanpan_rod_val_beads_intarray { \l_tmpa_int + ##1 + 1 } }
              }
          }
      }
  }

% 绘制边框
\NewDocumentCommand{ \mkframe }{ }
  {
    \int_compare:nNnT { \g__suanpan_rod_max_int } = { 0 }
      {
        \__suanpan_error:n { rod-count-error }
      }
    \__suanpan_frame_layout:nn { 1 }{ \g__suanpan_rod_max_int }
  }

% 为各档添加计位标记
% #1 起始档位(基于1，从左向右计数)
% #2 标记列表
\NewDocumentCommand{ \rodmark }{ O{1} m }
  {
    % 标记列表
    \clist_set:Nn \l_tmpa_clist { #2 }

    % 数据有效性检查
    \clist_if_empty:NT \l_tmpa_clist
      {
        \__suanpan_error:n { mark-list-error }
      }

    % 计数器
    \int_set:Nn \l_tmpa_int { #1 }
    % 有效性检查
    \__suanpan_check_rod_index:n { #1 }

    % 遍历列表
    \clist_map_inline:Nn \l_tmpa_clist
      {
        % 输出标记
        \__suanpan_rod_mark:nn { \l_tmpa_int }{ ##1 }

        % 递增计数器
        \int_incr:N \l_tmpa_int

        % 超出最大档位
        \int_compare:nNnT { \l_tmpa_int } > { \g__suanpan_rod_max_int }
          {
            \clist_map_break:
          }
      }
  }

% 选项设置用户接口
\NewDocumentCommand{ \suanpanset } { m }
  {
    \IfNoValueF { #1 }
      {
        \keys_set:nn { suanpan } { #1 }
      }
  }

\endinput

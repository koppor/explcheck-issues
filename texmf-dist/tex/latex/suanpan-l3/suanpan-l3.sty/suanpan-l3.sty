% ============================================================================
% 构建档杆支杆
% ============================================================================
\cs_new:Nn \__suanpan_support_construct:
  {
    % TikZ绘图样式
    \bool_if:NTF \l__suanpan_draft_bool
      { % 草稿模式
        \tikzset{%
          rod/.style = {% 档杆绘制样式(不带高光矩形)
            draw       = roddrawcolor,
            line~width = \l__suanpan_rod_linewidth_dim,
          },
          beam/.style = {% 横梁绘制样式(不带高光)
            fill = framecolor!20,
          },
        }
      }{
        \tikzset{%
          rod/.style = {% 档干绘制样式(带高光矩形)
            shade,
            left~color    = rodfillcolor!95,
            right~color   = rodfillcolor!95,
            middle~color  = rodfillcolor!15,
            shading~angle = 90 + \l__suanpan_spot_angle_int,
            draw          = roddrawcolor,
            line~width    = \l__suanpan_rod_linewidth_dim,
          },
          beam/.style = {% 横梁绘制样式(带高光矩形)
            shade,
            bottom~color  = framecolor!60,
            top~color     = framecolor!60,
            middle~color  = framecolor!5,
            shading~angle = \l__suanpan_spot_angle_int,
          },
        }
      }
    \tikzset{%
      frameinner/.style = {% 边框内线绘制样式
        draw       = framecolor,
        line~cap   = rect, % 弥补拼接间隙
        line~width = \l__suanpan_frame_inner_linewidth_dim,
      },
      frameouter/.style = {% 边框外线绘制样式
        draw       = framecolor,
        line~cap   = rect, % 弥补拼接间隙
        line~width = \l__suanpan_frame_outer_linewidth_dim,
      },
    }

    \hcoffin_gset:Nn \g__suanpan_support_coffin
      {
        \begin{tikzpicture}
          \clip (-\l__suanpan_support_d_half_dim, \l__suanpan_support_clip_lower_dim) rectangle
                ( \l__suanpan_support_d_half_dim, \l__suanpan_support_clip_upper_dim);
          % 下杆
          \path[rod]
            (-\l__suanpan_rod_d_half_dim, \l__suanpan_support_rod_lower_bottom_extend_dim) rectangle
            ( \l__suanpan_rod_d_half_dim, \l__suanpan_support_rod_lower_top_extend_dim);
          % 上杆
          \path[rod]
            (-\l__suanpan_rod_d_half_dim, \l__suanpan_support_rod_upper_bottom_extend_dim) rectangle
            ( \l__suanpan_rod_d_half_dim, \l__suanpan_support_rod_upper_top_extend_dim);

          \bool_if:NF \g__suanpan_has_frame_bool
            {
              % 横梁
              \path[beam]
                (-\l__suanpan_support_d_half_dim, -\l__suanpan_frame_b_half_dim) rectangle
                ( \l__suanpan_support_d_half_dim,  \l__suanpan_frame_b_half_dim);

              % 横梁上边线
              \path[frameinner, yshift = \l__suanpan_support_beam_yshift_dim]
                (-\l__suanpan_support_d_half_dim, 0pt) -- ( \l__suanpan_support_d_half_dim, 0pt);
              % 横梁下边线
              \path[frameinner, yshift = -\l__suanpan_support_beam_yshift_dim]
                (-\l__suanpan_support_d_half_dim, 0pt) -- ( \l__suanpan_support_d_half_dim, 0pt);

              % 上梁下边线
              \path[frameinner, yshift = \l__suanpan_support_upper_inner_yshift_dim]
                (-\l__suanpan_support_d_half_dim, 0pt) -- ( \l__suanpan_support_d_half_dim, 0pt);
              % 上梁上边线
              \path[frameouter, yshift = \l__suanpan_support_upper_outer_yshift_dim]
                (-\l__suanpan_support_d_half_dim, 0pt) -- (\l__suanpan_support_d_half_dim, 0pt);

              % 下梁上边线
              \path[frameinner, yshift = \l__suanpan_support_lower_inner_yshift_dim]
                (-\l__suanpan_support_d_half_dim, 0pt) -- ( \l__suanpan_support_d_half_dim, 0pt);
              % 下梁下边线
              \path[frameouter, yshift = \l__suanpan_support_lower_outer_yshift_dim]
                (-\l__suanpan_support_d_half_dim, 0pt) -- ( \l__suanpan_support_d_half_dim, 0pt);
            }
        \end{tikzpicture}
      }
  }

% ============================================================================
% 绘制计位点

% ============================================================================
% 尺寸计算函数
% ============================================================================
\cs_new:Nn \__suanpan_dim_calc:
  {
    % 检查尺寸有效性(确保为正值)
    \__suanpan_check_positive_dim:N \l__suanpan_bead_h_dim
    \__suanpan_check_positive_dim:N \l__suanpan_bead_d_dim
    \__suanpan_check_positive_dim:N \l__suanpan_rod_d_dim
    \__suanpan_check_positive_dim:N \l__suanpan_frame_b_dim

    % 基础尺寸半长度
    \dim_set:Nn \l__suanpan_bead_h_half_dim  { \l__suanpan_bead_h_dim  / 2 }
    \dim_set:Nn \l__suanpan_bead_d_half_dim  { \l__suanpan_bead_d_dim  / 2 }
    \dim_set:Nn \l__suanpan_rod_d_half_dim   { \l__suanpan_rod_d_dim   / 2 }
    \dim_set:Nn \l__suanpan_frame_b_half_dim { \l__suanpan_frame_b_dim / 2 }

    % 上珠偏移(8号算珠)
    \dim_set:Nn \l__suanpan_bead_upper_offset_dim
              { \l__suanpan_frame_b_half_dim + \l__suanpan_bead_h_half_dim }
    % 下珠偏移(1号算珠)
    \dim_set:Nn \l__suanpan_bead_lower_offset_dim
             { -\l__suanpan_frame_b_half_dim - \l__suanpan_bead_h_dim * 7 + \l__suanpan_bead_h_half_dim }
    % 上档杆长度
    \dim_set:Nn \l__suanpan_rod_upper_h_dim { \l__suanpan_bead_h_dim * 3 }
    % 下档杆长度
    \dim_set:Nn \l__suanpan_rod_lower_h_dim { \l__suanpan_bead_h_dim * 7 }
    % 上档杆偏移
    \dim_set:Nn \l__suanpan_rod_upper_offset_dim { \l__suanpan_frame_b_half_dim }
    % 下档杆偏移
    \dim_set:Nn \l__suanpan_rod_lower_offset_dim
              { -\l__suanpan_frame_b_half_dim - \l__suanpan_rod_lower_h_dim }
    % 上档杆位置
    \dim_set:Nn \l__suanpan_rod_upper_dim
              { \l__suanpan_rod_upper_offset_dim + \l__suanpan_rod_upper_h_dim }
    % 下档杆位置
    \dim_set:Nn \l__suanpan_rod_lower_dim { -\l__suanpan_frame_b_half_dim }

    % 上边框内线偏移
    \dim_set:Nn \l__suanpan_frame_upper_inner_offset_dim
              { \l__suanpan_frame_b_half_dim + \l__suanpan_rod_upper_h_dim }
    % 下边框内线偏移
    \dim_set:Nn \l__suanpan_frame_lower_inner_offset_dim
             { -\l__suanpan_frame_b_half_dim - \l__suanpan_rod_lower_h_dim }
    % 上边框外线偏移
    \dim_set:Nn \l__suanpan_frame_upper_outer_offset_dim
              { \l__suanpan_frame_b_dim + \l__suanpan_frame_b_half_dim + \l__suanpan_rod_upper_h_dim }
    % 下边框外线偏移
    \dim_set:Nn \l__suanpan_frame_lower_outer_offset_dim
             { -\l__suanpan_frame_b_dim - \l__suanpan_frame_b_half_dim - \l__suanpan_rod_lower_h_dim }

    % 算珠上边缘
    \dim_set:Nn \l__suanpan_bead_upper_dim
              { \l__suanpan_bead_h_half_dim - \l__suanpan_bead_sep_dim / 2 }
    % 算珠下边缘
    \dim_set:Nn \l__suanpan_bead_lower_dim
             { -\l__suanpan_bead_h_half_dim + \l__suanpan_bead_sep_dim / 2 }
    % 算珠绘制高度
    \dim_set:Nn \l__suanpan_bead_draw_h_dim
              { \l__suanpan_bead_upper_dim - \l__suanpan_bead_lower_dim }
    % 算珠绘制半高度
    \dim_set:Nn \l__suanpan_bead_draw_h_half_dim { \l__suanpan_bead_draw_h_dim / 2 }

    % 算珠圆角半径
    \dim_set:Nn \l__suanpan_bead_arc_dim { \l__suanpan_bead_draw_h_half_dim - 1pt }

    % 横梁计位点半径
    \dim_set:Nn \l__suanpan_frame_unit_r_dim { \fp_to_dim:n { \fp_eval:n { \l__suanpan_frame_b_dim * 0.23 } } }

    % 边框外线半宽度
    \dim_set:Nn \l__suanpan_frame_outer_half_dim { \l__suanpan_frame_outer_linewidth_dim / 2 }

    % 档杆总成宽度
    \dim_set:Nn \l__suanpan_support_d_dim { \l__suanpan_bead_d_dim + \l__suanpan_rod_sep_dim }
    % 档杆总成半宽度
    \dim_set:Nn \l__suanpan_support_d_half_dim { \l__suanpan_bead_d_half_dim + \l__suanpan_rod_sep_dim / 2 }

    % 档杆总成组装垂直偏移
    \dim_set:Nn \l__suanpan_support_y_offset_dim
            { ( \l__suanpan_frame_upper_outer_offset_dim -
                \l__suanpan_frame_lower_outer_offset_dim +
                \l__suanpan_frame_outer_linewidth_dim ) / 2 -
                \l__suanpan_frame_upper_outer_offset_dim -
                \l__suanpan_frame_outer_half_dim
            }

    % 上边框内线位置
    \dim_set:Nn \l__suanpan_frame_inner_upper_dim
              { \l__suanpan_frame_upper_inner_offset_dim +
                \l__suanpan_frame_inner_linewidth_dim / 2 }
    % 下边框内线位置
    \dim_set:Nn \l__suanpan_frame_inner_lower_dim
              { \l__suanpan_frame_lower_inner_offset_dim -
                \l__suanpan_frame_inner_linewidth_dim / 2 }

    % 边框内线高度
    \dim_set:Nn \l__suanpan_frame_inner_h_dim
              { \l__suanpan_rod_upper_h_dim +
                \l__suanpan_rod_lower_h_dim +
                \l__suanpan_frame_b_dim }
    % 边框外线高度
    \dim_set:Nn \l__suanpan_frame_outer_h_dim
              { \l__suanpan_rod_upper_h_dim +
                \l__suanpan_rod_lower_h_dim +
                \l__suanpan_frame_b_dim * 3 }

    % ---- 档杆支杆预计算尺寸 ----
    % clip 边界
    \dim_set:Nn \l__suanpan_support_clip_lower_dim
      { \l__suanpan_frame_lower_outer_offset_dim + \l__suanpan_frame_outer_linewidth_dim / 2 }
    \dim_set:Nn \l__suanpan_support_clip_upper_dim
      { \l__suanpan_frame_upper_outer_offset_dim - \l__suanpan_frame_outer_linewidth_dim / 2 }

    % 横梁边线 yshift
    \dim_set:Nn \l__suanpan_support_beam_yshift_dim
      { \l__suanpan_frame_b_half_dim - \l__suanpan_frame_inner_linewidth_dim / 2 }

    % 上梁内线 yshift
    \dim_set:Nn \l__suanpan_support_upper_inner_yshift_dim
      { \l__suanpan_frame_upper_inner_offset_dim + \l__suanpan_frame_inner_linewidth_dim / 2 }
    % 上梁外线 yshift
    \dim_set:Nn \l__suanpan_support_upper_outer_yshift_dim
      { \l__suanpan_support_upper_inner_yshift_dim + \l__suanpan_frame_b_half_dim }

    % 下梁内线 yshift
    \dim_set:Nn \l__suanpan_support_lower_inner_yshift_dim
      { \l__suanpan_frame_lower_inner_offset_dim - \l__suanpan_frame_inner_linewidth_dim / 2 }
    % 下梁外线 yshift
    \dim_set:Nn \l__suanpan_support_lower_outer_yshift_dim
      { \l__suanpan_support_lower_inner_yshift_dim - \l__suanpan_frame_b_half_dim }

    % 档杆延长(消除间隙)
    \dim_set:Nn \l__suanpan_support_rod_lower_top_extend_dim
      { \l__suanpan_rod_lower_dim + \l__suanpan_frame_inner_linewidth_dim / 2 }
    \dim_set:Nn \l__suanpan_support_rod_lower_bottom_extend_dim
      { \l__suanpan_rod_lower_offset_dim - \l__suanpan_frame_inner_linewidth_dim / 2 }
    \dim_set:Nn \l__suanpan_support_rod_upper_top_extend_dim
      { \l__suanpan_rod_upper_dim + \l__suanpan_frame_inner_linewidth_dim / 2 }
    \dim_set:Nn \l__suanpan_support_rod_upper_bottom_extend_dim
      { \l__suanpan_rod_upper_offset_dim - \l__suanpan_frame_inner_linewidth_dim / 2 }
  }

% 参数变化时递增档位总成全局版本号

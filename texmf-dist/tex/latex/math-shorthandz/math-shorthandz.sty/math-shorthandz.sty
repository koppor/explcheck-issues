  \msz@lim@opt{scale-text}{scale@text}{0.6}
  \msz@lim@opt{scale-script}{scale@script}{0.43}
  \msz@lim@opt{scale-scriptscript}{scale@scriptscript}{0.43}
  \msz@lim@opt{scale-absolute}{scale@absolute}{true}

  \msz@lim@opt{math-before}{math@before}{0}
  \msz@lim@opt{math-after}{math@after}{0}
  \msz@lim@opt{math-above}{math@above}{0}
  \msz@lim@opt{math-below}{math@below}{0}

  \msz@lim@opt{math-below-v}{math@below@v}{-0.4}
  \msz@lim@opt{math-below-h}{math@below@h}{0}
  \msz@lim@opt{math-script-v}{math@script@v}{0.3}
  \msz@lim@opt{math-script-h}{math@script@h}{-0.05}

  \msz@lim@opt{text-before}{text@before}{0}
  \msz@lim@opt{text-after}{text@after}{0}
  \msz@lim@opt{text-above}{text@above}{0.5}
  \msz@lim@opt{text-below}{text@below}{0.5}

  \msz@lim@opt{text-below-v}{text@below@v}{-0.4}
  \msz@lim@opt{text-below-h}{text@below@h}{0}
  \msz@lim@opt{text-script-v}{text@script@v}{0.3}
  \msz@lim@opt{text-script-h}{text@script@h}{-0.05}


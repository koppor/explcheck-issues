% ==============================================================================
% \zprime * [n] [v] [h] {symbol}
% ------------------------------------------------------------------------------
% Adorns SYMBOL with N prime marks (default 1). Unstarred draws them flush to
% the symbol's right edge, like a superscript; starred draws them as a
% centred accent above the symbol. The whole cluster (primes and the kerns
% between them) is scaled once by `zprime-scale-<style>`, one option per math
% style of the SYMBOL, so \zprime nests safely inside exponents etc. The
% switch `zprime-scale-absolute` (see GLOBAL) selects the meaning: true
% (default) -> a multiple of the normal-size primes; false -> a multiple of
% the ambient ones. Nested in other scaled boxes the cluster is guarded
% like any scaled call (see "Nesting guard" in GLOBAL).
%
% The prime cluster is a box placed explicitly, free to overlap the symbol.
% Every position is measured from the EDGES of the symbol to the NEAREST edge
% of the cluster, as a dimensionless RATIO of a unit measured in the style of
% the symbol (see GLOBAL): vertical options (v, above, below) are ratios of
% its x-height, horizontal ones (h, before, after) of its quad. The same
% number therefore looks identical at any math style or scale, and in
% exponents (same philosophy as \zscript).
%
% Option names: zprime-<mode>-<form>-<axis>, with
%   mode   math (display style) | text (text, script and scriptscript style)
%   form   script (unstarred) | accent (starred)
%   axis   v (vertical) | h (horizontal)
% and zprime-<mode>-<before|after|above|below> for the frame. Every key
% exists for both modes. `zprime-separation` (a mu-kern between consecutive
% primes, scaled with them; a very fine unit: use a few mu), the scales
% zprime-scale-<style> and the switch zprime-scale-absolute are mode-free.
%
% Coordinates: x positive to the right, y positive upward.
%   v  = y of the cluster's BOTTOM edge, from the symbol's TOP edge
%        (negative lowers the primes into the symbol).
%   h  = script: x of the cluster's LEFT edge, from the symbol's RIGHT edge;
%        accent: shift of the cluster from its centred position.
% V and H, when given, REPLACE (not nudge) the package option of the chosen
% form and mode for this call only; leave empty ([]) to keep it. Both are
% plain ratios, \eg [-0.5] or [0.1].
%
% The whole output is one \mathord box whose height and depth cover the
% symbol AND the cluster, plus `above`/`below`, and whose width covers the
% same plus `before`/`after` (all signed and additive), exactly as in
% \zscript. The box is wrapped in \mathord OUTSIDE the \mathchoice: a script
% attached afterwards (e.g. \zprime*[3]{\int}^{\infty}) or a \left/\right
% would otherwise see an empty atom instead of the box's true height.
%
%   \zprime{f}          \zprime*{f}
%   \zprime[2]{g}       \zprime*[2]{g}
%   \zprime*[1][][-0.1]{\int^{\infty}}   % h override, default v
% ==============================================================================

  % \msz@prime@opt {key suffix} {macro suffix} {default} — declares the
  % option macro \msz@prime@<macro suffix> and its key zprime-<key suffix>
  \newcommand{\msz@prime@opt}[3]{%
    \expandafter\newcommand\csname msz@prime@#2\endcsname{#3}%
    \define@key{shorthand}{zprime-#1}{\expandafter\renewcommand\csname msz@prime@#2\endcsname{##1}}%
  }

  \msz@prime@opt{separation}{sep}{-2mu}
  \msz@prime@opt{scale-display}{scale@display}{1.1}
  \msz@prime@opt{scale-text}{scale@text}{1.1}
  \msz@prime@opt{scale-script}{scale@script}{0.8}
  \msz@prime@opt{scale-scriptscript}{scale@scriptscript}{0.8}
  \msz@prime@opt{scale-absolute}{scale@absolute}{true}

  \msz@prime@opt{math-before}{math@before}{0}
  \msz@prime@opt{math-after}{math@after}{0}
  \msz@prime@opt{math-above}{math@above}{0.1}
  \msz@prime@opt{math-below}{math@below}{0.1}

  \msz@prime@opt{math-script-v}{math@script@v}{-1.3}
  \msz@prime@opt{math-script-h}{math@script@h}{-0.02}
  \msz@prime@opt{math-accent-v}{math@accent@v}{-0.8}
  \msz@prime@opt{math-accent-h}{math@accent@h}{0.1}

  \msz@prime@opt{text-before}{text@before}{0}
  \msz@prime@opt{text-after}{text@after}{0}
  \msz@prime@opt{text-above}{text@above}{0.1}
  \msz@prime@opt{text-below}{text@below}{0.1}

  \msz@prime@opt{text-script-v}{text@script@v}{-1.3}
  \msz@prime@opt{text-script-h}{text@script@h}{-0.02}
  \msz@prime@opt{text-accent-v}{text@accent@v}{-0.8}
  \msz@prime@opt{text-accent-h}{text@accent@h}{0.1}


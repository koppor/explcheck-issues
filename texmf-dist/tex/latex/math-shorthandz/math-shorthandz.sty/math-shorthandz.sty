  \msz@int@opt{math-slant-bottom-v}{math@slant@bottom@v}{-2}
  \msz@int@opt{math-slant-bottom-h}{math@slant@bottom@h}{-0.1}
  \msz@int@opt{math-stack-top-v}{math@stack@top@v}{3}
  \msz@int@opt{math-stack-top-h}{math@stack@top@h}{0.3}
  \msz@int@opt{math-stack-bottom-v}{math@stack@bottom@v}{-3}
  \msz@int@opt{math-stack-bottom-h}{math@stack@bottom@h}{-0.8}
  \msz@int@opt{math-right-top-v}{math@right@top@v}{1.4}
  \msz@int@opt{math-right-top-h}{math@right@top@h}{0.3}
  \msz@int@opt{math-right-bottom-v}{math@right@bottom@v}{-1.8}
  \msz@int@opt{math-right-bottom-h}{math@right@bottom@h}{-0.35}

  \msz@int@opt{text-separation}{text@separation}{-10mu}
  \msz@int@opt{text-dots-left}{text@dots@left}{-10mu}
  \msz@int@opt{text-dots-right}{text@dots@right}{-6mu}
  \msz@int@opt{text-before}{text@before}{0}
  \msz@int@opt{text-after}{text@after}{-0.2}
  \msz@int@opt{text-above}{text@above}{0.15}
  \msz@int@opt{text-below}{text@below}{0.15}

  \msz@int@opt{text-slant-top-v}{text@slant@top@v}{0.7}
  \msz@int@opt{text-slant-top-h}{text@slant@top@h}{-0.1}
  \msz@int@opt{text-slant-bottom-v}{text@slant@bottom@v}{-0.7}
  \msz@int@opt{text-slant-bottom-h}{text@slant@bottom@h}{-0.1}
  \msz@int@opt{text-stack-top-v}{text@stack@top@v}{1.6}
  \msz@int@opt{text-stack-top-h}{text@stack@top@h}{0.2}
  \msz@int@opt{text-stack-bottom-v}{text@stack@bottom@v}{-1.6}
  \msz@int@opt{text-stack-bottom-h}{text@stack@bottom@h}{-0.4}
  \msz@int@opt{text-right-top-v}{text@right@top@v}{0.2}
  \msz@int@opt{text-right-top-h}{text@right@top@h}{0.3}
  \msz@int@opt{text-right-bottom-v}{text@right@bottom@v}{-0.8}
  \msz@int@opt{text-right-bottom-h}{text@right@bottom@h}{0}

  \msz@int@opt{scale-display}{scale@display}{0.6}
  \msz@int@opt{scale-text}{scale@text}{0.6}
  \msz@int@opt{scale-script}{scale@script}{0.43}
  \msz@int@opt{scale-scriptscript}{scale@scriptscript}{0.43}
  \msz@int@opt{scale-absolute}{scale@absolute}{true}


          + \str_if_eq:VnTF \l__msz_lim_form_tl { below }
              { ( \box_wd:N \l__msz_lim_nuc_box - \box_wd:N \l__msz_lim_script_box ) / 2 }
              { \box_wd:N \l__msz_lim_nuc_box }
        }
      \dim_set:Nn \l__msz_lim_left_dim
        { \dim_max:nn { 0pt } { - \l__msz_lim_x_dim } }
      \dim_set:Nn \l__msz_lim_right_dim
        {
          \dim_max:nn { 0pt }
            {
              \l__msz_lim_x_dim + \box_wd:N \l__msz_lim_script_box
              - \box_wd:N \l__msz_lim_nuc_box
            }
        }
    }


        { \dim_max:nn { 0pt } { - \l__msz_prime_x_dim } }
      \dim_set:Nn \l__msz_prime_right_dim
        {
          \dim_max:nn { 0pt }
            {
              \l__msz_prime_x_dim + \box_wd:N \l__msz_prime_bare_box
              - \box_wd:N \l__msz_prime_nuc_box
            }
        }
    }

  % builds the whole output (one \mathchoice branch) —
  % #1 star-bool  #2 n (may be empty -> 1)  #3 v override (empty = option)
  % #4 h override (empty = option)  #5 symbol  #6 "math"|"text"
  % #7 style name of the symbol (display|text|script|scriptscript)
  % #8 style of the symbol and the primes
  % The output box is used bare: \zprime wraps it in \mathord OUTSIDE the
  % \mathchoice, so a script or \left/\right attached afterwards sees its
  % true height instead of an empty atom.
  \cs_new_protected:Npn \__msz_prime_build:nnnnnnnN #1#2#3#4#5#6#7#8
    {
      \tl_set:Nn \l__msz_prime_mode_tl {#6}
      \IfBooleanTF {#1}
        { \tl_set:Nn \l__msz_prime_form_tl { accent } }
        { \tl_set:Nn \l__msz_prime_form_tl { script } }
      \tl_set:Nn \l__msz_prime_n_tl {#2}
      \tl_if_empty:NT \l__msz_prime_n_tl { \tl_set:Nn \l__msz_prime_n_tl {1} }
      \__msz_unit:N #8
      \hbox_set:Nn \l__msz_prime_nuc_box { $ \m@th #8 #5 $ }

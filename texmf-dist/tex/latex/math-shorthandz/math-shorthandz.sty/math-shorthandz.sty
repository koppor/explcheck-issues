  % takes its scripts at the sides instead of above and below.
  \cs_new_protected:Npn \__msz_script_tex:nN #1#2
    {
      { }
      \__msz_script_attach:nnN { ll } { ul } #2
      \mathord {#1}
      \__msz_script_attach:nnN { lr } { ur } #2
    }


  % superscript (key #2), when present, with TeX's own placement — #3 style
  % of the scripts
  \cs_new_protected:Npn \__msz_script_attach:nnN #1#2#3
    {
      \tl_if_empty:cF { l__msz_script_ #1 _tl }
        { \sb { \__msz_script_content:nN {#1} #3 } }
      \tl_if_empty:cF { l__msz_script_ #2 _tl }
        { \sp { \__msz_script_content:nN {#2} #3 } }
    }


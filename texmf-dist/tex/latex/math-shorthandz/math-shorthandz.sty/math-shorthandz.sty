% ##############################################################################
% math-shorthandz.sty — smart shorthands for typesetting math in LaTeX
%
% Provides:
%   \zpunct   punctuation before equation number
%   \zline    arbitrary underline stacking (\zvec, \zmat convenience wrappers)
%   \zfrac    flexible fraction with configurable style and parenthesisation
%   \zscale   uniform scaling of math content
%   \zdot     math-mode dot product symbol with configurable size and placement
%   \zarg     scaled parenthesised function argument
%   \zdiff    differential and derivative operator
%   \zcond    "evaluated at" vertical bar with condition
%   \zscript  pre- and post-scripts with optional scaling
%   \zprime   prime superscript or accent, context-sensitive scaling
%   \zlim     limit operator with variable and value, below or as a subscript
%   \zint     configurable integral with glyph type and limit placement
%
% Dependencies:
%   amsmath, unicode-math, graphicx, nicefrac, xkeyval
%   (expl3 and xparse are part of the LaTeX kernel since 2020)
%
% Structure:
%   This file has one section per public command, ordered from the commands
%   that depend on nothing to those that build on the others. Each section is
%   self-contained: package options, constants, helper functions and the
%   public command are defined in that order, so a fix can be tested by
%   replacing the whole section. A short "Global" section up front holds the
%   handful of items shared across more than one command.
%
%   NOTE: no option is frozen at load time. Every section reads its
%   \msz@... macros at call time, so options given to
%   \usepackage[...]{math-shorthandz} take effect, and any of them may be
%   changed, or locally overridden inside a group, with
%   \setkeys{shorthand}{...}.
%
%   Option key names are always prefixed with the full public command name
%   (e.g. zint-, zdiff-, zline-) and belong to the keyval family `shorthand`;
%   internal \msz@... macro names drop the leading "z" purely to keep the
%   namespace short, since they already live under the \msz@ prefix (the
%   initials of math-shorthandz).
%
% Copyright (C) 2020-2026 Tiago Pomella Lobo
%
% This work may be distributed and/or modified under the conditions of the
% LaTeX Project Public License, either version 1.3c of this license or (at
% your option) any later version. The latest version of this license is in
%   https://www.latex-project.org/lppl.txt
% and version 1.3c or later is part of all distributions of LaTeX version
% 2008 or later.
%
% This work has the LPPL maintenance status `author-maintained'.
%
% The Current Maintainer of this work is Tiago Pomella Lobo
% (https://github.com/tplobo/math-shorthandz).
%
% This work consists of the files math-shorthandz.sty, math-shorthandz.tex,
% math-shorthandz-listings.tex and README.md, and the derived file
% math-shorthandz.pdf.
% ##############################################################################

\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{math-shorthandz}[2026/10/14 v1.0.0 smart shorthands for typesetting math]

% ------------------------------------------------------------------------------
% Required packages
% ------------------------------------------------------------------------------

\RequirePackage{graphicx}
\RequirePackage{amsmath}
\RequirePackage{unicode-math}
\RequirePackage{nicefrac}
\RequirePackage{xkeyval}

% ------------------------------------------------------------------------------
% Configure packages
% ------------------------------------------------------------------------------

% The integral glyphs are prescribed so that \intop and \ointop render with
% XITS glyphs. The base math font is left to the user; recommended:
%   \setmathfont{TeX Gyre DejaVu Math}[Scale=0.85]
\AtBeginDocument{\setmathfont[range={"222B-"2233}]{XITS Math}}

\makeatletter

% ==============================================================================
% GLOBAL
% ------------------------------------------------------------------------------
% Items shared by more than one command section: the package-wide per-style
% `scale-*` options read by \zscale and the style-aware UNITS in which
% \zscript, \zprime, \zlim and \zint measure every position and frame margin.
% Everything else lives entirely inside its own command's section below.
%
% Units: every position/frame option of those commands is a dimensionless
% RATIO of a unit measured in the math style of the nucleus, so distances
% shrink by themselves inside exponents, subscripts, etc. (unlike ex/em/pt,
% which follow the ambient text font):
%   vertical    (v, above, below)   x-height of the style
%   horizontal  (h, before, after)  quad (1em) of the style
% The axis height of the style is also measured, for commands that must
% re-centre scaled content (\zdot).
%
% Scales: every command that scales content (\zscale, \zdot, \zarg, \zscript,
% \zprime, \zlim, \zint) owns FOUR factors, one per math style (display, text,
% script, scriptscript) of the context in which it is called, and ONE switch
% `<command>-scale-absolute` (true | false) that selects what they mean:
%   true   ABSOLUTE (default): content is set in the NORMAL size
%          (\displaystyle in display context, \textstyle otherwise) and then
%          multiplied by the factor, which is thus the final size relative to
%          the normal one.
%   false  RELATIVE: content is set in the ambient (or, for scripts and
%          limits, the script) style, as TeX would, and then multiplied by
%          the factor. TeX's own shrinking and the factor stack. All factors
%          equal to 1 reproduces plain LaTeX.
% Any value other than `true` counts as false.
%
% Choosing the factors: with r the size (relative to the normal one) of the
% REFERENCE style and k the wanted fraction of it, the absolute factor is
% k*r and the relative one is k. The reference is the style of the call for
% \zscale, \zdot, \zarg and \zprime, and one style below that of the nucleus
% (never below scriptscript) for \zscript, \zlim and \zint. Math fonts shrink
% script and scriptscript style to about 0.7 and 0.5 of the normal size, so
% the defaults of every command are absolute factors chosen that way.
%
% Nesting guard: TeX never sets anything below scriptscript style, but a
% scaled box is invisible to its styles, so it is tracked explicitly.
% \l__msz_scale_acc_fp holds the geometric scale of the enclosing scaled
% boxes (1 outside any). A nested call may be shrunk by it only down to the
% size of a scriptscript call of the same command: its `scale-scriptscript`
% (times the measured size of scriptscript style when relative). A factor
% already below that size, from an option or given explicitly, is honoured
% as it is and never shrunk further by nesting.
% ==============================================================================

  \newcommand{\msz@scale@display}{1}
  \newcommand{\msz@scale@text}{1}
  \newcommand{\msz@scale@script}{0.7}
  \newcommand{\msz@scale@scriptscript}{0.6}
  \newcommand{\msz@scale@absolute}{true}
  \define@key{shorthand}{scale-display}{\renewcommand{\msz@scale@display}{#1}}
  \define@key{shorthand}{scale-text}{\renewcommand{\msz@scale@text}{#1}}
  \define@key{shorthand}{scale-script}{\renewcommand{\msz@scale@script}{#1}}
  \define@key{shorthand}{scale-scriptscript}{\renewcommand{\msz@scale@scriptscript}{#1}}
  \define@key{shorthand}{scale-absolute}{\renewcommand{\msz@scale@absolute}{#1}}

\ExplSyntaxOn

  \dim_new:N \l__msz_unit_h_dim
  \dim_new:N \l__msz_unit_v_dim
  \dim_new:N \l__msz_unit_axis_dim
  \box_new:N \l__msz_unit_box

  % sets the horizontal (quad) and vertical (x-height) units and the axis
  % height for style #1
  \cs_new_protected:Npn \__msz_unit:N #1
    {
      \hbox_set:Nn \l__msz_unit_box { $ \m@th #1 x $ }
      \dim_set:Nn \l__msz_unit_v_dim { \box_ht:N \l__msz_unit_box }
      \hbox_set:Nn \l__msz_unit_box { $ \m@th #1 \mkern 18mu $ }
      \dim_set:Nn \l__msz_unit_h_dim { \box_wd:N \l__msz_unit_box }
      \hbox_set:Nn \l__msz_unit_box { $ \m@th #1 \vcenter { \hbox { } } $ }
      \dim_set:Nn \l__msz_unit_axis_dim { \box_ht:N \l__msz_unit_box }
    }

  % expands to the length (ratio #1) * (unit dimension #2)
  \cs_new:Npn \__msz_ratio:nN #1#2
    { \fp_to_dim:n { (#1) * #2 } }

\ExplSyntaxOff

% ==============================================================================
% \zpunct {punct}
% ------------------------------------------------------------------------------
% Places punctuation at the right end of a display line, where its equation
% number goes. In a numbered row it is attached immediately before the number,
% separated from it by a space (a \tagform@ hook). In a row of a starred
% environment (equation*, gather*, flalign*, ...) it is typeset flush right
% through amsmath's own \tag*, exactly where a number would stand, so no number
% is required. Must be placed in the row it ends, before its \\. A row left
% unnumbered inside a numbered environment (\notag, \nonumber) discards the
% punctuation, so it can never leak into a later number or \eqref.
%
%   \begin{equation}  E = mc^2 \zpunct{,} \end{equation}
%   \begin{flalign*} &E = mc^2 \zpunct{,} \\ &F = ma \zpunct{.} \end{flalign*}
% ==============================================================================

  \newcommand{\msz@currentpunct}{}
  \def\tagform@#1{%
    \maketag@@@{\msz@currentpunct(\ignorespaces#1\unskip\@@italiccorr)}%
    \gdef\msz@currentpunct{}%
  }
  \let\msz@make@display@tag\make@display@tag
  \def\make@display@tag{%
    \if@eqnsw\else\iftag@\else\gdef\msz@currentpunct{}\fi\fi
    \msz@make@display@tag
  }
  \NewDocumentCommand \zpunct { m }
    {
      \ifst@rred
        \tag*{#1}%
      \else
        \gdef\msz@currentpunct{#1\space}%
      \fi
    }

% ==============================================================================
% \zline [count] {symbol}   |   \zvec {symbol}   |   \zmat {symbol}
% ------------------------------------------------------------------------------
% \zline underlines a symbol with <count> horizontal rules (default: 1),
% each of thickness `zline-thickness`, separated from the symbol by
% `zline-depth` and from each other by `zline-separation`. Rule width matches
% the symbol's natural width exactly. Safe in text and math mode.
%
% \zvec and \zmat are convenience wrappers producing one and two underlines
% respectively, for vector and matrix notation.
%
%   \zline[3]{W}       \zvec{u}       \zmat{A}
% ==============================================================================

  \newcommand{\msz@line@depth}{2pt}
  \newcommand{\msz@line@thickness}{0.4pt}
  \newcommand{\msz@line@separation}{0.9pt}
  \define@key{shorthand}{zline-depth}{\renewcommand{\msz@line@depth}{#1}}
  \define@key{shorthand}{zline-thickness}{\renewcommand{\msz@line@thickness}{#1}}
  \define@key{shorthand}{zline-separation}{\renewcommand{\msz@line@separation}{#1}}

\ExplSyntaxOn

  \box_new:N \l__msz_line_box
  \dim_new:N \l__msz_line_depth_dim
  \dim_new:N \l__msz_line_thickness_dim
  \dim_new:N \l__msz_line_sep_dim

  \NewDocumentCommand \zline { O{1} m }
    {
      \leavevmode
      \dim_set:Nn \l__msz_line_depth_dim     { \msz@line@depth       }
      \dim_set:Nn \l__msz_line_thickness_dim { \msz@line@thickness   }
      \dim_set:Nn \l__msz_line_sep_dim       { \msz@line@separation  }
      \hbox_set:Nn \l__msz_line_box
        { \ensuremath{ \mathsurround=0pt #2 } }
      \vtop
        {
          \offinterlineskip
          \box_use:N \l__msz_line_box
          \kern \l__msz_line_depth_dim
          \int_step_inline:nn {#1}
            {
              \hrule
                height \l__msz_line_thickness_dim
                width  \box_wd:N \l__msz_line_box
              \int_compare:nNnF {##1} = {#1}
                { \kern \l__msz_line_sep_dim }
            }
        }
    }

  \NewDocumentCommand \zvec { m } { \ensuremath { \zline[1]{#1} } }
  \NewDocumentCommand \zmat { m } { \ensuremath { \zline[2]{#1} } }

\ExplSyntaxOff

% ==============================================================================
% \zfrac * * [num] {num} [den] {den}
% ------------------------------------------------------------------------------
% Flexible fraction. {x} = plain, [x] = parenthesised. Single argument is
% treated as denominator (numerator defaults to 1). Star: \nicefrac.
% Double star: slash notation n/d. No star: \frac. The whole output is
% ALWAYS wrapped in \ensuremath, regardless of style, so operands may
% contain math (\alpha, \sqrt{...}, etc.) even when \zfrac is called from
% text mode — parenthesisation via \left(\right) then also stays valid,
% since it always executes inside guaranteed math. Safe in text, inline,
% and display mode.
%
% This section has no package options: unlike \zline or \zprime, \zfrac's
% layout is fully determined by its stars and its argument delimiters, so
% there is nothing left to tune.
%
%   \zfrac{n}{d}   \zfrac{n}[d]   \zfrac[n]{d}   \zfrac[n][d]   \zfrac[d]
% ==============================================================================

\ExplSyntaxOn

  \tl_new:N   \l__msz_frac_num_tl
  \tl_new:N   \l__msz_frac_den_tl

  \bool_new:N \l__msz_frac_num_paren_bool
  \bool_new:N \l__msz_frac_den_paren_bool
  \bool_new:N \l__msz_frac_den_present_bool
  % NOTE: \l__msz_frac_den_present_bool is unconditionally set true by
  % \__msz_frac_parse:nnnnnn below, so the "no denominator" branch in
  % \__msz_frac_render:nn is currently dead code. Potentially useful
  % if a "numerator-only" call form proves needed in the future.

  % wraps {math} in \left( \right); always called from within \ensuremath,
  % so plain math-mode delimiters are safe regardless of the caller's mode
  \cs_new:Npn \__msz_frac_paren:n #1
    { \left( #1 \right) }

  % renders one operand — #1 the paren-bool controlling it, #2 its token
  % list — parenthesising it via \__msz_frac_paren:n when #1 is true
  \cs_new:Npn \__msz_frac_arg:Nn #1 #2
    {
      \bool_if:NTF #1
        { \__msz_frac_paren:n {#2} }
        {#2}
    }

  % dispatches to the requested style once the numerator/denominator and
  % their paren-bools have been set by \__msz_frac_parse:nnnnnn —
  % #1 star (nicefrac/slash)  #2 double-star (slash)
  \cs_new:Npn \__msz_frac_render:nn #1 #2
    {
      \bool_if:NF \l__msz_frac_den_present_bool
        { \__msz_frac_arg:Nn \l__msz_frac_num_paren_bool { \l__msz_frac_num_tl } }
        {
          \IfBooleanTF {#1}
            {
              \IfBooleanTF {#2}
                {
                  \__msz_frac_arg:Nn \l__msz_frac_num_paren_bool { \l__msz_frac_num_tl }
                  /
                  \__msz_frac_arg:Nn \l__msz_frac_den_paren_bool { \l__msz_frac_den_tl }
                }
                {
                  \nicefrac
                    { \__msz_frac_arg:Nn \l__msz_frac_num_paren_bool { \l__msz_frac_num_tl } }
                    { \__msz_frac_arg:Nn \l__msz_frac_den_paren_bool { \l__msz_frac_den_tl } }
                }
            }
            {
              \frac
                { \__msz_frac_arg:Nn \l__msz_frac_num_paren_bool { \l__msz_frac_num_tl } }
                { \__msz_frac_arg:Nn \l__msz_frac_den_paren_bool { \l__msz_frac_den_tl } }
            }
        }
    }

  % parses the four o g o g arguments passed by \zfrac into the num/den
  % token lists and their paren-bools, covering every {}/[] combination
  \cs_new_protected:Npn \__msz_frac_parse:nnnnnn #1 #2 #3 #4 #5 #6
    {
      \IfNoValueTF {#3}
        {
          \IfNoValueTF {#5}
            {
              \IfNoValueTF {#6}
                {
                  \tl_set:Nn \l__msz_frac_num_tl { 1 }
                  \bool_set_false:N \l__msz_frac_num_paren_bool
                  \bool_set_true:N  \l__msz_frac_den_present_bool
                  \tl_set:Nn \l__msz_frac_den_tl {#4}
                  \bool_set_false:N \l__msz_frac_den_paren_bool
                }
                {
                  \tl_set:Nn \l__msz_frac_num_tl {#4}
                  \bool_set_false:N \l__msz_frac_num_paren_bool
                  \bool_set_true:N  \l__msz_frac_den_present_bool
                  \tl_set:Nn \l__msz_frac_den_tl {#6}
                  \bool_set_false:N \l__msz_frac_den_paren_bool
                }
            }
            {
              \tl_set:Nn \l__msz_frac_num_tl {#4}
              \bool_set_false:N \l__msz_frac_num_paren_bool
              \bool_set_true:N  \l__msz_frac_den_present_bool
              \tl_set:Nn \l__msz_frac_den_tl {#5}
              \bool_set_true:N  \l__msz_frac_den_paren_bool
            }
        }
        {
          \IfNoValueTF {#4}
            {
              \IfNoValueTF {#5}
                {
                  \tl_set:Nn \l__msz_frac_num_tl { 1 }
                  \bool_set_false:N \l__msz_frac_num_paren_bool
                  \bool_set_true:N  \l__msz_frac_den_present_bool
                  \tl_set:Nn \l__msz_frac_den_tl {#3}
                  \bool_set_true:N  \l__msz_frac_den_paren_bool
                }
                {
                  \tl_set:Nn \l__msz_frac_num_tl {#3}
                  \bool_set_true:N  \l__msz_frac_num_paren_bool
                  \bool_set_true:N  \l__msz_frac_den_present_bool
                  \tl_set:Nn \l__msz_frac_den_tl {#5}
                  \bool_set_true:N  \l__msz_frac_den_paren_bool
                }
            }
            {
              \tl_set:Nn \l__msz_frac_num_tl {#3}
              \bool_set_true:N  \l__msz_frac_num_paren_bool
              \bool_set_true:N  \l__msz_frac_den_present_bool
              \tl_set:Nn \l__msz_frac_den_tl {#4}
              \bool_set_false:N \l__msz_frac_den_paren_bool
            }
        }
    }

  \NewDocumentCommand \zfrac { s s o g o g }
    {
      \__msz_frac_parse:nnnnnn {#1}{#2}{#3}{#4}{#5}{#6}
      \ensuremath{ \__msz_frac_render:nn {#1} {#2} }
    }

\ExplSyntaxOff

% ==============================================================================
% \zscale [factor] {math}
% ------------------------------------------------------------------------------
% Scales math content uniformly by <factor>. Omitting <factor> uses the
% package option of the math style of the call (`scale-display`, `scale-text`,
% `scale-script` or `scale-scriptscript`); an explicit <factor> replaces it
% in whichever style the call sits. What the factor multiplies depends on
% the switch `scale-absolute` (see GLOBAL): true (default) -> the content set
% in the normal size; false -> the content set in the ambient style. The
% defaults are absolute factors derived as in "Choosing the factors" in
% GLOBAL. A nested call is guarded against shrinking below the scriptscript
% size (see "Nesting guard" in GLOBAL), but a factor given explicitly is
% never overridden. The output is one \mathord box (wrapped outside the
% \mathchoice, so a script attached afterwards sees a real atom). Safe in
% both math and text mode via an internal \ensuremath boundary.
%
% The helpers below are shared by \zdot, \zarg, \zscript, \zprime, \zlim and
% \zint, each of which passes its own option prefix (dot@scale, arg@scale,
% script@scale, prime@scale, lim@scale, int@scale), so every command reads
% its own four factors and its own switch.
%
%   \zscale{x^2}            % default factor of the context
%   \zscale[0.8]{\nabla f}  % explicit factor
% ==============================================================================

\ExplSyntaxOn

  \tl_new:N  \l__msz_scale_tl
  \tl_new:N  \l__msz_scale_name_tl
  \tl_new:N  \l__msz_scale_style_tl

  \dim_new:N \l__msz_scale_quad_dim

  % geometric scale of the enclosing scaled boxes (1 outside any), and the
  % one that applies inside the box being built; the size of the style the
  % content is set in (relative to the normal one), the size the call would
  % have alone, and the size of a scriptscript call of the same command
  \fp_new:N  \l__msz_scale_acc_fp
  \fp_new:N  \l__msz_scale_new_fp
  \fp_new:N  \l__msz_scale_rset_fp
  \fp_new:N  \l__msz_scale_p_fp
  \fp_new:N  \l__msz_scale_g_fp
  \fp_set:Nn \l__msz_scale_acc_fp { 1 }

  % sets fp #1 to the size of style #2 relative to the normal (text) style,
  % measured as a quad ratio. Uses only scratch registers, so the units set
  % by \__msz_unit:N are left untouched.
  \cs_new_protected:Npn \__msz_rel:NN #1#2
    {
      \hbox_set:Nn \l__msz_unit_box { $ \m@th \textstyle \mkern 18mu $ }
      \dim_set:Nn \l__msz_scale_quad_dim { \box_wd:N \l__msz_unit_box }
      \hbox_set:Nn \l__msz_unit_box { $ \m@th #2 \mkern 18mu $ }
      \fp_set:Nn #1
        { \dim_to_fp:n { \box_wd:N \l__msz_unit_box } / \dim_to_fp:n { \l__msz_scale_quad_dim } }
    }

  % resolves the factor applied to the box (into \l__msz_scale_tl), the
  % style in which the content is set (into \l__msz_scale_style_tl) and the
  % geometric scale that holds inside the box (into \l__msz_scale_new_fp) —
  % #1 factor (blank = option)  #2 option prefix, without msz@
  % #3 style name (display|text|script|scriptscript)  #4 ambient style
  % With p the size the call would have alone and g that of a scriptscript
  % call, the physical size is max(acc * p, min(p, g)): nesting may shrink a
  % call down to g, never below what p gives on its own.
  \cs_new_protected:Npn \__msz_scale_set:nnnN #1#2#3#4
    {
      \tl_set:Nx \l__msz_scale_name_tl {#3}
      \exp_args:Nv \str_if_eq:nnTF { msz@ #2 @absolute } { true }
        {
          \fp_set:Nn \l__msz_scale_rset_fp { 1 }
          \fp_set:Nn \l__msz_scale_g_fp { \use:c { msz@ #2 @scriptscript } }
          \str_if_eq:VnTF \l__msz_scale_name_tl { display }
            { \tl_set:Nn \l__msz_scale_style_tl { \displaystyle } }
            { \tl_set:Nn \l__msz_scale_style_tl { \textstyle } }
        }
        {
          \__msz_rel:NN \l__msz_scale_rset_fp #4
          \__msz_rel:NN \l__msz_scale_g_fp \scriptscriptstyle
          \fp_set:Nn \l__msz_scale_g_fp
            { \l__msz_scale_g_fp * \use:c { msz@ #2 @scriptscript } }
          \tl_set:Nn \l__msz_scale_style_tl {#4}
        }
      \tl_set:Nx \l__msz_scale_tl
        {
          \tl_if_blank:nTF {#1}
            { \use:c { msz@ #2 @ \l__msz_scale_name_tl } }
            {#1}
        }
      \fp_set:Nn \l__msz_scale_p_fp { \l__msz_scale_rset_fp * ( \l__msz_scale_tl ) }
      \fp_set:Nn \l__msz_scale_new_fp
        {
          max ( \l__msz_scale_acc_fp * \l__msz_scale_p_fp ,
                min ( \l__msz_scale_p_fp , \l__msz_scale_g_fp ) )
          / \l__msz_scale_rset_fp
        }
      \tl_set:Nx \l__msz_scale_tl
        { \fp_to_decimal:n { \l__msz_scale_new_fp / \l__msz_scale_acc_fp } }
    }

  % one \mathchoice branch — #1 factor (blank = option)  #2 math
  % #3 option prefix  #4 style name  #5 ambient style. Inside the box the
  % accumulated scale is the new one, so nested calls see it.
  \cs_new_protected:Npn \__msz_scale:nnnnN #1#2#3#4#5
    {
      \__msz_scale_set:nnnN {#1} {#3} {#4} #5
      \exp_args:NV \scalebox \l__msz_scale_tl
        {
          \fp_set_eq:NN \l__msz_scale_acc_fp \l__msz_scale_new_fp
          $ \m@th \l__msz_scale_style_tl #2 $
        }
    }

  \NewDocumentCommand \zscale { O{} m }
    {
      \ensuremath
        {
          \mathord
            {
              \mathchoice
                { \__msz_scale:nnnnN {#1} {#2} { scale } { display }      \displaystyle      }

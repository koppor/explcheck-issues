      \box_set_ht:Nn \l__msz_script_out_box
        {
          \box_ht:N \l__msz_script_out_box
          + \__msz_ratio:nN { \__msz_script_opt:n { above } } \l__msz_unit_v_dim
        }
      \box_set_dp:Nn \l__msz_script_out_box
        {
          \box_dp:N \l__msz_script_out_box
          + \__msz_ratio:nN { \__msz_script_opt:n { below } } \l__msz_unit_v_dim
        }
      \box_use:N \l__msz_script_out_box
    }


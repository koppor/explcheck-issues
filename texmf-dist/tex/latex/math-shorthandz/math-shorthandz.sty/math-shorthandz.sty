% ==============================================================================
% \zdiff + s t* [order] {var}
% ------------------------------------------------------------------------------
% Differential/derivative operator. No star: differential d^order var, set as
% a \mathinner atom, so TeX itself supplies the usual thin space against
% neighbouring Ord atoms in display/text style (none in script styles) and
% the usual binary/relation spacing elsewhere. The bare command is thus safe
% as an operand on its own (e.g. inside \frac), after \zarg, and after an
% operator that brings its own spacing (\zdot): Bin followed by Inner gets
% the same medium space as Bin followed by Ord, so nothing is doubled.
% A leading + adds an extra kern on top of that spacing — `zdiff-math-
% separation` when the call sits in display style, `zdiff-text-separation`
% in text/script/scriptscript style, chosen automatically via \mathchoice,
% mirroring \zint's math/text split. One star: derivative d^order/dvar^order
% as \frac, followed by `zdiff-kern`. Two stars (only meaningful with one
% star): derivative, as \nicefrac. [order] is the exponent of "d" (and, in
% the derivative form, of VAR as well); omit it for a first differential/
% derivative.
%
% Like \zint, these options are read at call time, so they may be set or
% locally overridden with \setkeys{shorthand}{...}.
%
%   \zdiff{x}   \zdiff+{x}   \zdiff[2]{x}   \zdiff+[2]{x}
%   \zdiff*[2]{x}   \zdiff**[2]{x}
% ==============================================================================

  \newcommand{\msz@diff@math@separation}{10mu}
  \newcommand{\msz@diff@text@separation}{5mu}
  \newcommand{\msz@diff@kern}{2mu}
  \define@key{shorthand}{zdiff-math-separation}{\renewcommand{\msz@diff@math@separation}{#1}}
  \define@key{shorthand}{zdiff-text-separation}{\renewcommand{\msz@diff@text@separation}{#1}}
  \define@key{shorthand}{zdiff-kern}{\renewcommand{\msz@diff@kern}{#1}}

\ExplSyntaxOn

  \NewDocumentCommand \zdiff { t+ s t* O{} m }
    {
      \ensuremath
        {
          \IfBooleanTF {#2}
            {
              \IfBooleanTF {#3}
                {
                  \nicefrac
                    { \text{d} \tl_if_blank:nF {#4} { ^{#4} } }
                    { \text{d} #5 \tl_if_blank:nF {#4} { ^{#4} } }
                }
                {
                  \frac
                    { \text{d} \tl_if_blank:nF {#4} { ^{#4} } }
                    { \text{d} #5 \tl_if_blank:nF {#4} { ^{#4} } }
                }
              \mkern \msz@diff@kern
            }
            {
              \mathinner
                {
                  \IfBooleanT {#1}
                    {
                      \mathchoice
                        { \mkern \msz@diff@math@separation }
                        { \mkern \msz@diff@text@separation }
                        { \mkern \msz@diff@text@separation }
                        { \mkern \msz@diff@text@separation }
                    }
                  \text{d} \tl_if_blank:nF {#4} { ^{#4} } #5
                }
            }
        }
    }


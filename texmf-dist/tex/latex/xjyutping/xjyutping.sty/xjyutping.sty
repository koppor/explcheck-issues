    \int_compare:nNnTF \l__xjyutping_nest_int = \c_zero_int
      { \__xjyutping_collected: }
      {
        \int_decr:N \l__xjyutping_nest_int
        \tl_put_right:Nn \l__xjyutping_collect_tl { \end }
        \__xjyutping_collect:w \q_nil

      { \cs_if_exist_p:c { xjp@w@ \__xjyutping_word:nnN {#1} {#2} \__xjyutping_can:n } }
      { \prg_return_true: } { \prg_return_false: }
  }
\cs_new:Npn \__xjyutping_longest:n #1
  {
    \int_max:nn
      { \cs_if_exist_use:cF { xjp@e@ \__xjyutping_raw:n {#1} } { 0 } }
      { \cs_if_exist_use:cF { xjp@e@ \__xjyutping_can:n {#1} } { 0 } }
  }
\cs_new_protected:Npn \__xjyutping_flush:
  {

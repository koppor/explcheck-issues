\dim_new:N  \l__xjyutping_cell_dim
\dim_new:N  \g__xjyutping_max_dim
\dim_new:N  \g__xjyutping_pad_dim
\skip_new:N \l__xjyutping_hsep_skip
\fp_new:N   \l__xjyutping_bls_fp

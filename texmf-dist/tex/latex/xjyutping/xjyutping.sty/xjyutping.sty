      { \use:c { xjp@len@ \int_use:N \l__xjyutping_ctx_int } }
    \int_compare:nNnT \l__xjyutping_len_int > \c_zero_int
      {
        \cs_set_nopar:cpn { xjp@cost@0 } { 0 }
        \int_step_inline:nn { \l__xjyutping_len_int }
          {
            \int_set:Nn \l__xjyutping_best_int
              { \use:c { xjp@cost@ \int_eval:n { ##1 - 1 } } + 100001 }
            \cs_set_nopar:cpn { xjp@back@ ##1 } { 1 }
            \int_step_inline:nnn { 2 }
              { \int_min:nn {##1} { \__xjyutping_longest:n {##1} } }
              {
                \__xjyutping_if_word:nnT { ##1 - ####1 + 1 } {##1}
                  {
                    \int_compare:nNnT
                      { \use:c { xjp@cost@ \int_eval:n { ##1 - ####1 } } + 100000 }
                      < { \l__xjyutping_best_int + 1 }
                      {
                        \int_set:Nn \l__xjyutping_best_int
                          { \use:c { xjp@cost@ \int_eval:n { ##1 - ####1 } } + 100000 }
                        \cs_set_nopar:cpn { xjp@back@ ##1 } {####1}
                      }

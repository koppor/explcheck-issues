% Inside the environment every line is the same distance apart: room for a
% ruby, its clearance and the depth of a line.  The minimum follows size
% changes inside the scope.
\cs_new_protected:Npn \__xjyutping_baselineskip:
  {
    \__xjyutping_ruby:nn { } { s }

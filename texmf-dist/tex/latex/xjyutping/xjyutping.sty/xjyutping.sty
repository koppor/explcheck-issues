          {
            \cs_set_eq:NN \__xjyutping_save_CJKglue: \CJKglue
            \cs_set_eq:NN \CJKglue \__xjyutping_CJKglue:
          }
        \cs_if_eq:NNF \CJKecglue \__xjyutping_CJKecglue:
          {
            \cs_set_eq:NN \__xjyutping_save_CJKecglue: \CJKecglue
            \cs_set_eq:NN \CJKecglue \__xjyutping_CJKecglue:
          }

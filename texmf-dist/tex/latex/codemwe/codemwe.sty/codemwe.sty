\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\RequirePackage{expl3}
\ProvidesExplPackage{codemwe}{2026-10-23}{v1.1.0}
  {typeset code with result box and generate MWE file using LaTeX3}

% 宏包版本检查函数
% #1 宏包名
% #2 要求的最低日期
\cs_new_protected:Npn \__codemwe_check_package_date:nn #1#2
  {
    \@ifpackagelater{ #1 }{ #2 }
      { }
      { \msg_warning:nnn { codemwe } { package-old } { #1 } }
  }

% 消息定义
% ===================================================================
% 宏包过期
\msg_new:nnn { codemwe } { package-old }
  {
    Package~#1~is~out~of~date. \\
    Some~problems~or~errors~may~occur~if~you~continue~compiling. \\\\
    Please~update~this~package~from~CTAN.
  }

% width 宽度设置过大
\msg_new:nnn { codemwe } { width-too-large }
  {
    The~'width'~option~is~too~large,~so~the~right~result~box~has~a~
    negative~width. \\
    Please~reduce~'width'~or~'sep'.
  }

% 未知 key-val 选项
\msg_new:nnn { codemwe } { unknown-key }
  {
    Unknown~key-val~option~'#1'~for~package~'codemwe'. \\
    Please~check~the~spelling~of~the~option~name. \\
    The~option~'#1'~has~been~ignored.
  }

% 结果图片文件不存在
\msg_new:nnn { codemwe } { result-file-missing }
  {
    The~result~image~file~'#1'~was~not~found. \\
    Please~check~the~'result'~option.
  }

% 计数器冲突（用户指定的 counter 已经存在）
\msg_new:nnn { codemwe } { counter-exists }
  {
    The~counter~'#1'~already~exists. \\
    The~'counter'~option~has~been~ignored;~please~choose~another~name.
  }

% 未知语种类型
\msg_new:nnn { codemwe } { unknown-textlang }
  {
    Unknown~language~'#1'. \\
    Falling~back~to~'en'. \\
    Use~\token_to_str:N \codemweNewLang~to~register~a~new~language.
  }

% 过渡语及注释词内容检索值错误
\msg_new:nnn { codemwe } { textlang-item-count }
  {
    Language~'#1'~provides~#2~items~instead~of~8. \\
    Please~check~its~definition.
  }

% 注册 tcolorbox 盒子失败，未知盒子类型
\msg_new:nnn { codemwe } { unknown-boxtype }
  {
    Unknown~box~type~'#1'. \\
    Falling~back~to~'syntaxbox'. \\
    Please~use~a~valid~box~environment~name,~or~register~one~
    via~\token_to_str:N \codemweNewBox.
  }

% 未知代码后端
\msg_new:nnn { codemwe } { unknown-backend }
  {
    Unknown~code~backend~'#1'. \\
    Falling~back~to~'tex'. \\
    Please~use~a~valid~backend~name,~or~register~one~
    via~\token_to_str:N \codemweNewBackend.
  }

% 不可编译后端缺少结果图片
\msg_new:nnn { codemwe } { backend-no-result }
  {
    Backend~'#1'~code~cannot~be~compiled~by~LaTeX,~and~no~result~
    image~is~given~by~the~'result'~option. \\
    The~result~box~has~been~skipped. \\
    Please~provide~a~result~image~via~the~'result'~option,~or~use~
    the~'noshow'~option.
  }

% minted 不可用（缺少 minted 宏包或未开启 shell escape）
\msg_new:nnn { codemwe } { minted-unavailable }
  {
    The~'minted'~option~requires~the~minted~package~and~shell~escape. \\
    minted~is~not~available,~so~the~code~is~typeset~with~fancyvrb~
    and~no~syntax~highlighting~is~applied. \\
    Please~install~minted,~enable~shell~escape~(-shell-escape),~
    and~recompile.
  }

% 未加载 minted 时就设置了 mintedstyle
\msg_new:nnn { codemwe } { mintedstyle-unused }
  {
    The~'mintedstyle'~option~has~no~effect~unless~the~'minted'~option~
    is~set. \\
    The~value~'#1'~has~been~recorded~and~will~be~used~together~with~
    the~'minted'~option.
  }

% 后端没有为 minted 指定代码语言名
\msg_new:nnn { codemwe } { minted-no-lexer }
  {
    Code~backend~'#1'~is~used~with~the~'minted'~option,~but~no~minted~
    language~name~is~assigned~to~it. \\
    The~name~'#1'~itself~is~passed~to~minted~as~the~lexer;~if~minted~
    does~not~know~it,~it~will~fall~back~to~plain~text. \\
    Assign~a~language~with~\token_to_str:N \codemweNewBackend.
  }

% minted 语言名未知（仍交给 minted 处理，由 minted 报告）
\msg_new:nnn { codemwe } { minted-unknown-lexer }
  {
    minted~does~not~know~the~language~name~'#1'~used~for~code~backend~
    '#2'. \\
    minted~will~report~an~error~and~fall~back~to~plain~text~output.
  }

% 为宏包传入参数
\clist_map_inline:nn
  {
    { many                }{ tcolorbox },
  }{ \PassOptionsToPackage #1 }

% 加载需要的宏包
\RequirePackage
  {
    tcolorbox, % 彩色盒子
    fancyvrb,  % 代码排版宏包
    graphicx,  % 插入图片
  }

% 检查指定的宏包是否过于陈旧
\clist_map_inline:nn
  {
    { expl3     }{ 2020/10/27 },
    { tcolorbox }{ 2020/10/09 },
  }{ \__codemwe_check_package_date:nn #1 }

% tcolorbox 盒子定义
% ===================================================================
% mwebox 盒子
% #1（可选，[]）背景色，默认 cyan
% #2（可选，()）标题
% #3（可选，[]）额外 tcolorbox 选项
\DeclareTColorBox{ mwebox }{ O{ cyan } d() O{  } }
  {
    enhanced~jigsaw,
    frame~hidden,
    center~title,

    IfValueT = { #2 }
      { title = #2 },

    pad~at~break*    = 3pt,
    boxrule          = 0pt,
    toptitle         = 3pt,
    colback          = #1,
    colbacktitle     = #1,
    opacityback      = 0.1,
    opacitybacktitle = 0.1,
    coltitle         = black,
    colframe         = black,
    left             = 6pt,
    right            = 6pt,
    top              = 0pt,
    bottom           = 3pt,
    middle           = 3pt,
    bottomtitle      = 3pt,
    beforeafter~skip = 2ex,
    halign~upper     = left,
    halign~lower     = left,
    #3
  }

% mwebox* 盒子
% #1（可选，[]）背景色，默认 cyan
% #2（可选，()）标题
% #3（可选，[]）额外 tcolorbox 选项
\DeclareTColorBox{ mwebox* }{ O{ cyan } d() O{  } }
  {
    enhanced~jigsaw,
    center~title,

    IfValueT = { #2 }
      { title = #2 },

    pad~at~break* = 3pt,
    toptitle         = 3pt,
    colback          = #1,
    colbacktitle     = #1,
    opacityback      = 0.1,
    opacitybacktitle = 0.1,
    coltitle         = black,
    colframe         = black,
    boxrule          = 0.4pt,
    left             = 6pt,
    right            = 6pt,
    top              = 3pt,
    bottom           = 3pt,
    middle           = 3pt,
    bottomtitle      = 3pt,
    beforeafter~skip = 2ex,
    halign~upper     = left,
    halign~lower     = left,
    #3
  }

% mweparbox 盒子
% #1（可选，[]）边框颜色，默认 purple
% #2（可选，()）标题
% #3（可选，[]）额外 tcolorbox 选项
\DeclareTColorBox{ mweparbox }{ O{ purple } d() O{  } }
  {
    frame~hidden,
    enhanced~jigsaw,

    IfValueTF = { #2 }
      {
        title = #2,
        top   = 0pt
      }{
        top   = 3pt
      },

    bottom           = 3pt,
    toptitle         = 3pt,
    left             = 6pt,
    right            = 6pt,
    middle           = 3pt,
    bottomtitle      = 3pt,
    beforeafter~skip = 1.5ex,
    pad~at~break*    = 3pt,
    boxrule          = 0pt,
    borderline~west  = { 3pt }{ 0pt }{ #1 },
    colback          = #1,
    colbacktitle     = #1,
    opacityback      = 0.1,
    opacitybacktitle = 0.1,
    colframe         = #1,
    coltitle         = #1,
    #3
  }

% mweparbox* 盒子
% #1（可选，[]）边框颜色，默认 purple
% #2（可选，()）标题
% #3（可选，[]）额外 tcolorbox 选项
\DeclareTColorBox{ mweparbox* }{ O{ purple } d() O{  } }
  {
    frame~hidden,
    enhanced~jigsaw,

    IfValueT = { #2 }
      { title = #2 },

    toptitle         = 0pt,
    left             = 6pt,
    right            = 6pt,
    top              = 0pt,
    middle           = 3pt,
    bottom           = 0pt,
    bottomtitle      = 3pt,
    beforeafter~skip = 1.5ex,
    pad~at~break*    = 3pt,
    boxrule          = 0pt,
    borderline~west  = { 3pt }{ 0pt }{ #1 },
    colback          = white,
    colframe         = #1,
    coltitle         = #1,
    #3
  }

% syntaxbox 盒子
% #1（可选，[]）背景色，默认 gray!12
% #2（可选，()）标题
% #3（可选，[]）额外 tcolorbox 选项
\DeclareTColorBox{ syntaxbox }{ O{ gray!12 } d() O{ } }
  {
    colback   = #1,
    colframe  = #1,
    boxrule   = 0pt,
    arc       = 0pt,
    left      = 6pt,
    right     = 6pt,
    top       = 3pt,
    bottom    = 3pt,
    nobeforeafter,
    #3,
  }

% syntaxbox* 盒子
% #1（可选，[]）背景色，默认 white
% #2（可选，()）标题
% #3（可选，[]）额外 tcolorbox 选项
\DeclareTColorBox{ syntaxbox* }{ O{ white } d() O{ } }
  {
    colback   = #1,
    colframe  = black,
    boxrule   = 0pt,
    arc       = 0pt,
    left      = 6pt,
    right     = 6pt,
    top       = 3pt,
    bottom    = 3pt,
    nobeforeafter,
    #3,
  }


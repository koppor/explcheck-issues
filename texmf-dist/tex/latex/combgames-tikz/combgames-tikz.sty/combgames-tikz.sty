% helper: coin outline + centered text
\newcommand{\SNCcoin}[1]{%
	\draw (.5,.5) circle[radius=.5];%
	\node at (.5,.5){#1};%
}

\gridtoken{SNC}{.}{}                                  % empty cell
\gridtoken{SNC}{o}{\SNCcoin{\$}}                      % coin with $
\gridtoken{SNC}{A}{\SNCcoin{\textbf{A}}}             % coin with A
\gridtoken{SNC}{B}{\SNCcoin{\textbf{B}}}             % coin with B

% edges (short inside-cell segments, centered)
\gridtoken{SNC}{-}{\draw (0.05,.5)--(.95,.5);}        % solid horizontal
\gridtoken{SNC}{|}{\draw (.5,0.05)--(.5,.95);}        % solid vertical
\gridtoken{SNC}{+}{\draw[densely dotted] (0.05,.5)--(.95,.5);}  % dotted horiz
\gridtoken{SNC}{:}{\draw[densely dotted] (.5,0.05)--(.5,.95);}  % dotted vert

% specials with loony mark near the center-left
\gridtoken{SNC}{*}{%
	\draw (0.05,.5)--(.95,.5);%
	\node at (.45,.5){\small$\scriptstyle\cgloony$};%
}
\gridtoken{SNC}{!}{%
	\draw (.5,0.05)--(.5,.95);%
	\node at (.45,.50){\small$\scriptstyle\cgloony$};%
}

% wrapper
\NewDocumentCommand{\StringsAndCoins}{ O{.35cm} m }{%
	\GridGame[#1]{SNC}{#2}%
}


\newcommand{\cgt@toad}{%
  \begin{scope}[line join=round,line cap=round]
    \def\cgt@animalfill{black}\ifgridgamecolor\def\cgt@animalfill{blue}\fi
    \filldraw[fill=\cgt@animalfill]
      (.13,.24)..controls(.11,.42)and(.22,.56)..(.38,.57)
      ..controls(.47,.60)and(.54,.56)..(.60,.55)
      ..controls(.59,.69)and(.75,.70)..(.77,.57)
      ..controls(.83,.55)and(.88,.51)..(.88,.45)
      ..controls(.88,.39)and(.78,.38)..(.72,.38)
      --(.73,.24)--(.87,.20)--(.62,.20)--(.58,.31)
      ..controls(.47,.22)and(.27,.19)..(.13,.24)--cycle;
    \draw[white,line width=.45pt] (.22,.25)
      ..controls(.18,.42)and(.38,.48)..(.47,.37)
      --(.34,.24)--(.52,.24);
    \fill[white] (.697,.585) circle[radius=.022];
  \end{scope}%
}
\newcommand{\cgt@frog}{%
  % Reflect a right-facing frog to face left.
  \begin{scope}[shift={(1,0)},xscale=-1,line join=round,line cap=round]
    \def\cgt@animalfill{white}\ifgridgamecolor\def\cgt@animalfill{red}\fi
    \filldraw[fill=\cgt@animalfill]
      (.12,.23)..controls(.10,.40)and(.22,.52)..(.36,.49)
      ..controls(.47,.47)and(.55,.52)..(.63,.56)
      ..controls(.62,.67)and(.75,.69)..(.78,.57)
      --(.91,.48)..controls(.90,.42)and(.79,.40)..(.72,.40)
      --(.68,.24)--(.88,.19)--(.59,.19)--(.57,.34)
      ..controls(.44,.28)and(.28,.20)..(.12,.23)--cycle;
    \draw (.18,.25)..controls(.16,.42)and(.31,.47)..(.41,.38)
      --(.27,.23)--(.50,.19);
    \fill (.716,.588) circle[radius=.023];
  \end{scope}%
}

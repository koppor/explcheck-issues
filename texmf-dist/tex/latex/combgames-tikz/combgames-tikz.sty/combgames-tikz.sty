% Hex options: [cell width][boundary=standard|swapped|none,
%   edges={row/column/NE/blue,row/column/W/red,...}].
% Rows and columns are 1-based in the normalized input (empty rows ignored).
\ExplSyntaxOn
\cs_generate_variant:Nn \regex_match:nnTF {ne}
\tl_new:N \l__cgt_hex_boundary_tl
\clist_new:N \l__cgt_hex_edges_clist
\seq_new:N \l__cgt_hex_edge_seq
\tl_new:N \l__cgt_hex_row_tl
\tl_new:N \l__cgt_hex_color_tl
\bool_new:N \l__cgt_hex_valid_bool
\int_new:N \l__cgt_hex_r_int
\int_new:N \l__cgt_hex_c_int
\keys_define:nn { cgt/hex } {
  boundary .choice:,
  boundary / none .code:n = {\tl_set:Nn \l__cgt_hex_boundary_tl {none}},
  boundary / standard .code:n = {\tl_set:Nn \l__cgt_hex_boundary_tl {standard}},
  boundary / swapped .code:n = {\tl_set:Nn \l__cgt_hex_boundary_tl {swapped}},
  edges .clist_set:N = \l__cgt_hex_edges_clist,
}
\msg_new:nnn {combgames-tikz}{hex-edge}
  {Invalid~Hex~edge~'#1'.~Use~row/column/NE|E|SE|SW|W|NW/blue|red;~the~cell~must~exist.}
\msg_new:nnn {combgames-tikz}{hex-full-board}
  {The~Hex~boundary~shortcut~requires~equal-length~rows~without~holes~('.').~Use~explicit~edges~for~fragments.}
% Endpoints follow a point-up hexagon clockwise from its top vertex.
\cs_new:cpn {cgt@hexedge@NE}{(0,.577350269)--(.5,.288675135)}
\cs_new:cpn {cgt@hexedge@E}{(.5,.288675135)--(.5,-.288675135)}
\cs_new:cpn {cgt@hexedge@SE}{(.5,-.288675135)--(0,-.577350269)}
\cs_new:cpn {cgt@hexedge@SW}{(0,-.577350269)--(-.5,-.288675135)}
\cs_new:cpn {cgt@hexedge@W}{(-.5,-.288675135)--(-.5,.288675135)}
\cs_new:cpn {cgt@hexedge@NW}{(-.5,.288675135)--(0,.577350269)}
\cs_new_protected:Npn \cgt_hex_draw_edge:nnnn #1#2#3#4 {
  \edef\cgt@edgepath{\use:c{cgt@hexedge@#3}}
  \begin{scope}[shift={({#2-1+.5*(#1-1)},{-.866025404*(#1-1)})}]
    \edef\cgt@drawedge{\noexpand\draw[draw=#4,line~width=1.4pt,line~cap=round]~\cgt@edgepath;}
    \cgt@drawedge
  \end{scope}
}
\cs_new_protected:Npn \cgt_hex_explicit_edge:n #1 {
  \seq_set_split:Nnn \l__cgt_hex_edge_seq {/}{#1}
  \bool_set_true:N \l__cgt_hex_valid_bool
  \int_compare:nNnTF {\seq_count:N\l__cgt_hex_edge_seq}={4}{
    \regex_match:neTF {\A[1-9][0-9]*\Z}{\seq_item:Nn\l__cgt_hex_edge_seq{1}}{}{
      \bool_set_false:N\l__cgt_hex_valid_bool}
    \regex_match:neTF {\A[1-9][0-9]*\Z}{\seq_item:Nn\l__cgt_hex_edge_seq{2}}{}{
      \bool_set_false:N\l__cgt_hex_valid_bool}
    \cs_if_exist:cF {cgt@hexedge@\seq_item:Nn\l__cgt_hex_edge_seq{3}}{
      \bool_set_false:N\l__cgt_hex_valid_bool}
    \str_case_e:nnF {\seq_item:Nn\l__cgt_hex_edge_seq{4}}{{blue}{}{red}{}}{
      \bool_set_false:N\l__cgt_hex_valid_bool}
  }{\bool_set_false:N\l__cgt_hex_valid_bool}
  \bool_if:NT \l__cgt_hex_valid_bool {
    \int_set:Nn\l__cgt_hex_r_int{\seq_item:Nn\l__cgt_hex_edge_seq{1}}
    \int_set:Nn\l__cgt_hex_c_int{\seq_item:Nn\l__cgt_hex_edge_seq{2}}
    \int_compare:nNnTF {\l__cgt_hex_r_int}>{\l__R}{
      \bool_set_false:N\l__cgt_hex_valid_bool
    }{
      \tl_set:Ne\l__cgt_hex_row_tl{\seq_item:Nn\l__rows{\l__cgt_hex_r_int}}
      \int_compare:nNnTF {\l__cgt_hex_c_int}>{\tl_count:N\l__cgt_hex_row_tl}{
        \bool_set_false:N\l__cgt_hex_valid_bool
      }{
        \str_if_eq:eeT{\tl_item:Nn\l__cgt_hex_row_tl{\l__cgt_hex_c_int}}{.}{
          \bool_set_false:N\l__cgt_hex_valid_bool}
      }
    }
  }
  \bool_if:NTF\l__cgt_hex_valid_bool{
    \cgt_hex_draw_edge:nnnn{\int_use:N\l__cgt_hex_r_int}{\int_use:N\l__cgt_hex_c_int}
      {\seq_item:Nn\l__cgt_hex_edge_seq{3}}{\seq_item:Nn\l__cgt_hex_edge_seq{4}}
  }{\msg_error:nnn{combgames-tikz}{hex-edge}{#1}}
}
\cs_new_protected:cpn {cgt@aftercells@HEX}{
  \tl_if_eq:NnF\l__cgt_hex_boundary_tl{none}{
    \bool_set_true:N\l__cgt_hex_valid_bool
    \seq_map_inline:Nn\l__rows{
      \int_compare:nNnF{\tl_count:n{##1}}={\l__C}{\bool_set_false:N\l__cgt_hex_valid_bool}
      \tl_if_in:nnT{##1}{.}{\bool_set_false:N\l__cgt_hex_valid_bool}
    }
    \bool_if:NTF\l__cgt_hex_valid_bool{
      \int_compare:nNnT{\l__R}>{0}{
        % Top and bottom: red in standard mode.
        \tl_set:Nn\l__cgt_hex_color_tl{red}
        \tl_if_eq:NnT\l__cgt_hex_boundary_tl{swapped}{\tl_set:Nn\l__cgt_hex_color_tl{blue}}
        \int_step_inline:nn{\l__C}{
          \cgt_hex_draw_edge:nnnn{1}{##1}{NW}{\l__cgt_hex_color_tl}
          \cgt_hex_draw_edge:nnnn{1}{##1}{NE}{\l__cgt_hex_color_tl}
          \cgt_hex_draw_edge:nnnn{\int_use:N\l__R}{##1}{SW}{\l__cgt_hex_color_tl}
          \cgt_hex_draw_edge:nnnn{\int_use:N\l__R}{##1}{SE}{\l__cgt_hex_color_tl}
        }
        % Left and right include the exposed diagonal edges between rows.
        \tl_set:Nn\l__cgt_hex_color_tl{blue}
        \tl_if_eq:NnT\l__cgt_hex_boundary_tl{swapped}{\tl_set:Nn\l__cgt_hex_color_tl{red}}
        \int_step_inline:nn{\l__R}{
          \cgt_hex_draw_edge:nnnn{##1}{1}{W}{\l__cgt_hex_color_tl}
          \cgt_hex_draw_edge:nnnn{##1}{\int_use:N\l__C}{E}{\l__cgt_hex_color_tl}
          \int_compare:nNnT{##1}<{\l__R}{\cgt_hex_draw_edge:nnnn{##1}{1}{SW}{\l__cgt_hex_color_tl}}
          \int_compare:nNnT{##1}>{1}{\cgt_hex_draw_edge:nnnn{##1}{\int_use:N\l__C}{NE}{\l__cgt_hex_color_tl}}
        }
      }
    }{\msg_error:nn{combgames-tikz}{hex-full-board}}
  }
  % Explicit edges are drawn last, allowing selected shortcut edges to be overridden.
  \clist_map_function:NN\l__cgt_hex_edges_clist\cgt_hex_explicit_edge:n
}

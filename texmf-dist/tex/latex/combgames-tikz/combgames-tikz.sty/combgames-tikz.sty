\NewDocumentCommand{\Phutball}{O{.35cm} O{} m m}{%
  \begingroup
  \def\cgt@phutcols{15}\def\cgt@phutrows{19}\def\cgt@phutmove{}%
  \def\cgt@movecolor{black}\ifgridgamecolor\def\cgt@movecolor{red}\fi
  \cgt@numberedtrue\cgt@pointlabelsfalse
  \pgfkeys{/cgt/phut/.cd,#2}\cgt@phutdimensions\cgt@phutreset\cgt@phutballcount{#4}
  \ensuremath{\mathord{\vcenter{\hbox{\begin{tikzpicture}[x=#1,y=#1]
    \draw[gray!65,step=1] (1,1) grid (\cgt@phutcols,\cgt@phutrows);
    \ifcgt@pointlabels

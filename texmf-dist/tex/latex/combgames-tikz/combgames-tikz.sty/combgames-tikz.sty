%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% PHUTBALL: INTERSECTIONS AND ANNOTATED JUMP PATHS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% [unit][columns=15,rows=19,move={x/y,...},numbered=true,move color=...]
% Mandatory arguments: black stones {x/y,...}, white ball {x/y} (or {}).
% Coordinates start at 1/1 in the bottom left. The move includes its start.
% Move coordinates may lie outside the grid, to illustrate a winning jump.
\newif\ifcgt@numbered
\pgfkeys{/cgt/phut/.is family,/cgt/phut,
  columns/.store in=\cgt@phutcols,rows/.store in=\cgt@phutrows,
  move/.store in=\cgt@phutmove,move color/.store in=\cgt@movecolor,
  numbered/.is if=cgt@numbered,numbered/.default=true,
  labels/.is if=cgt@pointlabels,labels/.default=true}
\ExplSyntaxOn
\seq_new:N \l__cgt_xy_seq
\clist_new:N \l__cgt_phutoccupied_clist
\cs_new_protected:Npn \cgt@phutreset {\clist_clear:N \l__cgt_phutoccupied_clist}
\cs_new_protected:Npn \cgt@phutballcount #1 {
  \int_compare:nNnT {\clist_count:n{#1}}>{1}{
    \PackageError{combgames-tikz}{Phutball~has~more~than~one~white~ball}{Supply~one~coordinate~or~an~empty~argument.}
  }
}
\cs_new_protected:Npn \cgt@xy #1 {
  \regex_match:nnTF {\A\s*-?\d+\s*/\s*-?\d+\s*\Z} {#1} {
    \seq_set_split:Nnn \l__cgt_xy_seq {/}{#1}
    \edef\cgt@x{\int_eval:n{\seq_item:Nn\l__cgt_xy_seq{1}}}
    \edef\cgt@y{\int_eval:n{\seq_item:Nn\l__cgt_xy_seq{2}}}
  }{\PackageError{combgames-tikz}{Invalid~coordinate~#1}{Use~integer~pairs~such~as~11/6.}\def\cgt@x{1}\def\cgt@y{1}}
}
\cs_new_protected:Npn \cgt@phutstones #1#2 {
  \clist_map_inline:nn {#1}{
    \cgt@xy{##1}
    \bool_if:nTF {
      \int_compare_p:n{1<=\cgt@x<=\cgt@phutcols} &&
      \int_compare_p:n{1<=\cgt@y<=\cgt@phutrows}
    }{
      \tl_set:Nx \l_tmpa_tl {\cgt@x/\cgt@y}
      \exp_args:NNV \clist_if_in:NnTF \l__cgt_phutoccupied_clist \l_tmpa_tl
        {\PackageError{combgames-tikz}{Phutball~point~##1~is~occupied~twice}{Use~each~point~only~once.}}
        {\clist_put_right:NV \l__cgt_phutoccupied_clist \l_tmpa_tl
         \filldraw[fill=#2] (\cgt@x,\cgt@y) circle[radius=.24];}
    }
    {\PackageError{combgames-tikz}{Stone~##1~is~outside~the~Phutball~board}{Increase~rows/columns~or~correct~the~coordinate.}}
  }
}
\cs_new_protected:Npn \cgt@phutpath #1 {
  \int_zero:N \l_tmpa_int
  \clist_map_inline:nn {#1}{
    \cgt@xy{##1}
    \int_incr:N \l_tmpa_int
    \int_compare:nNnT {\l_tmpa_int}>{1}{
      \draw[draw=\cgt@movecolor,line~width=.35pt,densely~dashed]
        (\cgt@prevx,\cgt@prevy)--(\cgt@x,\cgt@y);
    }
    \edef\cgt@prevx{\cgt@x}\edef\cgt@prevy{\cgt@y}
  }
  % Draw labels last, so later segments never run across earlier labels.
  \ifcgt@numbered
    \int_zero:N \l_tmpa_int
    \clist_map_inline:nn {#1}{
      \cgt@xy{##1}\int_incr:N \l_tmpa_int
      \int_compare:nNnT {\l_tmpa_int}>{1}{
        \node[circle,draw=\cgt@movecolor,line~width=.3pt,font=\tiny,
          fill=white,text=\cgt@movecolor,inner~sep=.6pt]
          at (\cgt@x,\cgt@y) {\int_eval:n{\l_tmpa_int-1}};
      }
    }
  \fi
}
\cs_new_protected:Npn \cgt@phutdimensions {
  \regex_match:neTF {\A[1-9]\d*\Z}{\cgt@phutcols}{}{
    \PackageError{combgames-tikz}{Invalid~Phutball~columns}{Use~a~positive~integer.}\def\cgt@phutcols{15}}
  \regex_match:neTF {\A[1-9]\d*\Z}{\cgt@phutrows}{}{
    \PackageError{combgames-tikz}{Invalid~Phutball~rows}{Use~a~positive~integer.}\def\cgt@phutrows{19}}
}
\cs_generate_variant:Nn \regex_match:nnTF {ne}

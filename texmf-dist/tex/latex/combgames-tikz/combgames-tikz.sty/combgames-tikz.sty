%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% GridGame setup
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\ExplSyntaxOn
\msg_new:nnn { combgames-tikz } { unknown-token }
  { Unknown~token~'#2'~in~game~'#1';~leaving~this~position~empty. }
% token registry
\NewDocumentCommand \gridtoken { m m m }{
	\cs_set_protected:cpn { cgt@map@#1@#2 } { #3 }
}

% minimal engine
% ===================== GridGame (with bbox margins) =====================
\NewDocumentCommand \GridGame { O{.35cm} m m }{%
	\ensuremath{%
		\mathord{%
			\vcenter{\hbox{%
					\begin{tikzpicture}[x=#1,y=#1, every node/.style={inner sep=0pt,outer sep=0pt}]
						% ---- measure rows/cols ----
						\seq_clear_new:N \l__rows
						\int_zero_new:N \l__R
						\int_zero_new:N \l__C
						\int_zero_new:N \l__len
						\seq_set_split:Nnn \l__rows { \\ } { #3 }
                        % Ignore empty rows, including rows containing only spaces.
                        \seq_clear_new:N \l__cgt_nonempty_rows_seq
                        \seq_map_inline:Nn \l__rows {
                          \tl_set:Nn \l_tmpa_tl { ##1 }
                          \tl_remove_all:Nn \l_tmpa_tl { \c_space_tl }
                          \tl_remove_all:Nn \l_tmpa_tl { ~ }
                          \tl_remove_all:Nn \l_tmpa_tl { ^^a0 }
                          \tl_if_blank:VF \l_tmpa_tl
                            { \seq_put_right:NV \l__cgt_nonempty_rows_seq \l_tmpa_tl }
                        }
                        \seq_set_eq:NN \l__rows \l__cgt_nonempty_rows_seq
                        \int_set:Nn \l__R { \seq_count:N \l__rows }
						\int_zero:N \l__C
						\seq_map_inline:Nn \l__rows {
							\tl_set:Nn \l_tmpa_tl { ##1 }
							\tl_remove_all:Nn \l_tmpa_tl { \c_space_tl } \tl_remove_all:Nn \l_tmpa_tl { ~ } \tl_remove_all:Nn \l_tmpa_tl { ^^a0 }
							\int_set:Nn \l__len { \tl_count:N \l_tmpa_tl }
							\int_compare:nNnT { \l__len } > { \l__C } { \int_set_eq:NN \l__C \l__len }
						}
						
						% ---- per-game bbox margins lookup ----
						\edef\cgt@bbl{%
							\ifcsname cgt@bboxlower@#2\endcsname
							\csname cgt@bboxlower@#2\endcsname
							\else
							\csname cgt@bboxlower@DEFAULT\endcsname
							\fi}
						\edef\cgt@bbu{%
							\ifcsname cgt@bboxupper@#2\endcsname
							\csname cgt@bboxupper@#2\endcsname
							\else
							\csname cgt@bboxupper@DEFAULT\endcsname
							\fi}
						
						% ---- prime the picture bbox so \vcenter centers visible artwork ----
						\path (0,\cgt@bbl) rectangle (\int_eval:n{\l__C}, {\int_eval:n{\l__R}+\cgt@bbu});
						
						% ---- draw cells/tokens ----
						\cs_if_exist_use:c { cgt@beforecells@#2 }
                        \int_zero_new:N \l__row
						\int_zero_new:N \l__col
						\seq_map_inline:Nn \l__rows {
							\int_incr:N \l__row
							\tl_set:Nn \l_tmpa_tl { ##1 }
							\tl_remove_all:Nn \l_tmpa_tl { \c_space_tl } \tl_remove_all:Nn \l_tmpa_tl { ~ } \tl_remove_all:Nn \l_tmpa_tl { ^^a0 }
							\int_zero:N \l__col
							\tl_map_inline:Nn \l_tmpa_tl {
								\int_incr:N \l__col
								\cs_if_exist:cTF { cgt@position@#2 }
                                  { \edef\cgt@cellposition{\use:c{cgt@position@#2}} }
                                  { \edef\cgt@cellposition{(\int_eval:n{\l__col-1},\int_eval:n{\l__R-\l__row})} }
                                \edef\cgt@begincell{\noexpand\begin{scope}[shift={\cgt@cellposition}]}\cgt@begincell
									\coordinate (cellcenter) at (.5,.5);
									\cs_if_exist_use:cF { cgt@map@#2@####1 } { \msg_warning:nnnn { combgames-tikz } { unknown-token } {#2} {####1} }
								\end{scope}
							}
						}
					\cs_if_exist_use:c { cgt@aftercells@#2 }
					\end{tikzpicture}%
			}}%
		}%
	}%
}

\ExplSyntaxOff

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% DOMINEERING
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% ------------ Domineering tokens ------------
\gridtoken{DomTok}{.}{}                        % empty
\gridtoken{DomTok}{o}{\draw (0,0) rectangle (1,1);}  % outline 1×1
\gridtoken{DomTok}{x}{%
	\fill[draw=none,fill=lightgray] (0,0) rectangle (1,1);
	\draw (0,0) rectangle (1,1);
}
\gridtoken{DomTok}{^}{}%
% n is a safe alias for ^ (the top half); v draws the whole vertical domino.
\gridtoken{DomTok}{n}{\csname cgt@map@DomTok@^\endcsname}
\gridtoken{DomTok}{>}{}%
\gridtoken{DomTok}{v}{%
	\draw (0,0) rectangle (1,2);
	\fill (0.4,0.4) -- (0.2,0.2) -- (0.8,0.2) -- (0.6,0.4)
	-- (0.6,1.6) -- (0.8,1.8) -- (0.2,1.8) -- (0.4,1.6) -- cycle;
}
\gridtoken{DomTok}{<}{%
	\draw (0,0) rectangle (2,1);
	\fill (0.4,0.4) -- (0.2,0.2) -- (0.2,0.8) -- (0.4,0.6)
	-- (1.6,0.6) -- (1.8,0.8) -- (1.8,0.2) -- (1.6,0.4) -- cycle;
}

% direct wrapper (no factory involved)
\NewDocumentCommand{\Domineering}{ O{.35cm} m }{%
	\GridGame[#1]{DomTok}{#2}%
}


% \Xmas[<unit>]{<string>} calls \UseXmas for each character.
\ExplSyntaxOn
\NewDocumentCommand{\Xmas}{ O{.35cm} m }{%
	\group_begin:
	\cs_set:Npn \cgt@xmasunit {#1}
	% normalize: strip spaces and NBSPs
	\tl_set:Nn \l_tmpa_tl {#2}
	\tl_remove_all:Nn \l_tmpa_tl { \c_space_tl }
	\tl_remove_all:Nn \l_tmpa_tl { ~ }
	\tl_remove_all:Nn \l_tmpa_tl { ^^a0 }
	% walk each character
	\tl_map_inline:Nn \l_tmpa_tl
	{
		% uppercase this single character
		\tl_set:Nx \l_tmpb_tl { \tl_upper_case:n {##1} }
		% OPTIONAL first-char remap R->W, B->T:
		% comment out these two lines if you don't want the remap
		% \str_if_eq:VnTF \l_tmpb_tl { R } { \tl_set:Nn \l_tmpb_tl { W } }{
		% \str_if_eq:VnT \l_tmpb_tl { B } { \tl_set:Nn \l_tmpb_tl { T } }
		% }
		% call \UseXmas{LETTER}; if \Xmas<LETTER> isn't defined, \UseXmas does nothing
		\exp_args:NV \UseXmas \l_tmpb_tl
	}
	\group_end:
}

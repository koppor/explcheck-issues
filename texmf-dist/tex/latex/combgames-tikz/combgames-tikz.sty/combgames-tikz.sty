%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% PUSH AND SHOVE AND ALL-SMALL VERSIONS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% ===== Push / Shove family =====
\newif\ifgridgamecolor % default false; set \gridgamecolortrue for colored O/X/G

% --- core shape paths (used by all variants) ---
% main blob
\newcommand{\pshgBlobPath}{%
	plot[smooth] coordinates {
		(.55,.10) (.42,.20) (.33,.27) (.32,.30) (.33,.40) (.33,.50)
		(.33,.56) (.34,.60) (.355,.625) (.39,.625)
		(.39,.625) (.39,.625) (.39,.625) (.41,.80) (.425,.83) (.45,.83)
		(.465,.80) (.50,.40) (.525,.30) (.625,.22)
	}%
}
% highlight curve
\newcommand{\pshgHiPath}{%
	plot[smooth] coordinates { (.355,.625) (.39,.625) (.40,.60) (.40,.415) (.40,.425) }%
}

% right-edge ticks: Push (P)
\newcommand{\pshgTicksP}{%
	\draw (.60,.40)--(.70,.40);
	\draw (.60,.70)--(.70,.70);
}
% right-edge ticks: Shove (S)
\newcommand{\pshgTicksS}{%
	\draw (.70,.30)--(.85,.30);
	\draw (.65,.45)--(.90,.45);
	\draw (.65,.60)--(.80,.60);
	\draw (.65,.75)--(.90,.75);
}

% --- drawing helpers for O/X/G under current color mode ---
\newcommand{\pshgDrawO}{%
	\ifgridgamecolor
	\filldraw[fill=red] \pshgBlobPath;
	\else
	\draw \pshgBlobPath;
	\fi
	% highlight (black)
	\draw \pshgHiPath;
}
\newcommand{\pshgDrawX}{%
	\ifgridgamecolor
	\filldraw[fill=blue] \pshgBlobPath;
	\else
	\filldraw \pshgBlobPath; % default black fill+stroke
	\fi
	% white highlight on X
	\draw[white] \pshgHiPath;
}
\newcommand{\pshgDrawG}{%
	\ifgridgamecolor
	\filldraw[fill=green] \pshgBlobPath;
	\else
	\filldraw[fill=lightgray] \pshgBlobPath;
	\fi
	% highlight (black)
	\draw \pshgHiPath;
}

% --- one piece: place, optionally scale (AllSmall), and choose ticks by game ---
% #1 = ticks macro (\pshgTicksP or \pshgTicksS)
% #2 = body macro  (\pshgDrawO / \pshgDrawX / \pshgDrawG)
% #3 = scale factor (1 or 0.6)
\newcommand{\pshgPiece}[3]{%
	\begin{scope}[shift={(.5,.5)}, scale=#3, shift={(-.5,-.5)}] % scale about cell center
		#2 % draw blob + highlight
		#1 % draw right-edge tick marks
	\end{scope}%
}

% -------------------- Push tokens (map: PUSH) --------------------
\gridtoken{PUSH}{.}{\draw (0,0) -- (1,0) -- (1,1) -- (0,1);} % empty
\gridtoken{PUSH}{O}{\draw (0,0) -- (1,0) -- (1,1) -- (0,1);
	\pshgPiece{\pshgTicksP}{\pshgDrawO}{1}}
\gridtoken{PUSH}{o}{\draw (0,0) -- (1,0) -- (1,1) -- (0,1);
	\pshgPiece{\pshgTicksP}{\pshgDrawO}{1}}
\gridtoken{PUSH}{X}{\draw (0,0) -- (1,0) -- (1,1) -- (0,1);
	\pshgPiece{\pshgTicksP}{\pshgDrawX}{1}}
\gridtoken{PUSH}{x}{\draw (0,0) -- (1,0) -- (1,1) -- (0,1);
	\pshgPiece{\pshgTicksP}{\pshgDrawX}{1}}
\gridtoken{PUSH}{L}{\draw (0,0) -- (1,0) -- (1,1) -- (0,1);
	\pshgPiece{\pshgTicksP}{\pshgDrawX}{1}} % alias
\gridtoken{PUSH}{R}{\draw (0,0) -- (1,0) -- (1,1) -- (0,1);
	\pshgPiece{\pshgTicksP}{\pshgDrawO}{1}} % alias
\gridtoken{PUSH}{G}{\draw (0,0) -- (1,0) -- (1,1) -- (0,1);
	\pshgPiece{\pshgTicksP}{\pshgDrawG}{1}}
\gridtoken{PUSH}{#}{}

\NewDocumentCommand{\Push}{ O{.5cm} m }{%
	\GridGame[#1]{PUSH}{#2}%
}

% -------------------- Shove tokens (map: SHOV) --------------------

%% 8. Installation
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% \@doclearpage: kernel code (2026-11-01) with two changes in the
%% "first column" branch: our bookkeeping of placed spans is reset when
%% they go back to \@deferlist, and \@colroom is brought back in sync with
%% \@colht afterwards.  Walking through the remaining columns
%% (\vbox{}\clearpage) already works for any number of columns.
\cs_new_protected:Npn \__ncol_doclearpage:
  {
    \ifvoid \footins
      \ifvbox \@kludgeins
        { \setbox \@tempboxa \box \@kludgeins }
      \fi
      \setbox \@tempboxa \vsplit \@cclv to \z@ \unvbox \@tempboxa
      \setbox \@tempboxa \box \@cclv
      \xdef \@deferlist { \@toplist \@botlist \@deferlist }
      \global \let \@toplist \@empty
      \global \let \@botlist \@empty
      \global \@colroom \@colht
      \ifx \@currlist \@empty
      \else
        \@latex@error { Float(s)~lost } \@ehb
        \global \let \@currlist \@empty
      \fi
      \@makefcolumn \@deferlist
      \@whilesw \if@fcolmade \fi { \@opcol \@makefcolumn \@deferlist }
      \if@twocolumn
        \if@firstcolumn
          \__ncol_widen_partial_spans:
          \xdef \@deferlist { \@dbltoplist \@deferlist }
          \global \let \@dbltoplist \@empty
          \__ncol_page_reset:
          \global \@colht \textheight
          \group_begin:
            \@dblfloatplacement
            \@makefcolumn \@deferlist
            \@whilesw \if@fcolmade \fi
              {
                \@outputpage
                \__ncol_page_reset:
                \@makefcolumn \@deferlist
              }
          \group_end:
          \__ncol_set_colht:
          \global \@colroom \@colht
        \else
          \vbox { } \clearpage
        \fi
      \fi
      \ifx \@deferlist \@empty \else \clearpage \fi
    \else
      \setbox \@cclv \vbox { \box \@cclv \vfil }
      \@makecol \@opcol
      \clearpage
    \fi
  }

%% \@addtocurcol: spanning floats (depth 1sp) never go through the kernel
%% code (nor through stfloats' version of it); they are deferred to the
%% start of a page, where \@addtodblcol allocates them.
\cs_new_protected:Npn \__ncol_addtocurcol:
  {
    \bool_lazy_and:nnTF
      { \legacy_if_p:n { @twocolumn } }
      { \dim_compare_p:nNn { \box_dp:N \@currbox } = { 1sp } }
      { \__ncol_span_arrived: }
      { \__ncol_orig_addtocurcol: }
  }
%% With same-page-spans it still goes on the page being built in two
%% cases: at the top if all the columns it covers are still to come, at
%% the bottom if it starts in the current column (and there is room
%% left) or later.
\cs_new_protected:Npn \__ncol_span_arrived:
  {
    \@insertfalse
    \@setfloattypecounts
    \bool_if:NT \g__ncol_samepage_bool
      {
        \@bitor \@currtype \@deferlist
        \if@test
        \else
          \__ncol_get_attr:
          \int_set:Nn \l__ncol_mintop_int { \g__ncol_cur_int + 1 }
          \int_set:Nn \l__ncol_minbot_int { \g__ncol_cur_int }
          \int_compare:nNnT { \l__ncol_a_int } = { \g__ncol_cur_int }
            {
              %% the current column is covered: it must have room left
              \dim_compare:nNnF { \@colroom - \@pageht }
                > { \box_ht:N \@currbox + \dbltextfloatsep + \dblfloatsep + \baselineskip }
                { \int_set:Nn \l__ncol_minbot_int { \g__ncol_cur_int + 1 } }
            }
          \dim_set:Nn \l__ncol_tmpb_dim
            { \dim_use:c { g__ncol_bot_ \int_use:N \g__ncol_cur_int _dim } }
          \__ncol_place:
          \if@insert
            %% the tail of the current column may just have been reserved
            \dim_set:Nn \l__ncol_tmpb_dim
              {
                \dim_use:c { g__ncol_bot_ \int_use:N \g__ncol_cur_int _dim }
                - \l__ncol_tmpb_dim
              }
            \global \advance \@colht  - \l__ncol_tmpb_dim
            \global \advance \@colroom - \l__ncol_tmpb_dim
          \fi
        \fi
      }
    \if@insert
    \else
      \@resethfps
      \@cons \@deferlist \@currbox
    \fi
  }

%% Before a flush, partial spans become full-width boxes (aligned to their
%% side) so that the kernel's float-page code can take them.
\cs_new_protected:Npn \__ncol_widen_partial_spans:
  {
    \group_begin:
      \cs_set_protected:Npn \@elt ##1
        {
          \cs_set_nopar:Npn \@currbox {##1}
          \dim_compare:nNnT { \box_dp:N ##1 } = { 1sp }
            {
              \__ncol_get_attr:
              \int_compare:nNnT { \l__ncol_k_int } < { \g__ncol_n_int }
                {
                  \global \setbox ##1 \vbox
                    {
                      \hb@xt@ \textwidth
                        {
                          \int_compare:nNnT { \l__ncol_a_int } > { 1 } { \hfil }
                          \box ##1
                          \int_compare:nNnT { \l__ncol_a_int } = { 1 } { \hfil }
                        }
                    }
                  \global \dp ##1 1sp
                  \__ncol_set_attr:nn { \g__ncol_n_int } { l }
                }
            }
        }
      \@dbltoplist
      \@deferlist
    \group_end:
  }

%% \@addmarginpar for more than two columns (kernel code otherwise): the
%% note goes to the nearer margin, shifted across the columns in between,
%% and notes from different columns sharing a margin do not overlap.
\cs_new_protected:Npn \__ncol_addmarginpar:
  {
    \bool_lazy_and:nnTF
      { \legacy_if_p:n { @twocolumn } }
      { \int_compare_p:nNn { \g__ncol_n_int } > { 2 } }
      { \__ncol_addmarginpar_n: }
      { \__ncol_orig_addmarginpar: }
  }
\cs_new_protected:Npn \__ncol_addmarginpar_n:
  {
    \@next \@marbox \@currlist
      { \@cons \@freelist \@marbox \@cons \@freelist \@currbox } \@latexbug
    \@tempcnta \@ne
    \int_compare:nNnF { 2 * \g__ncol_cur_int } > { \g__ncol_n_int }
      { \@tempcnta \m@ne }
    \ifnum \@tempcnta < \z@
      \global \setbox \@marbox \box \@currbox
    \fi
    %% lowest point used so far on this side, in this column's coordinates
    \dim_set:Nn \l__ncol_tmpa_dim
      { \dim_use:c { g__ncol_top_ \int_use:N \g__ncol_cur_int _dim } }
    \dim_gset:Nn \@mparbottom
      {
        \ifnum \@tempcnta < \z@ \g__ncol_mpar_left_dim \else \g__ncol_mpar_right_dim \fi
        - \l__ncol_tmpa_dim
      }
    \@tempdima \@mparbottom
    \advance \@tempdima - \@pageht
    \advance \@tempdima \ht \@marbox
    \ifdim \@tempdima > \z@
      \@latex@warning@no@line { Marginpar~on~page~\thepage \space moved }
    \else
      \@tempdima \z@
    \fi
    \global \@mparbottom \@pageht
    \global \advance \@mparbottom \@tempdima
    \global \advance \@mparbottom \dp \@marbox
    \global \advance \@mparbottom \marginparpush
    \ifnum \@tempcnta < \z@
      \dim_gset:Nn \g__ncol_mpar_left_dim { \@mparbottom + \l__ncol_tmpa_dim }
    \else
      \dim_gset:Nn \g__ncol_mpar_right_dim { \@mparbottom + \l__ncol_tmpa_dim }
    \fi
    \advance \@tempdima - \ht \@marbox
    \global \setbox \@marbox \vbox { \vskip \@tempdima \box \@marbox }
    \global \ht \@marbox \z@
    \global \dp \@marbox \z@
    \kern - \@pagedp
    \nointerlineskip
    \hb@xt@ \columnwidth
      {
        \ifnum \@tempcnta > \z@
          \hskip \columnwidth
          \hskip \dim_eval:n
            { ( \columnwidth + \columnsep ) * \int_eval:n { \g__ncol_n_int - \g__ncol_cur_int } }
          \hskip \marginparsep
        \else
          \hskip - \marginparsep
          \hskip - \marginparwidth
          \hskip - \dim_eval:n
            { ( \columnwidth + \columnsep ) * \int_eval:n { \g__ncol_cur_int - 1 } }
        \fi
        \box \@marbox \hss
      }
    \nointerlineskip
    \hbox { \vrule \@height \z@ \@width \z@ \@depth \@pagedp }
  }

\cs_new_protected:Npn \__ncol_onecolumn:
  {
    \__ncol_orig_onecolumn:
    \int_gset:Nn \g__ncol_n_int { 1 }
    \int_gset:Nn \g__ncol_cur_int { 1 }

    \cs_set_eq:NN \@addtodblcol \__ncol_addtodblcol:
    \cs_set_eq:NN \@dblfloat \__ncol_dblfloat:n
    \cs_set_eq:NN \@topnewpage \__ncol_topnewpage:w
    \cs_set_eq:NN \@doclearpage \__ncol_doclearpage:
    \cs_set_eq:NN \__ncol_orig_addtocurcol: \@addtocurcol

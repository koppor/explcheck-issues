    \cs_set_eq:NN \__ncol_orig_startcolumn: \@startcolumn
    \cs_set_eq:NN \@startcolumn \__ncol_startcolumn:
    \exp_args:NNe \tex_global:D \output
      { \exp_not:N \__ncol_output_begin: \exp_not:V \output }
    \cs_set_eq:NN \__ncol_orig_onecolumn: \onecolumn
    \cs_set_eq:NN \onecolumn \__ncol_onecolumn:
    \clist_map_inline:nn
      { cleardoublepage , pltx@cleartorightpage , pltx@cleartoleftpage ,
        pltx@cleartooddpage , pltx@cleartoevenpage }
      {
        \cs_if_exist:cT {##1}
          { \AddToHook { cmd / ##1 / after } { \__ncol_fill_page: } }
      }
  }
\AddToHook { begindocument / before } { \__ncol_install: }

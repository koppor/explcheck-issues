%
% Tagging
% Nothing from here on is read by a document not using \DocumentMetadata.
% More details and observations are in the file TAGGING_MEMO.md of the
% repository.
\@ifundefined{tag_mc_add_missing_to_stream:Nn}{\endinput}{}
% With pdfLaTeX a paragraph continuing on the next page must have its
% marked content closed at the end of the page and opened again on the
% next one.  tagpdf does this in the output routine, but it can not see
% inside the boxes which framed has split by itself.  We apply the same
% tagpdf command to each such piece, and to the last one.  With LuaLaTeX
% this command does nothing (and nothing is needed).
%
% \tag_mc_new_stream:n of tagpdf 1.0i does not create the variable which
% \tag_mc_add_missing_to_stream:Nn needs, hence the second line; see
% https://github.com/latex3/tagpdf/issues/152
% Nothing will have to be changed here once this is fixed in tagpdf.
\ExplSyntaxOn
\tag_mc_new_stream:n { colorframed }
\seq_if_exist:cF { g__tag_mc_colorframed_marks_seq }
  { \seq_new:c { g__tag_mc_colorframed_marks_seq } }
\cs_new_protected:Npn \colorframed@fixmc #1
  { \tag_mc_add_missing_to_stream:Nn #1 { colorframed } }
\ExplSyntaxOff
% This is \fb@put@frame of framed.sty 0.96 without its debugging lines.
% The only changes are the added \colorframed@fixmc\tw@ and
% \colorframed@conttrue (see below about the latter).
\def\fb@put@frame#1#2{\relax
 \ifdim\pagegoal=\maxdimen \pagegoal\vsize \fi
 \ifinner
   \fb@putboxa#1%
   \fb@afterframe
 \else
  \dimen@\pagegoal \advance\dimen@-\pagetotal
  \ifdim\dimen@<2\baselineskip
    \eject \fb@adjheight \fb@put@frame#1#2%
  \else
     \fb@sizeofframe#1%
     \begingroup
     \advance\dimen@.8\pageshrink
     \advance\dimen@-\fb@frh\relax
     \expandafter\endgroup
     \ifdim\dimen@>\ht\@tempboxa
        \fb@putboxa#1%
        \fb@afterframe
     \else
        \fb@sizeofframe#2%
        \setbox\@tempboxa\vbox{%
           \vskip \fb@frh \@plus\pagestretch \@minus.8\pageshrink
           \kern137sp\kern-137sp\penalty-30
           \unvbox\@tempboxa}%
        \edef\fb@resto@set{\boxmaxdepth\the\boxmaxdepth
                           \splittopskip\the\splittopskip}%
        \boxmaxdepth\z@ \splittopskip\z@
        \setbox\tw@\vsplit\@tempboxa to\dimen@
        \setbox\tw@\vbox{\unvbox\tw@}%
        \begingroup
        \advance\dimen@\topskip
        \expandafter\endgroup
        \ifdim\dimen@>\pagegoal
          \dimen@ii\pagegoal
          \advance\dimen@ii -\topskip
          \advance\dimen@ii \FrameHeightAdjust\relax
        \else
          \advance\dimen@.8\pageshrink
          \ifdim\ht\tw@>\dimen@
            \dimen@ii\dimen@
          \else
            \dimen@ii\ht\tw@
          \fi
        \fi
        \advance\dimen@ii -\fb@frh
        \setbox\tw@\vbox to\dimen@ii \bgroup
        \vskip -\fb@frh \@plus-\pagestretch \@minus-.8\pageshrink
        \unvbox\tw@ \unpenalty\unpenalty
        \ifdim\lastkern=-137sp
           \egroup \fb@resto@set \eject
           \fb@adjheight
           \fb@put@frame#1#2%
        \else
           \egroup \fb@resto@set
           \ifvoid\@tempboxa
              \setbox\@tempboxa\box\tw@
              \fb@putboxa#1%
              \fb@afterframe
           \else
              \ifdim\wd\tw@>\z@
                \wd\tw@\wd\@tempboxa
                \colorframed@fixmc\tw@%<<<< ADDED
                \centerline{#2{\box\tw@}}%
              \else
                \box\tw@
              \fi
              \hrule \@height\z@ \@width\hsize
              \eject
              \fb@adjheight
              \colorframed@conttrue%<<<< ADDED
              \fb@put@frame\LastFrameCommand\MidFrameCommand
  \fi\fi\fi\fi\fi
}
% This is \fb@putboxa of framed.sty 0.96 without its debugging lines.
% The only change is the added \colorframed@fixmc\@tempboxa.
\def\fb@putboxa#1{%
  \ifvoid\@tempboxa
    \PackageWarning{framed}{Boxa is void -- discard it. }%
  \else
    \colorframed@fixmc\@tempboxa%<<<< ADDED
    \centerline{#1{\box\@tempboxa}}%
  \fi
}
% framed executes the frame commands on a dummy box to measure the frame.
% Nothing of this must be tagged (a title may contain mathematics, which
% would create a structure).
% This is \fb@sizeofframe of framed.sty 0.96 without its debugging lines.
% The only change is the added \SuspendTagging.
\def\fb@sizeofframe#1{\begingroup
 \SuspendTagging{colorframed}%<<<< ADDED
 \setbox\z@\vbox{\vskip-5in \hbox{\hskip-5in
   #1{\hbox{\vrule \@height 4.7in \@depth.3in \@width 5in}}}%
   \vskip\z@skip}%
 \global\fb@frw\wd\z@ \global\fb@frh\ht\z@
 \endgroup
}
% Titles (argument #2 of \TitleBarFrame and \colorframedTitleBarFrame).
% A title is typeset by a frame command, hence after the contents of the
% frame.  To get it before them in the structure tree, an empty structure
% is created at the start of \MakeFramed, and the structure of the title,
% when it is typeset, is declared as a child of that one.  The title itself
% may contain what creates structures (mathematics for example).
% Whether a frame has a title is only known from the previous compilation
% (via a label): in a first compilation the title is tagged after the
% contents of the frame and a warning asks for another compilation.
% Only the title of the first piece of a frame is handled this way (the
% one from \FrameCommand or \FirstFrameCommand).  Titles of the following
% pieces (\MidFrameCommand, \LastFrameCommand) and all continuation labels
% (argument #1) are artifacts.  \colorframed@artifact is also used for the
% rules, see below.
%
% \colorframed@frameno      numbers the frames (all of them)
% \colorframed@titlelabel   the label of the current frame; only its
%                           existence in the previous compilation is used,
%                           not the value recorded with it
% \colorframed@titleparent  number of the empty structure created at the
%                           start of the current frame, empty if there is
%                           none
% \ifcolorframed@cont       true from the second piece of a frame on; it
%                           is set in \fb@put@frame, inside the group which
%                           \endMakeFramed opens around it
\newcount\colorframed@frameno
\newif\ifcolorframed@cont
\def\colorframed@titlelabel{colorframed-title-0}% if not inside \MakeFramed
\let\colorframed@titleparent\@empty
\def\colorframed@rerunwarning{%
  \AtEndDocument{\PackageWarningNoLine{colorframed}
    {Titles of frames are not at their place in the structure\MessageBreak
     tree. Rerun to get them right}}%
  \global\let\colorframed@rerunwarning\relax
}
\ExplSyntaxOn
\cs_new_protected:Npn \colorframed@titlestruct
  {
    \global\advance\colorframed@frameno\@ne
    \edef\colorframed@titlelabel{colorframed-title-\the\colorframed@frameno}
    \let\colorframed@titleparent\@empty
    \tag_if_active:T
      {
        \exp_args:No \property_if_recorded:nT { \colorframed@titlelabel }
          {
            \tag_struct_begin:n { tag=Part }
            \edef\colorframed@titleparent { \tag_get:n { struct_num } }
            \tag_struct_end:
          }
      }
  }
\cs_set_protected:Npn \colorframed@tagtitle #1
  {
    \tag_if_active:TF
      {
        \ifcolorframed@cont
          \colorframed@artifact {#1}
        \else
          \exp_args:No \property_record:nn { \colorframed@titlelabel } { abspage }
          \tl_if_empty:NTF \colorframed@titleparent
            {
              \colorframed@rerunwarning
              \tag_struct_begin:n { tag=P }
            }
            {
              \exp_args:Ne \tag_struct_begin:n
                { tag=P, parent=\colorframed@titleparent }
            }
          \tag_mc_begin:n { tag=P }
          #1
          \tag_mc_end:
          \tag_struct_end:
        \fi
      }
      {#1}
  }
\cs_set_protected:Npn \colorframed@artifact #1
  {
    \tag_if_active:TF
      {
        \tag_mc_if_in:TF
          {#1}
          {
            \tag_mc_begin:n { artifact }
            \group_begin:
            \SuspendTagging { colorframed }
            #1
            \group_end:
            \tag_mc_end:
          }
      }
      {#1}
  }
\ExplSyntaxOff
% \MakeFramed (already redefined at the top of this file) gets a prefix.
% The \par comes first so that the structure of a paragraph in progress is
% closed before the empty structure is created.
\let\colorframed@MakeFramed\MakeFramed
\def\MakeFramed{\par\colorframed@titlestruct\colorframed@MakeFramed}
% The title of \colorframed@TF@Title is a paragraph in a \vbox: it must not
% get a paragraph structure there.
\def\colorframed@notagpara{\tagpdfparaOff}
% This is \TF@Title of framed.sty 0.96, with \colorframed@tagtitle and
% \colorframed@artifact added.
\renewcommand\TF@Title[1]{%
  \ifx\delimiter#1\delimiter\else
  \kern-0.04pt\relax
  \begingroup
  \setbox\@tempboxa\vbox{%
   \kern0.8ex
   \hbox{\kern\fboxsep
         \textcolor{TFTitleColor}{\colorframed@tagtitle{#1}}\vphantom{Tj)}}%
   \kern0.8ex}%
  \colorframed@artifact{\hrule\@height\ht\@tempboxa}%
  \kern-\ht\@tempboxa
  \box\@tempboxa
  \endgroup
  \nointerlineskip
  \kern-0.04pt\relax
  \fi
}
% Rules and coloured backgrounds.
% With pdfLaTeX they must be marked as artifacts (LuaLaTeX does it by
% itself).  In the macros above this is done by \colorframed@artifact,
% which does nothing if a marked content is already open, as is the case
% if such a macro is used inside a paragraph.
% The leftbar environment of framed.sty needs it too.
\renewenvironment{leftbar}{%
  \def\FrameCommand{\colorframed@artifact{\vrule width 3pt}\hspace{10pt}}%
  \MakeFramed {\advance\hsize-\width \FrameRestore}}%
 {\endMakeFramed}
\endinput

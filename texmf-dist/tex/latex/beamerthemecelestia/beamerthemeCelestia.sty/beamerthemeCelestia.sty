    \DeclareDocumentEnvironment{#1}{d<>O{}}{%
      \IfValueT{##1}{\begin{actionenv}<##1>}%
      \begin{block}{\csname celestia@name@#2\endcsname\celestia@native@addition{##2}}}{%
      \end{block}\IfValueT{##1}{\end{actionenv}}}}
  \@for\celestia@env@loop:=property,properties,proposition,method,remark,remarks,activity,activities,application,applications,summary\do{%
    \expandafter\let\csname\celestia@env@loop\endcsname\relax
    \expandafter\let\csname end\celestia@env@loop\endcsname\relax
    \expandafter\celestia@native@env\expandafter{\celestia@env@loop}}

  \AtBeginDocument{%
    \@ifundefined{exercise}{\celestia@native@env{exercise}}{}%
    \@ifundefined{exercises}{\celestia@native@env{exercises}}{}%
    \@for\celestia@env@loop:=theorem,lemma,proposition,property,properties,corollary,definition,definitions,example,examples,remark,remarks,method,activity,activities,application,applications,summary,exercise,exercises\do{%
      \@ifundefined{\celestia@env@loop}{}{\@ifundefined{\celestia@env@loop*}{%
        \expandafter\let\csname\celestia@env@loop*\expandafter\endcsname\csname\celestia@env@loop\endcsname
        \expandafter\let\csname end\celestia@env@loop*\expandafter\endcsname\csname end\celestia@env@loop\endcsname}{}}}%
  }
\else

\newcommand{\celestia@standout@colors}{%
  \setbeamercolor{background canvas}{bg=main}%
  \setbeamercolor{normal text}{fg=background}%
  \setbeamercolor{structure}{fg=background}%
  \colorlet{emphasis}{background}%
  \colorlet{decoration}{background}%
  \def\celestia@decoration{background}%
  \usebeamercolor[fg]{normal text}%
}
\define@key{beamerframe}{c}[true]{%
  \beamer@frametopskip=0pt plus 1fill\relax
  \beamer@framebottomskip=0pt plus 2fill\relax
  \beamer@frametopskipautobreak=0pt plus .4\paperheight\relax
  \beamer@framebottomskipautobreak=0pt plus .6\paperheight\relax
}
\define@key{beamerframe}{standout}[true]{%
  \celestia@framegroup
  \celestia@standouttrue
  \setkeys{beamerframe}{c}%
  \beamer@framebottomskip=0pt plus 1.5fill\relax
  \setkeys{beamerframe}{noframenumbering}%
  \celestia@standout@colors
  \setbeamertemplate{frametitle}{}
  \setbeamertemplate{framesubtitle}{}
  \setbeamertemplate{footline}{}%
  \ifcelestia@motif
    \setbeamertemplate{background}{%
      \begin{tikzpicture}[remember picture, overlay]
        \coordinate (celestia disc) at ([xshift=0.01\paperwidth, yshift=-0.025\paperheight]current page.south east);
        \fill[main!96.5!background] (celestia disc) circle (0.43\paperheight);
        \fill[main!93!background] (celestia disc) circle (0.365\paperheight);
        \fill[main!90!background] (celestia disc) circle (0.30\paperheight);
      \end{tikzpicture}}%
  \fi
  \hypersetup{urlcolor=.}%
  \centering
  \usebeamerfont{frametitle}\huge
  \celestia@endframekey
}

% --- Title Page ---
\def\celestia@subject{}
\renewcommand{\subject}[1]{%
  \def\celestia@subject{#1}%
  \hypersetup{pdfsubject={#1}}%
}
\newcommand{\insertsubject}{\celestia@subject}
\newcommand{\celestia@caps}[1]{%
  \begingroup
  \iftutex
    \addfontfeatures{LetterSpace=8}%
  \else
    \ifdefined\letterspacefont
      \letterspacefont\celestia@lsfont\font 80\relax\celestia@lsfont
    \fi
  \fi
  \MakeUppercase{#1}%
  \endgroup
}

\setbeamertemplate{title page}{%
  \IfSubStr{\celestia@titlepages@new}{,\the\c@page,}{}{%
    \xdef\celestia@titlepages@new{\celestia@titlepages@new\the\c@page,}}%
  \celestia@motif{cover}%
  \vskip 0pt plus 1filll
  \begingroup
  \leftskip=\dimexpr\celestia@margin-1em\relax
  \rightskip=\dimexpr\celestia@margin-1em\relax

  \ifx\celestia@titlebackground\@empty\else
    \begin{tikzpicture}[remember picture, overlay]
      \node[opacity=0.15] at (current page.center) {\includegraphics[width=\paperwidth,height=\paperheight]{\celestia@titlebackground}};
    \end{tikzpicture}
  \fi
  \ifx\inserttitlegraphic\@empty\else
    \ifdefstring{\celestia@titlealign}{center}{}{%
      \begin{tikzpicture}[remember picture, overlay]
        \node[anchor=north east, inner sep=0pt] at ([xshift=-\beamer@rightmargin, yshift=-2em]current page.north east) {\inserttitlegraphic};
      \end{tikzpicture}
    }
  \fi

  \def\celestia@ta@center{center}
  \def\celestia@ta@right{right}

  \ifx\celestia@titlealign\celestia@ta@center
    \centering
    \leftskip=0pt plus 1fil
    \rightskip=0pt plus 1fil
  \else\ifx\celestia@titlealign\celestia@ta@right
      \raggedleft
      \leftskip=0pt plus 1fil
    \else
      \rightskip=0pt plus 1fil
    \fi\fi

  \ifx\inserttitlegraphic\@empty\else
    \ifdefstring{\celestia@titlealign}{center}{%
      {\centering\inserttitlegraphic\par}
      \vspace{\dimexpr1.2\baselineskip\relax}
    }{}
  \fi
  \ifx\celestia@subject\@empty\else
    {\usebeamercolor[fg]{subject}\usebeamerfont{subject}\celestia@caps{\celestia@subject}\par}
    \vspace{\dimexpr0.9\baselineskip\relax}
  \fi

  \begin{minipage}{0.75\textwidth}
    \ifx\celestia@titlealign\celestia@ta@center
      \centering
    \else\ifx\celestia@titlealign\celestia@ta@right
      \raggedleft
    \else
      \raggedright
    \fi\fi
    \hyphenpenalty=10000 \exhyphenpenalty=10000 \relax

    {\usebeamercolor[fg]{title}\usebeamerfont{title}\selectfont\inserttitle\par}

    \ifx\insertsubtitle\@empty\else
      \vspace{\dimexpr0.6\baselineskip\relax}
      {\usebeamercolor[fg]{subtitle}\usebeamerfont{subtitle}\insertsubtitle\par}
    \fi
  \end{minipage}

  \setbox\z@\hbox{\insertauthor\insertinstitute\insertdate}%
  \ifdim\wd\z@>\z@
    \par\vspace{\dimexpr1.2\baselineskip\relax}
    \celestia@rule
    \par\vspace{\dimexpr1.2\baselineskip\relax}
  \fi

  {\usebeamercolor[fg]{author}\usebeamerfont{author}\insertauthor\par}
  \ifx\insertinstitute\@empty\else
    \vspace{\dimexpr0.35\baselineskip\relax}
    {\usebeamercolor[fg]{institute}\usebeamerfont{institute}\insertinstitute\par}
  \fi
  \ifx\insertdate\@empty\else
    \vspace{\dimexpr0.6\baselineskip\relax}
    {\usebeamercolor[fg]{date}\usebeamerfont{date}\insertdate\par}
  \fi

  \endgroup
  \vskip 0pt plus 2filll
}


      \ifcelestia@motif
        \fill[emphasistint] (current page.south west) rectangle (current page.north east);
        \fill[emphasistint!66!background] (celestia disc) circle (0.43\paperheight);
        \fill[emphasistint!33!background] (celestia disc) circle (0.365\paperheight);
        \fill[background] (celestia disc) circle (0.30\paperheight);
      \else

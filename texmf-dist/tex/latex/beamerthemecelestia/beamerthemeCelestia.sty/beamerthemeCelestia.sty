    \ifdefstring{\celestia@language}{french}{%
      \uselanguage{French}\languagepath{French}%
    }{}%
  }%
  \newcommand{\celestia@native@addition}[1]{%
    \if\relax\detokenize{#1}\relax\else
      \IfSubStr{#1}{title=}{\celestia@native@keys{#1}}{%
        \IfSubStr{#1}{label=}{\celestia@native@keys{#1}}{~(#1)}}%
    \fi}
  \setbeamertemplate{proof begin}{\begin{block}{\let\@addpunct\@gobble\insertproofname}}
  \setbeamertemplate{theorem begin}{%
    \normalfont
    \begin{\inserttheoremblockenv}{%
      \inserttheoremname
      \expandafter\celestia@native@addition\expandafter{\inserttheoremaddition}}%
  }
  \newcommand{\celestia@native@env}[1]{%
    \celestia@native@defenv{#1}{#1}\celestia@native@defenv{#1*}{#1}}

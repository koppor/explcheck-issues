\newcommand{\celestia@runpalette}[1]{%
  \ifcsname celestia@palette@\detokenize{#1}\endcsname
    \def\celestia@palette{#1}%
    \csname celestia@palette@#1\endcsname
    \celestia@set@colorstrue
  \else
    \celestia@set@unknown{palette}{#1}%
  \fi
}
\newcommand{\celestia@runscheme}[1]{%
  \ifcsname celestia@scheme@\detokenize{#1}\endcsname
    \let\celestia@savedblock\celestia@block
    \def\celestia@emphasis{main}%
    \def\celestia@decoration{\celestia@emphasis}%
    \celestia@user@decoration@setfalse
    \def\celestia@frametitlesize{normalsize}%
    \def\celestia@titlealign{left}%
    \def\celestia@blockfill{auto}%
    \def\celestia@blockcorners{auto}%
    \@for\celestia@fam@loop:=\celestia@families\do{%
      \expandafter\def\csname celestia@\celestia@fam@loop block\endcsname{auto}}%
    \ifcelestia@allserif
      \def\celestia@headstyle{rmfamily}%
    \else
      \def\celestia@headstyle{sffamily}%
    \fi
    \csname celestia@scheme@#1\endcsname
    \IfSubStr{\celestia@block}{native}{%
      \ifcelestia@usenativeblocks\else
        \let\celestia@block\celestia@savedblock
        \PackageWarning{celestia}{Style #1 uses native blocks, which can only be\MessageBreak
          selected in \string\usetheme: the block style is kept}%
      \fi
    }{%
      \ifcelestia@usenativeblocks\let\celestia@block\celestia@savedblock\fi
    }%
    \csname celestia@palette@\celestia@palette\endcsname
    \celestia@set@colorstrue
    \celestia@set@blocktrue
    \celestia@set@frametitletrue
  \else
    \celestia@set@unknown{style}{#1}%
  \fi
}

\newcommand{\celestia@setkey}[2]{\@namedef{celestia@run@key@#1}##1{#2}}
\newcommand{\celestia@setdefault}[2]{\@namedef{celestia@run@default@#1}{#2}}
\newcommand{\celestia@run@call}[2]{\csname celestia@run@key@#2\endcsname{#1}}
\newcommand{\celestia@pre@do}[2]{%
  \celestia@ifin{style,palette,custompalette}{#1}{\@namedef{celestia@run@#1}{#2}}{}%
}
\newcommand{\celestia@run@do}[2]{%
  \ifcsname celestia@run@key@\detokenize{#1}\endcsname
    \ifx\kv@value\relax
      \ifcsname celestia@run@default@#1\endcsname
        \expandafter\expandafter\expandafter\celestia@run@call
          \expandafter\expandafter\expandafter{\csname celestia@run@default@#1\endcsname}{#1}%
      \else
        \PackageWarning{celestia}{No value given for #1}%
      \fi
    \else
      \csname celestia@run@key@#1\endcsname{#2}%
    \fi
  \else
    \PackageWarning{celestia}{Unknown key in \string\celestiaset: \detokenize{#1}}%
  \fi
}


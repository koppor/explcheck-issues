\newcommand{\celestia@sectionpage@begin}{%
  \celestia@motif{section}%
  \vskip 0pt plus 1filll
  \begingroup
  \leftskip=\dimexpr\celestia@margin-1em\relax
  \rightskip=\dimexpr\celestia@margin-1em\relax
  \ifdefstring{\celestia@titlealign}{center}{\centering}{\rightskip=0pt plus 1fil}%
  \hypersetup{hidelinks}%
  \hyphenpenalty=10000 \exhyphenpenalty=10000 \relax
}
\newcommand{\celestia@sectionpage@head}[4]{%
  \ifcelestia@sectionnumber
    \setbox\z@\hbox{\usebeamerfont{#1}\usebeamercolor[fg]{#1}#2\quad}%
    \ifdefstring{\celestia@titlealign}{center}{}{\hangindent=\wd\z@ \hangafter=1 }%

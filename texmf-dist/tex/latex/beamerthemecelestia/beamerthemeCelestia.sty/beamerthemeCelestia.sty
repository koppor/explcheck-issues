  \fi
  \ifx\celestia@tints\@empty
    \colorlet{blockcolortint}{main!9!background}%
    \colorlet{examplecolortint}{main!9!background}%
    \colorlet{alertcolortint}{alertcolor!9!background}%
    \colorlet{maintint}{main!9!background}%
    \colorlet{accenttint}{main!9!background}%
  \else
    \expandafter\celestia@define@tints\celestia@tints
  \fi
  \ifx\celestia@accentpair\@empty
    \colorlet{accenttext}{accent}%
    \colorlet{celestia@accenthue}{accent!9!background}%
  \else
    \expandafter\celestia@define@accent\celestia@accentpair
  \fi
  \ifx\celestia@remarkcolor\@empty
    \colorlet{remarkcolor}{main}%
  \else
    \definecolor{remarkcolor}{HTML}{\celestia@remarkcolor}%
  \fi
  \ifx\celestia@methodcolor\@empty
    \colorlet{methodcolor}{accent!70!main}%
  \else
    \definecolor{methodcolor}{HTML}{\celestia@methodcolor}%
  \fi
  \ifdefstring{\celestia@emphasis}{main}{%
    \colorlet{emphasis}{main}%
    \colorlet{emphasistint}{maintint}%
    \colorlet{decoration}{accent!80!main}%
  }{%
    \colorlet{emphasis}{accenttext}%
    \colorlet{emphasistint}{celestia@accenthue}%
    \colorlet{decoration}{main!60!background}%
  }%
  \ifcelestia@user@decoration@set
    \ifdefstring{\celestia@decoration}{main}{%
      \colorlet{decoration}{main}%
    }{%
      \colorlet{decoration}{accent}%
    }%
  \fi
  \ifcelestia@unicolor
    \colorlet{accent}{emphasis}%
    \colorlet{blockcolor}{emphasis}%
    \colorlet{examplecolor}{emphasis}%
    \colorlet{remarkcolor}{emphasis}%
    \colorlet{methodcolor}{emphasis}%
    \colorlet{decoration}{emphasis}%
    \setbeamercolor{normal text}{fg=emphasis}%
  \else
    \setbeamercolor{normal text}{fg=main}%
  \fi
  \@for\celestia@tonerole:=blockcolor,examplecolor,alertcolor,remarkcolor,methodcolor\do{%
    \expandafter\ifx\csname celestia@tones@\celestia@tonerole\endcsname\@empty
      \edef\celestia@tmp{\noexpand\celestia@fallback@tones{\celestia@tonerole}}%
    \else
      \edef\celestia@tmp{\noexpand\celestia@define@tones{\celestia@tonerole}%
        \csname celestia@tones@\celestia@tonerole\endcsname}%
    \fi
    \celestia@tmp
  }%
  \ifcelestia@unicolor
    \celestia@fallback@tones{blockcolor}%
    \celestia@fallback@tones{examplecolor}%
    \celestia@fallback@tones{remarkcolor}%
    \celestia@fallback@tones{methodcolor}%
  \fi
  \colorlet{mainveil}{remarkcolorveil}%
  \colorlet{accentveil}{methodcolorveil}%
  \colorlet{mainband}{remarkcolorband}%
  \colorlet{accentband}{methodcolorband}%
  \colorlet{footlinecolor}{main!40!background}%
  \colorlet{accentink}{accent!70!main}%
  \extractcolorspec{background}\celestia@tmp
  \expandafter\convertcolorspec\celestia@tmp{gray}\celestia@tmp
  \ifdim\celestia@tmp pt<0.5pt
    \setbeamercolor{elegant frametitle}{bg=emphasis!16!background,fg=emphasis}%
    \colorlet{celestia@barbg}{emphasis!16!background}%
    \colorlet{celestia@barfg}{emphasis}%
    \colorlet{celestia@bardot}{emphasis!45!background}%
    \def\celestia@solidband##1{##1band}%
    \def\celestia@solidtext##1{##1ink}%
  \else
    \setbeamercolor{elegant frametitle}{bg=emphasis,fg=background}%
    \colorlet{celestia@barbg}{emphasis}%
    \colorlet{celestia@barfg}{background}%
    \colorlet{celestia@bardot}{background}%
    \def\celestia@solidband##1{##1}%
    \def\celestia@solidtext##1{background}%
  \fi
}

\newcommand{\celestia@ft@subtitle}{\insertframesubtitle\vrule width\z@ depth 0.216em\relax}
\newlength{\celestia@ft@delta}
\newcommand{\celestia@ft@up}{%
  \par{\usebeamerfont{frametitle}\global\celestia@ft@delta=0.2195em}%
  \nointerlineskip\vskip-\celestia@ft@delta\leavevmode}
\newcommand{\celestia@ft@down}{%
  \ifx\insertframesubtitle\@empty
    {\usebeamerfont{frametitle}\vskip-0.216em}%
  \else
    {\usebeamerfont{framesubtitle}\vskip-0.216em}%
  \fi}

\def\celestia@ftsep#1{\ifx\celestia@frametitlepadding\@empty#1\else\celestia@frametitlepadding\fi}
\def\celestia@ftvskip#1{\ifx\celestia@frametitlebottomskip\@empty#1\else\celestia@frametitlebottomskip\fi}

\defbeamertemplate{frametitle}{clean}{%
  \setlength{\celestia@ft@left@margin}{\dimexpr\beamer@leftmargin+0.5em\relax}%
  \setlength{\celestia@ft@bary}{\celestia@ftsep{1.5em}}%
  \addtolength{\celestia@ft@bary}{-0.425em}%
  \ifx\celestia@frametitlepadding\@empty
    \setlength{\celestia@ft@barx}{\dimexpr\celestia@ft@left@margin-0.5em\relax}%
  \else
    \setlength{\celestia@ft@barx}{\dimexpr\celestia@ft@left@margin-0.5em\relax}%
    \addtolength{\celestia@ft@barx}{\celestia@frametitlepadding}%
    \divide\celestia@ft@barx by 2%
  \fi
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth,
    leftskip=\dimexpr\celestia@ft@left@margin-0.5em,
    rightskip=\dimexpr\beamer@rightmargin-\celestia@ftsep{1.5em}\relax plus 1fil,
    sep=\celestia@ftsep{1.5em}]{frametitle}
    \setbox\celestia@ft@box\vbox{%
      \hsize\dimexpr\hsize-\leftskip-\rightskip\relax
      \leftskip\z@
      \rightskip\z@ plus 1fil\relax
      {\usebeamerfont{frametitle}\color{emphasis}\celestia@ft@title}%
      \ifx\insertframesubtitle\@empty\else%
        \par{\usebeamerfont{framesubtitle}\color{main!70!background}\celestia@ft@subtitle}%
      \fi%
      \par
    }%
    \setbox\celestia@ft@boxtop\vtop{\unvcopy\celestia@ft@box}%
    \celestia@ft@up
    \rlap{\smash{\kern\dimexpr\celestia@ft@barx-\leftskip\relax
      \color{emphasis}\vrule width 0.3em
        height\dimexpr\ht\celestia@ft@boxtop+0.425em-\celestia@ft@delta\relax
        depth\dimexpr\ht\celestia@ft@box-\ht\celestia@ft@boxtop+0.5em\relax}}%
    \vtop{\unvbox\celestia@ft@box}%
    \par\celestia@ft@down
  \end{beamercolorbox}%
  \ifx\celestia@frametitlebottomskip\@empty
    \ifx\insertframesubtitle\@empty
      \vskip-1em%
    \else
      \vskip-0.5em%
    \fi
  \else
    \vskip\celestia@frametitlebottomskip%
  \fi
}

\setbeamercolor{elegant frametitle}{bg=emphasis,fg=background}

\defbeamertemplate{frametitle}{elegant}{%
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth,
    leftskip=\dimexpr\beamer@leftmargin-\celestia@ftsep{0.75em}\relax,
    rightskip=\dimexpr\beamer@rightmargin-\celestia@ftsep{0.75em}\relax plus 1fil,
    sep=\celestia@ftsep{0.75em}]{elegant frametitle}
    \celestia@ft@up
    \usebeamerfont{frametitle}\mdseries\celestia@ft@title%
    \ifx\insertframesubtitle\@empty\else%
      \par{\usebeamerfont{framesubtitle}\celestia@ft@subtitle}%
    \fi%
    \par\celestia@ft@down
  \end{beamercolorbox}%

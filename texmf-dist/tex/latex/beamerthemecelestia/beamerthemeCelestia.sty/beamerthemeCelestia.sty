\newcommand{\celestia@readlanguage}[1]{%
  \IfSubStr{,french,francais,frenchb,acadian,}{,#1,}{\def\celestia@language{french}}{\def\celestia@language{english}}%
}
\newcommand{\celestia@langfromdoc}{%
  \@ifpackageloaded{babel}{%
    \ifdefined\bbl@main@language
      \celestia@readlanguage{\bbl@main@language}%
    \else
      \celestia@readlanguage{\languagename}%
    \fi
  }{%
    \@ifpackageloaded{polyglossia}{%
      \ifdefined\mainlanguagename\celestia@readlanguage{\mainlanguagename}\fi
    }{}%
  }%
}
\newcommand{\celestia@loadbabel}{%
  \@ifpackageloaded{babel}{}{\@ifpackageloaded{polyglossia}{}{\RequirePackage[\celestia@language]{babel}}}%
}
\newif\ifcelestia@classlanguage
\def\celestia@classlanguages{}
\ifcelestia@user@language@set
  \celestia@loadbabel
\else
  \ifx\@classoptionslist\relax\else
    \@for\celestia@tmp:=\@classoptionslist\do{%
      \IfSubStr{,french,francais,frenchb,acadian,english,american,british,UKenglish,USenglish,}{,\celestia@tmp,}{%
        \celestia@classlanguagetrue\edef\celestia@classlanguages{\celestia@classlanguages,\celestia@tmp}}{}}%
  \fi
  \ifcelestia@classlanguage
    \@ifpackageloaded{babel}{}{\@ifpackageloaded{polyglossia}{}{%
      \edef\celestia@tmp{\noexpand\RequirePackage[\expandafter\@gobble\celestia@classlanguages]{babel}}\celestia@tmp}}%
  \fi
  \celestia@langfromdoc
  \AtEndPreamble{%
    \celestia@loadbabel
    \celestia@langfromdoc
    \celestia@setnames
  }
\fi


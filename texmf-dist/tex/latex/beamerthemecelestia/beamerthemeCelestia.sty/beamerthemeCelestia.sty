\def\celestia@parse@custompalette#1{%
  \celestia@parse@palette@aux#1,,,,,\relax
}

\def\celestia@parse@palette@aux#1,#2,#3,#4,#5,#6,#7\relax{%
  \def\celestia@maincolor{#1}%
  \def\celestia@accentcolor{#2}%
  \def\celestia@blockcolor{#3}%
  \def\celestia@examplecolor{#4}%
  \def\celestia@alertcolor{#5}%
  \def\celestia@backgroundcolor{#6}%
  \let\celestia@tints\@empty
  \let\celestia@bands\@empty
  \let\celestia@veils\@empty
}

\define@key{celestia}{palette}[lumiere]{%
  \def\celestia@palette{#1}
  \expandafter\ifx\csname celestia@palette@#1\endcsname\relax
    \PackageError{celestia}{Unknown palette: #1.}{See documentation.}%
  \else
    \csname celestia@palette@#1\endcsname
  \fi
}

\define@key{celestia}{custompalette}{%
  \def\celestia@custompalette@value{#1}%
  \celestia@parse@custompalette{#1}%
}
\define@key{celestia}{maincolor}{\def\celestia@user@maincolor{#1}}
\define@key{celestia}{accentcolor}{\def\celestia@user@accentcolor{#1}}
\define@key{celestia}{backgroundcolor}{\def\celestia@user@backgroundcolor{#1}}
\define@key{celestia}{blockcolor}{\def\celestia@user@blockcolor{#1}}
\define@key{celestia}{examplecolor}{\def\celestia@user@examplecolor{#1}}
\define@key{celestia}{alertcolor}{\def\celestia@user@alertcolor{#1}}


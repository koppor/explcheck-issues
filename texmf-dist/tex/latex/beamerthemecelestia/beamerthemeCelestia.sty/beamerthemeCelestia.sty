      (-3em, 0) rectangle (\paperwidth, \dimexpr\ht\@tempboxa+\dp\@tempboxa\relax);
    \node[anchor=south west, inner sep=0pt, outer sep=0pt] at (0,0) {\usebox{\@tempboxa}};
  \end{tikzpicture}}%
}


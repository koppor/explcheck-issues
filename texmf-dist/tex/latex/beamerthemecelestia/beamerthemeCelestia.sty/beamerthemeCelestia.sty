\newcommand{\celestiaset}[1]{%
  \let\celestia@saved@prefix\KV@prefix
  \celestia@set@colorsfalse
  \celestia@set@blockfalse
  \celestia@set@frametitlefalse
  \celestia@set@codefalse
  \let\celestia@run@style\relax
  \let\celestia@run@palette\relax
  \let\celestia@run@custompalette\relax
  \kv@parse{#1}{\celestia@pre@do}%
  \ifx\celestia@run@style\relax\else
    \expandafter\celestia@runscheme\expandafter{\celestia@run@style}%
  \fi
  \ifx\celestia@run@palette\relax\else
    \expandafter\celestia@runpalette\expandafter{\celestia@run@palette}%
  \fi
  \ifx\celestia@run@custompalette\relax\else
    \expandafter\celestia@parse@custompalette\expandafter{\celestia@run@custompalette}%
    \celestia@set@colorstrue
  \fi
  \kv@parse{#1}{\celestia@run@do}%
  \ifcelestia@set@colors\celestia@recolor\fi
  \ifcelestia@set@block\celestia@applyblock\fi
  \ifcelestia@set@frametitle\setbeamertemplate{frametitle}[\celestia@frametitle]\fi
  \ifcelestia@set@code\celestia@applycode\fi
  \ifcelestia@standout\celestia@standout@colors\fi
  \let\KV@prefix\celestia@saved@prefix
}
\define@key{beamerframe}{celestia}{%
  \celestia@framegroup
  \celestiaset{#1}%
  \celestia@endframekey
}

% Bibliography
\AtBeginDocument{%
  \IfPackageLoadedTF{biblatex}{%
    \defbibheading{bibliography}{%
      \ifdefstring{\celestia@language}{french}{%
        \frametitle{Références}%
      }{%
        \frametitle{References}%
      }%
    }%
  }{%
    \IfPackageLoadedTF{natbib}{%
      \setbeamertemplate{bibliography item}{\insertbiblabel}%
      \setbeamercolor{bibliography entry author}{fg=main}%
      \setbeamercolor{bibliography entry title}{fg=main}%
      \setbeamercolor{bibliography entry location}{fg=main}%
      \setbeamercolor{bibliography entry note}{fg=main}%
    }{}%
  }%
}


                        \insertshortauthor \quad \textperiodcentered \quad
                      \fi
                      \begingroup\hypersetup{hidelinks}\insertshorttitle\endgroup
                    };
                    \node[anchor=south east, inner xsep=0pt, text=main!65!background, font=\usebeamerfont{footline text}]
                    at ([xshift=-\beamer@rightmargin, yshift=1.2ex]SE) {

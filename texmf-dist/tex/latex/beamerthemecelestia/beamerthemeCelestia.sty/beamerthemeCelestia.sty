\newcommand{\celestia@motif}[1]{%
  \begin{tikzpicture}[remember picture, overlay]
    \coordinate (celestia disc) at ([xshift=0.01\paperwidth, yshift=-0.025\paperheight]current page.south east);
    \ifstrequal{#1}{section}{%
      \ifcelestia@motif
        \fill[maintint] (current page.south west) rectangle (current page.north east);
        \fill[maintint!66!background] (celestia disc) circle (0.43\paperheight);
        \fill[maintint!33!background] (celestia disc) circle (0.365\paperheight);
        \fill[background] (celestia disc) circle (0.30\paperheight);
      \else
        \fill[decoration, opacity=0.03] (current page.south west) rectangle (current page.north east);
      \fi
    }{%
      \ifcelestia@motif
        \ifx\celestia@titlebackground\@empty
          \fill[maintint!33!background] (celestia disc) circle (0.43\paperheight);
          \fill[maintint!66!background] (celestia disc) circle (0.365\paperheight);
          \fill[maintint] (celestia disc) circle (0.30\paperheight);
        \fi
      \fi
    }%
  \end{tikzpicture}%
}

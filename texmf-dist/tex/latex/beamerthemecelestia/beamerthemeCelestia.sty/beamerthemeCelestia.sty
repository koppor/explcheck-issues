            \else\ifx\celestia@footerstyle\celestia@fs@badge
                \begin{tikzpicture}[remember picture, overlay]
                  \node[anchor=south east, fill=emphasis, text=background, font=\usebeamerfont{footline text}\bfseries,
                  inner xsep=5pt, inner ysep=2.5pt, rounded corners=1.5pt]
                  at ([xshift=-\beamer@rightmargin, yshift=1.35em]SE)
                  {\celestia@pagecount};
                  \node[anchor=south west, inner xsep=0pt, font=\usebeamerfont{footline text}]
                  at ([xshift=\beamer@leftmargin, yshift=1.35em]SW)
                  {\usebeamercolor[fg]{footline text}%
                   \ifx\beamer@shortauthor\@empty\else\insertshortauthor\quad\textcolor{footlinecolor}{\textbar}\quad\fi
                   \begingroup\hypersetup{hidelinks}\insertshorttitle\endgroup};
                \end{tikzpicture}
                \vspace*{6ex}

              \else\ifx\celestia@footerstyle\celestia@fs@info
                  \begin{tikzpicture}[remember picture, overlay]
                    \ifcelestia@progressbar
                      \fill[\celestia@decoration!15!background] (SW) rectangle ([yshift=1.5pt]SE);
                      \fill[\celestia@decoration] (SW) rectangle ([yshift=1.5pt]$ (SW) + (\progress*\paperwidth, 0) $);
                    \fi
                    \node[anchor=south west, inner xsep=0pt, text=main!65!background, font=\usebeamerfont{footline text}]
                    at ([xshift=\beamer@leftmargin, yshift=1.2ex]SW) {

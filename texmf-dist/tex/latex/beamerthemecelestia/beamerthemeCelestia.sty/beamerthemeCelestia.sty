\newcommand{\celestia@mix@tones}[1]{%
  \colorlet{#1veil}{#1!7!background}%
  \colorlet{#1band}{#1!26!background}%
  \colorlet{#1d1}{#1!15!background}%
  \colorlet{#1d2}{#1!21!background}%
  \colorlet{#1d3}{#1!28!background}%
}
\newcommand{\celestia@define@tones}[3]{%
  \celestia@mix@tones{#1}%
  \definecolor{#1rule}{HTML}{#2}%
  \definecolor{#1ink}{HTML}{#3}%
}
\newcommand{\celestia@fallback@tones}[1]{%
  \celestia@mix@tones{#1}%
  \colorlet{#1rule}{#1!40!background}%
  \colorlet{#1ink}{#1!80!main}%
}

\def\celestia@parse@custompalette#1{%
  \celestia@parse@palette@aux#1,,,,,\relax
}

\def\celestia@parse@palette@aux#1,#2,#3,#4,#5,#6,#7\relax{%
  \def\celestia@maincolor{#1}%
  \def\celestia@accentcolor{#2}%
  \def\celestia@blockcolor{#3}%
  \def\celestia@examplecolor{#4}%
  \def\celestia@alertcolor{#5}%
  \def\celestia@backgroundcolor{#6}%
  \let\celestia@tints\@empty
  \let\celestia@accentpair\@empty
  \celestia@clear@tones
}


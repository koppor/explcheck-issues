\newcommand{\celestia@applyfamily}[1]{%
  \celestia@readfamily{#1}%
  \celestia@resolvedesign
  \edef\celestia@blockkey{\celestia@blockeff}%
  \IfSubStr{,framed,ruled,underline,outline,}{,\celestia@blockeff,}{%
    \edef\celestia@blockkey{\celestia@blockeff @\ifcelestia@blockfilled fill\else nofill\fi}}{}%
  \edef\celestia@fam@color{\csname celestia@famcolor@#1\endcsname}%
  \edef\celestia@tmp{\noexpand\tcbset{%
    \csname celestia@famkey@#1\endcsname/.style={%
      code={\noexpand\def\noexpand\celestia@codehair{\celestia@fam@color!38!background}},
      celestia@paper/.style={\ifcelestia@blockfilled\else colback=background, opacityback=0\fi},
      celestia@corners/.style={\ifcelestia@blockrounded rounded corners, arc=1mm\else sharp corners\fi},
      celestia@\celestia@blockkey={\celestia@fam@color}{####1}},
    \csname celestia@famkey@#1\endcsname @notitle/.style={celestia@notitle@\celestia@blockkey}}}%
  \celestia@tmp
  \def\celestia@fam@bg{background}%
  \IfSubStr{,fullbar,discs,}{,\celestia@blockeff,}{\edef\celestia@fam@bg{\celestia@fam@color veil}}{}%
  \ifdefstring{\celestia@blockeff}{bar}{\edef\celestia@fam@bg{\celestia@fill@bar{\celestia@fam@color}}}{}%
  \ifdefstring{\celestia@blockeff}{sober}{\edef\celestia@fam@bg{\celestia@fill@sober{\celestia@fam@color}}}{}%
  \ifdefstring{\celestia@blockeff}{soft}{\edef\celestia@fam@bg{\celestia@fill@soft{\celestia@fam@color}}}{}%
  \ifcelestia@blockfilled
    \ifdefstring{\celestia@blockeff}{shaded}{\edef\celestia@fam@bg{\celestia@fill@shaded{\celestia@fam@color}}}{}%
    \IfSubStr{,plain,card,ruled,underline,framed,outline,callout,badge,softbadge,}{,\celestia@blockeff,}{%
      \edef\celestia@fam@bg{\celestia@fam@color veil}}{}%
  \fi
  \expandafter\let\csname celestia@fambg@#1\endcsname\celestia@fam@bg
}
\newcommand{\celestia@applyblockstyle}{%
  \@for\celestia@fam@loop:=\celestia@families\do{%
    \expandafter\celestia@applyfamily\expandafter{\celestia@fam@loop}}%
}
\celestia@applyblockstyle


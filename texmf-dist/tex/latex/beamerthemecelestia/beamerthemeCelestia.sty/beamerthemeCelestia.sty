      the footline or the background of this frame:\MessageBreak
      use the frame option celestia={...} instead}%
  \fi
}
\newcommand{\celestia@set@loadonly}[1]{%
  \PackageWarning{celestia}{Option #1 can only be set in \string\usetheme}%
}
\newcommand{\celestia@set@unknown}[2]{%
  \PackageWarning{celestia}{Unknown value for #1: \detokenize{#2}}%
}
\newcommand{\celestia@set@choice}[3]{%
  \celestia@ifin{#3}{#2}{\@namedef{celestia@#1}{#2}}{\celestia@set@unknown{#1}{#2}}%
}
\newcommand{\celestia@set@bool}[2]{%

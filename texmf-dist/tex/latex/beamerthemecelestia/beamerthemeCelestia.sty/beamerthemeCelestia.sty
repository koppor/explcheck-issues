  \SetSymbolFont{largesymbols}{normal}{OMX}{#1}{m}{n}%
  \SetMathAlphabet{\mathrm}{normal}{OT1}{#1}{m}{n}
  \SetMathAlphabet{\mathrm}{bold}{OT1}{#1}{b}{n}

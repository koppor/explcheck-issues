\newcommand{\celestia@plan@build}{%
  \setbox\celestia@planbox\hbox{\usebeamerfont{section number}%
    \ifnum\celestia@toc@max>19 00\else\ifnum\celestia@toc@max>9 10\else 0\fi\fi\kern0.3em}%
  \celestia@planwidth=\wd\celestia@planbox
  \global\celestia@plancount=0
  \setbox\celestia@planbox\vbox{%
    \offinterlineskip
    \def\celestia@tocskip{\vskip 0.15em plus 0.9em\relax}%
    \let\celestia@tochidskip\celestia@tocskip
    \setbeamertemplate{section in toc}{%
      \global\advance\celestia@plancount 1
      \@tempdima=0.3em
      \vskip0.55em
      \usebeamerfont{section title}\normalbaselines
      \celestia@plan@hang
      \noindent\strut
      \celestia@plannum{\usebeamerfont{section number}\usebeamercolor[fg]{section number}\inserttocsectionnumber}%
      {\usebeamercolor[fg]{section title}\inserttocsection}\par
      \vskip\@tempdima}%
    \setbeamertemplate{section in toc shaded}{%
      \global\advance\celestia@plancount 1
      \small\normalbaselines
      \celestia@plan@hang
      \noindent\strut
      \celestia@plannum{\color{main!45!background}\inserttocsectionnumber}%
      {\color{main!58!background}\inserttocsection}\par}%
    \vskip 0.35em plus -0.9em\relax
    \celestia@tableofcontents[currentsection,hideallsubsections]%
    \unskip
  }%
}
\newcommand{\celestia@plan@dots}{%
  \vspace{1.6\baselineskip}%
  \celestia@plandim=\dimexpr(\paperwidth-2\celestia@margin)/\celestia@toc@max\relax
  \ifdim\celestia@plandim>1.55em \celestia@plandim=1.55em\fi
  \edef\celestia@picserial{\the\pgf@picture@serial@count}%
  \noindent\hspace{0.1em}\begin{tikzpicture}[baseline=-0.6ex]
    \celestia@plancount=0
    \loop\ifnum\celestia@plancount<\celestia@toc@max\relax
      \advance\celestia@plancount 1
      \ifnum\celestia@plancount=\c@section
        \fill[emphasis] (\the\celestia@plancount*\celestia@plandim,0) circle (0.58em);
        \node[text=\ifcelestia@motif emphasistint\else background\fi, font=\ifnum\celestia@plancount>9 \scriptsize\else\footnotesize\fi\bfseries, inner sep=0pt]
          at (\the\celestia@plancount*\celestia@plandim,0) {\the\celestia@plancount};
      \else
        \ifnum\celestia@plancount<\c@section
          \fill[main!45!background] (\the\celestia@plancount*\celestia@plandim,0) circle (0.24em);
        \else
          \draw[main!45!background, line width=0.6pt] (\the\celestia@plancount*\celestia@plandim,0) circle (0.24em);
        \fi
      \fi
    \repeat
  \end{tikzpicture}\par
  \global\pgf@picture@serial@count=\celestia@picserial\relax
}
\setbeamertemplate{section page}{%
  \celestia@sectionpage@begin
  \celestia@planlistfalse
  \ifdefstring{\celestia@sectiontoc}{list}{\celestia@planlisttrue}{}%
  \ifdefstring{\celestia@sectiontoc}{true}{\celestia@planlisttrue}{}%
  \ifcelestia@planlist
    \celestia@plan@build
    \setbox\z@\vbox{\celestia@sectionpage@overline}%
    \celestia@plandim=\dimexpr0.8\paperheight-\ht\z@-\dp\z@-\dp\celestia@planbox\relax
    \ifnum\celestia@plancount<2 \celestia@planlistfalse\fi
    \ifdim\ht\celestia@planbox>\celestia@plandim \celestia@planlistfalse\fi
  \fi
  \celestia@sectionpage@overline
  \ifcelestia@planlist
    \@tempdima=\dimexpr\ht\celestia@planbox+0.9em*\numexpr\celestia@plancount-1\relax\relax
    \ifdim\@tempdima>\celestia@plandim \@tempdima=\celestia@plandim\fi
    \nointerlineskip
    \vbox to \@tempdima{\unvbox\celestia@planbox}%
  \else
    \celestia@sectionpage@head{section number}{\thesection}{section title}{\insertsectionhead}%
    \ifdefstring{\celestia@sectiontoc}{false}{}{\ifnum\celestia@toc@max>1 \celestia@plan@dots\fi}%
  \fi
  \celestia@sectionpage@end
}
\setbeamertemplate{subsection page}{%

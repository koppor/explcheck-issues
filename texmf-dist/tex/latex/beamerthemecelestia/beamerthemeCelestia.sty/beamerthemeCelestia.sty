\newcommand{\celestia@footline@body}{%
    \leavevmode%
    \setbeamercolor{current author}{fg=main,bg=background}
    \setbeamercolor{current title}{fg=main,bg=background}
    \setbeamercolor{current date}{fg=main,bg=background}
    \setbeamercolor{current page}{fg=main,bg=background}

    \ifnum\insertmainframenumber>\z@
      \pgfmathsetmacro{\progress}{min(1, \insertframenumber/\insertmainframenumber)}%
    \else
      \def\progress{0}%
    \fi
    \begin{tikzpicture}[remember picture, overlay]
      \coordinate (SW) at (current page.south west);
      \coordinate (SE) at (current page.south east);
    \end{tikzpicture}

    \ifx\celestia@footerstyle\celestia@fs@minimalist
      \begin{tikzpicture}[remember picture, overlay]
        \ifcelestia@progressbar
          \fill[\celestia@decoration!15!background] (SW) rectangle ([yshift=1.5pt]SE);
          \fill[\celestia@decoration] (SW) rectangle ([yshift=1.5pt]$ (SW) + (\progress*\paperwidth, 0) $);
        \fi
        \node[anchor=south east, inner xsep=0pt, font=\usebeamerfont{footline text}]
        at ([xshift=-\beamer@rightmargin, yshift=2ex]SE) {
          \usebeamercolor[fg]{footline text}\celestia@framenumber};
      \end{tikzpicture}
      \vspace*{3ex}

    \else\ifx\celestia@footerstyle\celestia@fs@prestige
        \begin{tikzpicture}[remember picture, overlay]
          \foreach \x in {0.3, 0.7} {
            \node[anchor=base, inner sep=0pt, font=\usebeamerfont{footline text}]
              at ([xshift=\x*\paperwidth, yshift=2ex]SW) {\usebeamercolor[fg]{footline text}\textperiodcentered};
          }
        \end{tikzpicture}%
        \hbox{%
          \begin{beamercolorbox}[wd=.3\paperwidth,ht=3ex,dp=2ex,center]{}
            \usebeamerfont{footline text}\usebeamercolor[fg]{footline text}\insertshortauthor
          \end{beamercolorbox}%
          \begin{beamercolorbox}[wd=.4\paperwidth,ht=3ex,dp=2ex,center]{}
            \usebeamerfont{footline text}\usebeamercolor[fg]{footline text}%
            {\begingroup\hypersetup{hidelinks}\insertshorttitle\endgroup}
          \end{beamercolorbox}%
          \begin{beamercolorbox}[wd=.3\paperwidth,ht=3ex,dp=2ex,center]{}
            \usebeamerfont{footline text}\usebeamercolor[fg]{footline text}%
            \celestia@pagecount
          \end{beamercolorbox}%
        }%

      \else\ifx\celestia@footerstyle\celestia@fs@framed
          \begin{tikzpicture}[remember picture, overlay]
            \draw[footlinecolor, line width=0.4pt]
              ([yshift=5.5ex]SW) -- ([yshift=5.5ex]SE);
          \end{tikzpicture}%
          \hbox{%
            \begin{beamercolorbox}[wd=.3\paperwidth,ht=3ex,dp=2ex,center]{}
              \usebeamerfont{footline text}\usebeamercolor[fg]{footline text}\insertshortauthor
            \end{beamercolorbox}%
            \begin{beamercolorbox}[wd=.39\paperwidth,ht=3ex,dp=2ex,center]{}
              \usebeamerfont{footline text}\usebeamercolor[fg]{footline text}%
              {\begingroup\hypersetup{hidelinks}\insertshorttitle\endgroup}
            \end{beamercolorbox}%
            \begin{beamercolorbox}[wd=.3\paperwidth,ht=3ex,dp=2ex,center]{}
              \usebeamerfont{footline text}\usebeamercolor[fg]{footline text}%
              \celestia@pagecount
            \end{beamercolorbox}%
          }%

        \else\ifx\celestia@footerstyle\celestia@fs@ruled
          \begin{tikzpicture}[remember picture, overlay]
            \node[anchor=base, inner sep=0pt] (ruled@author)
              at ([xshift=0.15\paperwidth, yshift=2ex]SW)
              {\usebeamerfont{footline text}\usebeamercolor[fg]{footline text}\insertshortauthor};
            \node[anchor=base, inner sep=0pt] (ruled@title)
              at ([xshift=0.495\paperwidth, yshift=2ex]SW)
              {\usebeamerfont{footline text}\usebeamercolor[fg]{footline text}%
               \begingroup\hypersetup{hidelinks}\insertshorttitle\endgroup};
            \node[anchor=base, inner sep=0pt] (ruled@page)
              at ([xshift=0.845\paperwidth, yshift=2ex]SW)
              {\usebeamerfont{footline text}\usebeamercolor[fg]{footline text}%
               \celestia@pagecount};
            \draw[footlinecolor, line width=0.4pt]
              ([xshift=\beamer@leftmargin, yshift=4.6ex]SW) -- ([xshift=-\beamer@rightmargin, yshift=4.6ex]SE);
          \end{tikzpicture}%
          \vspace*{4.75ex}

        \else\ifx\celestia@footerstyle\celestia@fs@boxed
          \begin{tikzpicture}[remember picture, overlay]
            \node[anchor=base, inner xsep=5pt, inner ysep=2pt, text height=1.45ex, text depth=0.45ex] (boxed@author)
              at ([xshift=0.15\paperwidth, yshift=3ex]SW)
              {\usebeamerfont{footline text}\usebeamercolor[fg]{footline text}\insertshortauthor};
            \node[anchor=base, inner xsep=5pt, inner ysep=2pt, text height=1.45ex, text depth=0.45ex] (boxed@title)
              at ([xshift=0.495\paperwidth, yshift=3ex]SW)
              {\usebeamerfont{footline text}\usebeamercolor[fg]{footline text}%
               \begingroup\hypersetup{hidelinks}\insertshorttitle\endgroup};
            \node[anchor=base, inner xsep=5pt, inner ysep=2pt, text height=1.45ex, text depth=0.45ex,
              fill=maintint, rounded corners=1pt] (boxed@page)
              at ([xshift=0.845\paperwidth, yshift=3ex]SW)
              {\usebeamerfont{footline text}\usebeamercolor[fg]{footline text}%
               \celestia@pagecount};
          \end{tikzpicture}%
          \vspace*{4ex}

        \else\ifx\celestia@footerstyle\celestia@fs@boxedruled
          \begin{tikzpicture}[remember picture, overlay]
            \coordinate (boxedruled@y) at ([yshift=3.5ex]SW);

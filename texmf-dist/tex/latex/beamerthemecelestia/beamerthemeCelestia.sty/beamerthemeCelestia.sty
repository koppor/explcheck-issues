\newcommand{\celestia@imagepage}[2][]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture, overlay]
      \clip (current page.south west) rectangle (current page.north east);
      \sbox\z@{\includegraphics[width=\paperwidth]{#2}}%
      \ifdim\ht\z@<\paperheight
        \node[inner sep=0pt] at (current page.center) {\includegraphics[height=\paperheight]{#2}};
      \else
        \node[inner sep=0pt] at (current page.center) {\usebox\z@};
      \fi
      \if\relax\detokenize{#1}\relax\else
        \node[anchor=south west, inner sep=5pt, fill=background, fill opacity=0.88, text opacity=1,
          font=\footnotesize, text=main]
          at ([xshift=\beamer@leftmargin, yshift=\beamer@leftmargin]current page.south west) {#1};
      \fi
    \end{tikzpicture}%
  \end{frame}
}

\newcommand{\celestia@keyfigure}[2]{%

  \@for\celestia@fam@loop:=\celestia@families\do{%
    \edef\celestia@tmp{\csname celestia@\celestia@fam@loop block\endcsname}%
    \ifx\celestia@tmp\@empty\else
      \ifdefstring{\celestia@tmp}{auto}{}{%

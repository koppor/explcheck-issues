    {\usebeamerfont{subject}\usebeamercolor[fg]{subject}\celestia@caps{\beamer@shorttitle}\par}%
    \vspace{\dimexpr0.9\baselineskip\relax}%
  \fi
  \celestia@sectionpage@head{section number}{\thesection}{section title}{\insertsectionhead}%
  \celestia@sectionpage@end
}
\setbeamertemplate{subsection page}{%
  \celestia@sectionpage@begin
  {\usebeamerfont{subject}\usebeamercolor[fg]{subject}\celestia@caps{\insertsection}\par}%
  \vspace{\dimexpr0.9\baselineskip\relax}%
  \celestia@sectionpage@head{subsection number}{\insertsectionnumber.\insertsubsectionnumber}{subsection title}{\insertsubsectionhead}%
  \celestia@sectionpage@end
}

\ifcelestia@sectionpage

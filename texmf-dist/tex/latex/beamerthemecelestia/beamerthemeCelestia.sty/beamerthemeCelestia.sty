  \DeclareSymbolFont{celestia@interit}{OML}{Inter-TLF}{#1}{it}%
  \SetSymbolFont{celestia@interit}{bold}{OML}{Inter-TLF}{#2}{it}%
  \DeclareSymbolFontAlphabet{\mathrm}{celestia@interup}%
  \DeclareSymbolFontAlphabet{\mathnormal}{celestia@interit}%
  \def\operator@font{\mathgroup\symcelestia@interup}%
  \SetMathAlphabet{\mathit}{normal}{OT1}{Inter-TLF}{#1}{it}%
  \SetMathAlphabet{\mathit}{bold}{OT1}{Inter-TLF}{#2}{it}%
  \SetMathAlphabet{\mathbf}{normal}{OT1}{Inter-TLF}{#2}{n}%
  \SetMathAlphabet{\mathbf}{bold}{OT1}{Inter-TLF}{#2}{n}%
  \SetMathAlphabet{\mathsf}{normal}{OT1}{Inter-TLF}{#1}{n}%
  \SetMathAlphabet{\mathsf}{bold}{OT1}{Inter-TLF}{#2}{n}%
  \def\celestia@do##1{%
    \ifx##1\relax\else
      \DeclareMathSymbol{##1}{\mathalpha}{celestia@interit}{`##1}%
      \expandafter\celestia@do
    \fi}%
  \celestia@do abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\relax
  \def\celestia@do##1{%
    \ifx##1\relax\else
      \DeclareMathSymbol{##1}{\mathalpha}{celestia@interup}{`##1}%
      \expandafter\celestia@do
    \fi}%
  \celestia@do 0123456789\relax
  \count@="0B
  \@for\celestia@tmp:=alpha,beta,gamma,delta,epsilon,zeta,eta,theta,iota,%
    kappa,lambda,mu,nu,xi,pi,rho,sigma,tau,upsilon,phi,chi,psi,omega,%
    varepsilon,vartheta,varpi,varrho,varsigma,varphi\do{%
    \ifnum\count@="17 \else
      \expandafter\DeclareMathSymbol\csname\celestia@tmp\endcsname
        {\mathord}{celestia@interit}{\count@}%
    \fi
    \advance\count@\@ne}%
  \count@=\z@
  \@for\celestia@tmp:=Gamma,Delta,Theta,Lambda,Xi,Pi,Sigma,Upsilon,Phi,Psi,%
    Omega\do{%
    \expandafter\DeclareMathSymbol\csname\celestia@tmp\endcsname
      {\mathalpha}{celestia@interup}{\count@}%
    \advance\count@\@ne}%
  \DeclareMathSymbol{\partial}{\mathord}{celestia@interit}{"40}%
  \DeclareMathSymbol{\ell}{\mathord}{celestia@interit}{"60}%
  \DeclareMathSymbol{\imath}{\mathord}{celestia@interit}{"7B}%
  \DeclareMathSymbol{\jmath}{\mathord}{celestia@interit}{"7C}%
  \DeclareMathSymbol{!}{\mathclose}{celestia@interup}{"21}%
  \DeclareMathSymbol{;}{\mathpunct}{celestia@interup}{"3B}%
  \DeclareMathSymbol{?}{\mathclose}{celestia@interup}{"3F}%
  \DeclareMathSymbol{,}{\mathpunct}{celestia@interit}{"3B}%
}


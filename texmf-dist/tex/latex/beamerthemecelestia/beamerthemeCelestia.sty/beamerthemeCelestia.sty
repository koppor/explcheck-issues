\ProcessKeyvalOptions*

\csname celestia@palette@\celestia@palette\endcsname
\ifdefined\celestia@custompalette@value
  \expandafter\celestia@parse@custompalette\expandafter{\celestia@custompalette@value}%
\fi
\@for\celestia@role:=main,accent,background,block,example,alert\do{%
  \ifcsname celestia@user@\celestia@role color\endcsname
    \expandafter\let\csname celestia@\celestia@role color\expandafter\endcsname
      \csname celestia@user@\celestia@role color\endcsname
    \let\celestia@tints\@empty
    \let\celestia@bands\@empty
    \let\celestia@veils\@empty
  \fi
}

\ifcelestia@user@light@set\else
  \IfSubStr{,dusk,midnight,obsidian,velours,}{,\celestia@palette,}{\celestia@lightfalse}{}

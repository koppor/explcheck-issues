  \csname sys_if_engine_luatex:TF\endcsname {%
    \directlua{
      local function assign_codepoints_to_names(name_cp_map)
        return function(data)
          local characters = data.characters
          local descriptions = data.descriptions
          local glyph_name_map = data.resources.unicodes
          for name, cp in pairs(name_cp_map) do
            local slot = glyph_name_map[name]
            if slot then
              characters[cp] = table.merged(descriptions[slot])
            else
              tex.error("Failed to find glyph with specified name")
            end
          end
          return data
        end
      end

      local remap_lmpatch = assign_codepoints_to_names{
        gnaborretni = 0x2E18,
        guarani = 0x20B2,
        bigcircle = 0x25EF,
        space_uni0330 = 0x02F7,
        ['dblgrave.ts1'] = 0x02F5,
      }
      fonts.constructors.features.otf.register{
        name = 'lmpatch',
        description = "Patch Latin Modern",
        initializers = {
          node = remap_lmpatch,
          base = remap_lmpatch,
        },
      }
    }%
    \long\def\clm@patch{+lmpatch;}%
  }{%
    \let\clm@patch\@empty
  }%

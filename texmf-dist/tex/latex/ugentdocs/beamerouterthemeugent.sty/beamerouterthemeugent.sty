      [overlay,remember~picture,shift={(current~page.south~west)}]
      \bool_if:NT \g__ugentdocs_showlogo_bool {
         \ugentlogo{\@HBS}{\g__ugentdocs_logocolor_tl}{0}
      }
      \bool_if:NT \g__ugentdocs_framenumber_bool {
        \node[anchor=south~east, inner~sep=0pt, text=fg,
          font=\usebeamerfont{pageno~in~head/foot}]
        at (\@PW-\gridunit,\gridunit)
          {\insertframenumber/\inserttotalframenumber};
      }
    \end{tikzpicture}%
  \end{beamercolorbox}%
}

\defbeamertemplate*{frametitle}{empty} {}

\defbeamertemplate*{frametitle}{normal} {%
  \bool_if:NTF \l__ugentdocs_graphgiven_bool {\@SetInverse}{}%
  \vskip\gridunit%
  \@SetFrameTitleDims
  \hskip\@tempdima%
  \begin{beamercolorbox}[wd=\@tempdimb]{\__ugentdocs_beamercolor:n {frametitle}}%
    \usebeamerfont{frametitle}\MakeUppercase{\insertframetitle}\\[0.5ex]%
    \ifx\insertframesubtitle\@empty%
    {\usebeamerfont{framesubtitle}%
      \usebeamercolor[fg]{\__ugentdocs_beamercolor:n {framesubtitle}}~\strut\par}%
    \vskip-1ex%
    \else%
    {\usebeamerfont{framesubtitle}%
      \usebeamercolor[fg]{\__ugentdocs_beamercolor:n {framesubtitle}}%
      \insertframesubtitle\strut\par}%
    \fi%
    \if@tempswa\else\vskip-.3cm\fi%
  \end{beamercolorbox}%
}

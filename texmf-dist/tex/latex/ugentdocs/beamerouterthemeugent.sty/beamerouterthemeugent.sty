\defbeamertemplate*{title~page}{main}[1][] {%
  \thispagestyle{ugent@titlepage}%
  \@ComputeTitleDims
  \begin{tikzpicture}
    [overlay,remember~picture, shift={(current~page.south~west)}]
    \clip (0,0) rectangle (\textwidth,\paperheight-0.075cm);
    \node[anchor=north~west,
      text~width=\@titletextwidth, text=white, align=flush~left]
    at (2\gridunit,\@PH-\@HTS-\gridunit) {
      \begin{beamercolorbox}[wd=\linewidth,left]{\__ugentdocs_beamercolor:n {title~in~title~page}}
        \footnotesize\textbf{\@department[uppercase]}\\\@team[uppercase]
      \end{beamercolorbox}
    };
    \node[anchor=south~west,
      text~width=\@titletextwidth, text=white, align=flush~left]
    at (2\gridunit,\@HBS+\gridunit) {%
      \begin{beamercolorbox}[wd=\linewidth,left]{\__ugentdocs_beamercolor:n {title~in~title~page}}%
        \Huge\bfseries\MakeUppercase{\inserttitle}%
      \end{beamercolorbox}%
      \par\nointerlineskip\Huge\bfseries\vspace{1ex}%
      \begin{beamercolorbox}[wd=\linewidth,left]{\__ugentdocs_beamercolor:n {subtitle~in~title~page}}%
        \small\MakeUppercase{\insertsubtitle{}~\insertauthor{}~\insertdate}%
      \end{beamercolorbox}%
    };
  \end{tikzpicture}
}

\defbeamertemplate*{section~page}{main}[1][] {%
  \@ComputeTitleDims
  \begin{tikzpicture}
    [overlay,remember~picture, shift={(current~page.south~west)}]
    \begin{scope}
      \@rect[clip]{(2\gridunit,\@HBS+\gridunit)}{(\@PW-\gridunit,\@PH-\gridunit)}
      \node[anchor=south~west,
        text~width=\@titletextwidth, text=white, align=flush~left]
      at (2\gridunit,\@HBS+\gridunit) {
        \begin{beamercolorbox}[wd=\linewidth,left]{\__ugentdocs_beamercolor:n {section~title}}
          \Huge\bfseries
          \bool_if:NTF {\l__ugentdocs_secnums_bool}{
            \MakeUppercase{\insertsectionnumber.~\insertsection}
          }{
            \MakeUppercase{\insertsection}
          }
        \end{beamercolorbox}
      };
    \end{scope}
  \end{tikzpicture}
}

\defbeamertemplate*{subsection~page}{main}[1][] {%

\bool_if:NF \l__ugentdocs_secnums_bool {
  \setbeamertemplate{section~in~toc}{%
    % Based on beamer source, slightly smaller squares
    \leavevmode
    \leftskip=1.75ex
    \llap{%
      \usebeamerfont*{section~number~projected}%
      \usebeamercolor[bg]{section~number~projected}%
      %\vrule width2.25ex height1.85ex depth.4ex% original
      \raisebox{0.24ex}{\vrule width1.35ex height1.11ex depth.24ex}%
    }%
    \kern1.25ex
    \inserttocsection
    \par
  }
}

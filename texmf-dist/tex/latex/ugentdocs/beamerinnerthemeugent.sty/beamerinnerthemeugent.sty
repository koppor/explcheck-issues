\usetikzlibrary{calc}

\mode<presentation>

\setlength\parskip{0.5\baselineskip}
\setlength\parindent{0em}

\newcommand*\@rect[3][]{
\coordinate (bl) at #2;
\coordinate (tr) at #3;
\path[#1] (bl) rectangle (tr);
}

\DeclareRobustCommand\place{\@ifnextchar[{\@placeat}{\@placeat[align=left] }}
\def\@placeat[#1] at (#2,#3)#4{
  \begin{tikzpicture}[overlay,remember picture]
  \coordinate (place@px)
    at ($(current page.south west)!#2!(current page.south west-|current page.north east)$);
  \coordinate (place@py)
    at ($(current page.south west)!#3!(current page.south west|-current page.north east)$);
  \node[inner sep=0pt,#1] at (place@px |- place@py) {#4};
  \end{tikzpicture}
}

\ExplSyntaxOn
\fp_new:N \l__ugentdocs_fillalpha_fp
\tl_new:N \l__ugentdocs_fillcol_tl
\newcommand*\brightness[2][-0.5]{%
  \fp_compare:nNnTF {#1} > {0} {
    \tl_set:Nn \l__ugentdocs_fillcol_tl {white}
    \fp_set:Nn \l__ugentdocs_fillalpha_fp {#1}
  }{
    \tl_set:Nn \l__ugentdocs_fillcol_tl {black}
    \fp_set:Nn \l__ugentdocs_fillalpha_fp {-(#1)}
  }
  \begin{tikzpicture}[inner~sep=0pt,outer~sep=0pt]
    \node (a) {#2};
    \fill[fill=\l__ugentdocs_fillcol_tl, opacity=\fp_to_decimal:N\l__ugentdocs_fillalpha_fp]
      (a.south~west) rectangle (a.north~east);
  \end{tikzpicture}
}

\tl_new:N \l__ugentdocs_textbox_fillcolor_tl
\tl_new:N \l__ugentdocs_textbox_fillalpha_tl
\tl_new:N \l__ugentdocs_textbox_textcolor_tl
\tl_new:N \l__ugentdocs_textbox_textalpha_tl
\tl_new:N \l__ugentdocs_textbox_align_tl

\keys_define:nn { ugentdocs/textbox } {
  fill          .tl_set:N  = \l__ugentdocs_textbox_fillcolor_tl,
  fill          .initial:n = ugent@faculty,
  fill~opacity  .tl_set:N  = \l__ugentdocs_textbox_fillalpha_tl,
  fill~opacity  .initial:n = 1,
  text          .tl_set:N  = \l__ugentdocs_textbox_textcolor_tl,
  text          .initial:n = white,
  text~opacity  .tl_set:N  = \l__ugentdocs_textbox_textalpha_tl,
  text~opacity  .initial:n = 1,
  align         .tl_set:N  = \l__ugentdocs_textbox_align_tl,
  align         .initial:n = left,
}

\NewDocumentCommand \textbox { O{} m m m } {
  \keys_set:nn { ugentdocs/textbox } { #1 }
  \dim_set:Nn \l_tmpa_dim{#2-2\gridunit} % width
  \dim_set:Nn \l_tmpb_dim{#3-2\gridunit} % height
  \begin{tikzpicture}
  \node[align=flush~left,
    text~width=\l_tmpa_dim,
    inner~sep=\gridunit,
    text=\l__ugentdocs_textbox_textcolor_tl,
    text~opacity=\l__ugentdocs_textbox_textalpha_tl] (body)
    {\parbox[t][\l_tmpb_dim][t]{\l_tmpa_dim}{#4}};
  \begin{scope}[on~background~layer]
    \node[fill=\l__ugentdocs_textbox_fillcolor_tl,
      fill~opacity=\l__ugentdocs_textbox_fillalpha_tl, fit=(body), inner~sep=0mm] {};
  \end{scope}
  \end{tikzpicture}
}

\ExplSyntaxOff

\newcommand*{\@titlelogos}{}
\newcommand*{\titlelogos}[1]{\renewcommand*{\@titlelogos}{#1}}

\newcommand*{\@authorrole}{}
\newcommand*{\authorrole}[1]{\renewcommand*{\@authorrole}{#1}}

\NewDocumentCommand{\@printsocialitem}{mmm}{%
  % FA icon command, label text, URL
  \raisebox{-0.25\gridunit}{%
    \tikz[baseline]\node[fill=white,
    minimum width=\gridunit, minimum height=\gridunit,
    inner sep=0pt]{\color{ugent@main}\scalebox{0.75}{#1}};
  }%
  \hspace{0.25\gridunit}%
  \@ifpackageloaded{hyperref}{%
    \href{#3}{\uline{#2}}%
  }{%
    \uline{#2}%
  }
}

\newcommand*{\closingpage}{
  \begin{tikzpicture}
  [overlay,remember picture, shift={(current page.south west)}]
  \clip (0,0) rectangle (\@PW,\@PH);
  \node[anchor=north west,
  text width=\@PW-3\gridunit,
  text=white,
  align=flush left] at (3\gridunit,\@PH-4\gridunit) {
    \begin{beamercolorbox}[wd=\linewidth,left]{\@ugentbeamercolor{title in title page}}
      \small
      \textbf{\insertauthor}\\[0.5ex]
      \ifx\@authorrole\@empty\else
      \@authorrole\\[0.5ex]
      \fi
      \vspace{\gridunit}
      \@department[uppercase]~\@team[uppercase]\\[0.5ex]
      \vspace{\gridunit}
      \ifseqempty{emails}{}{\printseq{emails}{}{}{}\\[0.5ex]}
      \ifseqempty{phones}{}{\printseq{phones}{}{}{}\\[0.5ex]}
      \ifseqempty{mobiles}{}{\printseq{mobiles}{}{}{}\\[0.5ex]}
    \end{beamercolorbox}
  };
  \node[anchor=south west,
  text width=9\gridunit,
  text=white,
  align=flush left] at (\@PW-9\gridunit,\@HBS+\gridunit) {
    \begin{beamercolorbox}[wd=\linewidth,left]{\@ugentbeamercolor{title in title page}}
      \small
      \@printsocialitem{\faFacebook}{Universiteit Gent}
        {https://facebook.com/ugent/}\\[0.6ex]
      \@printsocialitem{\faInstagram}{@ugent}
        {https://instagram.com/ugent/}\\[0.6ex]
      \@printsocialitem{\faLinkedin}{Ghent University}
        {https://www.linkedin.com/school/ghent-university/}\\[0.6ex]
      \@printsocialitem{\faYoutubePlay}{youtube.com/ugent}
        {http://www.youtube.com/user/UniversiteitGent}\\%
      \vspace{\gridunit}
      \textcolor{ugent@accent}{
        \normalsize
        \@ifpackageloaded{hyperref}{%
          \href{https://www.ugent.be/}{www.ugent.be}%
        }{%
          www.ugent.be%
        }
      }
    \end{beamercolorbox}
  };
  \end{tikzpicture}
}

\newcommand\heading[1]{
  \par{
    \usebeamercolor{\@ugentbeamercolor{heading}}
    \color{fg}{\small\textbf{#1}~}
  }
}
\newcommand\subheading[1]{
  \par{
    \usebeamercolor{\@ugentbeamercolor{subheading}}
    \color{fg}{\footnotesize\textbf{\textit{#1}}~}
  }
}


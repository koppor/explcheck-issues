    lignes .initial:n = false ,
    chapeau .bool_set:N = \l__cpge_boite_chapeau_bool ,
    chapeau .initial:n = true ,
    titre .tl_set:N = \l__cpge_boite_titre_tl ,
    tcolorbox .tl_set:N = \l__cpge_boite_options_tl ,
    experimentales .code:n = \tl_put_right:Nn \l__cpge_opt_cap_tl { experimentales = #1 , } ,
    numeriques .code:n = \tl_put_right:Nn \l__cpge_opt_cap_tl { numeriques = #1 , } ,
    exigibles .code:n = \tl_put_right:Nn \l__cpge_opt_cap_tl { exigibles = #1 , } ,
    unknown .code:n =
      { \msg_error:nnVn { programmes-cpge } { option-inconnue } \l_keys_key_str { cpgeboite } } ,
  }

\newcommand \cpgeformattitreboite [1]
  {
    \cpgesiligne {#1}
      { \cpgefiliereDe{#1}~\cpgenumero{#1} }
      { \cpgeintitule{#1} }
  }

\cs_new_protected:Npn \cpge_boite:nn #1#2
  {
    \group_begin:
      \tl_clear:N \l__cpge_opt_cap_tl
      \tl_clear:N \l__cpge_boite_titre_tl
      \tl_clear:N \l__cpge_boite_options_tl
      \keys_set:nn { programmes-cpge / boite } {#1}
      \tl_if_empty:NT \l__cpge_boite_titre_tl
        { \tl_set:Nn \l__cpge_boite_titre_tl { \cpgeformattitreboite {#2} } }
      \tl_set:Ne \l__cpge_tmp_tl
        { cpge~boite , title = { \exp_not:V \l__cpge_boite_titre_tl } , \exp_not:V \l__cpge_boite_options_tl }
      \use:e { \exp_not:N \tcolorbox [ \exp_not:V \l__cpge_tmp_tl ] }
        \str_if_eq:eeTF { \cpge_champ:nn {#2} { genre } } { ligne }
          { \__cpge_boite_ligne:n {#2} }
          { \__cpge_boite_rubrique:n {#2} }
      \endtcolorbox
    \group_end:
  }
\cs_new_protected:Npn \__cpge_boite_ligne:n #1
  {
    \cpge_afficher:nnn { } {#1} { contenu }
    \tcblower
    \cpge_capacites:en { forme = liste , \tl_use:N \l__cpge_opt_cap_tl } {#1}
  }
\cs_new_protected:Npn \__cpge_boite_rubrique:n #1
  {
    \bool_if:NT \l__cpge_boite_chapeau_bool { \cpge_afficher:nnn { } {#1} { chapeau } }
    \bool_if:NT \l__cpge_boite_lignes_bool
      {
        \cpge_lignes:Nn \l__cpge_lignes_seq {#1}
        \seq_map_inline:Nn \l__cpge_lignes_seq
          {
            \par\medskip
            \cpge_afficher:nnn { forme = ligne } {##1} { contenu }
            \cpge_capacites:en { forme = liste , \tl_use:N \l__cpge_opt_cap_tl } {##1}
          }
      }
  }
\NewDocumentCommand \cpgeboite { O{} m } { \cpge_boite:nn {#1} {#2} }


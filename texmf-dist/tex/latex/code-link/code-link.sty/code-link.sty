% The .aux file is tokenized again, so a string cannot be written as it is:
% every character becomes \codelink@c{<charcode>}, which expands to it again.
\cs_new:Npn \__codelink_enc:n #1
  { \str_map_function:nN {#1} \__codelink_enc_char:N }
\cs_new:Npn \__codelink_enc_char:N #1
  { \exp_not:N \codelink@c { \int_eval:n { `#1 } } }
\cs_generate_variant:Nn \__codelink_enc:n { V }
\cs_new_protected:cpn { codelink@c } #1 { \char_generate:nn {#1} { 12 } }

% Character renderers. listings replace the matched characters by what we give
% them, so each one is typeset literally. The same shape serves the spelling of
% a string for listings (spec), for Pygments (pyg) and in labels (sanitize).
% A table holds one control sequence per special character, which is much
% faster than a case distinction per character.
% #1 table, then pairs of a character code and its replacement
\cs_new_protected:Npn \__codelink_table:nnn #1#2#3
  {
    \quark_if_recursion_tail_stop:n {#2}
    \cs_gset:cpn { c__codelink_ #1 _ \char_generate:nn {#2} { 12 } } { \exp_not:n {#3} }
    \__codelink_table:nnn {#1}
  }
% the character is passed in braces: an undelimited argument would skip a space
\cs_new:Npn \__codelink_lookup:nn #1#2 { \cs_if_exist_use:cF { c__codelink_ #1 _ #2 } {#2} }
\__codelink_table:nnn { disp }
  { 92 } { \textbackslash { } } { 95 } { \_ } { 123 } { \{ } { 125 } { \} }
  { 36 } { \$ } { 35 } { \# } { 37 } { \% } { 38 } { \& }
  { 126 } { \textasciitilde { } } { 94 } { \textasciicircum { } }
  { 60 } { \textless { } } { 62 } { \textgreater { } }
  { 34 } { \textquotedbl { } } { 124 } { \textbar { } } { 32 } { \  }
  { 45 } { {-} } { 39 } { {'} } { 96 } { {`} } { 44 } { {,} } { 33 } { {!} } { 63 } { {?} }
  \q_recursion_tail { } \q_recursion_stop
\__codelink_table:nnn { spec } { 92 } { \\ } { 32 } { \  } \q_recursion_tail { } \q_recursion_stop
\__codelink_table:nnn { pyg }
  { 92 } { \PYGZbs { } } { 123 } { \PYGZob { } } { 125 } { \PYGZcb { } } { 94 } { \PYGZca { } }
  { 95 } { \PYGZus { } } { 38 } { \PYGZam { } } { 60 } { \PYGZlt { } } { 62 } { \PYGZgt { } }
  { 35 } { \PYGZsh { } } { 37 } { \PYGZpc { } } { 36 } { \PYGZdl { } } { 45 } { \PYGZhy { } }
  { 39 } { \PYGZsq { } } { 34 } { \PYGZdq { } } { 126 } { \PYGZti { } }
  \q_recursion_tail { } \q_recursion_stop
\__codelink_table:nnn { san }
  { 92 } { :bs: } { 32 } { - } { 37 } { :pc: } { 35 } { :hs: } { 126 } { :ti: } { 123 } { :ob: }
  { 125 } { :cb: } { 94 } { :ca: } { 38 } { :am: } { 36 } { :dl: } { 34 } { :dq: }
  \q_recursion_tail { } \q_recursion_stop
\cs_new:Npn \__codelink_disp:n #1 { \str_map_function:nN {#1} \__codelink_disp_char:N }
\cs_new:Npn \__codelink_disp_char:N #1 { \__codelink_lookup:nn { disp } {#1} }
\cs_new:Npn \__codelink_spec:n #1 { \str_map_function:nN {#1} \__codelink_spec_char:N }
\cs_new:Npn \__codelink_spec_char:N #1 { \__codelink_lookup:nn { spec } {#1} }
\cs_new:Npn \__codelink_pyg:n #1 { \str_map_function:nN {#1} \__codelink_pyg_char:N }
\cs_new:Npn \__codelink_pyg_char:N #1 { \__codelink_lookup:nn { pyg } {#1} }
\cs_new:Npn \__codelink_sanitize:n #1 { \str_map_function:nN {#1} \__codelink_sanitize_char:N }
\cs_generate_variant:Nn \__codelink_sanitize:n { V, e }
\cs_new:Npn \__codelink_sanitize_char:N #1 { \__codelink_lookup:nn { san } {#1} }

% Languages are compared lowercased and without the dialect, like listings
% stores \lst@language.
% Results are cached, as this runs for every string and every minted environment.
\regex_const:Nn \c__codelink_dialect_regex { \A \[ [^\]]* \] }
\cs_new_protected:Npn \__codelink_scope:Nn #1#2
  {
    \str_set:Nx #1 {#2}
    \cs_if_exist:cTF { g__codelink_sc_ #1 }
      { \tl_set_eq:Nc #1 { g__codelink_sc_ #1 } }
      {
        \str_set_eq:NN \l__codelink_scope_in_str #1
        \str_set:Nx #1 { \str_foldcase:V #1 }
        \str_if_eq:eeT { \str_head:N #1 } { [ }
          { \regex_replace_once:NnN \c__codelink_dialect_regex { } #1 }
        \tl_gset_eq:cN { g__codelink_sc_ \l__codelink_scope_in_str } #1
      }
  }
\str_new:N \l__codelink_scope_in_str
% Is #1 a name of letters, with an optional backslash in front? (l3regex is too
% slow for a test that runs once per string)
\bool_new:N \l__codelink_isword_bool
\cs_new_protected:Npn \__codelink_if_word:nT #1#2
  {
    \str_set:Nn \l_tmpb_str {#1}
    \str_if_eq:eeT { \str_head:N \l_tmpb_str } { \c_backslash_str }
      { \str_set:Nx \l_tmpb_str { \str_tail:N \l_tmpb_str } }
    \bool_set:Nn \l__codelink_isword_bool { ! \str_if_empty_p:N \l_tmpb_str }
    \str_map_inline:Nn \l_tmpb_str
      {
        \__codelink_if_letter:nF {##1}
          { \bool_set_false:N \l__codelink_isword_bool \str_map_break: }
      }
    \bool_if:NT \l__codelink_isword_bool {#2}
  }
\prg_new_conditional:Npnn \__codelink_if_letter:n #1 { F }
  {
    \bool_lazy_or:nnTF
      { \int_compare_p:n { `A <= `#1 <= `Z } }
      { \int_compare_p:n { `a <= `#1 <= `z } }
      \prg_return_true: \prg_return_false:
  }
% Does #1 end with a letter, a digit or an underscore?
\cs_new_protected:Npn \__codelink_if_wordend:nT #1
  { \exp_args:Nx \__codelink_if_wordchar:nT { \str_item:nn {#1} { -1 } } }
\cs_new_protected:Npn \__codelink_if_wordchar:nT #1#2
  {
    \bool_lazy_any:nT
      {
        { \int_compare_p:n { `A <= `#1 <= `Z } }
        { \int_compare_p:n { `a <= `#1 <= `z } }
        { \int_compare_p:n { `0 <= `#1 <= `9 } }
        { \int_compare_p:nNn { `#1 } = { `_ } }
      }
      {#2}
  }

% Styles are code which runs in the group that typesets a link.
\NewDocumentCommand \CodeLinkStyle { m m }
  { \cs_set_protected:cpn { codelink@style@ \tl_to_str:n {#1} } {#2} }
\CodeLinkStyle { none } { }

% Options of a string: its own, else those of its group, else the defaults.
% A group is the entries "<name>/<key>" of one property list.
\prop_new:N \g__codelink_groups_prop
\cs_generate_variant:Nn \prop_get:NnNTF { Nx }
\cs_generate_variant:Nn \prop_if_in:NnTF { Nx }
\prop_new:N \l__codelink_opts_prop
\prop_const_from_keyval:Nn \c__codelink_defaults_prop
  { prefix = cl:, style = none, language = , links = true, highlight = true, boundary = true }
\tl_new:N \l__codelink_group_tl
\tl_new:N \l__codelink_label_tl
\tl_new:N \l__codelink_display_tl
\tl_new:N \l__codelink_style_tl
\tl_new:N \l__codelink_astyle_tl   % written to the .aux file
\tl_new:N \l__codelink_prefix_tl
\tl_new:N \l__codelink_lang_tl
\tl_new:N \l__codelink_links_tl
\tl_new:N \l__codelink_hl_tl
\tl_new:N \l__codelink_bd_tl
\str_new:N \l__codelink_str       % the string, with the backslash of a command
\str_new:N \l__codelink_scope_str
\bool_new:N \l__codelink_command_bool
\bool_new:N \l__codelink_links_bool
\keys_define:nn { codelink / entry }
  {
    group .tl_set:N = \l__codelink_group_tl,
    label .tl_set:N = \l__codelink_label_tl,
    display .tl_set:N = \l__codelink_display_tl,
    command .bool_set:N = \l__codelink_command_bool,
    command .default:n = true,
    prefix .code:n = { \prop_put:Nnn \l__codelink_opts_prop { prefix } {#1} },
    style .code:n = { \prop_put:Nnn \l__codelink_opts_prop { style } {#1} },
    language .code:n = { \prop_put:Nnn \l__codelink_opts_prop { language } {#1} },
    links .code:n = { \prop_put:Nnn \l__codelink_opts_prop { links } {#1} },
    highlight .code:n = { \prop_put:Nnn \l__codelink_opts_prop { highlight } {#1} },
    boundary .code:n = { \prop_put:Nnn \l__codelink_opts_prop { boundary } {#1} },
  }
\NewDocumentCommand \CodeLinkGroup { m m }
  {
    \group_begin:
      \prop_clear:N \l__codelink_opts_prop
      \keys_set:nn { codelink / entry } {#2}
      \prop_map_inline:Nn \l__codelink_opts_prop
        { \prop_gput:Nnn \g__codelink_groups_prop { #1 / ##1 } {##2} }
    \group_end:
    \prop_gput:Nnn \g__codelink_groups_prop { #1 / } { }
    \cs_undefine:c { g__codelink_gc_ #1 }
  }
\CodeLinkGroup { default } { }
\cs_new_protected:Npn \__codelink_opt:nN #1#2
  {
    \prop_get:NnNTF \l__codelink_opts_prop {#1} #2 { }
      {
        \prop_get:NxNTF \g__codelink_groups_prop { \l__codelink_group_tl / #1 } #2 { }
          { \prop_get:NnN \c__codelink_defaults_prop {#1} #2 }
      }
  }

\cs_new_protected:Npn \__codelink_resolve:
  {
    \__codelink_opt:nN { prefix } \l__codelink_prefix_tl
    \__codelink_opt:nN { style } \l__codelink_style_tl
    \__codelink_opt:nN { language } \l__codelink_lang_tl
    \__codelink_opt:nN { links } \l__codelink_links_tl
    \__codelink_opt:nN { highlight } \l__codelink_hl_tl
    \__codelink_opt:nN { boundary } \l__codelink_bd_tl
  }
% Resolves the options of the string #2 given #1.
\cs_new_protected:Npn \__codelink_prepare:nn #1#2
  {
    \tl_set:Nn \l__codelink_group_tl { default }
    \tl_clear:N \l__codelink_label_tl
    \tl_clear:N \l__codelink_display_tl
    \bool_set_false:N \l__codelink_command_bool
    \prop_clear:N \l__codelink_opts_prop
    \keys_set:nn { codelink / entry } {#1}
    \prop_if_in:NxTF \g__codelink_groups_prop { \l__codelink_group_tl / } { }
      {
        \msg_warning:nnx { codelink } { unknown-group } { \l__codelink_group_tl }
        \tl_set:Nn \l__codelink_group_tl { default }
      }
    \str_set:Nx \l__codelink_str
      { \bool_if:NT \l__codelink_command_bool { \c_backslash_str } \tl_to_str:n {#2} }
    % without keys of its own, a string takes the options of its group, which
    % are resolved once (\CodeLinkGroup drops the cache)
    \prop_if_empty:NTF \l__codelink_opts_prop
      {
        \cs_if_exist:cF { g__codelink_gc_ \l__codelink_group_tl }
          {
            \__codelink_resolve:
            \cs_gset:cpx { g__codelink_gc_ \l__codelink_group_tl }
              {
                \tl_set:Nn \exp_not:N \l__codelink_prefix_tl { \exp_not:V \l__codelink_prefix_tl }
                \tl_set:Nn \exp_not:N \l__codelink_style_tl { \exp_not:V \l__codelink_style_tl }
                \tl_set:Nn \exp_not:N \l__codelink_lang_tl { \exp_not:V \l__codelink_lang_tl }
                \tl_set:Nn \exp_not:N \l__codelink_links_tl { \exp_not:V \l__codelink_links_tl }
                \tl_set:Nn \exp_not:N \l__codelink_hl_tl { \exp_not:V \l__codelink_hl_tl }
                \tl_set:Nn \exp_not:N \l__codelink_bd_tl { \exp_not:V \l__codelink_bd_tl }
              }
          }
        \use:c { g__codelink_gc_ \l__codelink_group_tl }
      }
      { \__codelink_resolve: }
    \bool_set:Nn \l__codelink_links_bool { ! \str_if_eq_p:ee { \l__codelink_links_tl } { false } }
    % highlight=false: listings keep the colors of their own highlighting
    \tl_set_eq:NN \l__codelink_astyle_tl \l__codelink_style_tl
    \str_if_eq:eeT { \l__codelink_hl_tl } { false } { \tl_set:Nn \l__codelink_astyle_tl { none } }
    \tl_if_empty:NT \l__codelink_label_tl
      { \tl_set:Nx \l__codelink_label_tl { \l__codelink_prefix_tl \__codelink_sanitize:V \l__codelink_str } }
    \tl_if_empty:NT \l__codelink_display_tl
      { \tl_set:Nx \l__codelink_display_tl { \l__codelink_str } }
    \__codelink_scope:Nn \l__codelink_scope_str { \l__codelink_lang_tl }
  }

% Registering: one line per string in the .aux file; before \begin{document}
% they wait, as the file is only open then. A group with links=false registers
% nothing, its strings are plain text.
\seq_new:N \g__codelink_pending_seq
\bool_new:N \g__codelink_document_bool
\cs_new_protected:Npn \__codelink_write:n #1 { \iow_now:Nx \@mainaux {#1} }
\cs_generate_variant:Nn \__codelink_write:n { V }
\cs_generate_variant:Nn \seq_gput_right:Nn { NV }
\cs_new_protected:Npn \__codelink_register:n #1
  {
    \bool_if:NT \l__codelink_links_bool
      {
        \str_if_empty:NTF \l__codelink_str
          { \msg_warning:nn { codelink } { empty-string } }
          {
            \str_set:Nx \l_tmpa_str
              { g__codelink_w_ #1 / \l__codelink_scope_str / \__codelink_enc:V \l__codelink_str }
            \cs_if_exist:cF { \l_tmpa_str }
              {
                \cs_gset_nopar:cpn { \l_tmpa_str } { }
                \tl_set:Nx \l_tmpa_tl
                  {
                    \exp_not:N \codelink@in
                      { \__codelink_enc:V \l__codelink_str }
                      { \__codelink_enc:V \l__codelink_label_tl }
                      { \__codelink_enc:V \l__codelink_display_tl }
                      { \tl_to_str:N \l__codelink_astyle_tl }
                      { \__codelink_enc:V \l__codelink_scope_str }
                      {#1}
                      { \l__codelink_bd_tl }
                  }
                \bool_if:NTF \g__codelink_document_bool
                  { \__codelink_write:V \l_tmpa_tl }
                  { \seq_gput_right:NV \g__codelink_pending_seq \l_tmpa_tl }
              }
          }
      }
  }
\cs_new_protected:Npn \__codelink_anchor_hook:nn #1#2 { }
\cs_generate_variant:Nn \__codelink_anchor_hook:nn { VV }
\NewDocumentCommand \CodeLinkAnchorHook { m }
  { \cs_set_protected:Npn \__codelink_anchor_hook:nn ##1##2 {#1} }
\NewDocumentCommand \CodeLinkAnchor { O{} m }
  {
    \group_begin:
      \__codelink_prepare:nn {#1} {#2}
      \__codelink_register:n { link }
      \cs_if_exist:NT \phantomsection { \phantomsection }
      \exp_args:NV \label \l__codelink_label_tl
      \__codelink_anchor_hook:VV \l__codelink_str \l__codelink_label_tl
    \group_end:
  }
\NewDocumentCommand \CodeLinkRegister { O{} m }
  { \group_begin: \__codelink_prepare:nn {#1} {#2} \__codelink_register:n { link } \group_end: }
\NewDocumentCommand \CodeLinkBlock { O{} m }
  { \group_begin: \__codelink_prepare:nn {#1} {#2} \__codelink_register:n { block } \group_end: }

% Typesetting a link. The underline is a light rule at a fixed distance below
% the baseline, whatever the depth of the text is.
\box_new:N \l__codelink_ul_box
\box_new:N \l__codelink_ul_out_box
\tl_new:N \l__codelink_ul_color_tl   % the color of the line in a listing or in the text
\tl_set_eq:NN \l__codelink_ul_color_tl \g__codelink_ul_color_tl
\bool_new:N \l__codelink_hook_bool   % set inside of the Output hook of listings
\cs_new_protected:Npn \__codelink_ul_draw:N #1
  {
    \hbox_set:Nn \l__codelink_ul_out_box
      {
        \box_use:N #1
        \skip_horizontal:n { - \box_wd:N #1 }
        \tl_if_empty:NF \l__codelink_ul_color_tl
          { \@ifpackageloaded { xcolor } { \exp_args:NV \color \l__codelink_ul_color_tl } { } }
        \vrule width \box_wd:N #1
          height \dim_eval:n { \g__codelink_ul_thick_tl - \g__codelink_ul_offset_tl }
          depth \dim_eval:n { \g__codelink_ul_offset_tl } \scan_stop:
      }
    \box_set_dp:Nn \l__codelink_ul_out_box { \box_dp:N #1 }
    \box_use_drop:N \l__codelink_ul_out_box
  }
% #1 label (empty: no link), #2 style name, #3 text
\cs_new_protected:Npn \__codelink_format:nnn #1#2#3
  {
    \group_begin:
      \cs_if_exist_use:c { codelink@style@ #2 }
      \bool_lazy_all:nTF { { \g__codelink_underline_bool } { \l__codelink_ul_bool } { ! \tl_if_empty_p:n {#1} } }
        {
          % in the Output hook, #3 is the output of the whole token: the box
          % is only known once listings has made it
          \bool_if:NTF \l__codelink_hook_bool
            { \cs_set_protected:Npn \lst@OutputBox ##1 { \__codelink_ul_draw:N ##1 } #3 }
            { \hbox_set:Nn \l__codelink_ul_box {#3} \__codelink_ul_draw:N \l__codelink_ul_box }
        }
        {#3}
    \group_end:
  }
% How a text becomes a link to a label (#1 label, #2 text): hyperref, or any
% package which provides \hyperref, or the command of the user.
\cs_new_protected:Npn \__codelink_linkcmd:nn #1#2 { \hyperref [#1] {#2} }
\NewDocumentCommand \CodeLinkLinkCommand { m }
  {

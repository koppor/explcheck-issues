% check (default true): warn unless the title page uses the fields of the
% citation that the author style of the document checks, by default the title
% and every author in \maketitle. See "Checking the title page".
% style: the author style of the document. \cffsetauthors uses it by default,
% and the check uses its check-fields and check-region keys.
\bool_new:N \g__cfflatex_check_bool
\tl_new:N \g__cfflatex_document_style_tl
\keys_define:nn { import-citation-cff }
  {
    check .bool_gset:N = \g__cfflatex_check_bool,
    check .initial:n = true,
    style .tl_gset:N = \g__cfflatex_document_style_tl,
    style .value_required:n = true,
  }
\ProcessKeyOptions [import-citation-cff]


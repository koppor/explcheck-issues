% The check of the document --------------------------------------------------
%
% At \begin{document}, the check takes its fields and regions from the style
% option of the package, or else from the style of the last \cffsetauthors in
% the preamble, or else from standard. A style definition can give
% check-fields, a list of fields of the citation, where authors stands for
% every author, and check-region, a list of regions: maketitle, hooks =
% {<begin hook>}{<end hook>}, and document as the fallback.
\int_new:N \l__cfflatex_check_id_int
\tl_new:N \l__cfflatex_region_tl
\cs_generate_variant:Nn \hook_gput_code:nnn { nne }
\keys_define:nn { import-citation-cff / check }
  {
    check-fields .clist_gset:N = \g__cfflatex_check_fields_clist,
    check-region .code:n =
      {
        \seq_gclear:N \g__cfflatex_check_regions_seq
        \bool_gset_false:N \g__cfflatex_check_document_bool
        \keys_set:nn { import-citation-cff / check-region } {#1}
      },
  }
\keys_define:nn { import-citation-cff / check-region }
  {
    maketitle .code:n =
      { \seq_gput_right:Nn \g__cfflatex_check_regions_seq { maketitle } },
    maketitle .value_forbidden:n = true,
    document .code:n = { \bool_gset_true:N \g__cfflatex_check_document_bool },
    document .value_forbidden:n = true,
    hooks .code:n =
      {
        \int_compare:nNnTF { \tl_count:n {#1} } = { 2 }
          { \__cfflatex_check_hooks:nn #1 }
          {
            \msg_error:nnn { import-citation-cff }
              { check-region } { hooks~=~#1 }
          }
      },
    hooks .value_required:n = true,
    unknown .code:n =
      {
        \msg_error:nne { import-citation-cff }
          { check-region } { \l_keys_key_str }
      },
  }
% The region hooks<n> opens at the hook #1 and closes at the hook #2.
\cs_new_protected:Npn \__cfflatex_check_hooks:nn #1#2
  {
    \tl_set:Ne \l__cfflatex_region_tl
      { hooks \int_eval:n { \seq_count:N \g__cfflatex_check_regions_seq + 1 } }
    \seq_gput_right:NV \g__cfflatex_check_regions_seq \l__cfflatex_region_tl
    \hook_gput_code:nne {#1} { import-citation-cff }
      { \__cfflatex_region_begin:n { \l__cfflatex_region_tl } }
    \hook_gput_code:nne {#2} { import-citation-cff }
      { \__cfflatex_region_end:n { \l__cfflatex_region_tl } }

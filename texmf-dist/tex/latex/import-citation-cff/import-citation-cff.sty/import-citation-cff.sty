\prop_new:N \g__cfflatex_values_prop
% Every value of the citation by its path, such as "authors/1/name", and the
% kind of each mapping ("map") and sequence (its length) by its path, for \cff.
\prop_new:N \g__cfflatex_fields_prop
\prop_new:N \g__cfflatex_kinds_prop
\int_new:N \g__cfflatex_author_count_int
% The index of the current author in \cffforeachauthor; 0 outside the loop.
\int_new:N \g__cfflatex_author_index_int
% The number of the current affiliation in \cffforeachaffiliation, and the
% index of the current affiliation of the author in
% \cffforeachauthoraffiliation; 0 outside these loops.
\int_new:N \g__cfflatex_affiliation_index_int
\int_new:N \g__cfflatex_author_affiliation_index_int
% The index of the current contact in \cffforeachcontact; 0 outside the loop.
\int_new:N \g__cfflatex_contact_index_int
\bool_new:N \g__cfflatex_loaded_bool
\tl_new:N \l__cfflatex_source_tl
\tl_new:N \l__cfflatex_filename_tl
\tl_new:N \g__cfflatex_helper_tl
\str_new:N \l__cfflatex_file_lua_str
\str_new:N \l__cfflatex_helper_lua_str
\str_new:N \l__cfflatex_source_lua_str
\ior_new:N \g__cfflatex_dependency_ior
% For the check: whether a check region is open, the part of the title page
% being typeset (1: \title, 2: \author, 0: neither), the uses recorded as
% "<region>/<part>/<use>" and "<region>/*/<use>", and missing authors. <use>
% is <i> for author <i>, and the negative number of another checked field.
\bool_new:N \g__cfflatex_recording_bool
\tl_new:N \g__cfflatex_part_tl
\prop_new:N \g__cfflatex_used_prop
\clist_new:N \l__cfflatex_missing_clist
% The check of the document: the author style that gives it, the fields it
% checks and their numbers, its regions (maketitle and hooks<n>) and whether
% the whole document is the fallback region, the open regions, and whether a
% region has been checked.
\tl_new:N \g__cfflatex_check_style_tl
\clist_new:N \g__cfflatex_check_fields_clist
\prop_new:N \g__cfflatex_check_ids_prop
\seq_new:N \g__cfflatex_check_regions_seq
\bool_new:N \g__cfflatex_check_document_bool
\clist_new:N \g__cfflatex_check_open_clist
\bool_new:N \g__cfflatex_check_done_bool
\cs_generate_variant:Nn \ior_open:Nn { NV }

% Prefer the helper next to this package so both files share a version.
\file_get_full_name:nNF { \@currpath cfflatex.lua } \g__cfflatex_helper_tl
  {
    \file_get_full_name:nNF { cfflatex.lua } \g__cfflatex_helper_tl
      { \msg_fatal:nn { import-citation-cff } { missing-helper } }
  }

\keys_define:nn { import-citation-cff / include }
  {
    source .tl_set:N = \l__cfflatex_source_tl,
    source .value_required:n = true,
  }

% Quote a file name or a source key as a Lua string literal; the file contents
% are parsed as YAML and never become Lua source.
\cs_new_protected:Npn \__cfflatex_lua_quote:NN #1#2
  {
    \str_set:Ne #2 { \tl_to_str:V #1 }
    \regex_replace_all:nnN { [\\"] } { \\\0 } #2
    \regex_replace_all:nnN { \r } { \\r } #2
    \regex_replace_all:nnN { \n } { \\n } #2
    \str_put_left:Nn #2 { " }
    \str_put_right:Nn #2 { " }
  }

% Called by the TeX code that cfflatex.lua returns; explcheck cannot see these
% uses, so it would report the functions as unused (W401).
\cs_new_protected:Npn \__cfflatex_store:nn #1#2 % noqa: w401
  { \prop_gput:Nnn \g__cfflatex_values_prop {#1} {#2} }
\cs_new_protected:Npn \__cfflatex_store_field:nn #1#2 % noqa: w401
  { \prop_gput:Nnn \g__cfflatex_fields_prop {#1} {#2} }
\cs_new_protected:Npn \__cfflatex_store_kind:nn #1#2 % noqa: w401
  { \prop_gput:Nnn \g__cfflatex_kinds_prop {#1} {#2} }
\cs_new_protected:Npn \__cfflatex_finish:n #1 % noqa: w401
  {
    \int_gset:Nn \g__cfflatex_author_count_int {#1}
    \bool_gset_true:N \g__cfflatex_loaded_bool
  }
\cs_new_protected:Npn \__cfflatex_fail:n #1 % noqa: w401
  { \msg_fatal:nnn { import-citation-cff } { invalid } {#1} }

% \includecff[source=<key>]{<file>}
% Reads the top level of <file>, or the mapping under its top-level <key>, such
% as preferred-citation. A document reads one CFF file: \title and similar
% commands store \cff and expand it later, so reading another file would
% change values given before it. A second call is an error and is ignored.
\NewDocumentCommand \includecff {O{} m}
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      { \msg_error:nn { import-citation-cff } { include-once } }
      { \__cfflatex_include:nn {#1} {#2} }
  }
\cs_new_protected:Npn \__cfflatex_include:nn #1#2
  {
    \group_begin:
    \tl_clear:N \l__cfflatex_source_tl
    \keys_set:nn { import-citation-cff / include } {#1}
    \file_get_full_name:nNF {#2} \l__cfflatex_filename_tl
      { \msg_fatal:nnn { import-citation-cff } { missing-file } {#2} }
    \sys_if_engine_luatex:F
      {
        \sys_if_shell_unrestricted:F
          { \msg_fatal:nn { import-citation-cff } { shell-escape } }
      }
    % cfflatex.lua reads the file outside TeX. Opening it once through TeX
    % lists it in the .fls file of the -recorder option, which latexmk and
    % LaTeX Workshop use to rebuild when a dependency changes. Finding the file
    % above does not always do so: LuaLaTeX with shell escape does not record
    % it.
    \ior_open:NV \g__cfflatex_dependency_ior \l__cfflatex_filename_tl
    \ior_close:N \g__cfflatex_dependency_ior
    \bool_gset_false:N \g__cfflatex_loaded_bool
    \int_gzero:N \g__cfflatex_author_count_int
    \prop_gclear:N \g__cfflatex_values_prop
    \prop_gclear:N \g__cfflatex_fields_prop
    \prop_gclear:N \g__cfflatex_kinds_prop
    \__cfflatex_lua_quote:NN \l__cfflatex_filename_tl \l__cfflatex_file_lua_str
    \__cfflatex_lua_quote:NN \g__cfflatex_helper_tl \l__cfflatex_helper_lua_str
    \__cfflatex_lua_quote:NN \l__cfflatex_source_tl \l__cfflatex_source_lua_str
    \luabridge_now:e
      {
        local~kpse = require("kpse");
        local~helper = \exp_not:V \l__cfflatex_helper_lua_str;
        local~cfflatex = assert(loadfile(
        kpse.find_file(helper,~"tex")~or~helper))(helper);
        print(cfflatex.read(
        \exp_not:V \l__cfflatex_file_lua_str,
        \exp_not:V \l__cfflatex_source_lua_str
        ));
      }
    \group_end:
  }

% Checking the title page ----------------------------------------------------
%
% The author style of the document gives the fields to check and the regions
% of the document to check them in (see "Author styles" below). While a region
% is open, \cff and \cffauthor leave a record marker before the values of these
% fields. In the maketitle region, markers around the contents of \@title and
% \@author also tell which part of the title page is being typeset. The
% markers record when they are executed, which is when the title page is
% typeset; this sees uses in loops such as \cffforeachauthor and \foreach, whose
% indices are known only then, and in macros of the document. The markers carry
% only digits and "-", so case changes such as \MakeUppercase keep them intact,
% and their names contain no "_" or ":", so they stay readable if a class
% writes the title page to a file.
%
% The first region that closes is checked, and no region is checked after it.
% If the whole document is the fallback region, it is checked at its end when
% no other region has closed.

% <use> is <i> for author <i>, and the number of another checked field.
\cs_new_protected:cpn { cfflatex@mark } #1
  {
    \bool_if:NT \g__cfflatex_recording_bool
      {
        \clist_map_inline:Nn \g__cfflatex_check_open_clist
          {
            \prop_gput:Nen \g__cfflatex_used_prop
              { ##1 / \g__cfflatex_part_tl / #1 }
              {}
            \prop_gput:Nnn \g__cfflatex_used_prop { ##1 / * / #1 } {}
          }
      }
  }
% <part> is 1 for \title, 2 for \author, and 0 after them.
\cs_new_protected:cpn { cfflatex@part } #1
  { \tl_gset:Nn \g__cfflatex_part_tl {#1} }
\cs_new:Npn \__cfflatex_mark:n #1
  {
    % The marker is protected, so it stays a marker in expansion contexts.
    \bool_if:NT \g__cfflatex_recording_bool
      { \use:c { cfflatex@mark } {#1} }
  }
\cs_generate_variant:Nn \__cfflatex_mark:n { e }
\cs_generate_variant:Nn \prop_gput:Nnn { Nen }
\prg_generate_conditional_variant:Nnn \prop_if_in:Nn { Ne } { F }

% Opens the region #1, unless a region has already been checked.
\cs_new_protected:Npn \__cfflatex_region_begin:n #1
  {
    \bool_if:NF \g__cfflatex_check_done_bool
      {
        \clist_if_in:NnF \g__cfflatex_check_open_clist {#1}
          { \clist_gput_right:Nn \g__cfflatex_check_open_clist {#1} }
        \bool_gset_true:N \g__cfflatex_recording_bool
      }
  }
% Closes the region #1 if it is open, and checks it.
\cs_new_protected:Npn \__cfflatex_region_end:n #1
  {
    \clist_if_in:NnT \g__cfflatex_check_open_clist {#1}
      {
        \bool_gset_true:N \g__cfflatex_check_done_bool
        \bool_gset_false:N \g__cfflatex_recording_bool
        \clist_gclear:N \g__cfflatex_check_open_clist
        \bool_if:NT \g__cfflatex_loaded_bool
          {
            \clist_map_inline:Nn \g__cfflatex_check_fields_clist
              {
                \str_if_eq:nnTF {##1} { authors }
                  { \__cfflatex_check_authors:n {#1} }
                  { \__cfflatex_check_field:nn {#1} {##1} }
              }
          }
      }
  }
% Warns unless the region #1 uses the field #2. A field that the citation does
% not have cannot be used. In \maketitle, \title must use the title.
\cs_new_protected:Npn \__cfflatex_check_field:nn #1#2
  {
    \prop_if_in:NnT \g__cfflatex_fields_prop {#2}
      {
        \bool_lazy_and:nnTF { \str_if_eq_p:nn {#1} { maketitle } }
          { \str_if_eq_p:nn {#2} { title } }
          {
            \prop_if_in:NeF \g__cfflatex_used_prop
              { #1 / 1 / \prop_item:Nn \g__cfflatex_check_ids_prop {#2} }
              { \msg_warning:nn { import-citation-cff } { title-unused } }
          }
          {
            \prop_if_in:NeF \g__cfflatex_used_prop
              { #1 / * / \prop_item:Nn \g__cfflatex_check_ids_prop {#2} }
              { \msg_warning:nnn { import-citation-cff } { field-unused } {#2} }
          }
      }
  }
% Warns unless the region #1 uses every author. In \maketitle, \author must
% use them.
\cs_new_protected:Npn \__cfflatex_check_authors:n #1
  {
    \clist_clear:N \l__cfflatex_missing_clist
    \int_step_inline:nn { \g__cfflatex_author_count_int }
      {
        \prop_if_in:NeF \g__cfflatex_used_prop
          { #1 / \str_if_eq:nnTF {#1} { maketitle } { 2 } { * } / ##1 }
          { \clist_put_right:Nn \l__cfflatex_missing_clist {##1} }
      }
    \clist_if_empty:NF \l__cfflatex_missing_clist
      {
        \str_if_eq:nnTF {#1} { maketitle }
          {
            \msg_warning:nne { import-citation-cff } { authors-unused }
              { \clist_use:Nn \l__cfflatex_missing_clist { ,~ } }
          }
          {
            \msg_warning:nne { import-citation-cff } { region-authors-unused }
              { \clist_use:Nn \l__cfflatex_missing_clist { ,~ } }
          }
      }
  }

\cs_new_protected:Npn \__cfflatex_check_begin:
  {
    \seq_if_in:NnT \g__cfflatex_check_regions_seq { maketitle }
      {
        \bool_lazy_and:nnT { \g__cfflatex_loaded_bool }
          { ! \g__cfflatex_check_done_bool }
          {
            \tl_gset:Nn \g__cfflatex_part_tl { 0 }
            \__cfflatex_wrap_part:Nn \@title { 1 }
            \__cfflatex_wrap_part:Nn \@author { 2 }
            \__cfflatex_region_begin:n { maketitle }
          }
      }
  }
\cs_new_protected:Npn \__cfflatex_wrap_part:Nn #1#2
  {
    \cs_gset:Npe #1
      {
        \exp_not:c { cfflatex@part } {#2}
        \exp_not:o {#1}
        \exp_not:c { cfflatex@part } { 0 }
      }
  }
\AddToHook {cmd/maketitle/before} [import-citation-cff]
  {\__cfflatex_check_begin:}
\AddToHook {cmd/maketitle/after} [import-citation-cff]
  {\__cfflatex_region_end:n { maketitle }}
% The whole document is checked at its end, if no other region was checked.
\cs_new_protected:Npn \__cfflatex_check_fallback:
  {
    \bool_lazy_and:nnT { \g__cfflatex_check_document_bool }
      { ! \g__cfflatex_check_done_bool }
      {
        \bool_lazy_and:nnT { \g__cfflatex_loaded_bool }
          { ! \seq_if_empty_p:N \g__cfflatex_check_regions_seq }
          {
            \msg_info:nne { import-citation-cff } { check-fallback }
              { \tl_use:N \g__cfflatex_check_style_tl }
          }
        \__cfflatex_region_end:n { document }
      }
  }
\AddToHook {enddocument} [import-citation-cff] {\__cfflatex_check_fallback:}
% hyperref drops the markers from PDF strings, such as bookmarks.
\AddToHook {begindocument} [import-citation-cff]
  {
    \cs_if_exist:NT \pdfstringdefDisableCommands
      {
        \pdfstringdefDisableCommands
          {
            \cs_set_eq:cN { cfflatex@mark } \use_none:n
            \cs_set_eq:cN { cfflatex@part } \use_none:n
          }
      }
  }

% Getters --------------------------------------------------------------------

% Expands to the value stored under the key #1, or to nothing if it is absent.
\cs_new:Npn \__cfflatex_value:n #1
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      { \prop_item:Nn \g__cfflatex_values_prop {#1} }
      { \msg_expandable_error:nn { import-citation-cff } { not-loaded } }
  }

% Expands to #2 if a CFF file is loaded and #1 is the index of an author, and
% reports an error otherwise.
\cs_new:Npn \__cfflatex_if_author:nT #1#2
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      {
        \bool_lazy_or:nnTF { \int_compare_p:nNn {#1} < { 1 } }
          { \int_compare_p:nNn {#1} > { \g__cfflatex_author_count_int } }
          {
            \msg_expandable_error:nnn { import-citation-cff } { author-index }
              {#1}
          }
          {#2}
      }
      { \msg_expandable_error:nn { import-citation-cff } { not-loaded } }
  }

% \cffauthor{<index>}{<field>} expands to a field of the <index>-th author,
% counting from 1. An absent field expands to nothing.
\cs_generate_variant:Nn \prop_item:Nn { Ne }
\NewExpandableDocumentCommand \cffauthor {m m}
  {
    \__cfflatex_if_author:nT {#1}
      {
        \__cfflatex_mark:e { \int_eval:n {#1} }
        \prop_item:Ne \g__cfflatex_values_prop
          { authors / \int_eval:n {#1} / \tl_to_str:n {#2} }
      }
  }

% Any field ------------------------------------------------------------------
%
% \cff{<path>} expands to the value at <path>, the keys and indices that lead
% to it from the citation, separated by slashes, such as authors/1/name. A
% missing path expands to nothing, and a mapping or a sequence is an error.
% \cffcount{<path>} expands to the length of the sequence at <path>, 0 if it
% is missing; a value or a mapping is an error. \cff{<path>} counts for the
% check as a use of <path>, such as title, and \cff{authors/<i>/<field>} as a
% use of author <i>, like \cffauthor.
% The path is expanded first, so that it may contain \cffauthorindex.
\NewExpandableDocumentCommand \cff {m} {\exp_args:Ne \__cfflatex_cff:n {#1}}
\NewExpandableDocumentCommand \cffcount {m}
  {\exp_args:Ne \__cfflatex_cffcount:n {#1}}
\cs_new:Npn \__cfflatex_cff:n #1
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      {
        \prop_if_in:NnTF \g__cfflatex_fields_prop {#1}
          {
            \__cfflatex_path_mark:n {#1}
            \prop_item:Nn \g__cfflatex_fields_prop {#1}
          }
          {
            \prop_if_in:NnT \g__cfflatex_kinds_prop {#1}
              {
                \msg_expandable_error:nnn { import-citation-cff }
                  { not-a-value }
                  {#1}
              }
          }
      }
      { \msg_expandable_error:nn { import-citation-cff } { not-loaded } }
  }
\cs_new:Npn \__cfflatex_cffcount:n #1

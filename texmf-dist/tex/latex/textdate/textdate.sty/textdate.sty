        \textdate_extract_check_first:
      }
      {
        \msg_error:nnx
          { textdate }
          { invalid-date-format }
          { \l_textdate_input_tl }
      }
  }

\cs_new_protected:Npn \textdate_extract_check_first:
  {
    \tl_set:Nx \l_tmpa_tl
      {
        \seq_item:Nn \l_textdate_date_seq { 1 }
      }

\regex_match:nVTF
  { \A\d{4}\Z }
  \l_tmpa_tl
  {
    \textdate_extract_ymd:
  }
  {
    \textdate_extract_dmy:
  }
  }


\cs_new_protected:Npn \textdate_extract_ymd:
  {
    \tl_set:Nx \l_textdate_year_tl
      {
        \seq_item:Nn \l_textdate_date_seq { 1 }
      }

    \tl_set:Nx \l_textdate_month_tl

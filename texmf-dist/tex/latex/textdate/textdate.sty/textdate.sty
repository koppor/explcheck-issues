      }

    \textdate_validate:
  }

\cs_new_protected:Npn \textdate_extract_dmy:
  {
    \tl_set:Nx \l_tmpa_tl
      {
        \GetTranslation{textdate-date-order}
      }

    \tl_if_eq:VnTF
      \l_tmpa_tl
      { DMY }
      {
        \tl_set:Nx \l_textdate_day_tl
          {
            \seq_item:Nn \l_textdate_date_seq { 1 }
          }

        \tl_set:Nx \l_textdate_month_tl
          {
            \seq_item:Nn \l_textdate_date_seq { 2 }
          }

        \tl_set:Nx \l_textdate_year_tl
          {
            \seq_item:Nn \l_textdate_date_seq { 3 }
          }

        \textdate_validate:
      }
      {
        \msg_error:nnx
          { textdate }
          { invalid-date-format }
          { \l_textdate_input_tl }
      }
  }


\cs_new_protected:Npn \textdate_validate:
  {
    \regex_match:nVTF
      { \A\d+\Z }
      \l_textdate_year_tl
      {
        \regex_match:nVTF
          { \A\d+\Z }
          \l_textdate_month_tl
          {
            \regex_match:nVTF
              { \A\d+\Z }
              \l_textdate_day_tl
              {
                \int_set:Nn \l_textdate_month_int
                  { \l_textdate_month_tl }

                \int_set:Nn \l_textdate_day_int
                  { \l_textdate_day_tl }

                \int_compare:nNnTF
                  { \l_textdate_month_int }
                  <
                  { 1 }
                  {
                    \msg_error:nnx
                      { textdate }
                      { invalid-date-value }
                      { \l_textdate_input_tl }
                  }
                  {
                    \int_compare:nNnTF
                      { \l_textdate_month_int }
                      >
                      { 12 }
                      {
                        \msg_error:nnx
                          { textdate }
                          { invalid-date-value }
                          { \l_textdate_input_tl }
                      }
                      {
                        \int_compare:nNnTF
                          { \l_textdate_day_int }
                          <
                          { 1 }
                          {
                            \msg_error:nnx
                              { textdate }
                              { invalid-date-value }
                              { \l_textdate_input_tl }
                          }
                          {
                            \int_compare:nNnTF
                              { \l_textdate_day_int }
                              >
                              { 31 }
                              {
                                \msg_error:nnx
                                  { textdate }
                                  { invalid-date-value }
                                  { \l_textdate_input_tl }
                              }
                              {
                                \textdate_print:
                              }
                          }
                      }
                  }
              }
              {
                \msg_error:nnx
                  { textdate }
                  { invalid-date-format }
                  { \l_textdate_input_tl }
              }
          }
          {
            \msg_error:nnx
              { textdate }
              { invalid-date-format }
              { \l_textdate_input_tl }
          }
      }
      {
        \msg_error:nnx
          { textdate }
          { invalid-date-format }
          { \l_textdate_input_tl }
      }
  }


\cs_new:Npn \textdate_month_key:n #1
  {
    \int_case:nnF { #1 }
      {
        { 1 }  { january }
        { 2 }  { february }
        { 3 }  { march }
        { 4 }  { april }
        { 5 }  { may }
        { 6 }  { june }
        { 7 }  { july }
        { 8 }  { august }
        { 9 }  { september }
        { 10 } { october }
        { 11 } { november }
        { 12 } { december }
      }
      { }
  }

\cs_new_protected:Npn \textdate_print:
  {
    \tl_set:Nx \l_textdate_month_key_tl
      {
        textdate-
        \textdate_month_key:n
          { \l_textdate_month_int }
      }

    \group_begin:

      \cs_set:Npx \textdate@day
        {
          \int_eval:n { \l_textdate_day_tl }
          \int_compare:nNnT { \l_textdate_day_tl } = { 1 }
            {
              \str_case_e:nn { \languagename }
                {
                  {french} {\exp_not:N \textsuperscript{er}}
                  {italian} {°}
                }
            }
        }

      \cs_set:Npx \textdate@year
        {
          \l_textdate_year_tl
        }

      \cs_set:Npx \textdate@month
        {
          \exp_args:NV \GetTranslation
            \l_textdate_month_key_tl
        }

      \GetTranslation{textdate-format}

    \group_end:
  }


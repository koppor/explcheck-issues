\cs_new_protected:Npn \textdate_parse:n #1
  {
    \tl_set:Nx \l_textdate_input_tl { #1 }

    \regex_replace_all:nnN
      { / }
      { - }
      \l_textdate_input_tl

    \seq_set_split:NnV
      \l_textdate_date_seq
      { - }
      \l_textdate_input_tl

    \textdate_extract:
  }

\cs_new_protected:Npn \textdate_extract:
  {
    \int_compare:nNnTF
      { \seq_count:N \l_textdate_date_seq }
      =
      { 3 }

%KERNEL DE CALCULO EN Lua (kernel = lua). LA INTERFAZ ESTA DESCRIPTA EN pgf-go-kernel.sty.
%EL CALCULO ESTA EN pgf-go.lua; ACA SOLO SE LE PASAN LAS ENTRADAS.
\clist_gset:Nn \g_pgfgo_kernel_features_clist {captures, territory, sgf}

%NOMBRE COMPLETO DEL ARCHIVO #2 DEL PAQUETE, EN #1: SE BUSCA JUNTO A pgf-go.sty Y, SI NO ESTA AHI, EN
%EL PATH DE TeX CON kpse (INSTALADO, \file_full_name:n DEVUELVE EL NOMBRE SIN LA CARPETA Y dofile NO LO
%ENCUENTRA). PRIMERO COMO tex, LA MISMA BUSQUEDA QUE ENCONTRO pgf-go.sty: COMO lua PUEDE APARECER OTRA
%COPIA (POR EJ. CON TEXINPUTS).
\cs_new_protected:Npn \__pgfgo_kernel_lua_find:Nn #1#2 {
	\tl_clear:N #1
	\tl_if_empty:NF \c__pgfgo_path_tl {\tl_set:Ne #1 {\file_full_name:n {\c__pgfgo_path_tl / #2}}}
	\tl_if_empty:NT #1 {
		\tl_set:Ne #1 {\lua_now:e {
			tex.sprint(-2,~kpse.find_file("#2",~"tex")~or~kpse.find_file("#2",~"lua")~or~"#2")
		}}
	}
}

\tl_new:N \l__pgfgo_kernel_lua_file_tl
\__pgfgo_kernel_lua_find:Nn \l__pgfgo_kernel_lua_file_tl {pgf-go.lua}
\lua_now:e {pgfgo~=~dofile("\lua_escape:e {\l__pgfgo_kernel_lua_file_tl}")}

%LAS TABLAS DE LAS CODIFICACIONES ASIATICAS: Lua LAS CARGA SOLO SI HACEN FALTA.
\__pgfgo_kernel_lua_find:Nn \l__pgfgo_kernel_lua_file_tl {pgf-go-charsets.lua}
\lua_now:e {pgfgo.charsets_file~=~"\lua_escape:e {\l__pgfgo_kernel_lua_file_tl}"}

%UN BOOLEANO COMO ARGUMENTO DE Lua.
\cs_new:Npn \__pgfgo_kernel_lua_bool:N #1 {\bool_if:NTF #1 {true} {false}}
\cs_new:Npn \__pgfgo_kernel_lua_use_i: {\__pgfgo_kernel_lua_bool:N \l_pgfgo_use_i_bool}



%AL CERRAR EL goban: EL RELLENO DE CADA REGION, RECORTADO A LA CUADRICULA VISIBLE, EN LA CAPA DEL
%TERRITORIO; EL CONTORNO Y LOS VERTICES, RECORTADOS COMO LA CUADRICULA CON partial, EN LA CAPA DE LAS
%MARCAS (above) O EN LA DEL TERRITORIO.
\cs_new_protected:Npn \pgfgo_territory_end: {
	\clist_map_inline:nn {black, white} {
		\seq_if_empty:cF {g__pgfgo_territory_region_ ##1 _seq} {\__pgfgo_territory_region_draw:n {##1}}
	}
}

\cs_new_protected:Npn \__pgfgo_territory_region_draw:n #1 {
	\prop_set_eq:Nc \l__pgfgo_territory_region_style_prop {g__pgfgo_territory_region_ #1 _style_prop}
	\bool_if:nT {\__pgfgo_territory_style_p:n {fill}} {
		\pgfonlayer{pgfgo_layer_territory}
		\pgfscope
			\__pgfgo_territory_clip:n {0}
			\pgfsetfillopacity{\__pgfgo_territory_style:n {fill~opacity}}
			\pgfgo_fill:neee {\__pgfgo_territory_region_path:n {#1}}
				{\__pgfgo_territory_style:n {fill~color}}
				{\__pgfgo_territory_style:n {fill~pattern}}
				{\__pgfgo_territory_style:n {fill~pattern~color}}
		\endpgfscope
		\endpgfonlayer
	}
	\bool_lazy_or:nnT {\__pgfgo_territory_style_p:n {line}} {\__pgfgo_territory_style_p:n {vertices}}
		{
			\tl_set:Ne \l_tmpa_tl {
				\bool_if:nTF {\__pgfgo_territory_style_p:n {above}}
					{pgfgo_layer_mark} {pgfgo_layer_territory}
			}
			\exp_args:NV \pgfonlayer \l_tmpa_tl
			\pgfscope
				\__pgfgo_territory_clip:n {0.5}
				\bool_if:nT {\__pgfgo_territory_style_p:n {line}} {
					\pgfscope
						\__pgfgo_territory_region_path:n {#1}
						\pgfsetstrokecolor{\__pgfgo_territory_style:n {line~color}}
						\pgfsetstrokeopacity{\__pgfgo_territory_style:n {line~opacity}}
						\pgfgo_goban_line_width:n {\__pgfgo_territory_style:n {line~width}}
						\pgfusepath{stroke}
					\endpgfscope
				}
				\bool_if:nT {\__pgfgo_territory_style_p:n {vertices}} {
					\seq_map_inline:cn {g__pgfgo_territory_region_ #1 _seq} {
						\clist_map_inline:nn {##1} {\__pgfgo_territory_region_dot:nn ####1}
					}
					\pgfsetfillcolor{\__pgfgo_territory_style:n {vertices~color}}
					\pgfsetfillopacity{\__pgfgo_territory_style:n {line~opacity}}
					\pgfusepath{fill}
				}
			\endpgfscope
			\endpgfonlayer
		}
}

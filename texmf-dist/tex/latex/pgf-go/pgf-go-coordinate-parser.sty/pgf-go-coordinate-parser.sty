%NO HAY ESPACIOS AL PRINCIPIO Y AL FINAL PORQUE SE ELIMINAN AL SEPARAR LA clist.
%TRAMOS.
\regex_const:Nn \c__pgfgo_coordinate_LN_regex 		{\A([A-Z]{1,2})(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_LLN_regex 		{\A([A-Z]{1,2}):([A-Z]{1,2})\s*(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_LNN_regex 		{\A([A-Z]{1,2})\s*(\d{1,2}):(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_LNLN_regex 	{\A([A-Z]{1,2})(\d{1,2}):([A-Z]{1,2})(\d{1,2})\Z}
%LO QUE VA SOLO.
\regex_const:Nn \c__pgfgo_coordinate_all_regex 		{\A\*\Z}
\regex_const:Nn \c__pgfgo_coordinate_L_regex 		{\A([A-Z]{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_N_regex 		{\A(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_LL_regex 		{\A([A-Z]{1,2}):([A-Z]{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_NN_regex 		{\A(\d{1,2}):(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_LLNN_regex 	{\A([A-Z]{1,2}):([A-Z]{1,2})\s*(\d{1,2}):(\d{1,2})\Z}
%LOS OPERADORES, EN EL ORDEN EN QUE SE PRUEBAN (COMO EN pgf-go.lua).
\regex_const:Nn \c__pgfgo_coordinate_link_regex 	{\s*(-\|-|\|-\||--|-\||\|-|r)\s*}

\tl_new:N \l__pgfgo_coordinate_subset_tl
\seq_new:N \l__pgfgo_coordinate_match_seq
\tl_new:N \l__pgfgo_coordinate_match_tl
\seq_new:N \l__pgfgo_coordinate_parts_seq
\seq_new:N \l__pgfgo_coordinate_corners_seq
\seq_new:N \l__pgfgo_coordinate_links_seq
\tl_new:N \l__pgfgo_coordinate_corners_tl
\tl_new:N \l__pgfgo_coordinate_from_tl
\tl_new:N \l__pgfgo_coordinate_to_tl
\int_new:N \l__pgfgo_coordinate_part_int
\bool_new:N \l__pgfgo_coordinate_chain_bool

%DEJA EN \l__pgfgo_coordinate_corners_tl LAS ESQUINAS {x1}{y1}{x2}{y2} DEL TRAMO #1 (VACIO SI NO ES UN TRAMO).
\cs_new_protected:Npn \__pgfgo_coordinate_corners:n #1 {
	\tl_clear:N \l__pgfgo_coordinate_corners_tl
	\__pgfgo_coordinate_corners:Nnnnnn \c__pgfgo_coordinate_LN_regex {#1} {2} {3} {2} {3}
	\__pgfgo_coordinate_corners:Nnnnnn \c__pgfgo_coordinate_LLN_regex {#1} {2} {4} {3} {4}
	\__pgfgo_coordinate_corners:Nnnnnn \c__pgfgo_coordinate_LNN_regex {#1} {2} {3} {2} {4}
	\__pgfgo_coordinate_corners:Nnnnnn \c__pgfgo_coordinate_LNLN_regex {#1} {2} {3} {4} {5}
}
%SI #2 COINCIDE CON #1, LAS ESQUINAS SON LOS GRUPOS #3 (LETRA), #4, #5 (LETRA) Y #6 (CONTANDO LA COINCIDENCIA
%COMPLETA COMO 1).
\cs_new_protected:Npn \__pgfgo_coordinate_corners:Nnnnnn #1#2#3#4#5#6 {
	\tl_if_empty:NT \l__pgfgo_coordinate_corners_tl {
		\regex_extract_once:NnNT #1 {#2} \l__pgfgo_coordinate_match_seq {
			\tl_set:Ne \l__pgfgo_coordinate_corners_tl {
				{\__pgfgo_coordinate_column:e {\seq_item:Nn \l__pgfgo_coordinate_match_seq {#3}}}
				{\int_eval:n {\seq_item:Nn \l__pgfgo_coordinate_match_seq {#4}}}
				{\__pgfgo_coordinate_column:e {\seq_item:Nn \l__pgfgo_coordinate_match_seq {#5}}}
				{\int_eval:n {\seq_item:Nn \l__pgfgo_coordinate_match_seq {#6}}}
			}
		}
	}
}

%UN ELEMENTO (LO QUE ESTA ENTRE DOS COMAS). SE PARTE EN TRAMOS Y OPERADORES (A1 -| C3 -- E3 ES A1, -|, C3,
%--, E3). CADA OPERADOR VA DEL ULTIMO PUNTO DE UN TRAMO AL PRIMERO DEL SIGUIENTE, Y EL PUNTO QUE COMPARTEN VA
%UNA SOLA VEZ. SI NO ES UNA CADENA, PUEDE SER ALGO QUE VA SOLO.
\cs_new_protected:Npn \__pgfgo_coordinate_item:n #1 {
	\bool_set_true:N \l__pgfgo_coordinate_ordered_bool
	\bool_set_false:N \l__pgfgo_coordinate_skip_bool
	\bool_set_true:N \l__pgfgo_coordinate_chain_bool
	\seq_clear:N \l__pgfgo_coordinate_corners_seq
	\seq_clear:N \l__pgfgo_coordinate_links_seq
	\int_zero:N \l__pgfgo_coordinate_part_int
	%SIN -, | NI r NO HAY OPERADORES: UN SOLO TRAMO, SIN LA REGEX (EL CASO DE CASI TODOS LOS ELEMENTOS).
	\str_if_in:nnTF {#1} {-} {\__pgfgo_coordinate_split:n {#1}} {
		\str_if_in:nnTF {#1} {|} {\__pgfgo_coordinate_split:n {#1}} {
			\str_if_in:nnTF {#1} {r} {\__pgfgo_coordinate_split:n {#1}} {
				\seq_clear:N \l__pgfgo_coordinate_parts_seq
				\seq_put_right:Nn \l__pgfgo_coordinate_parts_seq {#1}
			}
		}
	}
	\seq_map_inline:Nn \l__pgfgo_coordinate_parts_seq {
		\int_incr:N \l__pgfgo_coordinate_part_int
		\int_if_odd:nTF {\l__pgfgo_coordinate_part_int} {
			\__pgfgo_coordinate_corners:n {##1}
			\tl_if_empty:NTF \l__pgfgo_coordinate_corners_tl
				{\bool_set_false:N \l__pgfgo_coordinate_chain_bool}
				{\seq_put_right:NV \l__pgfgo_coordinate_corners_seq \l__pgfgo_coordinate_corners_tl}
		} {\seq_put_right:Nn \l__pgfgo_coordinate_links_seq {##1}}
	}
	\int_if_odd:nF {\l__pgfgo_coordinate_part_int} {\bool_set_false:N \l__pgfgo_coordinate_chain_bool}
	\bool_if:NTF \l__pgfgo_coordinate_chain_bool
		{\__pgfgo_coordinate_chain:}
		{
			\int_compare:nNnTF {\l__pgfgo_coordinate_part_int} = {1}
				{\__pgfgo_coordinate_alone:n {#1}}
				{\msg_warning:nnn {pgfgo} {unknown-coordinate} {#1}}
		}
	\bool_if:NF \l__pgfgo_coordinate_ordered_bool {
		\bool_if:NF \l__pgfgo_coordinate_subtract_bool {\bool_set_false:N \l__pgfgo_coordinate_all_ordered_bool}
	}
}

\cs_new_protected:Npn \__pgfgo_coordinate_split:n #1 {
	\regex_split:NnN \c__pgfgo_coordinate_link_regex {#1} \l__pgfgo_coordinate_parts_seq
}

\cs_new_protected:Npn \__pgfgo_coordinate_chain: {
	\seq_pop_left:NN \l__pgfgo_coordinate_corners_seq \l__pgfgo_coordinate_from_tl
	\exp_last_unbraced:NV \__pgfgo_coordinate_piece:nnnn \l__pgfgo_coordinate_from_tl
	\seq_map_inline:Nn \l__pgfgo_coordinate_links_seq {
		\seq_pop_left:NN \l__pgfgo_coordinate_corners_seq \l__pgfgo_coordinate_to_tl
		\bool_set_true:N \l__pgfgo_coordinate_skip_bool
		\use:e {
			\exp_not:N \__pgfgo_coordinate_link:nnnnn {##1}
			\exp_last_unbraced:NV \__pgfgo_coordinate_last:nnnn \l__pgfgo_coordinate_from_tl
			\exp_last_unbraced:NV \__pgfgo_coordinate_first:nnnn \l__pgfgo_coordinate_to_tl
		}
		\bool_set_true:N \l__pgfgo_coordinate_skip_bool
		\exp_last_unbraced:NV \__pgfgo_coordinate_piece:nnnn \l__pgfgo_coordinate_to_tl
		\tl_set_eq:NN \l__pgfgo_coordinate_from_tl \l__pgfgo_coordinate_to_tl
	}
}
\cs_new:Npn \__pgfgo_coordinate_first:nnnn #1#2#3#4 {{#1}{#2}}
\cs_new:Npn \__pgfgo_coordinate_last:nnnn #1#2#3#4 {{#3}{#4}}

%LAS FORMAS SE PRUEBAN EN ORDEN Y LA PRIMERA QUE COINCIDE CORTA CON \prg_break:.
\cs_new_protected:Npn \__pgfgo_coordinate_alone:n #1 {
	\tl_set:Nn \l__pgfgo_coordinate_subset_tl {#1}
	\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_LLNN_regex \__pgfgo_coordinate_LLNN:nnnn
	\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_LL_regex \__pgfgo_coordinate_LL:nn
	\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_NN_regex \__pgfgo_coordinate_NN:nn
	\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_L_regex \__pgfgo_coordinate_L:n
	\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_N_regex \__pgfgo_coordinate_N:n
	\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_all_regex \__pgfgo_coordinate_all:
	\msg_warning:nnV {pgfgo} {unknown-coordinate} \l__pgfgo_coordinate_subset_tl
	\prg_break_point:
}

%SI EL ELEMENTO COINCIDE CON LA EXPRESION #1, LLAMA A #2 CON SUS GRUPOS Y TERMINA.
\cs_new_protected:Npn \__pgfgo_coordinate_try:NN #1#2 {
	\regex_extract_once:NVNT #1 \l__pgfgo_coordinate_subset_tl \l__pgfgo_coordinate_match_seq {
		\seq_pop_left:NN \l__pgfgo_coordinate_match_seq \l__pgfgo_coordinate_match_tl
		\use:e {\exp_not:N #2 \seq_map_function:NN \l__pgfgo_coordinate_match_seq \__pgfgo_coordinate_brace:n}
		\prg_break:
	}
}
\cs_new:Npn \__pgfgo_coordinate_brace:n #1 {{\exp_not:n {#1}}}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%GRUPOS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%CORCHETES: [...][...], L[...] Y [...]N. SE REPARTEN EN SU LUGAR: A[1:3, 5] ES A1:3, A5.
\regex_const:Nn \c__pgfgo_coordinate_brackets_both_regex {\[([^\]]*)\]\[([^\]]*)\]}
\regex_const:Nn \c__pgfgo_coordinate_brackets_numbers_regex {([A-Z]{1,2})\[([^\]]*)\]}
\regex_const:Nn \c__pgfgo_coordinate_brackets_letters_regex {\[([^\]]*)\](\d{1,2})}

\tl_new:N \l__pgfgo_coordinate_group_tl
\seq_new:N \l__pgfgo_coordinate_subsets_seq
\seq_new:N \l__pgfgo_coordinate_brackets_seq
\tl_new:N \l__pgfgo_coordinate_a_tl
\tl_new:N \l__pgfgo_coordinate_b_tl

\cs_new_protected:Npn \__pgfgo_coordinate_group:n #1 {
	\tl_set:Nn \l__pgfgo_coordinate_group_tl {#1}
	\str_if_in:NnT \l__pgfgo_coordinate_group_tl {[} {
		\__pgfgo_coordinate_brackets:NN \c__pgfgo_coordinate_brackets_both_regex \__pgfgo_coordinate_both:nn
		\__pgfgo_coordinate_brackets:NN \c__pgfgo_coordinate_brackets_numbers_regex \__pgfgo_coordinate_numbers:nn
		\__pgfgo_coordinate_brackets:NN \c__pgfgo_coordinate_brackets_letters_regex \__pgfgo_coordinate_letters:nn
	}
	\seq_set_from_clist:NV \l__pgfgo_coordinate_subsets_seq \l__pgfgo_coordinate_group_tl
	\seq_map_function:NN \l__pgfgo_coordinate_subsets_seq \__pgfgo_coordinate_item:n
}
\cs_generate_variant:Nn \seq_set_from_clist:Nn {NV}

%CAMBIA CADA COINCIDENCIA DE #1 POR LOS ELEMENTOS QUE #2 DEJA EN \l__pgfgo_coordinate_brackets_seq A PARTIR
%DE SUS DOS GRUPOS, SEPARADOS POR COMAS. LA PRIMERA APARICION DEL TEXTO ES LA COINCIDENCIA.
\cs_new_protected:Npn \__pgfgo_coordinate_brackets:NN #1#2 {
	\regex_extract_once:NVNT #1 \l__pgfgo_coordinate_group_tl \l__pgfgo_coordinate_match_seq {
		\seq_pop_left:NN \l__pgfgo_coordinate_match_seq \l__pgfgo_coordinate_match_tl
		\seq_pop_left:NN \l__pgfgo_coordinate_match_seq \l__pgfgo_coordinate_a_tl
		\seq_pop_left:NN \l__pgfgo_coordinate_match_seq \l__pgfgo_coordinate_b_tl
		\seq_clear:N \l__pgfgo_coordinate_brackets_seq
		\exp_args:NVV #2 \l__pgfgo_coordinate_a_tl \l__pgfgo_coordinate_b_tl
		\tl_replace_once:NVe \l__pgfgo_coordinate_group_tl \l__pgfgo_coordinate_match_tl
			{\seq_use:Nn \l__pgfgo_coordinate_brackets_seq {,~}}
		\__pgfgo_coordinate_brackets:NN #1#2
	}
}
\cs_generate_variant:Nn \tl_replace_once:Nnn {NVe}
%[A, B][1, 2]
\cs_new_protected:Npn \__pgfgo_coordinate_both:nn #1#2 {
	\clist_map_inline:nn {#1} {
		\clist_map_inline:nn {#2} {\seq_put_right:Nn \l__pgfgo_coordinate_brackets_seq {##1 ####1}}
	}
}
%A[1, 2]
\cs_new_protected:Npn \__pgfgo_coordinate_numbers:nn #1#2 {
	\clist_map_inline:nn {#2} {\seq_put_right:Nn \l__pgfgo_coordinate_brackets_seq {#1 ##1}}
}
%[A, B]1
\cs_new_protected:Npn \__pgfgo_coordinate_letters:nn #1#2 {
	\clist_map_inline:nn {#1} {\seq_put_right:Nn \l__pgfgo_coordinate_brackets_seq {##1 #2}}
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%COORDENADAS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%DEJA EN #2 LAS INTERSECCIONES {x}{y} DE LAS COORDENADAS #1, SIN REPETIR, Y EN #3 SI TODO LO QUE SUMA
%TIENE UN ORDEN FIJO.
\seq_new:N \l__pgfgo_coordinate_groups_seq
\cs_new_protected:Npn \__pgfgo_coordinate_points:nNN #1#2#3 {
	\__pgfgo_coordinate_run:nNN {
		\bool_set_false:N \l__pgfgo_coordinate_moves_bool
		\seq_set_split:Nnn \l__pgfgo_coordinate_groups_seq {;} {#1}
		\seq_map_inline:Nn \l__pgfgo_coordinate_groups_seq {
			\__pgfgo_coordinate_group:n {##1}
			\bool_set_inverse:N \l__pgfgo_coordinate_subtract_bool
		}
	} #2 #3
}
%LO MISMO PARA LAS JUGADAS DE \moves: UN SOLO GRUPO, CON REPETICIONES.
\cs_new_protected:Npn \__pgfgo_coordinate_moves:nNN #1#2#3 {
	\__pgfgo_coordinate_run:nNN {
		\bool_set_true:N \l__pgfgo_coordinate_moves_bool
		\__pgfgo_coordinate_group:n {#1}
	} #2 #3
}
\cs_new_protected:Npn \__pgfgo_coordinate_run:nNN #1#2#3 {
	\group_begin:
		\int_zero:N \l__pgfgo_coordinate_count_int
		\bool_set_false:N \l__pgfgo_coordinate_subtract_bool
		\bool_set_true:N \l__pgfgo_coordinate_all_ordered_bool
		#1
		\tl_set:Ne \l__pgfgo_coordinate_items_tl
			{\int_step_function:nN {\l__pgfgo_coordinate_count_int} \__pgfgo_coordinate_slot:n}
	\use:e {
		\group_end:
		\seq_set_from_clist:Nn \exp_not:N #2 {\exp_not:V \l__pgfgo_coordinate_items_tl}
		\bool_if:NTF \l__pgfgo_coordinate_all_ordered_bool {\bool_set_true:N} {\bool_set_false:N} \exp_not:N #3
	}
}

\ExplSyntaxOff

%\pgfgodefinemark{<nombre>}{<codigo pgf>} O \pgfgodefinemark[image = {file = <archivos>, width = <dim>}]{<nombre>}
%DEFINE UNA MARCA QUE SE USA COMO LAS DEMAS (\marks[<nombre>], players/<jugador>/mark, territory/mark).
%EL CODIGO SE DIBUJA CENTRADO EN EL PUNTO, CON EL RADIO DE LA PIEDRA COMO UNIDAD DE LAS COORDENADAS SIN
%UNIDAD, Y CON LOS COLORES pgfgomarkline Y pgfgomarkfill (mark/line Y mark/fill DEL JUGADOR).
\tl_new:N \l__pgfgo_mark_define_image_tl
\tl_new:N \l__pgfgo_mark_define_width_tl
\keys_define:nn {pgfgo / define mark} {
	image		.code:n		= {\keys_set:nn {pgfgo / define mark / image} {#1}},
}
\keys_define:nn {pgfgo / define mark / image} {
	file		.tl_set:N	= \l__pgfgo_mark_define_image_tl,
	width		.tl_set:N	= \l__pgfgo_mark_define_width_tl,
}

\NewDocumentCommand \pgfgodefinemark {om} {
	\group_begin:
		\tl_clear:N \l__pgfgo_mark_define_image_tl
		\tl_clear:N \l__pgfgo_mark_define_width_tl
		\IfValueT {#1} {\keys_set:nn {pgfgo / define mark} {#1}}
		\tl_if_empty:NTF \l__pgfgo_mark_define_image_tl
			{\group_end: \__pgfgo_mark_define_code:nn {#2}}
			{
				%EL ANCHO SE MIDE AHORA, CON LA FUENTE DEL TEXTO: EN LA FIGURA LA FUENTE ES \nullfont Y em VALE 0.
				\cs_gset:cpe {__pgfgo_mark_user_ #2 :} {
					\exp_not:N \__pgfgo_mark_image:nn
						{\exp_not:V \l__pgfgo_mark_define_image_tl}
						{\tl_if_blank:VF \l__pgfgo_mark_define_width_tl {\dim_eval:n {\l__pgfgo_mark_define_width_tl}}}
				}
				\group_end:
				\__pgfgo_mark_define_key:n {#2}
			}
}

\cs_new_protected:Npn \__pgfgo_mark_define_code:nn #1#2 {
	\cs_gset:cpn {__pgfgo_mark_user_ #1 :} {\__pgfgo_mark_code:n {#2}}
	\__pgfgo_mark_define_key:n {#1}
}

\cs_new_protected:Npn \__pgfgo_mark_define_key:n #1 {
	\__pgfgo_mark_shape_function:n {__pgfgo_mark_user_ #1 :}
	\__pgfgo_mark_shape_key:nn {#1} {\cs_set_eq:Nc \pgfgo_mark_current: {__pgfgo_mark_user_ #1 :}}
}

\cs_new_protected:Npn \__pgfgo_mark_code:n #1 {
	\pgfscope
		\pgfsetxvec{\pgfpoint{\l_pgfgo_players_stone_radius_dim}{0pt}}
		\pgfsetyvec{\pgfpoint{0pt}{\l_pgfgo_players_stone_radius_dim}}
		\colorlet{pgfgomarkline}{\l_pgfgo_players_mark_line_color_tl}
		\colorlet{pgfgomarkfill}{\l_pgfgo_players_mark_fill_color_tl}
		\pgfsetstrokecolor{pgfgomarkline}
		\pgfsetfillcolor{pgfgomarkfill}
		\__pgfgo_mark_opacity:NN \pgfsetstrokeopacity \l_pgfgo_players_mark_line_opacity_tl
		\__pgfgo_mark_opacity:NN \pgfsetfillopacity \l_pgfgo_players_mark_fill_opacity_tl
		\pgfsetlinewidth{\l_pgfgo_players_mark_line_width_dim}
		#1
	\endpgfscope
}

%SIN width, 1.2 VECES EL RADIO DE LA PIEDRA (COMO EL CIRCULO). CON width, POR mark/scale. CON VARIOS
%ARCHIVOS (#1 ES UNA LISTA), CADA PUNTO ELIGE UNO COMO LAS PIEDRAS: SIEMPRE EL MISMO EN EL MISMO PUNTO.
\tl_new:N \l__pgfgo_mark_image_file_tl
\cs_new_protected:Npn \__pgfgo_mark_image:nn #1#2 {
	\tl_set:Ne \l__pgfgo_mark_image_file_tl {
		\clist_item:nn {#1}
			{\pgfgo_image_pick:nnn {\l__pgfgo_mark_x_tl} {\l__pgfgo_mark_y_tl} {\clist_count:n {#1}}}
	}
	\pgfgo_image_load:Ve \l__pgfgo_mark_image_file_tl {
		width = \tl_if_blank:nTF {#2}
			{\dim_eval:n {1.2 \l_pgfgo_players_stone_radius_dim}}
			{
				\fp_compare:nNnTF {\l_pgfgo_players_mark_scale_fp} = {1}
					{\dim_eval:n {#2}}
					{\fp_to_dim:n {\l_pgfgo_players_mark_scale_fp * (\dim_eval:n {#2})}}
			}
	}
	\pgfgo_image_draw:
}




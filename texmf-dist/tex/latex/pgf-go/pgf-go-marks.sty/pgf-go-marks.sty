%SOLO SE DIBUJA SI ESTA EN LA PARTE VISIBLE DEL TABLERO. CON goban/captured marks = remove, UNA MARCA
%SOBRE UNA PIEDRA SE GUARDA CON LA PIEDRA (VER pgf-go-stones.sty), PARA QUE DESAPAREZCA SI LA CAPTURAN.
%#4: EL CODIGO QUE LA DIBUJA AHORA. UNA MARCA QUE NO SE VE AVANZA IGUAL LA SECUENCIA (EN UN partial O
%EN UNA VISTA, LAS LETRAS SON LAS DEL TABLERO ENTERO).
\cs_new_protected:Npn\__pgfgo_mark_at:nnnn #1#2#3#4 {
	\pgfgo_kernel_if_visible:nnTF {#2} {#3} {
		\bool_lazy_and:nnTF {\l_pgfgo_goban_captures_bool} {\l_pgfgo_goban_captured_marks_bool}
			{\pgfgo_kernel_board_if_occupied:nnTF {#2} {#3} {\pgfgo_captures_mark:nnn {#1} {#2} {#3}} {#4}}
			{#4}
	} {\pgfgo_mark_step:n {#1}}
}
\cs_new_protected:Npn\pgfgo_mark:nnn #1#2#3 {
	\__pgfgo_mark_at:nnnn {#1} {#2} {#3} {\__pgfgo_mark_draw:nnn {#1} {#2} {#3}}
}
\cs_generate_variant:Nn\pgfgo_mark:nnn  {nee}
\cs_new:Nn \pgfgo_mark:nn {\pgfgo_mark:nnn{#1}#2}
\cs_generate_variant:Nn\pgfgo_mark:nn {nV}

%EL JUGADOR (POR DEFECTO, EL DE AHORA) Y SU ESTILO DE MARCA, CON LAS OPCIONES #1. LAS DEMAS CLAVES (LA
%FORMA, custom) LAS PASA pgfgo/players/<jugador>/mark A pgfgo/mark.
%DENTRO DE \pgfgo_marks_parsed:nn LAS OPCIONES YA ESTAN PUESTAS (\l__pgfgo_mark_ready_bool).
\bool_new:N \l__pgfgo_mark_ready_bool
\cs_new_protected:Npn\__pgfgo_mark_setup:n #1 {
	\keys_set_groups:nnn{ pgfgo / mark }{ player-id }{#1}
	\bool_set_true:N \l_pgfgo_players_mark_options_bool
	\keys_set_exclude_groups:enn{ pgfgo / players / \__pgfgo_players_current: / mark } { external } {#1}
	\bool_set_false:N \l_pgfgo_players_mark_options_bool
	\pgfgo_get_variables_from_current_player:
}

%UNA MARCA QUE SE DIBUJA DESPUES AVANZA LA SECUENCIA AHORA, COMO SI SE HUBIERA DIBUJADO.
\cs_new_protected:Npn\pgfgo_mark_step:n #1 {
	\group_begin:
		\bool_if:NF \l__pgfgo_mark_ready_bool {\__pgfgo_mark_setup:n {#1}}
		\bool_if:NT \l_pgfgo_players_mark_sequence_bool {\pgfgo_kernel_sequence_step:}
	\group_end:
}

%EN LAS CAPAS DE UNA ANIMACION, SI EN EL PUNTO HAY UNA PIEDRA QUE SE DIBUJA AL CERRAR EL goban.
\prg_new_protected_conditional:Npnn \__pgfgo_mark_if_on_stone:nn #1#2 {TF} {
	\bool_if:NTF \l_pgfgo_captures_overlay_bool {
		\__pgfgo_captures_key:nn {#1} {#2}
		\bool_if:nTF {
			\prop_if_in_p:NV \g__pgfgo_captures_pending_prop \l__pgfgo_captures_key_tl &&
			! \prop_if_in_p:NV \g__pgfgo_captures_faded_prop \l__pgfgo_captures_key_tl
		} {\prg_return_true:} {\prg_return_false:}
	} {\prg_return_false:}
}

%DIBUJA LA MARCA DE OPCIONES #1 EN (#2,#3).
\cs_new_protected:Npn\__pgfgo_mark_draw:nnn #1#2#3 {
	\group_begin:
		\__pgfgo_mark_setup:n {#1}
		\__pgfgo_mark_draw:nn {#2} {#3}
	\group_end:
}

\cs_new_protected:Npn \__pgfgo_mark_shape: {
	\bool_if:NTF \l_pgfgo_players_mark_sequence_bool
		{\pgfgo_mark_sequence:}
		{\pgfgo_mark_current:}
}
\cs_generate_variant:Nn \str_if_eq_p:nn {Vn}

%DIBUJA EN (#1,#2) LA MARCA DE LAS OPCIONES YA PUESTAS.
\bool_new:N \l__pgfgo_mark_no_shadow_bool
\cs_new_protected:Npn\__pgfgo_mark_draw:nn #1#2 {
	\group_begin:

	%CON mark/scale, LAS FORMAS (Y SU SOMBRA) SE DIBUJAN CON UN RADIO DE PIEDRA PROPORCIONAL.
	\fp_compare:nNnF {\l_pgfgo_players_mark_scale_fp} = {1} {
		\dim_set:Nn \l_pgfgo_players_stone_radius_dim
			{\fp_to_dim:n {\l_pgfgo_players_mark_scale_fp * \l_pgfgo_players_stone_radius_dim}}
	}

	%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
	%---------------------SHADOW-----------------------%
	%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

	%EN LAS CAPAS DE UNA ANIMACION, LA SOMBRA QUEDARIA SOBRE LA PIEDRA: SOBRE UNA PIEDRA NO SE DIBUJA
	%(DEBAJO DE UNA PIEDRA NO SE VE).
	\__pgfgo_mark_if_on_stone:nnTF {#1} {#2}
		{\bool_set_true:N \l__pgfgo_mark_no_shadow_bool}
		{\bool_set_eq:NN \l__pgfgo_mark_no_shadow_bool \l_pgfgo_mark_t_bool}
	\bool_if:NF \l__pgfgo_mark_no_shadow_bool {
		\pgfonlayer{pgfgo_layer_mark_shadow}
		\pgfsetfillcolor{\l_pgfgo_goban_border_fill_color_tl}
		\tl_set:Ne \l_pgfgo_mark_shadow_scale_tl
			{\bool_if:NTF \l_pgfgo_mark_hatched_lines_bool {1} {0.8}}

		%CON IMAGEN DE FONDO, EL CIRCULO MUESTRA LA PARTE DE LA IMAGEN QUE LE CORRESPONDE. DEBAJO, EL COLOR
		%DEL FONDO (POR SI LA IMAGEN ES TRANSPARENTE) VA EN UN CIRCULO 1pt MAS CHICO: CON EL MISMO CIRCULO, EL
		%BORDE SUAVIZADO DEL COLOR SE VERIA COMO UN ANILLO ALREDEDOR DE LA MARCA.
		\pgfgo_goban_if_background_image:TF {
			\pgfpathcircle{\pgfpointxy{#1}{#2}}{\l_pgfgo_players_stone_radius_dim * \l_pgfgo_mark_shadow_scale_tl - 1pt}
			\pgfusepath{fill}
			\pgfscope
			\pgfpathcircle{\pgfpointxy{#1}{#2}}{\l_pgfgo_players_stone_radius_dim * \l_pgfgo_mark_shadow_scale_tl}
			\pgfusepath{clip}
			\pgfgo_goban_background_image:nn {#1} {#2}
			\endpgfscope
		}{
			\pgftransformshift{\pgfpointxy{#1}{#2}}
			\pgfpathcircle{\pgfpointorigin}{\l_pgfgo_players_stone_radius_dim * \l_pgfgo_mark_shadow_scale_tl}
			\pgfusepath{fill}
		}
		\endpgfonlayer
	}

	%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
	%---------------------MARCA------------------------%
	%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

	\tl_set:Nn \l__pgfgo_mark_x_tl {#1}
	\tl_set:Nn \l__pgfgo_mark_y_tl {#2}
	\pgftransformshift{\pgfpointxy{#1}{#2}}
	\pgfonlayer{pgfgo_layer_mark}
	%CON OPACIDAD, UN AMBITO LA LIMITA A ESTA MARCA (UN GRUPO DE TEX NO LA LIMITA EN EL PDF).
	\bool_lazy_and:nnTF
		{\str_if_eq_p:Vn \l_pgfgo_players_mark_line_opacity_tl {1}}
		{\str_if_eq_p:Vn \l_pgfgo_players_mark_fill_opacity_tl {1}}
		{\__pgfgo_mark_shape:}
		{\pgfscope \__pgfgo_mark_shape: \endpgfscope}
	\endpgfonlayer
	\pgftransformreset
	\group_end:
}


%DIBUJA LAS MARCAS #2 (LISTA DE {x}{y}). SI #1 NO INDICA EL JUGADOR, LAS MARCAS SON NEUTRALES.
%TAMBIEN SE USA PARA VOLVER A DIBUJAR LAS MARCAS RECORDADAS.
%LAS OPCIONES SE PONEN UNA SOLA VEZ PARA TODAS LAS MARCAS.
\cs_new_protected:Nn \pgfgo_marks_parsed:nn {
	\group_begin:
		\pgfgo_players_set_current:n {neutral}
		\__pgfgo_mark_setup:n {#1}
		%LA SECUENCIA EMPIEZA EN EL from DEL JUGADOR DE LAS MARCAS.
		\pgfgo_kernel_sequence_reset:n {\l_pgfgo_mark_sequence_from_int}
		\bool_lazy_and:nnT {\l__pgfgo_marks_unordered_bool} {\l_pgfgo_players_mark_sequence_bool}
			{\msg_warning:nnV {pgfgo} {unordered-coordinate} \l__pgfgo_marks_coordinates_tl}
		\bool_set_true:N \l__pgfgo_mark_ready_bool
		\clist_map_inline:nn {#2} {\__pgfgo_marks_point:nnn {#1} ##1}
	\group_end:
}
\cs_new_protected:Npn \__pgfgo_marks_point:nnn #1#2#3 {
	\__pgfgo_mark_at:nnnn {#1} {#2} {#3} {\__pgfgo_mark_draw:nn {#2} {#3}}
}
\cs_generate_variant:Nn \pgfgo_marks_parsed:nn {nV}

%SI LAS COORDENADAS NO TIENEN UN ORDEN FIJO, sequence AVISA (SOLO AL DIBUJARLAS, NO AL REPETIRLAS DE LA MEMORIA).
\bool_new:N \l__pgfgo_marks_unordered_bool
\tl_new:N \l__pgfgo_marks_coordinates_tl
\cs_new_protected:Npn\pgfgo_marks:nn #1#2 {
	\group_begin:
		\keys_set_groups:nnn{ pgfgo / mark }{ preset }{#1}
		\pgfgo_kernel_points:n{#2} %Devuelve \l_pgfgo_kernel_points_seq
		\bool_if:NF \l_pgfgo_kernel_points_ordered_bool {
			\bool_set_true:N \l__pgfgo_marks_unordered_bool
			\tl_set:Ne \l__pgfgo_marks_coordinates_tl {#2}
		}
		\clist_set_from_seq:NN \l_tmpa_clist\l_pgfgo_kernel_points_seq
		%RECORDAR LAS MARCAS
		\pgfgo_remember:Nnn \l_pgfgo_goban_remember_mark_bool {mark}
			{\exp_not:N\pgfgo_marks_parsed:nn{\exp_not:n{#1}}{\exp_not:V\l_tmpa_clist}}
		\pgfgo_marks_parsed:nV {#1} \l_tmpa_clist
	\group_end:
}




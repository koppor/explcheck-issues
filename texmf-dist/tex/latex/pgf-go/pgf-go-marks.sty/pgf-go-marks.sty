%LA OPACIDAD #2 CON #1 (\pgfsetstrokeopacity O \pgfsetfillopacity), SALVO QUE SEA 1.
\cs_new_protected:Npn \__pgfgo_mark_opacity:NN #1#2 {
	\str_if_eq:VnF #2 {1} {#1 {#2}}
}
\cs_generate_variant:Nn \str_if_eq:nnF {Vn}

%EL TRAZO DE LA MARCA DEL JUGADOR.
\cs_new_protected:Npn \__pgfgo_mark_stroke_style: {
	\pgfsetstrokecolor{\l_pgfgo_players_mark_line_color_tl}
	\__pgfgo_mark_opacity:NN \pgfsetstrokeopacity \l_pgfgo_players_mark_line_opacity_tl
	\pgfsetlinewidth{\l_pgfgo_players_mark_line_width_dim}
}
%EL RELLENO: #1 RECIBE EL COLOR. CON mark/fill = false NO SE RELLENA NADA.
\cs_new_protected:Npn \__pgfgo_mark_fill:nn #1#2 {
	\bool_if:NT \l_pgfgo_players_mark_fill_bool {
		\__pgfgo_mark_opacity:NN \pgfsetfillopacity \l_pgfgo_players_mark_fill_opacity_tl
		#1 {\l_pgfgo_players_mark_fill_color_tl}
		#2
	}
}

%UN CUADRADO DE MEDIO LADO #1 RADIOS DE PIEDRA.
\cs_new_protected:Npn \__pgfgo_mark_square_path:n #1 {
	\pgfpathrectanglecorners
		{\pgfpoint{\l_pgfgo_players_stone_radius_dim * #1}{\l_pgfgo_players_stone_radius_dim * #1}}
		{\pgfpoint{-\l_pgfgo_players_stone_radius_dim * #1}{-\l_pgfgo_players_stone_radius_dim * #1}}
}

\cs_new_protected:Nn\pgfgo_mark_circle: {
	\__pgfgo_mark_stroke_style:
	\pgfpathcircle{\pgfpointorigin}{\l_pgfgo_players_stone_radius_dim * 0.6}
	\pgfusepath{stroke}
}

\cs_new_protected:Nn\pgfgo_mark_triangle: {
	\__pgfgo_mark_stroke_style:
	\pgfpathmoveto{\pgfpoint{0}{\l_pgfgo_players_stone_radius_dim * 0.6}}
	\pgfpathlineto{\pgfpoint{-\l_pgfgo_players_stone_radius_dim * 0.866 * 0.6}{-\l_pgfgo_players_stone_radius_dim * 0.5 * 0.6}}
	\pgfpathlineto{\pgfpoint{\l_pgfgo_players_stone_radius_dim * 0.866 * 0.6}{-\l_pgfgo_players_stone_radius_dim * 0.5 * 0.6}}
	\pgfpathclose
	\pgfusepath{stroke}
}

\cs_new_protected:Nn\pgfgo_mark_square: {
	\__pgfgo_mark_stroke_style:
	\__pgfgo_mark_square_path:n {0.7071 * 0.6}
	\pgfusepath{stroke}
}

\cs_new_protected:Nn\pgfgo_mark_hatched_lines: {
	\__pgfgo_mark_fill:nn {\pgfsetfillpattern{north~west~lines}} {
		\pgfpathrectanglecorners
			{\pgfpoint{\l_pgfgo_players_stone_radius_dim}{\l_pgfgo_players_stone_radius_dim}}
			{\pgfpoint{-\l_pgfgo_players_stone_radius_dim}{-\l_pgfgo_players_stone_radius_dim}}
		\pgfusepath{fill}
	}
}

\cs_new_protected:Nn\pgfgo_mark_filled_square: {
	\__pgfgo_mark_fill:nn {\pgfsetfillcolor} {
		\__pgfgo_mark_square_path:n {0.7071 * 0.5}
		\pgfusepath{fill}
	}
}

\cs_new_protected:Nn\pgfgo_mark_filled_circle: {
	\__pgfgo_mark_fill:nn {\pgfsetfillcolor} {
		\pgfpathcircle{\pgfpointorigin}{\l_pgfgo_players_stone_radius_dim * 0.5}
		\pgfusepath{fill}
	}
}

\cs_new_protected:Nn\pgfgo_mark_cross: {
	\__pgfgo_mark_stroke_style:
	\pgfpathmoveto{\pgfpoint{\l_pgfgo_players_stone_radius_dim * 0.7071 * 0.6}{\l_pgfgo_players_stone_radius_dim * 0.7071 * 0.6}}
	\pgfpathlineto{\pgfpoint{-\l_pgfgo_players_stone_radius_dim * 0.7071 * 0.6}{-\l_pgfgo_players_stone_radius_dim * 0.7071 * 0.6}}
	\pgfpathmoveto{\pgfpoint{-\l_pgfgo_players_stone_radius_dim * 0.7071 * 0.6}{\l_pgfgo_players_stone_radius_dim * 0.7071 * 0.6}}
	\pgfpathlineto{\pgfpoint{\l_pgfgo_players_stone_radius_dim * 0.7071 * 0.6}{-\l_pgfgo_players_stone_radius_dim * 0.7071 * 0.6}}
	\pgfusepath{stroke}
}

\cs_set_eq:NN\pgfgo_mark_current:\pgfgo_mark_cross:

%LAS MARCAS t- (TERRITORIO): CON EL ESTILO DE LA CUADRICULA Y EL RELLENO DE LA PIEDRA.
\cs_new_protected:Npn \__pgfgo_mark_t_style: {
	\pgfsetstrokecolor{\l_pgfgo_goban_grid_color_tl}
	\pgfsetlinewidth{\l_pgfgo_goban_grid_line_width_dim}
	\pgfsetfillcolor{\l_pgfgo_players_stone_fill_color_tl}
	\pgfsetstrokeopacity{\l_pgfgo_goban_grid_opacity_tl}
}

\cs_new_protected:Nn\pgfgo_mark_t_circle: {
	\__pgfgo_mark_t_style:
	\pgfpathcircle{\pgfpointorigin}{\l_pgfgo_players_stone_radius_dim * 0.35}
	\pgfusepath{stroke, fill}
}

\cs_new_protected:Nn\pgfgo_mark_t_square: {
	\__pgfgo_mark_t_style:
	\pgfpathrectanglecorners
		{\pgfpointpolar{45}{\l_pgfgo_players_stone_radius_dim * 0.25 * 1.41}}
		{\pgfpointpolar{225}{\l_pgfgo_players_stone_radius_dim * 0.25 * 1.41}}
	\pgfusepath{stroke, fill}
}

%EL PUNTO DE LA MARCA QUE SE ESTA DIBUJANDO.
\tl_new:N \l__pgfgo_mark_x_tl
\tl_new:N \l__pgfgo_mark_y_tl

\cs_new_protected:Nn\pgfgo_mark_dim: {
	\pgfsetfillcolor{\l_pgfgo_goban_border_fill_color_tl}
	\pgfsetfillopacity{0.6}
	\pgfgo_goban_if_background_image:TF {
		\pgfscope
		\pgfpathrectanglecorners {\pgfpointxy{-0.5}{-0.5}} {\pgfpointxy{0.5}{0.5}}
		\pgfusepath{fill, clip}
		\pgftransformshift{\pgfpointxy{-\l__pgfgo_mark_x_tl}{-\l__pgfgo_mark_y_tl}}
		\pgfgo_goban_background_image:VV \l__pgfgo_mark_x_tl \l__pgfgo_mark_y_tl
		\endpgfscope
	}{
		\pgfpathrectanglecorners {\pgfpointxy{-0.5}{-0.5}} {\pgfpointxy{0.5}{0.5}}
		\pgfusepath{fill}
	}
}

%LAS MARCAS DE TEXTO: EL TEXTO #3, MAS CHICO CUANTOS MAS CARACTERES TIENE (#1); CON UNO, DE TAMANO #2.
\tl_new:N \l__pgfgo_mark_text_tl
\tl_new:N \l__pgfgo_mark_text_size_tl
\int_new:N \l__pgfgo_mark_text_length_int
\regex_const:Nn \c__pgfgo_mark_any_regex {.}
\cs_generate_variant:Nn \regex_count:NnN {NV}

\cs_new_protected:Npn \__pgfgo_mark_text:nnn #1#2#3 {
	\tl_if_empty:NTF \l_pgfgo_players_mark_label_font_size_tl
		{\tl_set:Ne \l__pgfgo_mark_text_size_tl {\int_case:nnF {#1} {{1} {#2} {2} {0.65em}} {0.45em}}}
		{\tl_set_eq:NN \l__pgfgo_mark_text_size_tl \l_pgfgo_players_mark_label_font_size_tl}
	%CON mark/scale, EL TAMANO SE CALCULA ADENTRO DE \pgftext: EN LA FIGURA, em VALE 0 (\nullfont).
	\fp_compare:nNnF {\l_pgfgo_players_mark_scale_fp} = {1} {
		\tl_set:Ne \l__pgfgo_mark_text_size_tl {
			\exp_not:N \dim_eval:n {
				\fp_use:N \l_pgfgo_players_mark_scale_fp
				\exp_not:N \dimexpr \exp_not:V \l__pgfgo_mark_text_size_tl \exp_not:N \scan_stop:
			}
		}
	}
	\pgftext{{
			\fontsize{\l__pgfgo_mark_text_size_tl}{0pt}\selectfont
			\l_pgfgo_players_mark_label_font_tl
			#3
	}}
	\pgfusepath{stroke}
}

\cs_new_protected:Nn\pgfgo_mark_custom: {
	\regex_count:NVN \c__pgfgo_mark_any_regex \l_pgfgo_mark_custom_tl \l__pgfgo_mark_text_length_int
	\pgfsetcolor{\l_pgfgo_players_mark_line_color_tl}
	\__pgfgo_mark_text:nnn {\l__pgfgo_mark_text_length_int} {1em}
		{\textcolor{\l_pgfgo_players_mark_label_color_tl}{\l_pgfgo_mark_custom_tl}}
}

\cs_new_protected:Nn\pgfgo_mark_sequence: {
	\tl_set:Ne \l__pgfgo_mark_text_tl {\pgfgo_players_mark_sequence_format:n{\pgfgo_kernel_sequence_number:}}
	\pgfgo_players_label_length:NnVN \pgfgo_players_mark_sequence_format:n {\pgfgo_kernel_sequence_number:}
		\l__pgfgo_mark_text_tl \l__pgfgo_mark_text_length_int
	\pgfsetcolor{\l_pgfgo_players_mark_label_color_tl}
	\__pgfgo_mark_text:nnn {\l__pgfgo_mark_text_length_int} {0.7em} {\l__pgfgo_mark_text_tl}
	\pgfgo_kernel_sequence_step:
}



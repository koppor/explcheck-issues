%MARK

\bool_new:N\l_pgfgo_mark_hatched_lines_bool
\bool_new:N\l_pgfgo_mark_t_bool
\tl_new:N\l_pgfgo_mark_shadow_scale_tl

\tl_new:N\l_pgfgo_mark_custom_tl
\tl_set:Nn\l_pgfgo_mark_custom_tl{!}

%LA FORMA ELEGIDA: DIBUJA LA MARCA CENTRADA EN EL ORIGEN.
\cs_new:Nn\pgfgo_mark_current:{}

%LAS FORMAS t- Y dim NO LLEVAN SOMBRA.
\cs_new_protected:Npn \__pgfgo_mark_t_shape:N #1 {
	\bool_set_true:N \l_pgfgo_mark_t_bool
	\cs_set_eq:NN \pgfgo_mark_current: #1
}

%LA FUNCION #1 ES UNA FORMA: UN NOMBRE POSIBLE DE \pgfgo_mark_current: (VER \pgfgo_style_save:N).
\cs_new_protected:Npn \__pgfgo_mark_shape_function:n #1 {
	\seq_if_in:NnF \g_pgfgo_style_functions_seq {#1} {\seq_gput_right:Nn \g_pgfgo_style_functions_seq {#1}}
}
\cs_generate_variant:Nn \__pgfgo_mark_shape_function:n {e}
\clist_map_inline:nn {pgfgo_mark_hatched_lines:, pgfgo_mark_custom:} {\__pgfgo_mark_shape_function:n {#1}}

%LA CLAVE DE FORMA #1 DE pgfgo/mark, QUE EJECUTA #2 (TAMBIEN LAS DE \pgfgodefinemark).
\cs_new_protected:Npn \__pgfgo_mark_shape_key:nn #1#2 {
	\keys_define:nn {pgfgo / mark} {
		#1		.code:n		= {#2},
		#1		.groups:n	= {shape},
	}
}
\cs_new_protected:Npn \__pgfgo_mark_simple_shape:nN #1#2 {
	\__pgfgo_mark_shape_function:e {\cs_to_str:N #2}
	\__pgfgo_mark_shape_key:nn {#1} {\cs_set_eq:NN \pgfgo_mark_current: #2}
}
\cs_new_protected:Npn \__pgfgo_mark_t_shape:nN #1#2 {
	\__pgfgo_mark_shape_function:e {\cs_to_str:N #2}
	\__pgfgo_mark_shape_key:nn {#1} {\__pgfgo_mark_t_shape:N #2}
}

%CLAVES: /pgfgo/mark/{circle, triangle, square, cross, filled square, filled circle}
\__pgfgo_mark_simple_shape:nN {circle}					\pgfgo_mark_circle:
\__pgfgo_mark_simple_shape:nN {triangle}				\pgfgo_mark_triangle:
\__pgfgo_mark_simple_shape:nN {square}					\pgfgo_mark_square:
\__pgfgo_mark_simple_shape:nN {cross}						\pgfgo_mark_cross:
\__pgfgo_mark_simple_shape:nN {filled~square}		\pgfgo_mark_filled_square:
\__pgfgo_mark_simple_shape:nN {filled~circle}		\pgfgo_mark_filled_circle:
%CLAVES: /pgfgo/mark/{t-circle, t-square, dim}
\__pgfgo_mark_t_shape:nN {t-circle}		\pgfgo_mark_t_circle:
\__pgfgo_mark_t_shape:nN {t-square}		\pgfgo_mark_t_square:
%ATENUA EL PUNTO (DD EN SGF): UN CUADRADO DEL COLOR DEL FONDO, TRANSLUCIDO, SOBRE LA PIEDRA Y LA CUADRICULA.
\__pgfgo_mark_t_shape:nN {dim}				\pgfgo_mark_dim:

\keys_define:nn { pgfgo / mark }{
	forget						.code:n	=	{\bool_set_false:N\l_pgfgo_goban_remember_mark_bool},
	forget						.groups:n	=	{preset},

	hatched~lines	.code:n			=	{
		\bool_set_true:N\l_pgfgo_mark_hatched_lines_bool
		\cs_set_eq:NN\pgfgo_mark_current:\pgfgo_mark_hatched_lines:
	},
	hatched~lines	.groups:n		=	{ shape },

	custom					.code:n			= {
		\tl_set:Nn\l_pgfgo_mark_custom_tl{#1}
		\cs_set_eq:NN\pgfgo_mark_current:\pgfgo_mark_custom:
	},
	custom					.groups:n		=	{ shape },
}

%EL ESTILO DE LAS MARCAS DE LOS TRES JUGADORES, PARA \pgfgoset{mark = {...}} (EN \marks LAS TOMA
%pgfgo/players/<jugador>/mark ANTES DE LLEGAR ACA).
%CLAVES: /pgfgo/mark/{line, fill, label, sequence, scale}
\clist_map_inline:nn {line, fill, label, sequence, scale} {
	\keys_define:nn {pgfgo / mark} {
		#1		.code:n		= {
			\keys_set:ne {pgfgo / players}
				{all = {mark = {#1 \tl_if_empty:nF {##1} {= {\exp_not:n {##1}}}}}}
		},
	}
}

%JUGADOR
%CLAVES: /pgfgo/mark/{black, b, white, w, neutral, n}
\pgfgo_players_define_id_keys:nN {pgfgo / mark} \pgfgo_players_set_current:n




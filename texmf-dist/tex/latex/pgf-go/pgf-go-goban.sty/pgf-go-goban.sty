	\bool_set_true:N\l_pgfgo_goban_border_bool
	\bool_set_true:N\l_pgfgo_goban_border_line_bool
	\bool_set_true:N\l_pgfgo_goban_border_fill_bool

	\dim_new:N\l_pgfgo_goban_border_sep_dim

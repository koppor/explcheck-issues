%------------------------------------------LATEX------------------------------------------------%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

	\NewDocumentEnvironment{goban}{O{}}{
		%\mark Y \marks SOLO EXISTEN DENTRO DEL TABLERO (AFUERA SON LAS PRIMITIVAS DE TEX).
		\cs_set_eq:NN \mark \__pgfgo_marks_command
		\cs_set_eq:NN \marks \__pgfgo_marks_command
		\cs_set_eq:NN \arrow \__pgfgo_arrow_command
		\cs_set_eq:NN \line \__pgfgo_line_command
		\cs_set_eq:NN \sgf \__pgfgo_sgf_command
		%CADA TABLERO EMPIEZA EN LA JUGADA 1 CON NEGRAS (resume VUELVE A JUGAR LAS DEL OTRO goban).
		\pgfgo_kernel_move_reset:
		\pgfgo_notes_begin:
		\pgfgo_points_begin:
		\pgfgo_territory_begin:
		%CADA goban EMPIEZA CON EL TABLERO DEL KERNEL VACIO (Y SIN PRISIONEROS).
		\pgfgo_kernel_if_feature:nT {captures} {\pgfgo_kernel_board_clear:}
		\bool_set_false:N \l__pgfgo_goban_size_bool
		\keys_set:nn {pgfgo / goban} {#1}
		\tl_if_empty:NF \l_pgfgo_goban_resume_tl {\__pgfgo_goban_resume:}
		\pgfgo_kernel_board_init:
		\tl_if_empty:NF \l_pgfgo_goban_name_tl {\__pgfgo_goban_name:n {#1}}
		\bool_if:NT \l_pgfgo_goban_captures_bool {\pgfgo_captures_begin:}
		%UN goban POR PAGINA (pgf-go-pages.sty).
		\pgfgo_pages_begin:

		\__pgfgo_goban_begin:VV \l_pgfgo_goban_size_x_int \l_pgfgo_goban_size_y_int
		}{
			\__pgfgo_goban_end:
			%AL .aux Y A export (pgf-go-store.sty).
			\pgfgo_store_end:
			\pgfgo_pages_end:
		}


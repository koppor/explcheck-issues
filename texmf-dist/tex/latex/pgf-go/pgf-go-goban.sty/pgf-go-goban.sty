	%LO QUE USA UNA VISTA DEL goban #1: SUS OPCIONES, SU ESTILO, SU MEMORIA, SU TAMANO Y SUS CAPTURAS. UN goban
	%YA DIBUJADO O IMPORTADO; SI NO, EL DEL .aux (UNO QUE VIENE DESPUES, VER pgf-go-store.sty).
	\tl_new:N \l__pgfgo_view_memory_tl
	\tl_new:N \l__pgfgo_view_size_tl
	\tl_new:N \l__pgfgo_view_captures_tl
	\prg_new_protected_conditional:Npnn \__pgfgo_view_find:n #1 {TF} {
		\prop_get:NnNTF \g__pgfgo_goban_names_prop {#1} \l__pgfgo_view_options_tl {
			\prop_get:NnN \g__pgfgo_goban_names_style_prop {#1} \l__pgfgo_view_style_tl
			\prop_get:NnN \g__pgfgo_goban_names_size_prop {#1} \l__pgfgo_view_size_tl
			\prop_get:NnN \g__pgfgo_goban_names_captures_prop {#1} \l__pgfgo_view_captures_tl
			\tl_set:Nn \l__pgfgo_view_memory_tl {#1}
			\prg_return_true:
		}{
			\pgfgo_store_find:nTF {#1} {\prg_return_true:} {\prg_return_false:}
		}
	}
	%PARA pgf-go-store.sty: #1 OPCIONES, #2 ESTILO, #3 NOMBRE DE LA MEMORIA, #4 TAMANO, #5 CAPTURAS.
	\cs_new_protected:Npn \pgfgo_view_set:nnnnn #1#2#3#4#5 {
		\tl_set:Nn \l__pgfgo_view_options_tl {#1}
		\tl_set:Nn \l__pgfgo_view_style_tl {#2}
		\tl_set:Nn \l__pgfgo_view_memory_tl {#3}
		\tl_set:Nn \l__pgfgo_view_size_tl {#4}
		\tl_set:Nn \l__pgfgo_view_captures_tl {#5}
	}

	%LO QUE GUARDA UN goban CON NOMBRE (MENOS SU MEMORIA): {TAMANO}{CAPTURAS}{OPCIONES}{ESTILO}, EN #2.
	\cs_new_protected:Npn \pgfgo_goban_name_get:nN #1#2 {
		\tl_set:Ne #2 {
			{\prop_item:Nn \g__pgfgo_goban_names_size_prop {#1}}
			{\prop_item:Nn \g__pgfgo_goban_names_captures_prop {#1}}
			{\prop_item:Nn \g__pgfgo_goban_names_prop {#1}}
			{\prop_item:Nn \g__pgfgo_goban_names_style_prop {#1}}
		}
	}
	%UN goban IMPORTADO (\pgfgoimport): QUEDA COMO SI SE HUBIERA DIBUJADO CON EL NOMBRE #1 (PARA resume Y
	%\pgfgoview). #2 TAMANO, #3 CAPTURAS, #4 OPCIONES, #5 ESTILO, #6 EL CODIGO DE SU MEMORIA.
	\cs_new_protected:Npn \pgfgo_goban_name_set:nnnnnn #1#2#3#4#5#6 {
		\pgfgo_kernel_remember_clear:n {#1}
		\pgfgo_kernel_remember_push:nn {#1} {\exp_not:n {#6}}
		\prop_gput:Nnn \g__pgfgo_goban_names_size_prop {#1} {#2}
		\prop_gput:Nnn \g__pgfgo_goban_names_captures_prop {#1} {#3}
		\prop_gput:Nnn \g__pgfgo_goban_names_prop {#1} {#4}
		\prop_gput:Nnn \g__pgfgo_goban_names_style_prop {#1} {#5}
	}

	%\pgfgoview[OPCIONES]{NOMBRE}{PARTES}: UNA VISTA POR PARTE (SEPARADAS POR COMAS), UNIDAS CON separator Y last.
	\seq_new:N \l__pgfgo_view_parts_seq
	\tl_new:N \l__pgfgo_view_goban_save_tl
	\cs_new_protected:Npn \pgfgo_view:nnn #1#2#3 {
		\group_begin:
			%SOLO PARA separator Y last: LAS OPCIONES DE goban LAS JUNTA CADA VISTA.
			\tl_set_eq:NN \l__pgfgo_view_goban_save_tl \l__pgfgo_view_goban_tl
			\keys_set:nn {pgfgo / view} {#1}
			\tl_set_eq:NN \l__pgfgo_view_goban_tl \l__pgfgo_view_goban_save_tl
			\seq_clear:N \l__pgfgo_view_parts_seq
			\clist_map_inline:nn {#3}
				{\seq_put_right:Nn \l__pgfgo_view_parts_seq {\__pgfgo_view_part:nnn {#1} {#2} {##1}}}
			\seq_use:Nnnn \l__pgfgo_view_parts_seq
				{\l__pgfgo_view_last_tl} {\l__pgfgo_view_separator_tl} {\l__pgfgo_view_last_tl}
		\group_end:
	}

	%UNA VISTA: EL goban CON ESE NOMBRE COMO QUEDO AL TERMINAR (CON LAS CAPTURAS), SOLO EN ESA PARTE, PARA USAR
	%EN EL TEXTO. SI TODAVIA NO HAY UN goban CON ESE NOMBRE: ?? Y UN AVISO.
	\cs_new_protected:Npn \__pgfgo_view_part:nnn #1#2#3 {
		\__pgfgo_view_find:nTF {#2} {
			\group_begin:
				%EL ESTILO DEL goban CON NOMBRE; \pgfgoset{view} Y LAS OPCIONES DE LA VISTA VAN ENCIMA.
				\tl_use:N \l__pgfgo_view_style_tl
				\keys_set:nn {pgfgo / view} {#1}
				\bool_set:Nn \l_pgfgo_remember_hide_mark_bool {! \l__pgfgo_view_marks_bool}
				\bool_set:Nn \l_pgfgo_remember_hide_arrow_bool {! \l__pgfgo_view_arrows_bool}
				\bool_set:Nn \l_pgfgo_remember_hide_line_bool {! \l__pgfgo_view_lines_bool}
				\bool_set:Nn \l_pgfgo_remember_hide_numbers_bool {! \l__pgfgo_view_numbers_bool}
				\bool_set:Nn \l_pgfgo_remember_hide_territory_bool {! \l__pgfgo_view_territory_bool}
				\bool_set:Nn \l_pgfgo_remember_hide_forgotten_bool {! \l__pgfgo_view_forgotten_bool}
				\tl_set_eq:NN \l_pgfgo_goban_view_tl \l__pgfgo_view_memory_tl
				\tl_clear:N \l_pgfgo_goban_name_tl
				\tl_clear:N \l_pgfgo_goban_resume_tl
				\__pgfgo_view_range:n {#3}
				\__pgfgo_view_save:
				%EL TAMANO Y LAS CAPTURAS PUEDEN VENIR DE resume (QUE EN LA VISTA NO HACE NADA).
				\use:e {
					\exp_not:N \begin {goban} [
						\exp_not:V \l__pgfgo_view_options_tl,
						size = {\l__pgfgo_view_size_tl},
						\exp_not:V \l__pgfgo_view_captures_tl
						\tl_if_empty:NF \l__pgfgo_view_profile_tl
							{, profile = {\exp_not:V \l__pgfgo_view_profile_tl}}
						\exp_not:V \l__pgfgo_view_goban_tl,
						partial = {\l__pgfgo_view_range_str}
					]
				}
				\end{goban}
				\__pgfgo_view_restore:
			\group_end:
		}{
			\msg_warning:nnn {pgfgo} {unknown-view-later} {#2}
			\textbf{??}
		}
	}
	\tl_new:N \l__pgfgo_view_options_tl
	\NewDocumentCommand \pgfgoview {O{} m m} {\pgfgo_view:nnn {#1} {#2} {#3}}

	%\pgfgostone[OPCIONES]: UNA PIEDRA SOLA EN EL TEXTO, CON EL ESTILO DE AHORA Y, ENCIMA, LAS OPCIONES DE view
	%(raise, profile Y LAS DE goban, COMO scale). SIN TABLERO NI MEMORIA: NO CAMBIA NADA DEL ULTIMO goban.
	%number = N: LA JUGADA N, CON EL ESTILO move DE SU COLOR (UNA PIEDRA NEUTRAL NO LLEVA NUMERO).
	\msg_new:nnn {pgfgo} {text-stone-number}
		{\iow_char:N\\pgfgostone~with~number~=~'#1'~needs~b~or~w:~the~stone~is~drawn~without~it.}
	\tl_new:N \l__pgfgo_text_stone_number_tl
	\tl_new:N \l__pgfgo_text_stone_options_tl
	\keys_define:nn {pgfgo / pgfgostone} {
		number			.tl_set:N		= \l__pgfgo_text_stone_number_tl,
	}
	\cs_new_protected:Npn \pgfgo_text_stone:n #1 {
		\group_begin:
			\tl_clear:N \l__pgfgo_text_stone_number_tl
			\keys_set_known:nnN {pgfgo / pgfgostone} {#1} \l__pgfgo_text_stone_options_tl
			\use:e {
				\keys_set:nn {pgfgo / goban} {
					\tl_if_empty:NF \l__pgfgo_view_profile_tl {profile = {\exp_not:V \l__pgfgo_view_profile_tl}}
					\exp_not:V \l__pgfgo_view_goban_tl
				}
			}
			\bool_set_false:N \l_pgfgo_goban_captures_bool
			\bool_set_true:N \l_pgfgo_mark_anywhere_bool
			\keys_set:nn {pgfgo / stone} {neutral}
			\keys_set_groups:nnV {pgfgo / stone} {player-id} \l__pgfgo_text_stone_options_tl
			\dim_set:Nn \l__pgfgo_goban_view_raise_dim {\l_pgfgo_goban_view_raise_tl}
			\cs_set_eq:cN {pgfonlayer} \__pgfgo_goban_onlayer:n
			\cs_set_eq:cN {endpgfonlayer} \__pgfgo_goban_endlayer:
			\exp_args:NV \pgfsetlayers \c__pgfgo_text_stone_layers_tl
			\pgfpicture
			\pgfsetxvec{\pgfpoint{\l_pgfgo_goban_grid_x_sep_dim}{0}}
			\pgfsetyvec{\pgfpoint{0}{\l_pgfgo_goban_grid_y_sep_dim}}
			\pgftransformscale{\l_pgfgo_goban_scale_tl}
			\fp_set:Nn \l_pgfgo_goban_line_scale_fp {
				\bool_if:NTF \l_pgfgo_goban_scale_line_width_bool {\l_pgfgo_goban_scale_tl} {1}
			}
			\bool_lazy_or:nnTF {\tl_if_empty_p:N \l__pgfgo_text_stone_number_tl} {\l_pgfgo_players_neutral_bool}
				{
					\tl_if_empty:NF \l__pgfgo_text_stone_number_tl
						{\msg_warning:nnV {pgfgo} {text-stone-number} \l__pgfgo_text_stone_number_tl}
					\exp_args:NV \__pgfgo_stone_draw:nnn \l__pgfgo_text_stone_options_tl {0} {0}
				}
				{
					\use:e {
						\__pgfgo_move_draw:nnnnnn {\exp_not:N \BooleanTrue}
							{\exp_not:V \l__pgfgo_text_stone_options_tl} {0} {0}
							{\exp_not:V \l__pgfgo_text_stone_number_tl}
							{\bool_if:NTF \l_pgfgo_players_black_bool {black} {white}}
					}
				}
			%COMO UNA VISTA: EL CENTRO A raise SOBRE LA LINEA DE BASE DEL TEXTO.
			\pgfsetbaseline {
				\dim_eval:n {(\dim_use:c {pgf@picminy} + \dim_use:c {pgf@picmaxy}) / 2 - \l__pgfgo_goban_view_raise_dim}
			}
			\endpgfpicture
		\group_end:
	}
	\tl_const:Nn \c__pgfgo_text_stone_layers_tl {
		pgfgo_layer_goban_border, pgfgo_layer_goban_grid, pgfgo_layer_goban_labels, pgfgo_layer_territory,
		pgfgo_layer_mark_shadow, pgfgo_layer_stone, pgfgo_layer_stone_mark, pgfgo_layer_mark, main
	}
	\cs_generate_variant:Nn \keys_set_groups:nnn {nnV}
	\cs_generate_variant:Nn \msg_warning:nnn {nnV}
	\NewDocumentCommand \pgfgostone {O{}} {\pgfgo_text_stone:n {#1}}


\keys_define:nn {pgfgo / goban / background / fill}{
	color				.tl_set:N		= \l_pgfgo_goban_border_fill_color_tl,
	color				.initial:n	= {white},

	opacity			.tl_set:N 	= \l_pgfgo_goban_border_fill_opacity_tl,
	opacity			.initial:n	= {1},

	pattern			.code:n = {\keys_set:nn {pgfgo / goban / background / fill / pattern} {#1}},

	false				.code:n = {\bool_set_false:N\l_pgfgo_goban_border_fill_bool},
	true				.code:n = {\bool_set_true:N\l_pgfgo_goban_border_fill_bool},

	image				.code:n = {\keys_set:nn {pgfgo / goban / background / fill / image} {#1}},
}

%EL PATRON, SOBRE EL COLOR Y LA IMAGEN (VER \pgfgo_fill:nnnn EN pgf-go.sty). EL COLOR DEL FONDO TAMBIEN
%TAPA LA CUADRICULA DEBAJO DE LAS MARCAS Y DE LOS HALOS: ACA NO VALE none.
\tl_new:N \l_pgfgo_goban_border_fill_pattern_tl
\tl_new:N \l_pgfgo_goban_border_fill_pattern_color_tl
\keys_define:nn {pgfgo / goban / background / fill / pattern}{
	name				.tl_set:N		= \l_pgfgo_goban_border_fill_pattern_tl,
	color				.tl_set:N		= \l_pgfgo_goban_border_fill_pattern_color_tl,
	color				.initial:n	= {black},
	false				.code:n			= {\tl_clear:N \l_pgfgo_goban_border_fill_pattern_tl},
}
%EL RELLENO DEL FONDO (COLOR Y PATRON) EN EL CAMINO QUE ARMA #1.
\cs_new_protected:Npn \pgfgo_goban_background_fill:n #1 {
	\pgfgo_fill:nVVV {#1}
		\l_pgfgo_goban_border_fill_color_tl
		\l_pgfgo_goban_border_fill_pattern_tl
		\l_pgfgo_goban_border_fill_pattern_color_tl
}

%IMAGEN DE FONDO, SOBRE EL COLOR. SE UBICA SEGUN EL TABLERO COMPLETO (CON partial SE VE LA PARTE QUE
%CORRESPONDE). stretch: OCUPA TODO EL FONDO; cover: MANTIENE LA PROPORCION Y CUBRE EL FONDO, CENTRADA;
%tile: BALDOSAS DE ANCHO width (SIN width, EL NATURAL) DESDE LA ESQUINA O EL BORDE anchor (O EL CENTRO).
%rotate Y VARIOS ARCHIVOS EN file: COMO EN grid/image (stretch Y cover: EL PRIMERO; tile SIN tiles: EL
%TAMANO DE LAS BALDOSAS ES EL DEL PRIMERO).
\seq_new:N \l_pgfgo_goban_background_image_seq
\tl_new:N \l_pgfgo_goban_background_image_fit_tl
\tl_new:N \l_pgfgo_goban_background_image_width_tl
\tl_new:N \l_pgfgo_goban_background_image_anchor_tl
\tl_new:N \l_pgfgo_goban_background_image_tiles_tl
\tl_new:N \l_pgfgo_goban_background_image_rotate_tl
\keys_define:nn {pgfgo / goban / background / fill / image}{
	file				.code:n			= {\seq_set_from_clist:Nn \l_pgfgo_goban_background_image_seq {#1}},
	fit					.choices:nn	= {stretch, cover, tile}
		{\tl_set_eq:NN \l_pgfgo_goban_background_image_fit_tl \l_keys_choice_tl},
	fit					.initial:n	= {cover},
	width				.tl_set:N		= \l_pgfgo_goban_background_image_width_tl,
	anchor			.choices:nn	= {south~west, south, south~east, west, center, east, north~west, north, north~east}
		{\tl_set_eq:NN \l_pgfgo_goban_background_image_anchor_tl \l_keys_choice_tl},
	anchor			.initial:n	= {south~west},
	tiles				.tl_set:N		= \l_pgfgo_goban_background_image_tiles_tl,
	rotate			.tl_set:N		= \l_pgfgo_goban_background_image_rotate_tl,
	false				.code:n			= {\seq_clear:N \l_pgfgo_goban_background_image_seq},
}

	\keys_define:nn {pgfgo / goban / label} {
		false				.code:n 		= {\keys_set:nn {pgfgo / goban / label / at} {none}},
		%LETRAS ABAJO Y NUMEROS A LA IZQUIERDA: "A1" SE LEE DESDE LA ESQUINA INFERIOR IZQUIERDA.
		true				.code:n 		= {\keys_set:nn {pgfgo / goban / label / at} {none, south, west}},

		color				.tl_set:N 	= \l_pgfgo_goban_labels_color_tl,

		sep					.dim_set:N 	= \l_pgfgo_goban_labels_sep_dim,

		font				.tl_set:N 	= \l_pgfgo_goban_label_font_tl,
		font				.initial:n	= {\sffamily},

		%VACIO: TAMANO DEL TEXTO ACTUAL.
		font~size		.tl_set:N 	= \l_pgfgo_goban_label_font_size_tl,
		font~size		.initial:n	= {10pt},

		at					.code:n 		= {\keys_set:nx{pgfgo / goban / label / at} {#1}},

		columns			.choices:nn	= {letters, numbers, kanji}
			{\tl_set_eq:NN \l_pgfgo_goban_label_columns_tl \l_keys_choice_tl},
		columns			.initial:n	= {letters},
		rows				.choices:nn	= {letters, numbers, kanji}
			{\tl_set_eq:NN \l_pgfgo_goban_label_rows_tl \l_keys_choice_tl},
		rows				.initial:n	= {numbers},
		columns~direction	.choices:nn	= {left~to~right, right~to~left}
			{\tl_set_eq:NN \l_pgfgo_goban_label_columns_direction_tl \l_keys_choice_tl},
		columns~direction	.initial:n	= {left~to~right},
		rows~direction		.choices:nn	= {bottom~to~top, top~to~bottom}
			{\tl_set_eq:NN \l_pgfgo_goban_label_rows_direction_tl \l_keys_choice_tl},
		rows~direction		.initial:n	= {bottom~to~top},
		%SOLO EL BORDE: LAS COORDENADAS DE LOS COMANDOS SE LEEN IGUAL.
		letter~case			.choices:nn	= {upper, lower}
			{\bool_set:Nn \l_pgfgo_goban_label_lower_bool {\int_compare_p:nNn {\l_keys_choice_int} = {2}}},
		letter~case			.initial:n	= {upper},

		%ESTILOS COMPLETOS. japanese: NUMEROS DESDE LA DERECHA ARRIBA Y KANJI DESDE ARRIBA AL COSTADO.
		%chinese: IGUAL, PERO LOS NUMEROS DESDE LA IZQUIERDA.
		style				.choice:,
		style / western		.code:n	= {\keys_set:nn {pgfgo / goban / label}
			{columns = letters, rows = numbers, columns~direction = left~to~right, rows~direction = bottom~to~top}},
		style / japanese	.code:n	= {\keys_set:nn {pgfgo / goban / label}
			{columns = numbers, rows = kanji, columns~direction = right~to~left, rows~direction = top~to~bottom}},
		style / chinese		.code:n	= {\keys_set:nn {pgfgo / goban / label}
			{columns = numbers, rows = kanji, columns~direction = left~to~right, rows~direction = top~to~bottom}},
	}

	%EL TEXTO DE LA COORDENADA DE LA COLUMNA O LA FILA #1.
	\cs_new:Npn \__pgfgo_goban_column_label:n #1 {
		\__pgfgo_goban_label_text:Vn \l_pgfgo_goban_label_columns_tl {
			\str_if_eq:VnTF \l_pgfgo_goban_label_columns_direction_tl {right~to~left}
				{\l_pgfgo_goban_size_x_int - (#1) + 1} {#1}
		}
	}
	\cs_new:Npn \__pgfgo_goban_row_label:n #1 {
		\__pgfgo_goban_label_text:Vn \l_pgfgo_goban_label_rows_tl {
			\str_if_eq:VnTF \l_pgfgo_goban_label_rows_direction_tl {top~to~bottom}
				{\l_pgfgo_goban_size_y_int - (#1) + 1} {#1}
		}
	}
	\cs_new:Npn \__pgfgo_goban_label_text:nn #1#2 {
		\str_case:nn {#1} {
			{letters}	{
				%LA MISMA CAJA PARA TODAS LAS MINUSCULAS (CON Y SIN ASCENDENTES O DESCENDENTES): LA MISMA LINEA BASE.
				\bool_if:NTF \l_pgfgo_goban_label_lower_bool
					{\vphantom{bg} \str_lowercase:e {\pgfgo_kernel_column_name:n {#2}}}
					{\pgfgo_kernel_column_name:n {#2}}
			}
			{numbers}	{\int_eval:n {#2}}
			{kanji}		{\pgfgo_int_to_kanji:n {#2}}
		}
	}
	\cs_generate_variant:Nn \__pgfgo_goban_label_text:nn {V}
	\cs_generate_variant:Nn \str_lowercase:n {e}


	%FUENTE DE LAS COORDENADAS DEL BORDE.
	\cs_new_protected:Nn \__pgfgo_goban_label_font: {
		\tl_if_empty:NF \l_pgfgo_goban_label_font_size_tl {
			\fontsize{\l_pgfgo_goban_label_font_size_tl}{\l_pgfgo_goban_label_font_size_tl}\selectfont
		}
		\l_pgfgo_goban_label_font_tl
	}

	\keys_define:nn {pgfgo / goban / label / at} {
		all					.code:n = {
			\bool_set_true:N\l_pgfgo_goban_labels_pos_north_bool
			\bool_set_true:N\l_pgfgo_goban_labels_pos_east_bool
			\bool_set_true:N\l_pgfgo_goban_labels_pos_south_bool
			\bool_set_true:N\l_pgfgo_goban_labels_pos_west_bool
													},

		none					.code:n = {
			\bool_set_false:N\l_pgfgo_goban_labels_pos_north_bool
			\bool_set_false:N\l_pgfgo_goban_labels_pos_east_bool
			\bool_set_false:N\l_pgfgo_goban_labels_pos_south_bool
			\bool_set_false:N\l_pgfgo_goban_labels_pos_west_bool
		},

		north				.bool_set:N = \l_pgfgo_goban_labels_pos_north_bool,
		north				.default:n = {true},

		east				.bool_set:N = \l_pgfgo_goban_labels_pos_east_bool,
		east				.default:n = {true},

		south				.bool_set:N = \l_pgfgo_goban_labels_pos_south_bool,
		south				.default:n = {true},

		west				.bool_set:N = \l_pgfgo_goban_labels_pos_west_bool,
		west				.default:n = {true},

		above				.bool_set:N = \l_pgfgo_goban_labels_pos_north_bool,
		above				.default:n = {true},

		right				.bool_set:N = \l_pgfgo_goban_labels_pos_east_bool,
		right				.default:n = {true},

		below				.bool_set:N = \l_pgfgo_goban_labels_pos_south_bool,
		below				.default:n = {true},

		left				.bool_set:N = \l_pgfgo_goban_labels_pos_west_bool,
		left				.default:n = {true},
	}

	%LAS ESQUINAS #1: <ESQUINA>:<ESQUINA>, <ESQUINA>, <ESQUINA> O <ESQUINA> to <ESQUINA>. EL VALOR SE PASA A
	%CADENA: EL : PUEDE LLEGAR ACTIVO (babel francais).
	\msg_new:nnn {pgfgo} {partial-corners}
		{'#1'~is~not~a~part~of~the~board.~Write~two~corners,~as~in~'partial~=~B2:D4'.}
	\str_new:N \l__pgfgo_goban_partial_str
	\seq_new:N \l__pgfgo_goban_partial_seq
	\cs_new_protected:Npn \__pgfgo_goban_partial_corners:n #1 {
		\str_set:Nn \l__pgfgo_goban_partial_str {#1}
		\str_if_in:NnTF \l__pgfgo_goban_partial_str {:}
			{\seq_set_split:NVV \l__pgfgo_goban_partial_seq \c_colon_str \l__pgfgo_goban_partial_str}
			{\seq_set_split:NnV \l__pgfgo_goban_partial_seq {,} \l__pgfgo_goban_partial_str}
		\int_compare:nNnTF {\seq_count:N \l__pgfgo_goban_partial_seq} = {2}
			{
				\pgfgo_kernel_board_window:e {
					\seq_item:Nn \l__pgfgo_goban_partial_seq {1} \c_space_tl to \c_space_tl
					\seq_item:Nn \l__pgfgo_goban_partial_seq {2}
				}
			}
			{
				\str_if_in:NnTF \l__pgfgo_goban_partial_str {to}
					{\pgfgo_kernel_board_window:V \l__pgfgo_goban_partial_str}
					{\msg_error:nnV {pgfgo} {partial-corners} \l__pgfgo_goban_partial_str}
			}
	}
	\cs_generate_variant:Nn \pgfgo_kernel_board_window:n {V, e}
	\cs_generate_variant:Nn \msg_error:nnn {nnV}
	\cs_generate_variant:Nn \seq_set_split:Nnn {NnV}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%----------------------------------------goban-----------------------------------------------%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

	%EL CONTORNO DEL FONDO DE LA PARTE VISIBLE (#1 Y #2: EL TAMANO COMPLETO). LAS ESQUINAS DEL TABLERO
	%COMPLETO VAN CON rounded corners/outer Y LAS DEMAS CON inner.
	\cs_new_protected:Npn \__pgfgo_goban_background_path:nn #1#2 {
		\pgfpathmoveto {\__pgfgo_goban_background_point:NnNn \l_pgfgo_goban_from_x_int {-} \l_pgfgo_goban_from_y_int {-}}
		\__pgfgo_goban_background_corner:NnnNnn \l_pgfgo_goban_to_x_int {#1} {} \l_pgfgo_goban_from_y_int {1} {-}
		\__pgfgo_goban_background_corner:NnnNnn \l_pgfgo_goban_to_x_int {#1} {} \l_pgfgo_goban_to_y_int {#2} {}
		\__pgfgo_goban_background_corner:NnnNnn \l_pgfgo_goban_from_x_int {1} {-} \l_pgfgo_goban_to_y_int {#2} {}
		\__pgfgo_goban_background_arc:NnNn \l_pgfgo_goban_from_x_int {1} \l_pgfgo_goban_from_y_int {1}
		\pgfpathclose
	}

	%LA ESQUINA DEL FONDO EN LA INTERSECCION (#1,#3), CORRIDA border sep HACIA AFUERA (#2 Y #4: - O NADA).
	\cs_new_protected:Npn \__pgfgo_goban_background_point:NnNn #1#2#3#4 {
		\pgfpointadd
			{\pgfpointxy{#1}{#3}}
			{\pgfpoint{#2\l_pgfgo_goban_border_sep_dim}{#4\l_pgfgo_goban_border_sep_dim}}
	}

	%EL REDONDEO DE LA PROXIMA ESQUINA, EN LA INTERSECCION (#1,#3): outer SI ES UNA ESQUINA DEL TABLERO
	%COMPLETO (#1 = #2 Y #3 = #4), SI NO inner.
	\cs_new_protected:Npn \__pgfgo_goban_background_arc:NnNn #1#2#3#4 {
		\bool_lazy_and:nnTF {\int_compare_p:nNn {#1} = {#2}} {\int_compare_p:nNn {#3} = {#4}}
			{\__pgfgo_goban_background_arc:N \l_pgfgo_goban_border_rounded_corners_dim}
			{\__pgfgo_goban_background_arc:N \l_pgfgo_goban_border_inner_rounded_corners_dim}
	}
	\cs_new_protected:Npn \__pgfgo_goban_background_arc:N #1 {
		\pgfsetcornersarced {\pgfpoint{#1}{#1}}
	}

	%UNA ESQUINA: (#1,#4), CON EL BORDE DEL TABLERO COMPLETO EN #2 Y #5 Y LOS SIGNOS EN #3 Y #6.
	\cs_new_protected:Npn \__pgfgo_goban_background_corner:NnnNnn #1#2#3#4#5#6 {
		\__pgfgo_goban_background_arc:NnNn #1 {#2} #4 {#5}
		\pgfpathlineto {\__pgfgo_goban_background_point:NnNn #1 {#3} #4 {#6}}
	}

	%HAY IMAGEN DE FONDO (Y EL FONDO SE RELLENA).
	\prg_new_conditional:Npnn \pgfgo_goban_if_background_image: {T, F, TF} {
		\bool_lazy_all:nTF {
			{\l_pgfgo_goban_border_bool}
			{\l_pgfgo_goban_border_fill_bool}
			{! \seq_if_empty_p:N \l_pgfgo_goban_background_image_seq}
		} {\prg_return_true:} {\prg_return_false:}
	}

	%DIBUJA LA IMAGEN DE FONDO DEL TABLERO COMPLETO (EL RECORTE LO HACE QUIEN LLAMA). LAS MARCAS LA
	%VUELVEN A DIBUJAR DEBAJO DE ELLAS, EN LUGAR DEL COLOR DEL FONDO.
	\dim_new:N \l__pgfgo_goban_image_x_dim
	\dim_new:N \l__pgfgo_goban_image_y_dim
	\dim_new:N \l__pgfgo_goban_image_w_dim
	\dim_new:N \l__pgfgo_goban_image_h_dim
	\fp_new:N \l__pgfgo_goban_image_fp
	\cs_new_protected:Npn \pgfgo_goban_background_image: {
		\__pgfgo_goban_image_files:N \l_pgfgo_goban_background_image_seq
		%ESQUINA INFERIOR IZQUIERDA Y TAMANO DEL FONDO DEL TABLERO COMPLETO.
		\dim_set:Nn \l__pgfgo_goban_image_x_dim {\l_pgfgo_goban_grid_x_sep_dim - \l_pgfgo_goban_border_sep_dim}
		\dim_set:Nn \l__pgfgo_goban_image_y_dim {\l_pgfgo_goban_grid_y_sep_dim - \l_pgfgo_goban_border_sep_dim}
		\dim_set:Nn \l__pgfgo_goban_image_w_dim
			{\l_pgfgo_goban_grid_x_sep_dim * (\l_pgfgo_goban_size_x_int - 1) + 2 \l_pgfgo_goban_border_sep_dim}
		\dim_set:Nn \l__pgfgo_goban_image_h_dim
			{\l_pgfgo_goban_grid_y_sep_dim * (\l_pgfgo_goban_size_y_int - 1) + 2 \l_pgfgo_goban_border_sep_dim}
		\str_case:Vn \l_pgfgo_goban_background_image_fit_tl {
			{stretch} {
				\__pgfgo_goban_image_fill:NNnnnnn
					\l__pgfgo_goban_image_file_tl \l_pgfgo_goban_background_image_rotate_tl
					{\l__pgfgo_goban_image_w_dim} {\l__pgfgo_goban_image_h_dim}
					{\__pgfgo_goban_background_image_center:} {1} {1}
			}
			%CON UN CUARTO DE VUELTA, EL ANCHO DE LA IMAGEN CUBRE EL ALTO DEL FONDO Y AL REVES.
			{cover} {
				\pgfgo_image_measure:V \l__pgfgo_goban_image_file_tl
				\__pgfgo_goban_quarter:Nnn \l_pgfgo_goban_background_image_rotate_tl {1} {1}
				\int_if_odd:nT {\l__pgfgo_goban_quarter_int} {
					\dim_set_eq:NN \l__pgfgo_goban_cell_w_dim \l_pgfgo_image_width_dim
					\dim_set_eq:NN \l_pgfgo_image_width_dim \l_pgfgo_image_height_dim
					\dim_set_eq:NN \l_pgfgo_image_height_dim \l__pgfgo_goban_cell_w_dim
				}
				\fp_set:Nn \l__pgfgo_goban_image_fp {
					max(\dim_to_fp:n {\l__pgfgo_goban_image_w_dim} / \dim_to_fp:n {\l_pgfgo_image_width_dim},
						\dim_to_fp:n {\l__pgfgo_goban_image_h_dim} / \dim_to_fp:n {\l_pgfgo_image_height_dim})
				}
				\pgfgo_image_load:Ve \l__pgfgo_goban_image_file_tl {
					width = \fp_to_dim:n {ceil(\l__pgfgo_goban_image_fp *
						\int_if_odd:nTF {\l__pgfgo_goban_quarter_int}
							{\l_pgfgo_image_height_dim} {\l_pgfgo_image_width_dim}, 2)}
				}
				\__pgfgo_goban_image_turn:n {\__pgfgo_goban_background_image_center:}
			}
			{tile} {
				\tl_if_empty:NTF \l_pgfgo_goban_background_image_tiles_tl
					{\__pgfgo_goban_background_image_tile:}
					{
						\__pgfgo_goban_tiles:VNN \l_pgfgo_goban_background_image_tiles_tl
							\l__pgfgo_goban_tiles_x_int \l__pgfgo_goban_tiles_y_int
						\pgfgo_image_load:Ve \l__pgfgo_goban_image_file_tl {
							width = \fp_to_dim:n {\l__pgfgo_goban_image_w_dim / \l__pgfgo_goban_tiles_x_int},
							height = \fp_to_dim:n {\l__pgfgo_goban_image_h_dim / \l__pgfgo_goban_tiles_y_int}
						}
						\__pgfgo_goban_mesh:NNnnnn
							\l__pgfgo_goban_image_file_tl \l_pgfgo_goban_background_image_rotate_tl
							{\l__pgfgo_goban_image_x_dim} {\l__pgfgo_goban_image_y_dim}
							{\l__pgfgo_goban_tiles_x_int} {\l__pgfgo_goban_tiles_y_int}
					}
			}
		}
	}

	%LA IMAGEN DE FONDO DEBAJO DE UNA MARCA EN EL PUNTO (#1,#2): CON BALDOSAS, SOLO LAS QUE TOCAN SU CASILLA.
	\tl_new:N \l__pgfgo_goban_image_point_x_tl
	\tl_new:N \l__pgfgo_goban_image_point_y_tl
	\cs_new_protected:Npn \pgfgo_goban_background_image:nn #1#2 {
		\group_begin:
		\tl_set:Nn \l__pgfgo_goban_image_point_x_tl {#1}
		\tl_set:Nn \l__pgfgo_goban_image_point_y_tl {#2}
		\pgfgo_goban_background_image:
		\group_end:
	}
	\cs_generate_variant:Nn \pgfgo_goban_background_image:nn {VV}

	%EL CENTRO DEL FONDO DEL TABLERO COMPLETO (UN PUNTO DE PGF).
	\cs_new:Npn \__pgfgo_goban_background_image_center: {
		\pgfpoint
			{\l__pgfgo_goban_image_x_dim + 0.5 \l__pgfgo_goban_image_w_dim}
			{\l__pgfgo_goban_image_y_dim + 0.5 \l__pgfgo_goban_image_h_dim}
	}

	%EL GIRO DE LAS IMAGENES DE LA CUADRICULA Y DEL FONDO: EL ANGULO DE #1 (rotate) EN LA CELDA (#2,#3),
	%REDONDEADO AL CUARTO DE VUELTA, EN \l__pgfgo_goban_quarter_int (0 A 3; SIN rotate, 0).
	\int_new:N \l__pgfgo_goban_quarter_int
	\cs_new_protected:Npn \__pgfgo_goban_quarter:Nnn #1#2#3 {
		\tl_if_blank:VTF #1
			{\int_zero:N \l__pgfgo_goban_quarter_int}
			{
				\pgfgo_image_angle:Nnn #1 {#2} {#3}
				\int_set:Nn \l__pgfgo_goban_quarter_int {\fp_eval:n {round(\l_pgfgo_image_angle_fp / 90)}}
				\int_set:Nn \l__pgfgo_goban_quarter_int
					{\l__pgfgo_goban_quarter_int - 4 * \int_div_truncate:nn {\l__pgfgo_goban_quarter_int} {4}}
				\int_compare:nNnT {\l__pgfgo_goban_quarter_int} < {0} {\int_add:Nn \l__pgfgo_goban_quarter_int {4}}
			}
	}
	%DIBUJA LA ULTIMA IMAGEN CARGADA, CENTRADA EN #1 Y GIRADA \l__pgfgo_goban_quarter_int CUARTOS DE VUELTA.
	\cs_new_protected:Npn \__pgfgo_goban_image_turn:n #1 {
		\int_compare:nNnTF {\l__pgfgo_goban_quarter_int} = {0}
			{\pgfgo_image_draw:n {#1}}
			{
				\pgfscope
					\pgftransformshift {#1}
					\pgftransformrotate {\int_eval:n {90 * \l__pgfgo_goban_quarter_int}}
					\pgfgo_image_draw:
				\endpgfscope
			}
	}
	%DIBUJA LA IMAGEN #1, GIRADA SEGUN #2 (rotate) EN LA CELDA (#6,#7), EN EL RECTANGULO DE #3 x #4 CENTRADO
	%EN #5: CON UN CUARTO DE VUELTA, SE CARGA CON EL ANCHO Y EL ALTO CAMBIADOS.
	\cs_new_protected:Npn \__pgfgo_goban_image_fill:NNnnnnn #1#2#3#4#5#6#7 {
		\__pgfgo_goban_quarter:Nnn #2 {#6} {#7}
		\int_if_odd:nTF {\l__pgfgo_goban_quarter_int}
			{\pgfgo_image_load:Ve #1 {width = \dim_eval:n {#4}, height = \dim_eval:n {#3}}}
			{\pgfgo_image_load:Ve #1 {width = \dim_eval:n {#3}, height = \dim_eval:n {#4}}}
		\__pgfgo_goban_image_turn:n {#5}
	}
	%UNA BALDOSA: SIN rotate Y CON UN SOLO ARCHIVO, LA ULTIMA IMAGEN CARGADA, SIN VOLVER A CARGARLA. CON
	%VARIOS, EL QUE TOCA A LA CELDA (#6,#7), CON EL TAMANO DE LA BALDOSA.
	\cs_new_protected:Npn \__pgfgo_goban_image_cell:NNnnnnn #1#2#3#4#5#6#7 {
		\bool_lazy_and:nnTF
			{\tl_if_blank_p:V #2}
			{\int_compare_p:nNn {\seq_count:N \l__pgfgo_goban_image_seq} < {2}}
			{\pgfgo_image_draw:n {#5}}
			{
				\__pgfgo_goban_image_pick:nn {#6} {#7}
				\__pgfgo_goban_image_fill:NNnnnnn #1 #2 {#3} {#4} {#5} {#6} {#7}
			}
	}
	\cs_generate_variant:Nn \tl_if_blank_p:n {V}

	%LOS ARCHIVOS DE LA IMAGEN QUE SE DIBUJA (#1, UNA seq) Y EL PRIMERO, EN \l__pgfgo_goban_image_file_tl.
	\seq_new:N \l__pgfgo_goban_image_seq
	\tl_new:N \l__pgfgo_goban_image_file_tl
	\cs_new_protected:Npn \__pgfgo_goban_image_files:N #1 {
		\seq_set_eq:NN \l__pgfgo_goban_image_seq #1
		\tl_set:Ne \l__pgfgo_goban_image_file_tl {\seq_item:Nn #1 {1}}
	}
	%EL ARCHIVO DE LA BALDOSA (#1,#2), SIEMPRE EL MISMO EN CADA LUGAR DE LA MALLA (COMO EN LAS PIEDRAS).
	\cs_new_protected:Npn \__pgfgo_goban_image_pick:nn #1#2 {
		\tl_set:Ne \l__pgfgo_goban_image_file_tl {
			\seq_item:Nn \l__pgfgo_goban_image_seq
				{\pgfgo_image_pick:nnn {#1} {#2} {\seq_count:N \l__pgfgo_goban_image_seq}}
		}
	}
	%EL TAMANO DE LAS BALDOSAS (EL DE LA IMAGEN SIN GIRAR).
	\dim_new:N \l__pgfgo_goban_cell_w_dim
	\dim_new:N \l__pgfgo_goban_cell_h_dim

	%SOLO LAS BALDOSAS QUE TOCAN EL FONDO DE LA PARTE VISIBLE. LAS BALDOSAS SE ALINEAN CON LA ESQUINA anchor
	%O EL BORDE anchor DEL FONDO DEL TABLERO COMPLETO (CENTRADAS EN EL BORDE); CON center, EN EL CENTRO.
	\dim_new:N \l__pgfgo_goban_tile_x_dim
	\dim_new:N \l__pgfgo_goban_tile_y_dim
	\cs_new_protected:Npn \__pgfgo_goban_background_image_tile: {
		\tl_if_empty:NTF \l_pgfgo_goban_background_image_width_tl
			{\pgfgo_image_load:Ve \l__pgfgo_goban_image_file_tl {}}
			{
				\pgfgo_image_load:Ve \l__pgfgo_goban_image_file_tl
					{width = \dim_eval:n {\l_pgfgo_goban_background_image_width_tl}}
			}
		\dim_set_eq:NN \l__pgfgo_goban_cell_w_dim \l_pgfgo_image_width_dim
		\dim_set_eq:NN \l__pgfgo_goban_cell_h_dim \l_pgfgo_image_height_dim
		%LA ESQUINA INFERIOR IZQUIERDA DE UNA BALDOSA, DESDE LA DEL FONDO COMPLETO: CONTRA EL BORDE QUE
		%NOMBRA anchor O, EN LA OTRA DIRECCION, CENTRADA.
		\__pgfgo_goban_tile_start:Nnnnn \l__pgfgo_goban_tile_x_dim
			{west} {east} {\l__pgfgo_goban_image_w_dim} {\l__pgfgo_goban_cell_w_dim}
		\__pgfgo_goban_tile_start:Nnnnn \l__pgfgo_goban_tile_y_dim
			{south} {north} {\l__pgfgo_goban_image_h_dim} {\l__pgfgo_goban_cell_h_dim}
		\tl_if_empty:NTF \l__pgfgo_goban_image_point_x_tl
			{
				\int_set:Nn \l__pgfgo_goban_tile_x_first_int {\__pgfgo_goban_tile_first:nnnn {\l_pgfgo_goban_from_x_int} {\l_pgfgo_goban_grid_x_sep_dim} {\l__pgfgo_goban_cell_w_dim} {\l__pgfgo_goban_tile_x_dim}}
				\int_set:Nn \l__pgfgo_goban_tile_x_last_int {\__pgfgo_goban_tile_last:nnnn {\l_pgfgo_goban_to_x_int} {\l_pgfgo_goban_grid_x_sep_dim} {\l__pgfgo_goban_cell_w_dim} {\l__pgfgo_goban_tile_x_dim}}
				\int_set:Nn \l__pgfgo_goban_tile_y_first_int {\__pgfgo_goban_tile_first:nnnn {\l_pgfgo_goban_from_y_int} {\l_pgfgo_goban_grid_y_sep_dim} {\l__pgfgo_goban_cell_h_dim} {\l__pgfgo_goban_tile_y_dim}}
				\int_set:Nn \l__pgfgo_goban_tile_y_last_int {\__pgfgo_goban_tile_last:nnnn {\l_pgfgo_goban_to_y_int} {\l_pgfgo_goban_grid_y_sep_dim} {\l__pgfgo_goban_cell_h_dim} {\l__pgfgo_goban_tile_y_dim}}
			}
			{
				\__pgfgo_goban_tile_point:NNVnnn \l__pgfgo_goban_tile_x_first_int \l__pgfgo_goban_tile_x_last_int
					\l__pgfgo_goban_image_point_x_tl {\l_pgfgo_goban_grid_x_sep_dim} {\l__pgfgo_goban_cell_w_dim} {\l__pgfgo_goban_tile_x_dim}
				\__pgfgo_goban_tile_point:NNVnnn \l__pgfgo_goban_tile_y_first_int \l__pgfgo_goban_tile_y_last_int
					\l__pgfgo_goban_image_point_y_tl {\l_pgfgo_goban_grid_y_sep_dim} {\l__pgfgo_goban_cell_h_dim} {\l__pgfgo_goban_tile_y_dim}
			}
		\int_step_inline:nnn {\l__pgfgo_goban_tile_x_first_int} {\l__pgfgo_goban_tile_x_last_int}
			{
				\int_step_inline:nnn {\l__pgfgo_goban_tile_y_first_int} {\l__pgfgo_goban_tile_y_last_int}
					{
						\__pgfgo_goban_image_cell:NNnnnnn
							\l__pgfgo_goban_image_file_tl \l_pgfgo_goban_background_image_rotate_tl
							{\l__pgfgo_goban_cell_w_dim} {\l__pgfgo_goban_cell_h_dim}
							{
								\pgfpoint
									{\l__pgfgo_goban_image_x_dim + \l__pgfgo_goban_tile_x_dim + \fp_to_dim:n {(##1 + 0.5) * \l__pgfgo_goban_cell_w_dim}}
									{\l__pgfgo_goban_image_y_dim + \l__pgfgo_goban_tile_y_dim + \fp_to_dim:n {(####1 + 0.5) * \l__pgfgo_goban_cell_h_dim}}
							}
							{##1} {####1}
					}
			}
	}
	%LA MALLA tiles = <COLUMNAS>x<FILAS> (O UN SOLO NUMERO PARA LAS DOS) EN #2 Y #3.
	\seq_new:N \l__pgfgo_goban_tiles_seq
	\msg_new:nnn {pgfgo} {image-tiles}
		{Image~tiles~must~be~'<columns>x<rows>'~or~a~number~(not~'#1').~One~tile~is~used.}
	\cs_new_protected:Npn \__pgfgo_goban_tiles:nNN #1#2#3 {
		\seq_set_split:Nnn \l__pgfgo_goban_tiles_seq {x} {#1}
		\int_set:Nn #2 {\seq_item:Nn \l__pgfgo_goban_tiles_seq {1}}
		\int_set:Nn #3 {\seq_item:Nn \l__pgfgo_goban_tiles_seq {-1}}
		\bool_lazy_or:nnT {\int_compare_p:nNn {#2} < {1}} {\int_compare_p:nNn {#3} < {1}} {
			\msg_warning:nnn {pgfgo} {image-tiles} {#1}
			\int_set:Nn #2 {1}
			\int_set:Nn #3 {1}
		}
	}
	\cs_generate_variant:Nn \__pgfgo_goban_tiles:nNN {V}
	\int_new:N \l__pgfgo_goban_tiles_x_int
	\int_new:N \l__pgfgo_goban_tiles_y_int

	%DIBUJA LA ULTIMA IMAGEN CARGADA (#1, GIRADA SEGUN #2) EN CADA CELDA DE UNA MALLA DE #5 x #6 QUE
	%EMPIEZA EN (#3,#4) (PUNTOS DE PGF EN dim) Y CUYAS CELDAS MIDEN LO QUE LA IMAGEN.
	%DEBAJO DE UNA MARCA (SOLO EN EL FONDO), SOLO LAS CELDAS QUE TOCAN SU CASILLA.
	\cs_new_protected:Npn \__pgfgo_goban_mesh:NNnnnn #1#2#3#4#5#6 {
		\dim_set_eq:NN \l__pgfgo_goban_cell_w_dim \l_pgfgo_image_width_dim
		\dim_set_eq:NN \l__pgfgo_goban_cell_h_dim \l_pgfgo_image_height_dim
		\int_zero:N \l__pgfgo_goban_tile_x_first_int
		\int_set:Nn \l__pgfgo_goban_tile_x_last_int {#5 - 1}
		\int_zero:N \l__pgfgo_goban_tile_y_first_int
		\int_set:Nn \l__pgfgo_goban_tile_y_last_int {#6 - 1}
		\tl_if_empty:NF \l__pgfgo_goban_image_point_x_tl {
			\__pgfgo_goban_tile_point:NNVnnn \l__pgfgo_goban_tile_x_first_int \l__pgfgo_goban_tile_x_last_int
				\l__pgfgo_goban_image_point_x_tl {\l_pgfgo_goban_grid_x_sep_dim} {\l__pgfgo_goban_cell_w_dim} {0pt}
			\__pgfgo_goban_tile_point:NNVnnn \l__pgfgo_goban_tile_y_first_int \l__pgfgo_goban_tile_y_last_int
				\l__pgfgo_goban_image_point_y_tl {\l_pgfgo_goban_grid_y_sep_dim} {\l__pgfgo_goban_cell_h_dim} {0pt}
			\int_set:Nn \l__pgfgo_goban_tile_x_first_int {\int_max:nn {\l__pgfgo_goban_tile_x_first_int} {0}}
			\int_set:Nn \l__pgfgo_goban_tile_x_last_int {\int_min:nn {\l__pgfgo_goban_tile_x_last_int} {#5 - 1}}
			\int_set:Nn \l__pgfgo_goban_tile_y_first_int {\int_max:nn {\l__pgfgo_goban_tile_y_first_int} {0}}
			\int_set:Nn \l__pgfgo_goban_tile_y_last_int {\int_min:nn {\l__pgfgo_goban_tile_y_last_int} {#6 - 1}}
		}
		\int_step_inline:nnn {\l__pgfgo_goban_tile_x_first_int} {\l__pgfgo_goban_tile_x_last_int} {
			\int_step_inline:nnn {\l__pgfgo_goban_tile_y_first_int} {\l__pgfgo_goban_tile_y_last_int} {
				\__pgfgo_goban_image_cell:NNnnnnn #1 #2
					{\l__pgfgo_goban_cell_w_dim} {\l__pgfgo_goban_cell_h_dim}
					{
						\pgfpoint
							{#3 + \fp_to_dim:n {(##1 + 0.5) * \l__pgfgo_goban_cell_w_dim}}
							{#4 + \fp_to_dim:n {(####1 + 0.5) * \l__pgfgo_goban_cell_h_dim}}
					}
					{##1} {####1}
			}
		}
	}

	%#1: DONDE EMPIEZA LA BALDOSA ALINEADA EN UNA DIRECCION: 0 SI anchor NOMBRA EL BORDE #2, EL TAMANO DEL
	%FONDO #4 SI NOMBRA EL BORDE #3 Y, SI NO NOMBRA NINGUNO, CENTRADA (#5: TAMANO DE LA BALDOSA).
	\cs_new_protected:Npn \__pgfgo_goban_tile_start:Nnnnn #1#2#3#4#5 {
		\tl_if_in:NnTF \l_pgfgo_goban_background_image_anchor_tl {#2}
			{\dim_zero:N #1}
			{
				\tl_if_in:NnTF \l_pgfgo_goban_background_image_anchor_tl {#3}
					{\dim_set:Nn #1 {#4}}
					{\dim_set:Nn #1 {0.5 #4 - 0.5 #5}}
			}
	}
	%LA PRIMERA Y LA ULTIMA BALDOSA QUE TOCAN LA PARTE VISIBLE, CONTANDO DESDE 0 EN LA BALDOSA ALINEADA.
	%#1: PRIMERA (O ULTIMA) LINEA VISIBLE, #2: SEPARACION DE LAS LINEAS, #3: TAMANO DE LA BALDOSA, #4: DONDE
	%EMPIEZA LA BALDOSA ALINEADA, DESDE LA ESQUINA DEL FONDO COMPLETO.
	\cs_new:Npn \__pgfgo_goban_tile_first:nnnn #1#2#3#4 {
		\fp_eval:n {floor((((#1) - 1) * \dim_to_fp:n {#2} - \dim_to_fp:n {#4}) / \dim_to_fp:n {#3})}
	}
	\cs_new:Npn \__pgfgo_goban_tile_last:nnnn #1#2#3#4 {
		\fp_eval:n {
			ceil((((#1) - 1) * \dim_to_fp:n {#2} + 2 * \dim_to_fp:n {\l_pgfgo_goban_border_sep_dim}
				- \dim_to_fp:n {#4}) / \dim_to_fp:n {#3}) - 1
		}
	}
	%LO MISMO DEBAJO DE UNA MARCA EN LA LINEA #3: LAS BALDOSAS (#1 A #2) QUE TOCAN SU CASILLA O SU CIRCULO, SI
	%ES MAS GRANDE. #4 A #6 COMO #2 A #4 ARRIBA.
	\int_new:N \l__pgfgo_goban_tile_x_first_int
	\int_new:N \l__pgfgo_goban_tile_x_last_int
	\int_new:N \l__pgfgo_goban_tile_y_first_int
	\int_new:N \l__pgfgo_goban_tile_y_last_int
	\fp_new:N \l__pgfgo_goban_tile_center_fp
	\fp_new:N \l__pgfgo_goban_tile_half_fp
	\cs_new_protected:Npn \__pgfgo_goban_tile_point:NNnnnn #1#2#3#4#5#6 {
		\fp_set:Nn \l__pgfgo_goban_tile_center_fp
			{((#3) - 1) * \dim_to_fp:n {#4} + \dim_to_fp:n {\l_pgfgo_goban_border_sep_dim} - \dim_to_fp:n {#6}}
		\fp_set:Nn \l__pgfgo_goban_tile_half_fp
			{max(0.5 * \dim_to_fp:n {#4}, \dim_to_fp:n {\l_pgfgo_players_stone_radius_dim})}
		\int_set:Nn #1 {\fp_eval:n
			{floor((\l__pgfgo_goban_tile_center_fp - \l__pgfgo_goban_tile_half_fp) / \dim_to_fp:n {#5})}}
		\int_set:Nn #2 {\fp_eval:n
			{ceil((\l__pgfgo_goban_tile_center_fp + \l__pgfgo_goban_tile_half_fp) / \dim_to_fp:n {#5}) - 1}}
	}
	\cs_generate_variant:Nn \__pgfgo_goban_tile_point:NNnnnn {NNV}

	%CAPAS. EL \pgfonlayer DE PGF METE LO QUE YA TENIA LA CAPA DENTRO DE LA CAJA NUEVA: CON MILES DE MARCAS
	%(\territory{auto} EN UN TABLERO GRANDE) EL ANIDAMIENTO DESBORDA LA PILA DE LuaTeX AL ARMAR LA PAGINA,
	%SIN NINGUN MENSAJE. EN EL goban, CADA \pgfonlayer VA EN SU CAJA, AL LADO DE LAS ANTERIORES; LO DEMAS ES
	%COMO EN PGF. \__pgfgo_goban_layer_close: CIERRA LA CAJA DE LA CAPA (NADA SI YA SE ESTABA EN ELLA).
	%EL \pgfsetlinewidth{0.4pt} DE PGF ESCRIBE "0.4 w" FUERA DE LA CAJA, EN LA CAPA DE AFUERA, Y DEJA EL ANCHO
	%GLOBAL: CON CAJA NUEVA, EL ANCHO ES 0.4pt SOLO PARA TeX Y SOLO DENTRO (EN EL PDF LA CAPA SIGUE COMO ESTABA).
	\cs_new_protected:Npn \__pgfgo_goban_onlayer:n #1 {
		\pgfutil@ifundefined {pgf@layerbox@#1} {
			\pgferror {Sorry,~the~requested~layer~'#1'~could~not~be~found.~Maybe~you~misspelled~it?}
			\cs_set_eq:NN \__pgfgo_goban_layer_close: \prg_do_nothing:
			\bgroup
			\begingroup
		}{
			\begingroup
			\tl_set:Nn \pgf@temp {#1}
			\tl_if_eq:NNTF \pgf@temp \pgfonlayer@name
				{
					\cs_set_eq:NN \__pgfgo_goban_layer_close: \prg_do_nothing:
					\cs_set:Npn \pgf@temp {\pgfsetlinewidth {0.4pt} \bgroup \begingroup}
				}{
					\cs_set_eq:NN \pgfonlayer@name \pgf@temp
					\pgfonlayer@assert@is@active
					\cs_set_eq:NN \__pgfgo_goban_layer_close: \egroup
					\cs_set:Npn \pgf@temp {
						\tex_global:D \tex_setbox:D \cs:w pgf@layerbox@#1 \cs_end: = \tex_hbox:D to 0pt \bgroup
							\tex_unhbox:D \cs:w pgf@layerbox@#1 \cs_end:
							\tex_hbox:D to 0pt \bgroup
								\begingroup
					}
					\dim_set:Nn \pgflinewidth {0.4pt}
				}
			\pgf@temp
		}
	}
	\cs_new_protected:Npn \__pgfgo_goban_endlayer: {
				\endgroup
				\hss
			\egroup
		\__pgfgo_goban_layer_close:
		\endgroup
	}
	\cs_new_eq:NN \__pgfgo_goban_layer_close: \prg_do_nothing:

	%EL SISTEMA DE COORDENADAS go DE TikZ: (go cs:B3) ES LA INTERSECCION B3 DEL goban (UNA SOLA, COMO EN
	%\arrow Y \line; PUEDE ESTAR FUERA DEL TABLERO, COMO C0). SI NO SE ENTIENDE, UN AVISO Y EL ORIGEN.
	\msg_new:nnn {pgfgo} {go-coordinate}
		{Coordinate~'#1'~in~(go~cs:#1)~was~not~recognized:~it~is~the~origin~(0,0).}
	\tikzdeclarecoordinatesystem {go} {\__pgfgo_goban_cs:n {#1}}
	\cs_new_protected:Npn \__pgfgo_goban_cs:n #1 {
		\pgfgo_kernel_point:eTF {\tl_trim_spaces:n {#1}}
			{\exp_after:wN \pgfpointxy \l_pgfgo_kernel_point_tl}
			{
				\msg_warning:nne {pgfgo} {go-coordinate} {\tl_trim_spaces:n {#1}}
				\pgfpointorigin
			}
	}
	\cs_generate_variant:Nn \pgfgo_kernel_point:nTF {e}

	%EMPIEZA EL DIBUJO. #1 Y #2 SON EL TAMANO COMPLETO; LA PARTE VISIBLE YA LA CALCULO \pgfgo_kernel_board_init:.
	%CON partial = auto, EL TABLERO SE DIBUJA AL CERRAR, CUANDO YA SE SABE QUE PARTE SE USO (SUS CAPAS VAN
	%DEBAJO IGUAL). EL ENTORNO TERMINA CON \__pgfgo_goban_end:.
	\cs_new_protected:Npn \__pgfgo_goban_begin:nn #1#2 {
		\group_begin:
		\cs_set_eq:cN {pgfonlayer} \__pgfgo_goban_onlayer:n
		\cs_set_eq:cN {endpgfonlayer} \__pgfgo_goban_endlayer:
		\pgfsetlayers{
			pgfgo_layer_goban_border,
			pgfgo_layer_goban_grid,
			pgfgo_layer_goban_labels,
			pgfgo_layer_territory,
			pgfgo_layer_mark_shadow,
			pgfgo_layer_stone,
			pgfgo_layer_stone_mark,
			pgfgo_layer_mark,
			main
		}
		\dim_set:Nn \l__pgfgo_goban_view_raise_dim {\l_pgfgo_goban_view_raise_tl}
		\tikzpicture
		\pgfsetxvec{\pgfpoint{ \l_pgfgo_goban_grid_x_sep_dim}{0}}
		\pgfsetyvec{\pgfpoint{0}{ \l_pgfgo_goban_grid_y_sep_dim}}
		\pgftransformscale{\l_pgfgo_goban_scale_tl}
		\fp_set:Nn \l_pgfgo_goban_line_scale_fp {
			\bool_if:nTF {\l_pgfgo_goban_scale_line_width_bool && !\l_pgfgo_goban_fit_bool}
				{\l_pgfgo_goban_scale_tl} {1}
		}
		\bool_if:NTF \l_pgfgo_goban_partial_auto_bool
			{\pgfgo_kernel_extent_clear:}
			{\__pgfgo_goban_board:nn {#1} {#2}}


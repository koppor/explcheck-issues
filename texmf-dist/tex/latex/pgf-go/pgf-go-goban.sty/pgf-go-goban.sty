	\dim_new:N\l_pgfgo_goban_grid_line_width_dim
	\dim_new:N\l_pgfgo_goban_grid_x_sep_dim
	\dim_new:N\l_pgfgo_goban_grid_y_sep_dim

	%BORDER
	\bool_new:N\l_pgfgo_goban_border_bool
	\bool_new:N\l_pgfgo_goban_border_line_bool

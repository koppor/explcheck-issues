	%\pgftransformscale (scale) SOLO MUEVE LOS PUNTOS: LOS GROSORES DE LAS LINEAS QUEDAN COMO ESTAN. CON
	%scale line width, scale TAMBIEN LOS MULTIPLICA, SALVO CON layout/fit, QUE ELIGE LA ESCALA PARA LLENAR LA
	%COLUMNA: LO AVISA \l_pgfgo_goban_fit_bool, QUE PRENDEN pgf-go-layout.sty Y pgf-go-sgf.sty ANTES DEL goban.
	\bool_new:N \l_pgfgo_goban_scale_line_width_bool
	\bool_new:N \l_pgfgo_goban_fit_bool
	\fp_new:N \l_pgfgo_goban_line_scale_fp
	\fp_set:Nn \l_pgfgo_goban_line_scale_fp {1}
	\cs_new_protected:Npn \pgfgo_goban_line_width:n #1 {
		\pgfsetlinewidth {\fp_to_dim:n {(#1) * \l_pgfgo_goban_line_scale_fp}}
	}

	%LAYERS
	\pgfdeclarelayer{pgfgo_layer_goban_border}

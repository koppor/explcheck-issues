	%LAS OPCIONES DE CADA goban CON NOMBRE Y, SI LAS USO, SUS CAPTURAS (resume LAS SIGUE USANDO). SU
	%MEMORIA EMPIEZA VACIA O, CON resume, CON EL CODIGO QUE VUELVE A DIBUJAR LO QUE TRAE.
	\prop_new:N \g__pgfgo_goban_names_prop
	\prop_new:N \g__pgfgo_goban_names_captures_prop
	\prop_new:N \g__pgfgo_goban_names_style_prop
	%EL TAMANO DE CADA goban CON NOMBRE: resume LO USA SI EL goban NO DA EL SUYO (size, sgf size, sgf view).
	\prop_new:N \g__pgfgo_goban_names_size_prop
	\bool_new:N \l__pgfgo_goban_size_bool
	\cs_new_protected:Npn \__pgfgo_goban_name:n #1 {
		\pgfgo_kernel_remember_clear:V \l_pgfgo_goban_name_tl
		\tl_if_empty:NF \l__pgfgo_goban_resume_memory_tl
			{\pgfgo_kernel_remember_push:Vn \l_pgfgo_goban_name_tl {\__pgfgo_goban_resume_code:}}
		\prop_gput:NVn \g__pgfgo_goban_names_prop \l_pgfgo_goban_name_tl {#1}
		\pgfgo_style_save:N \l__pgfgo_view_style_tl
		\prop_gput:NVV \g__pgfgo_goban_names_style_prop \l_pgfgo_goban_name_tl \l__pgfgo_view_style_tl
		\prop_gput:NVe \g__pgfgo_goban_names_size_prop \l_pgfgo_goban_name_tl
			{\int_use:N \l_pgfgo_goban_size_x_int x \int_use:N \l_pgfgo_goban_size_y_int}
		\prop_gput:NVe \g__pgfgo_goban_names_captures_prop \l_pgfgo_goban_name_tl {
			\bool_if:NT \l_pgfgo_goban_captures_bool
				{captures = \bool_if:NTF \l_pgfgo_goban_captures_fade_bool {fade} {remove}}
		}
	}
	\cs_generate_variant:Nn \pgfgo_kernel_remember_clear:n {V}
	\cs_generate_variant:Nn \pgfgo_kernel_remember_append:nn {VV}

	%EL ESTILO DE UN goban CON NOMBRE (PERFILES, \pgfgoset, Y SUS OPCIONES): EL CODIGO QUE VUELVE AL ESTILO
	%INICIAL Y PONE LAS VARIABLES DEL ESTILO (\g_pgfgo_style_vars_seq, VER pgf-go.sty) QUE CAMBIARON, Y LAS
	%FUNCIONES DEL ESTILO (FORMATO DE LOS NUMEROS Y DE LAS SECUENCIAS, FORMA DE LA MARCA) POR SU NOMBRE. ES
	%TEXTO: VA TAMBIEN AL .aux Y A LOS ARCHIVOS DE export (pgf-go-store.sty).
	\tl_new:N \l__pgfgo_view_style_tl
	\cs_new:Npn \__pgfgo_style_player_functions:n #1
		{pgfgo_players_ #1 _move_label_format:n, pgfgo_players_ #1 _mark_sequence_format:n,}
	\clist_const:Ne \c__pgfgo_style_functions_clist {
		\clist_map_function:nN {neutral, black, white} \__pgfgo_style_player_functions:n
		pgfgo_mark_current:
	}
	%LOS NOMBRES QUE PUEDEN TENER ESAS FUNCIONES. pgf-go-marks.sty AGREGA LAS FORMAS DE LAS MARCAS (TAMBIEN
	%LAS DE \pgfgodefinemark).
	\seq_new:N \g_pgfgo_style_functions_seq
	\seq_gset_from_clist:Nn \g_pgfgo_style_functions_seq {
		int_to_arabic:n, int_to_alph:n, int_to_Alph:n, int_to_roman:n, int_to_Roman:n, pgfgo_int_to_kanji:n
	}
	%SI UNA FUNCION NO ES NINGUNA DE ESAS, SE COPIA CON OTRO NOMBRE (SOLO SIRVE EN ESTE DOCUMENTO).
	\int_new:N \g__pgfgo_style_int
	\tl_new:N \l__pgfgo_view_style_functions_tl
	\tl_new:N \l__pgfgo_view_style_function_tl
	\cs_new_protected:Npn \pgfgo_style_save:N #1 {
		\tl_clear:N \l__pgfgo_view_style_functions_tl
		\clist_map_inline:Nn \c__pgfgo_style_functions_clist {
			\tl_clear:N \l__pgfgo_view_style_function_tl
			\seq_map_inline:Nn \g_pgfgo_style_functions_seq {
				\cs_if_eq:ccT {##1} {####1} {
					\tl_set:Nn \l__pgfgo_view_style_function_tl {####1}
					\seq_map_break:
				}
			}
			\tl_if_empty:NT \l__pgfgo_view_style_function_tl {
				\int_gincr:N \g__pgfgo_style_int
				\tl_set:Ne \l__pgfgo_view_style_function_tl {pgfgo~style~\int_use:N \g__pgfgo_style_int ~ ##1}
				\cs_gset_eq:cc {\l__pgfgo_view_style_function_tl} {##1}
			}
			\tl_put_right:Ne \l__pgfgo_view_style_functions_tl
				{\exp_not:N \pgfgo_style_function:nn {##1} {\l__pgfgo_view_style_function_tl}}
		}
		\tl_set:Ne #1 {
			\exp_not:N \pgfgo_style_initial:
			\seq_map_function:NN \g_pgfgo_style_vars_seq \__pgfgo_style_changed:n
			\exp_not:V \l__pgfgo_view_style_functions_tl
		}
	}
	\msg_new:nnn {pgfgo} {style-function}
		{Unknown~style~function~'#1'~(a~mark~defined~with~\iow_char:N\\pgfgodefinemark~in~another~document?).}
	\cs_new_protected:Npn \pgfgo_style_function:nn #1#2 {
		\cs_if_exist:cTF {#2} {\cs_set_eq:cc {#1} {#2}} {\msg_warning:nnn {pgfgo} {style-function} {#2}}
	}

	%EL ESTILO INICIAL (AL TERMINAR DE CARGAR pgf-go.sty): EL VALOR DE CADA VARIABLE, PARA SABER CUALES
	%CAMBIARON, Y EL CODIGO QUE LAS VUELVE A PONER TODAS.
	\tl_new:N \g__pgfgo_style_initial_tl
	\cs_new_protected:Npn \pgfgo_style_save_initial: {
		\seq_map_inline:Nn \g_pgfgo_style_vars_seq {\__pgfgo_style_save_initial:nN ##1}
	}
	\cs_new_protected:Npn \__pgfgo_style_save_initial:nN #1#2 {
		\str_new:c {g__pgfgo_style_initial_ \cs_to_str:N #2 _str}
		\str_gset:ce {g__pgfgo_style_initial_ \cs_to_str:N #2 _str} {\__pgfgo_style_value:nN {#1} #2}
		\tl_gput_right:Ne \g__pgfgo_style_initial_tl {\__pgfgo_style_value:nN {#1} #2}
	}
	\cs_generate_variant:Nn \str_gset:Nn {ce}
	\cs_new_protected:Npn \pgfgo_style_initial: {\tl_use:N \g__pgfgo_style_initial_tl}
	\cs_new:Npn \__pgfgo_style_changed:n #1 {\__pgfgo_style_changed:nN #1}
	\cs_new:Npn \__pgfgo_style_changed:nN #1#2 {
		\str_if_eq:eeF {\__pgfgo_style_value:nN {#1} #2} {\str_use:c {g__pgfgo_style_initial_ \cs_to_str:N #2 _str}}
			{\__pgfgo_style_value:nN {#1} #2}
	}

	%EL CODIGO QUE VUELVE A PONER EL VALOR DE LA VARIABLE #2, DE TIPO #1. PARA UNA EXPANSION e.
	\cs_new:Npn \__pgfgo_style_value:n #1 {\__pgfgo_style_value:nN #1}
	\cs_new:Npn \__pgfgo_style_value:nN #1#2 {
		\str_case:nnF {#1} {
			{bool}	{\exp_not:N \bool_set_eq:NN \exp_not:N #2 \bool_if:NTF #2 {\exp_not:N \c_true_bool} {\exp_not:N \c_false_bool}}
			{int}		{\exp_not:N \int_set:Nn \exp_not:N #2 {\int_use:N #2}}
			{dim}		{\exp_not:N \dim_set:Nn \exp_not:N #2 {\dim_use:N #2}}
			{skip}	{\exp_not:N \skip_set:Nn \exp_not:N #2 {\skip_use:N #2}}
			{fp}		{\exp_not:N \fp_set:Nn \exp_not:N #2 {\fp_to_tl:N #2}}
			{str}		{\exp_not:N \str_set:Nn \exp_not:N #2 {\exp_not:V #2}}
			{seq}		{\exp_not:N \seq_clear:N \exp_not:N #2 \seq_map_tokens:Nn #2 {\__pgfgo_style_item:Nn #2}}
			{prop}	{\exp_not:N \prop_clear:N \exp_not:N #2 \prop_map_tokens:Nn #2 {\__pgfgo_style_pair:Nnn #2}}
		}{
			\exp_not:N \tl_set:Nn \exp_not:N #2 {\exp_not:V #2}
		}
	}
	\cs_new:Npn \__pgfgo_style_item:Nn #1#2 {\exp_not:N \seq_put_right:Nn \exp_not:N #1 {\exp_not:n {#2}}}
	\cs_new:Npn \__pgfgo_style_pair:Nnn #1#2#3
		{\exp_not:N \prop_put:Nnn \exp_not:N #1 {\exp_not:n {#2}} {\exp_not:n {#3}}}
	\cs_generate_variant:Nn \pgfgo_kernel_remember_push:nn {Vn}

	%resume = {<nombre>, numbers, marks, territory}: EL NOMBRE Y QUE MAS TRAE, ADEMAS DE LAS PIEDRAS.
	\tl_new:N \l_pgfgo_goban_resume_tl
	\clist_new:N \l__pgfgo_goban_resume_clist

}

%LOS LADOS DE LA CASILLA (#1,#2), EN SENTIDO ANTIHORARIO, QUE NO TIENEN OTRA CASILLA PINTADA DEL OTRO LADO.
\cs_new_protected:Npn \__pgfgo_kernel_region_sides:nn #1#2 {
	\cs_if_exist:cT {__pgfgo_kernel_region_cell_ #1 _ #2 :} {
		\bool_if:nF {\__pgfgo_kernel_region_if_painted_p:nn {#1} {#2 - 1}}
			{\__pgfgo_kernel_region_add:nnn {#1} {#2} {1}}
		\bool_if:nF {\__pgfgo_kernel_region_if_painted_p:nn {#1 + 1} {#2}}
			{\__pgfgo_kernel_region_add:nnn {#1 + 1} {#2} {2}}
		\bool_if:nF {\__pgfgo_kernel_region_if_painted_p:nn {#1} {#2 + 1}}
			{\__pgfgo_kernel_region_add:nnn {#1 + 1} {#2 + 1} {4}}
		\bool_if:nF {\__pgfgo_kernel_region_if_painted_p:nn {#1 - 1} {#2}}
			{\__pgfgo_kernel_region_add:nnn {#1} {#2 + 1} {8}}
	}

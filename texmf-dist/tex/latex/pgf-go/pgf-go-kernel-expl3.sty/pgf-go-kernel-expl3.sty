%LOS CONTORNOS QUE EMPIEZAN EN EL VERTICE (#1,#2). CADA UNO EMPIEZA POR EL LADO DE MENOR DIRECCION.
\cs_new_protected:Npn \__pgfgo_kernel_region_start:nn #1#2 {
	\int_compare:nNnF {\__pgfgo_kernel_region_out:nn {#1} {#2}} = {0} {
		\int_zero:N \l__pgfgo_kernel_region_d_int
		\bool_until_do:nn {\__pgfgo_kernel_region_if_out_p:nnn {#1} {#2} {\l__pgfgo_kernel_region_d_int}}
			{\int_incr:N \l__pgfgo_kernel_region_d_int}
		\int_set:Nn \l__pgfgo_kernel_region_x_int {#1}
		\int_set:Nn \l__pgfgo_kernel_region_y_int {#2}
		\__pgfgo_kernel_region_remove:
		\tl_set:Nn \l__pgfgo_kernel_region_tl {{#1}{#2}}
		\__pgfgo_kernel_region_move:
		\bool_until_do:nn {
			\int_compare_p:nNn {\l__pgfgo_kernel_region_x_int} = {#1} &&
			\int_compare_p:nNn {\l__pgfgo_kernel_region_y_int} = {#2}
		}{
			\int_set_eq:NN \l__pgfgo_kernel_region_last_int \l__pgfgo_kernel_region_d_int
			\bool_set_false:N \l__pgfgo_kernel_region_found_bool
			\__pgfgo_kernel_region_take:n {\int_mod:nn {\l__pgfgo_kernel_region_last_int + 1} {4}}
			\__pgfgo_kernel_region_take:n {\l__pgfgo_kernel_region_last_int}
			\__pgfgo_kernel_region_take:n {\int_mod:nn {\l__pgfgo_kernel_region_last_int + 3} {4}}
			\int_compare:nNnF {\l__pgfgo_kernel_region_d_int} = {\l__pgfgo_kernel_region_last_int} {
				\tl_put_right:Ne \l__pgfgo_kernel_region_tl
					{,{\int_use:N \l__pgfgo_kernel_region_x_int}{\int_use:N \l__pgfgo_kernel_region_y_int}}
			}
			\__pgfgo_kernel_region_move:
		}
		\seq_put_right:NV \l_pgfgo_kernel_region_seq \l__pgfgo_kernel_region_tl
		\__pgfgo_kernel_region_start:nn {#1} {#2}
	}
}

%SI DEL VERTICE ACTUAL SALE UN LADO HACIA #1 (Y TODAVIA NO SE ELIGIO OTRO), LO TOMA.
\cs_new_protected:Npn \__pgfgo_kernel_region_take:n #1 {
	\bool_if:NF \l__pgfgo_kernel_region_found_bool {
		\bool_if:nT {
			\__pgfgo_kernel_region_if_out_p:nnn
				{\l__pgfgo_kernel_region_x_int} {\l__pgfgo_kernel_region_y_int} {#1}
		}{
			\bool_set_true:N \l__pgfgo_kernel_region_found_bool
			\int_set:Nn \l__pgfgo_kernel_region_d_int {#1}
			\__pgfgo_kernel_region_remove:
		}
	}
}

%QUITA EL LADO QUE SALE DEL VERTICE ACTUAL HACIA \l__pgfgo_kernel_region_d_int.
\cs_new_protected:Npn \__pgfgo_kernel_region_remove: {
	\__pgfgo_kernel_region_add:nnn {\l__pgfgo_kernel_region_x_int} {\l__pgfgo_kernel_region_y_int}
		{- \__pgfgo_kernel_region_bit:n {\l__pgfgo_kernel_region_d_int}}
}

\cs_new_protected:Npn \__pgfgo_kernel_region_move: {
	\int_case:nn {\l__pgfgo_kernel_region_d_int} {
		{0} {\int_incr:N \l__pgfgo_kernel_region_x_int}
		{1} {\int_incr:N \l__pgfgo_kernel_region_y_int}
		{2} {\int_decr:N \l__pgfgo_kernel_region_x_int}
		{3} {\int_decr:N \l__pgfgo_kernel_region_y_int}
	}
}



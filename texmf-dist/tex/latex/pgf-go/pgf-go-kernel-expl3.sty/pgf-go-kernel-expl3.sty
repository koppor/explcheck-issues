\int_new:N \l__pgfgo_kernel_x_int
\tl_new:N \l__pgfgo_kernel_y_tl
\tl_new:N \l__pgfgo_kernel_to_tl

%VENTANA PEDIDA CON partial, ANTES DE RECORTARLA AL TABLERO.
\int_new:N \l__pgfgo_kernel_window_from_x_int
\int_new:N \l__pgfgo_kernel_window_from_y_int
\int_new:N \l__pgfgo_kernel_window_to_x_int
\int_new:N \l__pgfgo_kernel_window_to_y_int


%9 O 9x13.
\regex_const:Nn \c__pgfgo_kernel_size_regex {\A(\d{1,2})(?:\s*x\s*(\d{1,2}))?\Z}
\cs_new_protected:Npn \pgfgo_kernel_board_size:n #1 {
	\regex_extract_once:NnNTF \c__pgfgo_kernel_size_regex {#1} \l__pgfgo_kernel_match_seq {
		\int_set:Nn \l_pgfgo_goban_size_x_int {\seq_item:Nn \l__pgfgo_kernel_match_seq {2}}
		\int_set:Nn \l_pgfgo_goban_size_y_int {
			\seq_item:Nn \l__pgfgo_kernel_match_seq
				{\tl_if_empty:eTF {\seq_item:Nn \l__pgfgo_kernel_match_seq {3}} {2} {3}}
		}
	}{
		\msg_error:nnn {pgfgo} {unknown-goban-key} {#1}
	}
}


%COLUMNA Y FILA DE UNA COORDENADA COMO C3. DEJA \l__pgfgo_kernel_x_int Y \l__pgfgo_kernel_y_tl.
\regex_const:Nn \c__pgfgo_kernel_coordinate_regex {([A-Za-z]*)\s*(\d*)}
\cs_new_protected:Npn \__pgfgo_kernel_parse_coordinate:n #1 {
	\regex_extract_once:NnN \c__pgfgo_kernel_coordinate_regex {#1} \l__pgfgo_kernel_match_seq
	\int_set:Nn \l__pgfgo_kernel_x_int {\int_from_alph:e {\seq_item:Nn \l__pgfgo_kernel_match_seq {2}}}

	\bool_if:NF \l_pgfgo_use_i_bool {
		\int_compare:nNnT {\l__pgfgo_kernel_x_int} > {9} {
			\int_decr:N \l__pgfgo_kernel_x_int
		}
	}

	\tl_set:Ne \l__pgfgo_kernel_y_tl {\seq_item:Nn \l__pgfgo_kernel_match_seq {3}}
}
\cs_generate_variant:Nn \__pgfgo_kernel_parse_coordinate:n {e, V}


\regex_const:Nn \c__pgfgo_kernel_window_regex {
	\A\s*
	([a-zA-Z]{1}\s*\d{1,2})
	\s* to \s*
	([a-zA-Z]{1}\s*\d{1,2})
	\s*\Z
}
\cs_new_protected:Npn \pgfgo_kernel_board_window:n #1 {
	\regex_extract_once:NnN \c__pgfgo_kernel_window_regex {#1} \l__pgfgo_kernel_match_seq

	\tl_set:Ne \l__pgfgo_kernel_to_tl {\seq_item:Nn \l__pgfgo_kernel_match_seq {3}}

	\__pgfgo_kernel_parse_coordinate:e {\seq_item:Nn \l__pgfgo_kernel_match_seq {2}}
	\int_set_eq:NN \l__pgfgo_kernel_window_from_x_int \l__pgfgo_kernel_x_int
	\int_set:Nn \l__pgfgo_kernel_window_from_y_int {\l__pgfgo_kernel_y_tl}

	\__pgfgo_kernel_parse_coordinate:V \l__pgfgo_kernel_to_tl
	\int_set_eq:NN \l__pgfgo_kernel_window_to_x_int \l__pgfgo_kernel_x_int
	\int_set:Nn \l__pgfgo_kernel_window_to_y_int {\l__pgfgo_kernel_y_tl}
}


\cs_new_protected:Npn \pgfgo_kernel_board_init: {
	\bool_if:NTF \l_pgfgo_goban_partial_bool {
		%LA VENTANA SE RECORTA AL TAMANO DEL TABLERO.
		\int_set:Nn \l_pgfgo_goban_from_x_int {\int_max:nn {1} {\int_min:nn {\l__pgfgo_kernel_window_from_x_int} {\l__pgfgo_kernel_window_to_x_int}}}
		\int_set:Nn \l_pgfgo_goban_from_y_int {\int_max:nn {1} {\int_min:nn {\l__pgfgo_kernel_window_from_y_int} {\l__pgfgo_kernel_window_to_y_int}}}
		\int_set:Nn \l_pgfgo_goban_to_x_int {\int_min:nn {\l_pgfgo_goban_size_x_int} {\int_max:nn {\l__pgfgo_kernel_window_from_x_int} {\l__pgfgo_kernel_window_to_x_int}}}
		\int_set:Nn \l_pgfgo_goban_to_y_int {\int_min:nn {\l_pgfgo_goban_size_y_int} {\int_max:nn {\l__pgfgo_kernel_window_from_y_int} {\l__pgfgo_kernel_window_to_y_int}}}
	}{
		\int_set:Nn \l_pgfgo_goban_from_x_int {1}
		\int_set:Nn \l_pgfgo_goban_from_y_int {1}
		\int_set_eq:NN \l_pgfgo_goban_to_x_int \l_pgfgo_goban_size_x_int
		\int_set_eq:NN \l_pgfgo_goban_to_y_int \l_pgfgo_goban_size_y_int
	}
}


\prg_new_protected_conditional:Npnn \pgfgo_kernel_if_visible:nn #1#2 {T, F, TF} {
	\bool_if:NT \l_pgfgo_goban_partial_auto_bool {\pgfgo_kernel_extent_add:nn {#1} {#2}}
	\bool_if:nTF {
		\int_compare_p:n {1 <= #1 <= \l_pgfgo_goban_size_x_int} &&
		\int_compare_p:n {1 <= #2 <= \l_pgfgo_goban_size_y_int}
	}{
		\bool_if:nTF {
			\int_compare_p:n {\l_pgfgo_goban_from_x_int <= #1 <= \l_pgfgo_goban_to_x_int} &&
			\int_compare_p:n {\l_pgfgo_goban_from_y_int <= #2 <= \l_pgfgo_goban_to_y_int}
		} {\prg_return_true:} {\prg_return_false:}
	}{
		\msg_warning:nnnn {pgfgo} {outside-board} {#1} {#2}
		\prg_return_false:
	}
}


\cs_new:Npn \pgfgo_kernel_column_name:n #1 {
	\int_to_Alph:n {#1 \bool_if:NF \l_pgfgo_use_i_bool {\int_compare:nNnT {#1} > {8} {+ 1}}}
}

%PUNTOS DE ESTRELLA. EN CADA EJE: LA LINEA CERCA DEL BORDE Y, SI ES IMPAR, LA DEL MEDIO (0 SI NO HAY).
\int_new:N \l__pgfgo_kernel_hoshi_near_x_int
\int_new:N \l__pgfgo_kernel_hoshi_near_y_int
\int_new:N \l__pgfgo_kernel_hoshi_mid_x_int
\int_new:N \l__pgfgo_kernel_hoshi_mid_y_int
\bool_new:N \l__pgfgo_kernel_hoshi_center_bool
\bool_new:N \l__pgfgo_kernel_hoshi_sides_bool
\cs_new_protected:Npn \__pgfgo_kernel_hoshi_axis:nNN #1#2#3 {
	\int_set:Nn #2 {\int_compare:nNnTF {#1} < {13} {3} {4}}
	\int_set:Nn #3 {\int_if_odd:nTF {#1} {(#1 + 1) / 2} {0}}
}
\cs_new_protected:Npn \pgfgo_kernel_hoshi: {
	\seq_clear:N \l_pgfgo_kernel_points_seq
	\bool_if:nT {
		! \int_compare_p:nNn {\l_pgfgo_goban_size_x_int} < {7} &&
		! \int_compare_p:nNn {\l_pgfgo_goban_size_y_int} < {7}
	}{
		\__pgfgo_kernel_hoshi_axis:nNN {\l_pgfgo_goban_size_x_int}
			\l__pgfgo_kernel_hoshi_near_x_int \l__pgfgo_kernel_hoshi_mid_x_int
		\__pgfgo_kernel_hoshi_axis:nNN {\l_pgfgo_goban_size_y_int}
			\l__pgfgo_kernel_hoshi_near_y_int \l__pgfgo_kernel_hoshi_mid_y_int
		%EL CENTRO SI LOS DOS EJES SON IMPARES; EL MEDIO DE LOS LADOS SI ADEMAS LOS DOS TIENEN 15 LINEAS O MAS.
		\bool_set:Nn \l__pgfgo_kernel_hoshi_center_bool {
			\int_compare_p:nNn {\l__pgfgo_kernel_hoshi_mid_x_int} > {0} &&
			\int_compare_p:nNn {\l__pgfgo_kernel_hoshi_mid_y_int} > {0}
		}
		\bool_set:Nn \l__pgfgo_kernel_hoshi_sides_bool {
			\l__pgfgo_kernel_hoshi_center_bool &&
			! \int_compare_p:nNn {\l_pgfgo_goban_size_x_int} < {15} &&
			! \int_compare_p:nNn {\l_pgfgo_goban_size_y_int} < {15}
		}
		%FILA POR FILA DESDE ABAJO: LA FILA CERCANA (ESQUINAS), LA DEL MEDIO (LADOS Y CENTRO) Y LA LEJANA.
		\__pgfgo_kernel_hoshi_row:nNN {\l__pgfgo_kernel_hoshi_near_y_int}
			\c_true_bool \l__pgfgo_kernel_hoshi_sides_bool
		\int_compare:nNnT {\l__pgfgo_kernel_hoshi_mid_y_int} > {0} {
			\__pgfgo_kernel_hoshi_row:nNN {\l__pgfgo_kernel_hoshi_mid_y_int}
				\l__pgfgo_kernel_hoshi_sides_bool \l__pgfgo_kernel_hoshi_center_bool
		}
		\__pgfgo_kernel_hoshi_row:nNN {\l_pgfgo_goban_size_y_int - \l__pgfgo_kernel_hoshi_near_y_int + 1}
			\c_true_bool \l__pgfgo_kernel_hoshi_sides_bool
	}
}
%UNA FILA DE PUNTOS DE ESTRELLA: LAS COLUMNAS CERCA DEL BORDE SI #2 Y LA DEL MEDIO SI #3.
\cs_new_protected:Npn \__pgfgo_kernel_hoshi_row:nNN #1#2#3 {
	\bool_if:NT #2 {\__pgfgo_kernel_hoshi_put:nn {\l__pgfgo_kernel_hoshi_near_x_int} {#1}}
	\bool_if:NT #3 {\__pgfgo_kernel_hoshi_put:nn {\l__pgfgo_kernel_hoshi_mid_x_int} {#1}}
	\bool_if:NT #2
		{\__pgfgo_kernel_hoshi_put:nn {\l_pgfgo_goban_size_x_int - \l__pgfgo_kernel_hoshi_near_x_int + 1} {#1}}
}
\cs_new_protected:Npn \__pgfgo_kernel_hoshi_put:nn #1#2 {
	\seq_put_right:Ne \l_pgfgo_kernel_points_seq {{\int_eval:n {#1}}{\int_eval:n {#2}}}
}



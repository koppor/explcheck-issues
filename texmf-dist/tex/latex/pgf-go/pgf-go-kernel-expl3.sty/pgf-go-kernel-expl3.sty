%PUNTOS DE UN POLIGONO. UN PUNTO ESTA ADENTRO SI ESTA SOBRE UNA ARISTA O SI UN RAYO HACIA LA DERECHA CRUZA
%UNA CANTIDAD IMPAR DE ARISTAS. TODO CON ENTEROS. LAS ARISTAS QUEDAN EN \l__pgfgo_kernel_edges_seq COMO
%{ax}{ay}{bx}{by}; EN CADA FILA SE ARMA EN \l__pgfgo_kernel_row_tl LA PRUEBA DE SUS PUNTOS CON LAS ARISTAS QUE
%LA TOCAN.
\seq_new:N \l__pgfgo_kernel_vertices_seq
\tl_new:N \l__pgfgo_kernel_previous_tl
\seq_new:N \l__pgfgo_kernel_edges_seq
\tl_new:N \l__pgfgo_kernel_row_tl
\bool_new:N \l__pgfgo_kernel_inside_bool
\bool_new:N \l__pgfgo_kernel_border_bool
\int_new:N \l__pgfgo_kernel_min_x_int
\int_new:N \l__pgfgo_kernel_max_x_int
\int_new:N \l__pgfgo_kernel_min_y_int
\int_new:N \l__pgfgo_kernel_max_y_int
\int_new:N \l__pgfgo_kernel_dy_int
\int_new:N \l__pgfgo_kernel_n_int

\cs_new_protected:Npn \pgfgo_kernel_polygon:n #1 {
	\seq_clear:N \l_pgfgo_kernel_points_seq
	\seq_set_from_clist:Nn \l__pgfgo_kernel_vertices_seq {#1}
	\seq_if_empty:NF \l__pgfgo_kernel_vertices_seq {
		\seq_clear:N \l__pgfgo_kernel_edges_seq
		\int_set:Nn \l__pgfgo_kernel_min_x_int {\c_max_int}
		\int_set:Nn \l__pgfgo_kernel_max_x_int {-\c_max_int}
		\int_set:Nn \l__pgfgo_kernel_min_y_int {\c_max_int}
		\int_set:Nn \l__pgfgo_kernel_max_y_int {-\c_max_int}
		\seq_get_right:NN \l__pgfgo_kernel_vertices_seq \l__pgfgo_kernel_previous_tl
		\seq_map_inline:Nn \l__pgfgo_kernel_vertices_seq {
			\__pgfgo_kernel_polygon_edge:nnN ##1 \l__pgfgo_kernel_previous_tl
			\tl_set:Nn \l__pgfgo_kernel_previous_tl {##1}
		}
		\int_step_inline:nnn
			{\int_max:nn {1} {\l__pgfgo_kernel_min_y_int}}
			{\int_min:nn {\l_pgfgo_goban_size_y_int} {\l__pgfgo_kernel_max_y_int}}
			{
				\tl_clear:N \l__pgfgo_kernel_row_tl
				\seq_map_inline:Nn \l__pgfgo_kernel_edges_seq {\__pgfgo_kernel_polygon_row:nnnnn {##1} ####1}
				\int_step_inline:nnn
					{\int_max:nn {1} {\l__pgfgo_kernel_min_x_int}}
					{\int_min:nn {\l_pgfgo_goban_size_x_int} {\l__pgfgo_kernel_max_x_int}}
					{\__pgfgo_kernel_polygon_point:nn {####1} {##1}}
			}
	}
}

%LA ARISTA QUE VA DEL VERTICE ANTERIOR (#3, {x}{y}) A (#1,#2).
\cs_new_protected:Npn \__pgfgo_kernel_polygon_edge:nnN #1#2#3 {
	\int_set:Nn \l__pgfgo_kernel_min_x_int {\int_min:nn {\l__pgfgo_kernel_min_x_int} {#1}}
	\int_set:Nn \l__pgfgo_kernel_max_x_int {\int_max:nn {\l__pgfgo_kernel_max_x_int} {#1}}
	\int_set:Nn \l__pgfgo_kernel_min_y_int {\int_min:nn {\l__pgfgo_kernel_min_y_int} {#2}}
	\int_set:Nn \l__pgfgo_kernel_max_y_int {\int_max:nn {\l__pgfgo_kernel_max_y_int} {#2}}
	\seq_put_right:Ne \l__pgfgo_kernel_edges_seq {\exp_not:V #3 {#1}{#2}}
}

%LA PRUEBA DE LA ARISTA (#2,#3)-(#4,#5) EN LA FILA #1. SI LA ARISTA ES HORIZONTAL Y ESTA EN LA FILA, ES BORDE
%ENTRE SUS DOS EXTREMOS. SI NO, Y LA FILA ESTA ENTRE SUS EXTREMOS, LA CORTA EN x = N / dy (CON dy > 0): EL
%PUNTO ESTA SOBRE LA ARISTA SI x dy = N, Y LA ARISTA CRUZA SU RAYO SI x dy < N Y UN EXTREMO ESTA ARRIBA DE LA
%FILA Y EL OTRO NO.
\cs_new_protected:Npn \__pgfgo_kernel_polygon_row:nnnnn #1#2#3#4#5 {
	\int_compare:nNnTF {#3} = {#5} {
		\int_compare:nNnT {#1} = {#3} {
			\tl_put_right:Ne \l__pgfgo_kernel_row_tl {
				\exp_not:N \__pgfgo_kernel_polygon_span:nn {\int_min:nn {#2} {#4}} {\int_max:nn {#2} {#4}}
			}
		}
	}{
		\int_compare:nT {\int_min:nn {#3} {#5} <= #1 <= \int_max:nn {#3} {#5}} {
			\int_set:Nn \l__pgfgo_kernel_dy_int {#5 - #3}
			\int_set:Nn \l__pgfgo_kernel_n_int {(#1 - #3) * (#4 - #2) + #2 * (#5 - #3)}
			\int_compare:nNnT {\l__pgfgo_kernel_dy_int} < {0} {
				\int_set:Nn \l__pgfgo_kernel_dy_int {- \l__pgfgo_kernel_dy_int}
				\int_set:Nn \l__pgfgo_kernel_n_int {- \l__pgfgo_kernel_n_int}
			}
			\tl_put_right:Ne \l__pgfgo_kernel_row_tl {
				\exp_not:N \__pgfgo_kernel_polygon_cut:nnN
					{\int_use:N \l__pgfgo_kernel_n_int} {\int_use:N \l__pgfgo_kernel_dy_int}
					\int_compare:nTF {#1 < \int_max:nn {#3} {#5}} {\exp_not:N \c_true_bool} {\exp_not:N \c_false_bool}
			}
		}
	}
}
\cs_new_protected:Npn \__pgfgo_kernel_polygon_point:nn #1#2 {
	\bool_set_false:N \l__pgfgo_kernel_inside_bool
	\bool_set_false:N \l__pgfgo_kernel_border_bool
	\cs_set:Npn \__pgfgo_kernel_polygon_x: {#1}
	\l__pgfgo_kernel_row_tl
	\bool_if:nT {\l__pgfgo_kernel_inside_bool || \l__pgfgo_kernel_border_bool}
		{\seq_put_right:Nn \l_pgfgo_kernel_points_seq {{#1}{#2}}}
}
\cs_new:Npn \__pgfgo_kernel_polygon_x: {}
\cs_new_protected:Npn \__pgfgo_kernel_polygon_span:nn #1#2 {
	\int_compare:nT {#1 <= \__pgfgo_kernel_polygon_x: <= #2}
		{\bool_set_true:N \l__pgfgo_kernel_border_bool}
}
\cs_new_protected:Npn \__pgfgo_kernel_polygon_cut:nnN #1#2#3 {
	\int_compare:nNnTF {\__pgfgo_kernel_polygon_x: * #2} = {#1}
		{\bool_set_true:N \l__pgfgo_kernel_border_bool}
		{
			\bool_if:NT #3 {
				\int_compare:nNnT {\__pgfgo_kernel_polygon_x: * #2} < {#1}
					{\bool_set_inverse:N \l__pgfgo_kernel_inside_bool}
			}
		}
}


%REGION. EL METODO ESTA EXPLICADO EN pgfgo.region (pgf-go.lua); LOS DOS KERNELS DAN LO MISMO. SE CALCULA EN
%UN GRUPO, CON UN NOMBRE POR PUNTO QUE NO HACE FALTA BORRAR: \__pgfgo_kernel_region_own_x_y: MARCA LOS PUNTOS
%RECIBIDOS, \__pgfgo_kernel_region_cell_x_y: LAS CASILLAS PINTADAS (POR SU ESQUINA DE ABAJO A LA IZQUIERDA) Y
%\__pgfgo_kernel_region_out_x_y: SUMA LAS DIRECCIONES DE LOS LADOS QUE SALEN DEL VERTICE (x,y) Y TODAVIA NO SE
%RECORRIERON. LA DIRECCION d (0 ESTE, 1 NORTE, 2 OESTE, 3 SUR) VALE 2^d.
\seq_new:N \g__pgfgo_kernel_region_seq
\int_new:N \l__pgfgo_kernel_region_x_int
\int_new:N \l__pgfgo_kernel_region_y_int
\int_new:N \l__pgfgo_kernel_region_d_int
\int_new:N \l__pgfgo_kernel_region_last_int
\bool_new:N \l__pgfgo_kernel_region_found_bool
\tl_new:N \l__pgfgo_kernel_region_tl

\cs_new_protected:Npn \pgfgo_kernel_region:n #1 {
	\group_begin:
		\seq_clear:N \l_pgfgo_kernel_region_seq
		\clist_map_inline:nn {#1} {\__pgfgo_kernel_region_own:nn ##1}
		\int_step_inline:nn {\l_pgfgo_goban_size_y_int - 1} {
			\int_step_inline:nn {\l_pgfgo_goban_size_x_int - 1} {\__pgfgo_kernel_region_cell:nn {####1} {##1}}
		}
		\int_step_inline:nn {\l_pgfgo_goban_size_y_int - 1} {
			\int_step_inline:nn {\l_pgfgo_goban_size_x_int - 1} {\__pgfgo_kernel_region_sides:nn {####1} {##1}}
		}
		\int_step_inline:nn {\l_pgfgo_goban_size_y_int} {
			\int_step_inline:nn {\l_pgfgo_goban_size_x_int} {\__pgfgo_kernel_region_start:nn {####1} {##1}}
		}
		\seq_gset_eq:NN \g__pgfgo_kernel_region_seq \l_pgfgo_kernel_region_seq
	\group_end:
	\seq_set_eq:NN \l_pgfgo_kernel_region_seq \g__pgfgo_kernel_region_seq
}

\cs_new_protected:Npn \__pgfgo_kernel_region_own:nn #1#2 {
	\cs_set_eq:cN {__pgfgo_kernel_region_own_ \int_eval:n {#1} _ \int_eval:n {#2} :} \prg_do_nothing:
}
\cs_new:Npn \__pgfgo_kernel_region_if_own_p:nn #1#2 {
	\cs_if_exist_p:c {__pgfgo_kernel_region_own_ \int_eval:n {#1} _ \int_eval:n {#2} :}
}
\cs_new:Npn \__pgfgo_kernel_region_if_painted_p:nn #1#2 {
	\cs_if_exist_p:c {__pgfgo_kernel_region_cell_ \int_eval:n {#1} _ \int_eval:n {#2} :}
}
%LOS LADOS QUE SALEN DEL VERTICE (#1,#2) Y FALTA RECORRER.
\cs_new:Npn \__pgfgo_kernel_region_out:nn #1#2 {
	\cs_if_exist_use:cF {__pgfgo_kernel_region_out_ \int_eval:n {#1} _ \int_eval:n {#2} :} {0}
}
\cs_new:Npn \__pgfgo_kernel_region_bit:n #1 {\int_case:nn {#1} {{0} {1} {1} {2} {2} {4} {3} {8}}}
%VERDADERO SI DEL VERTICE (#1,#2) SALE UN LADO HACIA #3 QUE FALTA RECORRER.
\cs_new:Npn \__pgfgo_kernel_region_if_out_p:nnn #1#2#3 {
	\int_if_odd_p:n {\int_div_truncate:nn {\__pgfgo_kernel_region_out:nn {#1} {#2}} {\__pgfgo_kernel_region_bit:n {#3}}}

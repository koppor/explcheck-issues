%RADIO DEL BRILLO (LA EXPRESION QUE RECIBE PGF).
\tl_const:Nn \c__pgfgo_stone_shine_radius_tl {
	\fp_use:N\l_tmpa_fp * \l_pgfgo_players_stone_radius_dim * \fp_to_decimal:N\l_pgfgo_players_stone_scale_fp
}

%EL BRILLO DIBUJADO: UN TRAZO CURVO Y UNA ELIPSE, PROPORCIONALES AL RADIO DE LA PIEDRA.
\cs_new_protected:Nn \pgfgo_stones_shine_default: {
	\pgfscope
	\pgfsetfillopacity{\fp_use:N\l_pgfgo_players_stone_shine_opacity_fp}
	\pgftransformrotate{-45}
	\pgftransformrotate{\fp_to_decimal:N\l_pgfgo_players_stone_shine_angle_fp}
	\pgfsetfillcolor{\l_pgfgo_players_stone_shine_color_tl}
	\fp_set:Nn\l_tmpa_fp{0.8}
	\pgfpathmoveto{\pgfpointpolar{135}{\c__pgfgo_stone_shine_radius_tl}}
	\pgfpatharc{135}{190}{\c__pgfgo_stone_shine_radius_tl}
	\pgfpathquadraticcurveto{\pgfpointpolar{135}{\c__pgfgo_stone_shine_radius_tl}}{\pgfpointpolar{80}{\c__pgfgo_stone_shine_radius_tl}}
	\pgfpatharc{80}{135}{\c__pgfgo_stone_shine_radius_tl}
	\pgfpathclose

	\pgfusepath{fill}

	\pgftransformshift{\pgfpointpolar{-45}{\c__pgfgo_stone_shine_radius_tl}}
	\pgftransformrotate{45}
	%LOS SEMIEJES: 4/17 Y 1/17 DEL RADIO (0.04cm Y 0.01cm CON UN RADIO DE 0.17cm).
	\dim_set:Nn \l__pgfgo_stone_shine_a_dim {\fp_to_dim:n
		{4 / 17 * \l_pgfgo_players_stone_radius_dim * \l_pgfgo_players_stone_scale_fp}}
	\dim_set:Nn \l__pgfgo_stone_shine_b_dim {\fp_to_dim:n
		{1 / 17 * \l_pgfgo_players_stone_radius_dim * \l_pgfgo_players_stone_scale_fp}}
	\pgfpathellipse{\pgfpointorigin}{\pgfpoint{\l__pgfgo_stone_shine_a_dim}{0cm}}
		{\pgfpoint{0cm}{\l__pgfgo_stone_shine_b_dim}}
	\pgfusepath{fill}
	\endpgfscope
}
\dim_new:N \l__pgfgo_stone_shine_a_dim
\dim_new:N \l__pgfgo_stone_shine_b_dim

%LA IMAGEN DE shine/image O DE shadow/image, CENTRADA EN LA PIEDRA: EL ARCHIVO #1, DE ANCHO #2 (VACIO: EL
%DIAMETRO DE LA PIEDRA), GIRADA #3. CON #4 (silhouette), SOLO SU FORMA, DEL COLOR DE RELLENO ACTUAL. LA
%OPACIDAD Y EL COLOR LOS PONE QUIEN LLAMA, DENTRO DE UN \pgfscope (LA IMAGEN CARGADA QUEDA ADENTRO: NO
%CAMBIA LA DE LA PIEDRA).
\cs_new_protected:Npn \__pgfgo_stone_file:NNNN #1#2#3#4 {
	\pgfgo_image_load:Ve #1 {
		width = \tl_if_empty:NTF #2
			{\fp_to_dim:n {2 * \l_pgfgo_players_stone_radius_dim * \l_pgfgo_players_stone_scale_fp}}
			{\dim_eval:n {#2}}
	}
	\tl_if_blank:VF #3 {\pgftransformrotate{\fp_eval:n {#3}}}
	\bool_if:NTF #4 {\pgfgo_image_shadow:} {\pgfgo_image_draw:}
}

%EL BRILLO, ENCIMA DE LA PIEDRA: EL DIBUJADO O LA IMAGEN shine/image. NO GIRA CON LA IMAGEN DE LA PIEDRA.
\cs_new_protected:Npn \__pgfgo_stone_shine: {
	\bool_if:NT \l_pgfgo_players_stone_shine_bool {
		\tl_if_empty:NTF \l_pgfgo_players_stone_shine_image_tl
			{\pgfgo_stones_shine_default:}
			{
				\pgfscope
					\pgfsetfillopacity{\fp_use:N\l_pgfgo_players_stone_shine_opacity_fp}
					\pgfsetfillcolor{\l_pgfgo_players_stone_shine_color_tl}
					\__pgfgo_stone_file:NNNN
						\l_pgfgo_players_stone_shine_image_tl
						\l_pgfgo_players_stone_shine_image_width_tl
						\l_pgfgo_players_stone_shine_image_rotate_tl
						\l_pgfgo_players_stone_shine_image_silhouette_bool
				\endpgfscope
			}
	}
}






\cs_new_protected:Npn \__pgfgo_stone_colors: {
	\str_if_eq:VnF \l_pgfgo_players_stone_fill_color_tl {none}
		{\pgfsetfillcolor{\l_pgfgo_players_stone_fill_color_tl}}
	\pgfsetstrokecolor{\l_pgfgo_players_stone_line_color_tl}
}
\cs_new_protected:Npn \__pgfgo_stone_opacities: {
	\pgfsetfillopacity{\fp_use:N\l_pgfgo_players_stone_fill_opacity_fp}
	\pgfsetstrokeopacity{\fp_use:N\l_pgfgo_players_stone_line_opacity_fp}
}


%SOMBRA DE LA PIEDRA, CORRIDA Y AGRANDADA (scale): LA IMAGEN shadow/image O, SIN ELLA, LA SILUETA DE LA
%PIEDRA QUE DIBUJA #1.
\cs_new_protected:Npn \__pgfgo_stone_shadow:n #1 {
	\bool_if:NT\l_pgfgo_players_stone_shadow_bool{
		\pgfscope
		\pgfsetfillopacity{\fp_use:N\l_pgfgo_players_stone_shadow_opacity_fp}
		\pgfsetfillcolor{\l_pgfgo_players_stone_shadow_color_tl}
		\pgftransformshift{\pgfpointpolar{\fp_use:N\l_pgfgo_players_stone_shadow_angle_fp}{\dim_use:N\l_pgfgo_players_stone_shadow_offset_dim}}
		\fp_compare:nNnF \l_pgfgo_players_stone_shadow_scale_fp = {1}
			{\pgftransformscale{\fp_use:N\l_pgfgo_players_stone_shadow_scale_fp}}
		\tl_if_empty:NTF \l_pgfgo_players_stone_shadow_image_tl
			{#1}
			{
				\__pgfgo_stone_file:NNNN
					\l_pgfgo_players_stone_shadow_image_tl
					\l_pgfgo_players_stone_shadow_image_width_tl
					\l_pgfgo_players_stone_shadow_image_rotate_tl
					\l_pgfgo_players_stone_shadow_image_silhouette_bool
			}
		\endpgfscope
	}
}

%LA PIEDRA ES UNA IMAGEN: SIN CIRCULO NI BORDE. LA SOMBRA TIENE LA FORMA DE LA IMAGEN. EL BRILLO VA ENCIMA
%Y NO GIRA CON ELLA.
\cs_new_protected:Npn \__pgfgo_stone_image: {
	\__pgfgo_stone_image_load:
	\pgfgo_image_angle:Nnn \l_pgfgo_players_stone_image_rotate_tl
		{\l_pgfgo_parsed_x_coordinate_tl} {\l_pgfgo_parsed_y_coordinate_tl}
	\__pgfgo_stone_shadow:n {
		\pgftransformrotate{\fp_use:N\l_pgfgo_image_angle_fp}
		\pgfgo_image_shadow:
	}
	\pgfscope
	\pgftransformrotate{\fp_use:N\l_pgfgo_image_angle_fp}
	\str_if_eq:VnF \l_pgfgo_players_stone_image_opacity_tl {1}
		{\pgfsetfillopacity{\l_pgfgo_players_stone_image_opacity_tl}}
	\pgfgo_image_draw:
	\endpgfscope
	\__pgfgo_stone_shine:
}

%EL GIRO DE UNA IMAGEN (#1: UN ANGULO, random O <MIN>:<MAX>) EN EL PUNTO (#2,#3), EN \l_pgfgo_image_angle_fp.
%CON random (= 0:360) O UN RANGO, UN ANGULO DEL RANGO QUE DEPENDE SOLO DE LA POSICION: LA IMAGEN DE UN
%PUNTO QUEDA SIEMPRE IGUAL (EN TODOS LOS DIAGRAMAS Y EN TODOS LOS CUADROS DE UNA ANIMACION). EL VALOR SE
%PASA A CADENA: EL : PUEDE LLEGAR ACTIVO (babel francais). LO USAN stone/image Y goban/hoshi/image.
\fp_new:N \l_pgfgo_image_angle_fp
\str_new:N \l__pgfgo_image_rotate_str
\seq_new:N \l__pgfgo_image_rotate_seq
\cs_new_protected:Npn \pgfgo_image_angle:Nnn #1#2#3 {
	\str_set:NV \l__pgfgo_image_rotate_str #1
	\str_if_eq:VnTF \l__pgfgo_image_rotate_str {random}
		{\__pgfgo_image_angle_range:nnnn {0} {360} {#2} {#3}}
		{
			\str_if_in:NnTF \l__pgfgo_image_rotate_str {:}
				{
					\seq_set_split:NVV \l__pgfgo_image_rotate_seq \c_colon_str \l__pgfgo_image_rotate_str
					\__pgfgo_image_angle_range:eenn
						{\seq_item:Nn \l__pgfgo_image_rotate_seq {1}}
						{\seq_item:Nn \l__pgfgo_image_rotate_seq {2}}
						{#2} {#3}
				}
				{
					\tl_if_blank:VTF #1
						{\fp_zero:N \l_pgfgo_image_angle_fp}
						{\fp_set:Nn \l_pgfgo_image_angle_fp {\l__pgfgo_image_rotate_str}}
				}
		}
}
\cs_new_protected:Npn \__pgfgo_image_angle_range:nnnn #1#2#3#4 {
	\fp_set:Nn \l_pgfgo_image_angle_fp {
		sin((#3) * 12.9898 + (#4) * 78.233) * 43758.5453
	}
	\fp_set:Nn \l_pgfgo_image_angle_fp {
		(#1) + (\l_pgfgo_image_angle_fp - floor(\l_pgfgo_image_angle_fp)) * ((#2) - (#1))
	}
}
\cs_generate_variant:Nn \__pgfgo_image_angle_range:nnnn {eenn}
\cs_generate_variant:Nn \str_if_eq:nnTF {Vn}
\cs_generate_variant:Nn \seq_set_split:Nnn {NVV}

%CON VARIOS ARCHIVOS, LA IMAGEN SE ELIGE POR LA POSICION: CADA PUNTO MUESTRA SIEMPRE LA MISMA.
\tl_new:N \l__pgfgo_stone_image_file_tl
\cs_new_protected:Npn \__pgfgo_stone_image_load: {
	\tl_set:Ne \l__pgfgo_stone_image_file_tl {
		\seq_item:Nn \l_pgfgo_players_stone_image_seq {
			\pgfgo_image_pick:nnn {\l_pgfgo_parsed_x_coordinate_tl} {\l_pgfgo_parsed_y_coordinate_tl}
				{\seq_count:N \l_pgfgo_players_stone_image_seq}
		}
	}
	\pgfgo_image_load:Ve \l__pgfgo_stone_image_file_tl {
		width = \tl_if_empty:NTF \l_pgfgo_players_stone_image_width_tl
			{\fp_to_dim:n {2 * \l_pgfgo_players_stone_radius_dim * \l_pgfgo_players_stone_scale_fp}}
			{\dim_eval:n {\l_pgfgo_players_stone_image_width_tl}}
	}
}

%UNA PIEDRA TRANSLUCIDA VA EN UN GRUPO DE TRANSPARENCIA: SE COMPONE ENTERA (EL BORDE NO SE VE SOBRE EL
%RELLENO). OPACA, EL GRUPO NO CAMBIA NADA Y VA EN UN \pgfscope.
%EN PDF CADA ASPECTO DE PIEDRA SE DIBUJA UNA VEZ COMO Form XObject (CON /Group SI ES TRANSLUCIDA) Y CADA
%PIEDRA ES UNA REFERENCIA A EL. CON IMAGEN, PATRON O color = none, Y EN DVI, SE DIBUJA CADA VEZ.
%LOS COLORES VAN DENTRO DEL Form; LAS OPACIDADES TAMBIEN SI ES OPACA. TRANSLUCIDA, VAN FUERA: EL GRUPO SE
%COMPONE CON ELLAS (DENTRO DEL GRUPO LA OPACIDAD EMPIEZA EN 1).
\cs_set:Nn\pgfgo_stone_default_shape:{
	\bool_set:Nn \l__pgfgo_stone_form_group_bool {
		! (\fp_compare_p:nNn {\l_pgfgo_players_stone_fill_opacity_fp} = {1}
		&& \fp_compare_p:nNn {\l_pgfgo_players_stone_line_opacity_fp} = {1})
	}
	\bool_lazy_all:nTF {
		{\sys_if_output_pdf_p:}
		{\seq_if_empty_p:N \l_pgfgo_players_stone_image_seq}
		{\tl_if_empty_p:N \l_pgfgo_players_stone_fill_pattern_tl}
		{! \str_if_eq_p:Vn \l_pgfgo_players_stone_fill_color_tl {none}}
		{\tl_if_empty_p:N \l_pgfgo_players_stone_shadow_image_tl}
		{\tl_if_empty_p:N \l_pgfgo_players_stone_shine_image_tl}
	}
		{
			\bool_if:NT \l__pgfgo_stone_form_group_bool {\__pgfgo_stone_opacities:}
			\__pgfgo_stone_form:
		}
		{
			\__pgfgo_stone_colors:
			\__pgfgo_stone_opacities:
			\bool_if:NTF \l__pgfgo_stone_form_group_bool
				{\pgftransparencygroup \__pgfgo_stone_shape: \endpgftransparencygroup}
				{\pgfscope \__pgfgo_stone_shape: \endpgfscope}
		}
}


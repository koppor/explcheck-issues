\tl_new:N \l_pgfgo_move_x_tl
\tl_new:N \l_pgfgo_move_y_tl

%EL COLOR DE LA PROXIMA JUGADA: black O white.
\cs_new:Npn \__pgfgo_move_color: {\pgfgo_kernel_move_if_black:TF {black} {white}}

%EL CODIGO QUE DIBUJA LA JUGADA (#1: NUMERADA, #2: OPCIONES, #3,#4: PUNTO) CON EL NUMERO Y EL COLOR
%DE AHORA. PARA USAR DENTRO DE UNA EXPANSION e.
\cs_new:Npn \__pgfgo_move_code:nnnn #1#2#3#4 {
	\exp_not:N \__pgfgo_move_draw:nnnnnn
		{\exp_not:n {#1}} {\exp_not:n {#2}} {\exp_not:n {#3}} {\exp_not:n {#4}}
		{\pgfgo_kernel_move_number:} {\__pgfgo_move_color:}
}

%FUERA DE LA PARTE VISIBLE NO SE DIBUJA, PERO LA JUGADA CUENTA (NUMERO Y TURNO).
\cs_set_protected:Npn\pgfgo_move:nnnn #1#2#3#4 {
	\__pgfgo_notes_check:nnnn {#1} {#2} {#3} {#4}
	\__pgfgo_points_put:nnn {#3} {#4} {\__pgfgo_move_color:}
	\bool_if:NTF \l_pgfgo_goban_captures_bool {
		\__pgfgo_captures_move:nnnn {#1} {#2} {#3} {#4}
	}{
		%UNA JUGADA ANOTADA ("N at M") NO SE DIBUJA.
		\bool_if:NF \l__pgfgo_notes_noted_bool {
			\pgfgo_kernel_if_visible:nnT {#3} {#4}
				{\use:e {\__pgfgo_move_code:nnnn {#1} {#2} {#3} {#4}}}
		}
		\pgfgo_kernel_move_play:nn {#3} {#4}
	}
}

%TAMANO DEL NUMERO SEGUN LA CANTIDAD DE LETRAS Y CIFRAS (SI NO SE FIJA CON label/font size).
\tl_new:N \l__pgfgo_move_label_tl
\tl_new:N \l__pgfgo_move_label_size_tl
\int_new:N \l__pgfgo_move_label_int

%DIBUJA LA JUGADA NUMERO #5 DE #6 (black O white) EN (#3,#4). #1: MOSTRAR EL NUMERO. #2: OPCIONES.
\cs_new_protected:Npn\__pgfgo_move_draw:nnnnnn #1#2#3#4#5#6 {
	\group_begin:
	\tl_set:Nn\l_pgfgo_move_x_tl{#3}
	\tl_set:Nn\l_pgfgo_move_y_tl{#4}

	\keys_set:nn { pgfgo / stone }{#6}
	\keys_set_exclude_groups:nnn {pgfgo / players / #6 / move} {external} {#2}
	\pgfgo_get_values_from_player:n {#6}
	%LAS OPCIONES DE PIEDRA Y mark VAN A LA PIEDRA; EL COLOR (#6) VA AL FINAL PARA QUE NO LO CAMBIE b O w.
	\__pgfgo_stone_draw:nnn{#2, #6}{#3}{#4}

	%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
	%----------------------LABEL-----------------------%
	%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

	\IfBooleanT{#1}{
		\tl_set:Ne \l__pgfgo_move_label_tl {\pgfgo_players_move_label_format:n{#5}}
		\tl_if_empty:NTF \l_pgfgo_players_move_label_font_size_tl
			{
				\pgfgo_players_label_length:NnVN \pgfgo_players_move_label_format:n {#5} \l__pgfgo_move_label_tl \l__pgfgo_move_label_int
				\tl_set:Ne \l__pgfgo_move_label_size_tl {
					\int_case:nnF {\l__pgfgo_move_label_int}
						{{1} {10pt} {2} {6.5pt}}
						{4.5pt}
				}
			}
			{\tl_set_eq:NN \l__pgfgo_move_label_size_tl \l_pgfgo_players_move_label_font_size_tl}

		\pgfscope
		\pgfsetcolor{\l_pgfgo_players_move_label_color_tl}
		\str_if_eq:VnF \l_pgfgo_players_move_label_opacity_tl {1}
			{\pgfsetfillopacity{\l_pgfgo_players_move_label_opacity_tl}}
		\pgftext[at=\pgfpointxy{\l_pgfgo_move_x_tl}{\l_pgfgo_move_y_tl}]{
			\l_pgfgo_players_move_label_font_tl\fontsize{ \l__pgfgo_move_label_size_tl }{0pt}\selectfont
			\l__pgfgo_move_label_tl
		}
		\pgfusepath{stroke}
		\endpgfscope
	}

	\group_end:
}
\cs_generate_variant:Nn \regex_count:NnN {NV}


\cs_new:Nn\pgfgo_move:nnn{\pgfgo_move:nnnn{#1}{#2}#3}




%LO QUE HAY EN CADA PUNTO DEL goban ACTUAL (LO USA EL TERRITORIO): "x,y" -> black | white | neutral
%(PIEDRAS VIVAS) O dead-black | dead-white (PRISIONEROS). LAS CAPTURAS Y AE QUITAN LAS PIEDRAS.
\prop_new:N \g_pgfgo_points_prop

\cs_new_protected:Npn \pgfgo_points_begin: {
	\prop_gclear:N \g_pgfgo_points_prop
	\prop_gclear:N \g_pgfgo_territory_prop
}

\cs_new_protected:Npn \__pgfgo_points_put:nnn #1#2#3 {
	\bool_lazy_and:nnT
		{\int_compare_p:n {1 <= #1 <= \l_pgfgo_goban_size_x_int}}
		{\int_compare_p:n {1 <= #2 <= \l_pgfgo_goban_size_y_int}}
		{
			\__pgfgo_captures_key:nn {#1} {#2}
			\prop_gput:NVe \g_pgfgo_points_prop \l__pgfgo_captures_key_tl {#3}
		}
}

\cs_new_protected:Npn \__pgfgo_points_remove:nn #1#2 {
	\__pgfgo_captures_key:nn {#1} {#2}
	\prop_gremove:NV \g_pgfgo_points_prop \l__pgfgo_captures_key_tl
}

%DIBUJA UNA PIEDRA. SI #1 NO INDICA EL JUGADOR, LA PIEDRA ES NEUTRAL.
%SOLO SE DIBUJA SI ESTA EN LA PARTE VISIBLE DEL TABLERO. CON CAPTURAS, LAS PIEDRAS NEGRAS Y BLANCAS
%QUE NO SON PRISIONEROS VAN AL TABLERO DEL KERNEL Y SE DIBUJAN AL CERRAR EL goban.
\cs_set_protected:Npn\pgfgo_stone:nnn #1#2#3 {
	\group_begin:
		\keys_set:nn { pgfgo / stone } {neutral}
		\keys_set_groups:nnn { pgfgo / stone } {player-id, captures-id} {#1}
		\__pgfgo_points_put:nnn {#2} {#3}
			{\bool_if:NT \l__pgfgo_stone_prisoner_bool {dead-} \__pgfgo_players_current:}
		\bool_lazy_and:nnTF {\l_pgfgo_goban_captures_bool}
			{! \l_pgfgo_players_neutral_bool && ! \l__pgfgo_stone_prisoner_bool}
			{
				\exp_args:Ne \pgfgo_kernel_board_put:nnn
					{\bool_if:NTF \l_pgfgo_players_black_bool {black} {white}} {#2} {#3}
				\pgfgo_kernel_if_visible:nnT {#2} {#3}
					{\__pgfgo_captures_defer:nnn {#2} {#3} {\__pgfgo_stone_draw:nnn {#1} {#2} {#3}}}
			}
			{\pgfgo_kernel_if_visible:nnT {#2} {#3} {\__pgfgo_stone_draw:nnn {#1} {#2} {#3}}}
	\group_end:
}

%UNA PIEDRA CAPTURADA CON captures = fade SE DIBUJA COMO UN PRISIONERO.
\cs_set_protected:Npn\__pgfgo_stone_draw:nnn #1#2#3 {
	\bool_if:NTF \l__pgfgo_captures_fade_bool
		{\__pgfgo_stone_draw_aux:nnn {#1, prisoner} {#2} {#3}}
		{\__pgfgo_stone_draw_aux:nnn {#1} {#2} {#3}}
}

%EL ESTILO DE UN PRISIONERO DEL JUGADOR #1, ANTES DE LAS OPCIONES DE LA PIEDRA: OPACIDAD DEL RELLENO 0.5,
%/pgfgo/prisoner, pgfgo/players/#1/stone/prisoner Y EL VALOR DE prisoner EN LA PIEDRA.
\cs_new_protected:Npn \__pgfgo_stone_prisoner_style:n #1 {
	\keys_set:nn { pgfgo / players / #1 / stone / fill } {opacity = 0.5}
	\keys_set:nV { pgfgo / players / #1 / stone } \l_pgfgo_prisoner_options_tl
	\keys_set:nv { pgfgo / players / #1 / stone } {l_pgfgo_players_ #1 _stone_prisoner_tl}
	\keys_set:nV { pgfgo / players / #1 / stone } \l__pgfgo_stone_prisoner_options_tl
}
\cs_generate_variant:Nn \__pgfgo_stone_prisoner_style:n {e}

\cs_new_protected:Npn\__pgfgo_stone_draw_aux:nnn #1#2#3 {
	\group_begin:
	\keys_set:nn { pgfgo / stone }{neutral}
	\bool_set_false:N \l__pgfgo_stone_prisoner_bool
	\keys_set_groups:nnn{ pgfgo / stone }{ player-id, captures-id }{#1}
	\bool_if:NT \l__pgfgo_stone_prisoner_bool
		{\__pgfgo_stone_prisoner_style:e {\__pgfgo_players_current:}}
	\keys_set_exclude_groups:enn { pgfgo / players / \__pgfgo_players_current: / stone } { external } {#1}
	\pgfgo_get_variables_from_current_player:

	\tl_set:Nn\l_pgfgo_parsed_x_coordinate_tl{#2}
	\tl_set:Nn\l_pgfgo_parsed_y_coordinate_tl{#3}
	\pgfgo_stone_render_shape:nn {#2} {#3}

	%-----MARCAS-------------------------
	\pgfscope
	\keys_set_groups:nnn {pgfgo / stone} {mark} {#1}
	\endpgfscope

	\group_end:
}



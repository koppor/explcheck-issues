%VUELVE A DIBUJAR JUGADAS RECORDADAS. #2 TRAE LAS OPCIONES ORIGINALES MAS from Y EL COLOR CON QUE EMPEZARON.
%SIN NUMEROS SI resume O \pgfgoview LOS ESCONDEN (SE DECIDE ACA: CON CAPTURAS, LA PIEDRA SE DIBUJA AL FINAL).
\cs_new_protected:Nn \pgfgo_move_parsed:nnn {
	\group_begin:
	\keys_set_groups:nnn { pgfgo / move} {player-id, first stone} {#2}
	\keys_set_groups:nnn { pgfgo / players / neutral / move} { label } {#2}
	\bool_if:nTF {#1 && ! \l_pgfgo_remember_hide_numbers_bool}
		{\clist_map_inline:nn {#3} {\pgfgo_move:nnn{\BooleanTrue}{#2}{##1}}}
		{\clist_map_inline:nn {#3} {\pgfgo_move:nnn{\BooleanFalse}{#2}{##1}}}
	\group_end:
}





%EL CODIGO QUE VUELVE A DIBUJAR LAS JUGADAS \l_tmpa_clist (#1: NUMERADAS, #2: OPCIONES). PARA UNA EXPANSION e.
\cs_new:Npn \__pgfgo_moves_code:nn #1#2 {
	\exp_not:N\pgfgo_move_parsed:nnn
		{#1}
		{
			\exp_not:n{#2},
			from = \pgfgo_kernel_move_number:,
			\__pgfgo_move_color:
		}
		{\exp_not:V\l_tmpa_clist}
}

%LAS JUGADAS DE \moves SON UNA SECUENCIA (CON ORDEN Y REPETICIONES), NO UN CONJUNTO COMO EN \stones: CADA
%ELEMENTO SE JUEGA EN SU ORDEN. LO QUE NO TIENE UN ORDEN FIJO (RECTANGULOS, r, *, ...) SE JUEGA COMO LO LEE
%EL KERNEL, CON UN AVISO; LOS GRUPOS QUE RESTAN (;) DAN ERROR. LAS COORDENADAS SE EXPANDEN CON e. DEJA LAS
%JUGADAS {x}{y} EN \l_pgfgo_kernel_points_seq.
\msg_new:nnn {pgfgo} {moves-subtract} {
	'#1'~subtracts~points~(;)~and~\iow_char:N\\moves~only~adds~them:~no~move~is~played.
}
\tl_new:N \l__pgfgo_moves_coordinates_tl

\cs_new_protected:Npn \__pgfgo_moves_points:n #1 {
	\tl_set:Ne \l__pgfgo_moves_coordinates_tl {#1}
	\tl_if_in:NnTF \l__pgfgo_moves_coordinates_tl {;} {
		\msg_error:nnV {pgfgo} {moves-subtract} \l__pgfgo_moves_coordinates_tl
		\seq_clear:N \l_pgfgo_kernel_points_seq
	} {
		\exp_args:NV \pgfgo_kernel_moves:n \l__pgfgo_moves_coordinates_tl
		\bool_if:NF \l_pgfgo_kernel_points_ordered_bool
			{\msg_warning:nnV {pgfgo} {unordered-coordinate} \l__pgfgo_moves_coordinates_tl}
	}
}

%\BooleanTrue O \BooleanFalse, SEGUN numbers.
\tl_new:N \l__pgfgo_moves_numbers_tl

\NewDocumentCommand{\moves}{O{}m}{
	\group_begin:
	\pgfgo_shift_reset:
	\__pgfgo_moves_points:n{#2} %Devuelve \l_pgfgo_kernel_points_seq

	\keys_set_groups:nnn { pgfgo / move} {preset, player-id, first stone} {#1}
	\pgfgo_shift_points:
	\keys_set_groups:nnn { pgfgo / players / neutral / move} { label } {#1}
	\tl_set:Ne \l__pgfgo_moves_numbers_tl
		{\bool_if:NTF \l_pgfgo_move_numbers_bool {\exp_not:N \BooleanTrue} {\exp_not:N \BooleanFalse}}
	%RECORDAR LAS PIEDRAS (CON EL NUMERO Y EL COLOR DE LA PRIMERA JUGADA), CON LOS NUMEROS COMO SE DIBUJAN.
	\clist_set_from_seq:NN \l_tmpa_clist\l_pgfgo_kernel_points_seq
	\pgfgo_remember:Nnn \l_pgfgo_goban_remember_move_bool {stone} {
		\bool_if:NF \l_pgfgo_goban_remember_move_label_bool {\exp_not:N \pgfgo_remember_numbers:n}
		{\__pgfgo_moves_code:nn {\exp_not:V \l__pgfgo_moves_numbers_tl} {#1}}
	}

	%-------------------------------------------------------------------------


	\seq_map_inline:Nn \l_pgfgo_kernel_points_seq
		{\exp_args:NV \pgfgo_move:nnnn \l__pgfgo_moves_numbers_tl {#1} ##1}
	\group_end:
}


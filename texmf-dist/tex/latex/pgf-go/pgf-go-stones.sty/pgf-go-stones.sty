%INTERSECCION DE LA PIEDRA QUE SE ESTA DIBUJANDO (LA USA LA CLAVE mark).
\tl_new:N \l_pgfgo_parsed_x_coordinate_tl
\tl_new:N \l_pgfgo_parsed_y_coordinate_tl



\keys_define:nn { pgfgo / stone }{
	forget						.code:n	=	{\bool_set_false:N\l_pgfgo_goban_remember_stone_bool},
	forget						.groups:n	=	{preset},

	black				.code:n		=	{\__pgfgo_stone_set_player:NNN \c_true_bool \c_false_bool \c_false_bool},
	black				.groups:n = { player-id },
	b						.code:n	= {\keys_set:nn{ pgfgo / stone }{black}},
	b						.groups:n = { player-id },


	white				.code:n		=	{\__pgfgo_stone_set_player:NNN \c_false_bool \c_true_bool \c_false_bool},
	white				.groups:n = { player-id },
	w						.code:n	= {\keys_set:nn{ pgfgo / stone }{white}},
	w						.groups:n = { player-id },

	neutral				.code:n		=	{\__pgfgo_stone_set_player:NNN \c_false_bool \c_false_bool \c_true_bool},
	neutral				.groups:n = { player-id },
	n						.code:n	= {\keys_set:nn{ pgfgo / stone }{neutral}},
	n						.groups:n = { player-id },

	%NO CUENTA EN LAS CAPTURAS. #1: OPCIONES DE ESTA PIEDRA (VER \__pgfgo_stone_prisoner_style:n).
	prisoner				.code:n	= {
		\bool_set_true:N \l__pgfgo_stone_prisoner_bool
		\tl_set:Nn \l__pgfgo_stone_prisoner_options_tl {#1}
	},
	prisoner				.groups:n = { captures-id },

	mark								.code:n = {
			\pgfgo_mark:nee{#1}{\l_pgfgo_parsed_x_coordinate_tl}{\l_pgfgo_parsed_y_coordinate_tl}
	},

	mark		.groups:n = {mark},

	shift				.code:n		= {\pgfgo_shift_set:n {#1}},
	shift				.groups:n	= {preset},
}

%shift = {<columnas>, <filas>}: \stones, \stone, \moves Y \marks MUEVEN LAS COORDENADAS (NO EL DIBUJO).
%HACIA LA DERECHA Y HACIA ARRIBA, SIN IMPORTAR LAS ETIQUETAS DEL BORDE. VALE SOLO PARA EL COMANDO: CADA
%UNO EMPIEZA EN 0.
\int_new:N \l_pgfgo_shift_x_int
\int_new:N \l_pgfgo_shift_y_int
\cs_new_protected:Npn \pgfgo_shift_set:n #1 {
	\int_set:Nn \l_pgfgo_shift_x_int {\clist_item:nn {#1} {1} + 0}
	\int_set:Nn \l_pgfgo_shift_y_int {\clist_item:nn {#1} {2} + 0}
}
\cs_new_protected:Npn \pgfgo_shift_reset: {
	\int_zero:N \l_pgfgo_shift_x_int
	\int_zero:N \l_pgfgo_shift_y_int
}

%DESPLAZA LOS PUNTOS {x}{y} DE \l_pgfgo_kernel_points_seq. LOS QUE QUEDAN FUERA DEL TABLERO SE SACAN CON
%UN AVISO (outside-board).
\cs_new_protected:Npn \pgfgo_shift_points: {
	\bool_lazy_and:nnF
		{\int_compare_p:nNn {\l_pgfgo_shift_x_int} = {0}}
		{\int_compare_p:nNn {\l_pgfgo_shift_y_int} = {0}}
		{
			\seq_clear:N \l__pgfgo_shift_seq
			\seq_map_inline:Nn \l_pgfgo_kernel_points_seq {\__pgfgo_shift_point:nn ##1}
			\seq_set_eq:NN \l_pgfgo_kernel_points_seq \l__pgfgo_shift_seq
		}
}
\seq_new:N \l__pgfgo_shift_seq
\cs_new_protected:Npn \__pgfgo_shift_point:nn #1#2 {
	\exp_args:Nee \__pgfgo_shift_point_aux:nn
		{\int_eval:n {#1 + \l_pgfgo_shift_x_int}} {\int_eval:n {#2 + \l_pgfgo_shift_y_int}}
}
\cs_new_protected:Npn \__pgfgo_shift_point_aux:nn #1#2 {
	\bool_lazy_and:nnTF
		{\int_compare_p:n {1 <= #1 <= \l_pgfgo_goban_size_x_int}}
		{\int_compare_p:n {1 <= #2 <= \l_pgfgo_goban_size_y_int}}
		{\seq_put_right:Nn \l__pgfgo_shift_seq {{#1}{#2}}}
		{\msg_warning:nnnn {pgfgo} {outside-board} {#1} {#2}}
}

%#1, #2, #3: SI LA PIEDRA ES NEGRA, BLANCA, NEUTRAL.
\cs_new_protected:Npn \__pgfgo_stone_set_player:NNN #1#2#3 {
	\bool_set_eq:NN	\l_pgfgo_players_black_bool		#1
	\bool_set_eq:NN	\l_pgfgo_players_white_bool		#2
	\bool_set_eq:NN	\l_pgfgo_players_neutral_bool	#3
}



\bool_new:N \l_pgfgo_move_numbers_bool
\keys_define:nn { pgfgo / move} {
	forget						.code:n	=	{\bool_set_false:N\l_pgfgo_goban_remember_move_bool},
	forget						.groups:n	=	{preset, local},


	%FIJAN DE QUIEN ES EL TURNO; LAS JUGADAS SIGUIENTES ALTERNAN DESDE AHI.
	black			.code:n			= {\pgfgo_kernel_move_set_player:n {black}},
	black			.groups:n		= {player-id},
	b						.code:n	= {\keys_set:nn{ pgfgo / move }{black}},
	b						.groups:n = { player-id, local },


	white			.code:n			= {\pgfgo_kernel_move_set_player:n {white}},
	white			.groups:n		= { player-id },
	w						.code:n	= {\keys_set:nn{ pgfgo / move }{white}},
	w						.groups:n = { player-id, local },


	from				.code:n			=	{\pgfgo_kernel_move_set_number:n {#1}},
	from				.groups:n		= {first stone, preset, local},

	shift				.code:n			= {\pgfgo_shift_set:n {#1}},
	shift				.groups:n		= {preset},


	%SI LAS JUGADAS LLEVAN SU NUMERO. ES ESTILO: \pgfgoset{move = {numbers = false}} VALE PARA TODAS.
	numbers			.bool_set:N		= \l_pgfgo_move_numbers_bool,
	numbers			.default:n		= {true},
	numbers			.initial:n		= {true},
	numbers			.groups:n		= {preset},
}







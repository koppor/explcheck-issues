\cs_new_protected:Npn \pgfgo_notes_begin: {
	\seq_gclear:N \g_pgfgo_move_notes_seq
	\prop_gclear:N \g__pgfgo_notes_number_prop
	\prop_gclear:N \g__pgfgo_notes_code_prop
}

%(#1,#2) ESTA EN LA PARTE VISIBLE (SIN AVISAR SI ESTA FUERA DEL TABLERO).
\prg_new_conditional:Npnn \__pgfgo_notes_if_visible:nn #1#2 {p} {
	\bool_if:nTF {
		\int_compare_p:n {\l_pgfgo_goban_from_x_int <= #1 <= \l_pgfgo_goban_to_x_int} &&
		\int_compare_p:n {\l_pgfgo_goban_from_y_int <= #2 <= \l_pgfgo_goban_to_y_int}
	} {\prg_return_true:} {\prg_return_false:}
}

%ANTES DE JUGAR: DECIDE SI LA JUGADA (#1: NUMERADA, #2: OPCIONES, #3,#4: PUNTO) SE ANOTA EN VEZ DE
%DIBUJARSE (\l__pgfgo_notes_noted_bool), O LA REGISTRA COMO LA PRIMERA JUGADA NUMERADA DEL PUNTO.
\cs_new_protected:Npn \__pgfgo_notes_check:nnnn #1#2#3#4 {
	\bool_set_false:N \l__pgfgo_notes_noted_bool
	\bool_lazy_and:nnT {\l_pgfgo_goban_notes_bool} {\__pgfgo_notes_if_visible_p:nn {#3} {#4}} {
		\IfBooleanT {#1} {
			\__pgfgo_captures_key:nn {#3} {#4}
			\prop_get:NVNTF \g__pgfgo_notes_number_prop \l__pgfgo_captures_key_tl \l__pgfgo_notes_tl {
				\bool_set_true:N \l__pgfgo_notes_noted_bool
				\seq_gput_right:Ne \g_pgfgo_move_notes_seq
					{{\pgfgo_kernel_move_number:} {\exp_not:V \l__pgfgo_notes_tl}}
			}{
				\prop_gput:NVe \g__pgfgo_notes_number_prop \l__pgfgo_captures_key_tl
					{\pgfgo_kernel_move_number:}
				\prop_gput:NVe \g__pgfgo_notes_code_prop \l__pgfgo_captures_key_tl
					{\__pgfgo_move_code:nnnn {#1} {#2} {#3} {#4}}
			}
		}
	}
}

%ANOTA QUE LA JUGADA ACTUAL ES UN PASE ({N}{}, QUE \pgfgomovenotes ESCRIBE "N: pass").
\cs_new_protected:Npn \pgfgo_notes_pass: {
	\seq_gput_right:Ne \g_pgfgo_move_notes_seq {{\pgfgo_kernel_move_number:} {}}
}

%CON CAPTURAS: VUELVE A DIBUJAR LA PRIMERA JUGADA NUMERADA DEL PUNTO.
\cs_new_protected:Npn \__pgfgo_notes_show_first:nn #1#2 {
	\__pgfgo_captures_key:nn {#1} {#2}
	\prop_get:NVNT \g__pgfgo_notes_code_prop \l__pgfgo_captures_key_tl \l__pgfgo_notes_tl {
		\prop_gput:NVV \g__pgfgo_captures_pending_prop \l__pgfgo_captures_key_tl \l__pgfgo_notes_tl
		\prop_gremove:NV \g__pgfgo_captures_faded_prop \l__pgfgo_captures_key_tl
	}
}

\keys_define:nn {pgfgo / notes} {
	at					.tl_set:N		= \l_pgfgo_notes_at_tl,
	at					.initial:n	= {\pgfgo_text:n {at}},
	pass				.tl_set:N		= \l_pgfgo_notes_pass_tl,
	pass				.initial:n	= {\pgfgo_text:n {pass}},
	separator		.tl_set:N		= \l_pgfgo_notes_separator_tl,
	separator		.initial:n	= {,~},
	%VACIA: LA DEL TEXTO (EN \sgfdiagrams Y \sgfproblem, LA DEL EPIGRAFE).
	font				.tl_set:N		= \l_pgfgo_notes_font_tl,
}
\keys_define:nn {pgfgo} {
	notes				.code:n			= {\keys_set:nn {pgfgo / notes} {#1}}
}

%UNA NOTA: "N at M", O "N: pass" SI M ESTA VACIO.
\cs_new_protected:Npn \__pgfgo_notes_item:nn #1#2 {
	\tl_if_empty:nTF {#2}
		{\seq_put_right:Nn \l_tmpa_seq {#1 : \nobreakspace \l_pgfgo_notes_pass_tl}}
		{\seq_put_right:Nn \l_tmpa_seq {#1 \nobreakspace \l_pgfgo_notes_at_tl \nobreakspace #2}}
}

\NewDocumentCommand \pgfgomovenotes {O{}} {
	\group_begin:
		\keys_set:nn {pgfgo / notes} {#1}
		\seq_clear:N \l_tmpa_seq
		\seq_map_inline:Nn \g_pgfgo_move_notes_seq {
			\__pgfgo_notes_item:nn ##1
		}
		\l_pgfgo_notes_font_tl
		\seq_use:Nn \l_tmpa_seq {\l_pgfgo_notes_separator_tl}
	\group_end:
}

%\pgfgoprisoners{black | white} ESCRIBE LOS PRISIONEROS DEL JUGADOR EN EL ULTIMO goban CON CAPTURAS. CON
%OTRO JUGADOR, UN ERROR Y 0.
\msg_new:nnn {pgfgo} {unknown-prisoners-player}
	{Unknown~player~'#1'~in~\iow_char:N\\pgfgoprisoners~(black,~b,~white~or~w):~the~number~is~0.}
\NewDocumentCommand \pgfgoprisoners {m} {
	\pgfgo_kernel_if_feature:nTF {captures}
		{
			\str_case:enF {\tl_trim_spaces:n {#1}} {{b} {} {black} {} {w} {} {white} {}}
				{\msg_error:nnn {pgfgo} {unknown-prisoners-player} {#1}}
			\exp_args:Ne \pgfgo_kernel_prisoners:n
				{\str_case:enF {\tl_trim_spaces:n {#1}} {{b} {black} {w} {white}} {\tl_trim_spaces:n {#1}}}
		}
		{\pgfgo_kernel_require:n {captures}}
}
\cs_generate_variant:Nn \str_case:nnF {e}

%DIBUJA LO QUE QUEDO, AL CERRAR EL goban. CON \l_pgfgo_captures_overlay_bool (ANIMACIONES POR CAPAS) NO
%DIBUJA NADA: LAS PIEDRAS VAN EN SUS PROPIAS CAPAS.
\bool_new:N \l_pgfgo_captures_overlay_bool
%CON \l_pgfgo_captures_collect_bool LAS PIEDRAS SE GUARDAN, PERO NINGUNA SE QUITA (goban SIN captures).
\bool_new:N \l_pgfgo_captures_collect_bool
\cs_new_protected:Npn \pgfgo_captures_end: {
	\bool_if:NF \l_pgfgo_captures_overlay_bool {\__pgfgo_captures_draw:}
}
\cs_new_protected:Npn \__pgfgo_captures_draw: {
	\prop_map_inline:Nn \g__pgfgo_captures_pending_prop {
		\group_begin:
			\prop_if_in:NnT \g__pgfgo_captures_faded_prop {##1}
				{\bool_set_true:N \l__pgfgo_captures_fade_bool}
			##2
		\group_end:
	}
	%LAS MARCAS VAN DESPUES: LA SECUENCIA DE CADA UNA SE FIJA AL DIBUJARLA.
	\prop_map_inline:Nn \g__pgfgo_captures_marks_prop {
		\group_begin: ##2 \group_end:
	}
}

\cs_new:Nn \pgfgo_stone:nn {\pgfgo_stone:nnn{#1}#2}



\DeclareDocumentCommand{\stone}{O{}m}{
	\group_begin:
	\pgfgo_shift_reset:
	\keys_set_groups:nnn{ pgfgo / stone }{ preset }{#1}
	\pgfgo_kernel_point:nTF {#2} { %Devuelve \l_pgfgo_kernel_point_tl
		\seq_clear:N \l_pgfgo_kernel_points_seq
		\seq_put_right:NV \l_pgfgo_kernel_points_seq \l_pgfgo_kernel_point_tl
		\pgfgo_shift_points:
		%\stone SIN JUGADOR DIBUJA UNA PIEDRA NEUTRAL, COMO \stones.
		\seq_map_inline:Nn \l_pgfgo_kernel_points_seq {
			%RECORDAR LAS PIEDRAS
			\pgfgo_remember:Nnn \l_pgfgo_goban_remember_stone_bool {stone}
				{\exp_not:N\pgfgo_stone:nn{neutral, \exp_not:n{#1}}{\exp_not:n {##1}}}

			\pgfgo_stone:nn{neutral, #1}{##1}
		}
	}{
		\msg_warning:nnn {pgfgo} {unknown-coordinate} {#2}
	}
	\group_end:
}


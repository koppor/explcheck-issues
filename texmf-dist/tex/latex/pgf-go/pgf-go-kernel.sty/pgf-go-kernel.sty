%	\pgfgo_kernel_extent_clear:
%		EMPIEZA SIN NADA DIBUJADO.
%	\pgfgo_kernel_extent_add:nn {x}{y}
%		SUMA EL PUNTO (SI ESTA EN EL TABLERO) AL RECTANGULO DE LO DIBUJADO.
%	\pgfgo_kernel_extent_window:n {margen}
%		FIJA LA PARTE VISIBLE (Y \l_pgfgo_goban_partial_bool): EL RECTANGULO DE LO DIBUJADO, margen LINEAS MAS
%		GRANDE. UN LADO QUE QUEDA A DOS LINEAS O MENOS DEL BORDE LLEGA HASTA EL. SIN NADA DIBUJADO, TODO EL
%		TABLERO. EL RECTANGULO ES GLOBAL: LO SUMAN LAS PIEDRAS Y MARCAS DE ADENTRO DE LOS GRUPOS.
\int_new:N \g__pgfgo_kernel_extent_from_x_int
\int_new:N \g__pgfgo_kernel_extent_from_y_int
\int_new:N \g__pgfgo_kernel_extent_to_x_int
\int_new:N \g__pgfgo_kernel_extent_to_y_int
\bool_new:N \g__pgfgo_kernel_extent_bool

\cs_new_protected:Npn \pgfgo_kernel_extent_clear: {
	\bool_gset_false:N \g__pgfgo_kernel_extent_bool
}

\cs_new_protected:Npn \pgfgo_kernel_extent_add:nn #1#2 {
	\bool_lazy_and:nnT
		{\int_compare_p:n {1 <= #1 <= \l_pgfgo_goban_size_x_int}}
		{\int_compare_p:n {1 <= #2 <= \l_pgfgo_goban_size_y_int}}
		{
			\bool_if:NTF \g__pgfgo_kernel_extent_bool
				{
					\int_gset:Nn \g__pgfgo_kernel_extent_from_x_int {\int_min:nn {\g__pgfgo_kernel_extent_from_x_int} {#1}}
					\int_gset:Nn \g__pgfgo_kernel_extent_from_y_int {\int_min:nn {\g__pgfgo_kernel_extent_from_y_int} {#2}}
					\int_gset:Nn \g__pgfgo_kernel_extent_to_x_int {\int_max:nn {\g__pgfgo_kernel_extent_to_x_int} {#1}}
					\int_gset:Nn \g__pgfgo_kernel_extent_to_y_int {\int_max:nn {\g__pgfgo_kernel_extent_to_y_int} {#2}}
				}
				{
					\bool_gset_true:N \g__pgfgo_kernel_extent_bool
					\int_gset:Nn \g__pgfgo_kernel_extent_from_x_int {#1}
					\int_gset:Nn \g__pgfgo_kernel_extent_from_y_int {#2}
					\int_gset:Nn \g__pgfgo_kernel_extent_to_x_int {#1}
					\int_gset:Nn \g__pgfgo_kernel_extent_to_y_int {#2}
				}
		}
}

\cs_new:Npn \__pgfgo_kernel_extent_low:nn #1#2 {
	\int_compare:nNnTF {#1 - #2} > {3} {#1 - #2} {1}
}
\cs_new:Npn \__pgfgo_kernel_extent_high:nnn #1#2#3 {
	\int_compare:nNnTF {#1 + #2} < {#3 - 2} {#1 + #2} {#3}
}
\cs_new_protected:Npn \pgfgo_kernel_extent_window:n #1 {
	\bool_set_true:N \l_pgfgo_goban_partial_bool
	\bool_if:NTF \g__pgfgo_kernel_extent_bool
		{
			\int_set:Nn \l_pgfgo_goban_from_x_int {\__pgfgo_kernel_extent_low:nn {\g__pgfgo_kernel_extent_from_x_int} {#1}}
			\int_set:Nn \l_pgfgo_goban_from_y_int {\__pgfgo_kernel_extent_low:nn {\g__pgfgo_kernel_extent_from_y_int} {#1}}
			\int_set:Nn \l_pgfgo_goban_to_x_int
				{\__pgfgo_kernel_extent_high:nnn {\g__pgfgo_kernel_extent_to_x_int} {#1} {\l_pgfgo_goban_size_x_int}}
			\int_set:Nn \l_pgfgo_goban_to_y_int
				{\__pgfgo_kernel_extent_high:nnn {\g__pgfgo_kernel_extent_to_y_int} {#1} {\l_pgfgo_goban_size_y_int}}
		}
		{
			\int_set:Nn \l_pgfgo_goban_from_x_int {1}
			\int_set:Nn \l_pgfgo_goban_from_y_int {1}
			\int_set_eq:NN \l_pgfgo_goban_to_x_int \l_pgfgo_goban_size_x_int
			\int_set_eq:NN \l_pgfgo_goban_to_y_int \l_pgfgo_goban_size_y_int
		}
}



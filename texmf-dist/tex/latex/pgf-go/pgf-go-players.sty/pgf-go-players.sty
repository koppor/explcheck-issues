%LAS CLAVES Y VARIABLES DEL JUGADOR #1 (tests/check_docs.py LEE players/#1 COMO players/<player>).
%CLAVES: /pgfgo/players/<player>
\cs_new_protected:Npn \__pgfgo_players_new:n #1 {
	%SIRVE PARA DETERMINAR SI UNA PIEDRA ES O NO DE ESTE JUGADOR
	\bool_new:c {l_pgfgo_players_ #1 _bool}

	\keys_define:nn {pgfgo / players}
		{#1 .code:n = {\keys_set:nn {pgfgo / players / #1} {##1}}}

	\keys_define:nn { pgfgo / players / #1 } {
		stone                   .code:n = {\keys_set:nn {pgfgo / players / #1 / stone}         {##1}},
		move                    .code:n = {\keys_set:nn {pgfgo / players / #1 / move}          {##1}},
		mark                    .code:n = {\keys_set:nn {pgfgo / players / #1 / mark}          {##1}},
		territory           		.code:n = {\keys_set:nn {pgfgo / players / #1 / territory} 		 {##1}},
		%EL PERFIL DE JUGADOR (VER pgf-go-profiles.sty).
		profile									.code:n = {\pgfgo_profile_use_player:nn {#1} {##1}},
	}



	%----------------------------------------------------------------------------------------------------
	%PIEDRA
	\dim_new:c {l_pgfgo_players_ #1 _stone_radius_dim}
	\fp_new:c {l_pgfgo_players_ #1 _stone_scale_fp}
	%EL ESTILO DE SUS PRISIONEROS (VER \__pgfgo_stone_prisoner_style:n EN pgf-go-stones.sty).
	\tl_new:c {l_pgfgo_players_ #1 _stone_prisoner_tl}

	\keys_define:nn { pgfgo / players / #1 / stone } {
		prisoner						.tl_set:c = {l_pgfgo_players_ #1 _stone_prisoner_tl},
		prisoner						.groups:n = { external },
		line								.code:n = {\keys_set:nn { pgfgo / players / #1 / stone / line } {##1}},
		line								.default:n = {true},
		fill 								.code:n = {\keys_set:nn { pgfgo / players / #1 / stone / fill } {##1}},
		fill								.default:n = {true},
		radius							.code:n = {\dim_set:cn{l_pgfgo_players_ #1 _stone_radius_dim}{##1}},
		radius							.initial:n = {5.5pt},
		scale								.code:n = {\fp_set:cn{l_pgfgo_players_ #1 _stone_scale_fp}{##1}},
		scale								.initial:n = {1},
		shadow							.code:n = {\keys_set:nn{ pgfgo / players / #1 / stone / shadow }{##1}},
		shadow							.default:n = {true},
		shine								.code:n = {\keys_set:nn{ pgfgo / players / #1 / stone / shine }{##1}},
		shine								.default:n = {true},
		image								.code:n = {\keys_set:nn{ pgfgo / players / #1 / stone / image }{##1}},
		%LAS DEMAS OPCIONES DE \stones Y \moves.
		mark							.groups:n	= { external },
		black								.groups:n = { external },
		b										.groups:n = { external },
		white								.groups:n = { external },
		w										.groups:n = { external },
		neutral							.groups:n = { external },
		n										.groups:n = { external },
		forget							.groups:n = { external },
		label								.groups:n = { external },
		from								.groups:n = { external },
		numbers							.groups:n = { external },
	}


	\bool_new:c {l_pgfgo_players_ #1 _stone_line_bool}
	\bool_set_true:c {l_pgfgo_players_ #1 _stone_line_bool}
	\tl_new:c 	{l_pgfgo_players_ #1 _stone_line_color_tl}
	\dim_new:c 	{l_pgfgo_players_ #1 _stone_line_width_dim}
	\fp_new:c 	{l_pgfgo_players_ #1 _stone_line_opacity_fp}

	\keys_define:nn { pgfgo / players / #1 / stone / line } {
		true 				.code:n 		= {\bool_set_true:c 	{l_pgfgo_players_ #1 _stone_line_bool}},
		false 			.code:n 		= {\bool_set_false:c 	{l_pgfgo_players_ #1 _stone_line_bool}},
		color				.code:n 		= {\tl_set:cn 				{l_pgfgo_players_ #1 _stone_line_color_tl}{##1}},
		color				.initial:n 	= {black},
		width				.code:n 		= {\dim_set:cn 				{l_pgfgo_players_ #1 _stone_line_width_dim}{##1}},
		width				.initial:n	= {0.7pt},
		opacity			.code:n 		= {\fp_set:cn 				{l_pgfgo_players_ #1 _stone_line_opacity_fp}{##1}},
		opacity			.initial:n	= {1}
	}



	\bool_new:c {l_pgfgo_players_ #1 _stone_fill_bool}
	\bool_set_true:c {l_pgfgo_players_ #1 _stone_fill_bool}
	\tl_new:c 	{l_pgfgo_players_ #1 _stone_fill_color_tl}
	\fp_new:c 	{l_pgfgo_players_ #1 _stone_fill_opacity_fp}

	\keys_define:nn { pgfgo / players / #1 / stone / fill } {
		true 				.code:n 		= {\bool_set_true:c 	{l_pgfgo_players_ #1 _stone_fill_bool}},
		false 			.code:n 		= {\bool_set_false:c 	{l_pgfgo_players_ #1 _stone_fill_bool}},
		color				.code:n 		= {\tl_set:cn 				{l_pgfgo_players_ #1 _stone_fill_color_tl}{##1}},
		color				.initial:n 	= {gray},
		opacity			.code:n 		= {\fp_set:cn 				{l_pgfgo_players_ #1 _stone_fill_opacity_fp}{##1}},
		opacity			.initial:n	=	{1}
	}



	\bool_new:c				{l_pgfgo_players_ #1 _stone_shadow_bool}
	\fp_new:c					{l_pgfgo_players_ #1 _stone_shadow_angle_fp}
	\dim_new:c				{l_pgfgo_players_ #1 _stone_shadow_offset_dim}
	\fp_new:c					{l_pgfgo_players_ #1 _stone_shadow_opacity_fp}
	\tl_new:c					{l_pgfgo_players_ #1 _stone_shadow_color_tl}
	\fp_new:c					{l_pgfgo_players_ #1 _stone_shadow_scale_fp}
	\tl_new:c					{l_pgfgo_players_ #1 _stone_shadow_image_tl}
	\tl_new:c					{l_pgfgo_players_ #1 _stone_shadow_image_width_tl}

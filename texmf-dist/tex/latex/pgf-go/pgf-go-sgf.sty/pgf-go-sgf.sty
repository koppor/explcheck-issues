\tl_new:N \l__pgfgo_sgfprob_black_tl
\tl_new:N \l__pgfgo_sgfprob_white_tl
\tl_new:N \l__pgfgo_sgfprob_player_tl
%LAS PARTIDAS DEL ARCHIVO (game = {1:20, 25}: UNA COLECCION DE PROBLEMAS), QUIEN JUEGA (to play) Y EL
%COMIENZO DEL EPIGRAFE DE CADA PROBLEMA ("Problem 3").
\seq_new:N \l__pgfgo_sgfprob_games_seq
\tl_new:N \l__pgfgo_sgfprob_to_play_tl
\tl_new:N \l__pgfgo_sgfprob_head_tl
%verdict: SI CADA SOLUCION ES CORRECTA O NO (\l__pgfgo_sgfprob_verdict_tl: correct, wrong O NADA).
\bool_new:N \l__pgfgo_sgfprob_verdict_bool
\tl_new:N \l__pgfgo_sgfprob_verdict_tl
\tl_new:N \l__pgfgo_sgfprob_position_tl
\tl_new:N \l__pgfgo_sgfprob_moves_tl
\bool_new:N \l__pgfgo_sgfprob_right_bool
\seq_new:N \l__pgfgo_sgfprob_paths_seq

\keys_define:nn {pgfgo / sgf~problem} {
	%alone: EL ENUNCIADO VA SOLO EN SU FILA, Y LAS VARIANTES DEBAJO.
	statement						.choices:nn	= {true, false, alone} {
		\bool_set:Nn \l__pgfgo_sgfprob_statement_bool {! \str_if_eq_p:Vn \l_keys_choice_tl {false}}
		\bool_set:Nn \l__pgfgo_sgfprob_alone_bool {\str_if_eq_p:Vn \l_keys_choice_tl {alone}}
	},
	statement						.default:n	= {true},
	statement						.initial:n	= {true},
	solutions						.bool_set:N	= \l__pgfgo_sgfprob_solutions_bool,
	solutions						.default:n	= {true},
	solutions						.initial:n	= {true},
	%EPIGRAFE DEL ENUNCIADO, ANTES DE QUIEN JUEGA ("Problem 3: Black to play").
	title								.tl_set:N		= \l__pgfgo_sgfprob_title_tl,
	variation~title			.tl_set:N		= \l__pgfgo_sgfprob_variation_title_tl,
	variation~title			.initial:n	= {\pgfgo_text:n {variation}},
	black~to~play				.tl_set:N		= \l__pgfgo_sgfprob_black_tl,
	black~to~play				.initial:n	= {\pgfgo_text:n {black~to~play}},
	white~to~play				.tl_set:N		= \l__pgfgo_sgfprob_white_tl,
	white~to~play				.initial:n	= {\pgfgo_text:n {white~to~play}},
	%COMO EN \sgfdiagrams (PERO CON LOS COMENTARIOS: ASI SE VE CUALES LINEAS SON CORRECTAS).
	goban								.tl_set:N		= \l__pgfgo_sgfprob_goban_tl,
	caption							.code:n			= {\keys_set:nn {pgfgo / sgf~problem / caption} {#1}},
	notes								.bool_set:N	= \l__pgfgo_sgfprob_notes_bool,
	notes								.default:n	= {true},
	notes								.initial:n	= {true},
	comments						.code:n			= {\keys_set:nn {pgfgo / sgf~problem / comments} {#1}},
	comments						.default:n	= {true},
	annotations					.bool_set:N	= \l__pgfgo_sgfprob_annotations_bool,
	annotations					.default:n	= {true},
	chat								.bool_set:N	= \l__pgfgo_sgfprob_chat_bool,
	chat								.default:n	= {true},
	%UNA PARTIDA, O VARIAS ({1:20, 25}): PRIMERO TODOS LOS ENUNCIADOS Y DESPUES LAS SOLUCIONES.
	game								.code:n			= {\__pgfgo_sgfprob_games:n {#1}},
	%auto: PL O EL COLOR DE LA PRIMERA JUGADA. none: EL EPIGRAFE NO DICE QUIEN JUEGA.
	to~play							.choices:nn	= {auto, black, white, none}
		{\tl_set_eq:NN \l__pgfgo_sgfprob_to_play_tl \l_keys_choice_tl},
	to~play							.initial:n	= {auto},
	%EL EPIGRAFE DE CADA SOLUCION DICE SI ES CORRECTA, SEGUN SUS ANOTACIONES (VER \__pgfgo_sgfprob_verdict:n).
	verdict							.bool_set:N	= \l__pgfgo_sgfprob_verdict_bool,
	verdict							.default:n	= {true},
	verdict							.initial:n	= {false},
	%LA VISTA DEL ARCHIVO (VW). SI NO HAY, CON partial = auto SE MUESTRA SOLO LA PARTE DEL TABLERO QUE USA EL
	%PROBLEMA.
	view								.bool_set:N	= \l__pgfgo_sgfprob_view_bool,
	view								.default:n	= {true},
	view								.initial:n	= {true},
	partial							.choices:nn	= {auto, false}
		{\bool_set:Nn \l__pgfgo_sgfprob_partial_bool {\str_if_eq_p:Vn \l_keys_choice_tl {auto}}},
	partial							.initial:n	= {auto},
	layout							.code:n			= {\tl_put_right:Nn \l__pgfgo_sgfprob_layout_tl {, #1}},
}
%COMO EN \sgfdiagrams (SIN root: EL COMENTARIO DE LA RAIZ VA CON EL ENUNCIADO).
\keys_define:nn {pgfgo / sgf~problem / comments} {
	true								.code:n			= {\bool_set_true:N \l__pgfgo_sgfprob_comments_bool},
	false								.code:n			= {\bool_set_false:N \l__pgfgo_sgfprob_comments_bool},
	font								.tl_set:N		= \l__pgfgo_sgfprob_comment_font_tl,
	align								.code:n			= {\__pgfgo_sgfdiag_comment_align:Nn \l__pgfgo_sgfprob_comment_align_tl {#1}},
	align								.initial:n	= {left},
	number							.code:n			= {\cs_set:Npn \__pgfgo_sgfprob_comment_number:n ##1 {#1}},
	number							.initial:n	= {\textbf{#1}:~},
	separator						.tl_set:N		= \l__pgfgo_sgfprob_comment_separator_tl,
	separator						.initial:n	= {\par},
	position						.choices:nn	= {below, right, left, after}
		{\tl_set_eq:NN \l__pgfgo_sgfprob_comment_position_tl \l_keys_choice_tl},
	height							.tl_set:N		= \l__pgfgo_sgfprob_comment_height_tl,
	height							.initial:n	= {none},
	position						.initial:n	= {below},
	width							.tl_set:N		= \l__pgfgo_sgfprob_comment_width_tl,
	width							.initial:n	= {auto},
	sep								.dim_set:N	= \l__pgfgo_sgfprob_comment_sep_dim,
	sep								.initial:n	= {1em},
}
\bool_set_true:N \l__pgfgo_sgfprob_comments_bool
\keys_define:nn {pgfgo / sgf~problem / caption} {
	font								.tl_set:N		= \l__pgfgo_sgfprob_font_tl,
	font								.initial:n	= {\small},
	min~width					.tl_set:N		= \l__pgfgo_sgfprob_caption_min_tl,
	min~width					.initial:n	= {8em},
}
\keys_define:nn {pgfgo} {
	sgf~problem					.code:n			= {\keys_set:nn {pgfgo / sgf~problem} {#1}}
}

%QUIEN JUEGA: EL PL DEL PRINCIPIO O, SI NO ESTA, EL COLOR DE LA PRIMERA JUGADA.
\cs_new_protected:Npn \__pgfgo_sgfprob_player:nnn #1#2#3 {
	\str_case:nnT {#1} {
		{player}	{\tl_set:Nn \l__pgfgo_sgfprob_player_tl {#2}}
		{black}		{\tl_set:Nn \l__pgfgo_sgfprob_player_tl {black}}
		{white}		{\tl_set:Nn \l__pgfgo_sgfprob_player_tl {white}}
	}{
		\seq_map_break:
	}
}

%LA PARTE VISIBLE ES LA MISMA EN TODOS LOS DIAGRAMAS: LA VISTA INICIAL DEL ARCHIVO #1, O LA DE partial = auto.
\cs_new_protected:Npn \__pgfgo_sgfprob_window:n #1 {
	\tl_clear:N \l__pgfgo_sgfdiag_window_tl
	\int_zero:N \l_pgfgo_goban_sgf_view_from_int
	\int_zero:N \l_pgfgo_goban_sgf_view_to_int
	\tl_clear:N \l_pgfgo_goban_sgf_view_variation_tl
	\bool_lazy_and:nnTF {\l__pgfgo_sgfprob_view_bool} {! \tl_if_empty_p:N \l_pgfgo_kernel_sgf_view_tl}
		{\tl_set:Nn \l__pgfgo_sgfdiag_window_tl {sgf~view = {#1}}}
		{\bool_if:NT \l__pgfgo_sgfprob_partial_bool {\tl_set:Nn \l__pgfgo_sgfdiag_window_tl {partial = auto}}}
}

%LAS PARTIDAS DE game: NUMEROS Y RANGOS (3:7, COMO LOS DE LAS COORDENADAS), SEPARADOS POR COMAS. LOS : DEL
%DOCUMENTO NO SON LETRAS: SE SEPARA CON \c_colon_str.
\cs_generate_variant:Nn \seq_set_split:Nnn {NV}
\cs_new_protected:Npn \__pgfgo_sgfprob_games:n #1 {
	\seq_clear:N \l__pgfgo_sgfprob_games_seq
	\clist_map_inline:nn {#1} {
		\seq_set_split:NVn \l_tmpa_seq \c_colon_str {##1}
		\int_step_inline:nnn {\seq_item:Nn \l_tmpa_seq {1}} {\seq_item:Nn \l_tmpa_seq {-1}}
			{\seq_put_right:Nn \l__pgfgo_sgfprob_games_seq {####1}}
	}
	\seq_get_left:NNT \l__pgfgo_sgfprob_games_seq \l_tmpa_tl
		{\int_set:Nn \l_pgfgo_kernel_sgf_game_int {\l_tmpa_tl}}
}

\cs_generate_variant:Nn \str_case:nnF {V}
%LEE EL PROBLEMA DEL ARCHIVO #1 (LA PARTIDA \l_pgfgo_kernel_sgf_game_int): SUS LINEAS, SU TAMANO, QUIEN JUEGA Y
%LA PARTE VISIBLE.
\cs_new_protected:Npn \__pgfgo_sgfprob_prepare:n #1 {
	\__pgfgo_sgf_extent:n {#1}
	\seq_set_eq:NN \l__pgfgo_sgfprob_paths_seq \l_pgfgo_kernel_sgf_paths_seq
	\pgfgo_kernel_sgf_read:n {#1}
	\__pgfgo_sgf_size:N \l__pgfgo_sgfdiag_size_tl
	\tl_clear:N \l__pgfgo_sgfprob_player_tl
	\str_case:VnF \l__pgfgo_sgfprob_to_play_tl {
		{auto}	{\seq_map_inline:Nn \l_pgfgo_kernel_sgf_moves_seq {\__pgfgo_sgfprob_player:nnn ##1}}
		{none}	{}
	}{
		\tl_set_eq:NN \l__pgfgo_sgfprob_player_tl \l__pgfgo_sgfprob_to_play_tl
	}
	\__pgfgo_sgfprob_window:n {#1}
}

%EL COMIENZO DEL EPIGRAFE DEL PROBLEMA #1: title; CON VARIAS PARTIDAS, title (O "Problem") Y EL NUMERO.
\cs_new_protected:Npn \__pgfgo_sgfprob_head:n #1 {
	\int_compare:nNnTF {\seq_count:N \l__pgfgo_sgfprob_games_seq} > {1}
		{
			\tl_set:Ne \l__pgfgo_sgfprob_head_tl {
				\tl_if_empty:NTF \l__pgfgo_sgfprob_title_tl
					{\exp_not:n {\pgfgo_text:n {problem}}} {\exp_not:V \l__pgfgo_sgfprob_title_tl}
				\exp_not:N \nobreakspace #1
			}
		}
		{\tl_set_eq:NN \l__pgfgo_sgfprob_head_tl \l__pgfgo_sgfprob_title_tl}
}

%EL ENUNCIADO: LA POSICION INICIAL, QUIEN JUEGA Y EL COMENTARIO DE LA RAIZ.
\cs_new_protected:Npn \__pgfgo_sgfprob_statement: {
	\tl_clear:N \l__pgfgo_sgfdiag_variation_tl
	\__pgfgo_sgfdiag_draw:nnnn {1} {0}
		{
			%LOS DOS PUNTOS, SOLO SI DESPUES SE DICE QUIEN JUEGA.
			\tl_use:N \l__pgfgo_sgfprob_head_tl
			\tl_if_empty:NF \l__pgfgo_sgfprob_player_tl {
				\tl_if_empty:NF \l__pgfgo_sgfprob_head_tl {:~}
				\str_case:Vn \l__pgfgo_sgfprob_player_tl {
					{black} {\l__pgfgo_sgfprob_black_tl}
					{white} {\l__pgfgo_sgfprob_white_tl}
				}
			}
		}
		{
			\bool_if:NT \l__pgfgo_sgfdiag_comments_bool {
				\__pgfgo_sgf_if_comment:nT {0}
					{\__pgfgo_sgfdiag_comments_below:n {\__pgfgo_sgf_comment_use:}}
			}
		}
	\bool_if:NTF \l__pgfgo_sgfprob_alone_bool
		{\pgfgo_layout_add_alone:N \l__pgfgo_sgfdiag_cell_box}
		{\pgfgo_layout_add:N \l__pgfgo_sgfdiag_cell_box}
}

%SI LA LINEA LEIDA (JUGADAS 0 A #1) ES CORRECTA PARA QUIEN JUEGA: EL ULTIMO GB O GW (POSICION BUENA PARA
%NEGRO O BLANCO); SI NO HAY, LA PRIMERA JUGADA CON TE O BM (LAS IMPARES SON DE QUIEN JUEGA: SU BM ES UN
%ERROR, EL DEL RIVAL NO); SI NO, "RIGHT" EN UN COMENTARIO (COMO EN goproblems.com). SI NO, NADA.
\cs_generate_variant:Nn \str_if_in:nnT {ee}
\cs_new_protected:Npn \__pgfgo_sgfprob_verdict:n #1 {
	\tl_clear:N \l__pgfgo_sgfprob_position_tl
	\tl_clear:N \l__pgfgo_sgfprob_moves_tl
	\bool_set_false:N \l__pgfgo_sgfprob_right_bool
	\int_step_inline:nnn {0} {#1} {
		\pgfgo_kernel_sgf_annotations:n {##1}
		\seq_map_inline:Nn \l_pgfgo_kernel_sgf_annotations_seq {\__pgfgo_sgfprob_judge:nnn {##1} ####1}
		\str_if_in:eeT {\pgfgo_kernel_sgf_comment:nn {##1} {true}} {RIGHT}
			{\bool_set_true:N \l__pgfgo_sgfprob_right_bool}
	}
	\tl_set:Ne \l__pgfgo_sgfprob_verdict_tl {
		\tl_if_empty:NTF \l__pgfgo_sgfprob_position_tl
			{
				\tl_if_empty:NTF \l__pgfgo_sgfprob_moves_tl
					{\bool_if:NT \l__pgfgo_sgfprob_right_bool {correct}}
					{\tl_use:N \l__pgfgo_sgfprob_moves_tl}
			}
			{\tl_use:N \l__pgfgo_sgfprob_position_tl}
	}
}
%LA ANOTACION #2 (CON VALOR #3) DE LA JUGADA #1.
\cs_new_protected:Npn \__pgfgo_sgfprob_judge:nnn #1#2#3 {
	\str_case:nn {#2} {
		{GB} {\__pgfgo_sgfprob_position:n {black}}
		{GW} {\__pgfgo_sgfprob_position:n {white}}
		{TE} {\__pgfgo_sgfprob_move:nnn {#1} {correct} {wrong}}
		{BM} {\__pgfgo_sgfprob_move:nnn {#1} {wrong} {correct}}
	}
}
\cs_new_protected:Npn \__pgfgo_sgfprob_position:n #1 {
	\tl_if_empty:NF \l__pgfgo_sgfprob_player_tl {
		\tl_set:Ne \l__pgfgo_sgfprob_position_tl
			{\str_if_eq:VnTF \l__pgfgo_sgfprob_player_tl {#1} {correct} {wrong}}
	}
}
%LA JUGADA #1: #2 SI ES DE QUIEN JUEGA (IMPAR), #3 SI ES DEL RIVAL. SOLO CUENTA LA PRIMERA.
\cs_new_protected:Npn \__pgfgo_sgfprob_move:nnn #1#2#3 {
	\bool_lazy_and:nnT {\tl_if_empty_p:N \l__pgfgo_sgfprob_moves_tl} {\int_compare_p:nNn {#1} > {0}} {
		\tl_set:Ne \l__pgfgo_sgfprob_moves_tl {\int_if_odd:nTF {#1} {#2} {#3}}
	}
}

%EL DIAGRAMA DE LA LINEA #2 (#1 ES SU NUMERO).
\cs_new_protected:Npn \__pgfgo_sgfprob_solution:nn #1#2 {
	\tl_set:Nn \l__pgfgo_sgfdiag_variation_tl {#2}
	\pgfgo_kernel_sgf_read:nn {\l__pgfgo_sgfdiag_file_tl} {#2}
	\__pgfgo_sgf_count_moves:Nn \l__pgfgo_sgfprob_last_int {\c_max_int}
	\tl_clear:N \l__pgfgo_sgfprob_verdict_tl
	\bool_if:NT \l__pgfgo_sgfprob_verdict_bool {\__pgfgo_sgfprob_verdict:n {\l__pgfgo_sgfprob_last_int}}
	\int_compare:nNnT {\l__pgfgo_sgfprob_last_int} > {0} {
		\__pgfgo_sgfdiag_add:nnnn {1} {\l__pgfgo_sgfprob_last_int}
			{
				\int_compare:nNnT {\seq_count:N \l__pgfgo_sgfprob_games_seq} > {1} {\l__pgfgo_sgfprob_head_tl :~}
				\l__pgfgo_sgfprob_variation_title_tl \nobreakspace #1
				\tl_if_empty:NF \l__pgfgo_sgfprob_verdict_tl
					{\nobreakspace (\exp_args:Ne \pgfgo_text:n {\l__pgfgo_sgfprob_verdict_tl})}
			}
			{\__pgfgo_sgfdiag_notes:nn {1} {\l__pgfgo_sgfprob_last_int}}
	}
}

\cs_new_protected:Npn \pgfgo_sgfproblem:nn #1#2 {
	\group_begin:
		\pgfgo_sgf_use_name:n {#2}
		\keys_set:nn {pgfgo / sgf~problem} {#1}
		\bool_set_eq:NN \l__pgfgo_sgf_annotations_bool \l__pgfgo_sgfprob_annotations_bool
		\bool_set_eq:NN \l__pgfgo_sgf_chat_bool \l__pgfgo_sgfprob_chat_bool
		\__pgfgo_sgfdiag_begin:Nn \l__pgfgo_sgfprob_layout_tl {#2}
		\tl_set:Nn \l__pgfgo_sgfdiag_sgf_restart_tl {false}
		%LOS DIAGRAMAS DE UN PROBLEMA SIEMPRE VAN NUMERADOS, SIN MARCA DE LA ULTIMA JUGADA.
		\bool_set_true:N \l__pgfgo_sgfdiag_numbers_bool
		\tl_clear:N \l__pgfgo_sgfdiag_last_tl
		\tl_set_eq:NN \l__pgfgo_sgfdiag_goban_tl \l__pgfgo_sgfprob_goban_tl
		\tl_set_eq:NN \l__pgfgo_sgfdiag_font_tl \l__pgfgo_sgfprob_font_tl
		\tl_set_eq:NN \l__pgfgo_sgfdiag_caption_min_tl \l__pgfgo_sgfprob_caption_min_tl
		\bool_set_eq:NN \l__pgfgo_sgfdiag_notes_bool \l__pgfgo_sgfprob_notes_bool
		\bool_set_eq:NN \l__pgfgo_sgfdiag_comments_bool \l__pgfgo_sgfprob_comments_bool
		\tl_set_eq:NN \l__pgfgo_sgfdiag_comment_font_tl \l__pgfgo_sgfprob_comment_font_tl
		\tl_set_eq:NN \l__pgfgo_sgfdiag_comment_align_tl \l__pgfgo_sgfprob_comment_align_tl
		\tl_set_eq:NN \l__pgfgo_sgfdiag_comment_separator_tl \l__pgfgo_sgfprob_comment_separator_tl
		\tl_set_eq:NN \l__pgfgo_sgfdiag_comment_position_tl \l__pgfgo_sgfprob_comment_position_tl
		\tl_set_eq:NN \l__pgfgo_sgfdiag_comment_width_tl \l__pgfgo_sgfprob_comment_width_tl
		\dim_set_eq:NN \l__pgfgo_sgfdiag_comment_sep_dim \l__pgfgo_sgfprob_comment_sep_dim
		\tl_set_eq:NN \l__pgfgo_sgfdiag_comment_height_tl \l__pgfgo_sgfprob_comment_height_tl
		\cs_set_eq:NN \__pgfgo_sgfdiag_comment_number:n \__pgfgo_sgfprob_comment_number:n
		\bool_set_false:N \l__pgfgo_sgfdiag_root_bool
		\seq_if_empty:NT \l__pgfgo_sgfprob_games_seq
			{\seq_put_right:Ne \l__pgfgo_sgfprob_games_seq {\int_use:N \l_pgfgo_kernel_sgf_game_int}}
		%PRIMERO LOS ENUNCIADOS DE TODAS LAS PARTIDAS, DESPUES LAS SOLUCIONES.
		\bool_if:NT \l__pgfgo_sgfprob_statement_bool {
			\seq_map_inline:Nn \l__pgfgo_sgfprob_games_seq {
				\int_set:Nn \l_pgfgo_kernel_sgf_game_int {##1}
				\__pgfgo_sgfprob_prepare:n {#2}
				\__pgfgo_sgfprob_head:n {##1}
				\__pgfgo_sgfprob_statement:
			}
		}
		\bool_if:NT \l__pgfgo_sgfprob_solutions_bool {
			\seq_map_inline:Nn \l__pgfgo_sgfprob_games_seq {
				\int_set:Nn \l_pgfgo_kernel_sgf_game_int {##1}
				\__pgfgo_sgfprob_prepare:n {#2}
				\__pgfgo_sgfprob_head:n {##1}
				\seq_map_indexed_inline:Nn \l__pgfgo_sgfprob_paths_seq
					{\__pgfgo_sgfprob_solution:nn {####1} {####2}}
			}
		}
		\pgfgo_layout_end:
		\__pgfgo_sgfdiag_after_flush:
	\group_end:
}

\NewDocumentCommand{\sgfproblem}{O{}m}{
	\__pgfgo_sgf_if_kernel:n {\pgfgo_sgfproblem:nn {#1} {#2}}
}

\ExplSyntaxOff

\bool_new:N \l__pgfgo_sgf_remove_warned_bool

%LA NUMERACION DE \sgf, \sgfanimation Y \sgfdiagrams. LAS JUGADAS VAN EN TRAMOS DE step (UNA LISTA REPITE
%EL ULTIMO TAMANO; EN \sgfdiagrams, CADA TRAMO ES UN DIAGRAMA). restart: true, DESDE EL SEGUNDO TRAMO CADA
%UNO NUMERA DESDE from; false, LOS NUMEROS DE LA PARTIDA; auto, LO QUE PIDE PM (CON PM[2], CADA 100).
%from TAMBIEN PRENDE restart. #1: EL ARBOL DE CLAVES, #2: EL PREFIJO DE LAS VARIABLES, #3: step INICIAL.
%CLAVES: /pgfgo/{sgf, sgf animation, sgf diagrams}/{step, restart}
%CLAVES: /pgfgo/{sgf, sgf animation, sgf diagrams}/restart/{true, false, auto, from}
\cs_new_protected:Npn \__pgfgo_sgf_numbering_keys:nnn #1#2#3 {
	\clist_new:c {l__pgfgo_ #2 _step_clist}
	\tl_new:c {l__pgfgo_ #2 _restart_tl}
	\int_new:c {l__pgfgo_ #2 _restart_from_int}
	\keys_define:nn {#1} {
		step				.clist_set:c	= {l__pgfgo_ #2 _step_clist},
		step				.initial:n		= {#3},
		restart			.code:n				= {\keys_set:nn {#1 / restart} {##1}},
		restart			.default:n		= {true},
	}
	\keys_define:nn {#1 / restart} {
		true				.code:n				= {\tl_set:cn {l__pgfgo_ #2 _restart_tl} {true}},
		false				.code:n				= {\tl_set:cn {l__pgfgo_ #2 _restart_tl} {false}},
		auto				.code:n				= {\tl_set:cn {l__pgfgo_ #2 _restart_tl} {auto}},
		from				.code:n				= {
															\tl_set:cn {l__pgfgo_ #2 _restart_tl} {true}
															\int_set:cn {l__pgfgo_ #2 _restart_from_int} {##1}
														},
	}
	\tl_set:cn {l__pgfgo_ #2 _restart_tl} {auto}
	\int_set:cn {l__pgfgo_ #2 _restart_from_int} {1}
}
\__pgfgo_sgf_numbering_keys:nnn {pgfgo / sgf} {sgf} {100}

\keys_define:nn {pgfgo / sgf} {
	from				.int_set:N	= \l__pgfgo_sgf_from_int,
	from				.initial:n	= {1},
	%last (O UN NUMERO NEGATIVO): HASTA LA ULTIMA JUGADA.
	to					.code:n			= {\__pgfgo_sgf_set_to:Nnn \l__pgfgo_sgf_to_int {\c_max_int} {#1}},
	to					.initial:n	= {last},
	%OPCIONES DE UNA MARCA PARA LA ULTIMA JUGADA QUE SE MUESTRA. false: SIN MARCA.
	last~mark		.code:n			= {
												\str_if_eq:nnTF {#1} {false}
													{\tl_clear:N \l__pgfgo_sgf_last_mark_tl}
													{\tl_set:Nn \l__pgfgo_sgf_last_mark_tl {#1}}
											},
	last~mark		.initial:n	= {false},
	%2.1: EN LA PRIMERA BIFURCACION, LA SEGUNDA VARIANTE; EN LA SEGUNDA, LA PRIMERA.
	variation		.tl_set:N		= \l__pgfgo_sgf_variation_tl,
	marks				.bool_set:N	= \l__pgfgo_sgf_marks_bool,
	marks				.default:n	= {true},
	marks				.initial:n	= {true},
	numbers			.choices:nn	= {true, false, auto}
		{\tl_set_eq:NN \l__pgfgo_sgf_numbers_tl \l_keys_choice_tl},
	numbers			.default:n	= {true},
	numbers			.initial:n	= {auto},
	%LA PARTIDA DEL ARCHIVO (1 ES LA PRIMERA).
	game				.code:n			= {\int_set:Nn \l_pgfgo_kernel_sgf_game_int {#1}},
	%LAS VARIANTES DE LA ULTIMA JUGADA, COMO LETRAS: none, children, siblings O auto (LO QUE DICE ST).
	variations	.choices:nn	= {none, children, siblings, auto}
		{\tl_set_eq:NN \l__pgfgo_sgf_variations_tl \l_keys_choice_tl},
	variations	.default:n	= {auto},
	variations	.initial:n	= {none},
}

%\pgfgoset{sgf = {...}} FIJA LAS OPCIONES DE TODOS LOS \sgf (Y LA PARTIDA DE LOS DEMAS COMANDOS).
%sgf charset: LA CODIFICACION DE LOS ARCHIVOS QUE NO SON UTF-8 (auto: LA DE CA).
\keys_define:nn {pgfgo} {
	sgf					.code:n			= {\keys_set:nn {pgfgo / sgf} {#1}},
	sgf~charset	.tl_set:N		= \l_pgfgo_kernel_sgf_charset_tl,
}

\msg_new:nnn {pgfgo} {sgf-size}
	{The~game~in~'#1'~is~for~a~#2~board,~but~the~goban~is~#3.}
%AE: SOLO SE PUEDE QUITAR UNA PIEDRA CON goban/captures (LAS PIEDRAS SE DIBUJAN AL FINAL). SIN CAPTURAS,
%\sgf AVISA UNA VEZ.
\msg_new:nnn {pgfgo} {sgf-remove}
	{'#1'~removes~stones~(AE).~That~needs~goban/captures,~so~they~are~not~removed.}


%PIEDRAS INICIALES. #1: black O white. #2: LISTA DE {x}{y}.
\cs_new_protected:Npn \__pgfgo_sgf_stones:nn #1#2 {
	\tl_if_blank:nF {#2} {
		\bool_if:NT \l__pgfgo_sgf_cache_bool {\clist_map_inline:nn {#2} {\__pgfgo_sgf_cache_outside:nn ##1}}
		\pgfgo_remember:Nnn \l_pgfgo_goban_remember_stone_bool {stone}
			{\exp_not:N \pgfgo_stones_parsed:nn {#1} {\exp_not:n {#2}}}
		\pgfgo_stones_parsed:nn {#1} {#2}
	}
}
\cs_generate_variant:Nn \__pgfgo_sgf_stones:nn {nV}

%LAS PIEDRAS INICIALES DE #1 (black O white), DE LA SECUENCIA #2 DEL KERNEL.
\cs_new_protected:Npn \__pgfgo_sgf_setup_stones:nN #1#2 {
	\clist_set_from_seq:NN \l_tmpa_clist #2
	\__pgfgo_sgf_stones:nV {#1} \l_tmpa_clist
}

%UN EVENTO DE LA PARTIDA: UNA JUGADA ({black | white}{x}{y}), UN CAMBIO DE UN NODO POSTERIOR A LA
%PRIMERA JUGADA ({add-black | add-white | remove}{x}{y}), UN NUMERO DE JUGADA ({number}{n}{}, POR MN) O
%UN TURNO ({player}{black | white}{}, POR PL). LAS JUGADAS, QUE SON LA MAYORIA, SE PRUEBAN PRIMERO.
\cs_new_protected:Npn \__pgfgo_sgf_event:nnn #1#2#3 {
	\str_case:nnF {#1} {
		{black}			{\__pgfgo_sgf_move:nnn {black} {#2} {#3}}
		{white}			{\__pgfgo_sgf_move:nnn {white} {#2} {#3}}
		{add-black}	{\__pgfgo_sgf_stones:nn {black} {{#2}{#3}}}
		{add-white}	{\__pgfgo_sgf_stones:nn {white} {{#2}{#3}}}
		{remove}		{\__pgfgo_sgf_remove:nn {#2} {#3}}
		{number}		{\int_set:Nn \l__pgfgo_sgf_number_int {#2 - 1}}
		{player}		{\pgfgo_kernel_move_set_player:n {#2}}
	}{
		\__pgfgo_sgf_move:nnn {#1} {#2} {#3}
	}
}

\cs_new_protected:Npn \__pgfgo_sgf_remove:nn #1#2 {
	\bool_if:nTF {\l_pgfgo_goban_captures_bool && ! \l_pgfgo_captures_collect_bool} {
		\pgfgo_remember:Nnn \l_pgfgo_goban_remember_stone_bool {stone}
			{\exp_not:N \pgfgo_captures_remove:nn {#1} {#2}}
		\pgfgo_captures_remove:nn {#1} {#2}
	}{
		\bool_if:NF \l__pgfgo_sgf_remove_warned_bool {
			\msg_warning:nnV {pgfgo} {sgf-remove} \l__pgfgo_sgf_file_tl
			\bool_set_true:N \l__pgfgo_sgf_remove_warned_bool
		}
	}
}

%EL NUMERO QUE SE MUESTRA DE CADA JUGADA DIBUJADA (CON restart NO ES EL DE LA PARTIDA), PARA LOS COMENTARIOS.
\prop_new:N \g__pgfgo_sgf_shown_prop
\cs_generate_variant:Nn \prop_gput:Nnn {Nee}

%UNA JUGADA DE #1 (black O white) EN (#2,#3). x E y VACIOS: PASE.
\cs_new_protected:Npn \__pgfgo_sgf_move:nnn #1#2#3 {
	\bool_if:NT \l__pgfgo_sgf_cache_bool {
		\bool_lazy_and:nnT
			{\int_compare_p:nNn {\l__pgfgo_sgf_count_int + 1} = {\l__pgfgo_sgf_from_int}}
			{! \int_compare_p:nNn {\l__pgfgo_sgf_from_int} > {\l__pgfgo_sgf_to_int}}
			{\__pgfgo_sgf_save:nn {a} {\l__pgfgo_sgf_index_int}}
	}
	\int_incr:N \l__pgfgo_sgf_count_int
	\int_compare:nNnTF {\l__pgfgo_sgf_count_int} > {\l__pgfgo_sgf_to_int} {
		\int_decr:N \l__pgfgo_sgf_count_int
		\int_set_eq:NN \l__pgfgo_sgf_resume_int \l__pgfgo_sgf_index_int
		\seq_map_break:
	}{
		\int_incr:N \l__pgfgo_sgf_number_int
		\bool_lazy_and:nnT
			{! \tl_if_empty_p:N \l__pgfgo_sgf_first_tl}
			{\int_compare_p:nNn {\l__pgfgo_sgf_count_int} = {\l__pgfgo_sgf_from_int}}
			{\int_set:Nn \l__pgfgo_sgf_shift_int {\l__pgfgo_sgf_first_tl - \l__pgfgo_sgf_number_int}}
		\int_compare:nNnT {\l__pgfgo_sgf_restart_int} = {1} {\__pgfgo_sgf_block:n {\l__pgfgo_sgf_number_int}}
		\int_set:Nn \l__pgfgo_sgf_shown_int {
			\int_case:nnF {\l__pgfgo_sgf_restart_int}
				{
					{1} {
						\int_compare:nNnTF {\l__pgfgo_sgf_block_int} = {1}
							{\l__pgfgo_sgf_number_int}
							{\l__pgfgo_sgf_restart_from_int + \l__pgfgo_sgf_number_int - \l__pgfgo_sgf_block_int}
					}
					{2} {\int_mod:nn {\l__pgfgo_sgf_number_int - 1} {100} + 1}
				}
				{\l__pgfgo_sgf_number_int + \l__pgfgo_sgf_shift_int}
		}
		\pgfgo_kernel_move_set_number:n {\l__pgfgo_sgf_shown_int}
		\prop_gput:Nee \g__pgfgo_sgf_shown_prop {\int_use:N \l__pgfgo_sgf_count_int} {\int_use:N \l__pgfgo_sgf_shown_int}
		\pgfgo_kernel_move_set_player:n {#1}
		\tl_if_blank:nTF {#2} {
			%UN PASE CUENTA, PERO NO SE DIBUJA. CON goban/notes, SI SE NUMERARIA, SE ANOTA ("N: pass"), SALVO LOS
			%QUE TERMINAN LA LINEA (#3 = end).
			\bool_lazy_all:nT {
				{\l_pgfgo_goban_notes_bool} {\l__pgfgo_sgf_numbers_bool} {\tl_if_empty_p:n {#3}}
				{! \int_compare_p:nNn {\l__pgfgo_sgf_count_int} < {\l__pgfgo_sgf_from_int}}
			} {\pgfgo_notes_pass:}
			\pgfgo_kernel_move_set_number:n {\l__pgfgo_sgf_shown_int + 1}
			\pgfgo_kernel_move_set_player:n {\str_if_eq:nnTF {#1} {black} {white} {black}}
		}{
			\__pgfgo_sgf_stone:nnn {#1} {#2} {#3}
		}
	}
}

%LA PIEDRA DE UNA JUGADA. SIN NUMERO ANTES DE from, Y TAMPOCO SI UNA MARCA DEL ARCHIVO CAE EN ESE PUNTO
%(LA MARCA LO REEMPLAZA).
\cs_new_protected:Npn \__pgfgo_sgf_stone:nnn #1#2#3 {
	\bool_set:Nn \l__pgfgo_sgf_numbered_bool
		{! \int_compare_p:nNn {\l__pgfgo_sgf_count_int} < {\l__pgfgo_sgf_from_int}}
	\bool_set:Nn \l__pgfgo_captures_keep_bool
		{\l__pgfgo_sgf_keep_numbered_bool && \l__pgfgo_sgf_numbered_bool}
	\__pgfgo_captures_key:nn {#2} {#3}
	\bool_if:NT \l__pgfgo_sgf_cache_bool {\__pgfgo_sgf_cache_outside:nn {#2} {#3}}
	\bool_if:nT {\l__pgfgo_sgf_numbers_bool && \l__pgfgo_sgf_numbered_bool}
		{\prop_put:NVn \l__pgfgo_sgf_numbered_prop \l__pgfgo_captures_key_tl {}}
	\bool_set:Nn \l__pgfgo_sgf_numbered_bool {
		\l__pgfgo_sgf_numbers_bool && \l__pgfgo_sgf_numbered_bool &&
		! \prop_if_in_p:NV \g__pgfgo_sgf_marked_prop \l__pgfgo_captures_key_tl
	}
	\pgfgo_remember:Nnn \l_pgfgo_goban_remember_move_bool {stone} {
		\bool_if:NF \l_pgfgo_goban_remember_move_label_bool {\exp_not:N \pgfgo_remember_numbers:n}
		{
			\__pgfgo_sgf_move_code:nnnn
				{\bool_if:NTF \l__pgfgo_sgf_numbered_bool {\exp_not:N \BooleanTrue} {\exp_not:N \BooleanFalse}}
				{#1} {#2} {#3}
		}
	}
	\bool_if:NTF \l__pgfgo_sgf_numbered_bool
		{\pgfgo_move:nnnn {\BooleanTrue} {} {#2} {#3}}
		{\pgfgo_move:nnnn {\BooleanFalse} {} {#2} {#3}}
}

%EL CODIGO QUE VUELVE A DIBUJAR LA JUGADA DE #2 EN (#3,#4) (#1: NUMERADA). PARA UNA EXPANSION e.
\cs_new:Npn \__pgfgo_sgf_move_code:nnnn #1#2#3#4 {
	\exp_not:N \pgfgo_move_parsed:nnn {#1} {from = \int_use:N \l__pgfgo_sgf_shown_int, #2} {{#3}{#4}}
}

%MARCAS DEL ARCHIVO (TR, SQ, CR, MA, LB; TB Y TW SON TERRITORIO): #1 FORMA, (#2,#3) PUNTO, #4 COLOR DE LA
%PIEDRA (black, white O neutral, PARA QUE LA MARCA SE VEA), #5 TEXTO DE LB.
\cs_new_protected:Npn \__pgfgo_sgf_mark:nnnnn #1#2#3#4#5 {
	\str_case:nnF {#1} {
		{black-territory}	{\__pgfgo_sgf_territory:nnn {black} {#2} {#3}}
		{white-territory}	{\__pgfgo_sgf_territory:nnn {white} {#2} {#3}}

\bool_new:N \l__pgfgo_sgfanim_marks_bool
\bool_new:N \l__pgfgo_sgfanim_view_bool
\bool_new:N \l__pgfgo_sgfanim_partial_bool
\bool_new:N \l__pgfgo_sgfanim_layers_bool

%CARACTERES CON OTRA FUENTE, QUE NO ES LA ACTUAL.
\msg_new:nnn {pgfgo} {sgf-glyphs}
	{The~font~'#1'~has~no~glyph~for~#2~(and~maybe~other~CJK~characters)~of~an~SGF~text.~Load~a~font~with~them,~for~example~with~ctex,~luatexja~or~luatexko.}

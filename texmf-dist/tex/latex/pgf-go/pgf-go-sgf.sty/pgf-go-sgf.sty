%LOS COMANDOS DE SGF NECESITAN UN KERNEL QUE LEA PARTIDAS (kernel = lua).
\cs_new_protected:Npn \__pgfgo_sgf_if_kernel:n #1 {
	\pgfgo_kernel_if_feature:nTF {sgf} {#1} {\pgfgo_kernel_require:n {sgf}}
}

%EL TAMANO DE LA ULTIMA PARTIDA LEIDA EN #1, COMO LA OPCION size DE goban (19x19).
\cs_new_protected:Npn \__pgfgo_sgf_size:N #1 {
	\tl_set:Ne #1 {\int_use:N \l_pgfgo_kernel_sgf_size_x_int x \int_use:N \l_pgfgo_kernel_sgf_size_y_int}
}

%partial = auto EN \sgfdiagrams, \sgfproblem Y \sgfanimation: TODOS LOS TABLEROS TIENEN LA MISMA PARTE
%VISIBLE, LA QUE USAN LAS LINEAS QUE SE DIBUJAN: TODO EL ARBOL DEL ARCHIVO #1 (\__pgfgo_sgf_extent:n, EN
%\sgfproblem) O LAS LINEAS #2, SEPARADAS POR ; (\__pgfgo_sgf_extent:nn). \__pgfgo_sgf_extent_add: LA SUMA A LO
%DIBUJADO DENTRO DE CADA goban (SI EL goban TODAVIA TIENE partial = auto).
\tl_new:N \l__pgfgo_sgf_extent_tl
\cs_new_protected:Npn \__pgfgo_sgf_extent:n #1 {
	\pgfgo_kernel_sgf_tree:n {#1}
	\tl_set_eq:NN \l__pgfgo_sgf_extent_tl \l_pgfgo_kernel_sgf_extent_tl
}
\cs_new_protected:Npn \__pgfgo_sgf_extent:nn #1#2 {
	\pgfgo_kernel_sgf_extent:nn {#1} {#2}
	\tl_set_eq:NN \l__pgfgo_sgf_extent_tl \l_pgfgo_kernel_sgf_extent_tl
}
\cs_generate_variant:Nn \__pgfgo_sgf_extent:nn {nV}
\cs_new_protected:Npn \__pgfgo_sgf_extent_add: {
	\bool_lazy_and:nnT {\l_pgfgo_goban_partial_auto_bool} {! \tl_if_empty_p:N \l__pgfgo_sgf_extent_tl}
		{\exp_after:wN \__pgfgo_sgf_extent_add:nnnn \l__pgfgo_sgf_extent_tl}
}
\cs_new_protected:Npn \__pgfgo_sgf_extent_add:nnnn #1#2#3#4 {
	\pgfgo_kernel_extent_add:nn {#1} {#2}
	\pgfgo_kernel_extent_add:nn {#3} {#4}
}

%VERDADERO SI EL EVENTO {#1}{#2}{#3} DE \l_pgfgo_kernel_sgf_moves_seq ES UNA JUGADA (NO UN CAMBIO DE UN NODO
%NI UN NUMERO).
\prg_new_conditional:Npnn \__pgfgo_sgf_if_move:nnn #1#2#3 {T} {
	\str_case:nnF {#1} {
		{black}	{\prg_return_true:}
		{white}	{\prg_return_true:}
	}{
		\prg_return_false:
	}
}

%DEJA EN #1 LA CANTIDAD DE JUGADAS DE LA ULTIMA PARTIDA LEIDA, SIN CONTAR MAS DE #2 (DEJA DE RECORRER AHI).
\cs_new_protected:Npn \__pgfgo_sgf_count_moves:Nn #1#2 {
	\int_zero:N #1
	\int_compare:nNnT {#2} > {0} {
		\seq_map_inline:Nn \l_pgfgo_kernel_sgf_moves_seq {
			\__pgfgo_sgf_if_move:nnnT ##1 {
				\int_incr:N #1
				\int_compare:nNnF {#1} < {#2} {\seq_map_break:}
			}
		}
	}
}



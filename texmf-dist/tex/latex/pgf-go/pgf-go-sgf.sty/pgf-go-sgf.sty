\tl_new:N \l__pgfgo_sgfanim_size_tl
%LAS JUGADAS (SIN LOS CAMBIOS DE NODOS NI LOS NUMEROS), {black | white}{x}{y}: LA JUGADA DE CADA CUADRO.
\seq_new:N \l__pgfgo_sgfanim_moves_seq
\box_new:N \l__pgfgo_sgfanim_box

\keys_define:nn {pgfgo / sgf~animation} {
	from						.int_set:N	= \l__pgfgo_sgfanim_from_int,
	from						.initial:n	= {0},
	%last (-1): LA ULTIMA JUGADA.
	to							.code:n			= {\__pgfgo_sgf_set_to:Nnn \l__pgfgo_sgfanim_to_int {-1} {#1}},
	to							.initial:n	= {last},
	fps							.tl_set:N		= \l__pgfgo_sgfanim_fps_tl,
	fps							.initial:n	= {1},
	goban						.tl_set:N		= \l__pgfgo_sgfanim_goban_tl,
	animate					.tl_set:N		= \l__pgfgo_sgfanim_animate_tl,
	animate					.initial:n	= {controls},
	numbers					.bool_set:N	= \l__pgfgo_sgfanim_numbers_bool,
	numbers					.default:n	= {true},
	%OPCIONES DE LA MARCA DE LA ULTIMA JUGADA (SIN numbers). false: SIN MARCA.
	last~mark				.code:n			= {
															\str_if_eq:nnTF {#1} {false}
																{\tl_clear:N \l__pgfgo_sgfanim_last_tl}
																{\tl_set:Nn \l__pgfgo_sgfanim_last_tl {#1}}
														},
	last~mark				.initial:n	= {circle},
	comments				.code:n			= {\keys_set:nn {pgfgo / sgf~animation / comments} {#1}},
	comments				.default:n	= {true},
	%COMO EN \sgf.
	variation				.tl_set:N		= \l__pgfgo_sgfanim_variation_tl,
	marks						.bool_set:N	= \l__pgfgo_sgfanim_marks_bool,
	marks						.default:n	= {true},
	marks						.initial:n	= {true},
	%LAS ANOTACIONES (TE, BM, GB, ...) Y EL NOMBRE DEL NODO, CON EL COMENTARIO.
	annotations			.bool_set:N	= \l__pgfgo_sgfanim_annotations_bool,
	annotations			.default:n	= {true},
	chat						.bool_set:N	= \l__pgfgo_sgfanim_chat_bool,
	chat						.default:n	= {true},
	game						.code:n			= {\int_set:Nn \l_pgfgo_kernel_sgf_game_int {#1}},
	%SI EL ARCHIVO TIENE VISTA (VW), LOS TABLEROS MUESTRAN SOLO ESA PARTE.
	view						.bool_set:N	= \l__pgfgo_sgfanim_view_bool,
	view						.default:n	= {true},
	view						.initial:n	= {true},
	%auto: LOS TABLEROS MUESTRAN SOLO LA PARTE QUE USA LA PARTIDA (SI NO HAY VISTA).
	partial					.choices:nn	= {auto, false}
		{\bool_set:Nn \l__pgfgo_sgfanim_partial_bool {\str_if_eq_p:Vn \l_keys_choice_tl {auto}}},
	partial					.initial:n	= {false},
	%POR CAPAS: CADA PIEDRA SE DIBUJA UNA SOLA VEZ (VER MAS ABAJO).
	layers					.bool_set:N	= \l__pgfgo_sgfanim_layers_bool,
	layers					.default:n	= {true},
	layers					.initial:n	= {true},
}


%GUARDA LA COPIA #1 (a O b), QUE SIGUE EN EL EVENTO #2.
\cs_new_protected:Npn \__pgfgo_sgf_save:nn #1#2 {
	\bool_if:nF {
		\g__pgfgo_captures_warned_bool || \l__pgfgo_sgf_remove_warned_bool || \l__pgfgo_sgf_outside_bool
	}{
		\__pgfgo_sgf_if_marked_conflict:NTF \l__pgfgo_sgf_numbered_prop {
			\tl_gclear:c {g__pgfgo_sgf_#1_context_tl}
		}{
			\tl_gset_eq:cN {g__pgfgo_sgf_#1_context_tl} \l__pgfgo_sgf_context_tl
			\int_gset_eq:cN {g__pgfgo_sgf_#1_count_int} \l__pgfgo_sgf_count_int
			\int_gset:cn {g__pgfgo_sgf_#1_index_int} {#2}
			\int_gset:cn {g__pgfgo_sgf_#1_from_int}
				{\int_min:nn {\l__pgfgo_sgf_from_int} {\l__pgfgo_sgf_count_int + 1}}
			\int_gset_eq:cN {g__pgfgo_sgf_#1_number_int} \l__pgfgo_sgf_number_int
			\int_gset_eq:cN {g__pgfgo_sgf_#1_shift_int} \l__pgfgo_sgf_shift_int
			\seq_gset_eq:cN {g__pgfgo_sgf_#1_captured_seq} \l_pgfgo_kernel_captured_seq
			\seq_gset_eq:cN {g__pgfgo_sgf_#1_notes_seq} \g_pgfgo_move_notes_seq
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_numbered_prop} \l__pgfgo_sgf_numbered_prop
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_pending_prop} \g__pgfgo_captures_pending_prop
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_faded_prop} \g__pgfgo_captures_faded_prop
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_marks_prop} \g__pgfgo_captures_marks_prop
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_points_prop} \g_pgfgo_points_prop
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_notes_number_prop} \g__pgfgo_notes_number_prop
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_notes_code_prop} \g__pgfgo_notes_code_prop
			\pgfgo_kernel_board_save:n {sgf-#1}
		}
	}
}

%DEJA EN \l__pgfgo_sgf_slot_tl LA COPIA QUE SIRVE (LA DE MAS JUGADAS), O NADA.
\cs_new_protected:Npn \__pgfgo_sgf_choose: {
	\tl_clear:N \l__pgfgo_sgf_slot_tl
	\clist_map_inline:nn {a, b} {
		\bool_lazy_all:nT {
			{\tl_if_eq_p:Nc \l__pgfgo_sgf_context_tl {g__pgfgo_sgf_##1_context_tl}}
			{! \int_compare_p:nNn {\int_use:c {g__pgfgo_sgf_##1_count_int}} > {\l__pgfgo_sgf_to_int}}
			{
				\int_compare_p:nNn {\int_use:c {g__pgfgo_sgf_##1_from_int}} =
					{\int_min:nn {\l__pgfgo_sgf_from_int} {\int_use:c {g__pgfgo_sgf_##1_count_int} + 1}}
			}
			{
				\bool_lazy_or_p:nn
					{\tl_if_empty_p:N \l__pgfgo_sgf_slot_tl}
					{
						\int_compare_p:nNn {\int_use:c {g__pgfgo_sgf_##1_count_int}}
							> {\int_use:c {g__pgfgo_sgf_ \l__pgfgo_sgf_slot_tl _count_int}}
					}
			}
		}{
			\__pgfgo_sgf_if_marked_conflict:cTF {g__pgfgo_sgf_##1_numbered_prop}
				{} {\tl_set:Nn \l__pgfgo_sgf_slot_tl {##1}}
		}
	}
}


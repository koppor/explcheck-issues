%EN \l__pgfgo_sgf_block_int, LA PRIMERA JUGADA DEL TRAMO DE step EN QUE CAE EL NUMERO #1. LOS TRAMOS QUE
%REPITEN EL ULTIMO TAMANO DE LA LISTA SE SALTAN DE UNA VEZ.
\int_new:N \l__pgfgo_sgf_block_int
\int_new:N \l__pgfgo_sgf_block_size_int
\int_new:N \l__pgfgo_sgf_block_index_int
\cs_new_protected:Npn \__pgfgo_sgf_block:n #1 {
	\int_set:Nn \l__pgfgo_sgf_block_int {1}
	\int_set:Nn \l__pgfgo_sgf_block_index_int {1}
	\__pgfgo_sgf_block_loop:n {#1}
}
\cs_new_protected:Npn \__pgfgo_sgf_block_loop:n #1 {
	\int_set:Nn \l__pgfgo_sgf_block_size_int {
		\int_max:nn {1} {
			\clist_item:Nn \l__pgfgo_sgf_step_clist
				{\int_min:nn {\l__pgfgo_sgf_block_index_int} {\clist_count:N \l__pgfgo_sgf_step_clist}}
		}
	}
	\int_compare:nNnT {#1} > {\l__pgfgo_sgf_block_int + \l__pgfgo_sgf_block_size_int - 1} {
		\int_compare:nNnTF {\l__pgfgo_sgf_block_index_int} < {\clist_count:N \l__pgfgo_sgf_step_clist}
			{
				\int_add:Nn \l__pgfgo_sgf_block_int {\l__pgfgo_sgf_block_size_int}
				\int_incr:N \l__pgfgo_sgf_block_index_int
				\__pgfgo_sgf_block_loop:n {#1}
			}
			{
				\int_add:Nn \l__pgfgo_sgf_block_int {
					\int_div_truncate:nn {#1 - \l__pgfgo_sgf_block_int} {\l__pgfgo_sgf_block_size_int}
						* \l__pgfgo_sgf_block_size_int
				}
			}
	}
}

%AVISA SI LA PARTIDA DEL ARCHIVO #1 NO ES DEL TAMANO DEL goban.
\cs_new_protected:Npn \__pgfgo_sgf_check_size:n #1 {
	\bool_lazy_and:nnF
		{\int_compare_p:nNn {\l_pgfgo_kernel_sgf_size_x_int} = {\l_pgfgo_goban_size_x_int}}
		{\int_compare_p:nNn {\l_pgfgo_kernel_sgf_size_y_int} = {\l_pgfgo_goban_size_y_int}}
		{
			\msg_warning:nnnee {pgfgo} {sgf-size} {#1}
				{\int_use:N \l_pgfgo_kernel_sgf_size_x_int x \int_use:N \l_pgfgo_kernel_sgf_size_y_int}
				{\int_use:N \l_pgfgo_goban_size_x_int x \int_use:N \l_pgfgo_goban_size_y_int}
		}
}

%LAS MARCAS Y LAS LETRAS DE LAS VARIANTES DE LA ULTIMA JUGADA QUE SE MUESTRA. SE AVERIGUAN ANTES DE JUGAR,
%PORQUE REEMPLAZAN LOS NUMEROS, Y SE DIBUJAN DESPUES.
\cs_new_protected:Npn \__pgfgo_sgf_marked: {
	\prop_gclear:N \g__pgfgo_sgf_marked_prop
	\prop_gclear:N \g__pgfgo_sgf_labeled_prop
	\seq_clear:N \l__pgfgo_sgf_marks_seq
	\bool_if:NT \l__pgfgo_sgf_marks_bool {
		\pgfgo_kernel_sgf_marks:n {\l__pgfgo_sgf_last_int}
		\seq_set_eq:NN \l__pgfgo_sgf_marks_seq \l_pgfgo_kernel_sgf_marks_seq
		\seq_map_inline:Nn \l__pgfgo_sgf_marks_seq {\__pgfgo_sgf_marked_point:nnnnn ##1}
	}
	\seq_clear:N \l__pgfgo_sgf_variations_seq
	\str_if_eq:VnF \l__pgfgo_sgf_variations_tl {none} {
		\exp_args:NnV \pgfgo_kernel_sgf_variations:nn {\l__pgfgo_sgf_last_int} \l__pgfgo_sgf_variations_tl
		\seq_set_eq:NN \l__pgfgo_sgf_variations_seq \l_pgfgo_kernel_sgf_variations_seq
		\seq_map_inline:Nn \l__pgfgo_sgf_variations_seq {\__pgfgo_sgf_marked_point:nnnnn {variation} ##1}
	}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%CON \l__pgfgo_sgf_cache_bool (\sgfanimation Y \sgfdiagrams, QUE DIBUJAN MUCHOS TABLEROS DE LA MISMA
%PARTIDA) UN \sgf NO VUELVE A JUGAR LA PARTIDA DESDE EL PRINCIPIO: SIGUE DESDE LA POSICION QUE GUARDO
%UN \sgf ANTERIOR. HAY DOS COPIAS: a, ANTES DE LA PRIMERA JUGADA NUMERADA (from), Y b, DESPUES DE LA
%ULTIMA (to). CADA UNA TIENE LO QUE DEJARON LAS JUGADAS: EL TABLERO DEL KERNEL, LO QUE SE VA A DIBUJAR
%(LAS PIEDRAS, LAS ATENUADAS Y LAS MARCAS), LOS PUNTOS DE \pgfgoscore, LAS NOTAS "N at M" Y EL NUMERO.
%
%UNA COPIA DE c JUGADAS SIRVE SI ES DEL MISMO ARCHIVO, CON LAS MISMAS OPCIONES Y EL MISMO TABLERO (EL
%CONTEXTO), SI to NO ES MENOR QUE c, SI LAS JUGADAS 1 A c SON LAS MISMAS NUMERADAS (from IGUAL, O LOS DOS
%MAYORES QUE c), Y SI NINGUNA DE ESAS JUGADAS NUMERADAS CAE EN UN PUNTO QUE MARCA EL ULTIMO NODO (LA
%MARCA LE QUITA EL NUMERO). NO SE GUARDA NADA SI HUBO UN AVISO (PARA QUE CADA TABLERO AVISE IGUAL).
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\bool_new:N \l__pgfgo_sgf_cache_bool
\tl_new:N \l__pgfgo_sgf_context_tl
%EL EVENTO QUE SE JUEGA, Y EL PRIMERO QUE NO SE JUGO (DONDE SIGUE UNA COPIA).
\int_new:N \l__pgfgo_sgf_index_int
\int_new:N \l__pgfgo_sgf_resume_int
\int_new:N \l__pgfgo_sgf_start_int
%SI UN PUNTO QUEDO FUERA DEL TABLERO.
\bool_new:N \l__pgfgo_sgf_outside_bool
\tl_new:N \l__pgfgo_sgf_slot_tl
\clist_map_inline:nn {a, b} {
	\tl_new:c {g__pgfgo_sgf_#1_context_tl}
	\int_new:c {g__pgfgo_sgf_#1_count_int}
	\int_new:c {g__pgfgo_sgf_#1_index_int}
	\int_new:c {g__pgfgo_sgf_#1_from_int}
	\int_new:c {g__pgfgo_sgf_#1_number_int}
	\int_new:c {g__pgfgo_sgf_#1_shift_int}
	\seq_new:c {g__pgfgo_sgf_#1_captured_seq}
	\seq_new:c {g__pgfgo_sgf_#1_notes_seq}
	\clist_map_inline:nn {numbered, pending, faded, marks, points, notes_number, notes_code}
		{\prop_new:c {g__pgfgo_sgf_#1_##1_prop}}
}

%BORRA LAS COPIAS (AL EMPEZAR CADA \sgfanimation O \sgfdiagrams).
\cs_new_protected:Npn \__pgfgo_sgf_cache_begin: {

%LEE EL COMENTARIO DE LA JUGADA #1 DE LA ULTIMA PARTIDA LEIDA (0: EL DE ANTES DE LA PRIMERA JUGADA), PARA
%PREGUNTAR SI TIENE (\__pgfgo_sgf_if_comment:nT) Y ESCRIBIRLO (\__pgfgo_sgf_comment_use:) SIN VOLVER A PEDIRLO.
\cs_new_protected:Npn \__pgfgo_sgf_comment_get:n #1 {
	\seq_clear:N \l__pgfgo_sgf_note_seq
	\bool_set_false:N \l__pgfgo_sgf_annotated_bool
	\bool_if:NT \l__pgfgo_sgf_annotations_bool {
		\pgfgo_kernel_sgf_annotations:n {#1}
		\seq_if_empty:NF \l_pgfgo_kernel_sgf_annotations_seq {
			\bool_set_true:N \l__pgfgo_sgf_annotated_bool
			\seq_map_inline:Nn \l_pgfgo_kernel_sgf_annotations_seq {\__pgfgo_sgf_note:nn ##1}
		}
	}
	\tl_set:Ne \l__pgfgo_sgf_comment_tl
		{\pgfgo_kernel_sgf_comment:nn {#1} {\bool_if:NTF \l__pgfgo_sgf_chat_bool {true} {false}}}
}
%UN TEXTO DEL ARCHIVO (COMENTARIO, PROPIEDAD): SE ESCRIBE, CON EL AVISO sgf-glyphs SI A LA FUENTE LE FALTAN

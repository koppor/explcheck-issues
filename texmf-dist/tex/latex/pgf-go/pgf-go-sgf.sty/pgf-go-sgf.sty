\tl_new:N \l__pgfgo_sgfdiag_caption_code_tl
\cs_new_protected:Npn \__pgfgo_sgfdiag_draw:nnnn #1#2#3#4 {
	\tl_set:Nn \l__pgfgo_sgfdiag_caption_tl {#3}
	\bool_set:Nn \l__pgfgo_sgfdiag_side_bool
		{
			\l__pgfgo_sgfdiag_comments_bool && (
				\str_if_eq_p:Vn \l__pgfgo_sgfdiag_comment_position_tl {right} ||
				\str_if_eq_p:Vn \l__pgfgo_sgfdiag_comment_position_tl {left}
			)
		}
	\bool_lazy_and:nnT {\l__pgfgo_sgfdiag_side_bool} {\pgfgo_layout_if_grid_p:} {
		\dim_set_eq:NN \l__pgfgo_sgfdiag_total_dim \l_pgfgo_layout_cell_dim
		\str_if_eq:VnTF \l__pgfgo_sgfdiag_comment_width_tl {auto}
			{
				\pgfgo_layout_if_fit:T
					{\dim_set:Nn \l_pgfgo_layout_cell_dim {(\l__pgfgo_sgfdiag_total_dim - \l__pgfgo_sgfdiag_comment_sep_dim) / 2}}
			}
			{
				\dim_set:Nn \l_pgfgo_layout_cell_dim
					{\l__pgfgo_sgfdiag_total_dim - \l__pgfgo_sgfdiag_comment_sep_dim - (\l__pgfgo_sgfdiag_comment_width_tl)}
			}
	}
	\pgfgo_layout_if_fit:T {
		\tl_if_empty:NT \l__pgfgo_sgfdiag_scale_tl {
			\pgfgo_layout_fit:nN
				{
					\tl_set:Nn \l__pgfgo_sgfdiag_scale_tl {scale = ##1}
					\__pgfgo_sgfdiag_board:nn {#1} {#2}
				}
				\l__pgfgo_sgfdiag_box
			\tl_set:Ne \l__pgfgo_sgfdiag_scale_tl {scale = \l_pgfgo_layout_scale_tl}
		}
	}
	\__pgfgo_sgfdiag_board:nn {#1} {#2}
	%UN TABLERO MAS ANCHO QUE EL PRIMERO (OTRO PROBLEMA, OTRA VISTA) NO ENTRA CON ESA ESCALA: SOLO ESE SE ACHICA.
	\pgfgo_layout_if_fit:T {
		\dim_compare:nNnT {\box_wd:N \l__pgfgo_sgfdiag_box} > {\l_pgfgo_layout_cell_dim + 0.1pt} {
			\group_begin:
				\pgfgo_layout_fit:nN
					{
						\tl_set:Nn \l__pgfgo_sgfdiag_scale_tl {scale = ##1}
						\__pgfgo_sgfdiag_board:nn {#1} {#2}
					}
					\l__pgfgo_sgfdiag_box
				\tl_set:Ne \l__pgfgo_sgfdiag_scale_tl {scale = \l_pgfgo_layout_scale_tl}
				\__pgfgo_sgfdiag_board:nn {#1} {#2}
				\box_gset_eq:NN \g__pgfgo_sgfdiag_fit_box \l__pgfgo_sgfdiag_box
			\group_end:
			\box_set_eq:NN \l__pgfgo_sgfdiag_box \g__pgfgo_sgfdiag_fit_box
			\box_gclear:N \g__pgfgo_sgfdiag_fit_box
		}
	}
	\bool_lazy_and:nnT {\l__pgfgo_sgfdiag_side_bool} {\pgfgo_layout_if_grid_p:} {
		\str_if_eq:VnT \l__pgfgo_sgfdiag_comment_width_tl {auto}
			{\pgfgo_layout_if_fit:F {\dim_set:Nn \l_pgfgo_layout_cell_dim {\box_wd:N \l__pgfgo_sgfdiag_box}}}
	}
	\box_gclear:N \g__pgfgo_sgfdiag_side_box
	\pgfgo_layout_if_cells:TF
		{
			\__pgfgo_sgfdiag_side_width:n {\l_pgfgo_layout_cell_dim}
			\tl_set:Nn \l__pgfgo_sgfdiag_align_tl {\pgfgo_layout_par_align:}
			\dim_set_eq:NN \l__pgfgo_sgfdiag_width_dim \l_pgfgo_layout_cell_dim
			\vbox_set_top:Nn \l__pgfgo_sgfdiag_cell_box {
				\pgfgo_layout_place:n {\box_use:N \l__pgfgo_sgfdiag_box}
				\skip_vertical:n {0.3em}
				\__pgfgo_sgfdiag_below:nn {\pgfgo_layout_par_align:} {#3}
				#4
			}
		}
		{
			\tl_set:Nn \l__pgfgo_sgfdiag_align_tl {\centering}
			%EL DIAGRAMA TIENE EL ANCHO DEL TABLERO. UN EPIGRAFE MAS ANCHO SE CORTA EN LINEAS (COMO EN LA GRILLA),
			%PERO EL DIAGRAMA NO ES MAS ANGOSTO QUE SU PALABRA MAS LARGA NI QUE caption/min width (SI ENTRA ASI EN
			%UNA LINEA, NO SE CORTA). EL EPIGRAFE CORTADO ES UN PARRAFO DE LA CELDA (NO UNA CAJA): SUS LINEAS Y LO
			%QUE SIGUE LLEVAN EL INTERLINEADO DE SIEMPRE.
			\hbox_set:Nn \l__pgfgo_sgfdiag_caption_box {\l__pgfgo_sgfdiag_font_tl #3}
			\dim_set:Nn \l__pgfgo_sgfdiag_width_dim {\box_wd:N \l__pgfgo_sgfdiag_box}
			\dim_compare:nNnT {\box_wd:N \l__pgfgo_sgfdiag_caption_box} > {\l__pgfgo_sgfdiag_width_dim} {
				\__pgfgo_sgfdiag_widest_word:n {#3}
				\__pgfgo_sgfdiag_caption_min:
				\dim_set:Nn \l__pgfgo_sgfdiag_width_dim {
					\dim_max:nn {\l__pgfgo_sgfdiag_width_dim} {\dim_max:nn {\g__pgfgo_sgfdiag_word_dim} {\g__pgfgo_sgfdiag_caption_min_dim}}
				}
			}
			\dim_compare:nNnTF {\box_wd:N \l__pgfgo_sgfdiag_caption_box} > {\l__pgfgo_sgfdiag_width_dim}
				{
					\box_clear:N \l__pgfgo_sgfdiag_caption_box
					\tl_set:Nn \l__pgfgo_sgfdiag_caption_code_tl {
						\group_begin:
							\__pgfgo_sgfdiag_par_setup:N \l__pgfgo_sgfdiag_width_dim
							\centering \l__pgfgo_sgfdiag_font_tl #3 \par
						\group_end:
					}
				}
				{
					\tl_set:Nn \l__pgfgo_sgfdiag_caption_code_tl {
						\hbox_to_wd:nn {\l__pgfgo_sgfdiag_width_dim} {\hfil \box_use:N \l__pgfgo_sgfdiag_caption_box \hfil}
					}
				}
			\__pgfgo_sgfdiag_side_width:n {\l__pgfgo_sgfdiag_width_dim}
			\vbox_set_top:Nn \l__pgfgo_sgfdiag_cell_box {
				\hbox_to_wd:nn {\l__pgfgo_sgfdiag_width_dim} {\hfil \box_use:N \l__pgfgo_sgfdiag_box \hfil}
				\skip_vertical:n {0.3em}
				\l__pgfgo_sgfdiag_caption_code_tl
				#4
			}
		}
	\bool_if:NT \l__pgfgo_sgfdiag_side_bool {\__pgfgo_sgfdiag_side:}
	%LA CELDA VUELVE A SU ANCHO (LA USAN LA DISPOSICION Y EL DIAGRAMA SIGUIENTE).
	\bool_lazy_and:nnT {\l__pgfgo_sgfdiag_side_bool} {\pgfgo_layout_if_grid_p:}
		{\dim_set_eq:NN \l_pgfgo_layout_cell_dim \l__pgfgo_sgfdiag_total_dim}
}

%EL ANCHO DE LA PALABRA MAS LARGA DEL EPIGRAFE #1 (EN \g__pgfgo_sgfdiag_word_dim): CON \hsize = 0pt CADA
%PALABRA VA EN SU LINEA (SIN GUIONES); SE SACAN LAS LINEAS DE ABAJO HACIA ARRIBA Y SE MIDE CADA UNA.
\dim_new:N \g__pgfgo_sgfdiag_word_dim
\box_new:N \l__pgfgo_sgfdiag_words_box
\cs_new_protected:Npn \__pgfgo_sgfdiag_widest_word:n #1 {
	\dim_gzero:N \g__pgfgo_sgfdiag_word_dim
	\vbox_set:Nn \l__pgfgo_sgfdiag_words_box {
		\dim_set_eq:NN \hsize \c_zero_dim
		\int_set:Nn \hyphenpenalty {10000}
		\int_set:Nn \exhyphenpenalty {10000}
		\dim_set:Nn \hfuzz {\c_max_dim}
		\int_set:Nn \hbadness {10000}
		\noindent \l__pgfgo_sgfdiag_font_tl #1 \par
		\__pgfgo_sgfdiag_widest_word_loop:
	}
}
%EL ANCHO MINIMO DEL EPIGRAFE CORTADO (EN \g__pgfgo_sgfdiag_caption_min_dim): min width EN LA FUENTE DEL
%EPIGRAFE, PERO NO MAS QUE EL EPIGRAFE EN UNA LINEA (\l__pgfgo_sgfdiag_caption_box).
\dim_new:N \g__pgfgo_sgfdiag_caption_min_dim
\cs_new_protected:Npn \__pgfgo_sgfdiag_caption_min: {
	\group_begin:
		\l__pgfgo_sgfdiag_font_tl
		\dim_gset:Nn \g__pgfgo_sgfdiag_caption_min_dim
			{\dim_min:nn {\l__pgfgo_sgfdiag_caption_min_tl} {\box_wd:N \l__pgfgo_sgfdiag_caption_box}}
	\group_end:
}
\cs_new_protected:Npn \__pgfgo_sgfdiag_widest_word_loop: {
	\tex_unskip:D \tex_unpenalty:D \tex_unskip:D
	\box_set_to_last:N \l_tmpa_box
	\box_if_empty:NF \l_tmpa_box {
		\hbox_set:Nn \l_tmpa_box {\hbox_unpack:N \l_tmpa_box}
		\dim_gset:Nn \g__pgfgo_sgfdiag_word_dim {\dim_max:nn {\g__pgfgo_sgfdiag_word_dim} {\box_wd:N \l_tmpa_box}}
		\__pgfgo_sgfdiag_widest_word_loop:
	}
}

%EL ANCHO DE LOS COMENTARIOS AL COSTADO DE UNA COLUMNA DE ANCHO #1: width, O CON auto LO QUE QUEDA DE LA
%CELDA O DE LA LINEA. AL MENOS 3em.
\cs_new_protected:Npn \__pgfgo_sgfdiag_side_width:n #1 {
	\bool_if:NT \l__pgfgo_sgfdiag_side_bool {
		\str_if_eq:VnTF \l__pgfgo_sgfdiag_comment_width_tl {auto}
			{
				\dim_set:Nn \l__pgfgo_sgfdiag_side_dim {
					\pgfgo_layout_if_grid:TF {\l__pgfgo_sgfdiag_total_dim} {\linewidth}
					- #1 - \l__pgfgo_sgfdiag_comment_sep_dim
				}
			}
			{\dim_set:Nn \l__pgfgo_sgfdiag_side_dim {\l__pgfgo_sgfdiag_comment_width_tl}}
		\dim_compare:nNnT {\l__pgfgo_sgfdiag_side_dim} < {3em} {\dim_set:Nn \l__pgfgo_sgfdiag_side_dim {3em}}
	}
}

%PONE LOS COMENTARIOS AL COSTADO DE LA CELDA, CON SU PRIMERA LINEA ARRIBA, A LA ALTURA DEL TABLERO. LA CELDA
%CONSERVA SU LINEA DE BASE; EN LA GRILLA, OCUPA EL ANCHO DE LA CELDA ENTERA.
\cs_new_protected:Npn \__pgfgo_sgfdiag_side: {
	\box_if_empty:NF \g__pgfgo_sgfdiag_side_box {
		\hbox_set:Nn \l_tmpb_box {
			\box_move_up:nn {\box_ht:N \l__pgfgo_sgfdiag_cell_box - \box_ht:N \g__pgfgo_sgfdiag_side_box}
				{\box_use:N \g__pgfgo_sgfdiag_side_box}
		}
		\hbox_set:Nn \l__pgfgo_sgfdiag_cell_box {
			\str_if_eq:VnTF \l__pgfgo_sgfdiag_comment_position_tl {right}
				{\box_use:N \l__pgfgo_sgfdiag_cell_box \skip_horizontal:N \l__pgfgo_sgfdiag_comment_sep_dim \box_use:N \l_tmpb_box}
				{\box_use:N \l_tmpb_box \skip_horizontal:N \l__pgfgo_sgfdiag_comment_sep_dim \box_use:N \l__pgfgo_sgfdiag_cell_box}
		}
		\pgfgo_layout_if_cells:T {
			\hbox_set_to_wd:Nnn \l__pgfgo_sgfdiag_cell_box {\l__pgfgo_sgfdiag_total_dim}
				{\box_use:N \l__pgfgo_sgfdiag_cell_box \hfil}
		}
	}
}
%EL MISMO DIAGRAMA, PUESTO EN LA DISPOSICION.
\cs_new_protected:Npn \__pgfgo_sgfdiag_add:nnnn #1#2#3#4 {
	\__pgfgo_sgfdiag_draw:nnnn {#1} {#2} {#3} {#4}
	\pgfgo_layout_add:N \l__pgfgo_sgfdiag_cell_box
}

%EL goban DEL DIAGRAMA (JUGADAS #1 A #2) EN \l__pgfgo_sgfdiag_box.
\cs_new_protected:Npn \__pgfgo_sgfdiag_board:nn #1#2 {
	\prop_gclear:N \g__pgfgo_sgf_shown_prop
	\hbox_set:Nn \l__pgfgo_sgfdiag_box {
		\pgfgo_layout_restore_goban:
		\use:e {
			\exp_not:N \begin{goban}
				[
					size = \l__pgfgo_sgfdiag_size_tl, captures, notes,
					\exp_not:V \l__pgfgo_sgfdiag_window_tl,
					\exp_not:V \l__pgfgo_sgfdiag_goban_tl,
					\exp_not:V \l__pgfgo_sgfdiag_scale_tl
				]
		}
			%COMO EN LOS LIBROS, LAS CAPTURAS DEL TRAMO NUMERADO NO SE QUITAN (SE VEN EN EL DIAGRAMA SIGUIENTE).
			\bool_set_true:N \l__pgfgo_sgf_keep_numbered_bool
			\tl_set_eq:NN \l__pgfgo_sgf_first_tl \l__pgfgo_sgfdiag_first_tl
			\__pgfgo_sgf_extent_add:
			\use:e {
				\exp_not:N \pgfgo_sgf:nn
					{
						from = \int_eval:n {#1},
						to = \int_eval:n {#2},
						variation = {\exp_not:V \l__pgfgo_sgfdiag_variation_tl},
						restart = {\exp_not:V \l__pgfgo_sgfdiag_sgf_restart_tl},
						numbers = \bool_if:NTF \l__pgfgo_sgfdiag_numbers_bool {true} {false},
						marks = \bool_if:NTF \l__pgfgo_sgfdiag_marks_bool {true} {false},
						last~mark = {\tl_if_empty:NTF \l__pgfgo_sgfdiag_last_tl {false} {\exp_not:V \l__pgfgo_sgfdiag_last_tl}}
					}
					{\exp_not:V \l__pgfgo_sgfdiag_file_tl}
			}
		\end{goban}
	}
}

%DEBAJO DEL EPIGRAFE: UN PARRAFO DEL ANCHO DEL DIAGRAMA (#1: \centering, \raggedright, ETC.).
\cs_new_protected:Npn \__pgfgo_sgfdiag_below:nn #1#2 {
	\hbox:n {\parbox[t]{\l__pgfgo_sgfdiag_width_dim} {#1 \l__pgfgo_sgfdiag_font_tl #2}}
}

%LOS COMENTARIOS #1 CON SU ALINEACION Y SU FUENTE (SI NO TIENEN, LA DEL EPIGRAFE): DEBAJO DEL EPIGRAFE, O AL
%COSTADO, EN \g__pgfgo_sgfdiag_side_box (DE ANCHO \l__pgfgo_sgfdiag_side_dim), QUE PONE \__pgfgo_sgfdiag_side:.
\box_new:N \g__pgfgo_sgfdiag_side_box
\dim_new:N \l__pgfgo_sgfdiag_side_dim
%LOS COMENTARIOS SE ARMAN EN UNA CAJA VERTICAL DE PARRAFOS (COMO LOS DE UN \parbox), QUE SE PUEDE CORTAR:
%CON height, LO QUE NO ENTRA VA A \g__pgfgo_sgfdiag_after_box, QUE SE ESCRIBE DESPUES DE LOS DIAGRAMAS.
\box_new:N \l__pgfgo_sgfdiag_comments_box
\box_new:N \l__pgfgo_sgfdiag_top_box
\box_new:N \g__pgfgo_sgfdiag_after_box
\dim_new:N \l__pgfgo_sgfdiag_after_dim
\cs_new_protected:Npn \__pgfgo_sgfdiag_comments_below:n #1 {
	\str_case:VnF \l__pgfgo_sgfdiag_comment_position_tl {
		{after} {
			\__pgfgo_sgfdiag_comments_set:Nn \l__pgfgo_sgfdiag_after_dim {#1}
			\__pgfgo_sgfdiag_after_add:
		}
		{below} {
			\__pgfgo_sgfdiag_comments_set:Nn \l__pgfgo_sgfdiag_width_dim {#1}
			\__pgfgo_sgfdiag_comments_cut:
			\__pgfgo_sgfdiag_comments_use:
		}
	}{
		\__pgfgo_sgfdiag_comments_set:Nn \l__pgfgo_sgfdiag_side_dim {#1}
		\__pgfgo_sgfdiag_comments_cut:
		\hbox_gset:Nn \g__pgfgo_sgfdiag_side_box {\__pgfgo_sgfdiag_comments_use:}
	}
}
%LA CAJA DE LOS COMENTARIOS CON LA LINEA DE BASE EN SU PRIMER RENGLON (COMO UN \parbox[t]).
\cs_new_protected:Npn \__pgfgo_sgfdiag_comments_use: {
	\vbox_top:n {\vbox_unpack:N \l__pgfgo_sgfdiag_comments_box}
}
%LOS COMENTARIOS #2 EN \l__pgfgo_sgfdiag_comments_box, DE ANCHO #1, CON SU ALINEACION Y SU FUENTE.
\cs_new_protected:Npn \__pgfgo_sgfdiag_comments_set:Nn #1#2 {
	\vbox_set:Nn \l__pgfgo_sgfdiag_comments_box {
		\__pgfgo_sgfdiag_par_setup:N #1
		\l__pgfgo_sgfdiag_comment_align_tl
		\__pgfgo_sgfdiag_comment_font:
		#2 \par
	}
}
\cs_new_protected:Npn \__pgfgo_sgfdiag_par_setup:N #1 {
	\use:c {@parboxrestore}
	\dim_set_eq:NN \hsize #1
	\dim_set_eq:NN \linewidth #1
}
\cs_new_protected:Npn \__pgfgo_sgfdiag_comment_font: {
	\tl_if_empty:NTF \l__pgfgo_sgfdiag_comment_font_tl
		{\l__pgfgo_sgfdiag_font_tl} {\l__pgfgo_sgfdiag_comment_font_tl}
}
%CON height: SI LA CAJA ES MAS ALTA, QUEDA LO QUE ENTRA Y EL RESTO VA DESPUES DE LOS DIAGRAMAS.
\cs_new_protected:Npn \__pgfgo_sgfdiag_comments_cut: {
	\str_if_eq:VnF \l__pgfgo_sgfdiag_comment_height_tl {none} {
		\dim_compare:nNnT
			{\box_ht:N \l__pgfgo_sgfdiag_comments_box + \box_dp:N \l__pgfgo_sgfdiag_comments_box}
			> {\l__pgfgo_sgfdiag_comment_height_tl}
			{
				\vbox_set_split_to_ht:NNn \l__pgfgo_sgfdiag_top_box \l__pgfgo_sgfdiag_comments_box
					{\l__pgfgo_sgfdiag_comment_height_tl}
				\__pgfgo_sgfdiag_after_add:
				\box_set_eq:NN \l__pgfgo_sgfdiag_comments_box \l__pgfgo_sgfdiag_top_box
			}
	}
}
%AGREGA \l__pgfgo_sgfdiag_comments_box (SI NO ESTA VACIA) A LOS COMENTARIOS DE DESPUES, CON EL EPIGRAFE DEL
%DIAGRAMA COMO ENCABEZADO.
\cs_new_protected:Npn \__pgfgo_sgfdiag_after_add: {
	\dim_compare:nNnT
		{\box_ht:N \l__pgfgo_sgfdiag_comments_box + \box_dp:N \l__pgfgo_sgfdiag_comments_box} > {0pt}
		{
			\vbox_gset:Nn \g__pgfgo_sgfdiag_after_box {
				\vbox_unpack:N \g__pgfgo_sgfdiag_after_box
				\group_begin:
					\__pgfgo_sgfdiag_par_setup:N \l__pgfgo_sgfdiag_after_dim
					\__pgfgo_sgfdiag_comment_font: \bfseries \l__pgfgo_sgfdiag_caption_tl \par
				\group_end:
				\vbox_unpack:N \l__pgfgo_sgfdiag_comments_box
				\skip_vertical:N \smallskipamount
			}
		}
}
%DESPUES DE LOS DIAGRAMAS: LOS COMENTARIOS DE after O LOS QUE NO ENTRARON (SE PUEDEN CORTAR ENTRE PAGINAS).
\cs_new_protected:Npn \__pgfgo_sgfdiag_after_flush: {
	\box_if_empty:NF \g__pgfgo_sgfdiag_after_box {
		\par \skip_vertical:N \medskipamount
		\vbox_unpack:N \g__pgfgo_sgfdiag_after_box
		\box_gclear:N \g__pgfgo_sgfdiag_after_box
	}
}

%EL NUMERO QUE SE MOSTRO DE LA JUGADA #1 (EL DE LA PARTIDA SI NO SE DIBUJO).
\cs_new:Npn \__pgfgo_sgfdiag_shown:n #1 {
	\prop_if_in:NnTF \g__pgfgo_sgf_shown_prop {#1} {\prop_item:Nn \g__pgfgo_sgf_shown_prop {#1}} {#1}
}

%separator ANTES DE CADA COMENTARIO MENOS EL PRIMERO.
\cs_new_protected:Npn \__pgfgo_sgfdiag_comment_separator: {
	\bool_if:NTF \l__pgfgo_sgfdiag_comment_first_bool
		{\bool_set_false:N \l__pgfgo_sgfdiag_comment_first_bool}
		{\l__pgfgo_sgfdiag_comment_separator_tl}
}

%LAS NOTAS "N at M" Y LOS COMENTARIOS DE LAS JUGADAS #1 A #2 (CON root, SI #1 ES 1, ANTES EL DE LA RAIZ).
\cs_new_protected:Npn \__pgfgo_sgfdiag_notes:nn #1#2 {
	\bool_if:nT {\l__pgfgo_sgfdiag_notes_bool && ! \seq_if_empty_p:N \g_pgfgo_move_notes_seq}
		{\__pgfgo_sgfdiag_below:nn {\l__pgfgo_sgfdiag_align_tl} {\pgfgomovenotes}}
	\bool_if:NT \l__pgfgo_sgfdiag_comments_bool {
		\__pgfgo_sgfdiag_comments_below:n {
			\bool_set_true:N \l__pgfgo_sgfdiag_comment_first_bool
			\bool_lazy_and:nnT {\l__pgfgo_sgfdiag_root_bool} {\int_compare_p:nNn {#1} = {1}}
				{\__pgfgo_sgf_if_comment:nT {0} {\__pgfgo_sgfdiag_comment_separator: \__pgfgo_sgf_comment_use:}}
			\int_step_inline:nnn {#1} {#2} {
				\__pgfgo_sgf_if_comment:nT {##1} {
					\__pgfgo_sgfdiag_comment_separator:
					\exp_args:Ne \__pgfgo_sgfdiag_comment_number:n {\__pgfgo_sgfdiag_shown:n {##1}}
					\__pgfgo_sgf_comment_use:
				}
			}
		}
	}
}

%EL DIAGRAMA #1, CON LAS JUGADAS #2 A #3. #4: EL NUMERO DEL NOMBRE DE SU FIGURA (0: SIN NOMBRE).
\cs_new_protected:Npn \__pgfgo_sgfdiag_diagram:nnnn #1#2#3#4 {
	%LA VISTA QUE ABARCA LAS DE TODAS LAS JUGADAS DEL DIAGRAMA.
	\int_set:Nn \l_pgfgo_goban_sgf_view_from_int {#2}
	\int_set:Nn \l_pgfgo_goban_sgf_view_to_int {#3}
	\__pgfgo_sgfdiag_add:nnnn {#2} {#3}
		{
			\int_compare:nNnTF {#4} > {0}
				{\pgfgo_kernel_sgf_name:n {#4}}
				{\l__pgfgo_sgfdiag_title_tl \nobreakspace \int_eval:n {#1}}
			\nobreakspace (\int_eval:n {#2}--\int_eval:n {#3})
		}
		{
			\__pgfgo_sgfdiag_notes:nn {#2} {#3}
			\bool_lazy_and:nnT
				{\l__pgfgo_sgfdiag_result_bool}
				{\int_compare_p:nNn {#3} = {\l__pgfgo_sgfdiag_total_int}}
				{\__pgfgo_sgfdiag_result:}
		}
}

%EL DIAGRAMA #1 (JUGADAS #2 A #3, CON EL NOMBRE #4), SI TIENE JUGADAS DESDE from: EMPIEZA EN from O DESPUES.
%CON restart, SI NO EMPIEZA EN LA JUGADA 1, LA JUGADA #2 SE MUESTRA COMO restart/from (AUNQUE NO SE DIBUJE).
\tl_new:N \l__pgfgo_sgfdiag_first_tl
\cs_new_protected:Npn \__pgfgo_sgfdiag_range:nnnn #1#2#3#4 {
	\int_compare:nNnF {#3} < {\l__pgfgo_sgfdiag_from_int} {
		\bool_lazy_and:nnTF {\str_if_eq_p:Vn \l__pgfgo_sgfdiag_restart_tl {true}} {\int_compare_p:nNn {#2} > {1}}
			{
				\tl_set:Ne \l__pgfgo_sgfdiag_first_tl {
					\int_eval:n {
						\l__pgfgo_sgfdiag_restart_from_int + \int_max:nn {#2} {\l__pgfgo_sgfdiag_from_int} - (#2)
					}
				}
			}
			{\tl_clear:N \l__pgfgo_sgfdiag_first_tl}
		\__pgfgo_sgfdiag_diagram:nnnn {#1} {\int_max:nn {#2} {\l__pgfgo_sgfdiag_from_int}} {#3} {#4}
		\__pgfgo_sgfdiag_variations:nnn {#1} {#2} {#3}
	}
}

%LAS VARIANTES QUE NACEN EN LAS JUGADAS #2 A #3 DEL DIAGRAMA #1, CADA UNA CON SU LETRA (3a, 3b, ...). LAS
%VARIANTES DE UNA VARIANTE VAN DONDE VA LA VARIANTE DE LA QUE SALEN (NACEN EN LA MISMA JUGADA).
\int_new:N \l__pgfgo_sgfdiag_var_count_int
\cs_new_protected:Npn \__pgfgo_sgfdiag_variations:nnn #1#2#3 {
	\int_zero:N \l__pgfgo_sgfdiag_var_count_int
	\seq_map_inline:Nn \l__pgfgo_sgfdiag_var_seq {\__pgfgo_sgfdiag_var_if:nnnnnnnnn {#1} {#2} {#3} ##1}
}
%#4: CAMINO, #5: PROFUNDIDAD, #6: NACE, #7: EMPIEZA, #8: ULTIMA, #9: COMENTADA. SE DIBUJA SI ESTA EN LA
%LISTA, O SI commented O all LA INCLUYEN (HASTA LA PROFUNDIDAD depth).
\bool_new:N \l__pgfgo_sgfdiag_var_wanted_bool
%#1: CAMINO, #2: PROFUNDIDAD, #3: NACE, #4: COMENTADA.
\cs_new_protected:Npn \__pgfgo_sgfdiag_var_wanted:nnnn #1#2#3#4 {
	\seq_if_in:NnTF \l__pgfgo_sgfdiag_var_found_seq {#1}
		{\bool_set_true:N \l__pgfgo_sgfdiag_var_wanted_bool}
		{
			\bool_set:Nn \l__pgfgo_sgfdiag_var_wanted_bool {
				\int_compare_p:nNn {#2} < {\l__pgfgo_sgfdiag_var_depth_int + 1} &&
				! \int_compare_p:nNn {#3} < {\l__pgfgo_sgfdiag_var_from_int} &&
				(
					\l__pgfgo_sgfdiag_var_all_bool ||
					(\l__pgfgo_sgfdiag_var_commented_bool && \int_compare_p:nNn {#4} = {1})
				)
			}
		}
}
\cs_new_protected:Npn \__pgfgo_sgfdiag_var_if:nnnnnnnnn #1#2#3#4#5#6#7#8#9 {
	\int_compare:nT {#2 <= #6 <= #3} {
		\__pgfgo_sgfdiag_var_wanted:nnnn {#4} {#5} {#6} {#9}
		\bool_if:NT \l__pgfgo_sgfdiag_var_wanted_bool {
			\int_incr:N \l__pgfgo_sgfdiag_var_count_int
			\__pgfgo_sgfdiag_variation:nnnnn {#1 \int_to_alph:n {\l__pgfgo_sgfdiag_var_count_int}} {#4} {#7} {#7} {#8}
		}
	}
}

%EL DIAGRAMA #1 (3a) DE LA VARIANTE #2, QUE REEMPLAZA LA JUGADA #3 DE LA LINEA DE LA QUE SALE: SUS JUGADAS #4 A #5,
%NUMERADAS DESDE 1. SIN LA COPIA DE \sgfdiagrams (LA DE LA LINEA PRINCIPAL QUEDA COMO ESTABA).
\int_new:N \l__pgfgo_sgfdiag_var_move_int
\NewDocumentCommand \pgfgovariationmove {} {\int_use:N \l__pgfgo_sgfdiag_var_move_int}
\cs_new_protected:Npn \__pgfgo_sgfdiag_variation:nnnnn #1#2#3#4#5 {
	\group_begin:
		\bool_set_false:N \l__pgfgo_sgf_cache_bool
		\bool_set_false:N \l__pgfgo_sgfdiag_root_bool
		\bool_set_false:N \l__pgfgo_sgfdiag_result_bool
		\tl_set:Nn \l__pgfgo_sgfdiag_variation_tl {#2}
		\tl_set:Nn \l_pgfgo_goban_sgf_view_variation_tl {#2}
		\tl_set:Nn \l__pgfgo_sgfdiag_first_tl {1}
		\int_set:Nn \l__pgfgo_sgfdiag_var_move_int {#3}
		\int_set:Nn \l_pgfgo_goban_sgf_view_from_int {#4}
		\int_set:Nn \l_pgfgo_goban_sgf_view_to_int {#5}
		\__pgfgo_sgfdiag_add:nnnn {#4} {#5}
			{\l__pgfgo_sgfdiag_title_tl \nobreakspace #1 \nobreakspace (\l__pgfgo_sgfdiag_var_title_tl)}
			{\__pgfgo_sgfdiag_notes:nn {#4} {#5}}
	\group_end:
}

%DEBAJO DEL ULTIMO DIAGRAMA: EL RESULTADO (RE) Y, SI EL ARCHIVO MARCA EL TERRITORIO (TB, TW), EL PUNTAJE DE
%CADA JUGADOR COMO EL DE \pgfgoscore (CON EL komi DE KM).
\tl_new:N \l__pgfgo_sgfdiag_re_tl
\cs_new_protected:Npn \__pgfgo_sgfdiag_result: {
	\tl_set:Ne \l__pgfgo_sgfdiag_re_tl {\exp_args:NV \pgfgo_kernel_sgf_info:nn \l__pgfgo_sgfdiag_file_tl {RE}}
	\bool_lazy_or:nnT
		{! \tl_if_blank_p:V \l__pgfgo_sgfdiag_re_tl}
		{! \prop_if_empty_p:N \g_pgfgo_territory_prop}
		{
			\__pgfgo_sgfdiag_below:nn {\l__pgfgo_sgfdiag_align_tl} {
				\l__pgfgo_sgfdiag_result_title_tl :~
				\tl_if_blank:VF \l__pgfgo_sgfdiag_re_tl {
					\str_if_eq:VnTF \l__pgfgo_sgfdiag_result_format_tl {raw}
						{\tl_use:N \l__pgfgo_sgfdiag_re_tl}
						{\exp_args:NV \__pgfgo_sgfdiag_result_text:n \l__pgfgo_sgfdiag_re_tl}
				}
				\prop_if_empty:NF \g_pgfgo_territory_prop {
					\tl_if_blank:VTF \l__pgfgo_sgfdiag_re_tl
						{\__pgfgo_sgfdiag_score:n {}}
						{\__pgfgo_sgfdiag_score:n {~(} )}
				}
			}
		}
}
\cs_new_protected:Npn \__pgfgo_sgfdiag_score:n #1 {
	#1
	\l__pgfgo_sgfdiag_black_tl \nobreakspace \pgfgoscore{black},~
	\l__pgfgo_sgfdiag_white_tl \nobreakspace \__pgfgo_sgfdiag_white_score:V \l__pgfgo_sgfdiag_komi_tl
}
\cs_new_protected:Npn \__pgfgo_sgfdiag_white_score:n #1 {\pgfgoscore[komi = {#1}]{white}}
\cs_generate_variant:Nn \__pgfgo_sgfdiag_white_score:n {V}

%EL RESULTADO #1 (RE) EN PALABRAS, CON LOS TEXTOS DEL IDIOMA (VER pgf-go-lang.sty): 0 O Draw, Void, ?, Y B+
%O W+ SEGUIDO DE NADA, DE LA DIFERENCIA, DE R (Resign), T (Time) O F (Forfeit). OTRA COSA SE ESCRIBE COMO ESTA.
%EN LOS TEXTOS, \pgfgowinner ES EL NOMBRE DEL GANADOR (black name O white name) Y \pgfgopoints LA DIFERENCIA.
\tl_new:N \l__pgfgo_sgfdiag_winner_tl
\tl_new:N \l__pgfgo_sgfdiag_points_tl
\seq_new:N \l__pgfgo_sgfdiag_re_seq
\NewDocumentCommand \pgfgowinner {} {\l__pgfgo_sgfdiag_winner_tl}
\NewDocumentCommand \pgfgopoints {} {\l__pgfgo_sgfdiag_points_tl}
\cs_new_protected:Npn \__pgfgo_sgfdiag_result_text:n #1 {
	\str_case_e:nnF {\str_lowercase:n {#1}} {
		{0}				{\pgfgo_text:n {draw}}
		{draw}		{\pgfgo_text:n {draw}}
		{void}		{\pgfgo_text:n {void}}
		{?}				{\pgfgo_text:n {unknown~result}}
	}{
		\regex_extract_once:nnNTF {\A([BbWw])\+(.*)\Z} {#1} \l__pgfgo_sgfdiag_re_seq
			{
				\str_if_eq:eeTF {\str_uppercase:f {\seq_item:Nn \l__pgfgo_sgfdiag_re_seq {2}}} {B}
					{\tl_set_eq:NN \l__pgfgo_sgfdiag_winner_tl \l__pgfgo_sgfdiag_black_tl}
					{\tl_set_eq:NN \l__pgfgo_sgfdiag_winner_tl \l__pgfgo_sgfdiag_white_tl}
				\tl_set:Ne \l__pgfgo_sgfdiag_points_tl {\seq_item:Nn \l__pgfgo_sgfdiag_re_seq {3}}
				\str_case_e:nnF {\str_lowercase:f {\l__pgfgo_sgfdiag_points_tl}} {
					{}				{\pgfgo_text:n {win}}
					{r}				{\pgfgo_text:n {win~by~resignation}}
					{resign}	{\pgfgo_text:n {win~by~resignation}}
					{t}				{\pgfgo_text:n {win~on~time}}
					{time}		{\pgfgo_text:n {win~on~time}}
					{f}				{\pgfgo_text:n {win~by~forfeit}}
					{forfeit}	{\pgfgo_text:n {win~by~forfeit}}
				}{
					\regex_match:nVTF {\A\d+(\.\d*)?\Z} \l__pgfgo_sgfdiag_points_tl
						{\pgfgo_text:n {win~by~points}}
						{#1}
				}
			}
			{#1}
	}
}

%UN DIAGRAMA POR FIGURA (FG): DESDE DONDE EMPIEZA HASTA LA JUGADA ANTERIOR A LA FIGURA SIGUIENTE. SI LA
%PRIMERA FIGURA NO EMPIEZA EN LA JUGADA 1, LAS JUGADAS ANTERIORES SON UN DIAGRAMA MAS.
\int_new:N \l__pgfgo_sgfdiag_count_int
\seq_new:N \l__pgfgo_sgfdiag_figures_seq
\cs_new_protected:Npn \__pgfgo_sgfdiag_figures: {
	\seq_set_eq:NN \l__pgfgo_sgfdiag_figures_seq \l_pgfgo_kernel_sgf_figures_seq
	\seq_get_left:NN \l__pgfgo_sgfdiag_figures_seq \l_tmpa_tl
	\int_compare:nNnT {\exp_after:wN \use_i:nn \l_tmpa_tl} > {1}
		{\seq_put_left:Nn \l__pgfgo_sgfdiag_figures_seq {{1}{0}}}
	\seq_put_right:Ne \l__pgfgo_sgfdiag_figures_seq {{\int_eval:n {\l__pgfgo_sgfdiag_last_int + 1}}{0}}
	\int_zero:N \l__pgfgo_sgfdiag_count_int
	\int_step_inline:nn {\seq_count:N \l__pgfgo_sgfdiag_figures_seq - 1} {
		\use:e {
			\exp_not:N \__pgfgo_sgfdiag_figure:nnnn
				\seq_item:Nn \l__pgfgo_sgfdiag_figures_seq {##1}
				\seq_item:Nn \l__pgfgo_sgfdiag_figures_seq {##1 + 1}
		}
	}
}
%#1#2: {JUGADA}{NOMBRE} DE LA FIGURA, #3#4: LOS DE LA SIGUIENTE.
\cs_new_protected:Npn \__pgfgo_sgfdiag_figure:nnnn #1#2#3#4 {
	\int_compare:nNnT {#1} < {#3} {
		\int_compare:nNnF {#1} > {\l__pgfgo_sgfdiag_last_int} {
			\int_incr:N \l__pgfgo_sgfdiag_count_int
			\__pgfgo_sgfdiag_range:nnnn {\l__pgfgo_sgfdiag_count_int} {#1}
				{\int_min:nn {#3 - 1} {\l__pgfgo_sgfdiag_last_int}} {#2}
		}
	}
}

%UN DIAGRAMA CADA step JUGADAS: EL DIAGRAMA n TIENE TANTAS COMO EL ELEMENTO n DE step (O EL ULTIMO).
\int_new:N \l__pgfgo_sgfdiag_start_int
\int_new:N \l__pgfgo_sgfdiag_length_int
\cs_new_protected:Npn \__pgfgo_sgfdiag_steps: {
	\clist_if_empty:NT \l__pgfgo_sgfdiag_step_clist {\clist_set:Nn \l__pgfgo_sgfdiag_step_clist {50}}
	\int_zero:N \l__pgfgo_sgfdiag_count_int
	\int_set:Nn \l__pgfgo_sgfdiag_start_int {1}
	\int_until_do:nNnn {\l__pgfgo_sgfdiag_start_int} > {\l__pgfgo_sgfdiag_last_int} {
		\int_incr:N \l__pgfgo_sgfdiag_count_int
		\int_set:Nn \l__pgfgo_sgfdiag_length_int {
			\int_max:nn {1} {
				\clist_item:Nn \l__pgfgo_sgfdiag_step_clist
					{\int_min:nn {\l__pgfgo_sgfdiag_count_int} {\clist_count:N \l__pgfgo_sgfdiag_step_clist}}
			}
		}
		\use:e {
			\exp_not:N \__pgfgo_sgfdiag_range:nnnn
				{\int_use:N \l__pgfgo_sgfdiag_count_int}
				{\int_use:N \l__pgfgo_sgfdiag_start_int}
				{\int_min:nn {\l__pgfgo_sgfdiag_start_int + \l__pgfgo_sgfdiag_length_int - 1} {\l__pgfgo_sgfdiag_last_int}}
				{0}
		}
		\int_add:Nn \l__pgfgo_sgfdiag_start_int {\l__pgfgo_sgfdiag_length_int}
	}
}

\cs_new_protected:Npn \pgfgo_sgfdiagrams:nn #1#2 {
	\group_begin:
		\pgfgo_sgf_use_name:n {#2}
		\keys_set:nn {pgfgo / sgf~diagrams} {#1}
		\bool_set_eq:NN \l__pgfgo_sgf_annotations_bool \l__pgfgo_sgfdiag_annotations_bool
		\bool_set_eq:NN \l__pgfgo_sgf_chat_bool \l__pgfgo_sgfdiag_chat_bool
		%CADA DIAGRAMA SIGUE LA PARTIDA DESDE EL ANTERIOR (VER \__pgfgo_sgf_play:).
		\__pgfgo_sgf_cache_begin:
		\__pgfgo_sgfdiag_begin:Nn \l__pgfgo_sgfdiag_layout_tl {#2}
		\tl_clear:N \l__pgfgo_sgf_extent_tl
		\exp_args:NnV \pgfgo_kernel_sgf_read:nn {#2} \l__pgfgo_sgfdiag_variation_tl
		\__pgfgo_sgf_size:N \l__pgfgo_sgfdiag_size_tl
		\tl_set_eq:NN \l__pgfgo_sgfdiag_komi_tl \l_pgfgo_kernel_sgf_komi_tl
		\__pgfgo_sgfdiag_var_setup:n {#2}
		%CON true, CADA DIAGRAMA SE NUMERA CON \l__pgfgo_sgfdiag_first_tl: \sgf NO REINICIA.
		\tl_set:Ne \l__pgfgo_sgfdiag_sgf_restart_tl
			{\str_if_eq:VnTF \l__pgfgo_sgfdiag_restart_tl {auto} {auto} {false}}
		\tl_set:Ne \l__pgfgo_sgfdiag_window_tl {
			\bool_if:NT \l__pgfgo_sgfdiag_partial_bool {partial = auto,}
			\bool_if:NT \l__pgfgo_sgfdiag_view_bool {sgf~view = {\exp_not:n {#2}}}
		}
		\tl_set_eq:NN \l_pgfgo_goban_sgf_view_variation_tl \l__pgfgo_sgfdiag_variation_tl
		\__pgfgo_sgf_count_moves:Nn \l__pgfgo_sgfdiag_total_int {\c_max_int}
		\int_set:Nn \l__pgfgo_sgfdiag_last_int {
			\int_compare:nNnTF {\l__pgfgo_sgfdiag_to_int} < {0}
				{\l__pgfgo_sgfdiag_total_int}
				{\int_min:nn {\l__pgfgo_sgfdiag_to_int} {\l__pgfgo_sgfdiag_total_int}}
		}
		\bool_if:NT \l__pgfgo_sgfdiag_partial_bool {\__pgfgo_sgfdiag_extent:n {#2}}
		\bool_lazy_and:nnTF {\l__pgfgo_sgfdiag_figures_bool} {! \seq_if_empty_p:N \l_pgfgo_kernel_sgf_figures_seq}
			{\__pgfgo_sgfdiag_figures:}
			{\__pgfgo_sgfdiag_steps:}
		\pgfgo_layout_end:
		\__pgfgo_sgfdiag_after_flush:
	\group_end:
}

%LAS VARIANTES DEL ARCHIVO #1 QUE PUEDEN DIBUJARSE: LAS QUE SE APARTAN DE LA LINEA QUE SE DIBUJA (LA DE
%variation). LOS CAMINOS DE LA LISTA,
%COMO NUMEROS SIN LOS 1 DEL FINAL (2.3.1 ES LA MISMA LINEA QUE 2.3), QUEDAN EN \l__pgfgo_sgfdiag_var_found_seq.
%UN CAMINO QUE NO ES UNA VARIANTE DA UN AVISO.
\msg_new:nnn {pgfgo} {sgf-no-variation}
	{'#1'~has~no~variation~'#2':~it~is~not~drawn.}
\seq_new:N \l__pgfgo_sgfdiag_var_seq
\seq_new:N \l__pgfgo_sgfdiag_var_found_seq
\cs_new_protected:Npn \__pgfgo_sgfdiag_var_setup:n #1 {
	\seq_clear:N \l__pgfgo_sgfdiag_var_seq
	\seq_clear:N \l__pgfgo_sgfdiag_var_found_seq
	\bool_lazy_or:nnT
		{\l__pgfgo_sgfdiag_var_commented_bool || \l__pgfgo_sgfdiag_var_all_bool}
		{! \seq_if_empty_p:N \l__pgfgo_sgfdiag_var_paths_seq}
		{
			\exp_args:NnV \pgfgo_kernel_sgf_branches:nn {#1} \l__pgfgo_sgfdiag_variation_tl
			\seq_set_eq:NN \l__pgfgo_sgfdiag_var_seq \l_pgfgo_kernel_sgf_branches_seq
			\seq_map_inline:Nn \l__pgfgo_sgfdiag_var_paths_seq {
				\pgfgo_kernel_sgf_path:nn {#1} {##1}
				\seq_put_right:NV \l__pgfgo_sgfdiag_var_found_seq \l_pgfgo_kernel_sgf_path_tl
				\bool_set_false:N \l_tmpa_bool
				\seq_map_inline:Nn \l__pgfgo_sgfdiag_var_seq {
					\str_if_eq:eeT {\use_i:nnnnnn ####1} {\l_pgfgo_kernel_sgf_path_tl}
						{\bool_set_true:N \l_tmpa_bool \seq_map_break:}
				}
				\bool_if:NF \l_tmpa_bool {\msg_warning:nnnn {pgfgo} {sgf-no-variation} {#1} {##1}}
			}
			%LA LECTURA DE LA LINEA QUE SE DIBUJA QUEDA COMO ESTABA.
			\exp_args:NnV \pgfgo_kernel_sgf_read:nn {#1} \l__pgfgo_sgfdiag_variation_tl
		}
}

%partial = auto: LA PARTE VISIBLE DE LA LINEA QUE SE DIBUJA Y DE LAS VARIANTES QUE SE DIBUJAN (LAS QUE
%NACEN HASTA LA ULTIMA JUGADA), DEL ARCHIVO #1.
\tl_new:N \l__pgfgo_sgfdiag_extent_tl
\cs_new_protected:Npn \__pgfgo_sgfdiag_extent:n #1 {
	\tl_set_eq:NN \l__pgfgo_sgfdiag_extent_tl \l__pgfgo_sgfdiag_variation_tl
	\seq_map_inline:Nn \l__pgfgo_sgfdiag_var_seq {\__pgfgo_sgfdiag_extent:nnnnnn ##1}
	\__pgfgo_sgf_extent:nV {#1} \l__pgfgo_sgfdiag_extent_tl
}
\cs_new_protected:Npn \__pgfgo_sgfdiag_extent:nnnnnn #1#2#3#4#5#6 {
	\int_compare:nNnF {#3} > {\l__pgfgo_sgfdiag_last_int} {
		\__pgfgo_sgfdiag_var_wanted:nnnn {#1} {#2} {#3} {#6}
		\bool_if:NT \l__pgfgo_sgfdiag_var_wanted_bool {\tl_put_right:Nn \l__pgfgo_sgfdiag_extent_tl {; #1}}
	}
}

\NewDocumentCommand{\sgfdiagrams}{O{}m}{
	\__pgfgo_sgf_if_kernel:n {\pgfgo_sgfdiagrams:nn {#1} {#2}}
}



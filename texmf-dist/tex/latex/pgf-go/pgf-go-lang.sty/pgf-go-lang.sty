%IDIOMAS
\ExplSyntaxOn

%LOS TEXTOS QUE ESCRIBE EL PAQUETE (EPIGRAFES, ANOTACIONES, RESULTADO) SALEN DE UN DICCIONARIO POR IDIOMA,
%\g__pgfgo_lang_<idioma>_prop. LAS CLAVES QUE LOS USAN TIENEN COMO VALOR INICIAL \pgfgo_text:n {<texto>},
%QUE SE RESUELVE RECIEN AL ESCRIBIRLO: ASI SIGUE A \selectlanguage Y CADA TEXTO SE PUEDE PISAR CON SU CLAVE,
%ANTES O DESPUES DE lang. UN TEXTO QUE FALTA EN UN IDIOMA SE TOMA DEL INGLES.
%\g__pgfgo_lang_alias_prop: NOMBRE (DE babel, DE polyglossia O EL CODIGO MISMO) -> CODIGO DEL IDIOMA.
\prop_new:N \g__pgfgo_lang_alias_prop
%lang: auto (EL IDIOMA DE babel O polyglossia, \languagename) O EL CODIGO DE UN IDIOMA.
\tl_new:N \l__pgfgo_lang_lang_tl
\tl_set:Nn \l__pgfgo_lang_lang_tl {auto}

%AGREGA LOS TEXTOS #2 (texto = traduccion, ...) AL IDIOMA #1 (LO CREA SI NO EXISTE).
\cs_new_protected:Npn \pgfgo_lang_define:nn #1#2 {
	\prop_if_exist:cF {g__pgfgo_lang_ #1 _prop} {\prop_new:c {g__pgfgo_lang_ #1 _prop}}
	\prop_gput:Nnn \g__pgfgo_lang_alias_prop {#1} {#1}
	\prop_gput_from_keyval:cn {g__pgfgo_lang_ #1 _prop} {#2}
}
%LOS NOMBRES #2 (LISTA) SON OTROS NOMBRES DEL IDIOMA #1.
\cs_new_protected:Npn \pgfgo_lang_alias:nn #1#2 {
	\clist_map_inline:nn {#2} {\prop_gput:Nnn \g__pgfgo_lang_alias_prop {##1} {#1}}
}
\NewDocumentCommand \pgfgodefinelanguage {mm} {\pgfgo_lang_define:nn {#1} {#2}}
\NewDocumentCommand \pgfgolanguagealias {mm} {\pgfgo_lang_alias:nn {#2} {#1}}

%EL CODIGO DEL IDIOMA DE NOMBRE #1, O SI NO SE CONOCE, EL DE LO QUE ESTA ANTES DEL PRIMER GUION
%(spanish-mexico, es-AR). VACIO SI TAMPOCO SE CONOCE. EXPANDIBLE.
\cs_new:Npn \__pgfgo_lang_code:n #1 {
	\prop_if_in:NnTF \g__pgfgo_lang_alias_prop {#1}
		{\prop_item:Nn \g__pgfgo_lang_alias_prop {#1}}
		{\__pgfgo_lang_code_base:w #1 - \q_stop}
}
\cs_new:Npn \__pgfgo_lang_code_base:w #1 - #2 \q_stop {
	\prop_if_in:NnT \g__pgfgo_lang_alias_prop {#1}
		{\prop_item:Nn \g__pgfgo_lang_alias_prop {#1}}
}
\cs_generate_variant:Nn \__pgfgo_lang_code:n {e}

%EL IDIOMA ACTUAL. CON lang = auto, EL DE \languagename (QUE LaTeX DEFINE COMO english SIN babel NI
%polyglossia); SI NO SE CONOCE, en. EXPANDIBLE.
\cs_new:Npn \__pgfgo_lang_language: {
	\str_if_eq:VnTF \l__pgfgo_lang_lang_tl {auto}
		{
			\cs_if_exist:NTF \languagename
				{\exp_args:Ne \__pgfgo_lang_or_en:n {\__pgfgo_lang_code:e {\languagename}}}
				{en}
		}
		{\tl_use:N \l__pgfgo_lang_lang_tl}
}
\cs_new:Npn \__pgfgo_lang_or_en:n #1 {\tl_if_empty:nTF {#1} {en} {#1}}

%EL TEXTO #1 EN EL IDIOMA ACTUAL. EXPANDIBLE.
\cs_new:Npn \pgfgo_text:n #1 {
	\exp_args:Ne \__pgfgo_text:nn {\__pgfgo_lang_language:} {#1}
}
\cs_new:Npn \__pgfgo_text:nn #1#2 {
	\prop_if_in:cnTF {g__pgfgo_lang_ #1 _prop} {#2}
		{\prop_item:cn {g__pgfgo_lang_ #1 _prop} {#2}}
		{\prop_item:Nn \g__pgfgo_lang_en_prop {#2}}
}
\NewExpandableDocumentCommand \pgfgotext {m} {\pgfgo_text:n {#1}}

\msg_new:nnn {pgfgo} {unknown-language}
	{Unknown~language~'#1'~for~pgf-go:~using~English.~Define~it~with~\iow_char:N\\pgfgodefinelanguage~
	or~give~it~another~name~with~\iow_char:N\\pgfgolanguagealias.}

\cs_new_protected:Npn \pgfgo_lang_set:n #1 {
	\str_if_eq:nnTF {#1} {auto}
		{\tl_set:Nn \l__pgfgo_lang_lang_tl {auto}}
		{
			\tl_set:Ne \l__pgfgo_lang_lang_tl {\__pgfgo_lang_code:n {#1}}
			\tl_if_empty:NT \l__pgfgo_lang_lang_tl {
				\msg_warning:nnn {pgfgo} {unknown-language} {#1}
				\tl_set:Nn \l__pgfgo_lang_lang_tl {en}
			}
		}
}
\keys_define:nn {pgfgo} {
	lang		.code:n			= {\pgfgo_lang_set:n {#1}},
}
%CON lang = auto, AVISA SI EL IDIOMA DEL DOCUMENTO NO SE CONOCE.
\AddToHook {begindocument / end} {
	\bool_lazy_and:nnT
		{\str_if_eq_p:Vn \l__pgfgo_lang_lang_tl {auto}}
		{\cs_if_exist_p:N \languagename}
		{
			\tl_if_blank:eT {\__pgfgo_lang_code:e {\languagename}}
				{\msg_warning:nne {pgfgo} {unknown-language} {\languagename}}
		}
}


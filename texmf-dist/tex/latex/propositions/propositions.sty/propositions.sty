    \bool_if:NT \g__props_zrefclever_bool
      {
        \tl_if_empty:NTF \l__props_crefname_tl
          { \__props_set_zc_type:n { prop } }
          { \exp_args:NV \__props_set_zc_type:n \l__props_crefname_tl }
      }
    \refstepcounter { prop@anchor }
  }



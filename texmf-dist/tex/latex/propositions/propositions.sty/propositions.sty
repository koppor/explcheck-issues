\cs_new_protected:Nn \__props_sync_equation_hooks:
  {
    \__props_decl_reset:
    \tl_set:Nn \l__props_style_tl { equation }
    \__props_style_load:
    \cs_set_eq:NN \__props_eqdispfmt:n \l__props_displayfmt:n
    \cs_set_eq:NN \__props_eqreffmt:n  \l__props_reffmt:n
  }

\AtBeginDocument
  {
    \bool_if:NT \g__props_equations_bool
      {
        \bool_gset_true:N \g__props_eqhooks_bool
        \__props_sync_equation_hooks:
      }
    \bool_if:NT \g__props_eqhooks_bool
      {
        %% Redefine the equation "prefix" macro so that \ref{eq:foo}
        %% produces \propapply{format}{number} instead of a bare number.
        %% This makes equation refs work with \oref and \nref.
        \cs_set:cpn { p@equation } #1
          { \propapply { \__props_eqreffmt:n { \propfmtarg } } { #1 } }
        %% Redefine \tagform@ so that displayed equation tags use
        %% the display format.  \tag* (used by \ptag) bypasses this, and so
        %% reaches the format by the ordinary item path instead.
        %%
        %% amsmath writes \maketag@@@{(\ignorespaces#1\unskip\@@italiccorr)},
        %% guarding the number against stray spaces and adding an italic
        %% correction before its closing parenthesis.  We take over the
        %% parentheses, so those guards would land *inside* the format's
        %% argument and become part of #1 --- harmless to a format that prints
        %% #1, but not to one that uses it as data: \index{eq #1} then wrote
        %% the key "eq \ignorespaces 1\unskip \@@italiccorr".  Trimming the
        %% token list does the same work in the data domain, and \tag{ 5 } is
        %% still tagged 5 rather than " 5 ".
        %%
        %% The italic correction is dropped rather than moved outside, where it
        %% would sit after the closing parenthesis instead of before it.  A
        %% format wanting an italic number should say display~format =
        %% (\textit{#1}), which supplies the correction itself.
        \cs_set:Npn \tagform@ #1
          {
            \tl_set:Nn \l__props_eqtag_tl {#1}
            \tl_trim_spaces:N \l__props_eqtag_tl
            \maketag@@@
              { \exp_args:NV \__props_eqdispfmt:n \l__props_eqtag_tl }
          }
      }
  }



\cs_new_protected:Nn \__props_build_ref_text:
  {
    %% Build a \propapply{template}{content} token list for the aux file.
    %%
    %% An item with nothing to refer to takes no reference format, exactly as
    %% one with nothing to display takes no display format (see
    %% \cs{__props_build_item_output:}).  Otherwise \cs{ref} to an item with no
    %% label would print the format's decoration wrapped around nothing---"()"
    %% under the default nameless style---where it should print nothing.
    \tl_if_empty:NTF \l__props_ref_text_tl
      { \tl_set:Nn \l__props_ref_tpl_tl { \propfmtarg } }
      {
        \protected@edef \l__props_ref_tpl_tl
          { \l__props_reffmt:n { \propfmtarg } }
      }
    \protected@edef \l__props_ref_cnt_tl { \l__props_ref_text_tl }
    \protected@edef \l__props_ref_result_tl
      {
        \propapply
          { \exp_not:V \l__props_ref_tpl_tl }
          { \exp_not:V \l__props_ref_cnt_tl }
      }
    %% The template and content are also saved globally for \lastref and the
    %% parent stacks (pushed when entering a nested prop environment)---but not
    %% by an item carrying \texttt{reset = false}.  Such an item continues its
    %% predecessor's sub-numbering rather than starting afresh, so the sub-list
    %% that follows it belongs, for referring purposes, to whatever the run
    %% began under: taking this item as the parent would give a run reading
    %% 1a, 1b, 2c, 2d, whose letters answer to one parent and whose prefixes to
    %% another.  This is what makes an unlabelled aside usable as an intertext
    %% break in a run of clauses, \texttt{nolabel} being \texttt{reset = false};
    %% \texttt{[style = nolabel, reset = true]} is then the way to have an
    %% unlabelled item start a fresh sub-list, whose items refer with no prefix
    %% rather than inheriting one that is no longer theirs.
    \bool_if:NT \l__props_reset_bool
      {
        \tl_gset_eq:NN \g__props_last_tpl_tl \l__props_ref_tpl_tl
        \tl_gset_eq:NN \g__props_last_cnt_tl \l__props_ref_cnt_tl
      }
  }


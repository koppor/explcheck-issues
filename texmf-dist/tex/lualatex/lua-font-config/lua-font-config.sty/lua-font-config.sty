\cs_new_protected:Npn \__lfc_font_config:nn #1#2 {
  \bool_set_false:N \l__lfc_do_bool
  \__lfc_set_font_set:n {#1}
  \keys_set:nn {lfc} {#2}
  \bool_if:NT \l__lfc_do_bool {
    \__lfc_configure_doc_families:
  }
}
\NewDocumentCommand\fontconfig { O {default} m } {
  \__lfc_font_config:nn {#1} {#2}
}
\NewDocumentCommand\newfontset { o m } {
  \str_if_eq:eeTF {default} {#2} {
    \msg_warning:nn {lfc} {meta-fam-default-name}
  } {
    \cs_if_exist:NF \__lfc_font_set_default:  {
      \msg_error:nn {lfc} {meta-fam-no-default}
    }
    \bool_if:NF \g__lfc_lum_done_bool {
      \IfPackageLoadedTF {unicode-math} {
        \msg_error:nnn {lfc} {math-needs-lum} {font~sets}
      } {

\clist_map_inline:nn {rm, sf, tt} {
  \keys_define:nn {lfc} {
    #1 .code:n            = {
      \tl_clear:N \l__lfc_tmpa_tl
      \tl_clear:N \l__lfc_tmpb_tl
      \keys_set_exclude_groups:nnnN {lfc/#1} {config} {##1} \l__lfc_tmpa_tl
      \keys_set_groups:nnVN {lfc/#1} {config}     \l__lfc_tmpa_tl \l__lfc_tmpb_tl
      \keys_set_groups:nnV  {lfc/#1} {lateconfig} \l__lfc_tmpb_tl
      \bool_set_true:N \l__lfc_do_bool
    },
    #1 .value_required:n  = true,
    #1 .usage:n           = preamble,
  }
  \keys_define:nn {lfc/#1} {
    name        .code:n   = { \use:c {__lfc_set_#1:n} {##1} },
    bfseries    .code:n   = {
      \__lfc_parse_series:nn {bfseries} {##1}
    },
    bold        .code:n   = {
      \str_set_eq:NN \l__lfc_weight_str \c_empty_str
      \str_set_eq:NN \l__lfc_width_str \c_empty_str
      \keys_set:nn {lfc/#1/series} {##1}
      \__lfc_parse_series:nVV {bfseries} \l__lfc_weight_str \l__lfc_width_str
    },
    mdseries    .code:n   = {
      \__lfc_parse_series:nn {mdseries} {##1}
    },
    normal      .code:n   = {
      \str_set_eq:NN \l__lfc_weight_str \c_empty_str
      \str_set_eq:NN \l__lfc_width_str \c_empty_str
      \keys_set:nn {lfc/#1/series} {##1}
      \__lfc_parse_series:nVV {mdseries} \l__lfc_weight_str \l__lfc_width_str
    },
    series / weight .str_set:N = \l__lfc_weight_str,
    series / width  .str_set:N = \l__lfc_width_str,
    fakebold    .code:n   = { \keys_set:nn {lfc/fam} {fakebold    = {##1}} },
    fakeoblique .code:n   = { \keys_set:nn {lfc/fam} {fakeoblique = {##1}} },
    fea         .code:n   = { \keys_set:nn {lfc/fam} {fea         = {##1}} },
    features    .code:n   = { \keys_set:nn {lfc/fam} {features    = {##1}} },
    force       .code:n   = { \keys_set:nn {lfc/fam} {force       = {##1}} },
    hyphenchar  .code:n   = { \keys_set:nn {lfc/fam} {hyphenchar  = {##1}} },
    scale       .code:n   = { \keys_set:nn {lfc/fam} {scale       = {##1}} },
    scoped      .code:n   = { \keys_set:nn {lfc/fam} {scoped      =  ##1}  },
    maths       .code:n   = { \__lfc_set_fam_cfg:nn   {maths}{##1} },
    math        .meta:n   = { maths = {##1} },
    nomaths     .meta:n   = { maths = false },
    nomath      .meta:n   = { nomaths },
    unknown     .code:n   = {
      \exp_args:NnV \use:c {__lfc_set_#1:n} \l_keys_key_str
    },
    name          .value_required:n   = true,
    math          .default:n          = true,
    maths         .default:n          = true,
    nomath        .value_forbidden:n  = true,
    nomaths       .value_forbidden:n  = true,
    unknown       .value_forbidden:n  = true,
    fea           .groups:n           = config,
    features      .groups:n           = lateconfig,
    force         .groups:n           = config,
    hyphenchar    .groups:n           = config,
    maths         .groups:n           = config,
    math          .groups:n           = config,
    nomath        .groups:n           = config,
    nomaths       .groups:n           = config,
    scale         .groups:n           = config,
    scoped        .groups:n           = config,
  }
}
\keys_define:nn {lfc} {
  debug   .code:n           = {
    \tl_clear:N \l__lfc_tmpa_tl
    \keys_set_groups:nnnN
      {lfc/debug} {toggle} {state = true, #1} \l__lfc_tmpa_tl
    \keys_set:nV {lfc/debug} \l__lfc_tmpa_tl
  },
  debug   .usage:n          = general,
  family  .code:n           = {
    \tl_clear:N \l__lfc_tmpa_tl
    \tl_clear:N \l__lfc_tmpb_tl
    \str_clear:N \l__lfc_scope_str
    \keys_set_exclude_groups:nnnN
                          {lfc/fam} {config,lateconfig} {#1} \l__lfc_tmpa_tl
    \keys_set_groups:nnVN {lfc/fam} {config}      \l__lfc_tmpa_tl \l__lfc_tmpb_tl
    \keys_set_groups:nnV  {lfc/fam} {lateconfig}  \l__lfc_tmpb_tl
    \bool_set_true:N \l__lfc_do_bool
  },
  family  .value_required:n = true,
  family  .usage:n          = general,
  math    .code:n           = {
    \bool_if:NF \g__lfc_lum_done_bool {
      \IfPackageLoadedTF {unicode-math} {
        \msg_error:nnn {lfc} {math-needs-lum} {math~config}
      } {
        \msg_info:nnn {lfc} {loading} {lua-unicode-math}
        \RequirePackage{lua-unicode-math}
        \bool_gset_true:N \g__lfc_lum_done_bool
      }
    }
    \tl_clear:N \l__lfc_tmpa_tl
    \keys_set_exclude_groups:nnnN {lfc/math} {config} {#1} \l__lfc_tmpa_tl
    \keys_set:nV {lfc/math} \l__lfc_tmpa_tl
    \bool_set_true:N \l__lfc_do_bool
  },
  math    .value_required:n = true,
  math    .usage:n          = preamble,
}
\keys_define:nn {lfc/fam} {
  name        .code:n = { \__lfc_set_fam_name:n {#1} },
  command     .code:n = {
    \exp_args:Nne \__lfc_set_fam_cfg:nn {csname}{ \cs_to_str:N #1 }
  },
  fakebold    .code:n = {
    \__lfc_set_fam_cfg:nn {fakebold} {#1}
  },
  fakeoblique .code:n = {
    \__lfc_set_fam_cfg:nn {fakeoblique} {#1}
  },
  fea         .code:n = { \__lfc_set_fam_cfg:nn {fea} {#1} },
  features    .code:n = {
    \seq_clear:N \l__lfc_features_seq
    \str_set:Ne \l__lfc_scope_str {*\c_colon_str*}

    \keys_set_groups:nnnN {lfc/features} {scope} {#1} \l__lfc_tempc_tl
    \keys_set:nV {lfc/features} \l__lfc_tempc_tl

    \seq_if_empty:NF \l__lfc_features_seq {
      \str_if_eq:eeTF {\l__lfc_scope_str} {\c__lfc_scope_default_str} {
        \exp_args:Nne \__lfc_set_fam_cfg:nn {fea} {
          \seq_use:Nn \l__lfc_features_seq {;}
        }
      } {
        \__lfc_set_fam_scoped_fea:Ve \l__lfc_scope_str {
          \seq_use:Nn \l__lfc_features_seq {;}
        }
      }
    }
    \str_clear:N \l__lfc_scope_str
  },
  force         .code:n = { \__lfc_set_fam_cfg:nn {force}{#1} },
  hyphenchar    .choices:nn = {false,true}{
    \__lfc_set_fam_cfg:nn {hyphenchar}{#1}
  },
  scale         .code:n = { \__lfc_set_fam_cfg:nn {scale}{#1} },
  scoped.code:n = {
    \str_set:Ne \l__lfc_tmpa_str {
      \__lfc_second_of_two:w #1 \q_stop
    }
    \str_if_empty:NTF \l__lfc_tmpa_str {
      \__lfc_set_fam_cfg:nn {fea} {#1}
    } {
      \__lfc_set_fam_scoped_fea:nn #1
    }
  },
  unknown   .code:n = {
    \exp_args:NV \__lfc_set_fam_name:n \l_keys_key_str
  },
  name          .value_required:n   = true,
  fakebold      .default:n          = 1.5,
  fakeoblique   .default:n          = 0.2,
  fea           .value_required:n   = true,
  features      .value_required:n   = true,
  force         .default:n          = true,
  hyphenchar    .default:n          = true,
  scale         .value_required:n   = true,
  scoped        .value_required:n   = true,
  unknown       .value_forbidden:n  = true,
  name          .usage:n            = general,
  command       .usage:n            = general,
  fea           .usage:n            = general,
  scoped        .usage:n            = general,
  features      .usage:n            = general,
  force         .usage:n            = general,
  scale         .usage:n            = general,
  unknown       .usage:n            = general,
  command       .groups:n           = config,
  fakebold      .groups:n           = config,
  fakeoblique   .groups:n           = config,
  fea           .groups:n           = config,
  features      .groups:n           = lateconfig,
  force         .groups:n           = config,
  hyphenchar    .groups:n           = config,
  scale         .groups:n           = config,
  scoped        .groups:n           = config,
}
\IfPackageLoadedF {unicode-math} {
  \keys_define:nn {lfc/math} {
    name      .code:n = { \use:c {__lfc_set_math:n} {#1} },
    force     .code:n = { \keys_set:nn {lfc/fam} {force    = {#1}} },
    scale     .code:n = { \keys_set:nn {lfc/fam} {scale    = {#1}} },
    unknown   .code:n = {
      \exp_args:NnV \use:c {__lfc_set_math:n} \l_keys_key_str
    },
    name      .value_required:n   = true,
    force     .default:n          = true,
    scale     .value_required:n   = true,
    unknown   .value_forbidden:n  = true,
    name      .usage:n            = preamble,
    force     .usage:n            = preamble,
    scale     .usage:n            = preamble,
    unknown   .usage:n            = preamble,
    force     .groups:n           = config,
    scale     .groups:n           = config,
  }
}
\keys_define:nn {lfc/features} {
  alternates  .code:n = {
    \exp_args:NV \__lfc_set_fam_features:nnn \l__lfc_scope_str {alternates} {#1}
  },
  embolden    .code:n = {
    \seq_put_right:Nn \l__lfc_features_seq {embolden=#1}
  },
  figures     .code:n = {
    \exp_args:NV \__lfc_set_fam_features:nnn \l__lfc_scope_str {figures} {#1}
  },
  forms         .code:n = {
    \exp_args:NV \__lfc_set_fam_features:nnn \l__lfc_scope_str {forms} {#1}
  },
  language      .code:n = {
    \seq_put_right:Nn \l__lfc_features_seq {language=#1}
  },
  ligatures     .code:n = {
    \exp_args:NV \__lfc_set_fam_features:nnn \l__lfc_scope_str {ligatures} {#1}
  },
  mode          .choices:nn = {base,node,harf}{
    \seq_put_right:Ne \l__lfc_features_seq {mode=\l_keys_choice_str}
  },
  scope           .code:n = {
    \seq_set_split:Nnn \l__lfc_scope_seq {,} {,,,}
    \keys_set:nn {lfc/features/scoped} {#1}
    \seq_map_indexed_inline:Nn \l__lfc_scope_seq {
      \int_case:nn {##1} {
        {1} { \str_set:Nn \l__lfc_tmpa_str {##2} }
        {2} {
          \bool_case:nF {
            { %% weight empty, width empty --> use *
              \bool_lazy_and_p:nn { \str_if_empty_p:n {##2} } {
                \str_if_empty_p:N \l__lfc_tmpa_str }
            } { \str_set:Nn \l__lfc_scope_str {*} }
            { %% weight m, width non-empty --> use width
              \bool_lazy_and_p:nn { \str_if_eq_p:Vn \l__lfc_tmpa_str {m} } {
                ! \str_if_empty_p:n {##2} }
            } { \str_set:Nn \l__lfc_scope_str {##2} }
            { %% weight non-empty, width m --> use weight
              \bool_lazy_and_p:nn { ! \str_if_empty_p:N \l__lfc_scope_str } {
                \str_if_eq_p:nn {##2} {m} }
            } { \str_set_eq:NN \l__lfc_scope_str \l__lfc_tmpa_str }
          } { %% o/w --> use concat
            \str_set:Ne \l__lfc_scope_str {\l__lfc_tmpa_str ##2}
          }
          \str_put_right:NV \l__lfc_scope_str \c_colon_str
        }
        {3} { \str_set:Nn \l__lfc_tmpa_str {##2} }
        {4} {
          \bool_case:nF {
            { %% shape empty, case empty --> use *
              \bool_lazy_and_p:nn { \str_if_empty_p:n {##2} } {
                \str_if_empty_p:N \l__lfc_tmpa_str
              }
            } { \str_put_right:Nn \l__lfc_scope_str {*} }
            { %% shape n, case non-empty --> use case
              \bool_lazy_and_p:nn { \str_if_eq_p:Vn \l__lfc_tmpa_str {n} } {
                ! \str_if_empty_p:n {##2} }
            } { \str_put_right:Nn \l__lfc_scope_str {##2} }
            { %% shape non-empty, case n --> use shape
              \bool_lazy_and_p:nn { ! \str_if_empty_p:N \l__lfc_tmpa_str } {
                \str_if_eq_p:nn {##2} {n} }
            } { \str_put_right:NV \l__lfc_scope_str \l__lfc_tmpa_str }
          } { %% o/w --> concat
            \str_put_right:Ne \l__lfc_scope_str {\l__lfc_tmpa_str ##2}
          }
        }
      }
    }
  },
  scoped / weight .choices:nn = {bold, book, demibold, extralight, extrabold,
    light, medium, regular, semibold, semilight, ultralight, ultrabold} {
    \exp_args:NNne \seq_set_item:Nnn \l__lfc_scope_seq {1} {
      \__lfc_parse_spec:nV {weight} \l_keys_choice_str
    }
  },
  scoped / width  .choices:nn = {condensed, expanded, extracondensed,
    extraexpanded, medium, semicondensed, semiexpanded, ultracondensed,
    ultraexpanded} {
    \exp_args:NNne \seq_set_item:Nnn \l__lfc_scope_seq {2} {
      \__lfc_parse_spec:nV {width} \l_keys_choice_str
    }
  },
  scoped / case   .choices:nn = {mixed, smallcaps} {
    \exp_args:NNne \seq_set_item:Nnn \l__lfc_scope_seq {3} {
      \__lfc_parse_spec:nV {case} \l_keys_choice_str
    }
  },
  scoped / style  .choices:nn = {italic, oblique, upright} {
    \exp_args:NNne \seq_set_item:Nnn \l__lfc_scope_seq {4} {
      \__lfc_parse_spec:nV {shape} \l_keys_choice_str
    }
  },
  script        .code:n = {
    \seq_put_right:Nn \l__lfc_features_seq {script=#1}
  },
  spacing       .code:n = {
    \exp_args:NV \__lfc_set_fam_features:nnn \l__lfc_scope_str {spacings} {#1}
  },
  alternates  .value_required:n = true,
  embolden    .value_required:n = true,
  figures     .value_required:n = true,
  forms       .value_required:n = true,
  language    .value_required:n = true,
  ligatures   .value_required:n = true,
  mode        .value_required:n = true,
  scope       .value_required:n = true,
  script      .value_required:n = true,
  spacing     .value_required:n = true,
  scope       .groups:n         = scope,
}

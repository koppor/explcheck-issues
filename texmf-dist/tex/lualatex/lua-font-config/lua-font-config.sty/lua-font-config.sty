\ExplSyntaxOn
\prop_gput:NnV \g_msg_module_name_prop {lfc} \lfc@base
\msg_new:nnnn {lfc} {needs-luatex} {
  \msg_critical_text:n {lfc} :: ~requires~LuaLaTeX~\msg_line_context:
} { \msg_see_documentation_text:n {lfc} }
\sys_if_engine_luatex:F { \msg_critical:nn {lfc} {needs-luatex} }
\msg_new:nnnn {lfc} {math-needs-lum} {
  \msg_error_text:n {lfc} :: ~math~config~requires~lua-unicode-math,~but~
  you've~loaded~unicode-math.~This~cannot~work~\msg_line_context:
} { To~configure~Unicode~maths~fonts~with~this~package,~we~need~to~load~
  lua-unicode-math,~but~unicode-math,~which~is~incompatible~has~already~
  been~loaded,~so~I'm~going~to~ignore~this~part~of~your~settings.~
  \msg_see_documentation_text:n {lfc}
}
\msg_new:nnnn {lfc} {loading} {
  \msg_info_text:n {lfc} :: ~loading~#1~for~maths~support~
  \msg_line_context:
} { \msg_see_documentation_text:n {lfc} }
\tl_new:N \l__lfc_tmpa_tl
\bool_new:N \l__lfc_tmpa_bool
\clist_map_inline:nn {rm, sf, tt} {
  \keys_define:nn {lfc} {
    #1 .code:n            = {
      \tl_clear:N \l__lfc_tmpa_tl
      \keys_set_exclude_groups:nnnN {lfc/#1} {config} {##1} \l__lfc_tmpa_tl
      \keys_set:nV {lfc/#1} \l__lfc_tmpa_tl
      \bool_set_true:N \l__lfc_tmpa_bool
    },
    #1 .value_required:n  = true,
    #1 .usage:n           = preamble,
  }
  \keys_define:nn {lfc/#1} {
    name      .code:n = { \use:c {__lfc_set_#1:n} {##1} },
    fea       .code:n = { \keys_set:nn {lfc/fam} {fea      = {##1}} },
    force     .code:n = { \keys_set:nn {lfc/fam} {force    = {##1}} },
    scale     .code:n = { \keys_set:nn {lfc/fam} {scale    = {##1}} },
    maths     .code:n = { \__lfc_set_fam_cfg:nn   {maths}{##1} },
    math      .meta:n = { maths = {##1} },
    nomaths   .meta:n = { maths = false },
    nomath    .meta:n = { nomaths },
    unknown   .code:n = {
      \exp_args:NnV \use:c {__lfc_set_#1:n} \l_keys_key_str
    },
    name      .value_required:n   = true,
    math      .default:n          = true,
    maths     .default:n          = true,
    nomath    .value_forbidden:n  = true,
    nomaths   .value_forbidden:n  = true,
    unknown   .value_forbidden:n  = true,
    fea       .groups:n           = config,
    force     .groups:n           = config,
    maths     .groups:n           = config,
    math      .groups:n           = config,
    nomath    .groups:n           = config,
    nomaths   .groups:n           = config,
    scale     .groups:n           = config,
  }
}
\keys_define:nn {lfc} {
  debug   .code:n           = {
    \tl_clear:N \l__lfc_tmpa_tl
    \keys_set_groups:nnnN
      {lfc/debug} {toggle} {state = true, #1} \l__lfc_tmpa_tl
    \keys_set:nV {lfc/debug} \l__lfc_tmpa_tl
  },
  debug   .usage:n          = general,
  family  .code:n           = {
    \tl_clear:N \l__lfc_tmpa_tl
    \keys_set_exclude_groups:nnnN {lfc/fam} {config} {#1} \l__lfc_tmpa_tl
    \keys_set:nV {lfc/fam} \l__lfc_tmpa_tl
    \bool_set_true:N \l__lfc_tmpa_bool
  },
  family  .value_required:n = true,
  family  .usage:n          = general,
  math    .code:n           = {
    \IfPackageLoadedTF {unicode-math} {
      \msg_error:nn {lfc} {math-needs-lum}
    } {
      \msg_info:nnn {lfc} {loading} {lua-unicode-math}
      \RequirePackage{lua-unicode-math}
      \tl_clear:N \l__lfc_tmpa_tl
      \keys_set_exclude_groups:nnnN {lfc/math} {config} {#1} \l__lfc_tmpa_tl
      \keys_set:nV {lfc/math} \l__lfc_tmpa_tl
      \bool_set_true:N \l__lfc_tmpa_bool
    }
  },
  math    .value_required:n = true,
  math    .usage:n          = preamble,
}
\keys_define:nn {lfc/fam} {
  name      .code:n = { \__lfc_set_fam_name:n {#1} },
  command   .code:n = {
    \exp_args:Nne \__lfc_set_fam_cfg:nn {csname}{ \cs_to_str:N #1 }
  },
  fea       .code:n = { \__lfc_set_fam_cfg:nn {fea}{#1} },
  force     .code:n = { \__lfc_set_fam_cfg:nn {force}{#1} },
  scale     .code:n = { \__lfc_set_fam_cfg:nn {scale}{#1} },
  unknown   .code:n = {
    \exp_args:NV \__lfc_set_fam_name:n \l_keys_key_str
  },
  name      .value_required:n   = true,
  fea       .value_required:n   = true,
  force     .default:n          = true,
  scale     .value_required:n   = true,
  unknown   .value_forbidden:n  = true,
  name      .usage:n            = general,
  fea       .usage:n            = general,
  force     .usage:n            = general,
  scale     .usage:n            = general,
  unknown   .usage:n            = general,
  fea       .groups:n           = config,
  force     .groups:n           = config,
  scale     .groups:n           = config,
}
\IfPackageLoadedF {unicode-math} {
  \keys_define:nn {lfc/math} {
    name      .code:n = { \use:c {__lfc_set_math:n} {#1} },
    force     .code:n = { \keys_set:nn {lfc/fam} {force    = {#1}} },
    scale     .code:n = { \keys_set:nn {lfc/fam} {scale    = {#1}} },
    unknown   .code:n = {
      \exp_args:NnV \use:c {__lfc_set_math:n} \l_keys_key_str
    },
    name      .value_required:n   = true,
    force     .default:n          = true,
    scale     .value_required:n   = true,
    unknown   .value_forbidden:n  = true,
    name      .usage:n            = preamble,
    force     .usage:n            = preamble,
    scale     .usage:n            = preamble,
    unknown   .usage:n            = preamble,
    force     .groups:n           = config,
    scale     .groups:n           = config,
  }
}
\keys_define:nn {lfc/debug} {
  categories  .code:n             = { \__lfc_debug_set_cats_scanner:n {#1} },
  state       .choice:,
  state/false .code:n             = { \__lfc_debug_set_false: },
  state/true  .code:n             = { \__lfc_debug_set_true: },
  categories  .usage:n            = general,
  state       .usage:n            = general,
  categories  .value_required:n   = true,
  state       .default:n          = true,
  state       .groups:n           = toggle,
}
\NewDocumentCommand\fontconfig { +m }{
  \bool_set_false:N \l__lfc_tmpa_bool
  \keys_set:nn {lfc} {#1}
  \bool_if:NT \l__lfc_tmpa_bool {
    \__lfc_configure_doc_families:
  }
}
\cs_new_protected_nopar:Npn \__lfc_set_mathrm: {
  \SetMathAlphabet \mathrm {normal} {TU} \rmdefault {\mdseries@rm} \shapedefault
  \SetMathAlphabet \mathit {normal} {TU} \rmdefault {\mdseries@rm} \itdefault
  \SetMathAlphabet \mathbf {normal} {TU} \rmdefault {\bfseries@rm} \shapedefault
  \SetMathAlphabet \mathrm {bold}   {TU} \rmdefault {\bfseries@rm} \shapedefault
  \SetMathAlphabet \mathit {bold}   {TU} \rmdefault {\bfseries@rm} \itdefault
  \SetMathAlphabet \mathbf {bold}   {TU} \rmdefault {\bfseries@rm} \shapedefault
  \SetSymbolFont{operators}{normal} {TU} \rmdefault {\mdseries@rm} \shapedefault
  \SetSymbolFont{operators}{bold}   {TU} \rmdefault {\bfseries@rm} \shapedefault
}
\cs_new_protected_nopar:Npn \__lfc_set_mathsf: {
  \SetMathAlphabet \mathsf {normal} {TU} \sfdefault {\mdseries@sf} \shapedefault
  \SetMathAlphabet \mathsf {bold}   {TU} \sfdefault {\bfseries@sf} \shapedefault
}
\cs_new_protected_nopar:Npn \__lfc_set_mathtt: {
  \SetMathAlphabet \mathtt {normal} {TU} \ttdefault {\mdseries@tt} \shapedefault
  \SetMathAlphabet \mathtt {bold}   {TU} \ttdefault {\bfseries@tt} \shapedefault
}
\cs_new_protected_nopar:Npn \__lfc_declare_lum_symbol_fonts:nn #1#2 {
  \DeclareSymbolFont{lummain}{TU}{#1}{m}{n}
  \SetSymbolFont{lummain}{bold}{TU}{#2}{b}{n}
}
\hook_gput_code:nnn {class/ltx-talk/before} {.} {
  \hook_gput_code:nnn {package/mathtools/after} {.} {
    \RequirePackage{lua-unicode-math}
    \fontconfig{
      rm      = {newcomputermodernsans},
      sf      = {newcomputermodernsans},
      math    = {newcomputermodernsansmath},
    }
    \tagpdfsetup { math / mathml / luamml / load = true }
  }
}
\lua_load_module:n {lua-font-config}

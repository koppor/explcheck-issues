              \dim_gset:Nn \l__LuaCJK_verb_cjk_dim
                { \box_wd:N \l__LuaCJK_verb_box }
            }
        \group_end:
        \dim_set:Nn \l__LuaCJK_verb_gap_dim
          { \l__LuaCJK_verb_space_dim - \l__LuaCJK_verb_cjk_dim }
        \dim_compare:nNnTF { \l__LuaCJK_verb_gap_dim } < { 0pt }
          {
            \msg_warning:nn { LuaCJK } { verb-addon-narrow }
            \LuaCJKsetup { CJKglue = 0pt, CJKecglue = 0pt }
          }
          {
            \LuaCJKsetup
              {
                CJKglue   = \dim_use:N \l__LuaCJK_verb_gap_dim ,
                CJKecglue = \dim_eval:n { \l__LuaCJK_verb_gap_dim / 2 }

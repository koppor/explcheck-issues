\cs_new_protected:Npn \__LuaCJK_verb_addon_compute:
  {
    \dim_set:Nn \l__LuaCJK_verb_space_dim
      { 2 \tex_fontdimen:D 2 \tex_font:D }
    \dim_compare:nNnTF
      { \tex_fontdimen:D 2 \tex_font:D }
      = { \tex_fontcharwd:D \tex_font:D 77 }
      {
        \dim_set_eq:NN \l__LuaCJK_verb_cjk_dim \l__LuaCJK_verb_space_dim
        \group_begin:
          \prop_get:NVNT \g__LuaCJK_family_prop \l__LuaCJK_family_tl \l__LuaCJK_tmpa_tl
            {
              \exp_args:NV \fontfamily \l__LuaCJK_tmpa_tl
              \selectfont

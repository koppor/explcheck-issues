\ProvidesExplPackage
  {luatagging-lua3keyval}
  {2026-09-25}
  {0.1c}
  {l3keyval wrapper for Lua based parsing}

\cs_new:Npn \__luakeyval_parse:n #1 {
  \keyval_parse:NNn \__luakeyval_pair:n \__luakeyval_pair:nn {#1}
  \scan_stop:
}

\cs_new:Npn \__luakeyval_clist_parse:n #1 {
  \clist_map_function:nN {#1} \__luakeyval_item:n
  \scan_stop:
}

\cs_generate_variant:Nn \__luakeyval_clist_parse:n {e}

\lua_load_module:n {luatagging-lua3keyval}

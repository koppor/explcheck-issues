\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{deckblatt}
  [2026-11-23 v1.0 Cover pages for self-archiving from BibTeX data]

\RequirePackage{iftex}
\RequireLuaTeX
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{qrcode}
\RequirePackage{pdfpages}

\directlua{
  deckblatt = require("deckblatt")
  if not (deckblatt.version == "1.0") then
    tex.error("Package deckblatt Error: deckblatt.lua has version "
      .. tostring(deckblatt.version) .. ", but deckblatt.sty expects 1.0")
  end
}


% ---------------------------------------------------------------------
% Helpers
% ---------------------------------------------------------------------
% #1 = kind (color, font, param), #2 = role, #3 = token list for the result.
% A value set by the user wins over the default of the variant.
\cs_new_protected:Npn \__deckblatt_get:nnN #1#2#3
  {
    \prop_get:cnNF { l__deckblatt_ #1 _prop } {#2} #3
      {
        \prop_get:cnNF { c__deckblatt_ \l__deckblatt_variant_tl _ #1 _prop }
          {#2} #3 { \tl_clear:N #3 }
      }
  }

\cs_new_protected:Npn \__deckblatt_font:n #1
  {
    \__deckblatt_get:nnN { font } {#1} \l__deckblatt_font_tl
    \tl_use:N \l__deckblatt_font_tl
  }

% Letter spacing works only with fontspec fonts.
\cs_new_protected:Npn \__deckblatt_letterspace:n #1
  {
    \__deckblatt_get:nnN { param } {#1} \l__deckblatt_param_tl
    \tl_if_blank:VF \l__deckblatt_param_tl
      {
        \cs_if_exist:NT \fontspec_if_fontspec_font:TF
          {
            \fontspec_if_fontspec_font:TF
              {
                \use:e
                  {
                    \exp_not:N \addfontfeature
                      { LetterSpace = \exp_not:V \l__deckblatt_param_tl }
                  }
              }
              { }
          }
      }
  }

\cs_new_protected:Npn \__deckblatt_setup_colors:
  {
    \clist_map_inline:Nn \c__deckblatt_color_roles_clist
      {
        \__deckblatt_get:nnN { color } {##1} \l__deckblatt_tmp_tl
        \tl_if_blank:VF \l__deckblatt_tmp_tl
          {
            \str_if_eq:VnF \l__deckblatt_tmp_tl { none }
              {
                \use:e
                  {
                    \exp_not:N \colorlet { deckblatt-##1 }
                      { \exp_not:V \l__deckblatt_tmp_tl }
                  }
              }
          }
      }
  }

\cs_new_protected:Npn \__deckblatt_set_lang:
  {
    \exp_args:NV \str_case:nnF \l__deckblatt_language_tl
      {
        { german }  { \tl_set:Nn \l__deckblatt_lang_tl { de } }
        { english } { \tl_set:Nn \l__deckblatt_lang_tl { en } }
      }
      {
        \tl_set:Nn \l__deckblatt_lang_tl { en }
        \cs_if_exist:NT \languagename
          {
            \exp_args:Ne \str_if_in:nnT { \languagename } { german }
              { \tl_set:Nn \l__deckblatt_lang_tl { de } }
            \exp_args:Ne \str_if_in:nnT { \languagename } { austrian }
              { \tl_set:Nn \l__deckblatt_lang_tl { de } }
          }
      }
    \lua_now:e { deckblatt.setlang("\l__deckblatt_lang_tl") }
  }

% Text in the current language (expandable once the language is set)
\cs_new:Npn \__deckblatt_text:n #1
  {
    \prop_if_in:NnTF \l__deckblatt_text_prop {#1}
      { \prop_item:Nn \l__deckblatt_text_prop {#1} }
      { \prop_item:cn { c__deckblatt_ \l__deckblatt_lang_tl _text_prop } {#1} }
  }

\cs_new_protected:Npn \__deckblatt_lua:n #1
  {
    \__deckblatt_set_lang:
    \lua_now:e { deckblatt.#1 }
  }

% Load the bibliography files, select the entry and set the PDF metadata
\cs_new_protected:Npn \__deckblatt_ensure:
  {
    \clist_map_inline:Nn \l__deckblatt_bibfiles_clist
      {
        \clist_if_in:NnF \g__deckblatt_loaded_clist {##1}
          {
            \lua_now:e { deckblatt.load("\lua_escape:e{##1}") }
            \clist_gput_right:Nn \g__deckblatt_loaded_clist {##1}
          }
      }
    \lua_now:e
      {
        deckblatt.select("\lua_escape:e{\l__deckblatt_key_tl}",
          "\lua_escape:e{\c_sys_jobname_str}",
          \bool_if:NTF \l__deckblatt_jobname_bool { true } { false })
      }
    \bool_if:nT { \l__deckblatt_meta_bool && ! \g__deckblatt_meta_bool }
      {
        \__deckblatt_if_selected:TF
          {
            \bool_gset_true:N \g__deckblatt_meta_bool
            \__deckblatt_lua:n { metadata() }
            \hypersetup
              { pdfcreator = { LuaLaTeX~with~deckblatt } , pdfdisplaydoctitle }
          }
          { }
      }
  }

\cs_new_protected:Npn \__deckblatt_if_selected:TF  { \lua_now:e { deckblatt.ifselected() } }
\cs_new_protected:Npn \__deckblatt_if_doi:TF       { \__deckblatt_lua:n { ifdoi() } }
\cs_new_protected:Npn \__deckblatt_if_article:TF   { \__deckblatt_lua:n { ifarticle() } }
\cs_new_protected:Npn \__deckblatt_if_subtitle:TF  { \__deckblatt_lua:n { ifsubtitle() } }
\cs_new_protected:Npn \__deckblatt_if_fulldate:TF  { \__deckblatt_lua:n { iffulldate() } }
\cs_new_protected:Npn \__deckblatt_if_publisher:TF { \__deckblatt_lua:n { ifpublisher() } }
\cs_new_protected:Npn \__deckblatt_if_part:TF      { \__deckblatt_lua:n { ifpart() } }


\cs_new_protected:Npn \deckblatt@doifont { \__deckblatt_font:n { doi } }

% ---------------------------------------------------------------------
% Small caps for last names
% ---------------------------------------------------------------------
% \dbsc{Name} uses real small caps if the current font has them (fontspec
% fonts: OpenType feature smcp; other fonts: a declared sc shape). Otherwise
% lowercase letters are replaced by reduced uppercase letters.
\cs_new_protected:Npn \deckblatt@scsmall
  {
    \__deckblatt_font:n { smallcaps }
    \__deckblatt_get:nnN { param } { smallcaps-scale } \l__deckblatt_param_tl
    \fontsize { \fp_eval:n { \l__deckblatt_param_tl * \f@size } } { \f@baselineskip }
    \selectfont
    \__deckblatt_letterspace:n { smallcaps-letterspace }
  }
\cs_new_protected:Npn \__deckblatt_sc_fallback:n #1
  { \lua_now:e { deckblatt.scfallback("\lua_escape:e{\tl_to_str:n {#1}}") } }
% A shape that is only substituted (sub, ssub, subf) does not count.
\cs_new_protected:Npn \__deckblatt_if_nfss_sc:TF #1#2
  {
    \cs_if_exist:cTF { \f@encoding / \f@family / \f@series / sc }
      {
        \exp_args:Ne \str_if_in:nnTF
          { \cs_meaning:c { \f@encoding / \f@family / \f@series / sc } }
          { sub }
          {#2} {#1}
      }
      {#2}
  }
\cs_new_protected:Npn \__deckblatt_if_real_sc:TF #1#2
  {
    \cs_if_exist:NTF \fontspec_if_fontspec_font:TF
      {
        \fontspec_if_fontspec_font:TF
          { \fontspec_if_feature:nTF { smcp } {#1} {#2} }
          { \__deckblatt_if_nfss_sc:TF {#1} {#2} }
      }
      { \__deckblatt_if_nfss_sc:TF {#1} {#2} }
  }
\DeclareRobustCommand \dbsc [1]
  { \__deckblatt_if_real_sc:TF { \textsc {#1} } { \__deckblatt_sc_fallback:n {#1} } }

% ---------------------------------------------------------------------
% BibTeX code
% ---------------------------------------------------------------------
\cs_new_protected:Npn \deckblatt@bibhead #1#2
  {
    \noindent
    { \color { deckblatt-bibtex-type } #1 }
    \{ { \color { deckblatt-bibtex-key } #2 } , \par
  }
\cs_new_protected:Npn \deckblatt@bibfield #1#2#3
  {
    \dim_set:Nn \hangindent
      { \deckblatt@indent + \deckblatt@namewidth + 4 \deckblatt@ch }
    \int_set:Nn \hangafter { 1 }
    \noindent
    \hbox_to_wd:nn { \deckblatt@indent } { }
    \hbox_to_wd:nn { \deckblatt@namewidth }
      { \color { deckblatt-bibtex-field } #1 \hfil }
    \hbox_to_wd:nn { 4 \deckblatt@ch }
      { \skip_horizontal:N \deckblatt@ch = \skip_horizontal:N \deckblatt@ch \{ \hfil }
    { \color { deckblatt-bibtex-value } #2 } \} #3 \par
  }
\cs_new_protected:Npn \deckblatt@bibend { \noindent \} \par }

\NewDocumentCommand \dbbibtex { }
  {
    \par
    \group_begin:
      \__deckblatt_font:n { bibtex }
      \color { deckblatt-bibtex }
      \settowidth \deckblatt@ch { 0 }
      \setlength \deckblatt@indent { 2 \deckblatt@ch }
      \dim_zero:N \parindent
      \skip_zero:N \parskip
      \raggedright
      \int_set:Nn \hyphenpenalty { 10000 }
      \int_set:Nn \exhyphenpenalty { 10000 }
      \__deckblatt_lua:n
        {
          bibtex(\dim_to_decimal_in_sp:n { \linewidth },
                 \dim_to_decimal_in_sp:n { \deckblatt@ch }, "\f@size")
        }
      \par
    \group_end:
  }

% ---------------------------------------------------------------------
% Building blocks of the cover page
% ---------------------------------------------------------------------
\cs_new_protected:Npn \__deckblatt_label:n #1
  {
    \mode_leave_vertical:
    \group_begin:
      \__deckblatt_font:n { label }
      \color { deckblatt-label }
      \__deckblatt_letterspace:n { label-letterspace }
      \MakeUppercase {#1}
    \group_end:
  }

% #1 = font role, #2 = colour (empty: current colour), #3 = content
\cs_new_protected:Npn \__deckblatt_block:nnn #1#2#3
  {
    \group_begin:
      \__deckblatt_font:n {#1}
      \mode_leave_vertical:
      \tl_if_blank:nF {#2} { \color {#2} }
      #3 \par
    \group_end:
  }

\cs_new_protected:Npn \__deckblatt_note:
  {
    \group_begin:
      \__deckblatt_font:n { note }
      \mode_leave_vertical:
      \color { deckblatt-note }
      \__deckblatt_text:n { note } \par
    \group_end:
  }

\cs_new_protected:Npn \__deckblatt_qr:
  { \dbdoiqr [ height = \dim_use:N \l__deckblatt_qr_dim ] }

\cs_new_protected:Npn \__deckblatt_citation:
  {
    \tl_if_blank:VTF \l__deckblatt_citation_text_tl
      { \dbcitation }
      { \tl_use:N \l__deckblatt_citation_text_tl }
  }

% #1 = vertical space between label and text
\cs_new_protected:Npn \__deckblatt_citation_part:n #1
  {
    \__deckblatt_label:n { \__deckblatt_text:n { citation } : } \par
    \skip_vertical:n {#1}
    \mode_leave_vertical: \__deckblatt_citation: \par
  }

% Is a QR code to be printed?
\cs_new_protected:Npn \__deckblatt_set_withqr:
  {
    \bool_set_false:N \l__deckblatt_withqr_bool
    \bool_if:NT \l__deckblatt_qr_bool
      { \__deckblatt_if_doi:TF { \bool_set_true:N \l__deckblatt_withqr_bool } { } }
  }

% Box with the BibTeX code: background and/or rule on the left
\cs_new_protected:Npn \__deckblatt_bibtex_box:
  {
    \use:c { __deckblatt_bibtex_padding_ \l__deckblatt_variant_tl : }
    \dim_set:Nn \l__deckblatt_inner_dim
      { \linewidth - \l__deckblatt_padl_dim - \l__deckblatt_padr_dim }
    \vbox_set:Nn \l__deckblatt_tmp_box
      {
        \dim_set_eq:NN \hsize \l__deckblatt_inner_dim
        \dim_set_eq:NN \linewidth \hsize
        \__deckblatt_label:n { \__deckblatt_text:n { bibtex } : } \par
        \skip_vertical:n { 2.5mm }
        \dbbibtex
      }
    \dim_set:Nn \l__deckblatt_tmp_dim
      {
        \box_ht_plus_dp:N \l__deckblatt_tmp_box
        + \l__deckblatt_padt_dim + \l__deckblatt_padb_dim
      }
    \__deckblatt_get:nnN { color } { bibtex-background } \l__deckblatt_tmp_tl
    \__deckblatt_get:nnN { param } { bibtex-rule-width } \l__deckblatt_param_tl
    \par
    \hbox:n
      {
        \str_if_eq:VnF \l__deckblatt_tmp_tl { none }
          {
            \hbox_overlap_right:n
              {
                \color { deckblatt-bibtex-background }
                \rule { \linewidth } { \l__deckblatt_tmp_dim }
              }
          }
        \dim_compare:nNnT { \l__deckblatt_param_tl } > { 0pt }
          {
            \hbox_overlap_right:n
              {
                \color { deckblatt-bibtex-rule }
                \rule { \l__deckblatt_param_tl } { \l__deckblatt_tmp_dim }
              }
          }
        \skip_horizontal:N \l__deckblatt_padl_dim
        \vbox_to_ht:nn { \l__deckblatt_tmp_dim }
          {
            \skip_vertical:N \l__deckblatt_padt_dim
            \box_use_drop:N \l__deckblatt_tmp_box
            \vss
          }
      }
  }
\cs_new_protected:Npn \__deckblatt_bibtex_padding_banner:
  {
    \dim_set:Nn \l__deckblatt_padl_dim { 5mm }
    \dim_set:Nn \l__deckblatt_padr_dim { 0mm }
    \dim_set:Nn \l__deckblatt_padt_dim { 1mm }
    \dim_set:Nn \l__deckblatt_padb_dim { 1mm }
  }
\cs_new_protected:Npn \__deckblatt_bibtex_padding_sidebar:
  {
    \dim_set:Nn \l__deckblatt_padl_dim { 5mm }
    \dim_set:Nn \l__deckblatt_padr_dim { 5mm }
    \dim_set:Nn \l__deckblatt_padt_dim { 4mm }
    \dim_set:Nn \l__deckblatt_padb_dim { 4mm }
  }

% ---------------------------------------------------------------------
% Variant "banner": band over the full width at the top of the page
% ---------------------------------------------------------------------
\cs_new_protected:Npn \__deckblatt_geometry_banner:
  {
    \dim_set:Nn \l__deckblatt_x_dim { 25mm }
    \dim_set:Nn \l__deckblatt_y_dim { 0mm }
    \dim_set:Nn \l__deckblatt_w_dim { \paperwidth - 50mm }
    \dim_set:Nn \l__deckblatt_h_dim { \paperheight - 20mm }
  }
\cs_new_protected:Npn \__deckblatt_background_banner: { }

\cs_new_protected:Npn \__deckblatt_band:
  {
    \vbox_set:Nn \l__deckblatt_tmp_box
      {
        \dim_set_eq:NN \hsize \l__deckblatt_w_dim
        \dim_set_eq:NN \linewidth \hsize
        \__deckblatt_block:nnn { author } { deckblatt-author } { \dbauthorssc }
        \skip_vertical:n { 5mm }
        \__deckblatt_block:nnn { title } { deckblatt-title } { \dbtitle }
        \__deckblatt_if_subtitle:TF
          {
            \skip_vertical:n { 3.5mm }
            \__deckblatt_block:nnn { subtitle } { deckblatt-subtitle } { \dbsubtitle }
          }
          { }
      }
    \dim_set:Nn \l__deckblatt_tmp_dim
      {
        \dim_max:nn { 112mm }
          { \dim_min:nn { 170mm } { \box_ht_plus_dp:N \l__deckblatt_tmp_box + 32mm } }
      }
    \hbox:n
      {
        \skip_horizontal:n { - \l__deckblatt_x_dim }
        \hbox_overlap_right:n
          {
            \color { deckblatt-main }
            \rule { \paperwidth } { \l__deckblatt_tmp_dim }
          }
        \skip_horizontal:N \l__deckblatt_x_dim
        \vbox_to_ht:nn { \l__deckblatt_tmp_dim }
          {
            \vss
            \box_use_drop:N \l__deckblatt_tmp_box
            \skip_vertical:n { 14mm }
          }
      }
  }

\cs_new_protected:Npn \__deckblatt_layout_banner:
  {
    \__deckblatt_band:
    \skip_vertical:n { 11mm }
    \skip_vertical:n { 0pt plus 1fill }
    \__deckblatt_if_part:TF
      { \__deckblatt_label:n { \__deckblatt_text:n { published-in } : } }
      { \__deckblatt_label:n { \__deckblatt_text:n { published } : } }
    \par
    \skip_vertical:n { 1.5mm }
    \__deckblatt_block:nnn { source } { } { \dbsource }
    \skip_vertical:n { 9mm }
    \__deckblatt_set_withqr:
    \bool_if:NTF \l__deckblatt_withqr_bool
      {
        \noindent
        \bool_if:NT \l__deckblatt_citation_bool
          {
            \begin{minipage}[t]
              { \dim_eval:n { \linewidth - \l__deckblatt_qr_dim - 10mm } }
              \vspace{0pt}
              \raggedright
              \__deckblatt_citation_part:n { 1.5mm }
            \end{minipage}
          }
        \hfill
        \begin{minipage}[t]{ \l__deckblatt_qr_dim }
          \vspace{0pt} \hfill \__deckblatt_qr:
        \end{minipage}
        \par
      }
      {
        \bool_if:NT \l__deckblatt_citation_bool
          { \__deckblatt_citation_part:n { 1.5mm } }
      }
    \skip_vertical:n { 0pt plus 1.6fill }
    \bool_if:NT \l__deckblatt_bibtex_bool { \__deckblatt_bibtex_box: }
    \bool_if:NT \l__deckblatt_note_bool
      {
        \skip_vertical:n { 4mm }
        \__deckblatt_note:
      }
  }

% ---------------------------------------------------------------------
% Variant "sidebar": coloured stripe at the left or right edge
% ---------------------------------------------------------------------
\cs_new_protected:Npn \__deckblatt_geometry_sidebar:
  {
    \str_if_eq:VnTF \l__deckblatt_side_tl { left }
      {
        \dim_set:Nn \l__deckblatt_x_dim { 33mm }
        \dim_zero:N \l__deckblatt_stripe_x_dim
      }
      {
        \dim_set:Nn \l__deckblatt_x_dim { 22mm }
        \dim_set:Nn \l__deckblatt_stripe_x_dim { \paperwidth - 15mm }
      }
    \dim_set:Nn \l__deckblatt_y_dim { 25mm }
    \dim_set:Nn \l__deckblatt_w_dim { \paperwidth - 55mm }
    \dim_set:Nn \l__deckblatt_h_dim { \paperheight - 45mm }
  }

\cs_new_protected:Npn \__deckblatt_background_sidebar:
  {
    \hbox_overlap_right:n
      {
        \skip_horizontal:N \l__deckblatt_stripe_x_dim
        \box_move_down:nn { \paperheight }
          {
            \hbox:n
              {
                \color { deckblatt-main }
                \rule { 15mm } { \paperheight }
              }
          }
      }
    \hbox_set:Nn \l__deckblatt_tmp_box
      {
        \rotatebox { 90 }
          {
            \__deckblatt_font:n { sidebar }
            \color { deckblatt-main-text }
            \__deckblatt_letterspace:n { sidebar-letterspace }
            \MakeUppercase { \__deckblatt_text:n { sidebar } }
          }
      }
    \hbox_overlap_right:n
      {
        \skip_horizontal:n
          { \l__deckblatt_stripe_x_dim + ( 15mm - \box_wd:N \l__deckblatt_tmp_box ) / 2 }
        \box_move_down:nn { \paperheight - 22mm }
          { \box_use_drop:N \l__deckblatt_tmp_box }
      }
  }

% #1 = text role of the label, #2 = content
\cs_new_protected:Npn \__deckblatt_row:nn #1#2
  {
    \par
    \noindent
    \dim_set:Nn \hangindent { 30mm }
    \int_set:Nn \hangafter { 1 }
    \makebox [ 30mm ] [ l ] { \__deckblatt_label:n { \__deckblatt_text:n {#1} : } }
    #2 \par
    \skip_vertical:n { 1.6mm }
  }

\cs_new_protected:Npn \__deckblatt_sidebar_data:
  {
    \__deckblatt_set_withqr:
    \noindent
    \begin{minipage}[t]
      {
        \bool_if:NTF \l__deckblatt_withqr_bool
          { \dim_eval:n { \linewidth - \l__deckblatt_qr_dim - 8mm } }
          { \linewidth }
      }
      \vspace{0pt}
      \raggedright
      \__deckblatt_if_article:TF
        {
          \__deckblatt_row:nn { published-in } { \dbjournal }
          \dbiffield { volume } { \__deckblatt_row:nn { volume } { \dbfield { volume } } } { }
          \dbiffield { number }
            { \__deckblatt_row:nn { issue } { \dbfield { number } } }
            {
              \dbiffield { issue }
                { \__deckblatt_row:nn { issue } { \dbfield { issue } } } { }
            }
        }
        {
          \dbiffield { booktitle }
            { \__deckblatt_row:nn { published-in } { \dbcollection } } { }
          \__deckblatt_if_publisher:TF
            { \__deckblatt_row:nn { publisher } { \dbpublisher } } { }
        }
      \__deckblatt_if_fulldate:TF
        { \__deckblatt_row:nn { date } { \dbdate } }
        { \__deckblatt_row:nn { year } { \dbdate } }
      \dbiffield { pages } { \__deckblatt_row:nn { pages } { \dbfield { pages } } } { }
      \dbiffield { isbn } { \__deckblatt_row:nn { isbn } { \dbfield { isbn } } } { }
      \__deckblatt_if_doi:TF { \__deckblatt_row:nn { doi } { \dbdoi } } { }
    \end{minipage}
    \bool_if:NT \l__deckblatt_withqr_bool
      {
        \hfill
        \begin{minipage}[t]{ \l__deckblatt_qr_dim }
          \vspace{0pt} \hfill \__deckblatt_qr:
        \end{minipage}
      }
    \par
  }

\cs_new_protected:Npn \__deckblatt_layout_sidebar:
  {
    \__deckblatt_block:nnn { author } { deckblatt-author } { \dbauthorssc }
    \skip_vertical:n { 7mm }
    \__deckblatt_block:nnn { title } { deckblatt-title } { \dbtitle }
    \__deckblatt_if_subtitle:TF
      {
        \skip_vertical:n { 4mm }
        \__deckblatt_block:nnn { subtitle } { deckblatt-subtitle } { \dbsubtitle }
      }
      { }
    \skip_vertical:n { 15mm }
    \__deckblatt_sidebar_data:
    \skip_vertical:n { 0pt plus 1fill }
    \bool_if:NT \l__deckblatt_citation_bool
      {
        \__deckblatt_citation_part:n { 2mm }
        \bool_if:NT \l__deckblatt_bibtex_bool { \skip_vertical:n { 9mm } }
      }
    \bool_if:NT \l__deckblatt_bibtex_bool { \__deckblatt_bibtex_box: }
    \bool_if:NT \l__deckblatt_note_bool
      {
        \skip_vertical:n { 4mm }
        \__deckblatt_note:
      }
  }

% ---------------------------------------------------------------------
% The cover page
% ---------------------------------------------------------------------
% The page is set in a box of its own size and placed in the background of
% an otherwise empty page. The layout of the document stays untouched.
\cs_new_protected:Npn \__deckblatt_page_setup:
  {
    \dim_set_eq:NN \hsize \l__deckblatt_w_dim
    \@parboxrestore
    \dim_set_eq:NN \textwidth \hsize
    \dim_set_eq:NN \columnwidth \hsize
    \normalfont
    \normalcolor
    \__deckblatt_font:n { text }
    \raggedright
    \cs_if_exist:NT \hypersetup { \hypersetup { hidelinks } }
    \cs_if_exist:NT \urlstyle { \urlstyle { same } }
    \cs_if_exist:NT \UrlBreaks { \tl_put_right:Nn \UrlBreaks { \do \- } }
  }

\cs_new_protected:Npn \__deckblatt_build:
  {
    \use:c { __deckblatt_geometry_ \l__deckblatt_variant_tl : }
    \vbox_set_to_ht:Nnn \l__deckblatt_page_box { \l__deckblatt_h_dim }
      {
        \__deckblatt_page_setup:
        \use:c { __deckblatt_layout_ \l__deckblatt_variant_tl : }
      }
    \hbox_gset:Nn \g__deckblatt_shipout_box
      {
        \use:c { __deckblatt_background_ \l__deckblatt_variant_tl : }
        \hbox_overlap_right:n
          {
            \skip_horizontal:N \l__deckblatt_x_dim
            \box_move_down:nn { \l__deckblatt_y_dim + \l__deckblatt_h_dim }
              { \box_use_drop:N \l__deckblatt_page_box }
          }
      }
  }

\cs_new_protected:Npn \__deckblatt_page:
  {
    \clearpage
    \group_begin:
      \__deckblatt_set_lang:
      \__deckblatt_setup_colors:
      \__deckblatt_build:
    \group_end:
    \thispagestyle { empty }
    \AddToHookNext { shipout / background }
      { \put (0,0) { \box_use_drop:N \g__deckblatt_shipout_box } }
    \null
    \clearpage
  }

\NewDocumentCommand \deckblatt { O{} }
  {
    \keys_set:nn { deckblatt } {#1}
    \__deckblatt_ensure:
    \__deckblatt_if_selected:TF
      { \__deckblatt_page: }
      { \msg_error:nn { deckblatt } { no-entry } }
    \tl_if_blank:VF \l__deckblatt_file_tl
      {
        \use:e
          {
            \exp_not:N \includepdf
              [ \exp_not:V \l__deckblatt_file_options_tl ]
              { \exp_not:V \l__deckblatt_file_tl }
          }
      }
    \tl_clear:N \l__deckblatt_file_tl
  }

% ---------------------------------------------------------------------
% Loading at the end of the preamble
% ---------------------------------------------------------------------
% hyperref and csquotes are loaded only if the document has not done so,
% to avoid option clashes.
\AddToHook { begindocument / before }
  {
    \@ifpackageloaded { csquotes } { } { \RequirePackage [ autostyle ] { csquotes } }
    \@ifpackageloaded { hyperref } { } { \RequirePackage { hyperref } }
  }
\AddToHook { begindocument }
  {
    \bool_gset_true:N \g__deckblatt_document_bool
    \__deckblatt_setup_colors:
    \__deckblatt_ensure:
  }

\ExplSyntaxOff
\endinput

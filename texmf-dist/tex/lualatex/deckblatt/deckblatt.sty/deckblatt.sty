% ---------------------------------------------------------------------
% Keys
% ---------------------------------------------------------------------
\keys_define:nn { deckblatt }
  {
    variant .choices:nn = { banner , sidebar }
      { \tl_set_eq:NN \l__deckblatt_variant_tl \l_keys_choice_tl } ,
    sidebar .choices:nn = { left , right }
      { \tl_set_eq:NN \l__deckblatt_side_tl \l_keys_choice_tl } ,
    sidebar-text .code:n =
      { \prop_put:Nnn \l__deckblatt_text_prop { sidebar } {#1} } ,
    note .bool_set:N = \l__deckblatt_note_bool ,
    note-text .code:n =
      {
        \prop_put:Nnn \l__deckblatt_text_prop { note } {#1}
        \bool_set_true:N \l__deckblatt_note_bool
      } ,
    qrcode .bool_set:N = \l__deckblatt_qr_bool ,
    qrcode-size .dim_set:N = \l__deckblatt_qr_dim ,
    citation .bool_set:N = \l__deckblatt_citation_bool ,
    citation-text .tl_set:N = \l__deckblatt_citation_text_tl ,
    bibtex .bool_set:N = \l__deckblatt_bibtex_bool ,
    pdfmeta .bool_set:N = \l__deckblatt_meta_bool ,
    jobname .bool_set:N = \l__deckblatt_jobname_bool ,
    title-split .code:n =
      {
        \str_if_eq:nnTF {#1} { false }
          { \lua_now:e { deckblatt.setsplit(false) } }
          { \lua_now:e { deckblatt.setsplit(true) } }
      } ,
    title-split .default:n = true ,
    language .choices:nn =
      { auto , german , ngerman , austrian , naustrian , de , english , en }
      {
        \exp_args:NV \str_case:nnF \l_keys_choice_tl
          {
            { auto }    { \tl_set:Nn \l__deckblatt_language_tl { auto } }
            { english } { \tl_set:Nn \l__deckblatt_language_tl { english } }
            { en }      { \tl_set:Nn \l__deckblatt_language_tl { english } }
          }
          { \tl_set:Nn \l__deckblatt_language_tl { german } }
      } ,
    bibfile .clist_set:N = \l__deckblatt_bibfiles_clist ,
    key .tl_set:N = \l__deckblatt_key_tl ,
    file .tl_set:N = \l__deckblatt_file_tl ,
    file-options .tl_set:N = \l__deckblatt_file_options_tl
  }
\clist_map_inline:Nn \c__deckblatt_color_roles_clist
  {
    \keys_define:nn { deckblatt }
      { #1-color .code:n = \prop_put:Nnn \l__deckblatt_color_prop {#1} {##1} }
  }
\clist_map_inline:Nn \c__deckblatt_font_roles_clist
  {
    \keys_define:nn { deckblatt }
      { #1-font .code:n = \prop_put:Nnn \l__deckblatt_font_prop {#1} {##1} }
  }
\clist_map_inline:Nn \c__deckblatt_param_roles_clist
  {
    \keys_define:nn { deckblatt }
      { #1 .code:n = \prop_put:Nnn \l__deckblatt_param_prop {#1} {##1} }
  }
\clist_map_inline:Nn \c__deckblatt_label_roles_clist
  {
    \keys_define:nn { deckblatt }
      { #1-label .code:n = \prop_put:Nnn \l__deckblatt_text_prop {#1} {##1} }
  }

\bool_new:N \g__deckblatt_document_bool
\NewDocumentCommand \deckblattsetup { m }
  {
    \keys_set:nn { deckblatt } {#1}
    \bool_if:NT \g__deckblatt_document_bool { \__deckblatt_ensure: }
  }

\ProcessKeyOptions [ deckblatt ]


    \token_to_str:N \mremoverule\space and~add~the~new~rule. }
\msg_new:nnn { numodel } { var-replaced }
  { Variable~'#2'~of~model~'#1'~is~replaced~in~place. }
\msg_new:nnn { numodel } { unknown-model }
  { \token_to_str:N \copymodel :~there~is~no~model~'#1'. }
\msg_new:nnn { numodel } { copy-no-var }
  { \token_to_str:N \copymodel :~model~'#1'~has~no~variable~'#2'. }


\NewDocumentCommand{\mvar}{ O{} m m m m m m }
  {
    \__numodel_pos_parse:n {#1}
    \tl_if_empty:NTF \l__numodel_eff_prefix_tl
      { \__numodel_mvar_exec:nnnnnnn {#1} {#2} {#3} {#4} {#5} {#6} {#7} }
      {
        \__numodel_log_find:enn { \l__numodel_eff_prefix_tl } { mvar } {#2}
        \int_compare:nNnTF { \l__numodel_log_idx_int } > { 0 }
          {
            % An existing variable: replaced where it stands.
            \msg_info:nnee { numodel } { var-replaced }
              { \l__numodel_eff_prefix_tl } {#2}
            \__numodel_log_set:enn { \l__numodel_eff_prefix_tl }
              { \int_use:N \l__numodel_log_idx_int }
              { {mvar} {#2} {#1} {} {#3} {#4} {#5} {#6} {#7} }
            \__numodel_rebuild:e { \l__numodel_eff_prefix_tl }
          }
          {
            \__numodel_log_append_exec:en { \l__numodel_eff_prefix_tl }
              { {mvar} {#2} {#1} {} {#3} {#4} {#5} {#6} {#7} }
          }
      }
  }

\NewDocumentCommand{\mrule}{ s O{} m m }
  {
    \__numodel_pos_parse:n {#2}
    \tl_set:Ne \l__numodel_item_tl
      {
        { rule } { \exp_not:n {#3} } { \exp_not:n {#2} }
        { \IfBooleanTF {#1} { true } { false } } { \exp_not:n {#4} } {} {} {} {}
      }
    \tl_if_empty:NTF \l__numodel_eff_prefix_tl
      { \__numodel_mrule_exec:nnnn {#1} {#2} {#3} {#4} }
      { \__numodel_place_rule:nn {#3} { replace } }
  }

\cs_new_protected:Npn \__numodel_place_rule:nn #1#2
  {
    \tl_set_eq:NN \l__numodel_copy_src_tl \l__numodel_eff_prefix_tl
    \bool_if:NTF \l__numodel_pos_replace_bool
      {
        \__numodel_log_find:enn { \l__numodel_eff_prefix_tl } { rule } {#1}
        \int_case:nnF { \l__numodel_log_count_int }
          {
            { 0 }
              {
                \msg_error:nneee { numodel } { no-rule }
                  { \l__numodel_eff_prefix_tl } {#1} {#2}
              }
            { 1 }
              {
                \bool_lazy_and:nnTF
                  { \tl_if_empty_p:N \l__numodel_pos_before_tl }
                  { \tl_if_empty_p:N \l__numodel_pos_after_tl }
                  {
                    \__numodel_log_set:eeV { \l__numodel_eff_prefix_tl }
                      { \int_use:N \l__numodel_log_idx_int }
                      \l__numodel_item_tl
                  }
                  {
                    \__numodel_log_remove:enn { \l__numodel_eff_prefix_tl }
                      { rule } {#1}
                    \__numodel_insert_at_position:
                  }
                \__numodel_rebuild:e { \l__numodel_eff_prefix_tl }
              }
          }
          {
            \msg_error:nnee { numodel } { several-rules }
              { \l__numodel_eff_prefix_tl } {#1}
          }
      }
      {
        \bool_lazy_and:nnTF
          { \tl_if_empty_p:N \l__numodel_pos_before_tl }
          { \tl_if_empty_p:N \l__numodel_pos_after_tl }
          {
            % Default: before the stop condition, else at the end.
            \__numodel_log_find:enn { \l__numodel_eff_prefix_tl } { stop } { }
            \int_compare:nNnTF { \l__numodel_log_idx_int } > { 0 }
              {
                \__numodel_log_insert:eeV { \l__numodel_eff_prefix_tl }
                  { \int_use:N \l__numodel_log_idx_int } \l__numodel_item_tl
                \__numodel_rebuild:e { \l__numodel_eff_prefix_tl }
              }
              {

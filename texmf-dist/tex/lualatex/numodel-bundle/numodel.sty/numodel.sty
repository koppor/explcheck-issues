\newcommand{\NumodelNumRounded}[2]{% #1 = value, #2 = sigfigs
  \num[evaluate-expression=true,
       round-mode=figures, round-precision=#2,
       exponent-mode=threshold, exponent-thresholds=-3:#2]
      {#1}\relax
}
\newcommand{\NumodelQtyRounded}[3]{% #1 = value, #2 = sigfigs, #3 = unit
  \qty[evaluate-expression=true,
       round-mode=figures, round-precision=#2,
       exponent-mode=threshold, exponent-thresholds=-3:#2]
      {#1}{#3}\relax
}
\newcommand{\NumodelNumInput}[1]{% #1 = number as typed
  \num[round-mode=none, exponent-mode=input]{#1}\relax
}
\newcommand{\NumodelQtyInput}[2]{% #1 = number as typed, #2 = unit
  \qty[round-mode=none, exponent-mode=input]{#1}{#2}\relax
}
\newcommand{\NumodelDefNumCs}[5]{%
  \expandafter\gdef\csname #1num\endcsname{%
    \NumodelStartNum{#2}{#3}{#4}{#5}%
  }%
}
\newcommand{\NumodelDefQtyCs}[6]{%
  \expandafter\gdef\csname #1qty\endcsname{%
    \NumodelStartQty{#2}{#3}{#4}{#5}{#6}%
  }%
}
\newcommand{\NumodelDefPreCs}[4]{% same parameters as above
  \expandafter\gdef\csname #1pre\endcsname{%
    \qty[evaluate-expression=true,
         round-mode=figures, round-precision=#3,
         prefix-mode=combine-exponent,
         exponent-mode=engineering,
         exponent-thresholds=-0:0]
        {#2}{#4}\relax
  }%
}


\cs_new_protected:Npn \__numodel_tab_build:
  {
    \tl_set:Ne \l__numodel_tab_body_tl
      {
        \exp_not:N \begin{tblr}
          {
            colspec = { * { \clist_count:N \l__numodel_tab_vars_clist } { c } } ,
            hlines , vlines , row{1} = { font = \exp_not:N \bfseries } ,
            \tl_if_empty:NF \g__numodel_tablestyle_tl
              { \exp_not:V \g__numodel_tablestyle_tl , }
            \exp_not:V \l__numodel_tab_table_tl

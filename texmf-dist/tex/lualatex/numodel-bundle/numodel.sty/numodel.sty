  { \tl_set:Nn \l__numodel_item_tl { {#1} {#2} { #3 , blank } {#4} {#5} {#6} {#7} {#8} {#9} } }

\cs_new:Npn \__numodel_log:n #1 { g__numodel_ #1 _log_seq }

\cs_new_protected:Npn \__numodel_log_find:nnn #1#2#3
  {
    \int_zero:N \l__numodel_log_idx_int
    \int_zero:N \l__numodel_log_count_int
    \seq_map_indexed_inline:cn { \__numodel_log:n {#1} }
      {
        \bool_lazy_and:nnT
          { \str_if_eq_p:ee { \__numodel_item_kind:nnnnnnnnn ##2 } {#2} }
          {
            \bool_lazy_or_p:nn
              { \tl_if_empty_p:n {#3} }
              { \str_if_eq_p:ee { \__numodel_item_name:nnnnnnnnn ##2 } {#3} }
          }
          {
            \int_incr:N \l__numodel_log_count_int
            \int_compare:nNnT { \l__numodel_log_idx_int } = { 0 }
              { \int_set:Nn \l__numodel_log_idx_int {##1} }
          }
      }
  }
\cs_new_protected:Npn \__numodel_log_insert:nnn #1#2#3
  {
    \seq_clear:N \l__numodel_log_tmp_seq
    \seq_map_indexed_inline:cn { \__numodel_log:n {#1} }
      {
        \int_compare:nNnT {##1} = {#2}
          { \seq_put_right:Nn \l__numodel_log_tmp_seq {#3} }
        \seq_put_right:Nn \l__numodel_log_tmp_seq {##2}
      }
    \int_compare:nNnT {#2} > { \seq_count:c { \__numodel_log:n {#1} } }
      { \seq_put_right:Nn \l__numodel_log_tmp_seq {#3} }
    \seq_gset_eq:cN { \__numodel_log:n {#1} } \l__numodel_log_tmp_seq
  }
\cs_new_protected:Npn \__numodel_log_set:nnn #1#2#3
  {
    \seq_clear:N \l__numodel_log_tmp_seq
    \seq_map_indexed_inline:cn { \__numodel_log:n {#1} }
      {
        \int_compare:nNnTF {##1} = {#2}
          { \seq_put_right:Nn \l__numodel_log_tmp_seq {#3} }
          { \seq_put_right:Nn \l__numodel_log_tmp_seq {##2} }
      }
    \seq_gset_eq:cN { \__numodel_log:n {#1} } \l__numodel_log_tmp_seq
  }
\cs_new_protected:Npn \__numodel_log_remove:nnn #1#2#3
  {
    \seq_clear:N \l__numodel_log_tmp_seq
    \seq_map_inline:cn { \__numodel_log:n {#1} }
      {
        \bool_lazy_and:nnF
          { \str_if_eq_p:ee { \__numodel_item_kind:nnnnnnnnn ##1 } {#2} }
          { \str_if_eq_p:ee { \__numodel_item_name:nnnnnnnnn ##1 } {#3} }
          { \seq_put_right:Nn \l__numodel_log_tmp_seq {##1} }
      }
    \seq_gset_eq:cN { \__numodel_log:n {#1} } \l__numodel_log_tmp_seq
  }

\cs_new_protected:Npn \__numodel_rebuild:n #1
  {
    \tl_set:Nn \l__numodel_copy_src_tl {#1}
    \__numodel_with_prefix:Nn \l__numodel_copy_src_tl
      {
        \__numodel_clear_state:
        \directlua{ numodel.reset_prefix("#1") }
        \bool_gset_true:N \g__numodel_replay_bool
        % Variables first (in their order), then rules, free text and
        % the stop condition (in theirs): a rule's display needs the
        % names of all variables it uses, also of variables added to a
        % copy after the rules they appear in.
        \seq_map_inline:cn { \__numodel_log:n {#1} }
          {
            \str_if_eq:eeT { \__numodel_item_kind:nnnnnnnnn ##1 } { mvar }
              { \__numodel_item_exec:nnnnnnnnn ##1 }
          }
        \seq_map_inline:cn { \__numodel_log:n {#1} }
          {
            \str_if_eq:eeF { \__numodel_item_kind:nnnnnnnnn ##1 } { mvar }
              { \__numodel_item_exec:nnnnnnnnn ##1 }
          }
        \bool_gset_false:N \g__numodel_replay_bool
      }
  }

\cs_new_protected:Npn \__numodel_log_append_exec:nn #1#2
  {
    \seq_gput_right:cn { \__numodel_log:n {#1} } {#2}
    \tl_set:Nn \l__numodel_copy_src_tl {#1}
    \__numodel_with_prefix:Nn \l__numodel_copy_src_tl
      { \__numodel_item_exec:nnnnnnnnn #2 }
  }

\msg_new:nnn { numodel } { no-rule }

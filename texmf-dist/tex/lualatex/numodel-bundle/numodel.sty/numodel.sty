\cs_new:Npn \__numodel_item_kind:nnnnnnnnn #1#2#3#4#5#6#7#8#9 {#1}
\cs_new:Npn \__numodel_item_name:nnnnnnnnn #1#2#3#4#5#6#7#8#9 {#2}
\cs_new_protected:Npn \__numodel_item_exec:nnnnnnnnn #1#2#3#4#5#6#7#8#9
  {
    \str_case:nn {#1}
      {
        { mvar } { \__numodel_mvar_exec:nnnnnnn {#3} {#2} {#5} {#6} {#7} {#8} {#9} }
        { rule }
          {
            \str_if_eq:nnTF {#4} { true }
              { \__numodel_mrule_exec:nnnn \c_true_bool  {#3} {#2} {#5} }
              { \__numodel_mrule_exec:nnnn \c_false_bool {#3} {#2} {#5} }
          }
        { text } { \__numodel_mruletext_exec:nn {#3} {#5} }
        { stop }
          {
            \str_if_eq:nnTF {#4} { true }
              { \__numodel_mstop_exec:nnn \c_true_bool  {#3} {#5} }
              { \__numodel_mstop_exec:nnn \c_false_bool {#3} {#5} }
          }
      }
  }
\cs_new_protected:Npn \__numodel_item_set_value:nnnnnnnnn #1#2#3#4#5#6#7#8#9
  {
    \tl_set:Nn \l__numodel_item_tl { {#1} {#2} {#3} {#4} {#5} }
    \tl_put_right:Ne \l__numodel_item_tl { { \exp_not:V \l__numodel_newval_tl } }
    \tl_put_right:Nn \l__numodel_item_tl { {#7} {#8} {#9} }
  }

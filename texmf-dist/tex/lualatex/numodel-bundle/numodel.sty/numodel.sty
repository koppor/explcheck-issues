\cs_new:Npn \__numodel_series_color:n #1
  {
    \clist_item:Nn \g__numodel_series_colors_clist
      { 1 + \int_mod:nn { #1 - 1 } { 7 } }
  }

\NewDocumentCommand{\diagrammodel}{ O{} m m O{} m }
  {
    \tl_clear:N \l__numodel_cmd_prefix_tl
    \bool_set_false:N \l__numodel_cmd_legend_bool
    \clist_clear:N \l__numodel_cmd_legend_clist
    \tl_clear:N \l__numodel_cmd_style_tl
    \bool_set_true:N \l__numodel_cmd_float_bool
    \tl_clear:N \l__numodel_cmd_caption_tl
    \bool_set_false:N \l__numodel_cmd_nocaption_bool
    \tl_clear:N \l__numodel_cmd_xcmmax_tl
    \tl_clear:N \l__numodel_cmd_ycmmax_tl
    \tl_clear:N \l__numodel_cmd_points_tl
    \bool_set_false:N \l__numodel_cmd_equal_bool
    \tl_clear:N \l__numodel_cmd_axis_tl
    \tl_clear:N \l__numodel_cmd_plot_tl
    \seq_clear:N \l__numodel_cmd_series_seq
    \keys_set:nn { numodel / cmd } {#1}
    \__numodel_resolve_eff_prefix:
    % --- Parse prefix list -----------------------------------------
    % \l__numodel_eff_prefix_tl may now carry a comma-separated list
    % of prefixes (e.g. "ptc,pw") when the user passes prefix={..}.
    % Treat it as a clist; a single prefix is just a one-item clist.
    % After this step \l__numodel_eff_prefix_tl is overwritten with
    % the first prefix, which drives the x-axis attributes and y-axis
    % label texts (the same short names are assumed to share unit and
    % display text across prefixes).
    \clist_set:NV \l__numodel_eff_prefixes_clist
                  \l__numodel_eff_prefix_tl
    \clist_get:NN \l__numodel_eff_prefixes_clist
                  \l__numodel_eff_prefix_tl
    \bool_set_false:N \l__numodel_multipref_bool
    \int_compare:nNnT
        { \clist_count:N \l__numodel_eff_prefixes_clist } > { 1 }
      { \bool_set_true:N \l__numodel_multipref_bool }
    \tl_set:Ne \l__numodel_xname_tl { \l__numodel_eff_prefix_tl #2 }
    % --- Parse comma-separated y-variable list ----------------------
    % Keep only variables whose unitraw matches the first one's; warn
    % about the rest.  The unit check uses the first prefix.
    \clist_clear:N \l__numodel_yshort_clist
    \tl_clear:N    \l__numodel_yunit_first_tl
    \int_zero:N    \l__numodel_yidx_int
    \clist_map_inline:nn {#3}
      {
        \int_incr:N \l__numodel_yidx_int
        \tl_set:Ne \l__numodel_yfull_tl { \l__numodel_eff_prefix_tl ##1 }
        \int_compare:nNnTF { \l__numodel_yidx_int } = { 1 }
          {
            % Copy the unit tokens verbatim (v-type, no full
            % expansion): units may be robust commands with an
            % optional argument (e.g. physunits' \V), which break
            % inside an e-/x-expansion.
            \tl_set:Nv \l__numodel_yunit_first_tl
              { \l__numodel_yfull_tl unitraw }
            \clist_put_right:Nn \l__numodel_yshort_clist {##1}
          }
          {
            \tl_set:Nv \l_tmpa_tl
              { \l__numodel_yfull_tl unitraw }
            \str_if_eq:VVTF \l_tmpa_tl \l__numodel_yunit_first_tl
              { \clist_put_right:Nn \l__numodel_yshort_clist {##1} }
              {
                \msg_warning:nnee { numodel } { unit-mismatch }
                  { \tl_to_str:N \l__numodel_yfull_tl }
                  { \tl_to_str:N \l__numodel_yunit_first_tl }
              }
          }
      }
    % Canonical y-name = first kept variable (legacy single-series
    % accessor used by the caption when only one series is plotted).
    \clist_get:NN \l__numodel_yshort_clist \l_tmpa_tl
    \tl_set:Ne \l__numodel_yname_tl
      { \l__numodel_eff_prefix_tl \l_tmpa_tl }
    % --- Axis ranges -----------------------------------------------
    \def\xmin{\use:c{\l__numodel_xname_tl min}}
    \def\xmax{\use:c{\l__numodel_xname_tl max}}
    \def\xlabelqty{\use:c{\l__numodel_xname_tl text}}
    \def\xlabelunit{\use:c{\l__numodel_xname_tl unitraw}}
    % Reduce y-range over every (prefix, yvar) pair.  Use \edef +
    % \fpeval so the per-variable min/max accessors are expanded to
    % numeric literals before the fp parser sees them.
    \def\ymin{inf}
    \def\ymax{-inf}
    \clist_map_inline:Nn \l__numodel_eff_prefixes_clist
      {
        \clist_map_inline:Nn \l__numodel_yshort_clist
          {
            \tl_set:Ne \l__numodel_yfull_tl { ##1 ####1 }
            \edef\ymin{\fpeval{min(\ymin,\use:c{\l__numodel_yfull_tl min})}}
            \edef\ymax{\fpeval{max(\ymax,\use:c{\l__numodel_yfull_tl max})}}
          }
      }
    % --- y-axis label: comma-joined display texts, common unit -----
    % Texts are taken from the first prefix (yvars under other
    % prefixes are assumed to share their display text).
    \tl_clear:N \l__numodel_yqty_tl
    \int_zero:N \l__numodel_yidx_int
    \clist_map_inline:Nn \l__numodel_yshort_clist
      {
        \int_incr:N \l__numodel_yidx_int
        \int_compare:nNnF { \l__numodel_yidx_int } = { 1 }
          { \tl_put_right:Nn \l__numodel_yqty_tl { ,~ } }
        \tl_put_right:Ne \l__numodel_yqty_tl
          { \use:c { \l__numodel_eff_prefix_tl ##1 text } }
      }
    \edef\ylabelqty{\tl_use:N \l__numodel_yqty_tl}
    \edef\ylabelunit{\exp_not:V \l__numodel_yunit_first_tl}
    \bool_if:NTF \l__numodel_cmd_float_bool
      { \begin{figure}[H] \centering }
      {
        % As capt-of's \captionof: \caption needs only \@captype.
        % Inside a list (exam's questions, enumerate) \hsize stays the
        % text width while \linewidth is narrower; the caption is \hsize
        % wide and would stick out.  The minipage makes \hsize the line
        % width (and keeps diagram and caption together).
        \begin{center}
        \begin{minipage}{\linewidth}
        \centering
        \cs_set:cpn { @captype } { figure }
        % Outside a float hypcap has no anchor to place; switch it off
        % (locally) instead of letting caption warn for every diagram.
        \cs_if_exist:NT \captionsetup { \captionsetup { hypcap = false } }
      }
    \group_begin:
    \__numodel_apply_dsep:
    \tl_if_empty:NF \l__numodel_cmd_xcmmax_tl
      { \cs_set:Npe \xcmmax { \tl_use:N \l__numodel_cmd_xcmmax_tl } }
    \tl_if_empty:NF \l__numodel_cmd_ycmmax_tl
      { \cs_set:Npe \ycmmax { \tl_use:N \l__numodel_cmd_ycmmax_tl } }
    \bool_if:NT \l__numodel_cmd_equal_bool { \use:c { nmp@equaltrue } }
    \tl_if_empty:NF \l__numodel_cmd_axis_tl
      {
        \exp_args:Ne \pgfplotsset
          { numodel/axis/.append~style = { \exp_not:V \l__numodel_cmd_axis_tl } }
      }
    % --- Build the plot body ---------------------------------------
    % One \addplot per (prefix, yvar) pair, prefix-major: all y-vars of
    % the first prefix come before any of the second.  A single series
    % (one prefix, one kept y-variable) is drawn in black and has a
    % legend only on request; several series cycle through the
    % colour-blind safe palette and always have a legend: the display
    % text, with the prefix in parentheses when there are several
    % prefixes, unless legend={...} gives the labels.
    \bool_set:Nn \l__numodel_single_series_bool
      {
        \int_compare_p:nNn
          {
            \clist_count:N \l__numodel_yshort_clist +
            \clist_count:N \l__numodel_eff_prefixes_clist
          } = { 2 }
      }
    \str_case:VnF \l__numodel_cmd_style_tl
      {
        { line }
          { \tl_set:Nn \l__numodel_series_opts_tl { no~markers , thick } }
        { both }
          {
            \tl_set:Nn \l__numodel_series_opts_tl
              { mark=* , mark~size=0.5pt , thick ,
                legend~image~post~style = { mark~size=2pt } }
          }
      }
      {
        \tl_set:Nn \l__numodel_series_opts_tl
          { only~marks , mark=* , mark~size=0.5pt ,
            legend~image~post~style = { mark~size=2pt } }
      }
    \tl_clear:N \l__numodel_plotbody_tl
    \int_zero:N \l__numodel_yidx_int
    \clist_map_inline:Nn \l__numodel_eff_prefixes_clist
      {
        \clist_map_inline:Nn \l__numodel_yshort_clist
          {
            \int_incr:N \l__numodel_yidx_int
            \tl_set:Ne \l__numodel_legend_item_tl
              {
                \clist_item:Nn \l__numodel_cmd_legend_clist
                  { \l__numodel_yidx_int }
              }
            \tl_put_right:Ne \l__numodel_plotbody_tl
              {
                \exp_not:N \addplot
                  [ \exp_not:V \l__numodel_series_opts_tl
                    \bool_if:NF \l__numodel_single_series_bool
                      {
                        , color = \__numodel_series_color:n
                                  { \int_use:N \l__numodel_yidx_int }
                      }
                    , \exp_not:V \l__numodel_cmd_plot_tl
                    , \seq_item:Nn \l__numodel_cmd_series_seq
                        { \l__numodel_yidx_int }
                  ]
                coordinates {
                  \__numodel_plot_coords:nnn { ##1 } { #2 } { ####1 }
                } ;
                \bool_if:nT
                  {
                    ! \l__numodel_single_series_bool
                    || \l__numodel_cmd_legend_bool
                  }
                  {
                    \exp_not:N \addlegendentry
                      {
                        \tl_if_empty:NTF \l__numodel_legend_item_tl
                          {
                            \bool_if:NTF \l__numodel_single_series_bool
                              { \exp_not:N \__numodel_legend_point: }
                              {
                                $ \exp_not:v { ##1 ####1 text } $
                                \bool_if:NT \l__numodel_multipref_bool
                                  { ~ ( ##1 ) }
                              }
                          }
                          { \exp_not:V \l__numodel_legend_item_tl }
                      }
                  }
              }
          }
      }
    \tl_put_right:Nn \l__numodel_plotbody_tl {#4}
    \exp_args:NV \__numodel_draw_plot:n \l__numodel_plotbody_tl
    % Record the axis ranges as drawn (\calcplotdims has rounded
    % \xmin ... \ymax to the tick lattice, still inside this group) for
    % numodel.get_model, so exporters can give a variable the same axis
    % range as its graph in the document.
    \clist_map_inline:Nn \l__numodel_eff_prefixes_clist
      {
        \directlua{ numodel.set_axis("##1", "##1#2", "\xmin", "\xmax") }
        \clist_map_inline:Nn \l__numodel_yshort_clist
          {
            \directlua{ numodel.set_axis("##1", "##1####1",
              "\ymin", "\ymax") }
          }
      }
    \group_end:
    \bool_if:NF \l__numodel_cmd_nocaption_bool
      {
        \tl_if_empty:NTF \l__numodel_cmd_caption_tl
          { \caption{$\tl_use:N \l__numodel_yqty_tl$($\use:c{\l__numodel_xname_tl text}$)\text{-diagram}} }
          { \caption{ \tl_use:N \l__numodel_cmd_caption_tl } }
        % If the project-specific worksheet system is loaded, pick the
        % '-ws' label inside a worksheet; otherwise always the bare label.
        \cs_if_exist:NTF \ifinworksheet
          { \ifinworksheet{\label{fig:#5-ws}}{\label{fig:#5}} }
          { \label{fig:#5} }
      }
    \bool_if:NTF \l__numodel_cmd_float_bool
      { \end{figure} }
      { \end{minipage} \end{center} }
  }


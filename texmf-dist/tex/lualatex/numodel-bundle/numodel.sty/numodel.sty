\cs_new_protected:Npn \__numodel_compute_body:
  {
    \tl_if_empty:NT \g_numodel_stop_expr_tl
      { \msg_error:nn { numodel } { no-stop } }
    \str_case:VnF \l__numodel_eff_engine_tl
      {
        { lua }
          {
            \__numodel_engine_run:n { false }
            \str_if_eq:VnTF \l__numodel_engine_status_tl { ok }
              {
                % The Lua run has stored the series; set the final
                % values and the step count as the fpeval loop does.
                \seq_map_inline:Nn \g_mvar_names_seq
                  {
                    \cs_gset:cpe {##1}
                      {
                        \directlua{ tex.sprint(numodel.tex_number(
                          numodel.engine_result.values["##1"])) }
                      }
                  }
                \int_gset:Nn \g_numodel_steps_int
                  { \directlua{ tex.sprint(numodel.engine_result.steps) } }
                \directlua{ if~numodel.engine_result.hit~then~
                  tex.sprint(string.char(92).."numodelmaxiterwarning")~end }
              }
              {
                \msg_info:nnee { numodel } { engine-fallback }
                  { \g_numodel_current_prefix_tl }
                  { \l__numodel_engine_status_tl }
                \__numodel_compute_fpeval:
              }
          }
        { compare }
          {
            \__numodel_engine_run:n { true }
            \__numodel_compute_fpeval:
            \str_if_eq:VnTF \l__numodel_engine_status_tl { ok }
              {
                \tl_set:Ne \l__numodel_engine_status_tl
                  {
                    \directlua{ tex.sprint(-2, numodel.engine_compare(
                      "\g_numodel_current_prefix_tl")) }
                  }
                \tl_if_empty:NTF \l__numodel_engine_status_tl
                  {
                    \msg_info:nne { numodel } { engine-agrees }
                      { \g_numodel_current_prefix_tl }
                  }
                  {
                    \msg_warning:nnee { numodel } { engine-differs }
                      { \g_numodel_current_prefix_tl }
                      { \l__numodel_engine_status_tl }
                  }
              }
              {
                \msg_warning:nnee { numodel } { engine-fallback }
                  { \g_numodel_current_prefix_tl }
                  { \l__numodel_engine_status_tl }
              }
          }
      }
      { \__numodel_compute_fpeval: }
    \__numodel_set_minmax_from_lua:
    % Public per-prefix step-count accessor: \<prefix>steps holds the
    % number of recorded samples (= iterations of the loop above).
    \cs_gset:cpe { \g_numodel_current_prefix_tl steps }
      { \int_use:N \g_numodel_steps_int }
  }


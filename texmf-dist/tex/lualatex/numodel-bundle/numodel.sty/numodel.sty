      }
    % header
    \int_zero:N \l__numodel_tab_colno_int
    \clist_map_inline:Nn \l__numodel_tab_vars_clist
      {
        \int_incr:N \l__numodel_tab_colno_int
        \int_compare:nNnF { \l__numodel_tab_colno_int } = { 1 }
          { \tl_put_right:Nn \l__numodel_tab_body_tl { & } }
        \tl_put_right:Ne \l__numodel_tab_body_tl
          {
            $ \exp_not:v { \l__numodel_eff_prefix_tl ##1 text } $
            \tl_if_blank:eF { \exp_not:v { \l__numodel_eff_prefix_tl ##1 unitraw } }
              {
                \c_space_tl
                ( \exp_not:N \unit { \exp_not:v { \l__numodel_eff_prefix_tl ##1 unitraw } } )
              }
          }
      }
    \tl_put_right:Nn \l__numodel_tab_body_tl { \\ }
    % rows
    \int_zero:N \l__numodel_tab_rowno_int
    \clist_map_inline:Nn \l__numodel_tab_rows_clist
      {
        \int_incr:N \l__numodel_tab_rowno_int
        \int_zero:N \l__numodel_tab_colno_int
        \clist_map_inline:Nn \l__numodel_tab_vars_clist
          {
            \int_incr:N \l__numodel_tab_colno_int
            \int_compare:nNnF { \l__numodel_tab_colno_int } = { 1 }
              { \tl_put_right:Nn \l__numodel_tab_body_tl { & } }
            % Empty in the pupil's version: blank, not the first column,
            % past the given rows.
            \bool_set:Nn \l__numodel_tab_empty_bool
              {
                \l__numodel_tab_blank_bool
                && \str_if_eq_p:Vn \l__numodel_eff_blanks_tl { open }
                && \int_compare_p:nNn { \l__numodel_tab_colno_int } > { 1 }
                && \int_compare_p:nNn
                     { \l__numodel_tab_rowno_int } > { \l__numodel_tab_given_int }
              }
            \bool_if:NF \l__numodel_tab_empty_bool
              { \__numodel_tab_cell:nn {####1} {##1} }
          }
        \tl_put_right:Nn \l__numodel_tab_body_tl { \\ }
      }
    \tl_put_right:Nn \l__numodel_tab_body_tl { \end{tblr} }
  }

\cs_new_protected:Npn \__numodel_tab_cell:nn #1#2
  {
    \tl_set:Ne \l_tmpa_tl
      {
        \directlua{ numodel.tex_cell("\l__numodel_eff_prefix_tl",
          "\l__numodel_eff_prefix_tl #1", #2,
          "\tl_use:N \l__numodel_tab_row_tl") }
      }
    \tl_if_empty:NF \l_tmpa_tl
      {
        \prop_get:NnNF \l__numodel_tab_num_prop {#1} \l__numodel_tab_opts_tl
          { \tl_clear:N \l__numodel_tab_opts_tl }
        \tl_put_right:Ne \l__numodel_tab_body_tl
          {
            \exp_not:N \num
              [ round-mode = figures ,
                round-precision = \use:c { \l__numodel_eff_prefix_tl #1 sign } ,
                exponent-mode = threshold ,
                exponent-thresholds = -3 \c_colon_str
                  \use:c { \l__numodel_eff_prefix_tl #1 sign } ,
                \exp_not:V \l__numodel_tab_opts_tl ]
              { \exp_not:V \l_tmpa_tl }
          }
      }
  }



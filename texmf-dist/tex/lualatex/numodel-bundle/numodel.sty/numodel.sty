    so~the~remaining~series~share~a~common~y-axis. }


\tl_new:N \l__numodel_display_tl
\tl_new:N \l__numodel_degfac_tl
\tl_new:N \l__numodel_radfac_tl
\tl_new:N \l__numodel_invdegfac_tl
\tl_new:N \l__numodel_invradfac_tl
\tl_new:N \l__numodel_lhs_tl
\tl_new:N \l__numodel_rhs_tl
\tl_new:N \l__numodel_cond_tl
\tl_new:N \l__numodel_true_tl
\tl_new:N \l__numodel_false_tl

\cs_new_protected:Npn \__numodel_vars_to_display:N #1
  {
    \str_if_eq:VnTF \g__numodel_angles_tl { degrees }
      {
        \tl_clear:N \l__numodel_degfac_tl
        \tl_set:Nn \l__numodel_radfac_tl { \sfrac {180} {\pi} \cdot ~ }
        \tl_clear:N \l__numodel_invdegfac_tl
        \tl_set:Nn \l__numodel_invradfac_tl { \sfrac {\pi} {180} \cdot ~ }
      }
      {
        \tl_set:Nn \l__numodel_degfac_tl { \sfrac {\pi} {180} \cdot ~ }
        \tl_clear:N \l__numodel_radfac_tl
        \tl_set:Nn \l__numodel_invdegfac_tl { \sfrac {180} {\pi} \cdot ~ }
        \tl_clear:N \l__numodel_invradfac_tl
      }
    \__numodel_debug:n{VTD~input:~\tl_to_str:N #1}
    \__numodel_debug:n{VTD~seq:~\seq_use:Nn \g_mvar_names_seq {|}}
    % Multi-character numeric superscripts.  \fp_eval:n accepts
    % '^1.2' (and '^12', '^-3', ...), but TeX math mode binds only
    % the next single token to ^, so 'T^1.2' would typeset as
    % 'T^{1}.2' and 'T^12' as 'T^{1}2'.  Wrap any numeric exponent
    % literal in braces so display reads 'T^{1.2}', 'T^{12}', etc.
    % Explicitly braced (^{...}) or parenthesised (^(...)) exponents
    % are left untouched.
    \regex_replace_all:nnN { \^ ( [+\-]? [0-9]+ (?: \. [0-9]+)? ) }
      { \^ \cB\{ \1 \cE\} } #1
    % Decimal numbers in the rule (0.24, 1.5e-3) through siunitx \num, so
    % they take the decimal marker of the syntax (\textmodel sets it via
    % \__numodel_apply_dsep:) and appear as typed: no rounding, no
    % power of ten.  Integers need no marker and stay as they are.  This
    % runs before the variable names are replaced, so digits inside a
    % display name (x_1) are never touched; and after the exponent
    % bracing above, so ^{1.2} becomes ^{\num{1.2}}.
    \regex_replace_all:nnN
      { [0-9]*\.[0-9]+ (?: [eE] [+\-]? [0-9]+ )? | [0-9]+ [eE] [+\-]? [0-9]+ }
      { \c{num} [round-mode=none,exponent-mode=input] \cB\{ \0 \cE\} } #1
    % Variable names -> display names
    \seq_map_inline:Nn \g_mvar_names_seq
      {
        \__numodel_debug:n{VTD~iter:~##1}
        \cs_if_exist:cT { ##1 text }
          {
            \tl_set:Ne \l_tmpa_tl { \use:c { ##1 text } }
            \__numodel_debug:n{VTD~replace~\c{##1}~with~\l_tmpa_tl}
            \regex_replace_all:nnN { \c{##1} } { \u{l_tmpa_tl} } #1
          }
      }
    % Arithmetic operators
    \regex_replace_all:nnN { \* } { \c{cdot} \x{20} } #1
    \regex_replace_all:nnN { >= } { \c{geqslant} \x{20} } #1
    \regex_replace_all:nnN { <= } { \c{leqslant} \x{20} } #1
    % Functions (syllabus notation).  Order matters: asin/acos must
    % match before sin/cos, otherwise the inner sin/cos gets replaced
    % first and the outer arc- prefix is left dangling.
    \regex_replace_all:nnN { sign \( }
      { \c{text}\cB\{ \u{g__numodel_kw_sign_tl}\cE\}( } #1
    \regex_replace_all:nnN { abs \( }
      { \c{text}\cB\{ \u{g__numodel_kw_abs_tl}\cE\}( } #1
    \regex_replace_all:nnN { sqrt \( }
      { \c{text}\cB\{ \u{g__numodel_kw_sqrt_tl}\cE\}( } #1
    \regex_replace_all:nnN { exp \( }
      { \c{text}\cB\{ \u{g__numodel_kw_exp_tl}\cE\}( } #1
    \regex_replace_all:nnN { ln \( }
      { \c{text}\cB\{ \u{g__numodel_kw_ln_tl}\cE\}( } #1
    \regex_replace_all:nnN { asin \( }
      { \u{l__numodel_invradfac_tl}\c{text}\cB\{ \u{g__numodel_kw_asin_tl}\cE\}( } #1
    \regex_replace_all:nnN { acos \( }
      { \u{l__numodel_invradfac_tl}\c{text}\cB\{ \u{g__numodel_kw_acos_tl}\cE\}( } #1
    \regex_replace_all:nnN { atan \( }
      { \u{l__numodel_invradfac_tl}\c{text}\cB\{ \u{g__numodel_kw_atan_tl}\cE\}( } #1
    % Inverse reciprocal trig (degrees): rendered as
    % 180/pi * <radian inverse>(1/arg).  The "1/arg" sits inside the
    % parens so the argument must be captured (no nested parens) -- the
    % closing brace then lands after it.  These must precede the radian
    % inverse-reciprocals (acsc/asec/acot) AND the *d reciprocals
    % (cscd/cotd/secd): "acscd(" contains "cscd(" and the bare acsc
    % regex would mis-bite without the leading "a".
    \regex_replace_all:nnN { acscd \( ([^()]*) \) }
      { \u{l__numodel_invdegfac_tl}
        \c{text}\cB\{ \u{g__numodel_kw_asin_tl}\cE\}(\c{sfrac}\cB\{1\cE\}\cB\{\1\cE\}) } #1
    \regex_replace_all:nnN { asecd \( ([^()]*) \) }
      { \u{l__numodel_invdegfac_tl}
        \c{text}\cB\{ \u{g__numodel_kw_acos_tl}\cE\}(\c{sfrac}\cB\{1\cE\}\cB\{\1\cE\}) } #1
    \regex_replace_all:nnN { acotd \( ([^()]*) \) }
      { \u{l__numodel_invdegfac_tl}
        \c{text}\cB\{ \u{g__numodel_kw_atan_tl}\cE\}(\c{sfrac}\cB\{1\cE\}\cB\{\1\cE\}) } #1
    % Inverse reciprocal trig (radians): <radian inverse>(1/arg),
    % e.g. acsc(x) -> ARCSIN(1/x).  Captured argument (no nested
    % parens).  Must precede the reciprocal cot/csc/sec regexes:
    % "acsc(" contains "csc(".
    \regex_replace_all:nnN { acsc \( ([^()]*) \) }
      { \u{l__numodel_invradfac_tl}\c{text}\cB\{ \u{g__numodel_kw_asin_tl}\cE\}(\c{sfrac}\cB\{1\cE\}\cB\{\1\cE\}) } #1
    \regex_replace_all:nnN { asec \( ([^()]*) \) }
      { \u{l__numodel_invradfac_tl}\c{text}\cB\{ \u{g__numodel_kw_acos_tl}\cE\}(\c{sfrac}\cB\{1\cE\}\cB\{\1\cE\}) } #1
    \regex_replace_all:nnN { acot \( ([^()]*) \) }
      { \u{l__numodel_invradfac_tl}\c{text}\cB\{ \u{g__numodel_kw_atan_tl}\cE\}(\c{sfrac}\cB\{1\cE\}\cB\{\1\cE\}) } #1
    % Inverse trig (degrees): rendered as 180/pi * <radian inverse>.
    % The 180/pi factor is a fixed prefix, so the head-only rewrite
    % stays correct for any argument (the original ")" still closes
    % the function).  Must precede sin/cos/tan: the trailing "d" keeps
    % them from matching the radian regexes, but keep them together for
    % readability.
    \regex_replace_all:nnN { asind \( }
      { \u{l__numodel_invdegfac_tl}
        \c{text}\cB\{ \u{g__numodel_kw_asin_tl}\cE\}( } #1
    \regex_replace_all:nnN { acosd \( }
      { \u{l__numodel_invdegfac_tl}
        \c{text}\cB\{ \u{g__numodel_kw_acos_tl}\cE\}( } #1
    \regex_replace_all:nnN { atand \( }
      { \u{l__numodel_invdegfac_tl}
        \c{text}\cB\{ \u{g__numodel_kw_atan_tl}\cE\}( } #1
    % Forward trig (degrees): SIN(pi/180 * arg).  The pi/180 factor is
    % a fixed prefix placed just after the opening paren, so this is a
    % head-only rewrite (robust for any argument).  The trailing "d"
    % keeps sind/cosd/tand from matching the radian sin/cos/tan below.
    \regex_replace_all:nnN { sind \( }
      { \c{text}\cB\{ \u{g__numodel_kw_sin_tl}\cE\}(\u{l__numodel_degfac_tl} } #1
    \regex_replace_all:nnN { cosd \( }
      { \c{text}\cB\{ \u{g__numodel_kw_cos_tl}\cE\}(\u{l__numodel_degfac_tl} } #1
    \regex_replace_all:nnN { tand \( }
      { \c{text}\cB\{ \u{g__numodel_kw_tan_tl}\cE\}(\u{l__numodel_degfac_tl} } #1
    \regex_replace_all:nnN { sin \( }
      { \c{text}\cB\{ \u{g__numodel_kw_sin_tl}\cE\}(\u{l__numodel_radfac_tl} } #1
    \regex_replace_all:nnN { cos \( }
      { \c{text}\cB\{ \u{g__numodel_kw_cos_tl}\cE\}(\u{l__numodel_radfac_tl} } #1
    \regex_replace_all:nnN { \b tan \( }
      { \c{text}\cB\{ \u{g__numodel_kw_tan_tl}\cE\}(\u{l__numodel_radfac_tl} } #1
    % Reciprocal trig functions: rendered as a slashed fraction
    % \sfrac{1}{<base>(arg)} so the "1/" no longer jams against the
    % preceding term.  The argument is captured (([^()]*)) so the
    % closing brace lands after it; this matches any argument WITHOUT
    % nested parens.  The head-only "1/<base>(" fallbacks below catch
    % the rare nested-argument case so it still translates (just
    % without the \sfrac wrapper).
    \regex_replace_all:nnN { cot \( ([^()]*) \) }
      { \c{sfrac}\cB\{1\cE\}\cB\{\c{text}\cB\{ \u{g__numodel_kw_tan_tl}\cE\}(\u{l__numodel_radfac_tl}\1)\cE\} } #1
    \regex_replace_all:nnN { csc \( ([^()]*) \) }
      { \c{sfrac}\cB\{1\cE\}\cB\{\c{text}\cB\{ \u{g__numodel_kw_sin_tl}\cE\}(\u{l__numodel_radfac_tl}\1)\cE\} } #1
    \regex_replace_all:nnN { sec \( ([^()]*) \) }
      { \c{sfrac}\cB\{1\cE\}\cB\{\c{text}\cB\{ \u{g__numodel_kw_cos_tl}\cE\}(\u{l__numodel_radfac_tl}\1)\cE\} } #1
    \regex_replace_all:nnN { cot \( }
      { 1/\c{text}\cB\{ \u{g__numodel_kw_tan_tl}\cE\}(\u{l__numodel_radfac_tl} } #1
    \regex_replace_all:nnN { csc \( }
      { 1/\c{text}\cB\{ \u{g__numodel_kw_sin_tl}\cE\}(\u{l__numodel_radfac_tl} } #1
    \regex_replace_all:nnN { sec \( }
      { 1/\c{text}\cB\{ \u{g__numodel_kw_cos_tl}\cE\}(\u{l__numodel_radfac_tl} } #1
    % Reciprocal trig (degrees): \sfrac{1}{<base>(pi/180 * arg)}.  Both
    % the reciprocal and the degree conversion are inside the fraction,
    % so the argument is captured (no nested parens); a nested-argument
    % call is left untranslated rather than risk mis-biting the longer
    % acotd/acscd/asecd names (which were already consumed above).
    \regex_replace_all:nnN { cotd \( ([^()]*) \) }
      { \c{sfrac}\cB\{1\cE\}\cB\{\c{text}\cB\{ \u{g__numodel_kw_tan_tl}\cE\}(\u{l__numodel_degfac_tl}\1)\cE\} } #1
    \regex_replace_all:nnN { cscd \( ([^()]*) \) }
      { \c{sfrac}\cB\{1\cE\}\cB\{\c{text}\cB\{ \u{g__numodel_kw_sin_tl}\cE\}(\u{l__numodel_degfac_tl}\1)\cE\} } #1
    \regex_replace_all:nnN { secd \( ([^()]*) \) }
      { \c{sfrac}\cB\{1\cE\}\cB\{\c{text}\cB\{ \u{g__numodel_kw_cos_tl}\cE\}(\u{l__numodel_degfac_tl}\1)\cE\} } #1
    % Floor and ceiling.  ceil(x) is rendered as -INT(-x) (the l3fp
    % identity), reusing the floor keyword; argument captured.
    \regex_replace_all:nnN { floor \( }
      { \c{text}\cB\{ \u{g__numodel_kw_floor_tl}\cE\}( } #1
    \regex_replace_all:nnN { ceil \( ([^()]*) \) }
      { -\c{text}\cB\{ \u{g__numodel_kw_floor_tl}\cE\}(-\1) } #1
    % Two-argument extrema.
    \regex_replace_all:nnN { min \( }
      { \c{text}\cB\{ \u{g__numodel_kw_min_tl}\cE\}( } #1
    \regex_replace_all:nnN { max \( }
      { \c{text}\cB\{ \u{g__numodel_kw_max_tl}\cE\}( } #1
    % Logical operators (syllabus notation)
    \regex_replace_all:nnN { \&\& }
      { \c{text}\cB\{\u{g__numodel_kw_and_tl}\cE\} } #1
    \regex_replace_all:nnN { \|\| }
      { \c{text}\cB\{\u{g__numodel_kw_or_tl}\cE\} } #1
  }

\cs_new_protected:Npn \__numodel_vars_to_display_fpeval:N #1
  {
    % Character escaping first, before any braces are introduced below.
    % (l3fp expressions never contain ~, #, $, so those need no handling;
    % space tokens must be preserved verbatim, so they are left alone.)
    \regex_replace_all:nnN { \^ } { \c{textasciicircum}\cB\{\cE\} } #1
    \regex_replace_all:nnN { & }  { \c{&} } #1
    \regex_replace_all:nnN { _ }  { \c{_} } #1
    % Variable names -> \ensuremath{display name}
    \seq_map_inline:Nn \g_mvar_names_seq
      {
        \cs_if_exist:cT { ##1 text }
          {
            \tl_set:Ne \l_tmpa_tl { \use:c { ##1 text } }
            \regex_replace_all:nnN { \c{##1} }
              { \c{ensuremath}\cB\{ \u{l_tmpa_tl} \cE\} } #1
          }
      }
  }

\cs_new_protected:Npn \__numodel_fpeval_render:nn #1 #2
  { \texttt { \ensuremath {#1} ~=~ #2 } }

\cs_new_protected:Npn \__numodel_fpeval_stoprow:nn #1 #2
  { \texttt { #1 ~ #2 } }

\bool_new:N \l__numodel_is_ternary_bool

\cs_new_protected:Npn \__numodel_parse_ternary:nN #1 #2
  {
    \bool_set_false:N \l__numodel_is_ternary_bool
    \regex_match:nnT { (.+) \? (.+) \: (.+) } {#1}
      {
        \bool_set_true:N \l__numodel_is_ternary_bool
        \tl_set:Nn \l__numodel_cond_tl {#1}
        \regex_replace_once:nnN { \s*(.+?) \s* \? .+ } { \1 } \l__numodel_cond_tl
        \tl_set:Nn \l__numodel_true_tl {#1}
        \regex_replace_once:nnN { .+? \? \s* (.+?) \s* \: .+ } { \1 } \l__numodel_true_tl
        \tl_set:Nn \l__numodel_false_tl {#1}
        \regex_replace_once:nnN { .+ \: \s* (.+?) \s* \Z } { \1 } \l__numodel_false_tl
        \__numodel_vars_to_display:N \l__numodel_cond_tl
        \__numodel_vars_to_display:N \l__numodel_true_tl
        \__numodel_vars_to_display:N \l__numodel_false_tl
      }
  }


\cs_new_protected:Npn \__numodel_blank_wrap:
  {
    \bool_if:NT \l__numodel_blank_bool
      {
        \tl_set:Ne \l__numodel_display_tl
          {
            \exp_not:N \__numodel_blank_choice:nn
              { \exp_not:V \l__numodel_lhs_tl \exp_not:n { \,=\, \cdots } }
              { \exp_not:V \l__numodel_display_tl }
          }
      }
  }

\cs_new_protected:Npn \__numodel_mrule_exec:nnnn #1#2#3#4 {%
  \__numodel_debug:n{MRULE~start:~#3}
  \bool_set_false:N \l__numodel_is_ternary_bool
  \bool_set_false:N \l__numodel_blank_bool
  % Parse keys (prefix, alias, aliasleft, aliasright; gridx/gridy ignored)
  \tl_clear:N \l__numodel_alias_tl
  \tl_clear:N \l__numodel_aliasleft_tl
  \tl_clear:N \l__numodel_aliasright_tl
  \keys_set:nn { numodel / mvar } {#2}
  \tl_clear:N \l__numodel_cmd_prefix_tl
  \__numodel_resolve_eff_prefix:
  \__numodel_with_prefix:Nn \l__numodel_eff_prefix_tl
    { \__numodel_mrule_body:nnn {#1}{#3}{#4} }%
  \__numodel_debug:n{MRULE~done:~#3}
}

\cs_new_protected:Npn \__numodel_mrule_body:nnn #1 #2 #3
  {
    \int_gincr:N \g_mrule_counter_int
    \tl_set:Ne \l__numodel_fullname_tl { \g_numodel_current_prefix_tl #2 }
    % Store execution data (target = full name)
    \seq_gput_right:Nx \g_mrule_calc_seq
      { { \l__numodel_fullname_tl } { \exp_not:n {#3} } }
    % Left-hand side: aliasleft or default display name
    \tl_if_blank:VTF \l__numodel_aliasleft_tl
      { \tl_set:Ne \l__numodel_lhs_tl { \use:c { \l__numodel_fullname_tl text } } }
      { \tl_set_eq:NN \l__numodel_lhs_tl \l__numodel_aliasleft_tl }
    % Generate display
    \tl_if_blank:VTF \l__numodel_alias_tl
      {
        \tl_if_blank:VTF \l__numodel_aliasright_tl
          {
            % Automatic display generation.  FPEVAL shows the body
            % verbatim in l3fp syntax (no ternary expansion); every
            % other syntax goes through the syllabus rewrite.
            \bool_if:NTF \g__numodel_fpeval_bool
              {
                \tl_set:Nn \l__numodel_rhs_tl {#3}
                \__numodel_vars_to_display_fpeval:N \l__numodel_rhs_tl
                \tl_set:Ne \l__numodel_display_tl
                  {
                    \exp_not:n { \__numodel_fpeval_render:nn }
                      { \exp_not:V \l__numodel_lhs_tl }
                      { \exp_not:V \l__numodel_rhs_tl }
                  }
              }
              {
            % Automatic display generation (ternary or normal)
            \__numodel_parse_ternary:nN {#3} \l__numodel_display_tl
            \bool_if:NTF \l__numodel_is_ternary_bool
              {
                \IfBooleanTF {#1}
                  {
                    % Starred ternary -> multiline IF/THEN/ELSE/ENDIF
                    \tl_set:Ne \l__numodel_display_tl
                      {
                        \__numodel_kwt:n {if}
                        \exp_not:V \l__numodel_cond_tl
                        \__numodel_kwt:n {then_nl}
                      }
                    \__numodel_blank_wrap:
                    \seq_gput_right:NV \g_mrule_seq \l__numodel_display_tl
                    \seq_gput_right:Nn \g_mrule_type_seq { rule }
                    \tl_set:Ne \l__numodel_display_tl
                      {
                        \exp_not:n { \quad }
                        \exp_not:V \l__numodel_lhs_tl \exp_not:n { \,=\, }
                        \exp_not:V \l__numodel_true_tl
                      }
                    \seq_gput_right:NV \g_mrule_seq \l__numodel_display_tl
                    \seq_gput_right:Ne \g_mrule_type_seq
                      { \bool_if:NTF \l__numodel_blank_bool { blankcont } { cont } }
                    \seq_gput_right:Ne \g_mrule_seq { \__numodel_kwt:n {else_nl} }
                    \seq_gput_right:Ne \g_mrule_type_seq
                      { \bool_if:NTF \l__numodel_blank_bool { blankcont } { cont } }
                    \tl_set:Ne \l__numodel_display_tl
                      {
                        \exp_not:n { \quad }
                        \exp_not:V \l__numodel_lhs_tl \exp_not:n { \,=\, }
                        \exp_not:V \l__numodel_false_tl
                      }
                    \seq_gput_right:NV \g_mrule_seq \l__numodel_display_tl
                    \seq_gput_right:Ne \g_mrule_type_seq
                      { \bool_if:NTF \l__numodel_blank_bool { blankcont } { cont } }
                    \seq_gput_right:Ne \g_mrule_seq { \__numodel_kwt:n {endif_nl} }
                    \seq_gput_right:Ne \g_mrule_type_seq
                      { \bool_if:NTF \l__numodel_blank_bool { blankcont } { cont } }
                  }
                  {
                    % Unstarred ternary -> single-line
                    \tl_set:Ne \l__numodel_display_tl
                      {
                        \__numodel_kwt:n {if}
                        \exp_not:V \l__numodel_cond_tl
                        \__numodel_kwt:n {then}
                        \exp_not:V \l__numodel_lhs_tl \exp_not:n { \,=\, }
                        \exp_not:V \l__numodel_true_tl
                        \__numodel_kwt:n {else}
                        \exp_not:V \l__numodel_lhs_tl \exp_not:n { \,=\, }
                        \exp_not:V \l__numodel_false_tl
                        \__numodel_kwt:n {endif}
                      }
                  }
              }
              {
                % Ordinary assignment: lhs = rhs
                \tl_set:Nn \l__numodel_rhs_tl {#3}
                \__numodel_vars_to_display:N \l__numodel_rhs_tl
                \__numodel_debug:n{MRULE~rhs~after:~\tl_to_str:N \l__numodel_rhs_tl}
                \tl_set:Ne \l__numodel_display_tl
                  {
                    \exp_not:V \l__numodel_lhs_tl \exp_not:n { \,=\, }
                    \exp_not:V \l__numodel_rhs_tl
                  }
                \__numodel_debug:n{MRULE~display:~\tl_to_str:N \l__numodel_display_tl}
              }
              }
          }
          {
            % aliasright: lhs = aliasright (no ternary processing)
            \tl_set:Ne \l__numodel_display_tl
              {
                \exp_not:V \l__numodel_lhs_tl \exp_not:n { \,=\, }
                \exp_not:V \l__numodel_aliasright_tl
              }
          }
      }
      {
        % alias: replace the whole row
        \tl_set:Ne \l__numodel_display_tl { \exp_not:V \l__numodel_alias_tl }
      }
    % For starred ternary everything is already pushed above
    \bool_if:nF { \l__numodel_is_ternary_bool && #1 }
      {
        \__numodel_blank_wrap:
        \seq_gput_right:NV \g_mrule_seq \l__numodel_display_tl
        \seq_gput_right:Nn \g_mrule_type_seq { rule }
      }
    % Pillar A — Lua-side rule registration.  Detokenize the raw
    % expression so Lua sees the macro names, not the evaluated
    % fp values.  Lua handles both the dependency extraction
    % (build_deps) and the flow detection (classify_flows) at
    % \graphicmodel time.
    \tl_set:Ne \l__numodel_scratch_tl { \detokenize {#3} }
    \directlua{ numodel.add_rule(
      "\g_numodel_current_prefix_tl",
      "\l__numodel_fullname_tl",
      "\luaescapestring{\l__numodel_scratch_tl}",
      "\bool_if:NTF \l__numodel_is_ternary_bool { ternary } { calc }",
      \IfBooleanTF {#1} { true } { false },
      \bool_if:NTF \l__numodel_blank_bool { true } { false }) }
  }


\cs_new_protected:Npn \__numodel_mruletext_exec:nn #1#2 {%
  \keys_set:nn { numodel / cmd } {#1}
  \tl_clear:N \l__numodel_cmd_prefix_tl
  \__numodel_resolve_eff_prefix:
  \__numodel_with_prefix:Nn \l__numodel_eff_prefix_tl
    {
      \int_gincr:N \g_mrule_counter_int
      \seq_gput_right:Nn \g_mrule_seq {#2}
      \seq_gput_right:Nn \g_mrule_type_seq { rule }
      \directlua{ numodel.add_ruletext(
        "\g_numodel_current_prefix_tl",
        "\luaescapestring{\detokenize{#2}}") }
    }
}


\tl_new:N \l__numodel_stop_tl
\cs_new_protected:Npn \__numodel_mstop_exec:nnn #1#2#3 {%
  \__numodel_debug:n{MSTOP~start}
  % Parse keys (only alias is honoured; prefix via key resolver)
  \tl_clear:N \l__numodel_alias_tl
  \tl_clear:N \l__numodel_aliasleft_tl
  \tl_clear:N \l__numodel_aliasright_tl
  \tl_clear:N \l__numodel_cmd_prefix_tl
  \bool_set_false:N \l__numodel_blank_bool
  \keys_set:nn { numodel / mvar } {#2}
  \tl_clear:N \l__numodel_cmd_prefix_tl
  \__numodel_resolve_eff_prefix:
  \__numodel_with_prefix:Nn \l__numodel_eff_prefix_tl
    { \__numodel_mstop_body:n {#3} }%
  \__numodel_debug:n{MSTOP~done}
}

\cs_new_protected:Npn \__numodel_mstop_body:n #1
  {
    \int_gincr:N \g_mrule_counter_int
    % Store expression for execution (always the actual condition)
    \tl_gset:Nn \g_numodel_stop_expr_tl {#1}
    \directlua{ numodel.set_stop(
      "\g_numodel_current_prefix_tl",
      "\luaescapestring{\detokenize{#1}}",
      \bool_if:NTF \l__numodel_blank_bool { true } { false }) }
    % Generate display
    \tl_if_blank:VTF \l__numodel_alias_tl
      {
        \bool_if:NTF \g__numodel_fpeval_bool
          {
            % FPEVAL: "stop: <condition>" verbatim in l3fp syntax.
            \tl_set:Nn \l__numodel_stop_tl {#1}
            \__numodel_vars_to_display_fpeval:N \l__numodel_stop_tl
            \tl_set:Ne \l__numodel_display_tl
              {
                \exp_not:n { \__numodel_fpeval_stoprow:nn }
                  { \__numodel_kw:n {stop} }
                  { \exp_not:V \l__numodel_stop_tl }
              }
          }
          {
            \tl_set:Nn \l__numodel_stop_tl {#1}
            \__numodel_vars_to_display:N \l__numodel_stop_tl
            \tl_set:Ne \l__numodel_display_tl
              {
                \__numodel_kwt:n {if}
                \exp_not:V \l__numodel_stop_tl
                \__numodel_kwt:n {then_nl}
                \__numodel_kwt:n {stop}
                \__numodel_kwt:n {endif_nl}
              }
          }
      }
      {
        \tl_set:Ne \l__numodel_display_tl { \exp_not:V \l__numodel_alias_tl }
      }
    % \mstop[blank]: "IF \cdots THEN STOP ENDIF" in the pupil's version.
    \bool_if:NT \l__numodel_blank_bool
      {
        \tl_set:Ne \l__numodel_display_tl
          {
            \exp_not:N \__numodel_blank_choice:nn
              {
                \bool_if:NTF \g__numodel_fpeval_bool
                  {
                    \exp_not:n { \__numodel_fpeval_stoprow:nn }
                      { \__numodel_kw:n {stop} } { \exp_not:n { \cdots } }
                  }
                  {
                    \__numodel_kwt:n {if}
                    \exp_not:n { \cdots }
                    \__numodel_kwt:n {then_nl}
                    \__numodel_kwt:n {stop}
                    \__numodel_kwt:n {endif_nl}
                  }
              }
              { \exp_not:V \l__numodel_display_tl }
          }
      }
    \seq_gput_right:NV \g_mrule_seq \l__numodel_display_tl
    \seq_gput_right:Nn \g_mrule_type_seq { rule }
  }



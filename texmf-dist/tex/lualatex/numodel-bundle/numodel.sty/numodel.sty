          }
      },
    legend                     .default:n = true,
    % \computemodel-only: engine=fpeval|lua|compare for this run.
    engine                     .code:n =
      { \__numodel_local_choice:Nnnn \l__numodel_cmd_engine_tl
          { engine } { fpeval , lua , compare } {#1} },
    % \textmodel-only: blanks=open|filled for this table.
    blanks                     .code:n =
      { \__numodel_local_choice:Nnnn \l__numodel_cmd_blanks_tl
          { blanks } { open , filled } {#1} },
    % style: model points (marks, default), a line, or both.
    style                      .code:n =
      { \__numodel_local_choice:Nnnn \l__numodel_cmd_style_tl
          { style } { marks , line , both } {#1} },
    % float=false: no figure float, so the diagram fits in a minipage,
    % a tcolorbox or an exam solution.
    float                      .bool_set:N = \l__numodel_cmd_float_bool,
    caption                    .tl_set:N   = \l__numodel_cmd_caption_tl,

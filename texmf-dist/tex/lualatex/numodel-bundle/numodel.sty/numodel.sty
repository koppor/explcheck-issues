                    \bool_lazy_and:nnT
                      { \str_if_eq_p:ee { \__numodel_item_kind:nnnnnnnnn ####1 } { rule } }
                      { \str_if_eq_p:ee { \__numodel_item_name:nnnnnnnnn ####1 } {##1} }
                      { \__numodel_item_add_blank:nnnnnnnnn ####1 }
                    \seq_put_right:NV \l__numodel_log_tmp_seq \l__numodel_item_tl
                  }
                \seq_gset_eq:cN { \__numodel_log:n {#1} } \l__numodel_log_tmp_seq
              }
          }
      }
      {
        \__numodel_log_find:nnn {#1} { mvar } {#2}
        \int_compare:nNnTF { \l__numodel_log_count_int } = { 0 }
          { \msg_error:nnnn { numodel } { copy-no-var } {#1} {#2} }
          {

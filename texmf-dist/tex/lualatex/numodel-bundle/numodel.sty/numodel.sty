\NewDocumentCommand{\computemodel}{ O{} }{%
  \__numodel_debug:n{COMPUTE~start}
  \tl_clear:N \l__numodel_cmd_prefix_tl
  \tl_clear:N \l__numodel_cmd_engine_tl
  \keys_set:nn { numodel / cmd } {#1}
  \tl_set:Ne \l__numodel_eff_engine_tl
    {
      \tl_if_empty:NTF \l__numodel_cmd_engine_tl
        { \tl_use:N \g__numodel_engine_tl }
        { \tl_use:N \l__numodel_cmd_engine_tl }
    }
  \__numodel_resolve_eff_prefix:
  \__numodel_with_prefix:Nn \l__numodel_eff_prefix_tl
    { \__numodel_compute_body: }%
  \__numodel_debug:n{COMPUTE~done}
}

\cs_new_protected:Npn \__numodel_compute_fpeval:
  {
    \int_gzero:N \g_numodel_steps_int
    % Initialise Lua storage for this prefix
    \directlua{ numodel.init("\g_numodel_current_prefix_tl") }
    % Main loop
    \bool_gset_false:N \g_tmpa_bool
    \bool_do_until:Nn \g_tmpa_bool
      {
        \__numodel_lua_record_all:
        \int_gincr:N \g_numodel_steps_int
        \int_compare:nNnT
          { \fp_eval:n { \g_numodel_stop_expr_tl } } = { 1 }
          { \bool_gset_true:N \g_tmpa_bool }
        \bool_if:NF \g_tmpa_bool
          {
            \seq_map_inline:Nn \g_mrule_calc_seq
              { \__numodel_exec_rule:nn ##1 }
          }
        \int_compare:nNnT
          { \g_numodel_steps_int } > { \g_numodel_maxiter_int }
          {
            \bool_gset_true:N \g_tmpa_bool
            \msg_warning:nn { numodel } { maxiter }
          }
      }
  }

\cs_new_protected:Npn \__numodel_engine_run:n #1
  {
    \seq_map_inline:Nn \g_mvar_names_seq
      {
        \directlua{ numodel.engine_set_init("##1",
          "\luaescapestring{ \use:c {##1} }") }
      }
    \group_begin:
      \seq_map_inline:Nn \g_mvar_names_seq
        { \cs_set:cpe {##1} { \exp_not:N \exp_not:N \exp_not:c {##1} } }
      \seq_map_inline:Nn \g_mrule_calc_seq
        { \__numodel_engine_rule:nn ##1 }
      \tl_set:Ne \l__numodel_engine_expr_tl { \g_numodel_stop_expr_tl }
      \directlua{ numodel.engine_run("\g_numodel_current_prefix_tl",
        "\luaescapestring{ \tl_to_str:N \l__numodel_engine_expr_tl }",
        \int_use:N \g_numodel_maxiter_int, #1) }
    \group_end:
    \tl_set:Ne \l__numodel_engine_status_tl
      { \directlua{ tex.sprint(-2, numodel.engine_status) } }
  }
\cs_new_protected:Npn \__numodel_engine_rule:nn #1#2
  {
    \tl_set:Ne \l__numodel_engine_expr_tl {#2}
    \directlua{ numodel.engine_add_rule("#1",
      "\luaescapestring{ \tl_to_str:N \l__numodel_engine_expr_tl }") }
  }


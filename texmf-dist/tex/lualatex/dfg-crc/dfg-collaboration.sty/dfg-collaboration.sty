\prop_new:N \l__dfgcollab_projects_prop
\tl_new:N \l__dfgcollab_area_tl
\tl_new:N \l__dfgcollab_links_tl
\bool_new:N \l__dfgcollab_active_bool
\clist_new:N \l__dfgcollab_selection_clist
\clist_new:N \l__dfgcollab_override_clist
\prop_new:N \l__dfgcollab_selection_prop
\bool_new:N \l__dfgcollab_selection_bool
\bool_new:N \l__dfgcollab_override_bool
\tl_new:N \l__dfgcollab_colors_tl
\tl_new:N \l__dfgcollab_palette_tl
\keys_define:nn {dfgcollab/project}
  {
    area .tl_set:N = \l__dfgcollab_area_tl,
    collaboration .tl_set:N = \l__dfgcollab_links_tl,
    collaborations .meta:n = {collaboration={#1}},
    active .bool_set:N = \l__dfgcollab_active_bool,
  }
\keys_define:nn {dfgcollab/setup}
  {
    area-colors .tl_set:N = \l__dfgcollab_colors_tl,
    area-palette .tl_set:N = \l__dfgcollab_palette_tl,
    area-palette .initial:n = {blue!70!black,teal!80!black,orange!85!black,violet,brown},
  }
\NewDocumentCommand \CollaborationSetup {m}{\keys_set:nn {dfgcollab/setup}{#1}}
\NewDocumentCommand \clearCollaborationProjects {}{\prop_clear:N \l__dfgcollab_projects_prop}
\NewDocumentCommand \DeclareCollaborationProject {m m}
  {
    \regex_match:nnTF {\A[A-Za-z0-9][A-Za-z0-9-]*\Z}{#1}
      {
        \group_begin:
        \tl_set:Nn \l__dfgcollab_area_tl {#1}
        \tl_set:Ne \l__dfgcollab_area_tl {\tl_head:V \l__dfgcollab_area_tl}
        \tl_clear:N \l__dfgcollab_links_tl
        \bool_set_true:N \l__dfgcollab_active_bool
        \keys_set:nn {dfgcollab/project}{#2}
        \use:e {\group_end:
          \prop_put:Nnn \exp_not:N \l__dfgcollab_projects_prop {#1}
            {area={\exp_not:V \l__dfgcollab_area_tl},
             collaboration={\exp_not:V \l__dfgcollab_links_tl},
             active=\bool_if:NTF \l__dfgcollab_active_bool {true}{false}}}
      }
      {\msg_error:nnn {dfg-collaboration}{bad-id}{#1}}
  }
\msg_new:nnn {dfg-collaboration}{bad-id}{Invalid~project~ID~'#1'.~Use~letters,~digits,~and~hyphens.}
\msg_new:nnn {dfg-collaboration}{target-not-found}
  {Project~'#1'~references~unknown~collaboration~target~'#2'.}
\msg_new:nnn {dfg-collaboration}{focus-not-found}{Unknown~or~inactive~focus~project~'#1'.}
\msg_new:nnn {dfg-collaboration}{empty-palette}{The~area~palette~must~not~be~empty.}
\keys_define:nn {dfg / project-collaboration-plot}
  {
    collaboration .code:n =
      {\bool_set_true:N \l__dfgcollab_override_bool
       \clist_set:Nn \l__dfgcollab_override_clist {#1}},
    collaboration .value_required:n = true,
    collaborations .meta:n = {collaboration={#1}},
    show-projects .code:n =
      {\bool_set_true:N \l__dfgcollab_selection_bool
       \clist_set:Nn \l__dfgcollab_selection_clist {#1}},
    show-projects .value_required:n = true,
    projects .meta:n = {show-projects={#1}},
    projects .value_required:n = true,
    width .dim_set:N = \l__dfg_collaboration_plot_width_dim,
  }
\cs_new_protected:Npn \__dfgcollab_reset:
  {
    \bool_set_false:N \l__dfgcollab_selection_bool
    \bool_set_false:N \l__dfgcollab_override_bool
    \clist_clear:N \l__dfgcollab_selection_clist
    \clist_clear:N \l__dfgcollab_override_clist
    \keys_set:nn {dfg / project-collaboration-plot}{layout=arc,arcs=false}
  }
\cs_new_protected:Npn \__dfgcollab_select:
  {
    \bool_if:NT \l__dfgcollab_selection_bool
      {
        \prop_clear:N \l__dfgcollab_selection_prop
        \clist_map_inline:Nn \l__dfgcollab_selection_clist
          {\prop_put:Nnn \l__dfgcollab_selection_prop {##1}{1}}
        \prop_put:NVn \l__dfgcollab_selection_prop \l__dfg_collaboration_plot_focus_tl {1}
        \seq_map_inline:Nn \l__dfg_collaboration_plot_nodes_seq
          {\prop_if_in:NnF \l__dfgcollab_selection_prop {##1}
            {\seq_remove_all:Nn \l__dfg_collaboration_plot_nodes_seq {##1}
             \prop_remove:Nn \l__dfg_collaboration_plot_status_prop {##1}
             \prop_remove:Nn \l__dfg_collaboration_plot_lists_prop {##1}}}
      }
  }
\cs_new_protected:Npn \__dfgcollab_override_edges:
  {
    \bool_if:NT \l__dfgcollab_override_bool
      {
        \prop_map_inline:Nn \l__dfg_collaboration_plot_edges_prop
          {
            \__dfg_collaboration_plot_unpack_edge:n {##1}
            \bool_lazy_or:nnT
              {\str_if_eq_p:VV \l__dfg_collaboration_plot_edge_left_tl \l__dfg_collaboration_plot_focus_tl}
              {\str_if_eq_p:VV \l__dfg_collaboration_plot_edge_right_tl \l__dfg_collaboration_plot_focus_tl}
              {\prop_remove:Nn \l__dfg_collaboration_plot_edges_prop {##1}}
          }
        \clist_map_inline:Nn \l__dfgcollab_override_clist
          {\exp_args:NV \__dfg_collaboration_plot_collect_edge:nn
            \l__dfg_collaboration_plot_focus_tl {##1}}
      }
  }
\cs_new_protected:Npn \__dfgcollab_collect:
  {
    \seq_clear:N \l__dfg_collaboration_plot_nodes_seq
    \prop_clear:N \l__dfg_collaboration_plot_status_prop
    \prop_clear:N \l__dfg_collaboration_plot_all_status_prop
    \prop_clear:N \l__dfg_collaboration_plot_lists_prop
    \prop_clear:N \l__dfg_collaboration_plot_area_prop
    \prop_clear:N \l__dfg_collaboration_plot_edges_prop
    \prop_map_inline:Nn \l__dfgcollab_projects_prop
      {
        \keys_set:nn {dfgcollab/project}{##2}
        \prop_put:Nnn \l__dfg_collaboration_plot_all_status_prop {##1}{C}
        \bool_if:NT \l__dfgcollab_active_bool
          {\seq_put_right:Nn \l__dfg_collaboration_plot_nodes_seq {##1}
           \prop_put:Nnn \l__dfg_collaboration_plot_status_prop {##1}{C}
           \prop_put:NnV \l__dfg_collaboration_plot_area_prop {##1}\l__dfgcollab_area_tl
           \prop_put:NnV \l__dfg_collaboration_plot_lists_prop {##1}\l__dfgcollab_links_tl}
      }
    \seq_sort:Nn \l__dfg_collaboration_plot_nodes_seq
      {\str_compare:eNeTF
        {\prop_item:Nn \l__dfg_collaboration_plot_area_prop {##1}/##1}<
        {\prop_item:Nn \l__dfg_collaboration_plot_area_prop {##2}/##2}
        {\sort_return_same:}{\sort_return_swapped:}}
    \__dfgcollab_select:
  }
\NewDocumentCommand \CollaborationPlot {O{} m}
  {
    \group_begin:
    \__dfgcollab_reset:
    \dim_set:Nn \l__dfg_collaboration_plot_width_dim {\linewidth}
    \exp_args:NNV \prop_set_from_keyval:Nn \l__dfg_collaboration_plot_area_color_override_prop
      \l__dfgcollab_colors_tl
    \exp_args:NNV \seq_set_from_clist:Nn \l__dfg_collaboration_plot_area_palette_seq
      \l__dfgcollab_palette_tl
    \tl_clear:N \l__dfg_collaboration_plot_caption_tl
    \__dfgplots_options:nnn {dfg / project-collaboration-plot}{collaboration}{#1}
    \seq_if_empty:NT \l__dfg_collaboration_plot_area_palette_seq
      {\msg_error:nn {dfg-collaboration}{empty-palette}
       \seq_put_right:Nn \l__dfg_collaboration_plot_area_palette_seq {blue}}
    \tl_set:Nn \l__dfg_collaboration_plot_focus_tl {#2}
    % An explicit one-off link list is a complete ID-only dataset when none exists.
    \prop_if_empty:NT \l__dfgcollab_projects_prop
      {\bool_if:NT \l__dfgcollab_override_bool
        {\DeclareCollaborationProject{#2}{}
         \clist_map_inline:Nn \l__dfgcollab_override_clist
           {\DeclareCollaborationProject{##1}{}}}}
    \__dfgcollab_collect:
    \prop_if_in:NnTF \l__dfg_collaboration_plot_status_prop {#2}
      {
        \__dfg_collaboration_plot_collect_edges:
        \__dfg_collaboration_plot_prepare:
        \__dfgplots_float: {figure}{\__dfg_collaboration_plot_full_width_picture:}
          {Collaborations~of~#2.\tl_if_blank:VF \l__dfg_collaboration_plot_caption_tl
            {~\tl_use:N \l__dfg_collaboration_plot_caption_tl}}
          {fig:project-collaboration-#2-\tl_use:N \l__dfg_collaboration_plot_layout_tl}
      }
      {\msg_error:nnn {dfg-collaboration}{focus-not-found}{#2}}
    \group_end:
  }

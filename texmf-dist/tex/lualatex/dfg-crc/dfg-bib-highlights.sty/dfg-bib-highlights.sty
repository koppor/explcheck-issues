  % ---------- Auxiliary .bib file -----------------------------------

  \tl_const:Ne \c__dfg_boldnames_bibfile_tl {\DFGBoldNamesFile}
  \iow_open:Nn \g__dfg_boldnames_iow { \c__dfg_boldnames_bibfile_tl }

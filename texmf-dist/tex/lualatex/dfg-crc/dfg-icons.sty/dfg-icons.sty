            [l,top=0,lines=\int_use:N \l__crc_icon_lines_int,
             leftsep=0pt,rightsep=\dim_use:N \l__crc_icon_gap_dim,
             abovesep=0pt,belowsep=0pt]
        }
        \phantom{\box_use:N \l__crc_icon_box}
      \end{wrapstuff}

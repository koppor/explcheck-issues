                  \tex_kern:D \l__crc_icon_gap_dim
                }
              \tex_unkern:D
            }
        }
      % Keep a pending list label at its margin rather than beside the image.
      \legacy_if:nT {@inlabel}
        {
          \hbox_gset:cn {@labels}
            {
              \tex_kern:D -\dim_eval:n
                {\box_wd:N \l__crc_icon_box + \l__crc_icon_gap_dim}
              \box_use_drop:c {@labels}
              \tex_kern:D \dim_eval:n
                {\box_wd:N \l__crc_icon_box + \l__crc_icon_gap_dim}
            }
        }

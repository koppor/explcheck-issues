    \seq_clear:N \l__crc_plot_categories_seq
    \seq_if_empty:NTF \l__crc_plot_events_seq
      {\emph{No~events~for~the~selected~year.}}
      {
        \str_if_eq:VnTF \l__crc_plot_year_tl {all}
          {
            \fp_set:Nn \l__crc_plot_start_fp

                \prop_item:Ne \l__crc_plot_geometry_prop {\l__crc_plot_sat_b_tl/\l__crc_plot_sat_type_tl-sin}*\l__crc_plot_ny_fp)+
           \prop_item:Ne \l__crc_plot_geometry_prop {\l__crc_plot_sat_b_tl/\l__crc_plot_sat_type_tl-hh}
           *abs(-\prop_item:Ne \l__crc_plot_geometry_prop {\l__crc_plot_sat_b_tl/\l__crc_plot_sat_type_tl-sin}*\l__crc_plot_nx_fp+
                 \prop_item:Ne \l__crc_plot_geometry_prop {\l__crc_plot_sat_b_tl/\l__crc_plot_sat_type_tl-cos}*\l__crc_plot_ny_fp)}

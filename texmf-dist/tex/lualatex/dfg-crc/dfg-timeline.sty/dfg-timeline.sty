        \dim_zero:N \l__crc_plot_height_dim
        \dim_zero:N \l__crc_plot_date_height_dim
        \dim_zero:N \l__crc_plot_bottom_dim
        \seq_map_inline:Nn \l__crc_plot_events_seq {\crc_plot_measure:n {##1}}
        \crc_plot_fit:
        \tl_if_eq:NnTF \l__crc_plot_lane_spacing_tl {auto}
          {\dim_set:Nn \l__crc_plot_step_dim {\l__crc_plot_height_dim+\l__crc_plot_gap_dim}}
          {\dim_set:Nn \l__crc_plot_step_dim {\l__crc_plot_lane_spacing_tl}}

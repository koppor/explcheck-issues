              {\fp_set:Nn \l__crc_plot_span_fp
                {max(\l__crc_plot_span_fp,ceil(\prop_item:Nn \l__crc_event_end_positions_prop {##1}))}}
            \fp_sub:Nn \l__crc_plot_span_fp {\l__crc_plot_start_fp}

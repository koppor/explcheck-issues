        \prop_item:Nn \l__crc_plot_geometry_prop {#1/fraction}*\dim_to_fp:n {\l__crc_plot_axis_span_dim}}}
    \prop_put:Nnx \l__crc_plot_geometry_prop {#1/x}{\dim_use:N \l__crc_plot_x_dim}
    \prop_put:Nnx \l__crc_plot_geometry_prop {#1/end-x}
      {\fp_to_dim:n {\dim_to_fp:n {\l__crc_plot_left_dim}+
        \prop_item:Nn \l__crc_plot_geometry_prop {#1/end-fraction}*\dim_to_fp:n {\l__crc_plot_axis_span_dim}}}
    \prop_put:Nnx \l__crc_plot_geometry_prop {#1/label-x}
      {\dim_eval:n {\l__crc_plot_x_dim+\l__crc_plot_xshift_dim}}
    \prop_put:Nnx \l__crc_plot_geometry_prop {#1/label-left}
      {\dim_eval:n {\l__crc_plot_x_dim+\l__crc_plot_xshift_dim+\prop_item:Nn \l__crc_plot_geometry_prop {#1/min-x}}}
    \prop_put:Nnx \l__crc_plot_geometry_prop {#1/label-right}
      {\dim_eval:n {\l__crc_plot_x_dim+\l__crc_plot_xshift_dim+\prop_item:Nn \l__crc_plot_geometry_prop {#1/max-x}}}
    \prop_put:NnV \l__crc_plot_geometry_prop {#1/lane-request}\l__crc_plot_lane_tl
    % Count shared starts separately from full date-range labels: different end
    % dates need distinct labels even when their start point is shared.
    \prop_if_in:NVTF \l__crc_plot_dates_prop \l__crc_event_date_tl
      {\prop_get:NVN \l__crc_plot_dates_prop \l__crc_event_date_tl \l_tmpa_tl
       \tl_set:Nx \l_tmpa_tl {\int_eval:n {\l_tmpa_tl+1}}
       \prop_put:NVV \l__crc_plot_dates_prop \l__crc_event_date_tl \l_tmpa_tl}
      {\prop_put:NVn \l__crc_plot_dates_prop \l__crc_event_date_tl {1}}
    \prop_put:Nnn \l__crc_plot_geometry_prop {#1/date-show}{false}
    \bool_if:NT \l__crc_plot_show_dates_bool
      {
        \tl_set:Nx \l_tmpa_tl {\l__crc_event_date_tl/\l__crc_event_end_date_tl}
        \prop_if_in:NVF \l__crc_plot_date_labels_prop \l_tmpa_tl
          {
            \prop_put:NVn \l__crc_plot_date_labels_prop \l_tmpa_tl {used}
            \prop_put:Nnn \l__crc_plot_geometry_prop {#1/date-show}{true}
            \prop_put:Nnx \l__crc_plot_geometry_prop {#1/date-x}
              {\dim_eval:n {\l__crc_plot_x_dim+\l__crc_plot_date_xshift_dim}}
            \tl_set_eq:NN \l__crc_plot_request_tl \l__crc_plot_date_lane_tl
            \crc_plot_find_lane:nn {date}{#1}
            \dim_set:Nn \l__crc_plot_bottom_dim
              {\dim_min:nn {\l__crc_plot_bottom_dim}
                {\l__crc_plot_y_dim+\prop_item:Nn \l__crc_plot_geometry_prop {#1/date-min-y}}}
          }

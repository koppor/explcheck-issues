\cs_new_protected:Npn \crc_plot_intersects:nnn #1#2#3
  {
    \tl_set:Nn \l__crc_plot_sat_type_tl {#1}
    \tl_set:Nn \l__crc_plot_sat_a_tl {#2}
    \tl_set:Nn \l__crc_plot_sat_b_tl {#3}
    \fp_set:Nn \l__crc_plot_dx_fp
      {\dim_to_fp:n {\prop_item:Nn \l__crc_plot_geometry_prop {#2/#1-x}}+
       \prop_item:Nn \l__crc_plot_geometry_prop {#2/#1-cx}-
       \dim_to_fp:n {\prop_item:Nn \l__crc_plot_geometry_prop {#3/#1-x}}-
       \prop_item:Nn \l__crc_plot_geometry_prop {#3/#1-cx}}
    \fp_set:Nn \l__crc_plot_dy_fp
      {\dim_to_fp:n {\l__crc_plot_y_dim}+\prop_item:Nn \l__crc_plot_geometry_prop {#2/#1-cy}-
       \dim_to_fp:n {\prop_item:Nn \l__crc_plot_geometry_prop {#3/#1-y}}-
       \prop_item:Nn \l__crc_plot_geometry_prop {#3/#1-cy}}
    \bool_set_true:N \l__crc_plot_intersects_bool
    \clist_map_inline:nn {#2,#3}
      {
        \crc_plot_sat_axis:nn
          {\prop_item:Nn \l__crc_plot_geometry_prop {##1/#1-cos}}
          {\prop_item:Nn \l__crc_plot_geometry_prop {##1/#1-sin}}
        \crc_plot_sat_axis:nn
          {-\prop_item:Nn \l__crc_plot_geometry_prop {##1/#1-sin}}
          {\prop_item:Nn \l__crc_plot_geometry_prop {##1/#1-cos}}
      }
  }
\cs_new_protected:Npn \crc_plot_find_lane:nn #1#2
  {
    \tl_if_eq:NnTF \l__crc_plot_request_tl {auto}
      {
        \int_zero:N \l__crc_plot_candidate_int
        \str_if_eq:nnT {#1}{label}
          {\seq_map_inline:Nn \l__crc_plot_events_seq
            {\int_compare:nNnT {##1}<{#2}
              {\str_if_eq:eeT {\prop_item:Nn \l__crc_event_dates_prop {##1}}
                               {\prop_item:Nn \l__crc_event_dates_prop {#2}}
                {\prop_get:NnNT \l__crc_plot_geometry_prop {##1/label-lane}\l_tmpa_tl
                  {\int_set:Nn \l__crc_plot_candidate_int
                    {\int_max:nn {\l__crc_plot_candidate_int}{\l_tmpa_tl+1}}}}}}}
        \bool_set_true:N \l__crc_plot_conflict_bool
        \int_zero:N \l__crc_plot_attempts_int
        \bool_while_do:nn {\l__crc_plot_conflict_bool}
          {
            \int_incr:N \l__crc_plot_attempts_int
            \bool_set_false:N \l__crc_plot_conflict_bool
            \crc_plot_candidate_y:nn {#1}{#2}
            \seq_map_inline:Nn \l__crc_plot_events_seq
              {
                \prop_if_in:NnT \l__crc_plot_geometry_prop {##1/#1-y}
                  {\crc_plot_intersects:nnn {#1}{#2}{##1}
                   \bool_if:NT \l__crc_plot_intersects_bool
                     {\bool_set_true:N \l__crc_plot_conflict_bool\seq_map_break:}}
              }
            \bool_if:NT \l__crc_plot_conflict_bool {\int_incr:N \l__crc_plot_candidate_int}
            \int_compare:nNnT {\l__crc_plot_attempts_int}>{999}
              {\bool_if:NT \l__crc_plot_conflict_bool
                {\msg_error:nnn {crc-events}{bad-input}
                  {Automatic~placement~exceeded~1000~attempts;~increase~lane~spacing~or~set~a~lane.}
                 \bool_set_false:N \l__crc_plot_conflict_bool}}
          }
      }
      {
        \exp_args:NnV \regex_match:nnTF {\A[0-9]+\Z}\l__crc_plot_request_tl
          {\int_set:Nn \l__crc_plot_candidate_int {\l__crc_plot_request_tl}}
          {\msg_error:nnn {crc-events}{bad-input}{Use~lane=auto~or~a~nonnegative~integer.}}
        \crc_plot_candidate_y:nn {#1}{#2}
      }
    \prop_put:Nnx \l__crc_plot_geometry_prop {#2/#1-lane}{\int_use:N \l__crc_plot_candidate_int}
    \prop_put:Nnx \l__crc_plot_geometry_prop {#2/#1-y}{\dim_use:N \l__crc_plot_y_dim}
  }
\cs_new_protected:Npn \crc_plot_place:n #1
  {
    \crc_plot_load:n {#1}
    \dim_set:Nn \l__crc_plot_x_dim

    \bool_if:NTF \l__crc_plot_show_labels_bool
      {
        % Show slanted labels with icons
        \node[
          anchor=south~west,
          rotate=\fp_use:N \l__crc_plot_event_rotation_fp,
          inner~sep=0pt,
          outer~sep=0pt,
          fill=white,
          crc~event/custom
        ]
        at (
          \prop_item:Nn \l__crc_plot_geometry_prop {#1/label-x},
          \prop_item:Nn \l__crc_plot_geometry_prop {#1/label-y}
        )
        {\box_use:c {l__crc_plot_label_#1_box}};
      }
      {
        % Hide slanted labels but keep icons
        \bool_if:NT \l__crc_plot_icons_bool
          {
            \node[
              anchor=south,
              inner~sep=0pt,
              outer~sep=0pt,
              text=\l__crc_event_color_tl
            ]
            at (
              \prop_item:Nn \l__crc_plot_geometry_prop {#1/label-x},
              \prop_item:Nn \l__crc_plot_geometry_prop {#1/label-y}
            )
            {\box_use:c {l__crc_plot_label_#1_box}};
          }
      }

    \str_if_eq:eeT
      {\prop_item:Nn \l__crc_plot_geometry_prop {#1/date-show}}
      {true}
      {
        \node[
          anchor=north~east,
          rotate=\fp_use:N \l__crc_plot_event_date_rotation_fp,
          inner~sep=0pt,
          outer~sep=0pt,
          text=EventMuted
        ]
        at (
          \dim_eval:n {\prop_item:Nn \l__crc_plot_geometry_prop {#1/date-x}-
                       \prop_item:Nn \l__crc_plot_geometry_prop {#1/date-connector-dx}},
          \dim_eval:n {\prop_item:Nn \l__crc_plot_geometry_prop {#1/date-y}-
                       \prop_item:Nn \l__crc_plot_geometry_prop {#1/date-connector-dy}}
        )
        {\box_use:c {l__crc_plot_date_#1_box}};
      }
    % A range that began before the selected year has a continuation arrow,
    % rather than an artificial event point at the start of January.
    \fp_compare:nT {\prop_item:Nn \l__crc_event_start_positions_prop {#1}>=\l__crc_plot_start_fp}

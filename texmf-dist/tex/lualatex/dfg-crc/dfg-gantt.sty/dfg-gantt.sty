\cs_new_protected:Npn \__dfggantt_validate_grid:
  {
    \bool_lazy_or:nnT
      {\int_compare_p:n {\l__dfggantt_slots_int < 1}}
      {\bool_lazy_or_p:nn
        {\int_compare_p:n {\l__dfggantt_first_quarter_int < 1}}
        {\int_compare_p:n {\l__dfggantt_first_quarter_int > 4}}}
      {\msg_error:nn {dfg-gantt}{bad-grid}
       \int_set:Nn \l__dfggantt_slots_int {16}
       \int_set:Nn \l__dfggantt_first_quarter_int {3}}
  }

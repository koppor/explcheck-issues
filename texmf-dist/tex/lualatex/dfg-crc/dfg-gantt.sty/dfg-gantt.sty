\NewDocumentCommand \DFGGanttTitles {}
  {
    \__dfggantt_validate_grid:
    \int_set_eq:NN \l__dfggantt_remaining_int \l__dfggantt_slots_int
    \int_set:Nn \l__dfggantt_group_int {5-\l__dfggantt_first_quarter_int}
    \int_set:Nn \l__dfggantt_year_int {1}
    \int_while_do:nn {\l__dfggantt_remaining_int > 0}
      {
        \int_set:Nn \l__dfggantt_group_int
          {\int_min:nn {\l__dfggantt_group_int}{\l__dfggantt_remaining_int}}
        \gantttitle[dfgTitleTopRule]
          {\int_compare:nNnTF {\clist_count:N \l__dfggantt_year_labels_clist}
            < {\l__dfggantt_year_int}
            {\dfgFundingYear{\int_use:N\l__dfggantt_year_int}}
            {\clist_item:Nn \l__dfggantt_year_labels_clist {\l__dfggantt_year_int}}}
          {\int_use:N\l__dfggantt_group_int}
        \int_sub:Nn \l__dfggantt_remaining_int {\l__dfggantt_group_int}
        \int_set:Nn \l__dfggantt_group_int {4}
        \int_incr:N \l__dfggantt_year_int
      }
    \ganttnewline
    \int_step_inline:nn {\l__dfggantt_slots_int}
      {
        \int_set:Nn \l__dfggantt_quarter_int
          {1+\int_mod:nn {\l__dfggantt_first_quarter_int+##1-2}{4}}
        \int_compare:nNnTF {\l__dfggantt_quarter_int}={4}
          {\gantttitle[dfgTitleBottomRightRule]
            {\dfgGanttShowQs{Q\int_use:N\l__dfggantt_quarter_int}{##1}}{1}}
          {\gantttitle[dfgTitleBottomRule]
            {\dfgGanttShowQs{Q\int_use:N\l__dfggantt_quarter_int}{##1}}{1}}
      }
    \ganttnewline
  }

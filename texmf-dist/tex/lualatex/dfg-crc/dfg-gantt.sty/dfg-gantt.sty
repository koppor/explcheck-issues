\cs_new_protected:Npn \__dfggantt_store:nnn #1#2#3
  {
    \__dfg_workpackage_normalize:n {#3}
    \keys_set:nn {dfggantt/record}{name={},description={},periodStart=1,periodEnd=1,style=default}
    \exp_args:NnV \keys_set:nn {dfggantt/record}\l__dfg_wp_normalized_tl
    \bool_set_true:N \l__dfggantt_valid_bool
    \exp_args:NnV \regex_match:nnF {\A\d+\Z}\l__dfggantt_start_tl
      {\bool_set_false:N \l__dfggantt_valid_bool}
    \exp_args:NnV \regex_match:nnF {\A\d+\Z}\l__dfggantt_end_tl
      {\bool_set_false:N \l__dfggantt_valid_bool}
    \bool_if:NT \l__dfggantt_valid_bool
      {\int_compare:nNnT {\l__dfggantt_start_tl}>{\l__dfggantt_end_tl}
        {\bool_set_false:N \l__dfggantt_valid_bool}}
    \bool_if:NTF \l__dfggantt_valid_bool
      {
        \DTLifdbexists{gantt-#1}{}{\DTLnewdb{gantt-#1}}
        \DTLnewrow{gantt-#1}
        \DTLnewdbentry{gantt-#1}{id}{#2}
        \clist_map_inline:nn {name,description,periodStart,periodEnd,style}
          {
            \str_case:nn {##1}
              {{name}{\tl_set_eq:NN \l_tmpa_tl \l__dfggantt_name_tl}
               {description}{\tl_set_eq:NN \l_tmpa_tl \l__dfggantt_description_tl}
               {periodStart}{\tl_set_eq:NN \l_tmpa_tl \l__dfggantt_start_tl}
               {periodEnd}{\tl_set_eq:NN \l_tmpa_tl \l__dfggantt_end_tl}
               {style}{\tl_set_eq:NN \l_tmpa_tl \l__dfggantt_style_tl}}
            \use:e {\exp_not:N\DTLnewdbentry{gantt-#1}{##1}{\exp_not:V\l_tmpa_tl}}
          }
      }
      {\msg_error:nne {dfg-gantt}{bad-range}{\l__dfggantt_start_tl--\l__dfggantt_end_tl}}
  }

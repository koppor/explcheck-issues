\newcommand{\crcDistributionBeginChart}[1]{%
  % Resolve automatic geometry after global and per-chart options are applied.
  \def\crcDistributionAutoRaise{auto}%
  \ifx\crcDistributionIconRaise\crcDistributionAutoRaise
    \ifcrcDistributionLabelLeft
      \def\crcDistributionEffectiveIconRaise{0pt}%
    \else
      \def\crcDistributionEffectiveIconRaise{2.3mm}%
    \fi
  \else
    \let\crcDistributionEffectiveIconRaise\crcDistributionIconRaise
  \fi
  \pgfmathsetlengthmacro{\crcDistributionHalfHeight}{.5*\crcDistributionBarHeight}%
  \pgfmathsetlengthmacro{\crcDistributionAxisTop}{\crcDistributionHalfHeight+\crcDistributionAxisPadding}%
  \pgfmathsetlengthmacro{\crcDistributionBottom}{-(#1-1)*\crcDistributionRowSpacing-\crcDistributionAxisTop}%
  \begin{tikzpicture}
}
\newcommand{\crcDistributionDrawRow}[5]{%
  % #1 label, #2 colour, #3 icon name, #4 count, #5 row index
  \pgfmathsetlengthmacro{\crcDistributionRowY}{-(#5-1)*\crcDistributionRowSpacing}%
  \pgfmathsetlengthmacro{\crcDistributionBarLength}{#4*\crcDistributionUnitWidth}%
  \pgfmathsetlengthmacro{\crcDistributionValueX}{\crcDistributionBarLength+\crcDistributionValueGap}%
  \begin{scope}[yshift=\crcDistributionRowY]
    \def\crcDistributionCurrentColor{#2}%
    \ifnum#4>0\relax
      \fill[#2] (0,-\crcDistributionHalfHeight)
        rectangle (\crcDistributionBarLength,\crcDistributionHalfHeight);
    \fi
    \ifnum#4>1\relax
      \edef\crcDistributionLastSeparator{\number\numexpr#4-1\relax}%
      \foreach \crcDistributionSegmentIndex in {1,...,\crcDistributionLastSeparator}{%
        \pgfmathsetlengthmacro{\crcDistributionSegmentX}{\crcDistributionSegmentIndex*\crcDistributionUnitWidth}%
        \draw[white,line width=\crcDistributionSeparatorWidth]
          (\crcDistributionSegmentX,-\crcDistributionHalfHeight)
          -- (\crcDistributionSegmentX,\crcDistributionHalfHeight);
      }%
    \fi
    \begin{scope}[shift={(\crcDistributionLabelX,\crcDistributionEffectiveIconRaise)},
                  x=\crcDistributionIconRadius,y=\crcDistributionIconRadius]
      \fill[#2] (0,0) circle[radius=\crcDistributionIconRadius];
      \csname crcDistributionIcon/#3\endcsname
    \end{scope}
    \ifcrcDistributionLabelLeft
      \pgfmathsetlengthmacro{\crcDistributionTextX}{\crcDistributionLabelX-\crcDistributionIconRadius-\crcDistributionLabelGap}%
      \node[anchor=east,font=\crcDistributionLabelFont,text=\crcDistributionTextColor,
            text width=\crcDistributionLabelWidth,align=right,inner sep=0pt,outer sep=0pt]
        at (\crcDistributionTextX,\crcDistributionEffectiveIconRaise) {#1};
    \else
      \node[font=\crcDistributionLabelFont,text=\crcDistributionTextColor,
            text width=\crcDistributionLabelWidth,align=center,inner sep=0pt]
        at (\crcDistributionLabelX,-\crcDistributionLabelDrop) {#1};
    \fi
    \node[anchor=west,font=\crcDistributionValueFont,text=\crcDistributionTextColor,
          inner sep=0pt,outer sep=0pt]
      at (\crcDistributionValueX,0) {#4};
  \end{scope}
}
\newcommand{\crcDistributionEndChart}{%
  \draw[\crcDistributionAxisColor,line width=\crcDistributionAxisWidth]
    (0,\crcDistributionAxisTop) -- (0,\crcDistributionBottom);
  \fill[\crcDistributionAxisColor] (0,\crcDistributionAxisTop)
    circle[radius=\crcDistributionDotRadius];
  \fill[\crcDistributionAxisColor] (0,\crcDistributionBottom)
    circle[radius=\crcDistributionDotRadius];
  \end{tikzpicture}%
}


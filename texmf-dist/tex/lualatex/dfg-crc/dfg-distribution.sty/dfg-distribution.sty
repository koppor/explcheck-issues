\prop_new:N \l__dc_values_prop
\prop_new:N \l__dc_candidate_prop
\clist_new:N \l__dc_order_clist
\clist_new:N \l__dc_candidate_order_clist
\seq_new:N \l__dc_seen_seq
\bool_new:N \l__dc_valid_bool
\int_new:N \l__dc_row_int
\tl_new:N \l__dc_label_tl
\tl_new:N \l__dc_color_tl
\tl_new:N \l__dc_icon_tl
\tl_new:N \l__dc_value_tl

\msg_new:nnn {distributionchart}{bad-input}
  {#1}
\cs_new_protected:Npn \__dc_error:n #1
  {
    \bool_set_false:N \l__dc_valid_bool
    \msg_error:nnn {distributionchart}{bad-input}{#1}
  }

\NewDocumentCommand \DeclareDistributionCategory {mmmm}
  {
    \cs_if_exist:cTF {crcDistributionIcon/#4}
      {
        \prop_if_in:NnF \l__dc_labels_prop {#1}
          {\clist_put_right:Nn \l__dc_order_clist {#1}}
        \prop_put:Nnn \l__dc_labels_prop {#1}{#2}
        \prop_put:Nnn \l__dc_colors_prop {#1}{#3}
        \prop_put:Nnn \l__dc_icons_prop {#1}{#4}
      }
      {\__dc_error:n {Unknown~icon~'#4'.~Declare~it~first.}}
  }

\cs_new_protected:Npn \crcDistributionSetOrder #1
  {
    \bool_set_true:N \l__dc_valid_bool
    \seq_clear:N \l__dc_seen_seq
    \clist_set:Nn \l__dc_candidate_order_clist {#1}
    \clist_if_empty:NT \l__dc_candidate_order_clist
      {\__dc_error:n {The~category~order~must~not~be~empty.}}
    \clist_map_inline:Nn \l__dc_candidate_order_clist
      {
        \prop_if_in:NnF \l__dc_labels_prop {##1}
          {\__dc_error:n {Unknown~category~'##1'~in~order.}}
        \seq_if_in:NnTF \l__dc_seen_seq {##1}
          {\__dc_error:n {Repeated~category~'##1'~in~order.}}
          {\seq_put_right:Nn \l__dc_seen_seq {##1}}
      }
    \bool_if:NT \l__dc_valid_bool
      {\clist_set_eq:NN \l__dc_order_clist \l__dc_candidate_order_clist}
  }

\cs_new_protected:Npn \__dc_missing_value:n #1
  {\__dc_error:n {Missing~count~for~'#1'.~Use~category=integer.}}
\cs_new_protected:Npn \__dc_set_pair:nn #1#2
  {
    \prop_if_in:NnTF \l__dc_labels_prop {#1}
      {
        \prop_if_in:NnTF \l__dc_candidate_prop {#1}
          {\__dc_error:n {Repeated~category~'#1'~in~the~data.}}
          {
            \regex_match:nnTF {\A[0-9]+\Z} {#2}
              {\prop_put:Nnx \l__dc_candidate_prop {#1}{\int_eval:n {#2}}}
              {\__dc_error:n {Count~for~'#1'~must~be~a~nonnegative~integer.}}
          }
      }
      {\__dc_error:n {Unknown~category~'#1'.~Declare~it~first.}}
  }
\NewDocumentCommand \setDistribution {m}
  {
    % Commit only a valid complete replacement; omitted categories become 0.
    \prop_clear:N \l__dc_candidate_prop
    \bool_set_true:N \l__dc_valid_bool
    \keyval_parse:NNn \__dc_missing_value:n \__dc_set_pair:nn {#1}
    \bool_if:NT \l__dc_valid_bool
      {\prop_set_eq:NN \l__dc_values_prop \l__dc_candidate_prop}
  }

\cs_new_protected:Npn \__dc_draw_row:n #1
  {
    \int_incr:N \l__dc_row_int
    \prop_get:NnN \l__dc_labels_prop {#1}\l__dc_label_tl
    \prop_get:NnN \l__dc_colors_prop {#1}\l__dc_color_tl
    \prop_get:NnN \l__dc_icons_prop {#1}\l__dc_icon_tl
    \prop_get:NnNTF \l__dc_values_prop {#1}\l__dc_value_tl
      {}{\tl_set:Nn \l__dc_value_tl {0}}
    \crcDistributionDrawRow
      {\l__dc_label_tl}{\l__dc_color_tl}{\l__dc_icon_tl}
      {\l__dc_value_tl}{\int_use:N \l__dc_row_int}
  }
\NewDocumentCommand \DistributionChart {O{}}
  {
    \group_begin:
      \distributionSetup{#1}
      \int_zero:N \l__dc_row_int
      \crcDistributionBeginChart{\clist_count:N \l__dc_order_clist}
        \clist_map_function:NN \l__dc_order_clist \__dc_draw_row:n
      \crcDistributionEndChart
    \group_end:
  }
\ExplSyntaxOff


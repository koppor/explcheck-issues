\box_new:N \g__dfg_thumb_shipout_box
\cs_new_protected:Npn \thumb_place_node:nnnn #1#2#3#4
{
  % Build in the running head to retain its fonts, colour and page style.
  \thumb_compute_height:
  \hbox_gset:Nn \g__dfg_thumb_shipout_box
  {
    \begin{tikzpicture}[overlay]
      \node[thumb,anchor=#1,rectangle,rounded~corners=7pt,xshift=#2]
        at (0,0)
      {
        \str_if_eq:nnTF {#1}{west}{\kern2mm}{\kern-2mm}
        \rotatebox[origin=c]{#3}{#4}
        \str_if_eq:nnTF {#1}{west}{\kern-2mm}{\kern2mm}
      };
    \end{tikzpicture}
  }
  % Freeze the page-edge coordinates; no previous-pass picture origin is used.
  \use:x
  {
    \exp_not:N \AddToHookNext {shipout/background}
    {
      \exp_not:N \put
        (\dim_eval:n {\str_if_eq:nnTF {#1}{west}{0pt}{\paperwidth}-\hoffset},
         \dim_eval:n {\voffset-\l_thumb_topmargin_dim
           -\l_thumb_height_dim*(\l_thumb_index_int-1)-\l_thumb_height_dim/2})
        {\exp_not:N\box_use_drop:N \exp_not:N\g__dfg_thumb_shipout_box}
    }
  }
}


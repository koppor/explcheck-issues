% Leerer „Geisterblock" zum handschriftlichen Ausfüllen
\cs_new_protected:Npn \__karol_bluecke:n #1
{
	\__karol_bdims:
	\dim_set:Nn \l__karol_bw_dim { #1 }
	\dim_set:Nn \l__karol_bh_dim
		{ \bool_if:NTF \l__karol_binline_bool { 1.20em } { 1.70em } }
	% Grundlinie wie bei einem beschrifteten Block: die Lücke sitzt mit
	% ihrer gedachten Textgrundlinie auf der Grundlinie des Fließtextes.
	\hbox_set:Nn \l__karol_btxt_box
		{ \__karol_blockfont: \__karol_bphantom: }
	\__karol_bbase_setzen:
	% Strichmuster in em rechnen, damit es mit der Blockgröße mitwächst —
	% ein festes 3pt-Muster ist für die knapp 2pt langen Kerbensegmente des
	% Inline-Blocks zu grob und zerreißt die Kontur.  em MUSS vorher ins
	% Register: im tikzpicture ist es 0pt.
	\dim_set:Nn \l__karol_bstr_dim { 0.17em }
	\dim_set:Nn \l__karol_bluk_dim { 0.13em }
	% Füllung: im Druck weiß statt hellgrau — der gestrichelte Rand sagt
	% schon alles, die Fläche wird ohnehin von Hand beschrieben.
	% (Der Test gehört NICHT in den TikZ-Schlüsselwert, siehe xcolor.)
	\bool_if:NTF \l__karol_druck_bool
		{ \tl_set:Nn \l__karol_bluf_tl { white } }
		{ \tl_set:Nn \l__karol_bluf_tl { black!6 } }
	\__karol_bemit:nN
	{
		\begin{tikzpicture}
			\useasboundingbox (0pt, 0pt) rectangle
				( \dim_use:N \l__karol_bw_dim ,
				  \__karol_bbbox:N \l__karol_bh_dim );
			\draw [ draw=black!55, line~width=.7pt,
			        dash~pattern=on~\l__karol_bstr_dim~off~\l__karol_bluk_dim,
			        line~join=round, line~cap=round,
			        fill=\l__karol_bluf_tl, rounded~corners=1.6pt ]
				\__karol_pfad_oben: \__karol_pfad_unten:n \l__karol_bh_dim ;
		\end{tikzpicture}
	}
	\l__karol_bh_dim
}
\NewDocumentCommand { \bluecke } { O{7em} }
	{ \__karol_bwrap:n { \__karol_bluecke:n {#1} } }

% ---------------------------------------------------------------------------
%  Inline-Blöcke für den Fließtext
% ---------------------------------------------------------------------------
%  Die \i…-Kommandos setzen genau einen Block in die laufende Zeile:
%  in der Schriftgröße des umgebenden Textes, mit dessen Grundlinie
%  bündig und mit knapperen Verzierungen als im Stapel.  Blöcke, die im
%  Stapel mehrzeilig wären (Schleifen, Verzweigungen, eigene Anweisungen),
%  erscheinen inline nur mit ihrem Kopf — \iwenndann{IstZiegel} ergibt
%  also den Block „wenn ⟨IstZiegel⟩ dann".  Für echte Rümpfe bleibt die
%  Umgebung karolbloecke zuständig.
%
%  Auch die \b…-Kommandos erkennen den Fließtext selbst und setzen dort
%  automatisch inline; die \i…-Fassungen ersparen nur die leeren
%  Rumpf-Argumente und erzwingen den Modus auch im Stapel.
% ---------------------------------------------------------------------------
\NewDocumentCommand { \ibefehl } { O{} m }
{
	\__karol_iwrap:n
	{
		\__karol_bblock:nn { karolBlockBefehl }
			{ #2 \tl_if_empty:nF {#1} { ~ \__karol_bpille:n {#1} } }
	}
}

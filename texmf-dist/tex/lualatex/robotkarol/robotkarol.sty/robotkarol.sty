}

% ---------------------------------------------------------------------------
%  Legende der Weltsymbole
% ---------------------------------------------------------------------------
% Ein Legendeneintrag: \karollegendenitem{Weltstring}{Beschriftung}
% Die Einträge sind bewusst klein skaliert: im Schrägbild der karolwelt
% braucht ein Feld mehr Fläche als in der früheren flachen Darstellung.
\newcommand{\karollegendenitem}[2]{%
	\mbox{\karolzeile[nummern=false, skalierung=0.42]{#1}\,#2}%
}
% Trenner mit viel Dehnung und leichtem Umbruchanreiz: die Legende ist
% breit und soll notfalls über mehrere Zeilen laufen statt überzustehen.
\newcommand{\karollegendentrenner}{%
	\penalty0\hskip 0.9em plus 2.5em minus .25em\relax}
\newcommand{\karollegende}{%
	\karollegendenitem{>}{Karol (Blickrichtung)}\karollegendentrenner
	\karollegendenitem{Z}{Ziegel}\karollegendentrenner
	\karollegendenitem{3}{Ziegelstapel}\karollegendentrenner
	\karollegendenitem{M}{Marke}\karollegendentrenner
	\karollegendenitem{{M>}}{Karol auf Marke}\karollegendentrenner
	\karollegendenitem{Q}{Quader\,/\,Wand}%
}

% ===========================================================================
%  5. Karol-Blöcke  (Blockprogrammierung wie in Robot Karol Online)
% ===========================================================================
%  Verwendung:
%      \begin{karolbloecke}[skalierung=1]
%          \bwiederholemal{5}{%
%              \bbefehl{Schritt}
%              \bbefehl{MarkeSetzen}}
%      \end{karolbloecke}
%
%      \bwiederholesolange{NichtIstWand}{…}
%      \bwenndann{IstZiegel}{…}
%      \bwenndannsonst{IstZiegel}{…}{…}
%      \bwiederholeimmer{…}
%      \bluecke[7em]              — leerer „Geisterblock" zum Ausfüllen
%      \bbedingung{IstZiegel}     — Sechseck, auch im Fließtext nutzbar
% ---------------------------------------------------------------------------
\ExplSyntaxOn

% --- Maße (bei jedem Rendern aus dem aktuellen em berechnet) ---------------
\dim_new:N \l__karol_bnd_dim    % Nasen-/Kerbentiefe
\dim_new:N \l__karol_bnx_dim    % Kerbe: Beginn
\dim_new:N \l__karol_bns_dim    % Kerbe: Schräge
\dim_new:N \l__karol_bnf_dim    % Kerbe: gerades Stück
\dim_new:N \l__karol_bpx_dim    % Innenabstand links/rechts
\dim_new:N \l__karol_bpt_dim    % Innenabstand oben (unter der Kerbe)
\dim_new:N \l__karol_bpb_dim    % Innenabstand unten
\dim_new:N \l__karol_bmw_dim    % Mindestbreite
\dim_new:N \l__karol_barm_dim   % Armbreite der C-Blöcke
\dim_new:N \l__karol_bfut_dim   % Fußhöhe der C-Blöcke
\dim_new:N \l__karol_bmm_dim    % Mindesthöhe eines Mauls
\dim_new:N \l__karol_bbase_dim  % Absenkung für die Grundlinienausrichtung
\tl_new:N  \l__karol_brc_tl     % Eckenradius (für TikZ-Schlüssel)
\dim_new:N \l__karol_brc_dim   % derselbe Wert zum Rechnen
\dim_new:N \l__karol_bkw_dim    % Strichstärke der Blockumrandung

% Inline-Modus: Blöcke im Fließtext.  Sie werden in der Schriftgröße des
% umgebenden Textes gesetzt, auf dessen Grundlinie ausgerichtet und mit
% kleineren „Verzierungen" (Kerbe, Nase, Innenabstände) versehen, damit
% ihre Höhe der Zeilenhöhe nahekommt.  Mehrzeilige Blöcke (C-/E-Blöcke)
% erscheinen inline nur mit ihrem Kopf.
\bool_new:N \l__karol_binline_bool   % aktuelle Ausgabe ist ein Inline-Block
\bool_new:N \l__karol_bimbau_bool    % wir stecken bereits in einem Block

\cs_new_protected:Npn \__karol_bdims:
{
	\bool_if:NTF \l__karol_binline_bool
	{	% --- Inline: flachere Kerbe, knappe Innenabstände, keine Mindestbreite
		\dim_set:Nn \l__karol_bnd_dim  { 0.12em }
		\dim_set:Nn \l__karol_bnx_dim  { 0.50em }
		\dim_set:Nn \l__karol_bns_dim  { 0.14em }
		\dim_set:Nn \l__karol_bnf_dim  { 0.45em }
		\dim_set:Nn \l__karol_bpx_dim  { 0.40em }
		\dim_set:Nn \l__karol_bpt_dim  { 0.08em }
		\dim_set:Nn \l__karol_bpb_dim  { 0.10em }
		\dim_zero:N \l__karol_bmw_dim
		\dim_set:Nn \l__karol_barm_dim { 0.70em }
		\dim_set:Nn \l__karol_bfut_dim { 0.40em }
		\dim_set:Nn \l__karol_bmm_dim  { 0.90em }
		\dim_set:Nn \l__karol_brc_dim  { 1.6pt }
	}
	{
		\dim_set:Nn \l__karol_bnd_dim  { 0.28em }
		\dim_set:Nn \l__karol_bnx_dim  { 0.75em }
		\dim_set:Nn \l__karol_bns_dim  { 0.26em }
		\dim_set:Nn \l__karol_bnf_dim  { 0.80em }
		\dim_set:Nn \l__karol_bpx_dim  { 0.60em }
		\dim_set:Nn \l__karol_bpt_dim  { 0.26em }
		\dim_set:Nn \l__karol_bpb_dim  { 0.30em }
		\dim_set:Nn \l__karol_bmw_dim  { 5.4em }
		\dim_set:Nn \l__karol_barm_dim { 1.05em }
		\dim_set:Nn \l__karol_bfut_dim { 0.62em }
		\dim_set:Nn \l__karol_bmm_dim  { 1.30em }
		\dim_set:Nn \l__karol_brc_dim  { 2pt }
	}
	\tl_set:Nx \l__karol_brc_tl { \dim_use:N \l__karol_brc_dim }
	% Umrandung: in der Oberfläche 3 px bei 110 px Blockhöhe, also gut
	% 2.7 % — bei den Maßen dieses Pakets rund ein halbes Punkt.  In em,
	% damit sie inline mitschrumpft.
	\dim_set:Nn \l__karol_bkw_dim { 0.045em }
	% Alle Blöcke werden jetzt umrandet, also brauchen ALLE die scharfen
	% Ecken an Kerbe und Nase: dort sind die Segmente kürzer als zwei
	% Eckradien, und pgf macht daraus sonst Spitzen (siehe \bluecke).
	\tl_set:Nn \l__karol_bkerbe_tl { [ sharp~corners ] }
	\tl_set:Nx \l__karol_bkante_tl
		{ [ rounded~corners = \l__karol_brc_tl ] }
}
% Farbe der Blockbeschriftung: weiß auf den kräftigen Flächen der
% Farbfassung, schwarz auf den hellen Graustufen des Druckmodus.
\cs_new_protected:Npn \__karol_bschriftfarbe:
{
	\bool_if:NTF \l__karol_druck_bool
		{ \color{black} } { \color{white} }
}
% Blockschrift: im Stapel \footnotesize, inline die Größe des Fließtextes
% Beschriftungen sind in Robot Karol Online normal gesetzt, nicht fett.
\cs_new_protected:Npn \__karol_blockfont:
{
	\__karol_textfont:
	\bool_if:NF \l__karol_binline_bool { \footnotesize }
}
% Höhenphantom der Beschriftung.  Im Stapel großzügig (Umlaut + Klammer),
% damit alle Blöcke exakt gleich hoch werden; inline knapp (Versalhöhe +
% Unterlänge), damit der Block die Zeilenhöhe nicht unnötig aufbläht.
\cs_new_protected:Npn \__karol_bphantom:
{
	\bool_if:NTF \l__karol_binline_bool
		{ \vphantom { Ag } } { \vphantom { Äg( } }
}
% Flachere Fassung für Bedingungsplättchen und Pillen: sie sitzen INNERHALB
% eines Blocks und dürfen ihn nicht unnötig aufblähen (keine Klammertiefe).
\cs_new_protected:Npn \__karol_bphantom_flach:
{
	\bool_if:NTF \l__karol_binline_bool
		{ \vphantom { Ag } } { \vphantom { Äg } }
}

% Beginn eines Nutzerblocks: Inline-Modus bestimmen und merken, dass wir
% ab jetzt im Blockbau sind (verschachtelte \bbedingung/Pillen erben ihn).
\cs_new_protected:Npn \__karol_bstart:
{
	\bool_if:NF \l__karol_bimbau_bool
	{
		\mode_if_horizontal:TF
			{ \bool_set_true:N  \l__karol_binline_bool }
			{ \bool_set_false:N \l__karol_binline_bool }
	}
	\bool_set_true:N \l__karol_bimbau_bool
}
% Wie \__karol_bstart:, aber erzwingt den Inline-Modus (\i…-Kommandos)
\cs_new_protected:Npn \__karol_bstart_inline:
{
	\bool_if:NF \l__karol_bimbau_bool
		{ \bool_set_true:N \l__karol_binline_bool }
	\bool_set_true:N \l__karol_bimbau_bool
	\mode_leave_vertical:
}

% Block ausgeben: im Stapel als bündige Zeile; inline so abgesenkt, dass
% die Textgrundlinie des Blocks auf der Grundlinie des Fließtextes liegt.
% (Die Bild-Grundlinie liegt an der Blockunterkante, ht = #2, dp = 0; die
% Beschriftung sitzt um Textunterlänge + Fußabstand darüber.)
% #1 = Inhalt, #2 = Gesamthöhen-Variable
\cs_new_protected:Npn \__karol_bemit:nN #1#2
{
	\bool_if:NTF \l__karol_binline_bool
	{
		\mode_leave_vertical:
		\raisebox { -\l__karol_bbase_dim } { \hbox:n { #1 } }
	}
	{ \hbox:n { #1 } }
}

% Arbeitsregister
\box_new:N \l__karol_btxt_box
\box_new:N \l__karol_bbody_box
\box_new:N \l__karol_belse_box
\box_new:N \l__karol_bsonst_box
\dim_new:N \l__karol_bw_dim     % Blockbreite
\dim_new:N \l__karol_bh_dim     % Kopfhöhe
\dim_new:N \l__karol_bm_dim     % Maulhöhe
\dim_new:N \l__karol_bmzwei_dim    % Maulhöhe (sonst-Zweig)
\dim_new:N \l__karol_bs_dim     % Höhe des sonst-Balkens
\dim_new:N \l__karol_bt_dim     % Gesamthöhe
\dim_new:N \l__karol_bbw_dim    % Breite der Gesamt-Boundingbox

% --- Stapel-Umgebung -------------------------------------------------------
% Innerhalb des Stapels: Kästen bündig ohne Zwischenraum übereinander.
\cs_new_protected:Npn \__karol_stapelmodus:
{
	% Im Stapel wird nie inline gesetzt — auch nicht, wenn der umgebende
	% Block inline war.  Damit erben Rümpfe stets die Stapel-Optik.
	\bool_set_false:N \l__karol_binline_bool
	\bool_set_false:N \l__karol_bimbau_bool
	\skip_zero:N \parskip
	\dim_zero:N \parindent
	\skip_set:Nn \baselineskip { 0pt }
	\dim_zero:N \lineskip
	\dim_set:Nn \lineskiplimit { \maxdimen }
}
\tl_new:N \l__karol_bskal_tl
\keys_define:nn { karol / bloecke }
{
	skalierung .tl_set:N  = \l__karol_bskal_tl,
	skalierung .initial:n = { 1 },
}
\box_new:N \l__karol_bstapel_box
\NewDocumentEnvironment { karolbloecke } { O{} }
{
	\keys_set:nn { karol / bloecke } { #1 }
	\vbox_set:Nw \l__karol_bstapel_box
	\__karol_stapelmodus:
}
{
	\vbox_set_end:
	\mode_leave_vertical:
	\hbox:n
	{
		\exp_args:NV \scalebox \l__karol_bskal_tl
			{ \box_use:N \l__karol_bstapel_box }
	}
}

% --- Kerbenpfade -----------------------------------------------------------
% Eckenmodus an Kerbe und Nase.  Gefüllte Blöcke zeichnen die Kontur nicht
% (draw=none), dort bleiben beide Marken leer und der Pfad ist unverändert.
% Der Geisterblock \bluecke STRICHELT die Kontur — und dort sind die
% Kerbensegmente kürzer als zwei Eckradien: inline ist die Schräge rund
% 2.0pt lang, zwei Radien à 1.6pt brauchen 3.2pt.  pgf erzeugt daraus einen
% entarteten Bogen, der als Spitze aus der Kontur schießt.  Deshalb setzt
% \bluecke an Kerbe und Nase auf scharfe Ecken und rundet nur die vier
% Außenecken.
\tl_new:N \l__karol_bkerbe_tl   % vor der Kerbe/Nase einzufügen
\tl_new:N \l__karol_bkante_tl   % danach wieder einzufügen
\dim_new:N \l__karol_bstr_dim   % Geisterblock: Strichlänge
\dim_new:N \l__karol_bluk_dim   % Geisterblock: Lückenlänge
\tl_new:N  \l__karol_bluf_tl    % Geisterblock: Füllfarbe

% Obere Kante mit Kerbe, von (0,0) bis (W,0).  Der Rumpf ohne den
% Startpunkt wird auch von der hellen Kante gebraucht, die schon an der
% linken Seite beginnt.
\cs_new:Npn \__karol_pfad_oben:
	{ (0pt, 0pt) \__karol_pfad_oben_ab: }
\cs_new:Npn \__karol_pfad_oben_ab:
{
	\l__karol_bkerbe_tl
	-- ( \dim_use:N \l__karol_bnx_dim , 0pt )
	-- ( \dim_eval:n { \l__karol_bnx_dim + \l__karol_bns_dim },
	     -\dim_use:N \l__karol_bnd_dim )
	-- ( \dim_eval:n { \l__karol_bnx_dim + \l__karol_bns_dim + \l__karol_bnf_dim },
	     -\dim_use:N \l__karol_bnd_dim )
	-- ( \dim_eval:n { \l__karol_bnx_dim + 2\l__karol_bns_dim + \l__karol_bnf_dim },
	     0pt )
	\l__karol_bkante_tl
	-- ( \dim_use:N \l__karol_bw_dim , 0pt )
}
% Untere Kante mit Nase, von (W,-#1) zurück bis (0,-#1):
\cs_new:Npn \__karol_pfad_unten:n #1
{
	-- ( \dim_use:N \l__karol_bw_dim , \dim_eval:n { 0pt-(#1) } )
	\l__karol_bkerbe_tl
	-- ( \dim_eval:n { \l__karol_bnx_dim + 2\l__karol_bns_dim + \l__karol_bnf_dim },
	     \dim_eval:n { 0pt-(#1) } )
	-- ( \dim_eval:n { \l__karol_bnx_dim + \l__karol_bns_dim + \l__karol_bnf_dim },
	     \dim_eval:n { 0pt-(#1) - \l__karol_bnd_dim } )
	-- ( \dim_eval:n { \l__karol_bnx_dim + \l__karol_bns_dim },
	     \dim_eval:n { 0pt-(#1) - \l__karol_bnd_dim } )
	-- ( \dim_use:N \l__karol_bnx_dim , \dim_eval:n { 0pt-(#1) } )
	\l__karol_bkante_tl
	-- ( 0pt , \dim_eval:n { 0pt-(#1) } )
	-- cycle
}
% Maulöffnung an der Kopf-/Balkenunterkante bei y = -#1
% (von rechts nach links; Nase zeigt ins Maul):
\cs_new:Npn \__karol_pfad_maul_auf:n #1
{
	-- ( \dim_use:N \l__karol_bw_dim , \dim_eval:n { 0pt-(#1) } )
	\l__karol_bkerbe_tl
	-- ( \dim_eval:n { \l__karol_barm_dim + \l__karol_bnx_dim
	                   + 2\l__karol_bns_dim + \l__karol_bnf_dim },
	     \dim_eval:n { 0pt-(#1) } )
	-- ( \dim_eval:n { \l__karol_barm_dim + \l__karol_bnx_dim
	                   + \l__karol_bns_dim + \l__karol_bnf_dim },
	     \dim_eval:n { 0pt-(#1) - \l__karol_bnd_dim } )
	-- ( \dim_eval:n { \l__karol_barm_dim + \l__karol_bnx_dim
	                   + \l__karol_bns_dim },
	     \dim_eval:n { 0pt-(#1) - \l__karol_bnd_dim } )
	-- ( \dim_eval:n { \l__karol_barm_dim + \l__karol_bnx_dim },
	     \dim_eval:n { 0pt-(#1) } )
	\l__karol_bkante_tl
	-- ( \dim_use:N \l__karol_barm_dim , \dim_eval:n { 0pt-(#1) } )
}
% Maulschluss an der Fuß-/Balkenoberkante bei y = -#1
% (von links nach rechts; Kerbe nimmt die Nase des letzten Blocks auf):
\cs_new:Npn \__karol_pfad_maul_zu:n #1
{
	-- ( \dim_use:N \l__karol_barm_dim , \dim_eval:n { 0pt-(#1) } )
	\l__karol_bkerbe_tl
	-- ( \dim_eval:n { \l__karol_barm_dim + \l__karol_bnx_dim },
	     \dim_eval:n { 0pt-(#1) } )
	-- ( \dim_eval:n { \l__karol_barm_dim + \l__karol_bnx_dim
	                   + \l__karol_bns_dim },
	     \dim_eval:n { 0pt-(#1) - \l__karol_bnd_dim } )
	-- ( \dim_eval:n { \l__karol_barm_dim + \l__karol_bnx_dim
	                   + \l__karol_bns_dim + \l__karol_bnf_dim },
	     \dim_eval:n { 0pt-(#1) - \l__karol_bnd_dim } )
	-- ( \dim_eval:n { \l__karol_barm_dim + \l__karol_bnx_dim
	                   + 2\l__karol_bns_dim + \l__karol_bnf_dim },
	     \dim_eval:n { 0pt-(#1) } )
	\l__karol_bkante_tl
	-- ( \dim_use:N \l__karol_bw_dim , \dim_eval:n { 0pt-(#1) } )
}

% --- Kopftext ausmessen, Breite/Kopfhöhe setzen ----------------------------
\cs_new_protected:Npn \__karol_bmess:n #1
{
	\__karol_bdims:
	\hbox_set:Nn \l__karol_btxt_box
		{ \__karol_blockfont: \__karol_bschriftfarbe: \__karol_bphantom: #1 }
	\dim_set:Nn \l__karol_bw_dim
		{ \box_wd:N \l__karol_btxt_box + 2 \l__karol_bpx_dim }
	\dim_compare:nT { \l__karol_bw_dim < \l__karol_bmw_dim }
		{ \dim_set_eq:NN \l__karol_bw_dim \l__karol_bmw_dim }
	\dim_set:Nn \l__karol_bh_dim
	{
		\l__karol_bnd_dim + \l__karol_bpt_dim
		+ \box_ht:N \l__karol_btxt_box + \box_dp:N \l__karol_btxt_box
		+ \l__karol_bpb_dim
	}
	\__karol_bbase_setzen:
}
% Abstand von der Unterkante der Boundingbox (= Bild-Grundlinie) hinauf zur
% Textgrundlinie im Block.  \raisebox{-\l__karol_bbase_dim} legt beide
% Grundlinien im Fließtext exakt übereinander.  Inline zählt die Nase zur
% Boundingbox (siehe \__karol_bbbox:N) und damit auch hier mit.
\cs_new_protected:Npn \__karol_bbase_setzen:
{
	\dim_set:Nn \l__karol_bbase_dim
		{ \box_dp:N \l__karol_btxt_box + \l__karol_bpb_dim }
	\bool_if:NT \l__karol_binline_bool
		{ \dim_add:Nn \l__karol_bbase_dim { \l__karol_bnd_dim } }
}
% Untere Kante der Boundingbox eines Blocks der Höhe #1.  Im Stapel endet
% sie an der Blockunterkante (die Nase ragt heraus und greift in den
% Folgeblock); inline zählt die Nase mit, damit TeX den Zeilenabstand
% richtig bemisst und nichts in die nächste Zeile ragt.
\cs_new:Npn \__karol_bbbox:N #1
{
	\bool_if:NTF \l__karol_binline_bool
		{ \dim_eval:n { 0pt - #1 - \l__karol_bnd_dim } }
		{ \dim_eval:n { 0pt - #1 } }
}
% Kopftext in den Block setzen (Grundlinie unterhalb der Kerbe)
% Achtung: die Box MUSS vor dem tikzpicture gefüllt werden (nullfont!)
\cs_new_protected:Npn \__karol_btxt_setzen:n #1
	{ \__karol_btext_at:nN {#1} \l__karol_btxt_box }
\cs_new_protected:Npn \__karol_btext_at:nN #1#2  % #1 = y-Offset, #2 = Box
{
	\node [ anchor=base~west, inner~sep=0pt ]
		at ( \dim_use:N \l__karol_bpx_dim ,
		     \dim_eval:n { 0pt-(#1) - \l__karol_bnd_dim - \l__karol_bpt_dim
		                   - \box_ht:N #2 } )
		{ \box_use:N #2 };
}

% --- Blockfläche mit Anschliff ---------------------------------------------
% Robot Karol Online setzt einen gewöhnlichen 3D-Anschliff ein: jede nach
% oben oder links zeigende Kante ist aufgehellt, jede nach unten oder
% rechts zeigende abgedunkelt.  Wichtig daran ist vor allem, dass
% gleichfarbige Blöcke voneinander abgesetzt sind — ein grüner wenn-Block
% in einer grünen Schleife wäre sonst nicht zu erkennen.
%
% Statt die Kontur in helle und dunkle Teilstücke zu zerlegen (fehler-
% anfällig an Ecken, Kerbe, Nase und Maul), wird der Effekt so erzeugt,
% wie er physikalisch entsteht:
%
%   1. Auf die Fläche BESCHNEIDEN.  Dadurch liegt jeder Strich vollständig
%      INNERHALB des Blocks — Blöcke können sich nicht mehr überlagern und
%      passen exakt ineinander.
%   2. Den kompletten Rand hell zeichnen.
%   3. Denselben Rand dunkel darüber, um eine Strichstärke nach links oben
%      versetzt: an nach unten und rechts zeigenden Kanten rutscht er ins
%      Innere und deckt das Helle ab, an nach oben und links zeigenden aus
%      der Fläche heraus, wo der Beschnitt ihn entfernt.  Schräge Kanten
%      bekommen automatisch den passenden Zwischenwert.
%
% Weil beide Striche denselben Pfad benutzen, folgen sie der Blockform in
% jedem Detail — Rundungen, Kerbe, Nase und Maulöffnungen inbegriffen.
% Die doppelte Strichstärke ist Absicht: der Beschnitt halbiert sie.
%   #1 = Blockfarbe, #2 = geschlossener Pfad der Blockform
\cs_new_protected:Npn \__karol_brand:nn #1#2
{
	\bool_if:NTF \l__karol_druck_bool
		{ \__karol_brand_druck:nn {#1} {#2} }
		{ \__karol_brand_farbe:nn {#1} {#2} }
}
% Druckmodus: an die Stelle des Anschliffs tritt eine schwarze Kontur.
% Die Blockfarben sind hier helle Graustufen — aus ihnen ließe sich kein
% sichtbarer Hell-Dunkel-Verlauf mehr gewinnen, wohl aber verlöre ein
% weißer Block ohne Kontur jede Form.  Beschnitten wird wie beim
% Anschliff, damit die Kontur ganz INNERHALB des Blocks liegt und
% gestapelte Blöcke sich nicht gegenseitig überzeichnen; die doppelte
% Strichstärke gleicht die Halbierung durch den Beschnitt aus.
%
% Die Fläche wird hier NICHT nach außen überzeichnet (in der Farbfassung
% 0.1pt gegen den Antialiasing-Saum): eine weiße Blockfläche würde sonst
% die Kontur des darüberliegenden Blocks anknabbern.  Nötig ist die
% Überzeichnung im Druck auch nicht — die Kontur deckt die Fuge ab.
\cs_new_protected:Npn \__karol_brand_druck:nn #1#2
{
	\fill [ #1, line~join = round, rounded~corners = \l__karol_brc_tl ]
		#2 ;
	\begin{scope}
		\clip [ rounded~corners = \l__karol_brc_tl ] #2 ;
		\draw [ draw = karolDruckKontur,
		        line~width = \dim_eval:n { 2.6 \l__karol_bkw_dim },
		        line~join = round, rounded~corners = \l__karol_brc_tl ]
			#2 ;
	\end{scope}
}
\cs_new_protected:Npn \__karol_brand_farbe:nn #1#2
{
	% Die Fläche einen Hauch überzeichnen (0.1pt nach außen).  Zwei exakt
	% aneinanderstoßende Flächen hinterlassen sonst einen hellen
	% Antialiasing-Saum — sichtbar dort, wo die Nase eines Blocks in der
	% Kerbe des nächsten sitzt.  Der Anschliff bleibt davon unberührt, er
	% wird auf den ungewachsenen Pfad beschnitten.
	\draw [ fill = #1, draw = #1, line~width = 0.2pt,
	        line~join = round, rounded~corners = \l__karol_brc_tl ]
		#2 ;
	\begin{scope}
		\clip [ rounded~corners = \l__karol_brc_tl ] #2 ;
		\draw [ fill = #1, draw = #1!70!white,
		        line~width = \dim_eval:n { 2 \l__karol_bkw_dim },
		        line~join = round, rounded~corners = \l__karol_brc_tl ]
			#2 ;
		\draw [ draw = #1!80!black,
		        line~width = \dim_eval:n { 2 \l__karol_bkw_dim },
		        line~join = round, rounded~corners = \l__karol_brc_tl,
		        xshift = -\dim_use:N \l__karol_bkw_dim,
		        yshift = \dim_use:N \l__karol_bkw_dim ]
			#2 ;
	\end{scope}
}

% --- Einfacher Anweisungsblock ---------------------------------------------
% #1 = Farbname   #2 = Beschriftung
\cs_new_protected:Npn \__karol_bblock:nn #1#2
{
	\tl_set:Nn \l__karol_bfarbe_tl {#1}
	\__karol_bmess:n {#2}
	\__karol_bemit:nN
	{
		\begin{tikzpicture}
			\useasboundingbox (0pt, 0pt) rectangle
				( \dim_use:N \l__karol_bw_dim ,
				  \__karol_bbbox:N \l__karol_bh_dim );
			\__karol_brand:nn {#1}
				{ \__karol_pfad_oben:
				  \__karol_pfad_unten:n \l__karol_bh_dim }
			\__karol_btxt_setzen:n { 0pt }
		\end{tikzpicture}
	}
	\l__karol_bh_dim
}

% --- C-Block (eine Maulöffnung) --------------------------------------------
% #1 = Farbname   #2 = Kopfbeschriftung   #3 = Rumpf
\cs_new_protected:Npn \__karol_bcblock:nnn #1#2#3
{
	% Inline gibt es keine Maulöffnung: nur der Kopf wird gesetzt.
	\bool_if:NTF \l__karol_binline_bool
		{ \__karol_bblock:nn      {#1} {#2}      }
		{ \__karol_bcblock_voll:nnn {#1} {#2} {#3} }
}
\cs_new_protected:Npn \__karol_bcblock_voll:nnn #1#2#3
{
	\tl_set:Nn \l__karol_bfarbe_tl {#1}
	\vbox_set:Nn \l__karol_bbody_box { \__karol_stapelmodus: #3 }
	\__karol_bmess:n {#2}
	\dim_set:Nn \l__karol_bm_dim
		{ \box_ht:N \l__karol_bbody_box + \box_dp:N \l__karol_bbody_box }
	\dim_compare:nT { \l__karol_bm_dim < \l__karol_bmm_dim }
		{ \dim_set_eq:NN \l__karol_bm_dim \l__karol_bmm_dim }
	\dim_set:Nn \l__karol_bt_dim
		{ \l__karol_bh_dim + \l__karol_bm_dim + \l__karol_bfut_dim }
	\dim_set:Nn \l__karol_bbw_dim
		{ \l__karol_barm_dim + \box_wd:N \l__karol_bbody_box + 0.4em }
	\dim_compare:nT { \l__karol_bbw_dim < \l__karol_bw_dim }
		{ \dim_set_eq:NN \l__karol_bbw_dim \l__karol_bw_dim }
	\__karol_bemit:nN
	{
		\begin{tikzpicture}
			\useasboundingbox (0pt, 0pt) rectangle
				( \dim_use:N \l__karol_bbw_dim , -\dim_use:N \l__karol_bt_dim );
			\__karol_brand:nn {#1}
			{
				\__karol_pfad_oben:
				\__karol_pfad_maul_auf:n \l__karol_bh_dim
				-- ( \dim_use:N \l__karol_barm_dim ,
				     \dim_eval:n { - \l__karol_bh_dim - \l__karol_bm_dim } )
				\__karol_pfad_maul_zu:n
					{ \dim_eval:n { \l__karol_bh_dim + \l__karol_bm_dim } }
				\__karol_pfad_unten:n \l__karol_bt_dim
			}
			\__karol_btxt_setzen:n { 0pt }
			\node [ anchor=north~west, inner~sep=0pt ]
				at ( \dim_use:N \l__karol_barm_dim ,
				     -\dim_use:N \l__karol_bh_dim )
				{ \box_use:N \l__karol_bbody_box };
		\end{tikzpicture}
	}
	\l__karol_bt_dim
}

% Mittelteil des E-Blocks (beide Mäuler und der sonst-Balken).  Fläche und
% dunkle Kante brauchen ihn gleichermaßen.
\cs_new:Npn \__karol_beblock_rumpf:
{
	\__karol_pfad_maul_auf:n \l__karol_bh_dim
	-- ( \dim_use:N \l__karol_barm_dim ,
	     \dim_eval:n { - \l__karol_bh_dim - \l__karol_bm_dim } )
	\__karol_pfad_maul_zu:n
		{ \dim_eval:n { \l__karol_bh_dim + \l__karol_bm_dim } }
	\__karol_pfad_maul_auf:n
		{ \dim_eval:n { \l__karol_bh_dim + \l__karol_bm_dim
		                + \l__karol_bs_dim } }
	-- ( \dim_use:N \l__karol_barm_dim ,
	     \dim_eval:n { - \l__karol_bh_dim - \l__karol_bm_dim
	                   - \l__karol_bs_dim - \l__karol_bmzwei_dim } )
	\__karol_pfad_maul_zu:n
		{ \dim_eval:n { \l__karol_bh_dim + \l__karol_bm_dim
		                + \l__karol_bs_dim + \l__karol_bmzwei_dim } }
}

% --- E-Block (wenn … dann … sonst …) ---------------------------------------
% #1 = Farbname  #2 = Kopf  #3 = dann-Rumpf  #4 = sonst-Rumpf
\cs_new_protected:Npn \__karol_beblock:nnnn #1#2#3#4
{
	% Inline gibt es keine Maulöffnungen: nur der Kopf wird gesetzt.
	\bool_if:NTF \l__karol_binline_bool
		{ \__karol_bblock:nn        {#1} {#2}           }
		{ \__karol_beblock_voll:nnnn {#1} {#2} {#3} {#4} }
}
\cs_new_protected:Npn \__karol_beblock_voll:nnnn #1#2#3#4
{
	\tl_set:Nn \l__karol_bfarbe_tl {#1}
	\vbox_set:Nn \l__karol_bbody_box { \__karol_stapelmodus: #3 }
	\vbox_set:Nn \l__karol_belse_box { \__karol_stapelmodus: #4 }
	\__karol_bmess:n {#2}
	% Höhe des sonst-Balkens aus seiner Beschriftung
	\hbox_set:Nn \l__karol_bsonst_box
		{ \__karol_blockfont: \__karol_bschriftfarbe: \__karol_bphantom: sonst }
	\dim_set:Nn \l__karol_bs_dim
	{
		\l__karol_bnd_dim + \l__karol_bpt_dim
		+ \box_ht:N \l__karol_bsonst_box + \box_dp:N \l__karol_bsonst_box
		+ \l__karol_bpb_dim
	}
	\dim_set:Nn \l__karol_bm_dim
		{ \box_ht:N \l__karol_bbody_box + \box_dp:N \l__karol_bbody_box }
	\dim_compare:nT { \l__karol_bm_dim < \l__karol_bmm_dim }
		{ \dim_set_eq:NN \l__karol_bm_dim \l__karol_bmm_dim }
	\dim_set:Nn \l__karol_bmzwei_dim
		{ \box_ht:N \l__karol_belse_box + \box_dp:N \l__karol_belse_box }
	\dim_compare:nT { \l__karol_bmzwei_dim < \l__karol_bmm_dim }
		{ \dim_set_eq:NN \l__karol_bmzwei_dim \l__karol_bmm_dim }
	\dim_set:Nn \l__karol_bt_dim
	{
		\l__karol_bh_dim + \l__karol_bm_dim + \l__karol_bs_dim
		+ \l__karol_bmzwei_dim + \l__karol_bfut_dim
	}
	\dim_set:Nn \l__karol_bbw_dim
		{ \l__karol_barm_dim + \box_wd:N \l__karol_bbody_box + 0.4em }
	\dim_compare:nT { \l__karol_bbw_dim < \l__karol_bw_dim }
		{ \dim_set_eq:NN \l__karol_bbw_dim \l__karol_bw_dim }
	\dim_compare:nT
		{ \l__karol_bbw_dim < \l__karol_barm_dim + \box_wd:N \l__karol_belse_box }
		{ \dim_set:Nn \l__karol_bbw_dim
			{ \l__karol_barm_dim + \box_wd:N \l__karol_belse_box + 0.4em } }
	\__karol_bemit:nN
	{
		\begin{tikzpicture}
			\useasboundingbox (0pt, 0pt) rectangle
				( \dim_use:N \l__karol_bbw_dim , -\dim_use:N \l__karol_bt_dim );
			\__karol_brand:nn {#1}
			{
				\__karol_pfad_oben:
				\__karol_beblock_rumpf:
				\__karol_pfad_unten:n \l__karol_bt_dim
			}
			\__karol_btxt_setzen:n { 0pt }
			% sonst-Beschriftung (Box wurde VOR dem Bild gefüllt)
			\__karol_btext_at:nN
				{ \dim_eval:n { \l__karol_bh_dim + \l__karol_bm_dim } }
				\l__karol_bsonst_box
			% Rümpfe
			\node [ anchor=north~west, inner~sep=0pt ]
				at ( \dim_use:N \l__karol_barm_dim ,
				     -\dim_use:N \l__karol_bh_dim )
				{ \box_use:N \l__karol_bbody_box };
			\node [ anchor=north~west, inner~sep=0pt ]
				at ( \dim_use:N \l__karol_barm_dim ,
				     \dim_eval:n { - \l__karol_bh_dim - \l__karol_bm_dim
				                   - \l__karol_bs_dim } )
				{ \box_use:N \l__karol_belse_box };
		\end{tikzpicture}
	}
	\l__karol_bt_dim
}

% --- Eingabefelder: Zahl (Pille) und Bedingung (Sechseck) ------------------
% Aktuelle Blockfarbe (für Pillen-Tönung), von den Buildern gesetzt
\tl_new:N \l__karol_bfarbe_tl
\tl_set:Nn \l__karol_bfarbe_tl { karolBlockBefehl }
% Pille: blasse Tönung der Blockfarbe, dunkle Schrift (wie Karol Online)
\dim_new:N \l__karol_bpxs_dim   % Pille: Innenabstand waagerecht
\dim_new:N \l__karol_bpys_dim   % Pille: Innenabstand senkrecht
\dim_new:N \l__karol_bpmw_dim   % Pille: Mindestbreite
\box_new:N \l__karol_bptxt_box  % Pillenbeschriftung
\box_new:N \l__karol_bpinh_box  % Pilleninhalt (Beschriftung + Platz fürs Dreieck)
\dim_new:N \l__karol_bph_dim    % Pillenhöhe
\dim_new:N \l__karol_bptri_dim  % Auswahldreieck: Seitenlänge
\dim_new:N \l__karol_bpgap_dim  % Auswahldreieck: Lücke zum Text
\dim_new:N \l__karol_bpby_dim   % Auswahldreieck: Spitze über der Grundlinie
\tl_new:N  \l__karol_bpdreieck_tl  % Farbe des Auswahldreiecks

% Verhältnisse des Auswahldreiecks, gemessen an der Oberfläche von Robot
% Karol Online (Pillenhöhe H = 83 px):  Seitenlänge 27 px = 0.325 H,
% Lücke Text->Dreieck 22 px = 0.265 H, und die Spitze steht praktisch auf
% der Textgrundlinie (2 px darüber = 0.024 H).  Das Dreieck hat die VOLLE
% Blockfarbe, nicht die aufgehellte der Pille.
\fp_const:Nn \c__karol_btri_fp     { 0.325 }
% 0.265 ist im Original der Abstand von der TINTE des letzten Buchstabens;
% hier wird ab der Textbox gemessen, deren rechte Kante die Seitenbreite
% des Glyphen schon enthält (~0.09 H).  Deshalb der kleinere Wert.
\fp_const:Nn \c__karol_btrigap_fp  { 0.19 }
\fp_const:Nn \c__karol_btribas_fp  { 0.024 }

% #1 = Auswahldreieck ja/nein (Boolean-Ausdruck), #2 = Beschriftung
\cs_new_protected:Npn \__karol_bpille_aux:nn #1#2
{
	\bool_if:NTF \l__karol_binline_bool
	{
		\dim_set:Nn \l__karol_bpxs_dim { 0.22em }
		\dim_set:Nn \l__karol_bpys_dim { 0.08em }
		\dim_set:Nn \l__karol_bpmw_dim { 0.85em }
	}
	{
		\dim_set:Nn \l__karol_bpxs_dim { 0.26em }
		\dim_set:Nn \l__karol_bpys_dim { 0.14em }
		\dim_set:Nn \l__karol_bpmw_dim { 1.05em }
	}
	% Beschriftung VOR dem Bild setzen (im tikzpicture gilt \nullfont) und
	% daraus die Pillenhöhe bestimmen; em-Maße müssen ohnehin vorher in
	% Register, im Bild sind sie 0pt.
	\hbox_set:Nn \l__karol_bptxt_box
	{
		\normalfont \__karol_textfont: \color{black}
		\bool_if:NF \l__karol_binline_bool { \footnotesize }
		\__karol_bphantom_flach: #2
	}
	\dim_set:Nn \l__karol_bph_dim
	{
		\box_ht:N \l__karol_bptxt_box + \box_dp:N \l__karol_bptxt_box
		+ 2 \l__karol_bpys_dim
	}
	\bool_if:nTF { #1 }
	{
		\dim_set:Nn \l__karol_bptri_dim
			{ \fp_to_dim:n { \c__karol_btri_fp * \l__karol_bph_dim } }
		\dim_set:Nn \l__karol_bpgap_dim
			{ \fp_to_dim:n { \c__karol_btrigap_fp * \l__karol_bph_dim } }
		\dim_set:Nn \l__karol_bpby_dim
			{ \fp_to_dim:n { \c__karol_btribas_fp * \l__karol_bph_dim } }
	}
	{
		\dim_zero:N \l__karol_bptri_dim
		\dim_zero:N \l__karol_bpgap_dim
		\dim_zero:N \l__karol_bpby_dim
	}
	% Im Farbmodus hebt sich die Pille durch ihre Tönung vom Block ab und
	% braucht keinen Rand.  Im Druck ist sie auf einem weißen \bbefehl
	% selbst weiß — dort trägt erst die Kontur die Information, dass hier
	% ein Eingabefeld sitzt.  Das Auswahldreieck hätte aus demselben Grund
	% keine Farbe mehr und bekommt einen festen Grauwert.
	% Das Auswahldreieck hat im Druck keine Blockfarbe mehr (der \bbefehl
	% ist dort weiß) und bekommt einen festen Grauwert.
	\tl_set_eq:NN \l__karol_bpdreieck_tl \l__karol_bfarbe_tl
	\bool_if:NT \l__karol_druck_bool
		{ \tl_set:Nn \l__karol_bpdreieck_tl { karolDruckAkzent } }
	% Platz für Lücke und Dreieck FEST in eine Box backen.  Als Leerraum
	% am Ende des Knotentextes geht er verloren — TikZ verwirft ihn, die
	% Pille wäre dann genau um die Dreieckbreite zu schmal.  Die Breite
	% einer gesetzten Box kann TikZ dagegen nicht mehr ändern.
	\hbox_set:Nn \l__karol_bpinh_box
	{
		\box_use:N \l__karol_bptxt_box
		\skip_horizontal:n
			{ \l__karol_bpgap_dim + \l__karol_bptri_dim }
	}
	\hbox:n
	{
		\begin{tikzpicture} [ baseline=0pt ]
			\node (karolpille) [ fill=\l__karol_bfarbe_tl!40!white,
			        karolpillenrand,
			        rounded~corners=\l__karol_brc_tl,
			        inner~xsep=\l__karol_bpxs_dim,
			        inner~ysep=\l__karol_bpys_dim,
			        minimum~width=\l__karol_bpmw_dim,
			        anchor=base ]
				at (0pt, 0pt)
				{ \box_use:N \l__karol_bpinh_box };
			% Auswahldreieck, rechtsbündig im Innenraum der Pille.
			% Bezugspunkt ist der Anker "base east": rechte Knotenkante auf
			% Höhe der Textgrundlinie — damit stimmt die Lage auch dann,
			% wenn die Mindestbreite die Pille breiter macht als ihr Inhalt.
			\dim_compare:nT { \l__karol_bptri_dim > 0pt }
			{
				\begin{scope} [ shift={ (karolpille.base~east) } ]
					\fill [ \l__karol_bpdreieck_tl ]
						( \dim_eval:n
						    { 0pt - \l__karol_bpxs_dim - \l__karol_bptri_dim },
						  \dim_eval:n
						    { \l__karol_bpby_dim + \l__karol_bptri_dim } )
						-- ( \dim_eval:n { 0pt - \l__karol_bpxs_dim },
						     \dim_eval:n
						       { \l__karol_bpby_dim + \l__karol_bptri_dim } )
						-- ( \dim_eval:n { 0pt - \l__karol_bpxs_dim
						                   - 0.5 \l__karol_bptri_dim },
						     \dim_use:N \l__karol_bpby_dim )
						-- cycle;
				\end{scope}
			}
		\end{tikzpicture}
	}
}
% Pille ohne Auswahl (Zahlen, Namen von Anweisungsdefinitionen, Kommentare)
\cs_new_protected:Npn \__karol_bpille:n #1
	{ \__karol_bpille_aux:nn { \c_false_bool } {#1} }
% Pille mit Auswahldreieck (Aufrufe, Himmelsrichtungen)
\cs_new_protected:Npn \__karol_bpille_menue:n #1
	{ \__karol_bpille_aux:nn { \c_true_bool } {#1} }
\box_new:N \l__karol_bhex_box
\dim_new:N \l__karol_bhw_dim
\dim_new:N \l__karol_bho_dim
\dim_new:N \l__karol_bhu_dim
\dim_new:N \l__karol_bhp_dim
\dim_new:N \l__karol_bhn_dim
\dim_new:N \l__karol_bhm_dim
\dim_new:N \l__karol_bhk_dim
\NewDocumentCommand { \bbedingung } { m }
{
	\group_begin:
	\__karol_farbschema:
	\__karol_bstart:
	\__karol_bdims:
	\tl_if_empty:nTF {#1}
	{	% Leere Fassung: weißer Sockel (für Lückenaufgaben)
		\hbox_set:Nn \l__karol_bhex_box
			{ \__karol_blockfont: \__karol_bphantom_flach: \hspace{1.1em} }
		\__karol_bbedform:n { white }
	}
	{
		\hbox_set:Nn \l__karol_bhex_box
			{ \__karol_blockfont: \__karol_bschriftfarbe: \__karol_bphantom_flach: #1 }
		\__karol_bbedform:n { karolBlockBedingung }
	}
	\group_end:
}
% Form: abgerundetes Rechteck, Stecker an der linken Kante (Karol Online)
\cs_new_protected:Npn \__karol_bbedform:n #1
{
	\bool_if:NTF \l__karol_binline_bool
	{
		\dim_set:Nn \l__karol_bhw_dim
			{ \box_wd:N \l__karol_bhex_box + 0.34em }
		\dim_set:Nn \l__karol_bho_dim
			{ \box_ht:N \l__karol_bhex_box + 0.10em }
		\dim_set:Nn \l__karol_bhu_dim
			{ \box_dp:N \l__karol_bhex_box + 0.10em }
		\dim_set:Nn \l__karol_bhp_dim { 0.20em }   % Steckertiefe
		\dim_set:Nn \l__karol_bhn_dim { 0.17em }   % halbe Steckerhöhe
	}
	{
		\dim_set:Nn \l__karol_bhw_dim
			{ \box_wd:N \l__karol_bhex_box + 0.52em }
		\dim_set:Nn \l__karol_bho_dim
			{ \box_ht:N \l__karol_bhex_box + 0.17em }
		\dim_set:Nn \l__karol_bhu_dim
			{ \box_dp:N \l__karol_bhex_box + 0.17em }
		\dim_set:Nn \l__karol_bhp_dim { 0.30em }   % Steckertiefe
		\dim_set:Nn \l__karol_bhn_dim { 0.26em }   % halbe Steckerhöhe
	}
	% Senkrechte Mitte und Halshöhe des Steckers.  In der Oberfläche ist
	% der Hals schmaler als das Steckerende (Puzzlenase, keine Lasche):
	% Hals ~0.27, Ende ~0.42 der Blockhöhe.
	\dim_set:Nn \l__karol_bhm_dim
		{ 0.5\l__karol_bho_dim - 0.5\l__karol_bhu_dim }
	\dim_set:Nn \l__karol_bhk_dim { 0.62\l__karol_bhn_dim }
	% (em-Werte MÜSSEN vor dem Bild in Register: im tikzpicture ist em=0!)
	\mode_leave_vertical:
	\hbox:n
	{
		\begin{tikzpicture} [ baseline=0pt ]
			% Körper und Stecker in EINEM Pfad, damit die Umrandung außen
			% herumläuft statt quer durch den Stecker.
			\__karol_brand:nn {#1}
			{
				( \dim_use:N \l__karol_bhp_dim , \dim_use:N \l__karol_bho_dim )
				-- ( \dim_eval:n { \l__karol_bhp_dim + \l__karol_bhw_dim },
				     \dim_use:N \l__karol_bho_dim )
				-- ( \dim_eval:n { \l__karol_bhp_dim + \l__karol_bhw_dim },
				     -\dim_use:N \l__karol_bhu_dim )
				-- ( \dim_use:N \l__karol_bhp_dim ,
				     -\dim_use:N \l__karol_bhu_dim )
				\__karol_bbed_links:
				-- cycle
			}
			\node [ anchor=base, inner~sep=0pt ]
				at ( \dim_eval:n { \l__karol_bhp_dim + 0.5\l__karol_bhw_dim },
				     0pt )
				{ \box_use:N \l__karol_bhex_box };
		\end{tikzpicture}
	}
}

% Linke Seite des Bedingungsplättchens: Hals und Puzzlenase, von der
% unteren zur oberen Halskante.  Scharfe Ecken, weil an den Übergängen
% Gerade->Kurve die Segmente kürzer als zwei Eckradien sind — pgf machte
% daraus sonst Häkchen (dieselbe Falle wie bei der Kerbe).
\cs_new:Npn \__karol_bbed_links:
{
	\l__karol_bkerbe_tl
	-- ( \dim_use:N \l__karol_bhp_dim ,
	     \dim_eval:n { \l__karol_bhm_dim - \l__karol_bhk_dim } )
				% Puzzlenase: ausschwingen, runde Außenkante, einschwingen
				.. controls
					( \dim_eval:n { 0.72\l__karol_bhp_dim },
					  \dim_eval:n { \l__karol_bhm_dim - \l__karol_bhk_dim } )
					and
					( \dim_eval:n { 0.55\l__karol_bhp_dim },
					  \dim_eval:n { \l__karol_bhm_dim - \l__karol_bhn_dim } ) ..
					( \dim_eval:n { 0.22\l__karol_bhp_dim },
					  \dim_eval:n { \l__karol_bhm_dim - \l__karol_bhn_dim } )
				.. controls
					( \dim_eval:n { 0.02\l__karol_bhp_dim },
					  \dim_eval:n { \l__karol_bhm_dim - \l__karol_bhn_dim } )
					and
					( \dim_eval:n { 0.02\l__karol_bhp_dim },
					  \dim_eval:n { \l__karol_bhm_dim + \l__karol_bhn_dim } ) ..
					( \dim_eval:n { 0.22\l__karol_bhp_dim },
					  \dim_eval:n { \l__karol_bhm_dim + \l__karol_bhn_dim } )
				.. controls
					( \dim_eval:n { 0.55\l__karol_bhp_dim },
					  \dim_eval:n { \l__karol_bhm_dim + \l__karol_bhn_dim } )
					and
					( \dim_eval:n { 0.72\l__karol_bhp_dim },
					  \dim_eval:n { \l__karol_bhm_dim + \l__karol_bhk_dim } ) ..
					( \dim_use:N \l__karol_bhp_dim ,
					  \dim_eval:n { \l__karol_bhm_dim + \l__karol_bhk_dim } )
	\l__karol_bkante_tl
}

% --- Himmelsrichtungen: Ist / NichtIst mit Auswahlmenü ---------------------
% In Robot Karol Online zeigen diese acht Blöcke die Richtung nicht als
% Text, sondern als Auswahlmenü: eine helle Pille mit Auswahldreieck.
%
%     \bist{Norden}        \bnichtist{Süden}
%
% Beide liefern für sich ein vollständiges Bedingungsplättchen (wie im
% Original abgebildet).  Als Argument eines Kontrollblocks steuern sie
% dagegen nur dessen Beschriftung bei — dort baut \bbedingung das
% Plättchen, ein zweites wäre falsch:
%
%     \bwenndann{\bist{Norden}}{…}   ->   wenn <Ist [Norden v]> dann
%
% Unterschieden wird über \l__karol_bimbau_bool: innerhalb eines Blocks
% ist es wahr, auf oberster Ebene falsch.
\cs_new_protected:Npn \__karol_bist_text:nn #1#2
{
	% Die Pille gehört zum Bedingungsplättchen, nicht zum umgebenden
	% Block — sonst bekäme sie in \bwenndann dessen Grün.
	\tl_set:Nn \l__karol_bfarbe_tl { karolBlockBedingung }
	#1 ~ \__karol_bpille_menue:n {#2}
}
\cs_new_protected:Npn \__karol_bist:nn #1#2
{
	\bool_if:NTF \l__karol_bimbau_bool
		{ \__karol_bist_text:nn {#1} {#2} }
		{ \bbedingung { \__karol_bist_text:nn {#1} {#2} } }
}
\NewDocumentCommand { \bist }      { m } { \__karol_bist:nn { Ist }      {#1} }
\NewDocumentCommand { \bnichtist } { m } { \__karol_bist:nn { NichtIst } {#1} }

% --- Benutzerkommandos -----------------------------------------------------
% Jeder Nutzerblock läuft in einer eigenen Gruppe und bestimmt zu Beginn
% über \__karol_bstart:, ob er als Stapelblock oder inline gesetzt wird.
% \__karol_bwrap:n kapselt das für alle \b…-Kommandos.
\cs_new_protected:Npn \__karol_bwrap:n #1
	{ \group_begin: \__karol_farbschema: \__karol_bstart: #1 \group_end: }
% dito, aber mit erzwungenem Inline-Modus (\i…-Kommandos)
\cs_new_protected:Npn \__karol_iwrap:n #1
	{ \group_begin: \__karol_farbschema: \__karol_bstart_inline: #1
	  \group_end: }

% \bbefehl[Anzahl]{Name} — optionale Zahl erscheint als Pille
\NewDocumentCommand { \bbefehl } { O{} m }
{
	\__karol_bwrap:n
	{
		\__karol_bblock:nn { karolBlockBefehl }
			{ #2 \tl_if_empty:nF {#1} { ~ \__karol_bpille:n {#1} } }
	}
}

% \baufruf[Anzahl]{Name} — Aufruf einer eigenen Anweisung (rot).
% Der Name steht wie im Original in einer Auswahlpille mit Dreieck (dort
% wählt man daraus die aufzurufende Anweisung); die Definition
% \banweisung zeigt ihn dagegen in einer Pille OHNE Dreieck.
\NewDocumentCommand { \baufruf } { O{} m }
{
	\__karol_bwrap:n
	{
		\__karol_bblock:nn { karolBlockAnweisung }
			{ \__karol_bpille_menue:n {#2}
			  \tl_if_empty:nF {#1} { ~ \__karol_bpille:n {#1} } }
	}
}

% \banweisung{Name}{Blöcke} — Definition einer eigenen Anweisung (C-Block)
\NewDocumentCommand { \banweisung } { m m }
{
	\__karol_bwrap:n
	{
		\__karol_bcblock:nnn { karolBlockAnweisung }
			{ Anweisung ~ \__karol_bpille:n {#1} } { #2 }
	}
}

% \bkommentar{Text} — Kommentarblock (khaki) mit //-Präfix
\NewDocumentCommand { \bkommentar } { m }
{
	\__karol_bwrap:n
	{
		\__karol_bblock:nn { karolBlockKommentar }
			{ { \normalfont \__karol_textfont: \color{black!70} // } ~
			  \__karol_bpille:n {#1} }
	}
}

% \bhauptprogramm — Hut-Block (ohne obere Kerbe), startet den Stapel

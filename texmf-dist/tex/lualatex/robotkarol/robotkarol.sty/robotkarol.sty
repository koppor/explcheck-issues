% ===========================================================================
%  Eine Aufgabe in Robot Karol Online steckt vollständig in der URL:
%  auf https://karol.arrrg.de/ folgt eine Raute und der Aufgabencode.
%
%      \karolonline{2t7t}   setzt   karol.arrrg.de/#2t7t
%                           und verlinkt auf https://karol.arrrg.de/#2t7t
%
%  Gesetzt wird nur, was man tatsächlich eintippen muss (ohne "https://"),
%  in der Programmschrift des Pakets.  Der Code wird unverändert
%  übernommen — auf Groß- und Kleinschreibung kommt es bei den
%  Aufgabencodes nicht an.
%
%  Der Verweis braucht hyperref.  Ob das Paket es lädt, entscheidet die
%  Paketoption:
%
%      \usepackage{robotkarol}                   lädt hyperref (Vorgabe)
%      \usepackage[hyperref=false]{robotkarol}   lädt es nicht
%
%  Ohne hyperref setzt \karolonline denselben Text, nur ohne Verweis.
%  Geladen wird im Haken "begindocument/before", also am Ende der
%  Präambel: hyperref will als letztes Paket geladen werden, und ein
%  Dokument, das es selbst mit eigenen Optionen lädt, käme sonst zu einem
%  Optionskonflikt.  Geladen wird ohne Optionen: wie Verweise aussehen,
%  ist Sache des Dokuments.  Aus demselben Grund fragt \karolonline nicht die
%  Paketoption ab, sondern ob es \href zum Zeitpunkt der Benutzung
%  wirklich gibt — dann verlinkt es auch in einem Dokument, das hyperref
%  trotz hyperref=false selbst geladen hat.
% ---------------------------------------------------------------------------
\ExplSyntaxOn

% Ohne Optionen geladen: wie Verweise aussehen (Rahmen, Farben), stellt
% das Dokument selbst über hyperref ein — das Paket redet da nicht hinein.
\bool_if:NT \g__karol_href_bool
	{ \AddToHook { begindocument/before } { \RequirePackage { hyperref } } }

% Beides als STRING, nicht als tl: unter \ExplSyntaxOn ist ":" ein
% Buchstabe (Catcode 11).  hyperref zerlegt die URL aber mit einem
% delimitierten Argument (\href@split #1:#2:#3), und das trifft nur
% Doppelpunkte mit Catcode 12 — sonst erscheint der Text, aber es
% entsteht kein Verweis, und zwar ohne jede Fehlermeldung.
\str_const:Nn \c__karol_obasis_str   { https://karol.arrrg.de/ }
\str_const:Nn \c__karol_oanzeige_str { karol.arrrg.de/ }
\str_new:N   \l__karol_ocode_str

% Der sichtbare Text: das, was man eintippen muss.
\cs_new_protected:Npn \__karol_online_text:
{
	{ \__karol_monofont: \str_use:N \c__karol_oanzeige_str \c_hash_str
	  \str_use:N \l__karol_ocode_str }
}
% #1 = fertige URL (x-expandiert, damit die Raute wirklich ankommt)
\cs_new_protected:Npn \__karol_online_href:n #1
	{ \href {#1} { \__karol_online_text: } }

\NewDocumentCommand { \karolonline } { m }
{
	\group_begin:
	% \str_set:Nn statt \tl_set:Nn — der Code muss Catcode 12 haben,
	% damit hyperref die URL zerlegen kann (siehe oben).
	\str_set:Nn \l__karol_ocode_str {#1}
	\cs_if_exist:NTF \href
	{
		\exp_args:Nx \__karol_online_href:n
			{ \c__karol_obasis_str \c_hash_str \l__karol_ocode_str }
	}
	{ \__karol_online_text: }
	\group_end:
}

\ExplSyntaxOff

\endinput

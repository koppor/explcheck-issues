\renewcommand{\lstlistingname}{Листинг}
\definecolor{suaiFrame}{HTML}{B5B5B5}
\definecolor{suaiNumber}{HTML}{8A8A8A}
\definecolor{suaiKeyword}{HTML}{0B4F9E}
\definecolor{suaiComment}{HTML}{5C7A5C}
\definecolor{suaiString}{HTML}{A03030}
\definecolor{suaiBack}{HTML}{F5F6F7}

% Рамка от поля до поля, номера строк внутри неё (\suai@lstgutter — на 3 цифры)
\newlength{\suai@lstgutter}
\setlength{\suai@lstgutter}{27pt}
\newlength{\suai@lstsep}
\setlength{\suai@lstsep}{7pt}

\lstdefinestyle{gost}{
  basicstyle=\ttfamily\fontsize{12}{14.4}\selectfont,
  numbers=left, numberstyle=\ttfamily\fontsize{10}{12}\selectfont
                            \color{suaiNumber},
  numbersep=9pt, stepnumber=1,
  frame=single, rulecolor=\color{suaiFrame}, framesep=\suai@lstsep,
  % listings рисует линию рамки ещё на framesep левее framexleftmargin,
  % поэтому левый отступ блока — сумма: рамка встаёт ровно на поле
  framexleftmargin=\suai@lstgutter,
  xleftmargin=\dimexpr\suai@lstgutter+\suai@lstsep\relax,
  xrightmargin=\suai@lstsep,
  % рвать можно и не на пробеле: длинный адрес или вызов без пробелов
  % иначе уходит за рамку
  breaklines=true, breakatwhitespace=false,
  postbreak=\mbox{\textcolor{suaiFrame}{$\hookrightarrow$}\space},
  showstringspaces=false, tabsize=4, columns=fullflexible,
  keepspaces=true, extendedchars=true, upquote=true,
  captionpos=t, aboveskip=12pt, belowskip=12pt,
  commentstyle=\itshape, stringstyle=\normalfont\ttfamily,
}
\lstdefinestyle{gostcolor}{
  style=gost,
  backgroundcolor=\color{suaiBack},
  keywordstyle=\color{suaiKeyword},
  commentstyle=\itshape\color{suaiComment},
  stringstyle=\color{suaiString},
}
\lstset{style=gost}

% listings разбирает только символы 0–255, остальные XeTeX ставит сразу,
% мимо его буфера: русское слово в начале строки уезжало в конец
% предыдущей. Кириллица — буквы листинга, тире, кавычки и № — прочие.
\def\suai@lstchars#1#2#3{%
  \count@=#2
  \loop\ifnum\count@<#3
    \catcode\count@=\active
    \begingroup\lccode`\~=\count@ \lccode`\A=\count@
    \lowercase{\endgroup\def~{#1A}}%
    \advance\count@\@ne
  \repeat}
\lst@AddToHook{SelectCharTable}{%
  \suai@lstchars\lst@ProcessLetter{"0400}{"0460}%
  \suai@lstchars\lst@ProcessOther{"2010}{"2028}%
  \suai@lstchars\lst@ProcessOther{"2116}{"2117}}

% Языки, которых в listings нет: комментарии, строки и основные ключевые
% слова. Заданный здесь язык listings в своих файлах уже не ищет.
\lstdefinelanguage{JavaScript}{
  sensitive=true,
  morekeywords={async,await,break,case,catch,class,const,continue,default,
    delete,do,else,export,extends,false,finally,for,from,function,if,
    import,in,instanceof,let,new,null,of,return,static,super,switch,this,
    throw,true,try,typeof,undefined,var,void,while,yield},
  morecomment=[l]{//}, morecomment=[s]{/*}{*/},
  morestring=[b]", morestring=[b]', morestring=[b]`,
}
\lstdefinelanguage{TypeScript}[]{JavaScript}{
  morekeywords={abstract,any,as,boolean,declare,enum,implements,interface,
    keyof,namespace,never,number,private,protected,public,readonly,string,
    type,unknown},
}
\lstdefinelanguage{Kotlin}{
  sensitive=true,
  morekeywords={abstract,as,break,by,catch,class,companion,const,
    constructor,continue,data,do,else,enum,false,final,finally,for,fun,if,
    import,in,init,interface,internal,is,lateinit,null,object,open,
    override,package,private,protected,public,return,sealed,super,suspend,
    this,throw,true,try,typealias,val,var,when,while},
  morecomment=[l]{//}, morecomment=[n]{/*}{*/},
  morestring=[b]", morestring=[b]', morestring=[s]{"""}{"""},
}
% без строк в '…': апостроф в Rust — ещё и время жизни ('a)
\lstdefinelanguage{Rust}{
  sensitive=true,
  morekeywords={as,async,await,break,const,continue,crate,dyn,else,enum,
    extern,false,fn,for,if,impl,in,let,loop,match,mod,move,mut,pub,ref,
    return,self,Self,static,struct,super,trait,true,type,unsafe,use,where,
    while},
  morecomment=[l]{//}, morecomment=[n]{/*}{*/},
  morestring=[b]",
}
\lstdefinelanguage{JSON}{
  sensitive=true,
  morekeywords={true,false,null},
  morestring=[b]",
}
% без строк в '…': апостроф в тексте (don't) открыл бы строку до конца кода
\lstdefinelanguage{YAML}{
  sensitive=true,
  morekeywords={true,false,null},
  morecomment=[l]\#,
  morestring=[b]",
}
% инструкции — только прописными: run, copy и user в командах не слова
\lstdefinelanguage{Dockerfile}{
  sensitive=true,
  morekeywords={ADD,ARG,AS,CMD,COPY,ENTRYPOINT,ENV,EXPOSE,FROM,HEALTHCHECK,
    LABEL,ONBUILD,RUN,SHELL,STOPSIGNAL,USER,VOLUME,WORKDIR},
  morecomment=[l]\#,
  morestring=[b]", morestring=[b]',
}

% Короткие имена: расширение файла или как язык зовут в разговоре.
% Регистр listings не различает; C# разбирает \suaicode (раздел 15).
\lstalias{cpp}{C++}
\lstalias[]{cs}[Sharp]{C}
\lstalias[]{csharp}[Sharp]{C}
\lstalias{js}{JavaScript}
\lstalias{ts}{TypeScript}
\lstalias{py}{Python}
\lstalias{kt}{Kotlin}
\lstalias{rs}{Rust}
\lstalias{yml}{YAML}
\lstalias{docker}{Dockerfile}

% Неизвестный язык — не ошибка: предупреждение и код без подсветки.
% \lst@Require пробует загрузить язык и через \lst@if говорит, вышло ли;
% ошибку при неудаче он выдаёт сам, поэтому на время пробы она глушится.
\let\suai@lstlanguage\KV@lst@language
\def\KV@lst@language#1{%
  \begingroup
    \def\PackageError##1##2##3{}%
    \lst@Require{language}{lang}{#1}\lst@FindAlias\lstlanguagefiles
    \lst@if \aftergroup\@firstoftwo \else \aftergroup\@secondoftwo \fi
  \endgroup
    {\suai@lstlanguage{#1}}%
    {\PackageWarning{suai}{Язык листинга '#1' неизвестен,\MessageBreak
       код набран без подсветки}%
     \suai@lstlanguage{}}}

%%---------------------------------------------------------------------
%%  7. ПРИЛОЖЕНИЯ (ГОСТ 7.32-2017, п. 6.14)
%%---------------------------------------------------------------------
\newcounter{suaiapp}
\newcommand{\suaiappletter}{\suai@upper{\value{suaiapp}}}

\newcommand\suai@appnumbering[1]{%
  \setcounter{#1}{0}%
  \expandafter\def\csname the#1\endcsname{\suaiappletter.\arabic{#1}}%
  % свои якоря hyperref, иначе ссылка ведёт на рисунок 1 основной части
  \expandafter\def\csname theH#1\endcsname{app\arabic{suaiapp}.\arabic{#1}}}

\newcommand{\suaiapp}[2][обязательное]{%
  \clearpage
  \stepcounter{suaiapp}%
  \phantomsection
  % в содержании — обозначение, статус и наименование (п. 6.17.7)
  \addcontentsline{toc}{section}%
    {\texorpdfstring{ПРИЛОЖЕНИЕ~\suaiappletter\ (#1)\ #2}%
                    {Приложение \suaiappletter. #2}}%
  \suai@appnumbering{figure}\suai@appnumbering{table}%
  \suai@appnumbering{equation}\suai@appnumbering{lstlisting}%
  {\centering
   {\suaiheadfont ПРИЛОЖЕНИЕ~\suaiappletter\par}
   \vspace{2pt}
   {\normalfont(#1)\par}
   \vspace{8pt}
   {\suaiheadfont #2\par}}% заголовок — с прописной буквы (п. 6.17.3)
  \vspace{14pt}\par}

%%---------------------------------------------------------------------
%%  8. ТИТУЛЬНЫЙ ЛИСТ
%%  Снят с бланка ГУАП (Word). Расстояния — между базовыми линиями в bp
%%  (пункты Word), кегль 12.045 pt = 12 bp. Отступы с minus сжимаются,
%%  если длинное название не помещается.
%%---------------------------------------------------------------------
\ExplSyntaxOn
\keys_define:nn { suai }
  {
    department   .tl_set:c    = suai@department,
    teacher-post .tl_set:c    = suai@teacherpost,
    teacher      .tl_set:c    = suai@teacher,
    type         .tl_set:c    = suai@type,
    type         .initial:n   = Отчет~о~лабораторной~работе,
    number       .tl_set:c    = suai@number,
    title        .tl_set:c    = suai@title,
    course-label .tl_set:c    = suai@courselabel,
    course-label .initial:n   = по~курсу:,
    course       .tl_set:c    = suai@course,
    group        .tl_set:c    = suai@group,
    student      .clist_set:N = \l__suai_students_clist,
    date         .tl_set:c    = suai@date,
    city         .tl_set:c    = suai@city,
    city         .initial:n   = Санкт-Петербург,
    year         .tl_set:c    = suai@year,
    year         .initial:x   = \int_use:N \c_sys_year_int,
  }
% запятая без «=» продолжает значение предыдущего ключа:
% teacher-post = доцент, канд. техн. наук -> {доцент, канд. техн. наук}
\tl_new:N \l__suai_key_tl
\tl_new:N \l__suai_value_tl
\bool_new:N \l__suai_key_bool
\cs_new_protected:Npn \__suai_setup_flush:
  {
    \bool_if:NT \l__suai_key_bool
      {
        \use:e
          {
            \exp_not:N \keys_set:nn { suai }
              { \exp_not:V \l__suai_key_tl = { \exp_not:V \l__suai_value_tl } }
          }
        \bool_set_false:N \l__suai_key_bool
      }
  }
\cs_new_protected:Npn \__suai_setup_item:n #1
  {
    \bool_if:NTF \l__suai_key_bool
      { \tl_put_right:Nn \l__suai_value_tl { ,~ #1 } }
      { \keys_set:nn { suai } {#1} }
  }
\cs_new_protected:Npn \__suai_setup_pair:nn #1#2
  {
    \__suai_setup_flush:
    \tl_set:Nn \l__suai_key_tl {#1}
    \tl_set:Nn \l__suai_value_tl {#2}
    \bool_set_true:N \l__suai_key_bool
  }
\NewDocumentCommand \suaisetup { m }
  {
    \bool_set_false:N \l__suai_key_bool
    \keyval_parse:nnn \__suai_setup_item:n \__suai_setup_pair:nn {#1}
    \__suai_setup_flush:
  }

% date = today -> ДД.ММ.ГГГГ на момент сборки
\cs_new:Npn \__suai_two_digits:N #1
  { \int_compare:nNnT {#1} < { 10 } { 0 } \int_use:N #1 }
\cs_new:cpn { suai@thedate }
  {
    \tl_if_eq:cnTF { suai@date } { today }
      {
        \__suai_two_digits:N \c_sys_day_int .
        \__suai_two_digits:N \c_sys_month_int .
        \int_use:N \c_sys_year_int
      }
      { \use:c { suai@date } }
  }
\cs_new_protected:cpn { suai@forstudents } #1
  { \clist_map_inline:Nn \l__suai_students_clist {#1} }
\cs_new:cpn { suai@firststudent }
  { \clist_if_empty:NF \l__suai_students_clist

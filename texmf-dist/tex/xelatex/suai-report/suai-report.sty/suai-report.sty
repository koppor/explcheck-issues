%%---------------------------------------------------------------------
%% 10. БЛОЧНЫЕ КОМАНДЫ: ЧТЕНИЕ СТРОК
%%  \suai_read_lines:n {код} собирает строки под командой в
%%  \g__suai_lines_seq до пустой строки, конца файла или строки,
%%  начинающейся с \section, \begin, \end и т. п. или \suai...,
%%  и выполняет код. Комментарий относится к своей строке: строка
%%  из одного комментария пропускается.
%%---------------------------------------------------------------------
\seq_new:N \g__suai_lines_seq
\tl_new:N \g__suai_then_tl
\bool_new:N \l__suai_cmd_bool
\str_new:N \l__suai_cmd_str
\seq_new:N \l__suai_line_seq
\tl_new:N \l__suai_line_tl
\cs_new_protected:Npn \__suai_eol: { }   % значение активного ^^M в блоке

\cs_new_protected:Npn \suai_read_lines:n #1
  {
    \tl_gset:Nn \g__suai_then_tl {#1}
    \seq_gclear:N \g__suai_lines_seq
    \group_begin:
      \char_set_catcode_active:n { 13 }
      % настоящий комментарий съел бы конец строки и склеил её со
      % следующей: % читается как знак, срезает его \__suai_line:n
      \char_set_catcode_other:N \%
      % блок в самом конце файла из \input: конец файла — как пустая строка
      \tex_everyeof:D \exp_after:wN { \c__suai_eol_tl }
      \__suai_lines_start:
  }
% #1 — токены, которые вернуть во входной поток после блока
\cs_new_protected:Npn \__suai_lines_stop:n #1
  { \group_end: \tl_use:N \g__suai_then_tl #1 }

% активный конец строки не набрать напрямую: \lowercase делает из
% активной ~ активный ^^M
\group_begin:
  \char_set_lccode:nn { `\~ } { 13 }
  \char_set_catcode_active:N \~
  \tex_lowercase:D
    {
      \group_end:
      \tl_const:Nn \c__suai_eol_tl { ~ }
      \cs_new_protected:Npn \__suai_lines_start:
        {
          \cs_set_eq:NN ~ \__suai_eol:
          \peek_meaning_remove:NTF \par
            { \__suai_lines_stop:n { \par } }
            % обе ветки одинаковые: убрать перевод строки, если он есть,
            % и начать читать. \__suai_line:w обязан стоять внутри ветки —
            % после \peek_... его подхватил бы сам peek вместо строки файла.
            { \peek_meaning_remove:NTF \__suai_eol: { \__suai_line:w } { \__suai_line:w } }
        }
      \cs_new_protected:Npn \__suai_line:w #1 ~
        { \tl_trim_spaces_apply:nN {#1} \__suai_line:n }
    }

% \% — команда и остаётся; % в скобках (\url{a%20b}) — тоже
\cs_new_protected:Npn \__suai_line:n #1
  {
    \exp_args:NnV \tl_if_in:nnTF {#1} \c_percent_str
      {
        \exp_args:NNV \seq_set_split:Nnn \l__suai_line_seq \c_percent_str {#1}
        \seq_get_left:NN \l__suai_line_seq \l__suai_line_tl
        \tl_if_blank:VTF \l__suai_line_tl
          { \__suai_line:w }
          { \exp_args:NV \__suai_line_text:n \l__suai_line_tl }
      }
      { \__suai_line_text:n {#1} }
  }
\cs_new_protected:Npn \__suai_line_text:n #1
  {
    \tl_if_blank:nTF {#1}
      { \__suai_lines_stop:n { \par } }
      {
        \bool_set_false:N \l__suai_cmd_bool
        \tl_if_head_is_N_type:nT {#1} { \__suai_check_cmd:w #1 \q_stop }
        \bool_if:NTF \l__suai_cmd_bool
          {
            \__suai_if_eol:nTF {#1}
              {
                \tl_set:Nn \l_tmpa_tl {#1}
                \tl_put_right:NV \l_tmpa_tl \c__suai_eol_tl
                \exp_args:NV \__suai_lines_stop:n \l_tmpa_tl
              }
              { \__suai_lines_stop:n {#1} }
          }
          {
            \seq_gput_right:Nn \g__suai_lines_seq {#1}
            \__suai_line:w
          }
      }
  }

% имя команды из \cs_to_str:N — строка, поэтому и список строковый:
% \clist_if_in:NnT сравнивает токены вместе с их категориями
\clist_const:Nx \c__suai_stop_clist
  {
    \tl_to_str:n
      {
        par, begin, end, section, subsection, subsubsection, paragraph,
        clearpage, newpage, maketitle, printbibliography,
      }
  }
\cs_new_protected:Npn \__suai_check_cmd:w #1 #2 \q_stop
  {
    \token_if_cs:NT #1
      {
        \str_set:Nx \l__suai_cmd_str { \cs_to_str:N #1 }
        \exp_args:NNV \clist_if_in:NnT \c__suai_stop_clist \l__suai_cmd_str
          { \bool_set_true:N \l__suai_cmd_bool }
        \exp_args:Nx \str_if_eq:nnT
          { \str_range:Nnn \l__suai_cmd_str { 1 } { 4 } } { suai }
          { \bool_set_true:N \l__suai_cmd_bool }
      }
  }

% Нужен ли строке #1 съеденный конец строки. \suaicode читает код со
% следующей строки, а окружения listings (lstlisting и заданные через
% \lstnewenvironment) отбрасывают всё, что стоит после \begin{…} на той
% же строке: без конца строки пропала бы первая строка кода. Остальным
% окружениям он не нужен: в формуле это был бы \par.
\prg_new_protected_conditional:Npnn \__suai_if_eol:n #1 { TF }
  {
    \str_clear:N \l__suai_cmd_str
    \tl_if_head_is_N_type:nT {#1} { \__suai_check_cmd:w #1 \q_stop }
    \str_case:VnF \l__suai_cmd_str
      {
        { suaicode } { \prg_return_true: }
        { begin }
          {
            \exp_args:Nee \str_if_in:nnTF
              { \cs_meaning:c { \tl_item:nn {#1} { 2 } } }
              { \c_backslash_str lstenv@name }
              { \prg_return_true: } { \prg_return_false: }
          }
      }
      { \prg_return_false: }
  }

%%---------------------------------------------------------------------
%% 11. ПЕРЕЧИСЛЕНИЯ
%%  После пунктов «;», после последнего «.». Свои ; . , в конце
%%  заменяются, ? ! : остаются. Точка сокращения (и т. д., и др.,
%%  2026 г., 5 шт.) — его часть: она остаётся, «;» ставится после неё.
%%  Со звёздочкой пунктуация не трогается.
%%---------------------------------------------------------------------
\bool_new:N \l__suai_punct_bool
\tl_new:N \l__suai_item_tl
\regex_const:Nn \c__suai_trail_regex { [\;\.\,] \s* \Z }
\regex_const:Nn \c__suai_keep_regex { [\?\!\:] \s* \Z }
% между «т.» и «д.» — пробел, ~ или \,
\regex_const:Nn \c__suai_abbr_regex
  {
    (?: \A | [^а-яёА-ЯЁ] )
    (?: т \. (?: \s | \~ | \c{,} )* [дп]
      | др | пр | гг? | вв | руб | коп | тыс | шт | экз | стр )
    \. \s* \Z
  }

\cs_new_protected:Npn \__suai_punct:n #1
  {
    \bool_if:NT \l__suai_punct_bool
      {
        \exp_args:NNV \regex_match:NnF \c__suai_abbr_regex \l__suai_item_tl
          { \regex_replace_once:NnN \c__suai_trail_regex { } \l__suai_item_tl }
        \exp_args:NNV \regex_match:NnTF \c__suai_abbr_regex \l__suai_item_tl
          {
            \int_compare:nNnF {#1} = { \seq_count:N \g__suai_lines_seq }
              { \tl_put_right:Nn \l__suai_item_tl { ; } }
          }
          {
            \exp_args:NNV \regex_match:NnF \c__suai_keep_regex \l__suai_item_tl
              {
                \tl_put_right:Nx \l__suai_item_tl
                  {
                    \int_compare:nNnTF {#1} = { \seq_count:N \g__suai_lines_seq }
                      { . } { ; }
                  }
              }
          }
      }
  }

% #1 — окружение, #2 — булево «без пунктуации»
\cs_new_protected:Npn \__suai_list:nn #1#2
  {
    \seq_if_empty:NF \g__suai_lines_seq
      {
        \bool_set:Nn \l__suai_punct_bool { ! #2 }
        \begin{#1}
          \seq_map_indexed_function:NN \g__suai_lines_seq \__suai_list_item:nn
        \end{#1}
      }
  }
\cs_new_protected:Npn \__suai_list_item:nn #1#2
  {
    \tl_set:Nn \l__suai_item_tl {#2}
    \__suai_punct:n {#1}
    \item \tl_use:N \l__suai_item_tl
  }

\NewDocumentCommand \suailist { s }
  { \suai_read_lines:n { \__suai_list:nn { itemize } {#1} } }
\NewDocumentCommand \suaienum { s }
  { \suai_read_lines:n { \__suai_list:nn { gostenum } {#1} } }
\NewDocumentCommand \suainum { s }

% Разрывы внутри длинных «слов» без пробелов (БД_Продажи, Журнал!$A$2,
% yandex.cloud/ru/docs): после _ / = + ! -, а в \ttfamily ещё после
% . , ; : ? & и перед ( [. В обычном тексте по . : ( не рвётся, чтобы
% не разъехались 76.АВ, «1С:Предприятие», LL(1). Перед цифрой разрыва
% нет: 1,5 и 01.01.2025 целы. Штраф как у переноса по слогам.
\newXeTeXintercharclass\suai@brkclass
\newXeTeXintercharclass\suai@ttbrkclass
\newXeTeXintercharclass\suai@openclass
\newXeTeXintercharclass\suai@closeclass
\newXeTeXintercharclass\suai@digitclass
\def\suai@setclass#1#2{%
  \def\suai@next##1{%
    \ifx\relax##1\else\XeTeXcharclass`##1=#1\expandafter\suai@next\fi}%
  \suai@next#2\relax}
\suai@setclass\suai@brkclass{_/=+!-}
\suai@setclass\suai@ttbrkclass{.,;:?&}
\suai@setclass\suai@openclass{([}
\suai@setclass\suai@closeclass{)]'"»}
\suai@setclass\suai@digitclass{0123456789}
\newcommand\suai@brk{\penalty50\relax}
\XeTeXinterchartoks\suai@brkclass\z@{\suai@brk}
\XeTeXinterchartoks\suai@brkclass\suai@openclass{\suai@brk}
\AddToHook{ttfamily}{%
  \XeTeXinterchartoks\suai@ttbrkclass\z@{\suai@brk}%
  \XeTeXinterchartoks\suai@ttbrkclass\suai@openclass{\suai@brk}%
  \XeTeXinterchartoks\z@\suai@openclass{\suai@brk}%
  \XeTeXinterchartoks\suai@digitclass\suai@openclass{\suai@brk}%
  \XeTeXinterchartoks\suai@closeclass\suai@openclass{\suai@brk}}
\XeTeXinterchartokenstate=\@ne


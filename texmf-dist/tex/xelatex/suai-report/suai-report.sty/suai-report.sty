%%---------------------------------------------------------------------
%% 12. ТАБЛИЦА
%%  Ячейки через |, первая строка — шапка; | внутри формулы ячейку
%%  не делит. У каждого столбца четыре ширины по набранному тексту,
%%  от узкой к широкой:
%%    1 — самый широкий неразрывный кусок (слог, число);
%%    2 — без переносов по слогам, но с разрывами из раздела 3;
%%    3 — самое длинное слово целиком;
%%    4 — самая широкая ячейка в одну строку.
%%  Берётся самый широкий уровень, который влезает в полосу, а остаток
%%  делится пропорционально нехватке до следующего уровня, как в HTML.
%%  Если не влезает даже уровень 1, столбец получает его, пока хватает
%%  доли, остальные делят остаток поровну.
%%---------------------------------------------------------------------
\int_new:N \l__suai_cols_int
\prop_new:N \l__suai_level_prop      % {уровень/столбец} -> pt
\prop_new:N \l__suai_wd_prop         % столбец -> итоговая ширина, pt
\seq_new:N \l__suai_cells_seq
\box_new:N \l__suai_cell_box
\box_new:N \l__suai_line_box
\dim_new:N \g__suai_line_dim
\tl_new:N \l__suai_col_tl
\fp_new:N \l__suai_avail_fp
\fp_new:N \l__suai_lo_sum_fp
\fp_new:N \l__suai_hi_sum_fp
\fp_new:N \l__suai_ratio_fp
\fp_new:N \l__suai_free_fp
\fp_new:N \l__suai_level_fp
\int_new:N \l__suai_lvl_int
\int_new:N \l__suai_open_int
\bool_new:N \l__suai_again_bool
\tl_new:N \l__suai_spec_tl
\tl_new:N \l__suai_head_tl
\tl_new:N \l__suai_body_tl
\tl_new:N \l__suai_row_tl
\tl_new:N \l__suai_table_tl

% запас на случай, если набор в колонке окажется чуть шире измеренного
\fp_const:Nn \c__suai_pad_fp { 1 }

% #1 — уровень, #2 — столбец
\cs_generate_variant:Nn \prop_item:Nn { Ne }
\cs_new:Npn \__suai_wd:nn #1#2
  { \prop_item:Ne \l__suai_level_prop { \int_eval:n {#1} / #2 } }
% сумма уровня \l__suai_lvl_int по столбцам
\cs_new:Npn \__suai_sum:
  { 0 \int_step_function:nN { \l__suai_cols_int } \__suai_sum_item:n }
\cs_new:Npn \__suai_sum_item:n #1 { + \__suai_wd:nn { \l__suai_lvl_int } {#1} }

% Ячейки строки #1 -> \l__suai_cells_seq. Черта внутри формулы ($|x|$,
% \( a | b \)) ячейку не делит: куски склеиваются обратно, пока формула
% не закрыта. \$ — команда, за знак формулы не считается.
\seq_new:N \l__suai_pieces_seq
\tl_new:N \l__suai_cell_tl
\bool_new:N \l__suai_math_bool
\int_new:N \l__suai_math_int
\regex_const:Nn \c__suai_dollar_regex { \$ }
\regex_const:Nn \c__suai_mopen_regex { \c{\(} }
\regex_const:Nn \c__suai_mclose_regex { \c{\)} }
\cs_new_protected:Npn \__suai_cells:n #1
  {
    \seq_set_split:Nnn \l__suai_cells_seq { | } {#1}
    \bool_set_false:N \l__suai_math_bool
    \tl_if_in:nnT {#1} { $ } { \bool_set_true:N \l__suai_math_bool }
    \tl_if_in:nnT {#1} { \( } { \bool_set_true:N \l__suai_math_bool }
    \bool_if:NT \l__suai_math_bool { \__suai_cells_join: }
  }
\cs_new_protected:Npn \__suai_cells_join:
  {
    \seq_set_eq:NN \l__suai_pieces_seq \l__suai_cells_seq
    \seq_clear:N \l__suai_cells_seq
    \bool_set_false:N \l__suai_math_bool      % формула открыта
    \seq_map_inline:Nn \l__suai_pieces_seq
      {
        \bool_if:NTF \l__suai_math_bool
          { \tl_put_right:Nn \l__suai_cell_tl { | ##1 } }
          { \tl_set:Nn \l__suai_cell_tl {##1} }
        \__suai_cells_open:
        \bool_if:NF \l__suai_math_bool
          { \seq_put_right:NV \l__suai_cells_seq \l__suai_cell_tl }
      }
    % формула так и не закрылась: ячейка как есть, ошибку покажет TeX
    \bool_if:NT \l__suai_math_bool
      { \seq_put_right:NV \l__suai_cells_seq \l__suai_cell_tl }
  }
\cs_new_protected:Npn \__suai_cells_open:
  {
    \exp_args:NNV \regex_count:NnN \c__suai_dollar_regex
      \l__suai_cell_tl \l__suai_math_int
    \bool_set:Nn \l__suai_math_bool { \int_if_odd_p:n { \l__suai_math_int } }
    \exp_args:NNV \regex_count:NnN \c__suai_mopen_regex
      \l__suai_cell_tl \l__suai_math_int
    \exp_args:NNV \regex_count:NnN \c__suai_mclose_regex
      \l__suai_cell_tl \l_tmpa_int
    \int_compare:nNnT { \l__suai_math_int } > { \l_tmpa_int }
      { \bool_set_true:N \l__suai_math_bool }
  }

\cs_new_protected:Npn \__suai_table_cols:n #1
  {
    \__suai_cells:n {#1}
    \int_set:Nn \l__suai_cols_int
      { \int_max:nn { \l__suai_cols_int } { \seq_count:N \l__suai_cells_seq } }
  }

\cs_new_protected:Npn \__suai_table_measure:n #1
  {
    \__suai_cells:n {#1}
    \seq_map_indexed_function:NN \l__suai_cells_seq \__suai_table_measure:nn
  }

% #1 — номер столбца, #2 — ячейка
\cs_new_protected:Npn \__suai_table_measure:nn #1#2
  {
    \tl_set:Nn \l__suai_col_tl {#1}
    \__suai_table_level:nnnn { 1 } { \c_zero_dim } { } {#2}
    \__suai_table_level:nnnn { 2 } { \c_zero_dim } { \__suai_nohyph: } {#2}
    \__suai_table_level:nnnn { 3 } { \c_zero_dim }
      { \__suai_nohyph: \__suai_nobreak: } {#2}
    \__suai_table_level:nnnn { 4 } { \c_max_dim } { \__suai_nohyph: } {#2}
  }
\cs_new_protected:Npn \__suai_nohyph:
  { \lefthyphenmin = 64 \scan_stop: }
% уровень 3: рвётся только по пробелам текста. Ячейка не режется на слова
% по токенам: $a + b$ и \cmd {x} разрезать нельзя, а TeX формулу не рвёт.
\cs_new_protected:Npn \__suai_nobreak:
  {
    \cs_set_eq:cN { suai@brk } \prg_do_nothing:   % разрывы из раздела 3
    \int_set:Nn \hyphenpenalty { 10000 }          % \-
    \int_set:Nn \exhyphenpenalty { 10000 }        % дефис и тире
    \int_set:Nn \binoppenalty { 10000 }
    \int_set:Nn \relpenalty { 10000 }
  }

% #1 — уровень, #2 — ширина строки, #3 — настройки, #4 — ячейка.
% Ячейка набирается абзацем шириной #2 (0pt — разрыв везде, где можно,
% \c_max_dim — только на \newline), берётся самая широкая строка.
\cs_new_protected:Npn \__suai_table_level:nnnn #1#2#3#4
  {
    \vbox_set:Nn \l__suai_cell_box
      {
        \dim_set:Nn \hsize {#2}
        \dim_set_eq:NN \linewidth \hsize
        \dim_zero:N \parindent
        \skip_zero:N \leftskip
        \skip_set:Nn \rightskip { 0pt plus 1fil }
        \skip_set:Nn \parfillskip { 0pt plus 1fil }
        \int_set:Nn \pretolerance { -1 }
        \int_set:Nn \tolerance { 10000 }
        \int_set:Nn \hbadness { 10000 }
        \dim_set_eq:NN \hfuzz \c_max_dim
        \dim_zero:N \emergencystretch
        #3
        % \hspace{0pt}: иначе первое слово абзаца не переносится
        \noindent \skip_horizontal:n { 0pt } #4 \par
        \dim_gzero:N \g__suai_line_dim
        \__suai_table_lines:
      }
    \__suai_table_wider:nn {#1} { \g__suai_line_dim }
  }
\cs_new_protected:Npn \__suai_table_wider:nn #1#2
  {
    \prop_put:Nxx \l__suai_level_prop { #1 / \l__suai_col_tl }
      {
        \fp_eval:n
          {
            max ( \__suai_wd:nn {#1} { \l__suai_col_tl } ,
                  \dim_to_fp:n {#2} + \c__suai_pad_fp )
          }
      }
  }
% снимать строки абзаца с конца и мерить их естественную ширину
\cs_new_protected:Npn \__suai_table_lines:
  {
    \tex_unskip:D \tex_unpenalty:D \tex_unskip:D
    \box_set_to_last:N \l__suai_line_box
    \box_if_empty:NF \l__suai_line_box
      {
        \hbox_set:Nn \l__suai_line_box { \hbox_unpack:N \l__suai_line_box }
        \dim_gset:Nn \g__suai_line_dim
          { \dim_max:nn { \g__suai_line_dim } { \box_wd:N \l__suai_line_box } }
        \__suai_table_lines:
      }
  }

% под текст остаётся ширина полосы минус линейки и отбивки столбцов;
% ищется первый уровень, на котором таблица не влезает
\cs_new_protected:Npn \__suai_table_widths:
  {
    \fp_set:Nn \l__suai_avail_fp
      {
        \dim_to_fp:n { \textwidth }
          - ( \l__suai_cols_int + 1 ) * \dim_to_fp:n { \arrayrulewidth }
          - 2 * \l__suai_cols_int * \dim_to_fp:n { \tabcolsep }
      }
    \int_set:Nn \l__suai_lvl_int { 1 }
    \fp_set:Nn \l__suai_hi_sum_fp { \__suai_sum: }
    \bool_until_do:nn
      {
        \int_compare_p:nNn { \l__suai_lvl_int } > { 3 }
        || \fp_compare_p:nNn { \l__suai_hi_sum_fp } > { \l__suai_avail_fp }
      }
      {
        \fp_set_eq:NN \l__suai_lo_sum_fp \l__suai_hi_sum_fp
        \int_incr:N \l__suai_lvl_int
        \fp_set:Nn \l__suai_hi_sum_fp { \__suai_sum: }
      }
    \fp_compare:nNnTF { \l__suai_hi_sum_fp } > { \l__suai_avail_fp }
      {
        \int_compare:nNnTF { \l__suai_lvl_int } = { 1 }
          { \__suai_table_squeeze: }
          { \__suai_table_share: }
      }
      { \__suai_table_stretch: }
  }

% всё влезло в одну строку: растянуть самые широкие ячейки на полосу
\cs_new_protected:Npn \__suai_table_stretch:
  {
    \int_step_inline:nn { \l__suai_cols_int }
      {
        \prop_put:Nnx \l__suai_wd_prop {##1}
          {
            \fp_eval:n
              {
                \__suai_wd:nn { 4 } {##1} * \l__suai_avail_fp
                  / max ( \l__suai_hi_sum_fp , 1 )
              }
          }
      }
  }

% уровень \l__suai_lvl_int - 1 влезает, \l__suai_lvl_int нет: каждому
% столбцу нижний уровень плюс доля свободного места по его аппетиту
\cs_new_protected:Npn \__suai_table_share:
  {
    \fp_set:Nn \l__suai_ratio_fp
      {
        ( \l__suai_avail_fp - \l__suai_lo_sum_fp )
          / max ( \l__suai_hi_sum_fp - \l__suai_lo_sum_fp , 1 )
      }
    \int_step_inline:nn { \l__suai_cols_int }
      {
        \prop_put:Nnx \l__suai_wd_prop {##1}
          {
            \fp_eval:n
              {
                \__suai_wd:nn { \l__suai_lvl_int - 1 } {##1}
                  + ( \__suai_wd:nn { \l__suai_lvl_int } {##1}
                      - \__suai_wd:nn { \l__suai_lvl_int - 1 } {##1} )
                    * \l__suai_ratio_fp
              }
          }
      }
  }

% Не влезает даже уровень 1: столбец, которому хватает доли, получает
% его, остальные делят остаток поровну.
\cs_new_protected:Npn \__suai_table_squeeze:
  {
    \fp_set_eq:NN \l__suai_free_fp \l__suai_avail_fp
    \int_set_eq:NN \l__suai_open_int \l__suai_cols_int
    \bool_set_true:N \l__suai_again_bool
    \bool_do_while:Nn \l__suai_again_bool { \__suai_table_pass: }
    \int_step_function:nN { \l__suai_cols_int } \__suai_table_rest:n
  }

% проход: доля растёт после каждого закреплённого столбца, поэтому
% проходы повторяются, пока находится хоть один новый
\cs_new_protected:Npn \__suai_table_pass:
  {
    \bool_set_false:N \l__suai_again_bool
    \fp_set:Nn \l__suai_level_fp
      { \l__suai_free_fp / max ( \l__suai_open_int , 1 ) }
    \int_step_function:nN { \l__suai_cols_int } \__suai_table_lock:n
  }

\cs_new_protected:Npn \__suai_table_lock:n #1
  {
    \prop_if_in:NnF \l__suai_wd_prop {#1}
      {
        \fp_compare:nNnF { \__suai_wd:nn { 1 } {#1} } > { \l__suai_level_fp }
          {
            \prop_put:Nnx \l__suai_wd_prop {#1} { \__suai_wd:nn { 1 } {#1} }
            \fp_sub:Nn \l__suai_free_fp { \__suai_wd:nn { 1 } {#1} }
            \int_decr:N \l__suai_open_int
            \bool_set_true:N \l__suai_again_bool
          }
      }
  }

\cs_new_protected:Npn \__suai_table_rest:n #1
  {
    \prop_if_in:NnF \l__suai_wd_prop {#1}
      {
        \prop_put:Nnx \l__suai_wd_prop {#1}
          { \fp_eval:n { max ( \l__suai_free_fp / max ( \l__suai_open_int , 1 ) , 1 ) } }
      }
  }

% столбец X с долей ширины по тексту; первый — влево, остальные по центру
\cs_new_protected:Npn \__suai_table_spec:n #1
  {
    \tl_put_right:Nx \l__suai_spec_tl
      {
        | > {
          \exp_not:N \hsize =
            \fp_eval:n
              {
                round ( \l__suai_cols_int * \prop_item:Nn \l__suai_wd_prop {#1}
                          / \l__suai_avail_fp , 4 )
              }
            \exp_not:N \hsize
          \exp_not:N \linewidth = \exp_not:N \hsize
          \int_compare:nNnTF {#1} = { 1 }
            { \exp_not:N \raggedright } { \exp_not:N \centering }
          \exp_not:N \arraybackslash
          % без клея перед первым словом TeX его не переносит
          \exp_not:N \hspace { 0pt }
        } X
        \int_compare:nNnT {#1} = { \l__suai_cols_int } { | }
      }
  }

\cs_new_protected:Npn \__suai_table_row:nn #1#2
  {
    \__suai_cells:n {#2}
    \tl_clear:N \l__suai_row_tl
    \int_step_inline:nn { \l__suai_cols_int }
      {
        \tl_put_right:Nx \l__suai_row_tl
          {
            \int_compare:nNnF {##1} = { 1 } { & }
            % шапка — по центру, без полужирного (п. 6.1.1)
            \int_compare:nNnT {#1} = { 1 } { \exp_not:N \centering }
            \seq_item:Nn \l__suai_cells_seq {##1}
          }
      }
    \tl_put_right:Nn \l__suai_row_tl { \tabularnewline \hline }
    \int_compare:nNnTF {#1} = { 1 }
      { \tl_set_eq:NN \l__suai_head_tl \l__suai_row_tl }
      { \tl_put_right:NV \l__suai_body_tl \l__suai_row_tl }
  }

\cs_new_protected:Npn \__suai_table:nn #1#2
  {
    \seq_if_empty:NF \g__suai_lines_seq
      {
        \int_zero:N \l__suai_cols_int
        \prop_clear:N \l__suai_level_prop
        \prop_clear:N \l__suai_wd_prop
        \seq_map_function:NN \g__suai_lines_seq \__suai_table_cols:n
        \int_step_inline:nn { \l__suai_cols_int }
          {
            \int_step_inline:nn { 4 }
              { \prop_put:Nnn \l__suai_level_prop { ####1 / ##1 } { 0 } }
          }
        \seq_map_function:NN \g__suai_lines_seq \__suai_table_measure:n
        % уровень не уже предыдущего, иначе доля места выйдет отрицательной
        \int_step_inline:nn { \l__suai_cols_int }
          {
            \tl_set:Nn \l__suai_col_tl {##1}
            \int_step_inline:nnn { 2 } { 4 }
              {
                \__suai_table_wider:nn {####1}
                  { \fp_to_dim:n { \__suai_wd:nn { ####1 - 1 } {##1} - \c__suai_pad_fp } }
              }
          }
        \__suai_table_widths:
        \tl_clear:N \l__suai_spec_tl
        \int_step_function:nN { \l__suai_cols_int } \__suai_table_spec:n
        \tl_clear:N \l__suai_head_tl
        \tl_clear:N \l__suai_body_tl
        \seq_map_indexed_function:NN \g__suai_lines_seq \__suai_table_row:nn
        \tl_set:Nx \l__suai_table_tl
          {
            \exp_not:N \begin{xltabular}{\exp_not:N \textwidth}{\exp_not:V \l__suai_spec_tl}
            \exp_not:N \caption{\exp_not:n {#2}}
            \tl_if_blank:nF {#1} { \exp_not:N \label{tab:\exp_not:n {#1}} }
            \exp_not:N \tabularnewline
            \exp_not:N \hline
            \exp_not:V \l__suai_head_tl
            \exp_not:N \endfirsthead
            \exp_not:N \multicolumn{\int_use:N \l__suai_cols_int}{@{}l}
              {Продолжение~таблицы~\exp_not:N \thetable}
            \exp_not:N \tabularnewline
            \exp_not:N \hline
            \exp_not:V \l__suai_head_tl
            \exp_not:N \endhead
            \exp_not:V \l__suai_body_tl
            \exp_not:N \end{xltabular}
          }
        \tl_use:N \l__suai_table_tl
      }
  }

\NewDocumentCommand \suaitable { O{} m }
  { \suai_read_lines:n { \__suai_table:nn {#1} {#2} } }

%%---------------------------------------------------------------------
%% 13. ФОРМУЛА С ПОЯСНЕНИЯМИ
%%  Строки «обозначение | смысл» дают «где V — ...;», $ добавляется сам.
%%  Обозначение с чертой пишется в $…$: «$|x|$ | модуль».
%%---------------------------------------------------------------------
\box_new:N \l__suai_where_box
\tl_new:N \l__suai_sym_tl

\cs_new_protected:Npn \__suai_where_item:nn #1#2
  {
    \__suai_cells:n {#2}
    \int_compare:nNnTF { \seq_count:N \l__suai_cells_seq } > { 1 }
      {
        \seq_pop_left:NN \l__suai_cells_seq \l__suai_sym_tl
        \tl_if_in:NnF \l__suai_sym_tl { $ }
          { \tl_set:Nx \l__suai_sym_tl { $ \exp_not:V \l__suai_sym_tl $ } }
        \tl_set:Nx \l__suai_item_tl
          {
            \exp_not:V \l__suai_sym_tl
            \exp_not:N \nobreakspace \exp_not:N \textemdash \c_space_tl
            \seq_use:Nn \l__suai_cells_seq { | }
          }
      }
      { \tl_set:Nn \l__suai_item_tl {#2} }
    \__suai_punct:n {#1}
    \par \noindent
    \hangindent = \box_wd:N \l__suai_where_box
    \hangafter = 1 \scan_stop:
    \int_compare:nNnTF {#1} = { 1 }
      { \box_use:N \l__suai_where_box }
      { \skip_horizontal:n { \box_wd:N \l__suai_where_box } }
    \tl_use:N \l__suai_item_tl
  }

\cs_new_protected:Npn \__suai_eq:nn #1#2
  {
    \begin{equation}
      #2
      \tl_if_blank:nF {#1} { \label{eq:#1} }
    \end{equation}
    \seq_if_empty:NF \g__suai_lines_seq
      {
        \hbox_set:Nn \l__suai_where_box { где \c_space_tl }
        \bool_set_true:N \l__suai_punct_bool
        \seq_map_indexed_function:NN \g__suai_lines_seq \__suai_where_item:nn
        \par
      }
  }

\NewDocumentCommand \suaieq { O{} m }
  { \suai_read_lines:n { \__suai_eq:nn {#1} {#2} } }

%%---------------------------------------------------------------------
%% 14. СПИСОК ИСТОЧНИКОВ
%%  Без строк под командой список печатает biblatex, если подключён.
%%---------------------------------------------------------------------
\cs_new_protected:Npn \__suai_sources:
  {
    \suaisection { Список~использованных~источников }
    \seq_if_empty:NTF \g__suai_lines_seq
      { \cs_if_exist:NT \printbibliography { \printbibliography [ heading = none ] } }
      {
        \begin{enumerate} [ label = \arabic*. , wide = \parindent ]
          \seq_map_inline:Nn \g__suai_lines_seq { \item ##1 }
        \end{enumerate}
      }
  }
\NewDocumentCommand \suaisources { }
  { \suai_read_lines:n { \__suai_sources: } }

%%---------------------------------------------------------------------
%% 15. ЛИСТИНГИ
%%  \suaicode[язык, метка]{файл}{Подпись}[метка] — код из файла (ищется
%%  и в code/), метка по умолчанию lst:имя-файла.
%%  \suaicode[язык, метка]{Подпись} — код в тексте: строки с отступом
%%  под командой, пустые строки внутри можно. Код кончается на первой
%%  непустой строке без отступа; общий отступ срезается.
%%  [язык, метка]: без «=» — по позиции, с «=» — ключ listings.
%%---------------------------------------------------------------------
\int_new:N \l__suai_code_int
% # в имени языка listings не переживает, C# подменяется на диалект
\cs_new_protected:Npn \__suai_code_language:n #1
  {
    \str_case:nnF {#1}
      {
        { C## } { \lstset { language = [Sharp]C } }
        { c## } { \lstset { language = [Sharp]C } }
      }
      { \lstset { language = {#1} } }
  }
\cs_new_protected:cpn { suai@codeopts } #1#2
  {
    \int_zero:N \l__suai_code_int
    \clist_map_inline:nn {#1}
      {
        \tl_if_in:nnTF {##1} { = }
          { \lstset {##1} }
          {
            \int_incr:N \l__suai_code_int
            \int_case:nn { \l__suai_code_int }
              {
                { 1 } { \__suai_code_language:n {##1} }
                { 2 } { \lstset { label = { lst:##1 } } }
              }
          }
      }
    \lstset { caption = {#2} }
  }

\msg_new:nnn { suai } { code-empty }
  {
    Под~\iow_char:N\\suaicode~нет~строк~с~отступом.~Код~в~тексте~
    пишется~под~командой~с~отступом,~код~из~файла~—~так:~
    \iow_char:N\\suaicode[язык]{файл}{Подпись}.
  }
\msg_new:nnn { suai } { code-rest }
  {
    После~подписи~\iow_char:N\\suaicode~на~той~же~строке~ничего~
    не~пишется:~код~начинается~со~следующей~строки.
  }

% Форма узнаётся по второй {…} на той же строке. Конец строки делается
% активным до того, как TeX её прочтёт, и peek на нём останавливается.
\NewDocumentCommand \suaicode { O{} m }
  {
    \group_begin:
      \char_set_catcode_active:n { 13 }
      \char_set_catcode_other:N \%
      \peek_remove_spaces:n
        {
          \peek_catcode:NTF \c_group_begin_token
            { \group_end: \__suai_code_file:nnnn {#1} {#2} }
            {
              \tl_gset:Nn \g__suai_code_then_tl { \__suai_code_typeset:nn {#1} {#2} }
              \__suai_code_inline:
            }
        }
  }

\NewDocumentCommand \__suai_code_file:nnnn { m m m o }
  {
    \group_begin:
      \use:c { suai@basename } {#2}
      \exp_args:Nx \lstset { label = { lst: \use:c { suai@base } } }
      \use:c { suai@codeopts } {#1} {#3}
      \IfValueT {#4} { \lstset { label = {#4} } }
      \file_if_exist:nTF {#2}
        { \lstinputlisting {#2} }
        { \lstinputlisting { code/#2 } }
    \group_end:
  }

%% Код в тексте. Строки читаются как есть (все ASCII — «прочие»,
%% конец строки активный) и собираются в \g__suai_code_seq, табуляция
%% сразу разворачивается в пробелы до колонки, кратной 4 (tabsize).
%% Строка, на которой код кончился, после листинга читается заново
%% с обычными кодами.
\tl_new:N \g__suai_code_then_tl
\seq_new:N \g__suai_code_seq
\int_new:N \g__suai_code_blank_int    % пустые строки после последней строки кода
\int_new:N \g__suai_code_indent_int   % общий отступ
\tl_new:N \g__suai_code_stop_tl
\tl_new:N \l__suai_code_line_tl
\int_new:N \l__suai_code_col_int
\int_new:N \l__suai_code_lead_int
\iow_new:N \g__suai_code_iow
\tl_const:Nx \c__suai_code_space_tl { \char_generate:nn { 32 } { 12 } }
% код в самом конце файла из \input: конец файла — как строка
% с комментарием без отступа, на ней код кончается
\tl_const:Nx \c__suai_code_eof_tl { \c_percent_str \exp_not:V \c__suai_eol_tl }

\cs_new_protected:Npn \__suai_code_inline:
  {
    \tex_everyeof:D \exp_after:wN { \c__suai_code_eof_tl }
    \seq_gclear:N \g__suai_code_seq
    \int_gzero:N \g__suai_code_blank_int
    \int_gset_eq:NN \g__suai_code_indent_int \c_max_int
    \__suai_code_rest:w
  }

\group_begin:
  \char_set_lccode:nn { `\~ } { 13 }
  \char_set_catcode_active:N \~
  \tex_lowercase:D
    {
      \group_end:
      % остаток строки с командой: пусто или комментарий
      \cs_new_protected:Npn \__suai_code_rest:w #1 ~
        {
          \tl_if_blank:nF {#1}
            {
              \str_if_eq:eeF { \str_head:n {#1} } { \c_percent_str }
                { \msg_error:nn { suai } { code-rest } }
            }
          \int_step_inline:nnn { 0 } { 127 } { \char_set_catcode_other:n {##1} }
          \char_set_catcode_active:n { 13 }
          \__suai_code_line:w
        }
      \cs_new_protected:Npn \__suai_code_line:w #1 ~
        { \__suai_code_line:n {#1} }
    }

\cs_new_protected:Npn \__suai_code_line:n #1
  {
    \tl_clear:N \l__suai_code_line_tl
    \int_zero:N \l__suai_code_col_int
    \int_set:Nn \l__suai_code_lead_int { -1 }   % -1 — пока одни пробелы
    \tl_map_inline:nn {#1}
      {
        \int_compare:nNnTF { `##1 } = { 9 }
          {
            \prg_replicate:nn { 4 - \int_mod:nn { \l__suai_code_col_int } { 4 } }
              {
                \tl_put_right:NV \l__suai_code_line_tl \c__suai_code_space_tl
                \int_incr:N \l__suai_code_col_int
              }
          }
          {
            \int_compare:nNnT \l__suai_code_lead_int < 0
              {
                \int_compare:nNnF { `##1 } = { 32 }
                  { \int_set_eq:NN \l__suai_code_lead_int \l__suai_code_col_int }
              }
            \tl_put_right:Nn \l__suai_code_line_tl {##1}
            \int_incr:N \l__suai_code_col_int
          }
      }
    \int_compare:nNnTF \l__suai_code_lead_int < 0
      {
        \int_gincr:N \g__suai_code_blank_int
        \__suai_code_line:w
      }
      {
        \int_compare:nNnTF \l__suai_code_lead_int > 0
          {
            \seq_if_empty:NF \g__suai_code_seq
              {
                \prg_replicate:nn { \g__suai_code_blank_int }
                  { \seq_gput_right:Nn \g__suai_code_seq { } }
              }
            \int_gzero:N \g__suai_code_blank_int
            \seq_gput_right:NV \g__suai_code_seq \l__suai_code_line_tl
            \int_gset:Nn \g__suai_code_indent_int
              { \int_min:nn { \g__suai_code_indent_int } { \l__suai_code_lead_int } }
            \__suai_code_line:w
          }
          {
            \tl_gset:Nn \g__suai_code_stop_tl {#1}
            \group_end:
            \__suai_code_end:
          }
      }
  }

\cs_new_protected:Npn \__suai_code_end:
  {
    \seq_if_empty:NTF \g__suai_code_seq
      { \msg_error:nn { suai } { code-empty } }
      { \tl_use:N \g__suai_code_then_tl }
    \int_compare:nNnT \g__suai_code_blank_int > 0 { \par }
    \__suai_code_stop:
  }

% Строка перечитывается без конца строки: \tl_set_rescan в expl3 2022
% года падает на строке из одного комментария, поэтому такая строка
% просто пропускается, а пробел за строкой ставится вручную. Следующему
% \suaicode и окружению listings вместо пробела нужен активный конец
% строки, как после \suaitable.
\cs_new_protected:Npn \__suai_code_stop:
  {
    \str_if_eq:eeTF { \str_head:N \g__suai_code_stop_tl } { \c_percent_str }
      { \tl_clear:N \l_tmpa_tl }
      {
        \exp_args:NNnV \tl_set_rescan:Nnn \l_tmpa_tl
          { \int_set:Nn \tex_endlinechar:D { -1 } } \g__suai_code_stop_tl
        \exp_args:NV \__suai_if_eol:nTF \l_tmpa_tl
          { \tl_put_right:NV \l_tmpa_tl \c__suai_eol_tl }
          {
            \exp_args:NNV \str_if_in:NnF \g__suai_code_stop_tl \c_percent_str
              { \tl_put_right:NV \l_tmpa_tl \c_space_tl }
          }
      }
    \tl_use:N \l_tmpa_tl
  }

\cs_new_protected:Npn \__suai_code_typeset:nn #1#2
  {
    \iow_open:Nn \g__suai_code_iow { \c_sys_jobname_str .code }
    \seq_map_inline:Nn \g__suai_code_seq
      {
        \iow_now:Nx \g__suai_code_iow
          { \tl_range:nnn {##1} { \g__suai_code_indent_int + 1 } { -1 } }
      }
    \iow_close:N \g__suai_code_iow
    \group_begin:
      \use:c { suai@codeopts } {#1} {#2}
      \lstinputlisting { \c_sys_jobname_str .code }
    \group_end:
  }
\ExplSyntaxOff


        return token_scan_int()
    end
    luacmd("__luaalignstate_set:w", function ()
        return luaalignstate_getset(set_scan)
    end, "protected")
    luacmd("__luaalignstate_add:w", function ()
        return luaalignstate_add(token_scan_int())
    end, "protected")
